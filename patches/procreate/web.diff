new file mode 100644
--- /dev/null
+++ b/crates/engine/src/playground.rs
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: MIT
+//! ProCraft in the browser, for Playground (patches/procreate.yaml in github.com/daijro/openplayground).
+//!
+//! wasm32-unknown-unknown has no clock and no files: `Instant::now` panics there, and every file call fails, the
+//! `image` crate's own `open` and `save_buffer` included. The modules that use them take `std` (and `image`) from here
+//! instead, through one `#[cfg(target_arch = "wasm32")] use …::playground::…;` line at each one's end (a local name
+//! shadows the crate's in that module; everything else in it still comes from the real one):
+//!   std::time  web-time's clock (its Instant a day on, so the app can step back from `now`);
+//!   std::fs    an in-memory file system (paintings, exports, brushes, palettes, settings, the recovery snapshot), each
+//!              write noted for the page to mirror into Files (apps/procraft/src/web.rs);
+//!   std::env   `HOME` is `/home` (settings live in memory, so every page starts afresh); nothing else is set;
+//!   image      `open`, `ImageReader::open` and `save_buffer` through those files.
+
+// Not every part of std's API that is here gets used.
+#![allow(dead_code)]
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod time {
+        use ::std::ops::{Add, AddAssign, Sub, SubAssign};
+        pub use web_time::*;
+
+        /// web-time's Instant, a day on from the page's start: the app sets clocks in the past
+        /// (`Instant::now() - PREVIEW_MIN_DT`), which web-time's clock, 0 when the page opened, cannot go below.
+        #[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+        pub struct Instant(web_time::Instant);
+
+        impl Instant {
+            pub fn now() -> Self {
+                Self(web_time::Instant::now() + Duration::from_secs(86_400))
+            }
+            pub fn elapsed(&self) -> Duration {
+                Self::now().saturating_duration_since(*self)
+            }
+            pub fn duration_since(&self, earlier: Self) -> Duration {
+                self.0.duration_since(earlier.0)
+            }
+            pub fn saturating_duration_since(&self, earlier: Self) -> Duration {
+                self.0.saturating_duration_since(earlier.0)
+            }
+            pub fn checked_duration_since(&self, earlier: Self) -> Option<Duration> {
+                self.0.checked_duration_since(earlier.0)
+            }
+            pub fn checked_add(&self, d: Duration) -> Option<Self> {
+                self.0.checked_add(d).map(Self)
+            }
+            pub fn checked_sub(&self, d: Duration) -> Option<Self> {
+                self.0.checked_sub(d).map(Self)
+            }
+        }
+        impl Add<Duration> for Instant {
+            type Output = Self;
+            fn add(self, d: Duration) -> Self {
+                Self(self.0 + d)
+            }
+        }
+        impl Sub<Duration> for Instant {
+            type Output = Self;
+            fn sub(self, d: Duration) -> Self {
+                Self(self.0 - d)
+            }
+        }
+        impl Sub for Instant {
+            type Output = Duration;
+            fn sub(self, earlier: Self) -> Duration {
+                self.saturating_duration_since(earlier)
+            }
+        }
+        impl AddAssign<Duration> for Instant {
+            fn add_assign(&mut self, d: Duration) {
+                self.0 += d;
+            }
+        }
+        impl SubAssign<Duration> for Instant {
+            fn sub_assign(&mut self, d: Duration) {
+                self.0 -= d;
+            }
+        }
+    }
+
+    pub mod env {
+        pub use ::std::env::*;
+        use ::std::ffi::{OsStr, OsString};
+
+        /// `HOME` is `/home`: settings and the recovery snapshot go to the in-memory files. Nothing else is set.
+        pub fn var_os<K: AsRef<OsStr>>(key: K) -> Option<OsString> {
+            (key.as_ref() == "HOME").then(|| OsString::from("/home"))
+        }
+
+        pub fn var<K: AsRef<OsStr>>(key: K) -> Result<String, VarError> {
+            var_os(key).and_then(|v| v.into_string().ok()).ok_or(VarError::NotPresent)
+        }
+    }
+
+    pub mod fs {
+        pub use ::std::fs::*;
+        use ::std::cell::RefCell;
+        use ::std::collections::{BTreeMap, BTreeSet};
+        use ::std::io::{self, Cursor, Read, Seek, SeekFrom, Write};
+        use ::std::path::{Component, Path, PathBuf};
+
+        enum Entry {
+            Dir,
+            File(Vec<u8>, web_time::SystemTime),
+        }
+
+        #[derive(Default)]
+        struct Tree {
+            entries: BTreeMap<PathBuf, Entry>,
+            /// Paths written, created or removed since the last [`changes`].
+            changed: BTreeSet<PathBuf>,
+        }
+
+        thread_local! {
+            static TREE: RefCell<Tree> = RefCell::default();
+        }
+
+        fn with<T>(f: impl FnOnce(&mut Tree) -> T) -> T {
+            TREE.with(|t| f(&mut t.borrow_mut()))
+        }
+
+        /// `/a/./b/../c` -> `/a/c`: one spelling per file (relative paths start at `/`).
+        pub fn key(p: &Path) -> PathBuf {
+            let mut out = PathBuf::from("/");
+            for c in p.components() {
+                match c {
+                    Component::ParentDir => {
+                        out.pop();
+                    }
+                    Component::Normal(n) => out.push(n),
+                    _ => {}
+                }
+            }
+            out
+        }
+
+        fn missing(p: &Path) -> io::Error {
+            io::Error::new(io::ErrorKind::NotFound, format!("{} does not exist", p.display()))
+        }
+
+        impl Tree {
+            fn mark(&mut self, p: PathBuf) {
+                self.changed.insert(p);
+            }
+            fn parents(&mut self, p: &Path) {
+                for dir in p.ancestors().skip(1) {
+                    self.entries.entry(dir.to_path_buf()).or_insert(Entry::Dir);
+                }
+            }
+            fn put(&mut self, p: PathBuf, bytes: Vec<u8>) {
+                self.parents(&p);
+                self.entries.insert(p, Entry::File(bytes, web_time::SystemTime::now()));
+            }
+        }
+
+        /// Stores a file without noting a change (files the page brings in from Files or a drop).
+        pub fn put(p: &Path, bytes: Vec<u8>) {
+            with(|t| t.put(key(p), bytes));
+        }
+
+        /// Removes a file without noting a change, giving back what it held (an export on its way to Save As).
+        pub fn take(p: &Path) -> Option<Vec<u8>> {
+            with(|t| match t.entries.remove(&key(p)) {
+                Some(Entry::File(bytes, _)) => Some(bytes),
+                _ => None,
+            })
+        }
+
+        /// The paths changed since the last call: each now holds what Files should hold, or is gone.
+        pub fn changes() -> Vec<PathBuf> {
+            with(|t| ::std::mem::take(&mut t.changed).into_iter().collect())
+        }
+
+        pub fn exists<P: AsRef<Path>>(p: P) -> io::Result<bool> {
+            Ok(metadata(p).is_ok())
+        }
+
+        pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(p: P, bytes: C) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                t.put(p.clone(), bytes.as_ref().to_vec());
+                t.mark(p);
+            });
+            Ok(())
+        }
+
+        pub fn read<P: AsRef<Path>>(p: P) -> io::Result<Vec<u8>> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::File(bytes, _)) => Ok(bytes.clone()),
+                _ => Err(missing(p.as_ref())),
+            })
+        }
+
+        pub fn read_to_string<P: AsRef<Path>>(p: P) -> io::Result<String> {
+            String::from_utf8(read(p)?).map_err(|e| io::Error::new(io::ErrorKind::InvalidData, e))
+        }
+
+        pub fn create_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                if !t.entries.contains_key(&p) {
+                    t.parents(&p);
+                    t.entries.insert(p.clone(), Entry::Dir);
+                    t.mark(p);
+                }
+            });
+            Ok(())
+        }
+
+        pub fn remove_file<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| match t.entries.get(&p) {
+                Some(Entry::File(..)) => {
+                    t.entries.remove(&p);
+                    t.mark(p);
+                    Ok(())
+                }
+                _ => Err(missing(&p)),
+            })
+        }
+
+        pub fn rename<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<()> {
+            let (from, to) = (key(from.as_ref()), key(to.as_ref()));
+            let bytes = read(&from)?;
+            with(|t| {
+                t.entries.remove(&from);
+                t.mark(from);
+                t.put(to.clone(), bytes);
+                t.mark(to);
+            });
+            Ok(())
+        }
+
+        #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+        pub struct FileType(bool);
+        impl FileType {
+            pub fn is_file(&self) -> bool {
+                self.0
+            }
+            pub fn is_dir(&self) -> bool {
+                !self.0
+            }
+            pub fn is_symlink(&self) -> bool {
+                false
+            }
+        }
+
+        #[derive(Clone, Debug)]
+        pub struct Metadata(Option<(u64, web_time::SystemTime)>);
+        impl Metadata {
+            pub fn len(&self) -> u64 {
+                self.0.map_or(0, |(n, _)| n)
+            }
+            pub fn is_file(&self) -> bool {
+                self.0.is_some()
+            }
+            pub fn is_dir(&self) -> bool {
+                self.0.is_none()
+            }
+            pub fn file_type(&self) -> FileType {
+                FileType(self.is_file())
+            }
+            pub fn modified(&self) -> io::Result<web_time::SystemTime> {
+                Ok(self.0.map_or(web_time::SystemTime::UNIX_EPOCH, |(_, t)| t))
+            }
+        }
+
+        pub fn metadata<P: AsRef<Path>>(p: P) -> io::Result<Metadata> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::File(bytes, at)) => Ok(Metadata(Some((bytes.len() as u64, *at)))),
+                Some(Entry::Dir) => Ok(Metadata(None)),
+                None => Err(missing(p.as_ref())),
+            })
+        }
+
+        /// A file's bytes, read whole when it opens; one created to write is stored when flushed or dropped.
+        pub struct File {
+            data: Cursor<Vec<u8>>,
+            /// Where written bytes go, for a file created to write.
+            to: Option<PathBuf>,
+            dirty: bool,
+        }
+
+        impl File {
+            pub fn open<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                Ok(File { data: Cursor::new(read(p)?), to: None, dirty: false })
+            }
+            pub fn create<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                let p = key(p.as_ref());
+                write(&p, [])?;
+                Ok(File { data: Cursor::new(Vec::new()), to: Some(p), dirty: false })
+            }
+            pub fn metadata(&self) -> io::Result<Metadata> {
+                Ok(Metadata(Some((self.data.get_ref().len() as u64, web_time::SystemTime::now()))))
+            }
+            /// The bytes are stored when the file is flushed or dropped.
+            pub fn sync_all(&self) -> io::Result<()> {
+                Ok(())
+            }
+            fn store(&mut self) {
+                if let (true, Some(to)) = (self.dirty, &self.to) {
+                    let _ = write(to, self.data.get_ref());
+                    self.dirty = false;
+                }
+            }
+        }
+
+        impl Read for File {
+            fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+                self.data.read(buf)
+            }
+        }
+
+        impl Seek for File {
+            fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
+                self.data.seek(pos)
+            }
+        }
+
+        impl Write for File {
+            fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+                if self.to.is_none() {
+                    return Err(io::Error::new(io::ErrorKind::PermissionDenied, "the file is open to read"));
+                }
+                self.dirty = true;
+                self.data.write(buf)
+            }
+            fn flush(&mut self) -> io::Result<()> {
+                self.store();
+                Ok(())
+            }
+        }
+
+        impl Drop for File {
+            fn drop(&mut self) {
+                self.store();
+            }
+        }
+    }
+}
+
+/// The `image` crate, with what reads or writes a path going through the in-memory files above.
+pub mod image {
+    use super::std::fs;
+    pub use ::image::*;
+    use ::std::io::Cursor;
+    use ::std::path::Path;
+
+    /// `image::open`: the format from the extension, as image's own.
+    pub fn open<P: AsRef<Path>>(p: P) -> ImageResult<DynamicImage> {
+        ImageReader::open(p)?.decode()
+    }
+
+    /// `image::save_buffer`: the format from the extension, as image's own.
+    pub fn save_buffer<P: AsRef<Path>>(
+        p: P,
+        buf: &[u8],
+        width: u32,
+        height: u32,
+        color: impl Into<ExtendedColorType>,
+    ) -> ImageResult<()> {
+        let mut out = Cursor::new(Vec::new());
+        write_buffer_with_format(&mut out, buf, width, height, color, ImageFormat::from_path(p.as_ref())?)?;
+        fs::write(p, out.into_inner())?;
+        Ok(())
+    }
+
+    /// `ImageReader::open`, giving image's own reader over the file's bytes.
+    pub struct ImageReader;
+    impl ImageReader {
+        pub fn open<P: AsRef<Path>>(p: P) -> ::std::io::Result<::image::ImageReader<Cursor<Vec<u8>>>> {
+            let mut reader = ::image::ImageReader::new(Cursor::new(fs::read(p.as_ref())?));
+            if let Ok(format) = ImageFormat::from_path(p) {
+                reader.set_format(format);
+            }
+            Ok(reader)
+        }
+    }
+}
