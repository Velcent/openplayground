+// SPDX-License-Identifier: MIT
+//! ProCraft in the browser, for Playground (patches/procreate.yaml in github.com/daijro/openplayground): the desktop
+//! app on the page's canvas, its files in Playground's Files.
+//!
+//! [`start`] runs the desktop's app on the page. Files live in memory (procraft-engine's `playground::std::fs`): a
+//! file from Files comes in at its path (`browser:/Art/Sky.procraft` is `/Art/Sky.procraft` here). The open dialogs
+//! take the iOS build's route: [`rfd::FileDialog::pick_file`] asks Playground's Open and gives nothing now, and the
+//! app's frame checks [`rfd::poll_pick`] until the file is in memory. A save dialog gives a path in `/ProCraft/Saving`
+//! at once; what the app writes there goes to Playground's Save As after the frame, then to the place in Files picked
+//! (or the device's downloads). What the app writes elsewhere outside its own folder (a Gallery Duplicate, beside its
+//! original) goes to Files too. "Open in ProCraft" and dropped files open as the matching Open… would. The Gallery
+//! lists the paintings in Files. A pen's pressure (PointerEvent.pressure, kept by index.html) reaches the brushes as
+//! Apple Pencil's touch force does.
+
+use crate::{PendingOpen, ProCraftApp, MAX_RECENT};
+use eframe::egui;
+use procraft_engine::playground::std::fs;
+use std::cell::{OnceCell, RefCell};
+use std::path::{Path, PathBuf};
+use wasm_bindgen::{closure::Closure, JsCast as _, JsValue};
+
+/// ProCraft's own folder in memory (`HOME`), never copied to Files: settings and the recovery snapshot.
+const OWN: &str = "/home";
+/// Where the save dialogs point: what lands here goes to Playground's Save As.
+const SAVING: &str = "/ProCraft/Saving";
+/// Where a file from the computer (Open's "From computer…", a drop) is kept.
+const OPENED: &str = "/ProCraft/Opened";
+
+/// Where Save As put an export.
+enum Saved {
+    InFiles(PathBuf),
+    Downloaded,
+    Cancelled,
+}
+
+enum Pick {
+    Idle,
+    Waiting,
+    Done(Option<PathBuf>),
+}
+
+thread_local! {
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+    /// The open dialog's state, for [`rfd::poll_pick`].
+    static PICK: RefCell<Pick> = const { RefCell::new(Pick::Idle) };
+    /// Files for the app to open ("Open in ProCraft", drops), on the next frame.
+    static INCOMING: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    /// Exports that went through Save As: where the app wrote each, and where it went.
+    static SAVED: RefCell<Vec<(PathBuf, Saved)>> = const { RefCell::new(Vec::new()) };
+    /// The paintings in Files, for the Gallery.
+    static LISTED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    /// The name Save As suggests: the last painting opened or saved.
+    static NAME: RefCell<String> = RefCell::new("Untitled".into());
+}
+
+fn repaint() {
+    CTX.with(|c| c.get().map(egui::Context::request_repaint));
+}
+
+/// The desktop's file dialogs (the iOS build's shape: rfd-shim's).
+pub mod rfd {
+    use std::path::{Path, PathBuf};
+
+    pub struct FileDialog {
+        types: Vec<String>,
+    }
+
+    impl FileDialog {
+        pub fn new() -> Self {
+            Self { types: Vec::new() }
+        }
+        pub fn add_filter(mut self, _name: &str, extensions: &[&str]) -> Self {
+            self.types.extend(extensions.iter().map(|e| e.to_ascii_lowercase()));
+            self
+        }
+        /// Asks Playground's Open (unless it is up already) and gives nothing now: the file comes through
+        /// [`poll_pick`].
+        pub fn pick_file(self) -> Option<PathBuf> {
+            super::ask_open(&self.types);
+            None
+        }
+        /// A path in /ProCraft/Saving, named after the last painting, with the first type's extension. What the app
+        /// writes there goes to Playground's Save As after the frame.
+        pub fn save_file(self) -> Option<PathBuf> {
+            let name = super::NAME.with_borrow(Clone::clone);
+            let file = match self.types.first() {
+                Some(ext) => format!("{name}.{ext}"),
+                None => name,
+            };
+            Some(Path::new(super::SAVING).join(file))
+        }
+    }
+
+    /// An open's state (rfd-shim's).
+    pub enum PickPoll {
+        NoRequest,
+        Waiting,
+        Picked(PathBuf),
+        Cancelled(Option<&'static str>),
+    }
+
+    /// Whether the file asked for is in memory yet. Call once per frame after `pick_file`.
+    pub fn poll_pick() -> PickPoll {
+        match super::PICK.replace(super::Pick::Idle) {
+            super::Pick::Idle => PickPoll::NoRequest,
+            super::Pick::Waiting => {
+                super::PICK.set(super::Pick::Waiting);
+                PickPoll::Waiting
+            }
+            super::Pick::Done(Some(path)) => PickPoll::Picked(path),
+            super::Pick::Done(None) => PickPoll::Cancelled(None),
+        }
+    }
+}
+
+/// A pen's pressure on the canvas now (index.html keeps it while a pen is down), for `latest_touch_force`.
+pub fn pen_pressure() -> Option<f32> {
+    get(&js_sys::global(), "procraftPenPressure").as_f64().map(|p| (p as f32).clamp(0.0, 1.0))
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = Some(get(&js_sys::global(), "playgroundFiles")).filter(JsValue::is_object)?;
+    let f = get(&api, method).dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok().filter(|v| !v.is_null() && !v.is_undefined())
+}
+
+fn options(fields: &[(&str, JsValue)]) -> JsValue {
+    let o = js_sys::Object::new();
+    for (k, v) in fields {
+        let _ = js_sys::Reflect::set(&o, &(*k).into(), v);
+    }
+    o.into()
+}
+
+fn types(types: &[String]) -> JsValue {
+    types.iter().map(|t| JsValue::from(t.as_str())).collect::<js_sys::Array>().into()
+}
+
+fn bytes(b: &[u8]) -> JsValue {
+    js_sys::Uint8Array::from(b).into()
+}
+
+/// The `path` of a file Playground gives (`browser:/a/b`), as a path here (`/a/b`).
+fn path_in(o: &JsValue) -> Option<PathBuf> {
+    get(o, "path").as_string().and_then(|p| p.strip_prefix("browser:").map(PathBuf::from))
+}
+
+fn in_files(path: &Path) -> JsValue {
+    format!("browser:{}", path.display()).into()
+}
+
+/// A painting's name, for the next Save As to suggest.
+fn remember_name(path: &Path) {
+    let painting = matches!(kind(path), Some(PendingOpen::Project | PendingOpen::Psd | PendingOpen::Image));
+    if let Some(stem) = path.file_stem().and_then(|s| s.to_str()).filter(|_| painting) {
+        NAME.set(stem.to_string());
+    }
+}
+
+/// A file from Playground (`{ path, name, bytes }`) into memory at its path in Files; one from the computer goes to
+/// /ProCraft/Opened.
+fn bring_in(file: &JsValue) -> Option<PathBuf> {
+    let name = get(file, "name").as_string()?;
+    let path = match path_in(file) {
+        Some(path) => path,
+        None => Path::new(OPENED).join(Path::new(&name).file_name()?),
+    };
+    fs::put(&path, js_sys::Uint8Array::new(&get(file, "bytes")).to_vec());
+    remember_name(&path);
+    Some(path)
+}
+
+/// Playground's Open, for [`rfd::FileDialog::pick_file`].
+fn ask_open(kinds: &[String]) {
+    if PICK.with_borrow(|p| matches!(p, Pick::Waiting)) {
+        return;
+    }
+    PICK.set(Pick::Waiting);
+    let asked = call("open", &[options(&[("types", types(kinds))])]);
+    wasm_bindgen_futures::spawn_local(async move {
+        let file = wait(asked).await.and_then(|list| js_sys::Array::from(&list).iter().next());
+        PICK.set(Pick::Done(file.as_ref().and_then(bring_in)));
+        repaint();
+    });
+}
+
+/// What an Open… of the file's type does with it ("Open in ProCraft", a drop).
+fn kind(path: &Path) -> Option<PendingOpen> {
+    let ext = path.extension()?.to_str()?.to_ascii_lowercase();
+    Some(match ext.as_str() {
+        "procraft" => PendingOpen::Project,
+        "psd" => PendingOpen::Psd,
+        "png" | "jpg" | "jpeg" | "webp" | "bmp" | "gif" | "tif" | "tiff" => PendingOpen::Image,
+        "pcpalette" | "gpl" => PendingOpen::Palette,
+        "ttf" | "otf" => PendingOpen::Font,
+        "pcbrush" | "abr" | "brush" | "brushset" | "kpp" | "bundle" | "sut" | "gbr" => PendingOpen::Brushes,
+        _ => return None,
+    })
+}
+
+fn opened(file: JsValue) {
+    if let Some(path) = bring_in(&file) {
+        INCOMING.with_borrow_mut(|o| o.push(path));
+        repaint();
+    }
+}
+
+/// An export the app wrote to /ProCraft/Saving: Playground's Save As, then into Files where it was put.
+fn save_as(written: PathBuf, data: Vec<u8>) {
+    let name = written.file_name().and_then(|n| n.to_str()).unwrap_or("Untitled").to_string();
+    let ext = written.extension().and_then(|e| e.to_str()).map(str::to_string);
+    let asked = call(
+        "saveAs",
+        &[options(&[("name", name.as_str().into()), ("types", types(ext.as_slice())), ("bytes", bytes(&data))])],
+    );
+    wasm_bindgen_futures::spawn_local(async move {
+        let answer = wait(asked).await;
+        let saved = match answer.as_ref().and_then(path_in) {
+            Some(to) => {
+                call("write", &[in_files(&to), bytes(&data)]);
+                fs::put(&to, data);
+                remember_name(&to);
+                Saved::InFiles(to)
+            }
+            None if answer.is_some() => Saved::Downloaded,
+            None => Saved::Cancelled,
+        };
+        SAVED.with_borrow_mut(|s| s.push((written, saved)));
+        repaint();
+    });
+}
+
+/// The Gallery's paintings: the `.procraft` files in Files (the first few the Gallery can show), brought into memory.
+fn list_paintings() {
+    wasm_bindgen_futures::spawn_local(async {
+        let Some(list) = wait(call("files", &["browser:/".into()])).await else { return };
+        let found: Vec<String> = js_sys::Array::from(&list).iter().filter_map(|p| p.as_string()).collect();
+        for p in found.into_iter().filter(|p| p.to_ascii_lowercase().ends_with(".procraft")).take(MAX_RECENT) {
+            let Some(path) = p.strip_prefix("browser:").map(PathBuf::from) else { continue };
+            if fs::metadata(&path).is_err() {
+                let Some(data) = wait(call("read", &[p.as_str().into()])).await else { continue };
+                fs::put(&path, js_sys::Uint8Array::new(&data).to_vec());
+            }
+            LISTED.with_borrow_mut(|l| l.push(path));
+        }
+        repaint();
+    });
+}
+
+/// The page's app: the desktop's, then what it asked of the page.
+struct Web {
+    app: ProCraftApp,
+    gallery_open: bool,
+}
+
+impl Web {
+    /// After the app's frame: files that came in, saves that landed, the Gallery's list, and what the app wrote.
+    fn after(&mut self, ctx: &egui::Context) {
+        let app = &mut self.app;
+        for path in INCOMING.take() {
+            match kind(&path) {
+                Some(kind) => app.open_picked(kind, path),
+                None => app.status = format!("ProCraft can't open {}.", path.display()),
+            }
+            ctx.request_repaint();
+        }
+        for (written, saved) in SAVED.take() {
+            let name = written.file_name().unwrap_or_default().to_string_lossy().to_string();
+            let written = written.to_string_lossy().to_string();
+            match saved {
+                Saved::InFiles(to) => {
+                    let to = to.to_string_lossy().to_string();
+                    app.recent.iter_mut().filter(|r| **r == written).for_each(|r| *r = to.clone());
+                    app.status = format!("Saved {to}");
+                }
+                Saved::Downloaded => app.status = format!("Downloaded {name}"),
+                Saved::Cancelled => app.status = format!("{name} not saved."),
+            }
+            // A project saved to Files is in the Gallery at its place there; one that wasn't isn't anywhere.
+            app.recent.retain(|r| *r != written);
+            app.gallery_keys.clear();
+        }
+        if app.gallery_open && !self.gallery_open {
+            list_paintings();
+        }
+        self.gallery_open = app.gallery_open;
+        for path in LISTED.take() {
+            let path = path.to_string_lossy().to_string();
+            if app.recent.len() < MAX_RECENT && !app.recent.contains(&path) {
+                app.recent.push(path);
+            }
+        }
+        for path in fs::changes() {
+            if path.starts_with(OWN) || fs::metadata(&path).map_or(true, |m| !m.is_file()) {
+                continue;
+            }
+            if path.starts_with(SAVING) {
+                if let Some(data) = fs::take(&path) {
+                    save_as(path, data);
+                }
+            } else if let Ok(data) = fs::read(&path) {
+                call("write", &[in_files(&path), bytes(&data)]);
+            }
+        }
+    }
+}
+
+impl eframe::App for Web {
+    /// A dropped file is only a name on the web: once its bytes are in memory (at /ProCraft/Opened/<name>), the app
+    /// opens it as "Open in ProCraft" does.
+    fn raw_input_hook(&mut self, _: &egui::Context, raw_input: &mut egui::RawInput) {
+        for f in std::mem::take(&mut raw_input.dropped_files) {
+            wasm_bindgen_futures::spawn_local(async move {
+                if let (Ok(data), Some(name)) = (f.bytes_async().await, f.path().file_name()) {
+                    let path = Path::new(OPENED).join(name);
+                    fs::put(&path, data);
+                    remember_name(&path);
+                    INCOMING.with_borrow_mut(|o| o.push(path));
+                    repaint();
+                }
+            });
+        }
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        eframe::App::ui(&mut self.app, ui, frame);
+        self.after(&ui.ctx().clone());
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        eframe::App::save(&mut self.app, storage);
+    }
+}
+
+/// `run` on the web: the app on the page's #procraft_canvas, and Playground's "Open in ProCraft".
+pub fn start() {
+    call("onOpen", &[Closure::<dyn Fn(JsValue)>::new(opened).into_js_value()]);
+    wasm_bindgen_futures::spawn_local(async {
+        let document = web_sys::window().and_then(|w| w.document()).expect("no document");
+        let canvas = document
+            .get_element_by_id("procraft_canvas")
+            .and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok())
+            .expect("no #procraft_canvas");
+        let started = eframe::WebRunner::new()
+            .start(
+                canvas,
+                eframe::WebOptions::default(),
+                Box::new(|cc| {
+                    CTX.with(|c| c.set(cc.egui_ctx.clone()).ok());
+                    Ok(Box::new(Web { app: ProCraftApp::new(cc), gallery_open: false }))
+                }),
+            )
+            .await;
+        if let Some(loading) = document.get_element_by_id("procraft_loading") {
+            match started {
+                Ok(()) => loading.remove(),
+                Err(e) => loading.set_text_content(Some(&format!("ProCraft could not start: {e:?}"))),
+            }
+        }
+    });
+}
