+# ProCraft in the browser, for Playground (patches/procreate.yaml in github.com/daijro/openplayground).
+# Build with: trunk build --release   (from the repository's root)
+[build]
+target = "index.html"
+public_url = "./"
+filehash = true
+dist = "target/trunk-dist"
diff --git a/apps/procraft/src/web.rs b/apps/procraft/src/web.rs
