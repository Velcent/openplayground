+//! The crop tool's view map for live editing (see live.rs `loupe`); the part that follows crop_view's signature.
+use crate::panels::detail::{CanvasMap, CropLayout};
+use crate::state::Zoom;
+
+pub(crate) fn map(frame: &lcc_pipeline::geometry::Frame, crop: lcc_geom::CropGeometry, area: egui::Rect, layout: Option<CropLayout>) -> CanvasMap {
+    // fitted and centred: the same for everyone whatever their zoom
+    crate::panels::detail::crop_view(frame, crop, area, layout, Zoom::Fit, 1.0, (0.5, 0.5)).map
+}
+
