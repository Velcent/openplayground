+/// Set by the web build for live editing: while several people edit one library, each new id is one none of the others
+/// can pick (the counter still goes past it).
+pub static FRESH_ID: std::sync::OnceLock<fn(&mut u64) -> u64> = std::sync::OnceLock::new();
+
+fn next_id(counter: &mut u64) -> u64 {
+    let id = (*counter).max(1);
+    let id = FRESH_ID.get().map_or(id, |fresh| fresh(&mut id.clone()));
+    *counter = (*counter).max(id.saturating_add(1));
+    id
+}
