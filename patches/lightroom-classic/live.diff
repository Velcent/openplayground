+//! Playground live editing (`playground_live`): the shared document is the library's catalog as JSON (every photo's
+//! develop settings, History, Versions, rating, flag, label and metadata; collections including saved Book, Print,
+//! Slideshow and Web creations, stacks, the keyword list, folder labels, the Map's saved locations), without what only
+//! this browser has (its preview index, sidecar stamps, links to its remote accounts, when it browsed Local folders and
+//! the photos seen there) and without views (selection, filter, sort, module, panels live outside the catalog). The
+//! originals of imported photos travel as session files named by their content hash, and land in this browser's
+//! storage as if imported here. Native undo history stays local; while connected Undo and Redo go to the session.
+//! Each person sees the others' selections outlined on grid and filmstrip cells and their pointer over a photo both
+//! have open, in their color with their name.
+//!
+//! Everything lives in new files: this one, `live_web.rs` (the host's side, a child of `web`) and a `live` module in
+//! the catalog, engine and UI crates. Playground's patches/lightroom-classic.yaml adds the one-line calls into them.
+
+use crate::store::{self, Originals};
+use lcc_engine::catalog::{Catalog, PhotoId, Source};
+use lcc_ui_egui::module::ModuleId;
+use lcc_ui_egui::state::ViewMode;
+use lcc_ui_egui::{CommandError, LccApp};
+use playground_live::{Live, Presence};
+use serde::Deserialize as _;
+use serde_json::Value;
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, BTreeSet, HashSet};
+
+#[path = "playground_live.rs"]
+#[allow(dead_code)]
+mod playground_live;
+
+#[cfg_attr(test, allow(dead_code))]
+pub const FORMAT: &str = concat!("lightroom-classic:1:", env!("CARGO_PKG_VERSION"));
+
+/// The catalog's own records of this browser: its previews index, its remote account links, its Local browsing.
+const OWN: [&str; 3] = ["browsed", "previews", "remote"];
+
+/// This browser's originals: the ones in memory, and the hashes known to be in its storage (`None`: no storage).
+#[derive(Default)]
+struct Media {
+    originals: Originals,
+    stored: Option<HashSet<String>>,
+}
+
+thread_local! {
+    static POINTER_DOWN: Cell<bool> = const { Cell::new(false) };
+    static MEDIA: RefCell<Media> = RefCell::default();
+    /// An original arrived from the session since the last frame.
+    static ARRIVED: Cell<bool> = const { Cell::new(false) };
+    /// Saved creations someone else saved since this person last opened them (album ids).
+    static STALE: RefCell<BTreeSet<u64>> = const { RefCell::new(BTreeSet::new()) };
+    /// An open command is running under [`command`]'s watch.
+    static OPENING: Cell<bool> = const { Cell::new(false) };
+    /// Where this person points on the photo they have open, as fractions of its frame.
+    static POINTER: Cell<Option<[f64; 2]>> = const { Cell::new(None) };
+    /// The others in the session, as the shell last gave them.
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+}
+
+/// The shared photo this person has open (the loupe, in Library or Develop).
+fn open_photo(app: &LccApp) -> Option<PhotoId> {
+    let loupe = matches!(app.ui.module, ModuleId::Library | ModuleId::Develop) && matches!(app.ui.view, ViewMode::Detail);
+    let active = app.session.selection.active.filter(|id| app.session.catalog.photo(*id).is_some_and(|p| !p.local));
+    loupe.then_some(active).flatten()
+}
+
+/// The end of a frame in the browser: notes where this person points on the open photo, draws the others' selections
+/// and pointers over the app, then [`frame`].
+#[cfg(target_arch = "wasm32")]
+pub fn end_frame(app: &mut LccApp, ctx: &egui::Context) {
+    let (down, at) = ctx.input(|i| (i.pointer.any_down(), i.pointer.hover_pos()));
+    let on = |r: egui::Rect| at.filter(|p| r.is_positive() && r.contains(*p) && app.canvas_rect.is_some_and(|c| c.contains(*p)));
+    let fraction = |p: egui::Pos2, r: egui::Rect| [(p.x - r.left()) / r.width(), (p.y - r.top()) / r.height()].map(|f| (f64::from(f) * 1e4).round() / 1e4);
+    POINTER.set(open_photo(app).and(app.image_rect).and_then(|r| Some(fraction(on(r)?, r))));
+    OTHERS.with_borrow(|others| show_others(app, ctx, others));
+    frame(app, down);
+}
+
+/// Each other person's selection outlined on grid and filmstrip cells, and their pointer over the photo when this
+/// person has the same one open, in their color with their name. Their states come from other people: what does not
+/// resolve is skipped.
+#[cfg(target_arch = "wasm32")]
+fn show_others(app: &LccApp, ctx: &egui::Context, others: &[Presence]) {
+    use egui::{Color32, FontId, Painter, Pos2, Rect, Shape, Stroke, StrokeKind, vec2};
+    fn tag(p: &Painter, at: Pos2, name: &str, color: Color32) {
+        let text = p.layout_no_wrap(name.chars().take(40).collect(), FontId::proportional(11.0), Color32::WHITE);
+        let r = Rect::from_min_size(at, text.size() + vec2(8.0, 4.0));
+        p.rect_filled(r, 3.0, color);
+        p.galley(r.min + vec2(4.0, 2.0), text, Color32::WHITE);
+    }
+    // over the panels, under menus and windows
+    let painter = ctx.layer_painter(egui::LayerId::background());
+    let area = |key: &str| app.widgets.iter().find(|(k, _)| k == key).map(|(_, r)| *r);
+    let (grid, strip) = (area("grid:scroll"), area("filmstrip"));
+    for (i, who) in others.iter().enumerate() {
+        let color = Color32::from_rgb(who.color[0], who.color[1], who.color[2]);
+        let selected: HashSet<u64> = who.state["selection"].as_array().into_iter().flatten().filter_map(Value::as_u64).collect();
+        for (key, r) in &app.widgets {
+            let clip = match key.split_once(':') {
+                Some(("thumb", id)) if id.parse().is_ok_and(|id| selected.contains(&id)) => grid,
+                Some(("film", id)) if id.parse().is_ok_and(|id| selected.contains(&id)) => strip,
+                _ => continue,
+            };
+            let Some(clip) = clip else { continue };
+            let p = painter.with_clip_rect(clip.intersect(*r));
+            // one inside the other when several people select the same photo
+            let inner = r.shrink(1.0 + 3.0 * i.min(8) as f32);
+            p.rect_stroke(inner, 0.0, Stroke::new(2.0, color), StrokeKind::Inside);
+            tag(&p, inner.min + vec2(3.0, 3.0), &who.name, color);
+        }
+        let pointer = who.state["pointer"].as_array().map(|xy| xy.iter().filter_map(Value::as_f64).collect::<Vec<_>>());
+        if let (Some(photo), Some(image), Some(canvas), Some(&[x, y])) = (open_photo(app), app.image_rect, app.canvas_rect, pointer.as_deref())
+            && who.state["page"].as_u64() == Some(photo.0)
+            && (0.0..=1.0).contains(&x)
+            && (0.0..=1.0).contains(&y)
+        {
+            let at = image.min + vec2(x as f32 * image.width(), y as f32 * image.height());
+            let p = painter.with_clip_rect(canvas);
+            p.add(Shape::convex_polygon(vec![at, at + vec2(0.0, 16.0), at + vec2(11.0, 11.0)], color, Stroke::new(1.0, Color32::WHITE)));
+            tag(&p, at + vec2(10.0, 14.0), &who.name, color);
+        }
+    }
+}
+
+/// The end of a frame.
+pub fn frame(app: &mut LccApp, pointer_down: bool) {
+    POINTER_DOWN.set(pointer_down);
+    if ARRIVED.take() {
+        // failed renders are retried once the catalog changes (as after a relink); the document itself stays as it is
+        app.session.catalog.revision = app.session.catalog.revision.wrapping_add(1);
+    }
+    // while live, automatic versions are for the photos this person edited (others' are theirs to keep)
+    lcc_engine::live::set_live(playground_live::connected());
+    playground_live::frame(app);
+}
+
+/// Offers live editing to the Playground shell (nothing happens until it connects), once the stored originals are known.
+#[cfg(target_arch = "wasm32")]
+pub async fn attach(
+    with_app: impl Fn(&mut dyn FnMut(&mut LccApp)) -> bool + 'static,
+    repaint: impl Fn() + 'static,
+    (originals, backend): (Originals, Option<crate::backend::Backend>),
+) {
+    let stored = match &backend {
+        Some(b) => Some(b.list("originals").await.unwrap_or_else(|e| {
+            log::warn!("listing the stored originals: {e}");
+            Vec::new()
+        })),
+        None => None,
+    };
+    MEDIA.set(Media { originals: originals.clone(), stored: stored.map(|s| s.into_iter().collect()) });
+    let _ = lcc_engine::catalog::live::FRESH_ID.set(playground_live::fresh_id);
+    let _ = lcc_ui_egui::live::COMMAND.set(command);
+    if let Err(e) = playground_live::web::attach::<LccApp>(FORMAT, with_app, repaint).and_then(|()| media(originals, backend)) {
+        log::error!("live editing unavailable: {e:?}");
+    }
+}
+
+/// Originals live in asynchronous browser storage: the adapter's `readAsset` and `writeAsset` return promises. One that
+/// arrives is stored and kept in memory as the import does, without touching the catalog or the undo history.
+#[cfg(target_arch = "wasm32")]
+fn media(originals: Originals, backend: Option<crate::backend::Backend>) -> Result<(), wasm_bindgen::JsValue> {
+    use js_sys::{Promise, Reflect, Uint8Array};
+    use wasm_bindgen::prelude::*;
+    use wasm_bindgen_futures::future_to_promise;
+    let adapter = Reflect::get(&js_sys::global(), &"playgroundLiveAdapter".into())?;
+    let (o, b) = (originals.clone(), backend.clone());
+    let read = move |id: String| {
+        let (originals, backend) = (o.clone(), b.clone());
+        future_to_promise(async move {
+            let path = store::original_path(&id, "original");
+            if let Some(bytes) = originals.contains(&path).then(|| originals.get(&path)).flatten() {
+                return Ok(Uint8Array::from(&bytes[..]).into());
+            }
+            let bytes = match &backend {
+                Some(b) => b.read(&store::storage_key(&id)).await?,
+                None => None,
+            };
+            Ok(Uint8Array::from(&bytes.ok_or("Missing media")?[..]).into())
+        })
+    };
+    Reflect::set(&adapter, &"readAsset".into(), &Closure::<dyn Fn(String) -> Promise>::new(read).into_js_value())?;
+    let write = move |id: String, name: String, bytes: Uint8Array| {
+        let (originals, backend) = (originals.clone(), backend.clone());
+        future_to_promise(async move {
+            let bytes = bytes.to_vec();
+            // the storage is named by content: anything else under this name would be another photo
+            if store::content_hash(&bytes) != id {
+                return Err(format!("{name} is not the photo the library refers to").into());
+            }
+            if let Some(b) = &backend {
+                b.write(&store::storage_key(&id), &bytes).await?;
+            }
+            originals.insert(&id, bytes.into());
+            MEDIA.with_borrow_mut(|m| m.stored.as_mut().map(|s| s.insert(id)));
+            ARRIVED.set(true);
+            crate::web::request_repaint();
+            Ok(JsValue::UNDEFINED)
+        })
+    };
+    Reflect::set(&adapter, &"writeAsset".into(), &Closure::<dyn Fn(String, String, Uint8Array) -> Promise>::new(write).into_js_value())?;
+    Ok(())
+}
+
+/// The commands live editing takes over or watches: while connected, Undo and Redo go to the session (but the Presets
+/// panel's own), and a saved creation someone else saved since this person opened it is not saved over.
+fn command(app: &mut LccApp, id: &str, params: &Value) -> Option<Result<Value, CommandError>> {
+    match id {
+        "edit.undo" | "edit.redo" if !lcc_ui_egui::live::is_native() => playground_live::undo(id == "edit.redo").then_some(Ok(Value::Null)),
+        "creation.update" if playground_live::connected() => {
+            let id = params["id"].as_u64().filter(|id| STALE.with_borrow(|s| s.contains(id)))?;
+            let creation = app.session.catalog.album(lcc_engine::catalog::AlbumId(id)).and_then(|a| a.creation.as_ref());
+            let what = creation.and_then(|c| lcc_engine::creations::kind_of(&c.kind)).map_or("creation", |k| k.label());
+            let msg = format!("someone else saved this {what} since you opened it: open it again to see theirs, or save yours under another name");
+            Some(Err(lcc_engine::EngineError::BadParams { cmd: "creation.update".into(), msg }.into()))
+        }
+        "creation.get" | "creation.open" | "slideshow.openSaved" if !OPENING.get() => {
+            OPENING.set(true);
+            let r = app.run_typed(id, params.clone());
+            OPENING.set(false);
+            // what this person has open now is the creation as stored
+            if let Some(id) = r.as_ref().ok().and_then(|v| v.get("id").or_else(|| v.get("openId"))).and_then(Value::as_u64) {
+                STALE.with_borrow_mut(|s| s.remove(&id));
+            }
+            Some(r)
+        }
+        _ => None,
+    }
+}
+
+/// The library folder of a Playground session (`?pg-session=<room id>`, a lowercase UUID): its own, so joining a session
+/// never touches this browser's library. `None` for anything else.
+pub fn session_library_dir(room: &str) -> Option<String> {
+    let uuid = room.len() == 36
+        && room.char_indices().all(|(i, c)| if matches!(i, 8 | 13 | 18 | 23) { c == '-' } else { matches!(c, '0'..='9' | 'a'..='f') });
+    uuid.then(|| format!("library-session-{room}"))
+}
+
+/// The content hash naming the original a photo's source refers to (demo scenes have none).
+fn original(path: &str) -> Option<&str> {
+    store::hash_of_path(path).filter(|h| crate::backup::valid_hash(h))
+}
+
+/// A photo record only this browser has: seen while browsing a Local folder, not in the library.
+fn own(photo: &Value) -> bool {
+    photo.get("local") == Some(&Value::Bool(true))
+}
+
+/// The ids of this browser's own photo records.
+fn own_ids(catalog: &Value) -> Vec<Value> {
+    catalog["photos"].as_object().map_or_else(Vec::new, |photos| photos.values().filter(|p| own(p)).map(|p| p["id"].clone()).collect())
+}
+
+/// The catalog a shared document holds, refusing one that does not hold together (concurrent stacks sharing a photo,
+/// folders moved into each other): every peer would repair it, each proposing the same fix.
+fn catalog(document: &Value) -> Result<Catalog, String> {
+    let catalog = Catalog::deserialize(document).map_err(|e| format!("Conflict: {e}"))?;
+    match catalog.clone().repair().first() {
+        Some(problem) => Err(format!("Conflict: {problem}")),
+        None => Ok(catalog),
+    }
+}
+
+impl Live for LccApp {
+    const COUNTERS: &'static [&'static str] = &["next_photo", "next_album", "next_stack"];
+
+    fn live_document(&self) -> Value {
+        let mut doc = serde_json::to_value(&self.session.catalog).unwrap_or(Value::Null);
+        let local = own_ids(&doc);
+        if let Some(c) = doc.as_object_mut() {
+            OWN.iter().for_each(|k| _ = c.remove(*k));
+            if let Some(photos) = c.get_mut("photos").and_then(Value::as_object_mut) {
+                photos.retain(|_, p| !own(p));
+                // the sidecar stamps say what this device's files were
+                photos.values_mut().filter_map(Value::as_object_mut).for_each(|p| _ = p.remove("xmp"));
+            }
+            // stacks hold library photos only; one left with fewer than two is this browser's own
+            if let Some(stacks) = c.get_mut("stacks").and_then(Value::as_object_mut) {
+                stacks.retain(|_, st| {
+                    let Some(photos) = st.get_mut("photos").and_then(Value::as_array_mut) else { return true };
+                    let before = photos.len();
+                    photos.retain(|id| !local.contains(id));
+                    photos.len() == before || photos.len() >= 2
+                });
+                if stacks.is_empty() {
+                    // as the catalog writes none
+                    c.remove("stacks");
+                }
+            }
+        }
+        doc
+    }
+
+    fn live_adopt(&mut self, mut document: Value) -> Result<(), String> {
+        Self::live_check(&document)?;
+        let mine = serde_json::to_value(&self.session.catalog).map_err(|e| e.to_string())?;
+        let local = own_ids(&mine);
+        if let (Some(doc), Some(mine)) = (document.as_object_mut(), mine.as_object()) {
+            for k in OWN {
+                if let Some(v) = mine.get(k) {
+                    doc.insert(k.into(), v.clone());
+                }
+            }
+            if let (Some(photos), Some(old)) = (doc.get_mut("photos").and_then(Value::as_object_mut), mine.get("photos").and_then(Value::as_object)) {
+                for (id, p) in old {
+                    if own(p) {
+                        photos.entry(id.clone()).or_insert_with(|| p.clone());
+                    } else if let (Some(xmp), Some(new)) = (p.get("xmp"), photos.get_mut(id).and_then(Value::as_object_mut)) {
+                        new.insert("xmp".into(), xmp.clone());
+                    }
+                }
+            }
+            // this browser's photos go back into its stacks: the shared stack, or its own one
+            if let Some(old) = mine.get("stacks").and_then(Value::as_object) {
+                let stacks = doc.entry("stacks").or_insert_with(|| Value::Object(Default::default()));
+                for (id, st) in old {
+                    let Some(photos) = st["photos"].as_array() else { continue };
+                    let (theirs, ours): (Vec<&Value>, Vec<&Value>) = photos.iter().partition(|p| !local.contains(p));
+                    if ours.is_empty() {
+                        continue;
+                    }
+                    match stacks.get_mut(id).and_then(|s| s["photos"].as_array_mut()) {
+                        Some(shared) => shared.extend(ours.into_iter().filter(|p| !shared.contains(p)).cloned().collect::<Vec<_>>()),
+                        None if theirs.len() < 2 => _ = stacks.as_object_mut().map(|s| s.insert(id.clone(), st.clone())),
+                        None => {}
+                    }
+                }
+            }
+        }
+        // checked as shared above; this browser's own records need no repair to be its own
+        let catalog = Catalog::deserialize(&document).map_err(|e| format!("Conflict: {e}"))?;
+        STALE.with_borrow_mut(|stale| {
+            for a in catalog.albums() {
+                let mine = self.session.catalog.album(a.id).and_then(|a| a.creation.as_ref()).map(|c| &c.document);
+                if a.creation.as_ref().is_some_and(|c| Some(&c.document) != mine) {
+                    stale.insert(a.id.0);
+                }
+            }
+        });
+        self.session.adopt_catalog(catalog);
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        !POINTER_DOWN.get()
+            && !self.text_focus
+            && self.session.interaction.is_none()
+            && self.gesture.is_none()
+            && self.brush_live.is_none()
+            && self.import.is_none()
+            && self.ui.name_edit.is_none()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.session.catalog.revision)
+    }
+
+    fn live_disconnected(&mut self) {
+        self.session.undo.clear();
+        self.session.redo.clear();
+    }
+
+    fn live_check(document: &Value) -> Result<(), String> {
+        catalog(document).map(drop)
+    }
+
+    /// The originals the shared photos were imported from, by content hash.
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        MEDIA.with_borrow_mut(|Media { originals, stored }| {
+            let mut out = BTreeMap::new();
+            for p in self.session.catalog.photos().filter(|p| !p.local) {
+                let Source::File { path } = &p.source else { continue };
+                let Some(hash) = original(path) else { continue };
+                // in memory means stored too: imports and loads keep only what storage took
+                let in_memory = originals.contains(path);
+                if let (true, Some(stored)) = (in_memory, stored.as_mut()) {
+                    stored.insert(hash.to_string());
+                }
+                let have = in_memory || stored.as_ref().is_some_and(|s| s.contains(hash));
+                out.entry(hash.to_string()).or_insert((p.file_name.clone(), have));
+            }
+            out.into_iter().map(|(hash, (name, have))| (hash, name, have)).collect()
+        })
+    }
+
+    /// `{ page: "library" | the shared photo open in the loupe, pointer: [x, y] on it (fractions of its frame),
+    /// selection: the first 50 selected shared photos }`.
+    fn live_presence(&self) -> Value {
+        let catalog = &self.session.catalog;
+        let shared = self.session.selection.ids.iter().filter(|id| catalog.photo(**id).is_some_and(|p| !p.local));
+        let mut state = serde_json::json!({"page": "library", "selection": shared.take(50).map(|id| id.0).collect::<Vec<_>>()});
+        if let Some(photo) = open_photo(self) {
+            state["page"] = photo.0.into();
+            if let Some(at) = POINTER.get() {
+                state["pointer"] = serde_json::json!(at);
+            }
+        }
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        let photos = document["photos"].as_object().into_iter().flat_map(|p| p.values()).filter(|p| !own(p));
+        let paths = photos.filter(|p| p["source"]["type"] == "file").filter_map(|p| p["source"]["path"].as_str());
+        paths.filter_map(original).map(str::to_string).collect::<std::collections::BTreeSet<_>>().into_iter().collect()
+    }
+}
