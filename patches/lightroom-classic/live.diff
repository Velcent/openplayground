@@ -0,0 +1,260 @@
+//! Playground live editing (`playground_live`): the shared document is the library's catalog as JSON (every photo's
+//! develop settings, History, Versions, rating, flag, label and metadata; collections including saved Book, Print,
+//! Slideshow and Web creations, stacks, the keyword list, folder labels, the Map's saved locations), without what only
+//! this browser has (its preview index, sidecar stamps, links to its remote accounts, when it browsed Local folders and
+//! the photos seen there) and without views (selection, filter, sort, module, panels live outside the catalog). The
+//! photos' original files are not shared: a photo imported by someone else shows as missing here. Native undo history
+//! stays local; while connected Undo and Redo go to the session.
+
+use crate::playground_live::{self, Live};
+use lcc_engine::catalog::Catalog;
+use lcc_ui_egui::LccApp;
+use serde::Deserialize as _;
+use serde_json::Value;
+use std::cell::Cell;
+
+pub const FORMAT: &str = concat!("lightroom-classic:1:", env!("CARGO_PKG_VERSION"));
+
+/// The catalog's own records of this browser: its previews index, its remote account links, its Local browsing.
+const OWN: [&str; 3] = ["browsed", "previews", "remote"];
+
+thread_local! {
+    static POINTER_DOWN: Cell<bool> = const { Cell::new(false) };
+}
+
+/// The end of a frame.
+pub fn frame(app: &mut LccApp, pointer_down: bool) {
+    POINTER_DOWN.set(pointer_down);
+    // while live, automatic versions are for the photos this person edited (others' are theirs to keep)
+    if playground_live::connected() != app.session.own_edits.is_some() {
+        app.session.own_edits = playground_live::connected().then(Default::default);
+    }
+    playground_live::frame(app);
+}
+
+/// Offers live editing to the Playground shell (nothing happens until it connects).
+#[cfg(target_arch = "wasm32")]
+pub fn attach(with_app: impl Fn(&mut dyn FnMut(&mut LccApp)) -> bool + 'static, repaint: impl Fn() + 'static) {
+    let _ = lcc_engine::catalog::FRESH_ID.set(playground_live::fresh_id);
+    let _ = lcc_ui_egui::UNDO.set(playground_live::undo);
+    let _ = lcc_ui_egui::LIVE.set(playground_live::connected);
+    if let Err(e) = playground_live::web::attach::<LccApp>(FORMAT, with_app, repaint) {
+        log::error!("live editing unavailable: {e:?}");
+    }
+}
+
+/// A photo record only this browser has: seen while browsing a Local folder, not in the library.
+fn own(photo: &Value) -> bool {
+    photo.get("local") == Some(&Value::Bool(true))
+}
+
+/// The ids of this browser's own photo records.
+fn own_ids(catalog: &Value) -> Vec<Value> {
+    catalog["photos"].as_object().map_or_else(Vec::new, |photos| photos.values().filter(|p| own(p)).map(|p| p["id"].clone()).collect())
+}
+
+/// The catalog a shared document holds, refusing one that does not hold together (concurrent stacks sharing a photo,
+/// folders moved into each other): every peer would repair it, each proposing the same fix.
+fn catalog(document: &Value) -> Result<Catalog, String> {
+    let catalog = Catalog::deserialize(document).map_err(|e| format!("Conflict: {e}"))?;
+    match catalog.clone().repair().first() {
+        Some(problem) => Err(format!("Conflict: {problem}")),
+        None => Ok(catalog),
+    }
+}
+
+impl Live for LccApp {
+    const COUNTERS: &'static [&'static str] = &["next_photo", "next_album", "next_stack"];
+
+    fn live_document(&self) -> Value {
+        let mut doc = serde_json::to_value(&self.session.catalog).unwrap_or(Value::Null);
+        let local = own_ids(&doc);
+        if let Some(c) = doc.as_object_mut() {
+            OWN.iter().for_each(|k| _ = c.remove(*k));
+            if let Some(photos) = c.get_mut("photos").and_then(Value::as_object_mut) {
+                photos.retain(|_, p| !own(p));
+                // the sidecar stamps say what this device's files were
+                photos.values_mut().filter_map(Value::as_object_mut).for_each(|p| _ = p.remove("xmp"));
+            }
+            // stacks hold library photos only; one left with fewer than two is this browser's own
+            if let Some(stacks) = c.get_mut("stacks").and_then(Value::as_object_mut) {
+                stacks.retain(|_, st| {
+                    let Some(photos) = st.get_mut("photos").and_then(Value::as_array_mut) else { return true };
+                    let before = photos.len();
+                    photos.retain(|id| !local.contains(id));
+                    photos.len() == before || photos.len() >= 2
+                });
+                if stacks.is_empty() {
+                    // as the catalog writes none
+                    c.remove("stacks");
+                }
+            }
+        }
+        doc
+    }
+
+    fn live_adopt(&mut self, mut document: Value) -> Result<(), String> {
+        Self::live_check(&document)?;
+        let mine = serde_json::to_value(&self.session.catalog).map_err(|e| e.to_string())?;
+        let local = own_ids(&mine);
+        if let (Some(doc), Some(mine)) = (document.as_object_mut(), mine.as_object()) {
+            for k in OWN {
+                if let Some(v) = mine.get(k) {
+                    doc.insert(k.into(), v.clone());
+                }
+            }
+            if let (Some(photos), Some(old)) = (doc.get_mut("photos").and_then(Value::as_object_mut), mine.get("photos").and_then(Value::as_object)) {
+                for (id, p) in old {
+                    if own(p) {
+                        photos.entry(id.clone()).or_insert_with(|| p.clone());
+                    } else if let (Some(xmp), Some(new)) = (p.get("xmp"), photos.get_mut(id).and_then(Value::as_object_mut)) {
+                        new.insert("xmp".into(), xmp.clone());
+                    }
+                }
+            }
+            // this browser's photos go back into its stacks: the shared stack, or its own one
+            if let Some(old) = mine.get("stacks").and_then(Value::as_object) {
+                let stacks = doc.entry("stacks").or_insert_with(|| Value::Object(Default::default()));
+                for (id, st) in old {
+                    let Some(photos) = st["photos"].as_array() else { continue };
+                    let (theirs, ours): (Vec<&Value>, Vec<&Value>) = photos.iter().partition(|p| !local.contains(p));
+                    if ours.is_empty() {
+                        continue;
+                    }
+                    match stacks.get_mut(id).and_then(|s| s["photos"].as_array_mut()) {
+                        Some(shared) => shared.extend(ours.into_iter().filter(|p| !shared.contains(p)).cloned().collect::<Vec<_>>()),
+                        None if theirs.len() < 2 => _ = stacks.as_object_mut().map(|s| s.insert(id.clone(), st.clone())),
+                        None => {}
+                    }
+                }
+            }
+        }
+        // checked as shared above; this browser's own records need no repair to be its own
+        self.session.adopt_catalog(Catalog::deserialize(&document).map_err(|e| format!("Conflict: {e}"))?);
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        !POINTER_DOWN.get()
+            && !self.text_focus
+            && self.session.interaction.is_none()
+            && self.gesture.is_none()
+            && self.brush_live.is_none()
+            && self.import.is_none()
+            && self.ui.name_edit.is_none()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.session.catalog.revision)
+    }
+
+    fn live_disconnected(&mut self) {
+        self.session.undo.clear();
+        self.session.redo.clear();
+    }
+
+    fn live_check(document: &Value) -> Result<(), String> {
+        catalog(document).map(drop)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use lcc_engine::Session;
+    use lcc_engine::catalog::{Op, Photo, PreviewEntry, Source, Stack};
+    use lcc_ui_egui::Services;
+    use playground_live::canonical;
+    use serde_json::json;
+
+    fn demo() -> LccApp {
+        let mut s = Session::new();
+        lcc_engine::demo::load(&mut s);
+        LccApp::new(s, Services::default())
+    }
+
+    #[test]
+    fn shares_the_catalog_without_views_adopts_it_without_an_undo_step_and_waits_for_a_gesture() -> Result<(), String> {
+        let _ = lcc_engine::catalog::FRESH_ID.set(playground_live::fresh_id);
+        let (mut a, mut b) = (demo(), demo());
+        playground_live::connect();
+        // A browsed a Local folder and built a preview: its records of those are its own, like its views.
+        let mut seen = Photo::new(a.session.catalog.alloc_photo_id(), Source::Demo { scene: 1 }, "seen.jpg", "JPEG", 9, 9, "2026-01-01T00:00:00");
+        seen.local = true;
+        a.session.catalog.apply(Op::AddPhoto { photo: Box::new(seen.clone()) }).map_err(|e| e.to_string())?;
+        let first = a.session.selection.active.ok_or("no active photo")?;
+        // ... and stacked it with a library photo: the stack stays its own too
+        let stack = Stack { id: a.session.catalog.alloc_stack_id(), photos: vec![first, seen.id], collapsed: false };
+        a.session.catalog.apply(Op::AddStack { stack }).map_err(|e| e.to_string())?;
+        let preview = PreviewEntry { size: 1024, one_to_one: false, settings_hash: 7, built_at: "2026-01-01T00:00:00".into() };
+        a.session.catalog.apply(Op::SetPreview { id: first, entry: Some(preview) }).map_err(|e| e.to_string())?;
+        let start = canonical(&a.live_document());
+        assert!(!String::from_utf8_lossy(&start).contains("seen.jpg") && !String::from_utf8_lossy(&start).contains("previews"));
+        assert!(!String::from_utf8_lossy(&start).contains("stacks") && LccApp::live_check(&playground_live::parse(&start)?).is_ok());
+        a.run("library.next", json!({}))?;
+        assert_eq!(canonical(&a.live_document()), start, "views are not shared");
+        let (selected, undo_steps) = (a.session.selection.clone(), a.session.undo.len());
+        // A merge that no longer holds together (two stacks sharing a photo) is refused, not repaired by every peer.
+        let mut stacked = playground_live::parse(&start)?;
+        stacked["stacks"] = json!({"1": {"id": 1, "photos": [1, 2]}, "2": {"id": 2, "photos": [2, 3]}});
+        assert!(LccApp::live_check(&playground_live::parse(&start)?).is_ok() && LccApp::live_check(&stacked).is_err());
+        assert!(LccApp::live_check(&Value::Null).is_err());
+
+        // B joins with the whole library, then rates a photo A is not on; A merges it at a quiet frame, keeping its
+        // selection, its own records and its undo history.
+        b.live_adopt(playground_live::parse(&start)?)?;
+        assert_eq!((canonical(&b.live_document()), b.session.undo.len()), (start.clone(), 0));
+        let other = b.session.catalog.photos().map(|p| p.id).find(|id| Some(*id) != selected.active).ok_or("no photo")?;
+        b.run("photo.rate", json!({"rating": 5, "ids": [other.0]}))?;
+        let edited = canonical(&b.live_document());
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(start), edited.clone(), Box::new(move |r| to.set(r.is_ok())));
+        a.session.begin_interaction("Exposure").map_err(|e| e.to_string())?;
+        playground_live::frame(&mut a);
+        assert!(!done.get(), "a slider drag holds remote changes");
+        a.session.end_interaction().map_err(|e| e.to_string())?;
+        playground_live::frame(&mut a);
+        assert!(done.get());
+        assert_eq!(canonical(&a.live_document()), edited);
+        assert_eq!(a.session.catalog.photo(other).map(|p| p.rating), Some(5));
+        assert_eq!(a.session.catalog.photo(seen.id).map(|p| p.file_name.as_str()), Some("seen.jpg"));
+        assert!(serde_json::to_value(&a.session.catalog).map_err(|e| e.to_string())?["previews"].get(first.0.to_string()).is_some());
+        assert_eq!(a.session.catalog.stack_of(seen.id).map(|s| s.photos.clone()), Some(vec![first, seen.id]));
+        assert_eq!((a.session.selection.clone(), a.session.undo.len()), (selected, undo_steps));
+
+        // New ids are this peer's own; the counter goes past them, so the catalog needs no repair.
+        assert!(seen.id.0 >> 52 == 1 && a.session.catalog.alloc_album_id().0 >> 52 == 1 && a.session.catalog.repair().is_empty());
+        // A shared library whose counters never saw A's own photo (a session joined) still installs, keeping it.
+        a.live_adopt(demo().live_document())?;
+        assert!(a.session.catalog.photo(seen.id).is_some());
+        playground_live::disconnect();
+        Ok(())
+    }
+
+    #[test]
+    fn while_live_leaving_a_photo_versions_only_this_persons_edits() -> Result<(), String> {
+        let (mut a, mut b) = (demo(), demo());
+        playground_live::connect();
+        frame(&mut a, false);
+        let versions = |app: &LccApp, id| app.session.catalog.photo(id).map_or(0, |p| p.versions.len());
+        // B edits the photo A is on; A steps away from it: no automatic version of B's edit from A.
+        let x = a.session.active().ok_or("no active photo")?;
+        b.run("library.select", json!({"ids": [x.0]}))?;
+        b.run("develop.set", json!({"values": {"light.exposure": 0.5}}))?;
+        a.live_adopt(b.live_document())?;
+        let before = versions(&a, x);
+        a.run("library.next", json!({}))?;
+        assert_eq!(versions(&a, x), before, "someone else's edit is theirs to version");
+        // A's own edit is versioned when A leaves the photo, as before.
+        let y = a.session.active().ok_or("no active photo")?;
+        a.run("develop.set", json!({"values": {"light.exposure": 0.25}}))?;
+        let before = versions(&a, y);
+        a.run("library.next", json!({}))?;
+        assert_eq!(versions(&a, y), before + 1);
+        playground_live::disconnect();
+        frame(&mut a, false);
+        assert!(a.session.own_edits.is_none(), "not live: every edited photo again");
+        Ok(())
+    }
+}
