+        seen.local = true;
+        a.session.catalog.apply(Op::AddPhoto { photo: Box::new(seen.clone()) }).map_err(|e| e.to_string())?;
+        let first = a.session.selection.active.ok_or("no active photo")?;
+        // ... and stacked it with a library photo: the stack stays its own too
+        let stack = Stack { id: a.session.catalog.alloc_stack_id(), photos: vec![first, seen.id], collapsed: false };
+        a.session.catalog.apply(Op::AddStack { stack }).map_err(|e| e.to_string())?;
+        let preview = PreviewEntry { size: 1024, one_to_one: false, settings_hash: 7, built_at: "2026-01-01T00:00:00".into() };
+        a.session.catalog.apply(Op::SetPreview { id: first, entry: Some(preview) }).map_err(|e| e.to_string())?;
+        let start = canonical(&a.live_document());
+        assert!(!String::from_utf8_lossy(&start).contains("seen.jpg") && !String::from_utf8_lossy(&start).contains("previews"));
+        assert!(!String::from_utf8_lossy(&start).contains("stacks") && LccApp::live_check(&playground_live::parse(&start)?).is_ok());
+        a.run("library.next", json!({}))?;
+        assert_eq!(canonical(&a.live_document()), start, "views are not shared");
+        let (selected, undo_steps) = (a.session.selection.clone(), a.session.undo.len());
+        // A merge that no longer holds together (two stacks sharing a photo) is refused, not repaired by every peer.
+        let mut stacked = playground_live::parse(&start)?;
+        stacked["stacks"] = json!({"1": {"id": 1, "photos": [1, 2]}, "2": {"id": 2, "photos": [2, 3]}});
+        assert!(LccApp::live_check(&playground_live::parse(&start)?).is_ok() && LccApp::live_check(&stacked).is_err());
+        assert!(LccApp::live_check(&Value::Null).is_err());
+
+        // B joins with the whole library, then rates a photo A is not on; A merges it at a quiet frame, keeping its
+        // selection, its own records and its undo history.
+        b.live_adopt(playground_live::parse(&start)?)?;
+        assert_eq!((canonical(&b.live_document()), b.session.undo.len()), (start.clone(), 0));
+        let other = b.session.catalog.photos().map(|p| p.id).find(|id| Some(*id) != selected.active).ok_or("no photo")?;
+        b.run("photo.rate", json!({"rating": 5, "ids": [other.0]}))?;
+        let edited = canonical(&b.live_document());
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(start), edited.clone(), Box::new(move |r| to.set(r.is_ok())));
+        a.session.begin_interaction("Exposure").map_err(|e| e.to_string())?;
+        playground_live::frame(&mut a);
+        assert!(!done.get(), "a slider drag holds remote changes");
+        a.session.end_interaction().map_err(|e| e.to_string())?;
+        playground_live::frame(&mut a);
+        assert!(done.get());
+        assert_eq!(canonical(&a.live_document()), edited);
+        assert_eq!(a.session.catalog.photo(other).map(|p| p.rating), Some(5));
+        assert_eq!(a.session.catalog.photo(seen.id).map(|p| p.file_name.as_str()), Some("seen.jpg"));
+        assert!(serde_json::to_value(&a.session.catalog).map_err(|e| e.to_string())?["previews"].get(first.0.to_string()).is_some());
+        assert_eq!(a.session.catalog.stack_of(seen.id).map(|s| s.photos.clone()), Some(vec![first, seen.id]));
+        assert_eq!((a.session.selection.clone(), a.session.undo.len()), (selected, undo_steps));
+
+        // New ids are this peer's own; the counter goes past them, so the catalog needs no repair.
+        assert!(seen.id.0 >> 52 == 1 && a.session.catalog.alloc_album_id().0 >> 52 == 1 && a.session.catalog.repair().is_empty());
+        // A shared library whose counters never saw A's own photo (a session joined) still installs, keeping it.
+        a.live_adopt(demo().live_document())?;
+        assert!(a.session.catalog.photo(seen.id).is_some());
+        playground_live::disconnect();
+        // An invitation's session opens a library of its own; nothing else names a library folder.
+        let room = "0f8e7d6c-5b4a-4321-8fed-cba987654321";
+        assert!(session_library_dir(room).is_some_and(|d| d == format!("library-session-{room}") && crate::backup::valid_library_dir(&d)));
+        assert!([&room.to_uppercase(), "../library", "", &room[1..]].iter().all(|r| session_library_dir(r).is_none()));
+        Ok(())
+    }
+
+    #[test]
+    fn presence_is_the_open_photo_the_pointer_on_it_and_the_shared_selection() -> Result<(), String> {
+        let mut a = demo();
+        let ids: Vec<u64> = a.session.catalog.photos().map(|p| p.id.0).take(2).collect();
+        // a Local folder's photo is this person's own: the others are not shown it
+        let mut seen = Photo::new(a.session.catalog.alloc_photo_id(), Source::Demo { scene: 1 }, "seen.jpg", "JPEG", 9, 9, "2026-01-01T00:00:00");
+        seen.local = true;
+        a.session.catalog.apply(Op::AddPhoto { photo: Box::new(seen.clone()) }).map_err(|e| e.to_string())?;
+        a.run("library.select", json!({"ids": [ids[0], ids[1], seen.id.0]}))?;
+        POINTER.set(Some([0.25, 0.5]));
+        a.ui.view = ViewMode::PhotoGrid;
+        assert_eq!(a.live_presence(), json!({"page": "library", "selection": ids}), "no pointer outside the loupe");
+        a.ui.view = ViewMode::Detail;
+        let open = a.session.selection.active.ok_or("no active photo")?;
+        assert_eq!(a.live_presence(), json!({"page": open.0, "pointer": [0.25, 0.5], "selection": ids}));
+        Ok(())
+    }
+
+    #[test]
+    fn lists_the_shared_photos_originals_by_content_hash() -> Result<(), String> {
+        let mut a = demo();
+        let originals = Originals::default();
+        originals.install(&mut a.session);
+        MEDIA.set(Media { originals: originals.clone(), stored: Some(HashSet::new()) });
+        assert!(a.live_assets().is_empty() && LccApp::live_assets_of(&a.live_document()).is_empty(), "demo scenes have no original");
+        let bytes = store::png_bytes(8, 8);
+        let hash = store::content_hash(&bytes);
+        let path = originals.added("IMG 1.png", &hash, bytes.into());
+        a.run("library.import", json!({"paths": [path]}))?;
+        // a photo merely seen in a Local folder is this browser's own
+        let file = Source::File { path: store::original_path("123", "seen.png") };
+        let mut seen = Photo::new(a.session.catalog.alloc_photo_id(), file, "seen.png", "PNG", 8, 8, "2026-01-01T00:00:00");
+        seen.local = true;
+        a.session.catalog.apply(Op::AddPhoto { photo: Box::new(seen) }).map_err(|e| e.to_string())?;
+        assert_eq!(a.live_assets(), [(hash.clone(), "IMG 1.png".to_string(), true)]);
+        assert_eq!(LccApp::live_assets_of(&a.live_document()), [hash.clone()]);
+        // gone from memory, it is still in storage
+        MEDIA.with_borrow_mut(|m| m.originals = Originals::default());
+        assert_eq!(a.live_assets(), [(hash, "IMG 1.png".to_string(), true)]);
+        Ok(())
+    }
+
+    #[test]
+    fn while_live_leaving_a_photo_versions_only_this_persons_edits() -> Result<(), String> {
+        let (mut a, mut b) = (demo(), demo());
+        let versions = |app: &LccApp, id| app.session.catalog.photo(id).map_or(0, |p| p.versions.len());
+        // B edits the photo A is on (in B's browser); A steps away from it: no automatic version of B's edit from A.
+        let x = a.session.active().ok_or("no active photo")?;
+        b.run("library.select", json!({"ids": [x.0]}))?;
+        b.run("develop.set", json!({"values": {"light.exposure": 0.5}}))?;
+        playground_live::connect();
+        frame(&mut a, false);
+        a.live_adopt(b.live_document())?;
+        let before = versions(&a, x);
+        a.run("library.next", json!({}))?;
+        assert_eq!(versions(&a, x), before, "someone else's edit is theirs to version");
+        // A's own edit is versioned when A leaves the photo, as before.
+        let y = a.session.active().ok_or("no active photo")?;
+        a.run("develop.set", json!({"values": {"light.exposure": 0.25}}))?;
+        let before = versions(&a, y);
+        a.run("library.next", json!({}))?;
+        assert_eq!(versions(&a, y), before + 1);
+        playground_live::disconnect();
+        frame(&mut a, false);
+        assert!(!lcc_engine::live::is_live(), "not live: every edited photo again");
+        Ok(())
+    }
+
+    #[test]
+    fn while_live_undo_is_the_sessions_and_nothing_undoes_or_saves_over_someone_elses_change() -> Result<(), String> {
+        let _ = lcc_ui_egui::live::COMMAND.set(command);
+        let mut a = demo();
+        let ids: Vec<u64> = a.session.catalog.photos().take(2).map(|p| p.id.0).collect();
+        let id = a.run("creation.save", json!({"kind": "slideshow", "name": "Trip", "settings": {"a": 1}, "ids": ids}))?["id"].as_u64().ok_or("no id")?;
+        a.run("preset.apply", json!({"id": "lc.golden-hour"}))?;
+        let steps = a.session.undo.len();
+        playground_live::connect();
+        frame(&mut a, false);
+        // Undo goes to the session; the Presets panel's Amount still undoes its own step
+        a.run("edit.undo", json!({}))?;
+        assert_eq!((a.session.undo.len(), playground_live::activity().1), (steps, vec![false]));
+        {
+            let _native = lcc_ui_egui::live::native();
+            a.run("edit.undo", json!({}))?;
+            a.run("edit.redo", json!({}))?;
+        }
+        assert_eq!((a.session.undo.len(), a.session.redo.len()), (steps, 0));
+
+        // someone else's change: to another photo it leaves the preset's step alone, to this one it voids it
+        let theirs = |a: &LccApp, photo, creation: Option<u64>| -> Result<Value, String> {
+            let mut shared = a.session.catalog.clone();
+            let mut d = (*a.session.develop_of(photo).ok_or("no photo")?).clone();
+            d.light.exposure += 0.5;
+            shared.apply(Op::SetDevelop { id: photo, settings: std::sync::Arc::new(d), label: "Exposure".into(), edited: None }).map_err(|e| e.to_string())?;
+            let mut doc = serde_json::to_value(&shared).map_err(|e| e.to_string())?;
+            if let Some(c) = creation {
+                let saved = &mut doc["albums"][c.to_string()]["creation"]["document"];
+                let mut layout: Value = serde_json::from_str(saved.as_str().ok_or("no creation")?).map_err(|e| e.to_string())?;
+                layout["theirs"] = json!(true);
+                *saved = Value::String(layout.to_string());
+            }
+            Ok(doc)
+        };
+        let active = a.session.active().ok_or("no active photo")?;
+        let other = a.session.visible().iter().copied().find(|p| *p != active).ok_or("no other photo")?;
+        a.live_adopt(theirs(&a, other, None)?)?;
+        assert_eq!(a.session.undo.len(), steps, "another photo's change leaves the preset's step alone");
+        a.live_adopt(theirs(&a, active, Some(id))?)?;
+        assert!(a.session.undo.is_empty(), "undoing the preset now would drop someone else's change");
+
+        // and a save over a creation someone else saved since this person opened it is refused, until they open it again
+        let save = |a: &mut LccApp| a.run("creation.update", json!({"id": id, "settings": {"a": 3}}));
+        assert!(save(&mut a).is_err());
+        a.run("creation.get", json!({"id": id}))?;
+        save(&mut a)?;
+        playground_live::disconnect();
+        frame(&mut a, false);
+        Ok(())
+    }
+}
diff --git a/apps/web/src/live_web.rs b/apps/web/src/live_web.rs
new file mode 100644
index 0000000..257c670
--- /dev/null
+++ b/apps/web/src/live_web.rs
@@ -0,0 +1,68 @@
+//! Playground live editing in the browser host (Playground's patches/lightroom-classic.yaml declares this module in
+//! `web.rs`, wraps the app the web entry creates with [`wrap`] and opens [`session_library`]): the app runs inside
+//! [`Shared`], whose frames end with the others' presence drawn and the session's turn, and the live editing hooks
+//! reach it between frames. A
+//! Playground invitation's page (`?pg-session=<room id>`) opens a library of its own.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use super::{WebApp, request_repaint};
+
+/// The web app, shared with the live editing hooks.
+pub(super) struct Shared(Rc<RefCell<WebApp>>);
+
+/// The app with live editing offered to the Playground shell (nothing happens until it connects).
+pub(super) fn wrap(mut app: WebApp) -> Box<Shared> {
+    if session_library().is_some() {
+        // a restore would point this browser's own library at the backup
+        app.app.services.restore_library = None;
+    }
+    let media = (app.originals.clone(), app.backend.clone());
+    let app = Rc::new(RefCell::new(app));
+    let live = app.clone();
+    // between frames only: during one the app is busy
+    let with_app = move |f: &mut dyn FnMut(&mut lcc_ui_egui::LccApp)| live.try_borrow_mut().map(|mut w| f(&mut w.app)).is_ok();
+    wasm_bindgen_futures::spawn_local(crate::live::attach(with_app, request_repaint, media));
+    Box::new(Shared(app))
+}
+
+/// The library folder of this page's Playground session, if it is one.
+pub(super) fn session_library() -> Option<String> {
+    let search = web_sys::window()?.location().search().ok()?;
+    let room = search.trim_start_matches('?').split('&').find_map(|p| p.strip_prefix("pg-session="))?;
+    crate::live::session_library_dir(room)
+}
+
+// ponytail: `on_exit` is not passed on (its signature follows eframe's renderer feature); WebApp has none today
+impl eframe::App for Shared {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        eframe::App::logic(&mut *self.0.borrow_mut(), ctx, frame);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        let mut app = self.0.borrow_mut();
+        eframe::App::ui(&mut *app, ui, frame);
+        crate::live::end_frame(&mut app.app, ui.ctx());
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        eframe::App::raw_input_hook(&mut *self.0.borrow_mut(), ctx, raw_input);
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        eframe::App::save(&mut *self.0.borrow_mut(), storage);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        eframe::App::auto_save_interval(&*self.0.borrow())
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        eframe::App::clear_color(&*self.0.borrow(), visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        eframe::App::persist_egui_memory(&*self.0.borrow())
+    }
+}
diff --git a/crates/catalog/src/live.rs b/crates/catalog/src/live.rs
new file mode 100644
index 0000000..b4ef5c0
--- /dev/null
+++ b/crates/catalog/src/live.rs
@@ -0,0 +1,14 @@
+//! Playground live editing (Playground's patches/lightroom-classic.yaml calls [`alloc`] first thing in each
+//! `alloc_*_id`): while several people edit one library, each new id is one none of the others can pick. Only the web
+//! build sets [`FRESH_ID`]; without it ids come from the counters as always.
+
+/// Set by the web build for live editing: the id to use given the counter's next one.
+pub static FRESH_ID: std::sync::OnceLock<fn(&mut u64) -> u64> = std::sync::OnceLock::new();
+
+/// The id `counter` gives under [`FRESH_ID`] (the counter still goes past it); `None` without it.
+pub(crate) fn alloc(counter: &mut u64) -> Option<u64> {
+    let fresh = FRESH_ID.get()?;
+    let id = fresh(&mut (*counter).max(1));
+    *counter = (*counter).max(id.saturating_add(1));
+    Some(id)
+}
diff --git a/crates/engine/src/live.rs b/crates/engine/src/live.rs
new file mode 100644
index 0000000..e59c16b
--- /dev/null
+++ b/crates/engine/src/live.rs
@@ -0,0 +1,91 @@
+//! Playground live editing (Playground's patches/lightroom-classic.yaml calls [`committed`] first thing in
+//! [`Session::commit`] and [`not_mine`] in [`Session::auto_version`]): the web build installs other people's changes
+//! with [`Session::adopt_catalog`] and turns [`set_live`] on while a session is connected. Elsewhere nothing changes.
+
+use std::cell::RefCell;
+use std::collections::BTreeSet;
+
+use crate::Session;
+use lcc_catalog::{Catalog, Op, PhotoId};
+
+thread_local! {
+    /// While live: the photos whose develop settings this person committed since their last automatic version
+    /// (`None`: not live, every edited photo gets one when left). Others' edits are theirs to version.
+    // ponytail: one per thread, as the browser runs one session; a Session field if a host ever runs two live
+    static OWN_EDITS: RefCell<Option<BTreeSet<PhotoId>>> = const { RefCell::new(None) };
+}
+
+/// Live editing on or off; a change forgets the edits it knew.
+pub fn set_live(on: bool) {
+    OWN_EDITS.with_borrow_mut(|own| {
+        if own.is_some() != on {
+            *own = on.then(BTreeSet::new);
+        }
+    });
+}
+
+/// Whether live editing is on.
+pub fn is_live() -> bool {
+    OWN_EDITS.with_borrow(Option::is_some)
+}
+
+/// `op` is being committed as this person's step: while live, the photos it develops are their edits.
+pub(crate) fn committed(op: &Op) {
+    OWN_EDITS.with_borrow_mut(|own| {
+        if let Some(own) = own {
+            develops(op, &mut |id| _ = own.insert(id));
+        }
+    });
+}
+
+/// While live, leaving photo `id` keeps no automatic version of an edit that was not this person's.
+pub(crate) fn not_mine(id: PhotoId) -> bool {
+    OWN_EDITS.with_borrow_mut(|own| own.as_mut().is_some_and(|own| !own.remove(&id)))
+}
+
+/// Calls `f` with each photo `op` sets the develop settings of.
+fn develops(op: &Op, f: &mut impl FnMut(PhotoId)) {
+    match op {
+        Op::SetDevelop { id, .. } => f(*id),
+        Op::Batch { ops } => ops.iter().for_each(|op| develops(op, f)),
+        _ => {}
+    }
+}
+
+impl Session {
+    /// Live editing: install a catalog with other people's changes in it. No undo step; the selection keeps the photos
+    /// still there, and the library saves it whole (no op says what changed).
+    pub fn adopt_catalog(&mut self, mut catalog: Catalog) {
+        let mut redeveloped = BTreeSet::new();
+        for p in self.catalog.photos() {
+            let new = catalog.photo(p.id);
+            if new.is_none_or(|n| (&n.source, &n.content_hash) != (&p.source, &p.content_hash)) {
+                self.media.forget(p.id);
+            }
+            if new.is_none_or(|n| n.develop != p.develop) {
+                redeveloped.insert(p.id);
+            }
+            // the plug-in field index is this session's, never saved: it stays
+            if !p.plugin_fields.is_empty() {
+                let _ = catalog.set_plugin_fields(p.id, p.plugin_fields.clone());
+            }
+        }
+        // undoing a step of this person's own now would put back a photo someone else changed since (the Presets
+        // panel's Amount undoes its step to replace it): that history is void, as Undo is the session's while live
+        let mut touched = false;
+        if let Some(last) = self.undo.last() {
+            develops(&last.op, &mut |id| touched |= redeveloped.contains(&id));
+        }
+        if touched {
+            self.undo.clear();
+            self.redo.clear();
+        }
+        // caches keyed on the revision (the grid's list among them) see a new one, with nothing remembered of how it got there
+        catalog.revision = self.catalog.revision.wrapping_add(1);
+        self.catalog = catalog;
+        self.selection.ids.retain(|id| self.catalog.photo(*id).is_some());
+        self.selection.active = self.selection.active.filter(|id| self.catalog.photo(*id).is_some()).or_else(|| self.selection.ids.first().copied());
+        // ponytail: a whole snapshot per remote change, O(library); journal the photos that changed if big libraries lag
+        self.compact_soon();
+    }
+}
diff --git a/crates/ui-egui/src/live.rs b/crates/ui-egui/src/live.rs
new file mode 100644
index 0000000..516c6ed
--- /dev/null
+++ b/crates/ui-egui/src/live.rs
@@ -0,0 +1,69 @@
+//! Playground live editing (Playground's patches/lightroom-classic.yaml calls [`command`] first thing in
+//! `LccApp::run`, [`menu_item`] in the menu bar's items and [`native`] in the Presets panel): the hooks the web
+//! build's live editing fills in. Elsewhere nothing changes.
+
+use std::cell::Cell;
+
+use serde_json::Value;
+
+use crate::{CommandError, LccApp};
+
+/// Set by a host with live editing: it sees each command first and answers the ones it takes over (`None`: the app
+/// runs it).
+pub static COMMAND: std::sync::OnceLock<fn(&mut LccApp, &str, &Value) -> Option<Result<Value, CommandError>>> = std::sync::OnceLock::new();
+
+/// The hook's answer to a command, in the error type of the entry point it was called from (`run` or `run_typed`).
+pub(crate) fn command<E: Refusal>(app: &mut LccApp, id: &str, params: &Value) -> Option<Result<Value, E>> {
+    COMMAND.get().and_then(|hook| hook(app, id, params)).map(|r| r.map_err(E::from_refusal))
+}
+
+/// An entry point's error type.
+pub(crate) trait Refusal {
+    fn from_refusal(e: CommandError) -> Self;
+}
+
+impl Refusal for CommandError {
+    fn from_refusal(e: CommandError) -> Self {
+        e
+    }
+}
+
+impl Refusal for String {
+    fn from_refusal(e: CommandError) -> Self {
+        e.message
+    }
+}
+
+thread_local! {
+    static NATIVE: Cell<u32> = const { Cell::new(0) };
+}
+
+/// While it lives, Undo and Redo are this person's own steps, never the session's (the Presets panel's Amount replaces
+/// the step it made).
+pub struct Native(());
+
+impl Drop for Native {
+    fn drop(&mut self) {
+        NATIVE.set(NATIVE.get().saturating_sub(1));
+    }
+}
+
+pub fn native() -> Native {
+    NATIVE.set(NATIVE.get() + 1);
+    Native(())
+}
+
+/// Whether Undo and Redo are this person's own steps just now (see [`native`]).
+pub fn is_native() -> bool {
+    NATIVE.get() > 0
+}
+
+/// A menu item's label and state: while live, Undo and Redo are the session's, always offered and naming no step of
+/// this person's own history.
+pub(crate) fn menu_item(id: &str, label: String, enabled: bool) -> (String, bool) {
+    match id {
+        "edit.undo" if lcc_engine::live::is_live() => ("Undo".into(), true),
+        "edit.redo" if lcc_engine::live::is_live() => ("Redo".into(), true),
+        _ => (label, enabled),
+    }
+}
