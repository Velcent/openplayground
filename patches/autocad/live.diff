+//! Live editing in a Playground session (`patches/autocad.yaml` wires it in): handles and anonymous block names no one
+//! else in the session picks. Nothing changes until a session connects ([`playground_live::fresh_id`]).
+
+use crate::{Drawing, Handle, playground_live};
+
+impl Drawing {
+    /// [`Drawing::new_handle`] while connected: a random step past the counter, so people adding objects at once pick
+    /// different handles, and the counter (merged by maximum) stays above them all ("handle >= seed" means new).
+    pub(crate) fn live_handle(&mut self) -> Option<Handle> {
+        let seed = self.handseed;
+        let fresh = playground_live::fresh_id(&mut { seed });
+        if fresh == seed {
+            return None;
+        }
+        let h = seed.max(1 << 52) + (fresh & 0xFF_FFFF);
+        self.handseed = h + 1;
+        Some(Handle(h))
+    }
+
+    /// [`Drawing::anonymous_block_name`] while connected: each person numbers from their own random start, so names
+    /// added at once differ.
+    pub(crate) fn live_block_name(&self, prefix: &str) -> Option<String> {
+        let start = ((playground_live::fresh_id(&mut 0) >> 32) & 0xF_FFFF) * 1000;
+        if start == 0 {
+            return None;
+        }
+        let mut i = 1u64;
+        loop {
+            let n = format!("{prefix}{}", start + i);
+            if self.block(&n).is_none() || i > 1_000_000 {
+                return Some(n);
+            }
+            i += 1;
+        }
+    }
+}
