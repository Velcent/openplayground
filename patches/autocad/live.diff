+//! Live editing in a Playground session (`patches/autocad.yaml` wires it in): which open drawings the session shares,
+//! and their Undo and Redo, which go to the session.
+
+thread_local! {
+    /// The `uid`s of the open drawings a Playground session shares (none: no session).
+    pub static LIVE_UIDS: std::cell::RefCell<Vec<u64>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+#[cfg(target_arch = "wasm32")]
+impl crate::Session {
+    /// [`crate::Session::undo`] (`redo`: [`crate::Session::redo`]) in a drawing a Playground session shares: the
+    /// session takes back this person's last operation; the step here only names it (and keeps UNDO n, Back and MREDO
+    /// counting). `None`: not a shared drawing, nothing to undo, or no session.
+    pub(crate) fn live_undo(&mut self, redo: bool) -> Option<crate::Result<Option<String>>> {
+        let st = self.state_mut().ok()?;
+        let shared = LIVE_UIDS.with_borrow(|uids| uids.contains(&st.uid));
+        let (from, to) = if redo { (&mut st.redo, &mut st.undo) } else { (&mut st.undo, &mut st.redo) };
+        if !shared || from.is_empty() || !cadcraft_doc::playground_live::undo(redo) {
+            return None;
+        }
+        let snap = from.pop();
+        let label = snap.as_ref().map(|s| s.label.clone());
+        to.extend(snap);
+        Some(Ok(label))
+    }
+}
