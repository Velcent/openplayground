@@ -0,0 +1,924 @@
+//! Live editing in a Playground session (web only). The shared document is the set of drawings open in the session,
+//! `{ documents: [{ id, name, ...drawing }] }`: the one shown when the session started and every drawing opened,
+//! created or imported here or by the others since, which reaches the others as a tab behind theirs. Closing a tab is
+//! this person's own: the drawing stays in the session and up to date, and the Start page lists it to open again.
+//! A drawing is JSON: entities keyed by handle, table records, layouts and blocks by name. This person's current layer,
+//! colour, styles and other command defaults, the `*Active` viewport tiles, isolated objects, an in-place reference
+//! edit and the file data CADCraft does not model stay local, as do views and the selection (outside the drawing). A
+//! layout viewport's view is the sheet's, so shared.
+//! Presence: the drawing and space each person is on, their pointer, selection and the gesture under way (objects
+//! being moved or grip-edited as ghosts, a command's rubber band, a selection window), drawn on the canvas in their
+//! colours and eased; dots on the tabs show who is where (`patches/autocad.yaml` wires [`frame`], [`draw_presence`],
+//! [`tab_dots`] and [`session_list`] in).
+//!
+//! The session and the presence look (pointers, name tags, colours, easing, convex ghosts) are the playground-live
+//! crate's (patches/live/kit); ghosts and rubber bands of any shape, selections and selection windows are CADCraft's
+//! own, drawn here in the kit's colours.
+
+use std::cell::{Cell, RefCell};
+use std::collections::{HashMap, HashSet};
+use std::sync::Arc;
+
+use crate::CadApp;
+use crate::canvas::{Look, Xf, draw_highlight};
+use cadcraft_engine::doc::{Block, Drawing, Entity, EntityKind, EntityStore, Handle, Header, Layout, Space, VportConfig};
+use cadcraft_engine::geom::{Mat3, Vec2};
+use cadcraft_engine::live::LIVE_UIDS;
+use cadcraft_engine::{DocState, Session};
+use cadcraft_render::{DisplayList, Kind};
+use egui::{Color32, Pos2, Rect, Shape, Stroke, pos2, vec2};
+use playground_live::{self, Live, Presence, presence};
+use serde_json::{Map, Value, json};
+
+/// Header variables that are this person's current settings and command defaults, not the drawing's.
+const PERSONAL: &[&str] = &[
+    "CLAYER", "CECOLOR", "CECOLOR_RGB", "CELTYPE", "CELWEIGHT", "TEXTSTYLE", "DIMSTYLE", "CMLSTYLE", "CMLEADERSTYLE",
+    "CTABLESTYLE", "CPLOTSTYLE", "CANNOSCALE", "TEXTSIZE", "CIRCLERAD", "OFFSETDIST", "CHAMMODE", "INSNAME", "HPNAME",
+    "HPSCALE", "HPANG", "POLYSIDES", "TRIMMODE", "EDGEMODE", "PROJMODE", "FILLETRAD", "CHAMFERA", "CHAMFERB", "CHAMFERC",
+    "CHAMFERD", "DONUTID", "DONUTOD", "CMLSCALE", "CADCRAFT_LAYERP", "CADCRAFT_LAYISO",
+];
+
+/// A drawing of the session.
+struct Doc {
+    /// Its id in the session.
+    id: u64,
+    /// Its tab here (`DocState::uid`); none once this person closed it.
+    uid: Option<u64>,
+    /// As last seen: what the session goes on with while it is closed here.
+    drawing: Arc<Drawing>,
+    name: String,
+}
+
+/// The session's drawings as this page knows them, in the session's order.
+#[derive(Default)]
+struct Shared {
+    docs: Vec<Doc>,
+    /// Tabs whose uid is at least this were opened since the session started (uids only grow).
+    since: u64,
+    /// For [`playground_live::fresh_id`].
+    next: u64,
+    /// The open shared drawings whose native Undo history was cleared.
+    cleared: Vec<u64>,
+}
+
+thread_local! {
+    static SHARED: RefCell<Shared> = RefCell::default();
+    /// This person's pointer on the canvas in the shown space's drawing units: this frame's ([`draw_presence`]), then
+    /// as of the last frame (`None`: off the canvas, or no canvas shown).
+    static POINTER: Cell<Option<Vec2>> = const { Cell::new(None) };
+    static SHOWN_POINTER: Cell<Option<Vec2>> = const { Cell::new(None) };
+}
+
+/// The end of each frame (web), after the canvas drew: the presence look's (name tags in the kit's 12 px, as before),
+/// then [`playground_live::frame`].
+pub fn frame(app: &mut CadApp, ctx: &egui::Context) {
+    presence::end_frame(ctx);
+    SHOWN_POINTER.set(POINTER.take());
+    playground_live::frame(app);
+    // Newly shared: their native Undo starts here, as the session's does.
+    let fresh: Vec<u64> = SHARED.with_borrow_mut(|sh| {
+        let fresh: Vec<u64> = sh.docs.iter().filter_map(|d| d.uid).filter(|uid| !sh.cleared.contains(uid)).collect();
+        sh.cleared.extend(&fresh);
+        fresh
+    });
+    for st in app.session.docs.iter_mut().filter(|st| fresh.contains(&st.uid)) {
+        st.undo.clear();
+        st.redo.clear();
+    }
+}
+
+/// Brings the session's drawings up to date with this page's tabs: the shown one when nothing is shared yet, each one
+/// opened since (a new drawing of the session), the latest of each that is open, and which ones were closed.
+fn register(s: &Session) {
+    SHARED.with_borrow_mut(|sh| {
+        let add = |sh: &mut Shared, st: &DocState| {
+            let id = playground_live::fresh_id(&mut sh.next);
+            sh.docs.push(Doc { id, uid: Some(st.uid), drawing: st.drawing().clone(), name: st.title.clone() });
+        };
+        if sh.docs.is_empty() {
+            let Ok(st) = s.state() else { return };
+            sh.since = s.docs.iter().map(|d| d.uid).max().unwrap_or(0) + 1;
+            add(sh, st);
+        }
+        for doc in &mut sh.docs {
+            match doc.uid.and_then(|uid| s.docs.iter().find(|st| st.uid == uid)) {
+                Some(st) => (doc.drawing, doc.name) = (st.drawing().clone(), st.title.clone()),
+                None => doc.uid = None,
+            }
+        }
+        let opened: Vec<&DocState> = s.docs.iter().filter(|st| st.uid >= sh.since && !sh.docs.iter().any(|d| d.uid == Some(st.uid))).collect();
+        for st in opened {
+            add(sh, st);
+        }
+        LIVE_UIDS.set(sh.docs.iter().filter_map(|d| d.uid).collect());
+    });
+}
+
+/// The session's id of the drawing in tab `uid`, when the session shares it.
+fn shared_id(uid: u64) -> Option<u64> {
+    SHARED.with_borrow(|sh| sh.docs.iter().find(|d| d.uid == Some(uid)).map(|d| d.id))
+}
+
+fn invalid(e: serde_json::Error) -> String {
+    format!("Invalid shared drawing: {e}")
+}
+
+macro_rules! fields {
+    ($($f:ident),*) => {
+        fn put(d: &Drawing, m: &mut Map<String, Value>) -> serde_json::Result<()> {
+            $(m.insert(stringify!($f).into(), serde_json::to_value(&d.$f)?);)*
+            Ok(())
+        }
+        fn take(d: &mut Drawing, m: &mut Map<String, Value>) -> serde_json::Result<()> {
+            $(d.$f = serde_json::from_value(m.remove(stringify!($f)).unwrap_or_default())?;)*
+            Ok(())
+        }
+    };
+}
+fields!(
+    layers, linetypes, text_styles, dim_styles, mleader_styles, table_styles, mline_styles, views, ucss, layer_states,
+    groups, plot_style_tables, constraints, parametric, scales, handseed
+);
+
+/// `value` with an `id` (unless it has one), so the merge pairs it up across versions.
+fn keyed(mut value: Value, id: Value) -> Value {
+    if let Value::Object(m) = &mut value {
+        m.entry("id").or_insert(id);
+    }
+    value
+}
+
+fn entities(store: &EntityStore) -> serde_json::Result<Value> {
+    store.iter().map(|e| Ok(keyed(serde_json::to_value(&**e)?, e.handle.0.into()))).collect::<serde_json::Result<_>>().map(Value::Array)
+}
+
+/// `value` (a block or layout) with its entities.
+fn with_entities(mut value: Value, store: &EntityStore) -> serde_json::Result<Value> {
+    value["entities"] = entities(store)?;
+    Ok(value)
+}
+
+fn document(d: &Drawing) -> serde_json::Result<Value> {
+    let mut m = Map::new();
+    let mut header = d.header.clone();
+    header.vars.retain(|k, _| !PERSONAL.contains(&k.as_str()));
+    m.insert("header".into(), serde_json::to_value(&header)?);
+    put(d, &mut m)?;
+    let vports: Vec<_> = d.vports.iter().filter(|c| !c.is_active()).collect();
+    m.insert("vports".into(), serde_json::to_value(vports)?);
+    // Table records by name.
+    for value in m.values_mut() {
+        for item in value.as_array_mut().into_iter().flatten() {
+            if let Some(name) = item.get("name").cloned() {
+                *item = keyed(item.take(), name);
+            }
+        }
+    }
+    m.insert("model".into(), entities(&d.model)?);
+    let layouts = d.layouts.iter().map(|l| Ok(keyed(with_entities(serde_json::to_value(l)?, &l.entities)?, l.name.clone().into())));
+    m.insert("layouts".into(), Value::Array(layouts.collect::<serde_json::Result<_>>()?));
+    let blocks = d.blocks.iter().map(|(name, b)| Ok((name.clone(), with_entities(serde_json::to_value(&**b)?, &b.entities)?)));
+    m.insert("blocks".into(), Value::Object(blocks.collect::<serde_json::Result<_>>()?));
+    Ok(Value::Object(m))
+}
+
+/// Makes `store` hold `items` in their order, keeping the entities (and chunks) that did not change.
+fn sync(store: &mut EntityStore, items: Vec<Entity>) {
+    let order: Vec<_> = items.iter().map(|e| e.handle).collect();
+    let keep: HashSet<_> = order.iter().copied().collect();
+    for h in store.handles() {
+        if !keep.contains(&h) {
+            store.remove(h);
+        }
+    }
+    for e in items {
+        if store.get(e.handle).is_none_or(|old| **old != e) {
+            store.push(e);
+        }
+    }
+    if store.handles() != order {
+        let at: HashMap<_, _> = order.iter().enumerate().map(|(i, h)| (*h, i)).collect();
+        store.sort_by_key(|e| at.get(&e.handle).copied());
+    }
+}
+
+fn store_from(value: Option<Value>, mut store: EntityStore) -> serde_json::Result<EntityStore> {
+    sync(&mut store, serde_json::from_value(value.unwrap_or_default())?);
+    Ok(store)
+}
+
+/// Makes `d` the shared `document`, keeping what is this person's own.
+fn install(d: &mut Drawing, document: Value) -> serde_json::Result<()> {
+    let mut m: Map<String, Value> = serde_json::from_value(document)?;
+    let mut header: Header = serde_json::from_value(m.remove("header").unwrap_or_default())?;
+    header.vars.retain(|k, _| !PERSONAL.contains(&k.as_str()));
+    header.vars.extend(d.header.vars.iter().filter(|(k, _)| PERSONAL.contains(&k.as_str())).map(|(k, v)| (k.clone(), v.clone())));
+    d.header = header;
+    take(d, &mut m)?;
+    let vports: Vec<VportConfig> = serde_json::from_value(m.remove("vports").unwrap_or_default())?;
+    d.vports.retain(VportConfig::is_active);
+    d.vports.extend(vports.into_iter().filter(|c| !c.is_active()));
+    d.model = store_from(m.remove("model"), std::mem::take(&mut d.model))?;
+    let mut layouts = Vec::new();
+    for mut value in serde_json::from_value::<Vec<Value>>(m.remove("layouts").unwrap_or_default())? {
+        let items = value.as_object_mut().and_then(|v| v.remove("entities"));
+        let mut layout: Layout = serde_json::from_value(value)?;
+        let old = d.layouts.iter().find(|l| l.name == layout.name).map(|l| l.entities.clone());
+        layout.entities = store_from(items, old.unwrap_or_default())?;
+        layouts.push(layout);
+    }
+    d.layouts = layouts;
+    let mut blocks = std::collections::BTreeMap::new();
+    for (name, mut value) in serde_json::from_value::<Map<String, Value>>(m.remove("blocks").unwrap_or_default())? {
+        let items = value.as_object_mut().and_then(|v| v.remove("entities"));
+        let mut block: Block = serde_json::from_value(value)?;
+        let old = d.blocks.get(&name);
+        block.entities = store_from(items, old.map(|b| b.entities.clone()).unwrap_or_default())?;
+        let block = match old {
+            Some(old) if **old == block => old.clone(),
+            _ => Arc::new(block),
+        };
+        blocks.insert(name, block);
+    }
+    d.blocks = blocks;
+    Ok(())
+}
+
+/// The session's drawings in a shared document: (id, name, drawing).
+fn entries(document: &Value) -> Result<Vec<(u64, String, Value)>, String> {
+    let list = document["documents"].as_array().ok_or("Invalid shared drawings: no list")?;
+    let mut out: Vec<(u64, String, Value)> = Vec::with_capacity(list.len());
+    for v in list {
+        let (Some(id), Some(name)) = (v["id"].as_u64(), v["name"].as_str()) else {
+            return Err("Invalid shared drawing: no id or name".into());
+        };
+        if out.iter().any(|(other, ..)| *other == id) {
+            return Err("Conflict: two drawings with one id".into());
+        }
+        out.push((id, name.to_owned(), v.clone()));
+    }
+    Ok(out)
+}
+
+/// Puts `d` in tab `st` unless it is there already, with no native undo step; leaves a layout that went and drops
+/// selected objects that went.
+fn put_in(st: &mut DocState, d: Drawing) {
+    if d == **st.drawing() {
+        return;
+    }
+    st.doc = Arc::new(d);
+    st.revision += 1;
+    if let Space::Paper(name) = &st.space
+        && !st.doc.layouts.iter().any(|l| l.name == *name)
+    {
+        (st.space, st.mspace) = (Space::Model, None);
+    }
+    let doc = st.doc.clone();
+    st.selection.retain(|h| doc.entity(*h).is_some());
+}
+
+impl Live for CadApp {
+    const COUNTERS: &'static [&'static str] = &["handseed"];
+
+    /// `{ documents: [{ id, name, ...drawing }] }`: every drawing of the session, open here or not.
+    fn live_document(&self) -> Value {
+        register(&self.session);
+        SHARED.with_borrow(|sh| {
+            let docs = sh.docs.iter().map(|d| {
+                let mut v = document(&d.drawing).unwrap_or_default();
+                (v["id"], v["name"]) = (d.id.into(), d.name.clone().into());
+                v
+            });
+            json!({ "documents": docs.collect::<Vec<_>>() })
+        })
+    }
+
+    /// Each drawing goes into its tab here; one new to the session opens in a tab behind this person's, one they closed
+    /// stays closed. Joining, the session's first drawing goes into the tab this page shares.
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let incoming = entries(&document)?;
+        let s = &mut self.session;
+        if SHARED.with_borrow(|sh| sh.docs.is_empty()) && s.docs.is_empty() {
+            // Joining from the Start tab: a tab for the session's first drawing.
+            s.new_drawing(false);
+        }
+        register(s);
+        // Worked out before anything changes: (id, name, this page's copy as (tab, drawing), the drawing to install).
+        type Plan = Vec<(u64, String, Option<(Option<u64>, Arc<Drawing>)>, Drawing)>;
+        let plan: Plan = SHARED.with_borrow(|sh| {
+            let joining = !incoming.iter().any(|(id, ..)| sh.docs.iter().any(|d| d.id == *id));
+            let step = |(i, (id, name, json)): (usize, (u64, String, Value))| -> Result<_, String> {
+                let old = if joining && i == 0 { sh.docs.first() } else { sh.docs.iter().find(|d| d.id == id) };
+                // ponytail: installs every drawing of the session per change (O(all entities)); skip unchanged ones if big sessions lag.
+                let mut d = old.map_or_else(Drawing::default, |o| (*o.drawing).clone());
+                install(&mut d, json).map_err(invalid)?;
+                Ok((id, name, old.map(|o| (o.uid, o.drawing.clone())), d))
+            };
+            incoming.into_iter().enumerate().map(step).collect::<Result<_, String>>()
+        })?;
+        let active = s.active;
+        let mut docs = Vec::with_capacity(plan.len());
+        for (id, name, old, d) in plan {
+            let at = old.as_ref().and_then(|o| o.0).and_then(|uid| s.docs.iter().position(|st| st.uid == uid));
+            let (uid, drawing) = match (at.and_then(|i| s.docs.get_mut(i)), old) {
+                (Some(st), _) => {
+                    put_in(st, d);
+                    st.title.clone_from(&name);
+                    (Some(st.uid), st.drawing().clone())
+                }
+                (None, Some((_, last))) => (None, if *last == d { last } else { Arc::new(d) }),
+                (None, None) => {
+                    // New to the session: a tab behind this person's.
+                    let i = s.open_drawing(d, &name, None);
+                    s.active = active;
+                    match s.docs.get(i) {
+                        Some(st) => (Some(st.uid), st.doc.clone()),
+                        None => continue,
+                    }
+                }
+            };
+            docs.push(Doc { id, uid, drawing, name });
+        }
+        SHARED.with_borrow_mut(|sh| {
+            sh.docs = docs;
+            LIVE_UIDS.set(sh.docs.iter().filter_map(|d| d.uid).collect());
+        });
+        Ok(())
+    }
+
+    /// Refuses anything that is not a list of drawings with distinct ids.
+    fn live_check(document: &Value) -> Result<(), String> {
+        for (_, _, d) in entries(document)? {
+            // ponytail: decodes every drawing per merge (O(entities)); a lighter schema check if big sessions lag.
+            install(&mut Drawing::default(), d).map_err(invalid)?;
+        }
+        Ok(())
+    }
+
+    /// `{ doc, page, selection, pointer?, drag?, ghost?, band?, window? }` (see [`gesture`]), on the session's drawings.
+    fn live_presence(&self) -> Value {
+        let Some(st) = self.session.state().ok().filter(|_| !self.ui.start_tab) else { return Value::Null };
+        let (Some(doc), Some(page)) = (shared_id(st.uid), page(st)) else { return Value::Null };
+        let selection: Vec<u64> = st.selection.iter().take(MAX_ITEMS).map(|h| h.0).collect();
+        let mut state = json!({ "doc": doc, "page": page, "selection": selection });
+        if let Some(p) = SHOWN_POINTER.get() {
+            state["pointer"] = json!([p.x, p.y]);
+        }
+        gesture(self, st, &mut state);
+        state
+    }
+
+    /// Kept for the canvas and the tabs; whoever moved to another drawing or space starts over there, their marks
+    /// undrawn for a frame being forgotten ([`presence::end_frame`]).
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        presence::show(others);
+    }
+
+    fn live_quiet(&self) -> bool {
+        let s = &self.session;
+        presence::quiet()
+            && s.running.is_none()
+            && s.suspended.is_none()
+            && s.pending_window.is_none()
+            && s.select_mode.is_none()
+            && !s.lisp_busy()
+            && s.docs.iter().all(|st| {
+                // The Block Editor, REFEDIT and ARRAYEDIT Source hold objects out for editing until they close.
+                st.block_edit.is_none()
+                    && st.doc.refedit.is_none()
+                    && !st.doc.blocks.values().any(|b| b.array.as_ref().is_some_and(|a| a.editing.is_some()))
+            })
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::hash::DefaultHasher::new();
+        for st in &self.session.docs {
+            (st.uid, st.revision, Arc::as_ptr(st.drawing()) as usize, &st.title).hash(&mut h);
+            // Panning and zooming inside a layout viewport changes its view in place.
+            if let Some((vh, vp)) = st.active_viewport() {
+                (vh, vp.view_center.x.to_bits(), vp.view_center.y.to_bits(), vp.view_height.to_bits()).hash(&mut h);
+            }
+        }
+        SHARED.with_borrow(|sh| sh.docs.iter().for_each(|d| (d.id, d.uid, Arc::as_ptr(&d.drawing) as usize).hash(&mut h)));
+        Some(h.finish())
+    }
+
+    fn live_disconnected(&mut self) {
+        let shared = SHARED.take();
+        LIVE_UIDS.take();
+        for st in self.session.docs.iter_mut().filter(|st| shared.docs.iter().any(|d| d.uid == Some(st.uid))) {
+            // Their steps hold other people's edits.
+            st.undo.clear();
+            st.redo.clear();
+        }
+    }
+}
+
+/// The space `st` shows, as presence names it: `Model` or the layout's name. `None` in the Block Editor.
+fn page(st: &DocState) -> Option<&str> {
+    match &st.space {
+        _ if st.block_edit.is_some() => None,
+        Space::Model => Some("Model"),
+        Space::Paper(name) => Some(name),
+    }
+}
+
+/// The most selected or dragged objects, and shapes, a presence names.
+const MAX_ITEMS: usize = 50;
+/// The most bytes of a presence (the shell sends at most 4 KiB).
+const MAX_BYTES: usize = 4000;
+/// Coordinates beyond this are not drawn (remote data).
+const FAR_OUT: f64 = 1e12;
+
+/// The gesture under way, read from the session, into `state`: `drag` (the objects a command moves, rotates, scales or
+/// mirrors, and its transform so far `m`: [a, b, c, d, e, f]), `ghost` (objects a grip edit reshapes, as they would
+/// end up) and `band` (the command's rubber band, and what it drew so far), as entities ([`drawable`] ones, as many
+/// as fit); `window` (a selection window's corners). On the sheet's terms only: none while editing model space through
+/// a layout viewport. The text typed at the command line stays this person's.
+fn gesture(app: &CadApp, st: &DocState, state: &mut Value) {
+    let s = &app.session;
+    let Some(c) = app.canvas.cursor.filter(|_| st.active_viewport().is_none()) else { return };
+    if let Some(w) = s.pending_window {
+        state["window"] = json!([w.corner.x, w.corner.y, c.x, c.y]);
+    }
+    if let Some(running) = &s.running {
+        let (mut ghost, mut band) = (Vec::new(), Vec::new());
+        match s.drag(c) {
+            Some((d, extra)) if !d.clipboard && !d.handles.is_empty() => {
+                let (m, handles) = (d.matrix, d.handles.iter().take(MAX_ITEMS).map(|h| h.0).collect::<Vec<_>>());
+                state["drag"] = json!({ "handles": handles, "m": [m.a, m.b, m.c, m.d, m.e, m.f] });
+                band.extend(extra.into_iter().map(|e| e.kind));
+            }
+            _ => {
+                band = s.preview(c).into_iter().map(|e| e.kind).collect();
+                if running.id == "grip" {
+                    // The objects reshaped, then the line from the grip to the cursor.
+                    let line = band.pop();
+                    ghost = std::mem::replace(&mut band, line.into_iter().collect());
+                }
+            }
+        }
+        // What the command drew so far (LINE adds each segment as it goes): the newest objects of the space.
+        if let Some(store) = st.doc.space(&st.space) {
+            let chunks: Vec<_> = store.chunk_slices().collect();
+            let newest = chunks.iter().rev().flat_map(|(_, items)| items.iter().rev());
+            band.extend(newest.take_while(|e| running.before.entity(e.handle).is_none()).take(MAX_ITEMS).map(|e| e.kind.clone()));
+        }
+        round(state);
+        let mut room = MAX_BYTES.saturating_sub(state.to_string().len() + 20);
+        for (key, kinds) in [("ghost", ghost), ("band", band)] {
+            let shapes = shapes(&kinds, &mut room);
+            if !shapes.is_empty() {
+                state[key] = Value::Array(shapes);
+            }
+        }
+    }
+    round(state);
+}
+
+/// Shapes the others draw of a gesture: plain curves, cheap to rebuild every frame.
+fn drawable(k: &EntityKind) -> bool {
+    matches!(
+        k,
+        EntityKind::Line(_)
+            | EntityKind::Point(_)
+            | EntityKind::Circle(_)
+            | EntityKind::Arc(_)
+            | EntityKind::Ellipse(_)
+            | EntityKind::LwPolyline(_)
+            | EntityKind::Polyline3d(_)
+            | EntityKind::Spline(_)
+    )
+}
+
+/// The [`drawable`] ones of `kinds` as JSON, at most [`MAX_ITEMS`], as many as fit in `room` bytes (which they use).
+fn shapes(kinds: &[EntityKind], room: &mut usize) -> Vec<Value> {
+    let fits = |k: &EntityKind| {
+        let mut v = serde_json::to_value(k).ok()?;
+        round(&mut v);
+        let n = v.to_string().len() + 1;
+        (n <= *room).then(|| {
+            *room -= n;
+            v
+        })
+    };
+    kinds.iter().filter(|k| drawable(k)).filter_map(fits).take(MAX_ITEMS).collect()
+}
+
+/// Fractional numbers to 4 decimals (drawing units: below a pixel at any usual zoom), so a presence stays small.
+fn round(v: &mut Value) {
+    match v {
+        Value::Number(n) if n.is_f64() => {
+            if let Some(r) = n.as_f64().and_then(|x| serde_json::Number::from_f64((x * 1e4).round() / 1e4)) {
+                *n = r;
+            }
+        }
+        Value::Array(items) => items.iter_mut().for_each(round),
+        Value::Object(m) => m.values_mut().for_each(round),
+        _ => {}
+    }
+}
+
+/// Person `who`'s mark `key` (a gesture's shapes, as JSON) with each number eased toward where it is by its place in
+/// `v` ([`presence::ease`]: `px` points a unit, a jump wider than `far` points goes at once, and so does a number new to
+/// its place, as in another shape). None when a number is out of range (remote data).
+fn eased(ctx: &egui::Context, who: &str, key: &str, v: &Value, px: f64, far: f64) -> Option<Value> {
+    match v {
+        Value::Number(n) => {
+            let x = n.as_f64().filter(|x| x.abs() < FAR_OUT)?;
+            let [at] = presence::ease(ctx, who, key, [x], [px], [far])?;
+            // Arrived, it is the number as sent (an integer field still reads back).
+            Some(if at == x { v.clone() } else { serde_json::Number::from_f64(at)?.into() })
+        }
+        Value::Array(items) => {
+            items.iter().enumerate().map(|(i, x)| eased(ctx, who, &format!("{key}/{i}"), x, px, far)).collect::<Option<_>>().map(Value::Array)
+        }
+        Value::Object(m) => {
+            m.iter().map(|(k, x)| Some((k.clone(), eased(ctx, who, &format!("{key}/{k}"), x, px, far)?))).collect::<Option<_>>().map(Value::Object)
+        }
+        _ => Some(v.clone()),
+    }
+}
+
+/// `N` numbers in range, or none.
+fn numbers<const N: usize>(v: &Value) -> Option<[f64; N]> {
+    let items = v.as_array().filter(|a| a.len() == N)?;
+    let mut out = [0.0; N];
+    for (o, x) in out.iter_mut().zip(items) {
+        *o = x.as_f64().filter(|x| x.abs() < FAR_OUT)?;
+    }
+    Some(out)
+}
+
+/// A display list of `ents` for the canvas at `scale` pixels a unit.
+fn list_of(doc: &Drawing, ents: &[Entity], scale: f64) -> DisplayList {
+    cadcraft_render::build_entities(doc, ents, &cadcraft_render::Options { tolerance: 0.5 / scale, min_dash: 2.0 / scale, ..Default::default() })
+}
+
+/// The shapes a presence's `kinds` (JSON) name, those it may ([`drawable`]).
+fn shapes_of(kinds: &Value) -> Vec<Entity> {
+    let kind = |v: &Value| serde_json::from_value::<EntityKind>(v.clone()).ok().filter(drawable);
+    kinds.as_array().into_iter().flatten().take(MAX_ITEMS).filter_map(kind).map(|k| Entity::new(Handle(0), k)).collect()
+}
+
+/// The others on the drawing and space this person sees, on the canvas (after the drawing and its highlights; `xf` is
+/// the sheet's transform in a layout), in the session's look: everyone's ghosts and rubber bands, then their selections
+/// outlined, then their pointers with their names, each in their colour and eased toward their latest presence
+/// ([`presence::ease`], which repaints until they get there). Also notes this person's pointer for
+/// [`Live::live_presence`].
+pub fn draw_presence(app: &CadApp, ctx: &egui::Context, p: &egui::Painter, xf: &Xf, rect: Rect) {
+    POINTER.set(ctx.pointer_hover_pos().filter(|q| rect.contains(*q)).map(|q| xf.to_world(q)));
+    let Ok(st) = app.session.state() else { return };
+    let (Some(doc), Some(page)) = (shared_id(st.uid), page(st)) else { return };
+    // Points a drawing unit, and a jump wider than a quarter of the view goes at once.
+    let (px, far) = (xf.scale, f64::from(rect.height()) / 4.0);
+    let others = presence::others();
+    let here: Vec<&Presence> = others.iter().filter(|o| o.state["doc"].as_u64() == Some(doc) && o.state["page"] == page).collect();
+    for o in &here {
+        let color = presence::color(o);
+        // ponytail: rebuilds the ghosts' and bands' display lists every frame; cache by state if big drags lag.
+        let m = numbers::<6>(&o.state["drag"]["m"]).and_then(|m| presence::ease(ctx, &o.id, "m", m, [px; 6], [far; 6]));
+        if let (Some(handles), Some([a, b, c, d, e, f])) = (o.state.pointer("/drag/handles").and_then(Value::as_array), m) {
+            let m = Mat3 { a, b, c, d, e, f };
+            let moved = |h: &Value| {
+                let mut e = (**st.doc.entity(Handle(h.as_u64()?))?).clone();
+                e.kind.transform(&m);
+                Some(e)
+            };
+            let ents: Vec<Entity> = handles.iter().take(MAX_ITEMS).filter_map(moved).collect();
+            paint_list(p, xf, &list_of(&st.doc, &ents, xf.scale), color, false);
+        }
+        for (key, band) in [("ghost", false), ("band", true)] {
+            let ents = eased(ctx, &o.id, key, &o.state[key], px, far).map_or_else(Vec::new, |v| shapes_of(&v));
+            if !ents.is_empty() {
+                paint_list(p, xf, &list_of(&st.doc, &ents, xf.scale), color, band);
+            }
+        }
+        let window = numbers::<4>(&o.state["window"]).and_then(|w| presence::ease(ctx, &o.id, "window", w, [px; 4], [far; 4]));
+        if let Some([x0, y0, x1, y1]) = window {
+            let r = Rect::from_two_pos(xf.to_screen(Vec2::new(x0, y0)), xf.to_screen(Vec2::new(x1, y1)));
+            let corners = [r.left_top(), r.right_top(), r.right_bottom(), r.left_bottom(), r.left_top()];
+            p.extend(Shape::dashed_line(&corners, Stroke::new(1.5, color), 4.0, 3.0));
+        }
+    }
+    for o in &here {
+        let handles: HashSet<Handle> =
+            o.state["selection"].as_array().into_iter().flatten().take(MAX_ITEMS).filter_map(Value::as_u64).map(Handle).collect();
+        if let (Some(list), false) = (&app.canvas.list, handles.is_empty()) {
+            // ponytail: scans the display list per person and frame; index it like the canvas's PrimIndex if big drawings lag.
+            let prims: Vec<usize> = list.prims.iter().enumerate().filter(|(_, pr)| handles.contains(&pr.handle)).map(|(i, _)| i).collect();
+            draw_highlight(p, xf, list, &prims, presence::color(o), Look { width: 2.0, dashed: false });
+        }
+    }
+    for o in &here {
+        let at = numbers::<2>(&o.state["pointer"]).and_then(|t| presence::ease(ctx, &o.id, "pointer", t, [px; 2], [far; 2]));
+        if let Some(at) = at.map(|[x, y]| xf.to_screen(Vec2::new(x, y))).filter(|at| rect.expand(20.0).contains(*at)) {
+            presence::cursor(p, at, presence::color(o), &o.name);
+        }
+    }
+}
+
+/// A ghost's fill and edge, in its person's colour at these opacities (the kit's).
+const GHOST: f32 = 0.28;
+const GHOST_EDGE: f32 = 0.85;
+
+/// `list` in `color`: a rubber band (1.5 px dashed outlines) or a ghost (closed convex outlines as the kit's
+/// [`presence::ghost_shape`]; fills at [`GHOST`], other lines 1.5 px at [`GHOST_EDGE`]).
+fn paint_list(p: &egui::Painter, xf: &Xf, list: &DisplayList, color: Color32, band: bool) {
+    let edge = Stroke::new(1.5, if band { color } else { color.gamma_multiply(GHOST_EDGE) });
+    let fill = color.gamma_multiply(GHOST);
+    let mut mesh = egui::Mesh::default();
+    for prim in &list.prims {
+        let pts: Vec<Pos2> = list.points(prim).iter().map(|q| xf.to_screen(*q)).collect();
+        match prim.kind {
+            Kind::Polyline if band => p.extend(Shape::dashed_line(&pts, edge, 4.0, 3.0)),
+            Kind::Polyline => match convex_ring(&pts) {
+                Some(ring) => presence::ghost_shape(p, ring, color),
+                None => {
+                    p.add(Shape::line(pts, edge));
+                }
+            },
+            Kind::Tris if !band => {
+                for q in pts {
+                    let i = mesh.vertices.len() as u32;
+                    mesh.colored_vertex(q, fill);
+                    mesh.indices.push(i);
+                }
+            }
+            Kind::Point => {
+                if let Some(q) = pts.first() {
+                    p.circle_stroke(*q, 3.0, edge);
+                }
+            }
+            _ => {}
+        }
+    }
+    if !mesh.is_empty() {
+        p.add(mesh);
+    }
+}
+
+/// The corners of `pts` when it is a closed loop turning one way (a convex footprint egui can fill), without the
+/// repeated last point.
+fn convex_ring(pts: &[Pos2]) -> Option<&[Pos2]> {
+    let ring = pts.split_last().filter(|(last, ring)| ring.len() >= 3 && ring.first().is_some_and(|f| f.distance(**last) < 0.5))?.1;
+    let n = ring.len();
+    let mut sign = 0.0;
+    for i in 0..n {
+        let (a, b, c) = (ring[i], ring[(i + 1) % n], ring[(i + 2) % n]);
+        let turn = (b - a).x * (c - b).y - (b - a).y * (c - b).x;
+        if turn.abs() > 1e-3 {
+            if sign * turn < 0.0 {
+                return None;
+            }
+            sign = turn;
+        }
+    }
+    (sign != 0.0).then_some(ring)
+}
+
+/// The others on the drawing in tab `i` as dots in their colours, at the tab's right end (right after `chrome::file_tabs`
+/// draws the tab, whose widget id this repeats).
+pub fn tab_dots(app: &CadApp, ui: &egui::Ui, i: usize) {
+    let Some(id) = app.session.docs.get(i).and_then(|st| shared_id(st.uid)) else { return };
+    let Some(tab) = ui.ctx().read_response(ui.id().with(("tab", i))).map(|r| r.rect) else { return };
+    let on = presence::others().into_iter().filter(|o| o.state["doc"].as_u64() == Some(id));
+    for (k, o) in on.take(4).enumerate() {
+        let at = pos2(tab.right() - 30.0 - 10.0 * k as f32, tab.center().y);
+        ui.painter().circle(at, 4.0, presence::color(&o), Stroke::new(1.0, Color32::WHITE));
+    }
+}
+
+/// The Start page's "In this session" list (in a session, right after `chrome::start_page`), in its left column under
+/// the buttons: a row for each drawing of the session, with dots in the colours of the others on it; a click goes to
+/// it, opening it again in a tab when this person closed it.
+pub fn session_list(app: &mut CadApp, ui: &mut egui::Ui) {
+    if !playground_live::connected() {
+        return;
+    }
+    register(&app.session);
+    let rows: Vec<(u64, String, Option<u64>)> = SHARED.with_borrow(|sh| sh.docs.iter().map(|d| (d.id, d.name.clone(), d.uid)).collect());
+    if rows.is_empty() {
+        return;
+    }
+    let (t, r, p) = (crate::theme::Tokens::get(), ui.max_rect(), ui.painter().clone());
+    let (x, mut y) = (r.left() + 34.0, r.top() + 140.0 + 4.0 * 44.0 + 16.0);
+    p.text(pos2(x, y), egui::Align2::LEFT_TOP, "In this session", crate::theme::small(), t.text_dim);
+    y += 22.0;
+    let (others, mut chosen) = (presence::others(), None);
+    for (id, name, uid) in rows {
+        let row = Rect::from_min_size(pos2(x, y), vec2(220.0, 30.0));
+        let resp = ui.interact(row, ui.id().with(("live_session", id)), egui::Sense::click());
+        if resp.hovered() {
+            p.rect_filled(row, 2.0, t.control_hover.gamma_multiply(0.5));
+        }
+        let clip = p.with_clip_rect(row.shrink(2.0));
+        let color = if uid.is_some() { t.text } else { t.text_faint };
+        clip.text(pos2(row.left() + 10.0, row.center().y), egui::Align2::LEFT_CENTER, &name, crate::theme::body(), color);
+        let on = others.iter().filter(|o| o.state["doc"].as_u64() == Some(id));
+        for (k, o) in on.take(4).enumerate() {
+            let at = pos2(row.right() - 12.0 - 10.0 * k as f32, row.center().y);
+            p.circle(at, 4.0, presence::color(o), Stroke::new(1.0, Color32::WHITE));
+        }
+        if resp.on_hover_text(if uid.is_some() { "Open in this session" } else { "Closed here: open it again" }).clicked() {
+            chosen = Some((id, uid));
+        }
+        y += 34.0;
+    }
+    let Some((id, uid)) = chosen else { return };
+    let s = &mut app.session;
+    let i = match uid.and_then(|uid| s.docs.iter().position(|st| st.uid == uid)) {
+        Some(i) => i,
+        None => {
+            // Open again: a tab with the session's copy.
+            let found = SHARED.with_borrow(|sh| sh.docs.iter().find(|d| d.id == id).map(|d| ((*d.drawing).clone(), d.name.clone())));
+            let Some((d, name)) = found else { return };
+            let i = s.open_drawing(d, &name, None);
+            let uid = s.docs.get(i).map(|st| st.uid);
+            SHARED.with_borrow_mut(|sh| sh.docs.iter_mut().filter(|d| d.id == id).for_each(|d| d.uid = uid));
+            i
+        }
+    };
+    let _ = app.run("document.switch", json!({ "index": i }));
+    app.ui.start_tab = false;
+}
