+//! Live editing in a Playground session (`patches/autocad.yaml` wires it in): which drawing the session shares, and
+//! its Undo and Redo, which go to the session.
+
+thread_local! {
+    /// The `uid` of the drawing a Playground session shares (0: none).
+    pub static LIVE_UID: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
+#[cfg(target_arch = "wasm32")]
+impl crate::Session {
+    /// [`crate::Session::undo`] (`redo`: [`crate::Session::redo`]) in the drawing a Playground session shares: the
+    /// session takes back this person's last operation; the step here only names it (and keeps UNDO n, Back and MREDO
+    /// counting). `None`: not the shared drawing, nothing to undo, or no session.
+    pub(crate) fn live_undo(&mut self, redo: bool) -> Option<crate::Result<Option<String>>> {
+        let st = self.state_mut().ok()?;
+        let shared = st.uid == LIVE_UID.get();
+        let (from, to) = if redo { (&mut st.redo, &mut st.undo) } else { (&mut st.undo, &mut st.redo) };
+        if !shared || from.is_empty() || !cadcraft_doc::playground_live::undo(redo) {
+            return None;
+        }
+        let snap = from.pop();
+        let label = snap.as_ref().map(|s| s.label.clone());
+        to.extend(snap);
+        Some(Ok(label))
+    }
+}
diff --git a/crates/ui-egui/src/live.rs b/crates/ui-egui/src/live.rs
new file mode 100644
index 0000000..d8feaec
--- /dev/null
+++ b/crates/ui-egui/src/live.rs
@@ -0,0 +1,498 @@
+//! Live editing in a Playground session (web only): the shared document is the drawing open when the session started
+//! (pinned by uid; if its tab closes the session goes on with it as it was), as JSON. Entities are keyed by handle,
+//! table records, layouts and blocks by name. This person's current layer, colour, styles and other command defaults,
+//! the `*Active` viewport tiles, isolated objects, an in-place reference edit and the file data CADCraft does not model
+//! stay local, as do views and the selection (outside the drawing). A layout viewport's view is the sheet's, so shared.
+//! Presence: the others' pointers and selections, drawn on the canvas in their colors (`patches/autocad.yaml` wires
+//! [`frame`] and [`draw_presence`] in).
+
+use std::cell::{Cell, RefCell};
+use std::collections::{HashMap, HashSet};
+use std::sync::Arc;
+
+use crate::CadApp;
+use crate::canvas::{Look, Xf, draw_highlight};
+use cadcraft_engine::doc::playground_live::{self, Live, Presence};
+use cadcraft_engine::doc::{Block, Drawing, Entity, EntityStore, Handle, Header, Layout, Space, VportConfig};
+use cadcraft_engine::live::LIVE_UID;
+use cadcraft_engine::{DocState, geom::Vec2};
+use egui::{Color32, Pos2, Rect, Shape, Stroke, vec2};
+use serde_json::{Map, Value, json};
+
+/// Header variables that are this person's current settings and command defaults, not the drawing's.
+const PERSONAL: &[&str] = &[
+    "CLAYER", "CECOLOR", "CECOLOR_RGB", "CELTYPE", "CELWEIGHT", "TEXTSTYLE", "DIMSTYLE", "CMLSTYLE", "CMLEADERSTYLE",
+    "CTABLESTYLE", "CPLOTSTYLE", "CANNOSCALE", "TEXTSIZE", "CIRCLERAD", "OFFSETDIST", "CHAMMODE", "INSNAME", "HPNAME",
+    "HPSCALE", "HPANG", "POLYSIDES", "TRIMMODE", "EDGEMODE", "PROJMODE", "FILLETRAD", "CHAMFERA", "CHAMFERB", "CHAMFERC",
+    "CHAMFERD", "DONUTID", "DONUTOD", "CMLSCALE", "CADCRAFT_LAYERP", "CADCRAFT_LAYISO",
+];
+
+thread_local! {
+    /// A pointer is down or a text field has the keyboard (as of the last frame).
+    static GESTURE: Cell<bool> = const { Cell::new(false) };
+    /// The shared drawing whose native Undo history was last cleared.
+    static CLEARED: Cell<u64> = const { Cell::new(0) };
+    /// The shared drawing as last seen, which the session goes on with if its tab closes.
+    static LAST: RefCell<Option<Arc<Drawing>>> = const { RefCell::new(None) };
+    /// The others in the session ([`Live::live_show_presence`]).
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+    /// This person's pointer on the canvas in the shown space's drawing units: this frame's ([`draw_presence`]), then
+    /// as of the last frame (`None`: off the canvas, or no canvas shown).
+    static POINTER: Cell<Option<Vec2>> = const { Cell::new(None) };
+    static SHOWN_POINTER: Cell<Option<Vec2>> = const { Cell::new(None) };
+}
+
+/// The end of each frame (web): [`playground_live::frame`], told whether a pointer or the keyboard is busy.
+pub fn frame(app: &mut CadApp, ctx: &egui::Context) {
+    GESTURE.set(ctx.input(|i| i.pointer.any_down()) || ctx.egui_wants_keyboard_input());
+    SHOWN_POINTER.set(POINTER.take());
+    playground_live::frame(app);
+    // Newly shared: its native Undo starts here, as the session's does.
+    let uid = LIVE_UID.get();
+    if uid != CLEARED.replace(uid)
+        && let Some(st) = app.session.docs.iter_mut().find(|d| d.uid == uid)
+    {
+        st.undo.clear();
+        st.redo.clear();
+    }
+}
+
+/// The shared drawing's index, pinning the active one when nothing is shared yet; `None` once its tab closed.
+fn pinned(s: &cadcraft_engine::Session) -> Option<usize> {
+    if LIVE_UID.get() == 0
+        && let Ok(st) = s.state()
+    {
+        LIVE_UID.set(st.uid);
+    }
+    s.docs.iter().position(|d| d.uid == LIVE_UID.get())
+}
+
+fn invalid(e: serde_json::Error) -> String {
+    format!("Invalid shared drawing: {e}")
+}
+
+macro_rules! fields {
+    ($($f:ident),*) => {
+        fn put(d: &Drawing, m: &mut Map<String, Value>) -> serde_json::Result<()> {
+            $(m.insert(stringify!($f).into(), serde_json::to_value(&d.$f)?);)*
+            Ok(())
+        }
+        fn take(d: &mut Drawing, m: &mut Map<String, Value>) -> serde_json::Result<()> {
+            $(d.$f = serde_json::from_value(m.remove(stringify!($f)).unwrap_or_default())?;)*
+            Ok(())
+        }
+    };
+}
+fields!(
+    layers, linetypes, text_styles, dim_styles, mleader_styles, table_styles, mline_styles, views, ucss, layer_states,
+    groups, plot_style_tables, constraints, parametric, scales, handseed
+);
+
+/// `value` with an `id` (unless it has one), so the merge pairs it up across versions.
+fn keyed(mut value: Value, id: Value) -> Value {
+    if let Value::Object(m) = &mut value {
+        m.entry("id").or_insert(id);
+    }
+    value
+}
+
+fn entities(store: &EntityStore) -> serde_json::Result<Value> {
+    store.iter().map(|e| Ok(keyed(serde_json::to_value(&**e)?, e.handle.0.into()))).collect::<serde_json::Result<_>>().map(Value::Array)
+}
+
+/// `value` (a block or layout) with its entities.
+fn with_entities(mut value: Value, store: &EntityStore) -> serde_json::Result<Value> {
+    value["entities"] = entities(store)?;
+    Ok(value)
+}
+
+fn document(d: &Drawing) -> serde_json::Result<Value> {
+    let mut m = Map::new();
+    let mut header = d.header.clone();
+    header.vars.retain(|k, _| !PERSONAL.contains(&k.as_str()));
+    m.insert("header".into(), serde_json::to_value(&header)?);
+    put(d, &mut m)?;
+    let vports: Vec<_> = d.vports.iter().filter(|c| !c.is_active()).collect();
+    m.insert("vports".into(), serde_json::to_value(vports)?);
+    // Table records by name.
+    for value in m.values_mut() {
+        for item in value.as_array_mut().into_iter().flatten() {
+            if let Some(name) = item.get("name").cloned() {
+                *item = keyed(item.take(), name);
+            }
+        }
+    }
+    m.insert("model".into(), entities(&d.model)?);
+    let layouts = d.layouts.iter().map(|l| Ok(keyed(with_entities(serde_json::to_value(l)?, &l.entities)?, l.name.clone().into())));
+    m.insert("layouts".into(), Value::Array(layouts.collect::<serde_json::Result<_>>()?));
+    let blocks = d.blocks.iter().map(|(name, b)| Ok((name.clone(), with_entities(serde_json::to_value(&**b)?, &b.entities)?)));
+    m.insert("blocks".into(), Value::Object(blocks.collect::<serde_json::Result<_>>()?));
+    Ok(Value::Object(m))
+}
+
+/// Makes `store` hold `items` in their order, keeping the entities (and chunks) that did not change.
+fn sync(store: &mut EntityStore, items: Vec<Entity>) {
+    let order: Vec<_> = items.iter().map(|e| e.handle).collect();
+    let keep: HashSet<_> = order.iter().copied().collect();
+    for h in store.handles() {
+        if !keep.contains(&h) {
+            store.remove(h);
+        }
+    }
+    for e in items {
+        if store.get(e.handle).is_none_or(|old| **old != e) {
+            store.push(e);
+        }
+    }
+    if store.handles() != order {
+        let at: HashMap<_, _> = order.iter().enumerate().map(|(i, h)| (*h, i)).collect();
+        store.sort_by_key(|e| at.get(&e.handle).copied());
+    }
+}
+
+fn store_from(value: Option<Value>, mut store: EntityStore) -> serde_json::Result<EntityStore> {
+    sync(&mut store, serde_json::from_value(value.unwrap_or_default())?);
+    Ok(store)
+}
+
+/// Makes `d` the shared `document`, keeping what is this person's own.
+fn install(d: &mut Drawing, document: Value) -> serde_json::Result<()> {
+    let mut m: Map<String, Value> = serde_json::from_value(document)?;
+    let mut header: Header = serde_json::from_value(m.remove("header").unwrap_or_default())?;
+    header.vars.retain(|k, _| !PERSONAL.contains(&k.as_str()));
+    header.vars.extend(d.header.vars.iter().filter(|(k, _)| PERSONAL.contains(&k.as_str())).map(|(k, v)| (k.clone(), v.clone())));
+    d.header = header;
+    take(d, &mut m)?;
+    let vports: Vec<VportConfig> = serde_json::from_value(m.remove("vports").unwrap_or_default())?;
+    d.vports.retain(VportConfig::is_active);
+    d.vports.extend(vports.into_iter().filter(|c| !c.is_active()));
+    d.model = store_from(m.remove("model"), std::mem::take(&mut d.model))?;
+    let mut layouts = Vec::new();
+    for mut value in serde_json::from_value::<Vec<Value>>(m.remove("layouts").unwrap_or_default())? {
+        let items = value.as_object_mut().and_then(|v| v.remove("entities"));
+        let mut layout: Layout = serde_json::from_value(value)?;
+        let old = d.layouts.iter().find(|l| l.name == layout.name).map(|l| l.entities.clone());
+        layout.entities = store_from(items, old.unwrap_or_default())?;
+        layouts.push(layout);
+    }
+    d.layouts = layouts;
+    let mut blocks = std::collections::BTreeMap::new();
+    for (name, mut value) in serde_json::from_value::<Map<String, Value>>(m.remove("blocks").unwrap_or_default())? {
+        let items = value.as_object_mut().and_then(|v| v.remove("entities"));
+        let mut block: Block = serde_json::from_value(value)?;
+        let old = d.blocks.get(&name);
+        block.entities = store_from(items, old.map(|b| b.entities.clone()).unwrap_or_default())?;
+        let block = match old {
+            Some(old) if **old == block => old.clone(),
+            _ => Arc::new(block),
+        };
+        blocks.insert(name, block);
+    }
+    d.blocks = blocks;
+    Ok(())
+}
+
+impl Live for CadApp {
+    const COUNTERS: &'static [&'static str] = &["handseed"];
+
+    fn live_document(&self) -> Value {
+        let s = &self.session;
+        let d = match pinned(s).and_then(|i| s.docs.get(i)) {
+            Some(st) => {
+                LAST.set(Some(st.drawing().clone()));
+                st.drawing().clone()
+            }
+            // Its tab closed: the drawing as it was (an empty one if none was ever open).
+            None => LAST.with_borrow(Clone::clone).unwrap_or_default(),
+        };
+        document(&d).unwrap_or_default()
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let s = &mut self.session;
+        if LIVE_UID.get() == 0 && s.docs.is_empty() {
+            // Joining from the Start tab: a tab for the shared drawing.
+            s.new_drawing(false);
+        }
+        let i = pinned(s);
+        let current = match i.and_then(|i| s.docs.get(i)) {
+            Some(st) => st.doc.clone(),
+            None => LAST.with_borrow(Clone::clone).unwrap_or_default(),
+        };
+        let mut d = (*current).clone();
+        install(&mut d, document).map_err(invalid)?;
+        if d == *current {
+            return Ok(());
+        }
+        let d = Arc::new(d);
+        LAST.set(Some(d.clone()));
+        let Some(st) = i.and_then(|i| s.docs.get_mut(i)) else { return Ok(()) };
+        st.doc = d;
+        st.revision += 1;
+        if let Space::Paper(name) = &st.space
+            && !st.doc.layouts.iter().any(|l| l.name == *name)
+        {
+            (st.space, st.mspace) = (Space::Model, None);
+        }
+        let doc = st.doc.clone();
+        st.selection.retain(|h| doc.entity(*h).is_some());
+        Ok(())
+    }
+
+    /// Refuses anything that is not a drawing.
+    fn live_check(document: &Value) -> Result<(), String> {
+        // ponytail: decodes the whole drawing per merge (O(entities)); a lighter schema check if big sessions lag.
+        install(&mut Drawing::default(), document.clone()).map_err(invalid)
+    }
+
+    fn live_presence(&self) -> Value {
+        let Some(st) = self.session.state().ok().filter(|st| st.uid == LIVE_UID.get() && !self.ui.start_tab) else {
+            return Value::Null;
+        };
+        let Some(page) = page(st) else { return Value::Null };
+        let selection: Vec<u64> = st.selection.iter().take(50).map(|h| h.0).collect();
+        let mut state = json!({ "page": page, "selection": selection });
+        if let Some(p) = SHOWN_POINTER.get() {
+            state["pointer"] = json!([p.x, p.y]);
+        }
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+
+    fn live_quiet(&self) -> bool {
+        let s = &self.session;
+        !GESTURE.get()
+            && s.running.is_none()
+            && s.suspended.is_none()
+            && s.pending_window.is_none()
+            && s.select_mode.is_none()
+            && !s.lisp_busy()
+            && s.docs.iter().all(|st| {
+                // The Block Editor, REFEDIT and ARRAYEDIT Source hold objects out for editing until they close.
+                st.block_edit.is_none()
+                    && st.doc.refedit.is_none()
+                    && !st.doc.blocks.values().any(|b| b.array.as_ref().is_some_and(|a| a.editing.is_some()))
+            })
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        use std::hash::{Hash, Hasher};
+        let s = &self.session;
+        let mut h = std::hash::DefaultHasher::new();
+        match pinned(s).and_then(|i| s.docs.get(i)) {
+            Some(st) => {
+                (st.uid, st.revision, Arc::as_ptr(st.drawing()) as usize).hash(&mut h);
+                // Panning and zooming inside a layout viewport changes its view in place.
+                if let Some((vh, vp)) = st.active_viewport() {
+                    (vh, vp.view_center.x.to_bits(), vp.view_center.y.to_bits(), vp.view_height.to_bits()).hash(&mut h);
+                }
+            }
+            None => LAST.with_borrow(|d| d.as_ref().map(Arc::as_ptr)).hash(&mut h),
+        }
+        Some(h.finish())
+    }
+
+    fn live_disconnected(&mut self) {
+        let uid = LIVE_UID.replace(0);
+        if let Some(st) = self.session.docs.iter_mut().find(|d| d.uid == uid) {
+            // Its steps hold other people's edits.
+            st.undo.clear();
+            st.redo.clear();
+        }
+        LAST.set(None);
+    }
+}
+
+/// The space `st` shows, as presence names it: `Model` or the layout's name. `None` in the Block Editor.
+fn page(st: &DocState) -> Option<&str> {
+    match &st.space {
+        _ if st.block_edit.is_some() => None,
+        Space::Model => Some("Model"),
+        Space::Paper(name) => Some(name),
+    }
+}
+
+/// The others on the space this person sees, on the canvas (after the drawing and its highlights; `xf` is the sheet's
+/// transform in a layout): their selected objects outlined and their pointers with their names, in their colors. Also
+/// notes this person's pointer for [`Live::live_presence`].
+pub fn draw_presence(app: &CadApp, ctx: &egui::Context, p: &egui::Painter, xf: &Xf, rect: Rect) {
+    POINTER.set(ctx.pointer_hover_pos().filter(|q| rect.contains(*q)).map(|q| xf.to_world(q)));
+    OTHERS.with_borrow(|others| {
+        let Some(page) = app.session.state().ok().filter(|st| st.uid == LIVE_UID.get()).and_then(page) else { return };
+        for other in others.iter().filter(|o| o.state["page"] == page) {
+            let color = Color32::from_rgb(other.color[0], other.color[1], other.color[2]);
+            let handles: HashSet<Handle> =
+                other.state["selection"].as_array().into_iter().flatten().take(50).filter_map(Value::as_u64).map(Handle).collect();
+            if let (Some(list), false) = (&app.canvas.list, handles.is_empty()) {
+                // ponytail: scans the display list per person and frame; index it like the canvas's PrimIndex if big drawings lag.
+                let prims: Vec<usize> = list.prims.iter().enumerate().filter(|(_, pr)| handles.contains(&pr.handle)).map(|(i, _)| i).collect();
+                draw_highlight(p, xf, list, &prims, color, Look { width: 2.0, dashed: false });
+            }
+            let at = match other.state["pointer"].as_array().map(Vec::as_slice) {
+                Some([x, y]) => x.as_f64().zip(y.as_f64()).map(|(x, y)| xf.to_screen(Vec2::new(x, y))),
+                _ => None,
+            };
+            if let Some(at) = at.filter(|at| rect.expand(20.0).contains(*at)) {
+                pointer(p, at, color, &other.name);
+            }
+        }
+    });
+}
+
+/// A pointer arrow with its tip at `at` and a name tag beside it.
+fn pointer(p: &egui::Painter, at: Pos2, color: Color32, name: &str) {
+    let arrow = [at, at + vec2(0.0, 17.0), at + vec2(4.5, 13.0), at + vec2(12.0, 12.0)];
+    p.add(Shape::convex_polygon(arrow.to_vec(), color, Stroke::new(1.0, Color32::WHITE)));
+    let name: String = name.chars().take(40).collect();
+    if name.is_empty() {
+        return;
+    }
+    let galley = p.layout_no_wrap(name, egui::FontId::proportional(12.0), Color32::WHITE);
+    let tag = Rect::from_min_size(at + vec2(10.0, 16.0), galley.size() + vec2(8.0, 4.0));
+    p.rect_filled(tag, 3.0, color);
+    p.galley(tag.min + vec2(4.0, 2.0), galley, Color32::WHITE);
+}
