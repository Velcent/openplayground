+    #[test]
+    fn presence_gives_the_drawing_space_selection_and_a_move_under_way() {
+        let mut a = app(sample());
+        let id = first(&a.live_document())["id"].clone();
+        let handles = a.session.doc().unwrap().model.handles();
+        a.session.set_selection(handles[..2].to_vec());
+        assert_eq!(a.live_presence(), json!({ "doc": id, "page": "Model", "selection": [handles[0].0, handles[1].0] }));
+        // MOVE from 0,0 with the cursor at 2,1: the others draw the objects moved by that much.
+        a.session.cmdline("move").unwrap();
+        a.session.cmdline("0,0").unwrap();
+        a.canvas.cursor = Some(Vec2::new(2.0, 1.0));
+        let held = a.live_presence();
+        assert_eq!(held["drag"], json!({ "handles": [handles[0].0, handles[1].0], "m": [1.0, 0.0, 0.0, 1.0, 2.0, 1.0] }));
+        a.session.cancel();
+        a.session.state_mut().unwrap().space = Space::Paper("Layout1".into());
+        assert_eq!(a.live_presence()["page"], "Layout1");
+        a.ui.start_tab = true;
+        assert_eq!(a.live_presence(), Value::Null, "not on the Start tab");
+
+        // The others' rubber bands and ghosts ease number by number; a number new to its place goes at once, one at rest
+        // reads back as sent, and one out of range drops the shapes.
+        let ctx = egui::Context::default();
+        let band = |x: f64| json!([{ "Line": { "a": [0, 0, 0], "b": [x, 0.0, 0.0] } }]);
+        assert_eq!(eased(&ctx, "b", "band", &band(1.0), 10.0, 100.0), Some(band(1.0)));
+        let step = eased(&ctx, "b", "band", &band(3.0), 10.0, 100.0).unwrap();
+        let x = step[0]["Line"]["b"][0].as_f64().unwrap();
+        assert!(x > 1.0 && x < 3.0, "{step}");
+        assert_eq!(step[0]["Line"]["a"], json!([0, 0, 0]));
+        assert_eq!(eased(&ctx, "b", "band", &band(1e13), 10.0, 100.0), None);
+    }
