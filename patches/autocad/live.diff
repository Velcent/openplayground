+    #[test]
+    fn objects_drawn_while_connected_stay_old_to_arrayedit() {
+        live::connect();
+        let mut s = Session::new();
+        let c = s.execute("circle", &json!({ "center": [0, 0], "radius": 1 })).unwrap()["handle"].clone();
+        let a = s.execute("arrayrect", &json!({ "handles": [c], "rows": 1, "cols": 3, "colSpacing": 2 })).unwrap()["handle"].clone();
+        s.execute("circle", &json!({ "center": [50, 50], "radius": 1 })).unwrap();
+        let d = s.doc().unwrap();
+        assert!(d.model.iter().all(|e| e.handle.0 >> 52 == 1 && e.handle.0 < d.handseed), "random handles, under the counter");
+        s.execute("arrayedit", &json!({ "handle": a, "source": {} })).unwrap();
+        s.execute("arrayclose", &json!({ "save": false })).unwrap();
+        assert_eq!(s.doc().unwrap().model.len(), 2, "discarding the source edit keeps the circle drawn before it");
+        live::disconnect();
+    }
+
+    #[test]
+    fn a_drawing_opened_in_a_session_reaches_the_others_behind_their_own_and_stays_closed_where_closed() {
+        live::connect();
+        let mut a = app(sample());
+        a.live_document();
+        a.start("ui.sample");
+        let opened = a.live_document();
+        let names: Vec<_> = opened["documents"].as_array().unwrap().iter().map(|d| d["name"].clone()).collect();
+        assert_eq!(names, [json!("shared"), json!("Bracket")], "it joins the session");
+
+        let mut b = app(Drawing::new_imperial());
+        b.live_adopt(opened.clone()).unwrap();
+        let titles: Vec<_> = b.session.docs.iter().map(|st| st.title.as_str()).collect();
+        assert_eq!((titles, b.session.active), (vec!["shared", "Bracket"], 0), "a tab behind b's own");
+        b.session.docs.remove(1);
+        assert_eq!(canonical(&b.live_document()), canonical(&opened), "closing it is b's own");
+        let mut edited = opened.clone();
+        edited["documents"][1]["handseed"] = json!(0x9000);
+        b.live_adopt(edited.clone()).unwrap();
+        assert_eq!(b.session.docs.len(), 1, "a change does not open it again");
+        assert_eq!(canonical(&b.live_document()), canonical(&edited), "but it keeps up to date");
+
+        assert!(CadApp::live_check(&Value::Null).is_err());
+        assert!(CadApp::live_check(&json!({ "documents": [{ "id": 1, "name": "x", "model": 1 }] })).is_err());
+        assert!(CadApp::live_check(&edited).is_ok());
+        live::disconnect();
+    }
