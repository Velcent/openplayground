+# Playground's browser build of EarthCraft (patches/google-earth.yaml in github.com/daijro/openplayground): the part of
+# Tokio crates/earthcraft-data uses, on the page's one thread. Native builds compile it empty.
+[package]
+name = "earthcraft-playground-tokio"
+version = "0.1.0"
+edition = "2024"
+description = "EarthCraft in the browser: Tokio's runtime, tasks, timers and files on a page's one thread"
+license = "MIT"
+publish = false
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+earthcraft-playground = { path = ".." }
+tokio = { version = "1", default-features = false, features = ["sync", "macros", "io-util"] }
+wasm-bindgen = "0.2"
+wasm-bindgen-futures = "0.4"
+js-sys = "0.3"
+web-time = "1"
