+++ b/crates/earthcraft-playground/reqwest/src/lib.rs
@@ -0,0 +1,212 @@
+// SPDX-License-Identifier: MIT
+//! EarthCraft in the browser, for Playground (patches/google-earth.yaml in github.com/daijro/openplayground): the part of
+//! reqwest crates/earthcraft-data uses, over the browser's fetch. The crate takes it as `reqwest` on wasm (an `extern
+//! crate … as reqwest` at its root; the real reqwest is a native-only dependency there).
+//!
+//! reqwest's own wasm client is fetch too, but its futures hold the page's JavaScript objects, which are not Send (the
+//! crate's tasks are), and it has no connect/read timeouts and no `chunk`. Here each request runs on the page's event
+//! loop and hands back its whole answer, so everything the crate holds is plain bytes:
+//!   - the browser sends its own User-Agent (a script can't set it), so `user_agent` is dropped;
+//!   - a timeout is the request's whole time (`read_timeout` counts as one when no `timeout` is set);
+//!   - `chunk` gives the body in one piece; the crate's size limits still apply after it.
+//! Only servers that allow other sites' pages to read them (CORS) answer; the others fail as a network error does.
+#![cfg(target_arch = "wasm32")]
+
+use bytes::Bytes;
+use std::time::Duration;
+pub use reqwest::{Method, StatusCode};
+
+/// A request that failed, or came back with an error status.
+#[derive(Debug)]
+pub struct Error {
+    message: String,
+    status: Option<StatusCode>,
+}
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.message)
+    }
+}
+impl std::error::Error for Error {}
+impl Error {
+    fn new(message: impl ToString) -> Self {
+        Self { message: message.to_string(), status: None }
+    }
+    pub fn status(&self) -> Option<StatusCode> {
+        self.status
+    }
+    pub fn is_status(&self) -> bool {
+        self.status.is_some()
+    }
+}
+impl From<reqwest::Error> for Error {
+    fn from(error: reqwest::Error) -> Self {
+        Self { status: error.status(), message: error.to_string() }
+    }
+}
+pub type Result<T> = std::result::Result<T, Error>;
+
+#[derive(Clone, Debug, Default)]
+pub struct Client {
+    timeout: Option<Duration>,
+}
+impl Client {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn builder() -> ClientBuilder {
+        ClientBuilder::default()
+    }
+    pub fn get(&self, url: impl AsRef<str>) -> RequestBuilder {
+        self.request(Method::GET, url)
+    }
+    pub fn post(&self, url: impl AsRef<str>) -> RequestBuilder {
+        self.request(Method::POST, url)
+    }
+    pub fn request(&self, method: Method, url: impl AsRef<str>) -> RequestBuilder {
+        RequestBuilder { method, url: url.as_ref().into(), headers: Vec::new(), body: None, timeout: self.timeout, error: None }
+    }
+}
+
+#[derive(Debug, Default)]
+pub struct ClientBuilder {
+    timeout: Option<Duration>,
+    read_timeout: Option<Duration>,
+}
+impl ClientBuilder {
+    pub fn user_agent<V>(self, _: V) -> Self {
+        self
+    }
+    pub fn timeout(mut self, timeout: Duration) -> Self {
+        self.timeout = Some(timeout);
+        self
+    }
+    pub fn connect_timeout(self, _: Duration) -> Self {
+        self
+    }
+    pub fn read_timeout(mut self, timeout: Duration) -> Self {
+        self.read_timeout = Some(timeout);
+        self
+    }
+    pub fn no_proxy(self) -> Self {
+        self
+    }
+    pub fn build(self) -> Result<Client> {
+        Ok(Client { timeout: self.timeout.or(self.read_timeout) })
+    }
+}
+
+#[derive(Debug)]
+pub struct RequestBuilder {
+    method: Method,
+    url: String,
+    headers: Vec<(String, String)>,
+    body: Option<Vec<u8>>,
+    timeout: Option<Duration>,
+    error: Option<String>,
+}
+impl RequestBuilder {
+    pub fn header(mut self, name: impl AsRef<str>, value: impl AsRef<str>) -> Self {
+        self.headers.push((name.as_ref().into(), value.as_ref().into()));
+        self
+    }
+    pub fn query<T: serde::Serialize + ?Sized>(mut self, query: &T) -> Self {
+        match serde_urlencoded::to_string(query) {
+            Ok(q) if !q.is_empty() => {
+                self.url.push(if self.url.contains('?') { '&' } else { '?' });
+                self.url.push_str(&q);
+            }
+            Ok(_) => {}
+            Err(error) => self.error = Some(error.to_string()),
+        }
+        self
+    }
+    pub fn form<T: serde::Serialize + ?Sized>(mut self, form: &T) -> Self {
+        match serde_urlencoded::to_string(form) {
+            Ok(body) => {
+                self.body = Some(body.into_bytes());
+                self.headers.push(("Content-Type".into(), "application/x-www-form-urlencoded".into()));
+            }
+            Err(error) => self.error = Some(error.to_string()),
+        }
+        self
+    }
+    pub fn body(mut self, body: impl Into<Vec<u8>>) -> Self {
+        self.body = Some(body.into());
+        self
+    }
+    pub fn timeout(mut self, timeout: Duration) -> Self {
+        self.timeout = Some(timeout);
+        self
+    }
+    /// Fetches on the page's event loop; the answer comes back whole.
+    pub async fn send(self) -> Result<Response> {
+        if let Some(error) = self.error {
+            return Err(Error::new(error));
+        }
+        let (answer, response) = tokio::sync::oneshot::channel();
+        let url = self.url.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            let mut result = self.fetch(true).await;
+            // A header of the app's own (Digitraffic-User, TomTom-Api-Key) makes the browser ask the server first,
+            // and a server that doesn't answer that question can't be read: ask again without them.
+            if result.as_ref().is_err_and(|e| e.status.is_none()) && self.headers.iter().any(|(n, _)| !safelisted(n)) {
+                result = self.fetch(false).await;
+            }
+            let _ = answer.send(result);
+        });
+        response.await.map_err(|_| Error::new(format!("request for {url} was dropped")))?
+    }
+
+    async fn fetch(&self, all_headers: bool) -> Result<Response> {
+        let mut request = reqwest::Client::new().request(self.method.clone(), &self.url);
+        for (name, value) in self.headers.iter().filter(|(n, _)| all_headers || safelisted(n)) {
+            request = request.header(name, value);
+        }
+        if let Some(body) = &self.body {
+            request = request.body(body.clone());
+        }
+        if let Some(timeout) = self.timeout {
+            request = request.timeout(timeout);
+        }
+        let response = request.send().await?;
+        let status = response.status();
+        Ok(Response { status, url: self.url.clone(), body: Some(response.bytes().await?) })
+    }
+}
+
+/// Headers a page sends to another site without asking it first.
+fn safelisted(name: &str) -> bool {
+    ["accept", "accept-language", "content-language", "content-type"].iter().any(|s| name.eq_ignore_ascii_case(s))
+}
+
+#[derive(Debug)]
+pub struct Response {
+    status: StatusCode,
+    url: String,
+    body: Option<Bytes>,
+}
+impl Response {
+    pub fn status(&self) -> StatusCode {
+        self.status
+    }
+    pub fn error_for_status(self) -> Result<Self> {
+        if self.status.is_client_error() || self.status.is_server_error() {
+            return Err(Error { message: format!("HTTP status {} for url ({})", self.status, self.url), status: Some(self.status) });
+        }
+        Ok(self)
+    }
+    /// The whole body the first time, then None.
+    pub async fn chunk(&mut self) -> Result<Option<Bytes>> {
+        Ok(self.body.take())
+    }
+    pub async fn bytes(self) -> Result<Bytes> {
+        Ok(self.body.unwrap_or_default())
+    }
+    pub async fn text(self) -> Result<String> {
+        Ok(String::from_utf8_lossy(&self.body.unwrap_or_default()).into_owned())
+    }
+    pub async fn json<T: serde::de::DeserializeOwned>(self) -> Result<T> {
+        serde_json::from_slice(&self.body.unwrap_or_default()).map_err(Error::new)
+    }
+}
diff --git a/crates/earthcraft-playground/src/lib.rs b/crates/earthcraft-playground/src/lib.rs
new file mode 100644
index 0000000..fd66f47
