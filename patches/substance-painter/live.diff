index 0000000..448ffe9
--- /dev/null
+++ b/crates/ui/src/app/live.rs
@@ -0,0 +1,302 @@
+//! Live editing in a Playground session (`shell/live.js` drives it through [`web`]); nothing here runs until the shell
+//! connects. The shared project is [`checkpoint`]'s canonical binary checkpoint: the layer trees and settings, the
+//! painted tiles, the images they use and the mesh, without anyone's views (camera, selection, tool, brush, open
+//! folders, panels). A remote change merges into the project at the end of a quiet frame, keeping this person's views
+//! and unsent work, and is no step of the native undo history. While connected, Undo and Redo go to the session,
+//! which reverts only this person's operations, and History jumps are off.
+
+pub(crate) mod checkpoint;
+
+use std::collections::VecDeque;
+
+use super::SubcraftApp;
+
+/// A remote change waiting for a quiet frame: `edited` relative to `base`, or with no base the whole shared project.
+struct Remote {
+    base: Option<Vec<u8>>,
+    edited: Vec<u8>,
+    done: Done,
+}
+
+/// Settles a remote change: a whole adopted project gives back the checkpoint it replaced, for the shell's draft.
+pub(crate) type Done = Box<dyn FnOnce(Result<Option<Vec<u8>>, String>)>;
+
+#[derive(Default)]
+struct Live {
+    connected: bool,
+    /// The last frame was not quiet: a checkpoint now would catch a gesture half done.
+    busy: bool,
+    /// The committed document as last reported.
+    seen: Option<subcraft_doc::Document>,
+    remote: VecDeque<Remote>,
+    /// Shared changes reported so far.
+    changes: u64,
+    #[cfg(test)]
+    undos: Vec<bool>,
+    #[cfg(target_arch = "wasm32")]
+    hooks: Option<web::Hooks>,
+    /// For a repaint when the shell queues a change between frames.
+    #[cfg(target_arch = "wasm32")]
+    ctx: Option<egui::Context>,
+}
+
+thread_local! {
+    static LIVE: std::cell::RefCell<Live> = std::cell::RefCell::default();
+}
+
+pub(crate) fn connect() {
+    LIVE.with_borrow_mut(|live| (live.connected, live.seen) = (true, None));
+}
+
+/// Ends the session's hold on Undo; changes still waiting fail.
+pub(crate) fn disconnect() {
+    let waiting = LIVE.with_borrow_mut(|live| {
+        live.connected = false;
+        #[cfg(target_arch = "wasm32")]
+        {
+            live.hooks = None;
+        }
+        std::mem::take(&mut live.remote)
+    });
+    for remote in waiting {
+        (remote.done)(Err("Live editing disconnected".into()));
+    }
+}
+
+pub(crate) fn queue(base: Option<Vec<u8>>, edited: Vec<u8>, done: Done) {
+    let refused = LIVE.with_borrow_mut(|live| {
+        if !live.connected {
+            return Some(done);
+        }
+        live.remote.push_back(Remote { base, edited, done });
+        #[cfg(target_arch = "wasm32")]
+        if let Some(ctx) = &live.ctx {
+            ctx.request_repaint();
+        }
+        None
+    });
+    if let Some(done) = refused {
+        done(Err("Live editing is not connected".into()));
+    }
+}
+
+pub(crate) fn connected() -> bool {
+    LIVE.with_borrow(|live| live.connected)
+}
+
+/// Passes Undo or Redo to the session while connected: whether it did.
+pub(crate) fn undo(redo: bool) -> bool {
+    let connected = LIVE.with_borrow_mut(|live| {
+        #[cfg(test)]
+        if live.connected {
+            live.undos.push(redo);
+        }
+        live.connected
+    });
+    #[cfg(target_arch = "wasm32")]
+    if connected {
+        web::call(|hooks| &hooks.undo, &redo.into());
+    }
+    connected
+}
+
+impl SubcraftApp {
+    /// The canonical shared project, unless the last frame was busy: then the next quiet frame reports it again.
+    pub(crate) fn live_checkpoint(&self) -> Result<Vec<u8>, String> {
+        let busy = LIVE.with_borrow_mut(|live| {
+            if live.busy {
+                live.seen = None;
+            }
+            live.busy
+        });
+        if busy {
+            return Err("busy".into());
+        }
+        self.live_encode()
+    }
+
+    fn live_encode(&self) -> Result<Vec<u8>, String> {
+        let s = &self.state.session;
+        checkpoint::encode(s.history().current(), s.resources(), &s.scene().mesh)
+    }
+
+    /// Nothing under way that a remote change would cut short or a checkpoint would catch half done: no pointer down
+    /// (a stroke, a slider drag still coalescing into one history entry), no pen edit or image still being applied,
+    /// no text being typed.
+    fn live_quiet(&self, ctx: &egui::Context) -> bool {
+        let s = &self.state;
+        !ctx.input(|i| i.pointer.any_down())
+            && !s.session.is_stroking()
+            && !s.painting
+            && !s.pen.is_editing()
+            && !s.pen.is_pending()
+            && !s.asset_preview.is_applying()
+            && !ctx.egui_wants_keyboard_input()
+    }
+
+    /// The end of a frame: the remote changes waiting, then a report if the committed document changed, once quiet.
+    pub(super) fn live_frame(&mut self, ctx: &egui::Context) {
+        let quiet = self.live_quiet(ctx);
+        let waiting = LIVE.with_borrow_mut(|live| {
+            #[cfg(target_arch = "wasm32")]
+            live.ctx.get_or_insert_with(|| ctx.clone());
+            live.busy = !quiet;
+            if live.connected && quiet { std::mem::take(&mut live.remote) } else { VecDeque::new() }
+        });
+        for remote in waiting {
+            let result = self.live_apply(remote.base.as_deref(), &remote.edited);
+            (remote.done)(result);
+            ctx.request_repaint();
+        }
+        let doc = self.state.session.history().current();
+        let changed = LIVE.with_borrow_mut(|live| {
+            if !live.connected || !quiet || live.seen.as_ref() == Some(doc) {
+                return false;
+            }
+            live.seen = Some(doc.clone());
+            live.changes += 1;
+            true
+        });
+        #[cfg(target_arch = "wasm32")]
+        if changed {
+            web::call(|hooks| &hooks.changed, &wasm_bindgen::JsValue::NULL);
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        let _ = changed;
+    }
+
+    /// Merges a remote change into the project (or adopts a whole one, giving back the checkpoint it replaced), with no
+    /// undo step of its own.
+    fn live_apply(&mut self, base: Option<&[u8]>, edited: &[u8]) -> Result<Option<Vec<u8>>, String> {
+        // A whole project installs even when this one cannot be shared (too large): it then gives nothing back.
+        let local = self.live_encode();
+        let current = local.as_deref().ok().map(checkpoint::parse).transpose()?;
+        let edited = checkpoint::parse(edited)?;
+        let target = match (base, &current) {
+            (Some(base), Some(current)) => checkpoint::merge(&checkpoint::parse(base)?, current, &edited)?,
+            (Some(_), None) => return Err(local.err().unwrap_or_default()),
+            (None, _) => {
+                checkpoint::check_whole(&edited, current.as_ref())?;
+                // Joined: the welcome hub's New and Open would only be refused now.
+                self.state.welcome.open = false;
+                edited
+            }
+        };
+        let s = &mut self.state.session;
+        let install = checkpoint::install(&target, s.history().current(), s.resources(), &s.scene().mesh)?;
+        match install.mesh {
+            None => s.adopt(install.doc, install.resources, false),
+            // Another model: a session of its own, as when opening one.
+            Some((mesh, bytes)) => {
+                let mut store = subcraft_doc::ResourceStore::default();
+                for r in install.resources {
+                    store.insert_shared(r);
+                }
+                self.state.set_session(subcraft_app::Session::from_parts(mesh, install.doc, store, "Live session"));
+                checkpoint::known_mesh(&self.state.session.scene().mesh, &bytes);
+            }
+        }
+        Ok(local.ok().filter(|_| base.is_none()))
+    }
+
+    /// The session ended: native Undo starts over from the project as the session left it.
+    fn live_disconnected(&mut self) {
+        let doc = self.state.session.history().current().clone();
+        self.state.session.adopt(doc, Vec::new(), true);
+    }
+}
+
+/// The adapter object the Playground shell drives (`shell/live.js`): `format`; `checkpoint()`, the canonical shared
+/// project, throwing `busy` while a gesture is under way; `merge(base, current, edited)`, the pure strict merge;
+/// `apply(base, edited)`, a promise that merges `edited` (with no base: adopts it whole, resolving to the checkpoint
+/// it replaced) at the end of the next quiet frame; `connect({ changed, undo })` and `disconnect()`. The hooks are
+/// called from inside a frame: the shell defers its calls back.
+#[cfg(target_arch = "wasm32")]
+pub(crate) mod web {
+    use super::{LIVE, SubcraftApp};
+    use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+    use js_sys::{Function, Object, Promise, Reflect, Uint8Array};
+
+    pub(super) struct Hooks {
+        pub(super) changed: Function,
+        pub(super) undo: Function,
+    }
+
+    pub(super) fn call(pick: impl FnOnce(&Hooks) -> &Function, arg: &JsValue) {
+        if let Some(hook) = LIVE.with_borrow(|live| live.hooks.as_ref().map(|hooks| pick(hooks).clone())) {
+            let _ = hook.call1(&JsValue::NULL, arg);
+        }
+    }
+
+    /// Offers the adapter as `globalThis.playgroundLiveAdapter`, and to `globalThis.playgroundLive.attach` when the
+    /// shell is there already. A page without the shell never connects.
+    pub(crate) fn attach(runner: &eframe::WebRunner) -> Result<(), JsValue> {
+        let adapter = Object::new();
+        let set = |name: &str, value: JsValue| Reflect::set(&adapter, &name.into(), &value).map(drop);
+        set("format", format!("substance-painter:1:{}", env!("CARGO_PKG_VERSION")).into())?;
+        let app = runner.clone();
+        let checkpoint = move || -> Result<Uint8Array, JsValue> {
+            // Not running yet, or inside a frame: the shell retries a busy checkpoint.
+            let app = app.app_mut::<SubcraftApp>().ok_or("busy")?;
+            Ok(app.live_checkpoint().map_err(|e| JsValue::from_str(&e))?.as_slice().into())
+        };
+        set("checkpoint", Closure::<dyn Fn() -> _>::new(checkpoint).into_js_value())?;
+        let merge = |base: Uint8Array, current: Uint8Array, edited: Uint8Array| -> Result<Uint8Array, JsValue> {
+            let merged = super::checkpoint::merge_bytes(&base.to_vec(), &current.to_vec(), &edited.to_vec());
+            Ok(merged.map_err(|e| JsValue::from_str(&e))?.as_slice().into())
+        };
+        set("merge", Closure::<dyn Fn(_, _, _) -> _>::new(merge).into_js_value())?;
+        let apply = |base: JsValue, edited: Uint8Array| -> Promise {
+            let mut job = Some((base.dyn_ref::<Uint8Array>().map(Uint8Array::to_vec), edited.to_vec()));
+            Promise::new(&mut |resolve, reject| {
+                let Some((base, edited)) = job.take() else { return };
+                super::queue(
+                    base,
+                    edited,
+                    Box::new(move |result| {
+                        let _ = match result {
+                            Ok(None) => resolve.call0(&JsValue::NULL),
+                            Ok(Some(replaced)) => resolve.call1(&JsValue::NULL, &Uint8Array::from(replaced.as_slice())),
+                            Err(e) => reject.call1(&JsValue::NULL, &JsValue::from_str(&e)),
+                        };
+                    }),
+                );
+            })
+        };
+        set("apply", Closure::<dyn Fn(_, _) -> _>::new(apply).into_js_value())?;
+        let connect = |hooks: JsValue| -> Result<(), JsValue> {
+            let get = |name: &str| Reflect::get(&hooks, &name.into())?.dyn_into::<Function>();
+            let hooks = Hooks { changed: get("changed")?, undo: get("undo")? };
+            super::connect();
+            LIVE.with_borrow_mut(|live| {
+                live.hooks = Some(hooks);
+                if let Some(ctx) = &live.ctx {
+                    ctx.request_repaint();
+                }
+            });
+            Ok(())
+        };
+        set("connect", Closure::<dyn Fn(_) -> _>::new(connect).into_js_value())?;
+        let app = runner.clone();
+        let disconnect = move || {
+            super::disconnect();
+            if let Some(mut app) = app.app_mut::<SubcraftApp>() {
+                app.live_disconnected();
+            }
+        };
+        set("disconnect", Closure::<dyn Fn()>::new(disconnect).into_js_value())?;
+        let global = js_sys::global();
+        Reflect::set(&global, &"playgroundLiveAdapter".into(), &adapter)?;
+        let attach = Reflect::get(&global, &"playgroundLive".into())
+            .and_then(|live| Reflect::get(&live, &"attach".into()))
+            .ok()
+            .and_then(|attach| attach.dyn_into::<Function>().ok());
+        if let Some(attach) = attach {
+            attach.call1(&global, &adapter)?;
+        }
+        Ok(())
+    }
+}
+
