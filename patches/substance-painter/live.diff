+//! The others in a live session, in their colour. In the 3D view, through this person's camera: the strokes they are
+//! painting (the surface points so far, at their brush width) and the pen paths they are editing, then their pointers
+//! with a "Name · Layer" tag; what the model hides is drawn faint. In the 2D view: their pen paths under way. In the
+//! Layers panel: a frame around the layer each has selected, the line where a layer they drag would drop, and a tag
+//! with the value of a layer setting they are dragging. Presence arrives about ten times a second: pointers and the
+//! newest end of strokes ease toward their latest state in object space, so this person's own orbiting never lags them.
+//! Everything in a state comes from another person: what doesn't read as ids or numbers in range is skipped.
+// The painting is web only (the hooks are); native tests use the projections.
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use egui::{Color32, Pos2, Rect, Shape, Stroke, StrokeKind, Vec2 as V2, vec2};
+use glam::{Vec2, Vec3};
+use serde::Deserialize as _;
+use serde_json::Value;
+use subcraft_app::Camera;
+use subcraft_app::layer_tree::DropTarget;
+use subcraft_core::{LayerId, TextureSetId};
+
+use super::Presence;
+use crate::state::UiState;
+
+/// How long the others' marks take to go most (1 - 1/e) of the way to where they last were, in seconds.
+const EASE: f32 = 0.08;
+/// The most points of a remote path (twice what a presence carries).
+const MAX_POINTS: usize = 400;
+
+/// `N` finite numbers of a sane size (remote data).
+fn coords<const N: usize>(v: &Value) -> Option<[f32; N]> {
+    let v = v.as_array().filter(|v| v.len() == N)?;
+    let mut out = [0.0; N];
+    for (o, c) in out.iter_mut().zip(v) {
+        *o = c.as_f64().filter(|c| c.abs() < 1e9)? as f32;
+    }
+    Some(out)
+}
+
+/// Another person's pointer: a point on the model in object space.
+pub(super) fn point(v: &Value) -> Option<Vec3> {
+    coords::<3>(v).map(Vec3::from_array)
+}
+
+/// A path of `N`-number points, at most [`MAX_POINTS`].
+pub(super) fn path<const N: usize>(v: &Value) -> Option<Vec<[f32; N]>> {
+    v.as_array().filter(|v| v.len() <= MAX_POINTS)?.iter().map(coords).collect()
+}
+
+/// A positive size in range.
+fn size(v: &Value) -> Option<f32> {
+    v.as_f64().filter(|s| *s > 0.0 && *s < 1e6).map(|s| s as f32)
+}
+
+fn page(o: &Presence) -> Option<TextureSetId> {
+    TextureSetId::deserialize(&o.state["page"]).ok()
+}
+
+fn layer(v: &Value) -> Option<LayerId> {
+    LayerId::deserialize(v).ok()
+}
+
+fn color(o: &Presence) -> Color32 {
+    Color32::from_rgb(o.color[0], o.color[1], o.color[2])
+}
+
+/// `text` cut to `n` characters, with "…" when cut.
+fn cut_text(text: &str, n: usize) -> String {
+    match text.chars().nth(n) {
+        Some(_) => text.chars().take(n - 1).chain(['…']).collect(),
+        None => text.to_owned(),
+    }
+}
+
+/// "Name · Layer": their name and the layer they work on, when it is in this document.
+pub(super) fn label(state: &UiState, o: &Presence) -> String {
+    let name = cut_text(&o.name, 24);
+    let layer = page(o)
+        .and_then(|ts| state.session.document().texture_set(ts))
+        .zip(layer(&o.state["selection"][0]))
+        .and_then(|(ts, layer)| ts.find(layer));
+    match layer {
+        Some(layer) => format!("{name} · {}", cut_text(&layer.name, 24)),
+        None => name,
+    }
+}
+
+/// Where the surface point `p` shows in the 3D view at `rect` (in points), and whether the model hides it there; none
+/// behind the eye.
+pub(super) fn on_screen(state: &UiState, camera: &Camera, rect: Rect, ppp: f32, p: Vec3) -> Option<(Pos2, bool)> {
+    let screen = camera.project(p)?;
+    let at = rect.min + vec2(screen.x, screen.y) / ppp;
+    let tolerance = state.session.scene().mesh.bounds.diagonal() * 0.03;
+    Some((at, state.session.pick(camera, screen.truncate()).is_none_or(|hit| hit.position.distance(p) > tolerance)))
+}
+
+/// A person's moving marks as last drawn, in object space: their pointer, and how far (along the path) the drawn end of
+/// their stroke trails its newest point.
+#[derive(Default)]
+struct Shown {
+    pointer: Option<Vec3>,
+    tip: Option<Vec3>,
+    behind: f32,
+}
+
+thread_local! {
+    static SHOWN: RefCell<HashMap<String, Shown>> = RefCell::default();
+}
+
+/// How far along `path` from `q` (within `tol` of it) to its newest end, searched from that end.
+fn from_end(path: &[Vec3], q: Vec3, tol: f32) -> Option<f32> {
+    let mut d = 0.0;
+    for w in path.windows(2).rev() {
+        let (a, b) = (w[0], w[1]);
+        let len = a.distance(b);
+        let t = if len > 0.0 { ((q - a).dot(b - a) / (len * len)).clamp(0.0, 1.0) } else { 0.0 };
+        if a.lerp(b, t).distance(q) <= tol {
+            return Some(d + len * (1.0 - t));
+        }
+        d += len;
+    }
+    None
+}
+
+/// `path` without its last `behind` units.
+fn cut(path: &[Vec3], mut behind: f32) -> Vec<Vec3> {
+    let mut end = path.len();
+    while behind > 0.0 && end > 1 {
+        let (a, b) = (path[end - 2], path[end - 1]);
+        let len = a.distance(b);
+        if behind < len {
+            let mut kept = path[..end - 1].to_vec();
+            kept.push(b.lerp(a, behind / len));
+            return kept;
+        }
+        behind -= len;
+        end -= 1;
+    }
+    path[..end].to_vec()
+}
+
+/// A translucent stroke `w` wide along `path` (screen points), as one mesh so that no part of it covers another: round
+/// caps, mitred joins (at most twice as long), its edges feathered over `aa` points as egui feathers its own shapes.
+fn stroke(path: &[Pos2], w: f32, ink: Color32, aa: f32) -> Shape {
+    let mut pts: Vec<Pos2> = Vec::with_capacity(path.len());
+    for &p in path {
+        if pts.last().is_none_or(|q| q.distance(p) > 0.01) {
+            pts.push(p);
+        }
+    }
+    let n = pts.len();
+    let (inner, outer) = ((w - aa).max(0.0) / 2.0, (w + aa) / 2.0);
+    let clear = Color32::TRANSPARENT;
+    let dir = |i: usize| (pts[i + 1] - pts[i]).normalized();
+    let mut mesh = egui::Mesh::default();
+    // Per point, along its normal: the left edge's feather and inside, the right edge's inside and feather.
+    let normals: Vec<V2> = (0..n)
+        .map(|i| match i {
+            _ if n == 1 => V2::Y,
+            0 => dir(0).rot90(),
+            _ if i == n - 1 => dir(n - 2).rot90(),
+            _ => {
+                let (a, b) = (dir(i - 1).rot90(), dir(i).rot90());
+                let m = (a + b).normalized();
+                m / m.dot(a).max(0.5)
+            }
+        })
+        .collect();
+    for (p, normal) in pts.iter().zip(&normals) {
+        for (off, c) in [(outer, clear), (inner, ink), (-inner, ink), (-outer, clear)] {
+            mesh.colored_vertex(*p + *normal * off, c);
+        }
+    }
+    for a in (0..n.saturating_sub(1) as u32).map(|i| 4 * i) {
+        for k in 0..3 {
+            mesh.add_triangle(a + k, a + k + 1, a + 4 + k);
+            mesh.add_triangle(a + k + 1, a + 5 + k, a + 4 + k);
+        }
+    }
+    // Half a disc out of each end (a whole one around a single point), from the end's left edge to its right.
+    let mut cap = |i: usize, out: V2| {
+        let (p, left) = (pts[i], normals[i]);
+        let at = 4 * i as u32;
+        let centre = mesh.vertices.len() as u32;
+        mesh.colored_vertex(p, ink);
+        let (mut last_in, mut last_out) = (at + 1, at);
+        for k in 1..=12 {
+            let (sin, cos) = (std::f32::consts::PI * k as f32 / 12.0).sin_cos();
+            let (inside, edge) = match k {
+                12 => (at + 2, at + 3),
+                _ => {
+                    let u = left * cos + out * sin;
+                    let v = mesh.vertices.len() as u32;
+                    mesh.colored_vertex(p + u * inner, ink);
+                    mesh.colored_vertex(p + u * outer, clear);
+                    (v, v + 1)
+                }
+            };
+            mesh.add_triangle(centre, last_in, inside);
+            mesh.add_triangle(last_in, last_out, inside);
+            mesh.add_triangle(last_out, edge, inside);
+            (last_in, last_out) = (inside, edge);
+        }
+    };
+    match n {
+        0 => {}
+        1 => {
+            cap(0, V2::X);
+            cap(0, -V2::X);
+        }
+        _ => {
+            cap(0, -dir(0));
+            cap(n - 1, dir(n - 2));
+        }
+    }
+    Shape::mesh(mesh)
+}
+
+/// Relative luminance (sRGB) of `c`.
+fn luminance(c: Color32) -> f32 {
+    let lin = |v: u8| {
+        let v = f32::from(v) / 255.0;
+        if v <= 0.04045 { v / 12.92 } else { ((v + 0.055) / 1.055).powf(2.4) }
+    };
+    0.2126 * lin(c.r()) + 0.7152 * lin(c.g()) + 0.0722 * lin(c.b())
+}
+
+const TAG_PAD: V2 = vec2(7.0, 3.0);
+
+/// A tag's text on `color` (white, or near black on a light colour), at `alpha`.
+fn tag_text(painter: &egui::Painter, text: &str, color: Color32, alpha: f32) -> Arc<egui::Galley> {
+    let ink = if luminance(color) > 0.55 { Color32::from_rgb(0x11, 0x11, 0x11) } else { Color32::WHITE };
+    painter.layout_no_wrap(text.to_owned(), crate::theme::font_strong(12.0), ink.gamma_multiply(alpha))
+}
+
+/// A name or value tag filled with `fill`, its top left at `at` (on a pixel).
+fn tag(painter: &egui::Painter, at: Pos2, galley: Arc<egui::Galley>, fill: Color32) {
+    let ppp = painter.pixels_per_point();
+    let at = (at.to_vec2() * ppp).round().to_pos2() / ppp;
+    painter.rect_filled(Rect::from_min_size(at, galley.size() + 2.0 * TAG_PAD), 6.0, fill);
+    painter.galley(at + TAG_PAD, galley, fill);
+}
+
+/// The pointer arrow, tip at (0, 0), in points.
+const ARROW: [[f32; 2]; 7] = [[0.0, 0.0], [0.0, 16.0], [4.5, 12.2], [7.6, 18.6], [10.4, 17.3], [7.3, 11.0], [12.5, 11.0]];
+
+/// `points` filled with `fill` as a fan from the first (the arrow is star-shaped around its tip).
+fn fan(points: &[Pos2], fill: Color32) -> Shape {
+    let mut mesh = egui::Mesh::default();
+    for p in points {
+        mesh.colored_vertex(*p, fill);
+    }
+    for i in 1..points.len() as u32 - 1 {
+        mesh.add_triangle(0, i, i + 1);
+    }
+    Shape::mesh(mesh)
+}
+
+/// A person's pointer: the arrow in their colour with a white outline and a soft shadow, and their name tag (faint
+/// where the model hides the point).
+fn pointer(painter: &egui::Painter, tip: Pos2, color: Color32, name: &str, faint: bool) {
+    let ppp = painter.pixels_per_point();
+    let tip = (tip.to_vec2() * ppp).round().to_pos2() / ppp;
+    let alpha = if faint { 0.45 } else { 1.0 };
+    let arrow = |off: V2| ARROW.map(|[x, y]| tip + off + vec2(x, y));
+    painter.add(fan(&arrow(vec2(0.0, 1.0)), Color32::from_black_alpha(64).gamma_multiply(alpha)));
+    painter.add(fan(&arrow(V2::ZERO), color.gamma_multiply(alpha)));
+    painter.add(Shape::closed_line(arrow(V2::ZERO).to_vec(), Stroke::new(1.5, Color32::WHITE.gamma_multiply(alpha))));
+    tag(painter, tip + vec2(12.0, 15.0), tag_text(painter, name, color, alpha), color.gamma_multiply(alpha));
+}
+
+/// A stroke on the model: its points in object space (`None` breaks it), at `w` points wide; where the model hides it,
+/// faint.
+fn surface_stroke(state: &UiState, painter: &egui::Painter, camera: &Camera, rect: Rect, points: &[Option<Vec3>], w: f32, color: Color32) {
+    let ppp = painter.pixels_per_point();
+    // Runs of points alike (shown or hidden), each starting where the last one ended.
+    let mut runs: Vec<(bool, Vec<Pos2>)> = Vec::new();
+    let mut last: Option<(Pos2, bool)> = None;
+    for p in points {
+        let Some((at, hidden)) = p.and_then(|p| on_screen(state, camera, rect, ppp, p)) else {
+            last = None;
+            continue;
+        };
+        match (last, runs.last_mut()) {
+            (Some((_, was)), Some((h, run))) if was == hidden && *h == hidden => run.push(at),
+            (Some((from, _)), _) => runs.push((hidden, vec![from, at])),
+            (None, _) => runs.push((hidden, vec![at])),
+        }
+        last = Some((at, hidden));
+    }
+    let aa = 1.0 / ppp;
+    for (hidden, run) in runs {
+        let ink = color.gamma_multiply(if hidden { 0.7 * 0.45 } else { 0.7 });
+        painter.add(stroke(&run, w, ink, aa));
+    }
+}
+
+/// Points on screen per object unit at `p`.
+fn per_unit(camera: &Camera, ppp: f32, p: Vec3) -> f32 {
+    camera.pixels_per_unit(camera.view_depth(p)) / ppp
+}
+
+/// On the model in the 3D view at `rect` (this person's `camera`): the others' strokes and pen paths under way, then
+/// their pointers and tags, easing toward where they last were. Whether a mark is still on its way.
+pub(super) fn draw_3d(state: &UiState, painter: &egui::Painter, camera: &Camera, rect: Rect, others: &[Presence]) -> bool {
+    let ctx = painter.ctx();
+    let ppp = ctx.pixels_per_point();
+    let k = 1.0 - (-ctx.input(|i| i.stable_dt).clamp(0.0, 0.1) / EASE).exp();
+    let far = rect.width().max(rect.height()) / 4.0;
+    let screen = |p: Vec3| camera.project(p).map(|s| rect.min + vec2(s.x, s.y) / ppp);
+    let mine = state.session.selected_texture_set().id;
+    let mut moving = false;
+    SHOWN.with_borrow_mut(|shown| {
+        shown.retain(|id, _| others.iter().any(|o| o.id == *id));
+        let mut tips = Vec::new();
+        for o in others {
+            let s = shown.entry(o.id.clone()).or_default();
+            let color = color(o);
+            // Their stroke on the model, its newest end easing along it.
+            let st = &o.state["stroke"];
+            let points: Vec<Vec3> = path::<3>(&st["points"]).unwrap_or_default().into_iter().map(Vec3::from_array).collect();
+            if let (Some(&tip), Some(r)) = (points.last(), size(&st["size"])) {
+                let unit = per_unit(camera, ppp, tip);
+                if s.tip != Some(tip) {
+                    let since = s.tip.and_then(|old| from_end(&points, old, 4.0 / unit.max(1e-6)));
+                    s.behind = since.map_or(0.0, |d| s.behind + d);
+                    s.tip = Some(tip);
+                }
+                s.behind *= 1.0 - k;
+                if s.behind * unit < 0.5 || s.behind * unit > far {
+                    s.behind = 0.0;
+                }
+                moving |= s.behind > 0.0;
+                let shown: Vec<_> = cut(&points, s.behind).into_iter().map(Some).collect();
+                let w = (2.0 * r * unit).clamp(2.0, far);
+                surface_stroke(state, painter, camera, rect, &shown, w, color);
+            } else {
+                (s.tip, s.behind) = (None, 0.0);
+            }
+            // Their pen path, where it lies on this texture set (when it is the one shown here).
+            let pen = &o.state["pen"];
+            if page(o) == Some(mine)
+                && let (Some(points), Some(r)) = (path::<2>(&pen["points"]), size(&pen["size"]))
+            {
+                let at = |uv: Vec2| state.session.pen_uv_position(uv);
+                let on: Vec<Option<Vec3>> = points.iter().map(|uv| at(Vec2::from_array(*uv))).collect();
+                // Its width (a share of the UV square) on the model at its newest point: the nearest of the surface
+                // points a radius away in UV (a seam lands farther).
+                let w = points.iter().zip(&on).rev().find_map(|(uv, p)| {
+                    let (uv, p) = (Vec2::from_array(*uv), (*p)?);
+                    let near = [Vec2::X, -Vec2::X, Vec2::Y, -Vec2::Y].into_iter().filter_map(|d| at(uv + d * r)).map(|q| q.distance(p));
+                    near.filter(|d| *d > 0.0).min_by(f32::total_cmp).map(|d| 2.0 * d * per_unit(camera, ppp, p))
+                });
+                surface_stroke(state, painter, camera, rect, &on, w.unwrap_or(2.0).clamp(2.0, far), color);
+            }
+            // Their pointer, eased in object space; whether the model hides it is decided where it is going.
+            let target = point(&o.state["pointer"]);
+            let jump = |a: Vec3, b: Vec3| screen(a).zip(screen(b)).is_none_or(|(a, b)| a.distance(b) > far);
+            s.pointer = match (s.pointer, target) {
+                (Some(at), Some(to)) if !jump(at, to) => {
+                    let next = at.lerp(to, k);
+                    let near = screen(next).zip(screen(to)).is_none_or(|(a, b)| a.distance(b) < 0.5);
+                    moving |= !near;
+                    Some(if near { to } else { next })
+                }
+                (_, to) => to,
+            };
+            if let (Some(at), Some(to)) = (s.pointer, target)
+                && let (Some(at), Some((_, hidden))) = (screen(at), on_screen(state, camera, rect, ppp, to))
+                && rect.contains(at)
+            {
+                tips.push((at, color, label(state, o), hidden));
+            }
+        }
+        // Pointers over every stroke.
+        for (at, color, name, hidden) in tips {
+            pointer(painter, at, color, &name, hidden);
+        }
+    });
+    moving
+}
+
+/// In the 2D view (the selected texture set's UV square at `image`): the others' pen paths under way on it.
+pub(super) fn draw_uv(state: &UiState, painter: &egui::Painter, image: Rect, others: &[Presence]) {
+    let mine = state.session.selected_texture_set().id;
+    for o in others.iter().filter(|o| page(o) == Some(mine)) {
+        let pen = &o.state["pen"];
+        if let (Some(points), Some(r)) = (path::<2>(&pen["points"]), size(&pen["size"])) {
+            let on: Vec<Pos2> = points.iter().map(|[u, v]| image.min + vec2(*u, *v) * image.width()).collect();
+            let w = (2.0 * r * image.width()).clamp(2.0, image.width());
+            painter.add(stroke(&on, w, color(o).gamma_multiply(0.7), 1.0 / painter.pixels_per_point()));
+        }
+    }
+}
+
+/// The drop target someone's layer drag would take, when it is a row of theirs (`["above" | "below" | "inside", id]`).
+pub(super) fn drop_target(v: &Value) -> Option<DropTarget> {
+    let id = layer(&v[1])?;
+    match v[0].as_str()? {
+        "above" => Some(DropTarget::Above(id)),
+        "below" => Some(DropTarget::Below(id)),
+        "inside" => Some(DropTarget::Inside(id)),
+        _ => None,
+    }
+}
+
+/// In the Layers panel, on the row of `layer` (of texture set `set`) at `rect`, for each other person on that texture
+/// set: a frame in their colour when it is the layer they selected, the line (or frame, for into a folder) where a
+/// layer they drag would drop, and the value of a setting of it they are dragging.
+pub(super) fn row(painter: &egui::Painter, set: TextureSetId, id: LayerId, rect: Rect, others: &[Presence]) {
+    let ppp = painter.pixels_per_point();
+    let snap = |r: Rect| Rect::from_min_max((r.min.to_vec2() * ppp).round().to_pos2() / ppp, (r.max.to_vec2() * ppp).round().to_pos2() / ppp);
+    let mut inset = 0.0;
+    let mut right = rect.right() - 8.0;
+    for o in others.iter().filter(|o| page(o) == Some(set)) {
+        let color = color(o);
+        if layer(&o.state["selection"][0]) == Some(id) {
+            painter.rect_stroke(snap(rect.shrink(inset)), 0.0, Stroke::new(2.0, color), StrokeKind::Inside);
+            inset += 2.0;
+        }
+        // The app's own drop marker, in their colour.
+        let (line, edge) = (Stroke::new(2.0, color.gamma_multiply(0.85)), Stroke::new(1.5, color.gamma_multiply(0.85)));
+        match drop_target(&o.state["reorder"]) {
+            Some(DropTarget::Above(l)) if l == id => {
+                painter.line_segment([rect.left_top(), rect.right_top()], line);
+            }
+            Some(DropTarget::Below(l)) if l == id => {
+                painter.line_segment([rect.left_bottom(), rect.right_bottom()], line);
+            }
+            Some(DropTarget::Inside(l)) if l == id => {
+                painter.rect(snap(rect), 0.0, color.gamma_multiply(0.28), edge, StrokeKind::Inside);
+            }
+            _ => {}
+        }
+        let adjust = &o.state["adjust"];
+        if layer(&adjust["layer"]) == Some(id)
+            && let Some(text) = adjust["text"].as_str()
+        {
+            let text: String = cut_text(&text.chars().filter(|c| !c.is_control()).collect::<String>(), 40);
+            let galley = tag_text(painter, &text, color, 1.0);
+            let size = galley.size() + 2.0 * TAG_PAD;
+            right -= size.x;
+            tag(painter, Pos2::new(right, rect.center().y - size.y / 2.0), galley, color);
+            right -= 4.0;
+        }
+    }
+}
