+//! Live editing in a Playground session (subcraft-ui's `app::live`): a project changed elsewhere, installed into the
+//! session without an undo step of its own.
+
+use std::sync::Arc;
+
+use subcraft_doc::{Document, Resource};
+
+use super::Session;
+
+impl Session {
+    /// Installs a document changed elsewhere (a live session) with no undo step of its own, adding the images it
+    /// uses; the selection is repaired as after Undo. `restart`: the history starts over from it.
+    pub fn live_adopt(&mut self, doc: Document, resources: Vec<Arc<Resource>>, restart: bool) {
+        for r in resources {
+            self.resources.insert_shared(r);
+        }
+        let h = &mut self.history;
+        let label = h.entries()[h.cursor()].label.clone();
+        if restart {
+            h.reset(doc, "Live session");
+        } else if h.undo().is_some() {
+            // The current entry, replaced in place (any redo branch, out of reach while connected, goes).
+            h.push(label, doc);
+        } else {
+            h.reset(doc, label);
+        }
+        self.sync_after_history_move();
+    }
+}
