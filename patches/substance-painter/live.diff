+/// `checkpoint` installed into `s` with no base, as a joining peer does.
+fn adopt(s: &mut Session, checkpoint: &[u8]) {
+    let cp = parse(checkpoint).unwrap();
+    checkpoint::check_whole(&cp, Some(&parse(&bytes(s)).unwrap())).unwrap();
+    let i = install(&cp, s.history().current(), s.resources(), &s.scene().mesh).unwrap();
+    assert!(i.mesh.is_none());
+    s.live_adopt(i.doc, i.resources, false);
+}
+
+fn png() -> Arc<Resource> {
+    image(None)
+}
+
+/// A small image whose file is `file` (default: its PNG).
+fn image(file: Option<Vec<u8>>) -> Arc<Resource> {
+    let bitmap = subcraft_image::Bitmap::new_u8(2, 2, 3, vec![255, 0, 0, 0, 255, 0, 0, 0, 255, 9, 9, 9]);
+    let encoded = subcraft_image::encode_bitmap(&bitmap).unwrap().0;
+    Arc::new(Resource {
+        id: ResourceId::new(),
+        name: "logo.png".into(),
+        kind: ResourceKind::Texture,
+        bitmap: Arc::new(subcraft_image::io::decode_bitmap(&encoded, None).unwrap()),
+        source_path: None,
+        encoded: Some(Arc::new(file.unwrap_or(encoded))),
+    })
+}
+
+/// A fill layer showing `image`, above the selection.
+fn image_fill(s: &mut Session, image: Arc<Resource>) {
+    let id = image.id;
+    let doc = s.history().current().clone();
+    s.live_adopt(doc, vec![image], false);
+    s.execute(Command::AddLayer(NewLayer::Fill)).unwrap();
+    let layer = s.selection().layer.unwrap();
+    let fill = FillChannel::new(FillSource::Bitmap { resource: id });
+    s.execute(Command::SetFillChannel { layer, channel: ChannelKind::BaseColor, fill }).unwrap();
+}
