+#[test]
+fn merges_take_tiles_layers_and_fields_from_whoever_changed_them_and_conflict_when_both_did() {
+    let mut a = cube();
+    let base = bytes(&a);
+    let mut b = cube();
+    adopt(&mut b, &base);
+    // Different tiles of the same layer, and a new layer with an image on each side.
+    stroke(&mut a, (0.3, 0.3), (0.35, 0.32));
+    image_fill(&mut a, png());
+    stroke(&mut b, (0.62, 0.65), (0.68, 0.7));
+    image_fill(&mut b, png());
+    let (ca, cb) = (bytes(&a), bytes(&b));
+    let merged = merge_bytes(&base, &ca, &cb).unwrap();
+    let both = parse(&merged).unwrap();
+    let i = install(&both, a.history().current(), a.resources(), &a.scene().mesh).unwrap();
+    let ts = &i.doc.texture_sets[0];
+    assert_eq!(ts.layers.len(), 3, "both new layers");
+    assert_eq!(i.resources.len(), 1, "the other side's image (union)");
+    let painted = |doc: &subcraft_doc::Document| match &doc.texture_sets[0].layers[0].content {
+        LayerContent::Paint(p) => p.channels[&ChannelKind::BaseColor].allocated_tiles(),
+        _ => unreachable!(),
+    };
+    let (pa, pb) = (painted(a.history().current()), painted(b.history().current()));
+    assert_eq!(painted(&i.doc), pa + pb, "both strokes' tiles");
+    a.live_adopt(i.doc, i.resources, false);
+    assert_eq!(bytes(&a), merged, "the merge is what the merged project reports");
+
+    // The same tile from both sides conflicts, as does one field both changed (even to the same value).
+    let mut c = cube();
+    adopt(&mut c, &base);
+    stroke(&mut c, (0.31, 0.31), (0.36, 0.33));
+    let err = merge_bytes(&base, &ca, &bytes(&c)).unwrap_err();
+    assert!(err.contains("tile"), "{err}");
+    let layer = a.history().current().texture_sets[0].layers[0].id;
+    let mut d = cube();
+    adopt(&mut d, &base);
+    let mut e = cube();
+    adopt(&mut e, &base);
+    for s in [&mut d, &mut e] {
+        s.execute(Command::Rename { layer, name: "Same".into() }).unwrap();
+    }
+    assert!(merge_bytes(&base, &bytes(&d), &bytes(&e)).unwrap_err().contains("Conflict"));
+    // Per-channel settings merge by channel: two people's opacities on one layer.
+    let (mut d, mut e) = (cube(), cube());
+    adopt(&mut d, &base);
+    adopt(&mut e, &base);
+    for (s, channel) in [(&mut d, ChannelKind::BaseColor), (&mut e, ChannelKind::Roughness)] {
+        s.execute(Command::SetBlendOpacity { layer, channel, opacity: 0.25 }).unwrap();
+    }
+    let merged = merge_bytes(&base, &bytes(&d), &bytes(&e)).unwrap();
+    let both = parse(&merged).unwrap();
+    let i = install(&both, d.history().current(), d.resources(), &d.scene().mesh).unwrap();
+    let blend = &i.doc.texture_sets[0].layers[0].blend;
+    assert_eq!((blend[&ChannelKind::BaseColor].opacity, blend[&ChannelKind::Roughness].opacity), (0.25, 0.25));
+
+    // Not this build's form, or not a checkpoint: refused before anyone records it.
+    let mut extra: serde_json::Value = serde_json::from_slice(json_of(&cb)).unwrap();
+    extra["texture_sets"][0]["layers"][0]["note"] = "x".into();
+    assert!(merge_bytes(&base, &base, &with_json(&cb, &extra)).unwrap_err().contains("this build's form"));
+    assert!(merge_bytes(&base, &base, b"SCLIVE01").is_err());
+}
+
+fn json_of(checkpoint: &[u8]) -> &[u8] {
+    let n = u32::from_le_bytes(checkpoint[8..12].try_into().unwrap()) as usize;
+    &checkpoint[12..12 + n]
+}
+
+fn with_json(checkpoint: &[u8], json: &serde_json::Value) -> Vec<u8> {
+    let json = serde_json::to_vec(json).unwrap();
+    let rest = &checkpoint[12 + json_of(checkpoint).len()..];
+    [&checkpoint[..8], &(json.len() as u32).to_le_bytes(), &json, rest].concat()
+}
