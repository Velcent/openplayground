+/// A real brush stroke (every channel of the default brush) across the view, `from` and `to` in 0..1.
+fn stroke(s: &mut Session, from: (f32, f32), to: (f32, f32)) {
+    let camera = crate::orbit::OrbitCamera::framing(&s.scene().mesh.bounds).paint_camera([800, 600]);
+    s.begin_stroke().unwrap();
+    for k in 0..=24 {
+        let t = k as f32 / 24.0;
+        let p = Vec2::new(from.0 + (to.0 - from.0) * t, from.1 + (to.1 - from.1) * t) * Vec2::new(800.0, 600.0);
+        s.stroke_to(&camera, p, false).unwrap();
+    }
+    s.end_stroke();
+}
