+    assert_eq!(s.document(), s.history().current());
+    assert!(undo(true) && LIVE.with_borrow(|l| l.undos.clone()) == [true], "Undo goes to the session");
+    let changes = LIVE.with_borrow(|l| l.changes);
+    owner.live_frame(&ctx);
+    assert_eq!(LIVE.with_borrow(|l| l.changes), changes, "no change: nothing to report");
+
+    // While connected, New and Open wait for the session's end.
+    let mesh = Arc::as_ptr(&owner.state.session.scene().mesh);
+    owner.request(crate::dialogs::Pending::NewSample, 0.0);
+    assert!(owner.pending_now.is_none() && owner.state.confirm.is_none());
+    assert_eq!(Arc::as_ptr(&owner.state.session.scene().mesh), mesh);
+
+    // A project too large to share still takes a whole shared one (giving nothing back), so a peer never wedges.
+    let shared = bytes(&peer);
+    image_fill(&mut owner.state.session, image(Some(vec![0; checkpoint::MAX_BYTES])));
+    owner.state.welcome.open = true;
+    assert!(owner.live_apply(Some(&shared), &shared).unwrap_err().contains("too large"));
+    assert_eq!(owner.live_apply(None, &shared), Ok(None));
+    assert_eq!(owner.live_encode().unwrap(), shared);
+    assert!(!owner.state.welcome.open, "joined: the welcome hub closes");
+
+    disconnect();
+    owner.live_disconnected();
+    assert!(!undo(false));
+    assert_eq!(owner.state.session.history().entries().len(), 1, "native Undo starts over");
+}
+
+#[test]
+fn a_stroke_changes_a_small_span_and_oversized_projects_fail_clearly() {
+    let mut s = Session::sample();
+    let before = bytes(&s);
+    let mut spans = Vec::new();
+    for (from, to) in [((0.45, 0.35), (0.6, 0.45)), ((0.5, 0.5), (0.55, 0.6)), ((0.4, 0.6), (0.48, 0.62))] {
+        let (was, layer) = (bytes(&s), s.selected_layer().unwrap().clone());
+        stroke(&mut s, from, to);
+        let now = bytes(&s);
+        let prefix = was.iter().zip(&now).take_while(|(a, b)| a == b).count();
+        let suffix = was.iter().rev().zip(now.iter().rev()).take_while(|(a, b)| a == b).count();
+        let span = now.len() - prefix - suffix.min(was.len().min(now.len()) - prefix);
+        let (LayerContent::Paint(a), LayerContent::Paint(b)) = (&layer.content, &s.selected_layer().unwrap().content) else { unreachable!() };
+        let tiles: usize = b.channels.iter().map(|(k, i)| a.channels.get(k).map_or(i.allocated_tiles(), |was| i.changed_tiles(was).len())).sum();
+        spans.push((now.len(), span, tiles));
+    }
+    eprintln!(
+        "sample crate at 1024²: empty {} bytes; after 3 strokes {} bytes ({} bytes of raw texels); per stroke (checkpoint, changed span, tiles touched): {spans:?}",
+        before.len(),
+        bytes(&s).len(),
+        s.history().current().raster_bytes()
+    );
+    assert!(spans.iter().skip(1).all(|&(size, span, _)| span < size / 2), "{spans:?}");
+
+    image_fill(&mut s, image(Some(vec![0; checkpoint::MAX_BYTES])));
+    let err = encode(s.history().current(), s.resources(), &s.scene().mesh).unwrap_err();
+    assert!(err.contains("too large to edit live") && err.contains("128 MiB"), "{err}");
+    assert!(parse(&vec![0; checkpoint::MAX_BYTES + 1]).unwrap_err().contains("too large"));
+}
