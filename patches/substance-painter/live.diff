+#[test]
+fn checkpoints_are_canonical_leave_views_out_and_install_exactly() {
+    let mut a = cube();
+    a.execute(Command::AddLayer(NewLayer::Folder)).unwrap();
+    let folder = a.selection().layer.unwrap();
+    a.execute(Command::AddMask { layer: folder, white: true }).unwrap();
+    let paint = a.selected_texture_set().layers[0].id;
+    a.execute(Command::SelectLayer(Some(paint))).unwrap();
+    stroke(&mut a, (0.4, 0.4), (0.6, 0.55));
+    image_fill(&mut a, png());
+    let shared = bytes(&a);
+    assert_eq!(write(&parse(&shared).unwrap()).unwrap(), shared, "parsing and writing give the same bytes");
+
+    // Views: selection, an open folder, the brush, the tool. The folder's open state is in the document and its
+    // history, but personal.
+    a.execute(Command::SetFolderExpanded { layer: folder, expanded: false }).unwrap();
+    a.execute(Command::SelectLayer(None)).unwrap();
+    a.brush.settings.size *= 2.0;
+    assert_eq!(bytes(&a), shared, "views are not shared");
+
+    // A peer on the same model installs it exactly, keeping its own folder state, and reports the same bytes.
+    let mut b = cube();
+    adopt(&mut b, &shared);
+    assert_eq!(bytes(&b), shared);
+    let (da, db) = (a.history().current(), b.history().current());
+    assert_eq!(da.texture_sets[0].layers[0], db.texture_sets[0].layers[0], "painted tiles arrive exactly");
+    assert!(b.resources().len() == 1 && b.history().entries().len() == 1, "the image arrives; no undo step");
+    let open = |s: &Session| match &s.history().current().texture_sets[0].find(folder).unwrap().content {
+        LayerContent::Group(g) => g.expanded,
+        _ => unreachable!(),
+    };
+    assert!(!open(&a) && open(&b));
