+#[test]
+fn remote_changes_wait_for_quiet_install_without_an_undo_step_and_keep_views() {
+    let mut owner = app(cube());
+    let mut peer = cube();
+    let base = owner.live_encode().unwrap();
+    adopt(&mut peer, &base);
+    stroke(&mut peer, (0.4, 0.4), (0.6, 0.5));
+    let edited = bytes(&peer);
+    // The owner's own views and history.
+    owner.state.session.execute(Command::AddLayer(NewLayer::Folder)).unwrap();
+    owner.state.camera.orbit(30.0, 10.0);
+    let (camera, selection, history) =
+        (owner.state.camera.paint_camera([8, 8]).view, owner.state.session.selection(), owner.state.session.history().entries().len());
+
+    connect();
+    assert!(connected());
+    let done = std::rc::Rc::new(std::cell::RefCell::new(None));
+    let to = done.clone();
+    queue(Some(base), edited, Box::new(move |r| *to.borrow_mut() = Some(r)));
+    owner.state.painting = true;
+    let ctx = egui::Context::default();
+    owner.live_frame(&ctx);
+    assert!(done.borrow().is_none(), "a stroke under way waits");
+    assert_eq!(owner.live_checkpoint().unwrap_err(), "busy");
+    owner.state.painting = false;
+    owner.live_frame(&ctx);
+    assert_eq!(*done.borrow(), Some(Ok(None)));
+    let s = &owner.state.session;
+    assert_eq!(s.history().entries().len(), history, "no undo step");
+    assert_eq!((s.selection(), owner.state.camera.paint_camera([8, 8]).view), (selection, camera), "views stay");
+    assert_eq!(s.selected_texture_set().layers.len(), 2, "the owner's folder stays");
+    assert_eq!(s.document(), s.history().current());
+    assert!(undo(true) && LIVE.with_borrow(|l| l.undos.clone()) == [true], "Undo goes to the session");
+    let changes = LIVE.with_borrow(|l| l.changes);
+    owner.live_frame(&ctx);
+    assert_eq!(LIVE.with_borrow(|l| l.changes), changes, "no change: nothing to report");
+
+    // While connected, New and Open wait for the session's end.
+    let mesh = Arc::as_ptr(&owner.state.session.scene().mesh);
+    owner.request(crate::dialogs::Pending::NewSample, 0.0);
+    assert!(owner.pending_now.is_none() && owner.state.confirm.is_none());
+    assert_eq!(Arc::as_ptr(&owner.state.session.scene().mesh), mesh);
+
+    // A project too large to share still takes a whole shared one (giving nothing back), so a peer never wedges.
+    let shared = bytes(&peer);
+    image_fill(&mut owner.state.session, image(Some(vec![0; checkpoint::MAX_BYTES])));
+    owner.state.welcome.open = true;
+    assert!(owner.live_apply(Some(&shared), &shared).unwrap_err().contains("too large"));
+    assert_eq!(owner.live_apply(None, &shared), Ok(None));
+    assert_eq!(owner.live_encode().unwrap(), shared);
+    assert!(!owner.state.welcome.open, "joined: the welcome hub closes");
+
+    disconnect();
+    owner.live_disconnected();
+    assert!(!undo(false));
+    assert_eq!(owner.state.session.history().entries().len(), 1, "native Undo starts over");
+}
