+//! The shared project as one canonical binary checkpoint (the same project gives the same bytes on every peer), and
+//! its strict three-way merge.
+//!
+//! Layout, little endian, every list sorted:
+//! - `SCLIVE01`;
+//! - u32 length + canonical JSON: texture sets with their settings and layer trees, in the project file's schema
+//!   (`DocumentV1`), without folder open state (personal) and with the rasters in the sections below;
+//! - u32 length + the mesh (`subcraft_mesh::serialize`, deflated);
+//! - u32 count + the images fills and image masks use, by id: 16-byte id, u8 kind, u32 length + name, u32 length +
+//!   the original file;
+//! - each layer with rasters, by id: u8 1, 16-byte id, u8 count + its images (slot, u8 components, u32 size, 4 × f32
+//!   fill bits), then its allocated tiles in tile order (images in slot order within a tile): u32 tile, u8 image, u32
+//!   length + the deflated f16 texels (low bytes, then high bytes); u32::MAX ends them. u8 0 ends the layers.
+//!
+//! A stroke changes only the bytes of the tiles it touched, a setting only the JSON, a layer move only the JSON: no
+//! count ahead of a layer's tiles, or of the layers, changes with them. Deflating is deterministic for one build
+//! (the format names the build), and a tile holding only its image's fill is left out like an unallocated one.
+
+use std::cell::RefCell;
+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};
+use std::io::{Read as _, Write as _};
+use std::rc::Rc;
+use std::sync::{Arc, Weak};
+
+use serde_json::Value;
+use subcraft_core::{AnchorId, ChannelKind, ChannelValue, EffectId, LayerId, ResourceId, TextureSetId};
+use subcraft_doc::{
+    ChannelBlend, ChannelDef, Document, FillChannel, FillContent, GroupContent, Layer, LayerContent, Mask, MaskEffect,
+    MaskEffectKind, PaintContent, PartMask, PenAnchor, PenPath, RESOLUTIONS, Resource, ResourceKind, ResourceStore,
+    TextureSet,
+};
+use subcraft_image::{TILE_SIZE, TILE_TEXELS, Tile, TiledImage};
+use subcraft_mesh::Mesh;
+use subcraft_project::schema::*;
+use uuid::Uuid;
+
+use super::playground_live::canonical;
+
+/// The shell's document limit.
+pub(crate) const MAX_BYTES: usize = 128 << 20;
+const MAGIC: &[u8; 8] = b"SCLIVE01";
+const END: u32 = u32::MAX;
+const MASK: u8 = 0x40;
+const EFFECT: u8 = 0x80;
+
+type Error = String;
+
+fn invalid(what: impl std::fmt::Display) -> Error {
+    format!("Invalid shared project: {what}")
+}
+
+fn conflict(what: impl std::fmt::Display) -> Error {
+    format!("Conflict: both changed {what}")
+}
+
+fn too_large(bytes: usize) -> Error {
+    format!(
+        "This project is too large to edit live: {} MiB, over the {} MiB limit of a shared document. Lower the texture \
+         resolution or remove painted layers.",
+        bytes.div_ceil(1 << 20),
+        MAX_BYTES >> 20
+    )
+}
+
+/// Bytes borrowed from a checkpoint or shared with the encoder's cache and the resource store.
+#[derive(Clone, Debug)]
+pub(crate) enum Bytes<'a> {
+    Slice(&'a [u8]),
+    Shared(Rc<[u8]>),
+    File(Arc<Vec<u8>>),
+}
+
+impl std::ops::Deref for Bytes<'_> {
+    type Target = [u8];
+    fn deref(&self) -> &[u8] {
+        match self {
+            Bytes::Slice(s) => s,
+            Bytes::Shared(s) => s,
+            Bytes::File(f) => f,
+        }
+    }
+}
+
+impl PartialEq for Bytes<'_> {
+    fn eq(&self, other: &Self) -> bool {
+        **self == **other
+    }
+}
+
+/// Which raster of a layer: a paint channel (its index in [`ChannelKind::ALL`]), the mask base or a mask paint effect.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub(crate) enum Slot {
+    Channel(u8),
+    Mask,
+    Effect(Uuid),
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Image<'a> {
+    comps: u8,
+    size: u32,
+    fill: [u32; 4],
+    tiles: BTreeMap<u32, Bytes<'a>>,
+}
+
+impl Image<'_> {
+    fn layout(&self) -> (u8, u32, [u32; 4]) {
+        (self.comps, self.size, self.fill)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+struct Res<'a> {
+    kind: u8,
+    name: String,
+    bytes: Bytes<'a>,
+}
+
+type Images<'a> = BTreeMap<Slot, Image<'a>>;
+
+/// A parsed checkpoint.
+#[derive(Debug)]
+pub(crate) struct Checkpoint<'a> {
+    json: Value,
+    mesh: Bytes<'a>,
+    resources: BTreeMap<Uuid, Res<'a>>,
+    layers: BTreeMap<Uuid, Images<'a>>,
+}
+
+// ----- bytes ---------------------------------------------------------------------------------------------------------
+
+struct Reader<'a>(&'a [u8]);
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Result<&'a [u8], Error> {
+        if self.0.len() < n {
+            return Err(invalid("truncated"));
+        }
+        let (a, rest) = self.0.split_at(n);
+        self.0 = rest;
+        Ok(a)
+    }
+    fn u8(&mut self) -> Result<u8, Error> {
+        Ok(self.take(1)?[0])
+    }
+    fn u32(&mut self) -> Result<u32, Error> {
+        Ok(u32::from_le_bytes(self.take(4)?.try_into().expect("4 bytes")))
+    }
+    fn uuid(&mut self) -> Result<Uuid, Error> {
+        Ok(Uuid::from_bytes(self.take(16)?.try_into().expect("16 bytes")))
+    }
+    fn blob(&mut self) -> Result<&'a [u8], Error> {
+        let n = self.u32()? as usize;
+        self.take(n)
+    }
+}
+
+fn slot_byte(slot: Slot) -> u8 {
+    match slot {
+        Slot::Channel(i) => i,
+        Slot::Mask => MASK,
+        Slot::Effect(_) => EFFECT,
+    }
+}
+
+fn kind_byte(kind: ResourceKind) -> u8 {
+    match kind {
+        ResourceKind::Texture => 0,
+        ResourceKind::Alpha => 1,
+        ResourceKind::Environment => 2,
+    }
+}
+
+fn tiles_in(size: u32) -> u32 {
+    size.div_ceil(TILE_SIZE).pow(2)
+}
+
+pub(crate) fn parse(bytes: &[u8]) -> Result<Checkpoint<'_>, Error> {
+    if bytes.len() > MAX_BYTES {
+        return Err(too_large(bytes.len()));
+    }
+    let mut r = Reader(bytes);
+    if r.take(MAGIC.len())? != MAGIC {
+        return Err(invalid("not a SubCraft live checkpoint"));
+    }
+    let json: Value = serde_json::from_slice(r.blob()?).map_err(invalid)?;
+    if !json.is_object() {
+        return Err(invalid("no document"));
+    }
+    let mesh = Bytes::Slice(r.blob()?);
+    let mut resources = BTreeMap::new();
+    for _ in 0..r.u32()? {
+        let id = r.uuid()?;
+        let kind = r.u8()?;
+        let name = std::str::from_utf8(r.blob()?).map_err(invalid)?.to_owned();
+        let bytes = Bytes::Slice(r.blob()?);
+        if kind > 2 || resources.last_key_value().is_some_and(|(last, _)| *last >= id) {
+            return Err(invalid("image list"));
+        }
+        resources.insert(id, Res { kind, name, bytes });
+    }
+    let mut layers: BTreeMap<Uuid, Images> = BTreeMap::new();
+    loop {
+        match r.u8()? {
+            0 => break,
+            1 => {}
+            _ => return Err(invalid("layer list")),
+        }
+        let id = r.uuid()?;
+        if layers.last_key_value().is_some_and(|(last, _)| *last >= id) {
+            return Err(invalid("layer order"));
+        }
+        let mut slots = Vec::new();
+        let mut images = BTreeMap::new();
+        for _ in 0..r.u8()? {
+            let slot = match r.u8()? {
+                i if (i as usize) < ChannelKind::ALL.len() => Slot::Channel(i),
+                MASK => Slot::Mask,
+                EFFECT => Slot::Effect(r.uuid()?),
+                _ => return Err(invalid("raster slot")),
+            };
+            let (comps, size) = (r.u8()?, r.u32()?);
+            let fill = [r.u32()?, r.u32()?, r.u32()?, r.u32()?];
+            if !(1..=4).contains(&comps)
+                || !RESOLUTIONS.contains(&size)
+                || fill.iter().any(|f| !f32::from_bits(*f).is_finite())
+                || slots.last().is_some_and(|last| *last >= slot)
+            {
+                return Err(invalid("raster layout"));
+            }
+            slots.push(slot);
+            images.insert(slot, Image { comps, size, fill, tiles: BTreeMap::new() });
+        }
+        if images.is_empty() {
+            return Err(invalid("a layer without rasters"));
+        }
+        let mut last = None;
+        loop {
+            let tile = r.u32()?;
+            if tile == END {
+                break;
+            }
+            let index = r.u8()?;
+            let slot = *slots.get(index as usize).ok_or_else(|| invalid("raster index"))?;
+            let image = images.get_mut(&slot).expect("listed");
+            if last >= Some((tile, index)) || tile >= tiles_in(image.size) {
+                return Err(invalid("tile order"));
+            }
+            last = Some((tile, index));
+            image.tiles.insert(tile, Bytes::Slice(r.blob()?));
+        }
+        layers.insert(id, images);
+    }
+    if !r.0.is_empty() {
+        return Err(invalid("trailing bytes"));
+    }
+    Ok(Checkpoint { json, mesh, resources, layers })
+}
+
+pub(crate) fn write(cp: &Checkpoint) -> Result<Vec<u8>, Error> {
+    let json = canonical(&cp.json);
+    let size = MAGIC.len()
+        + 4
+        + json.len()
+        + 4
+        + cp.mesh.len()
+        + 4
+        + cp.resources.values().map(|r| 16 + 1 + 8 + r.name.len() + r.bytes.len()).sum::<usize>()
+        + cp.layers.values().map(|images| {
+            let image = |(s, i): (&Slot, &Image)| {
+                22 + if matches!(s, Slot::Effect(_)) { 16 } else { 0 } + i.tiles.values().map(|t| 9 + t.len()).sum::<usize>()
+            };
+            22 + images.iter().map(image).sum::<usize>()
+        }).sum::<usize>()
+        + 1;
+    if size > MAX_BYTES {
+        return Err(too_large(size));
+    }
+    let mut out = Vec::with_capacity(size);
+    let u32 = |out: &mut Vec<u8>, v: usize| out.extend_from_slice(&(v as u32).to_le_bytes());
+    let blob = |out: &mut Vec<u8>, b: &[u8]| {
+        u32(out, b.len());
+        out.extend_from_slice(b);
+    };
+    out.extend_from_slice(MAGIC);
+    blob(&mut out, &json);
+    blob(&mut out, &cp.mesh);
+    u32(&mut out, cp.resources.len());
+    for (id, r) in &cp.resources {
+        out.extend_from_slice(id.as_bytes());
+        out.push(r.kind);
+        blob(&mut out, r.name.as_bytes());
+        blob(&mut out, &r.bytes);
+    }
+    for (id, images) in &cp.layers {
+        if images.len() > u8::MAX as usize {
+            return Err("A layer has too many paint effects to edit live".into());
+        }
+        out.push(1);
+        out.extend_from_slice(id.as_bytes());
+        out.push(images.len() as u8);
+        for (slot, image) in images {
+            out.push(slot_byte(*slot));
+            if let Slot::Effect(effect) = slot {
+                out.extend_from_slice(effect.as_bytes());
+            }
+            out.push(image.comps);
+            u32(&mut out, image.size as usize);
+            for f in image.fill {
+                u32(&mut out, f as usize);
+            }
+        }
+        let mut tiles: Vec<(u32, u8, &[u8])> = images
+            .values()
+            .enumerate()
+            .flat_map(|(i, image)| image.tiles.iter().map(move |(&t, b)| (t, i as u8, &b[..])))
+            .collect();
+        tiles.sort_unstable_by_key(|&(t, i, _)| (t, i));
+        for (t, i, b) in tiles {
+            u32(&mut out, t as usize);
+            out.push(i);
+            blob(&mut out, b);
+        }
+        u32(&mut out, END as usize);
+    }
+    out.push(0);
+    debug_assert_eq!(out.len(), size);
+    Ok(out)
+}
+
+// ----- texels --------------------------------------------------------------------------------------------------------
+
+fn deflate(raw: &[u8]) -> Vec<u8> {
+    let mut e = flate2::write::DeflateEncoder::new(Vec::new(), flate2::Compression::default());
+    e.write_all(raw).expect("in memory");
+    e.finish().expect("in memory")
+}
+
+/// At most `limit` bytes; a stream that would give more is invalid.
+fn inflate(blob: &[u8], limit: usize) -> Result<Vec<u8>, Error> {
+    let mut out = Vec::new();
+    flate2::read::DeflateDecoder::new(blob)
+        .take(limit as u64 + 1)
+        .read_to_end(&mut out)
+        .map_err(invalid)?;
+    if out.len() > limit {
+        return Err(invalid("oversized data"));
+    }
+    Ok(out)
+}
+
+fn tile_blob(tile: &Tile) -> Vec<u8> {
+    let bits = tile.data.iter().map(|v| v.to_bits());
+    let raw: Vec<u8> = bits.clone().map(|b| b as u8).chain(bits.map(|b| (b >> 8) as u8)).collect();
+    deflate(&raw)
+}
+
+fn tile_from(blob: &[u8], comps: u8) -> Result<Tile, Error> {
+    let n = TILE_TEXELS * comps as usize;
+    let raw = inflate(blob, n * 2)?;
+    if raw.len() != n * 2 {
+        return Err(invalid("tile size"));
+    }
+    let (low, high) = raw.split_at(n);
+    let data = low.iter().zip(high).map(|(&l, &h)| subcraft_core::f16::from_bits(l as u16 | (h as u16) << 8)).collect();
+    Ok(Tile { data })
+}
+
+fn mesh_from(blob: &[u8]) -> Result<Mesh, Error> {
+    subcraft_mesh::serialize::decode(&inflate(blob, 2 * MAX_BYTES)?).map_err(invalid)
+}
+
+/// Deflated tiles and mesh by allocation, so a checkpoint compresses only what changed since the last one. A weak
+/// reference keeps each address from being reused while its entry lives.
+#[derive(Default)]
+struct Cache {
+    tiles: HashMap<usize, (Weak<Tile>, Option<Rc<[u8]>>)>,
+    mesh: Option<(Weak<Mesh>, Rc<[u8]>)>,
+}
+
+thread_local! {
+    static CACHE: RefCell<Cache> = RefCell::default();
+}
+
+impl Cache {
+    /// None: the tile holds only the image's fill.
+    fn tile(&mut self, tile: &Arc<Tile>, comps: usize, fill: [f32; 4]) -> Option<Rc<[u8]>> {
+        let key = Arc::as_ptr(tile) as usize;
+        if let Some((weak, blob)) = self.tiles.get(&key)
+            && weak.strong_count() > 0
+        {
+            return blob.clone();
+        }
+        let fill: Vec<u16> = fill[..comps].iter().map(|&f| subcraft_core::f16::from_f32(f).to_bits()).collect();
+        let filled = tile.data.chunks_exact(comps).all(|px| px.iter().zip(&fill).all(|(v, f)| v.to_bits() == *f));
+        let blob: Option<Rc<[u8]>> = (!filled).then(|| tile_blob(tile).into());
+        self.tiles.insert(key, (Arc::downgrade(tile), blob.clone()));
+        blob
+    }
+
+    fn mesh(&mut self, mesh: &Arc<Mesh>) -> Rc<[u8]> {
+        match &self.mesh {
+            Some((weak, blob)) if weak.as_ptr() == Arc::as_ptr(mesh) && weak.strong_count() > 0 => blob.clone(),
+            _ => {
+                let blob: Rc<[u8]> = deflate(&subcraft_mesh::serialize::encode(mesh)).into();
+                self.mesh = Some((Arc::downgrade(mesh), blob.clone()));
+                blob
+            }
+        }
+    }
+}
+
+// ----- the shared projection -----------------------------------------------------------------------------------------
+
+fn channel_index(kind: ChannelKind) -> u8 {
+    ChannelKind::ALL.iter().position(|&k| k == kind).expect("every channel is listed") as u8
+}
+
+/// A layer's rasters by slot.
+fn rasters(l: &Layer) -> Vec<(Slot, &TiledImage)> {
+    let mut out = Vec::new();
+    if let LayerContent::Paint(p) = &l.content {
+        out.extend(p.channels.iter().map(|(&k, image)| (Slot::Channel(channel_index(k)), image)));
+    }
+    if let Some(m) = &l.mask {
+        out.push((Slot::Mask, &m.base));
+        for e in &m.effects {
+            if let MaskEffectKind::Paint { image } = &e.kind {
+                out.push((Slot::Effect(e.id.0), image));
+            }
+        }
+    }
+    out
+}
+
+pub(super) fn layer_json(l: &Layer) -> LayerV1 {
+    let blend = l.blend.iter().map(|(&channel, b)| BlendV1 { channel, mode: b.mode, opacity: b.opacity }).collect();
+    let mask = l.mask.as_ref().map(|m| MaskV1 {
+        enabled: m.enabled,
+        base: String::new(),
+        effects: m
+            .effects
+            .iter()
+            .map(|e| MaskEffectV1 {
+                id: e.id.0,
+                name: e.name.clone(),
+                visible: e.visible,
+                blend: e.blend,
+                opacity: e.opacity,
+                kind: match &e.kind {
+                    MaskEffectKind::Paint { .. } => MaskEffectKindV1::Paint { raster: String::new() },
+                    MaskEffectKind::Fill { value, procedural, projection } => {
+                        MaskEffectKindV1::Fill { value: *value, procedural: *procedural, projection: *projection }
+                    }
+                    MaskEffectKind::Generator(g) => MaskEffectKindV1::Generator { generator: *g },
+                    MaskEffectKind::Levels(l) => MaskEffectKindV1::Levels { levels: *l },
+                    MaskEffectKind::Invert => MaskEffectKindV1::Invert,
+                    MaskEffectKind::Image { resource, projection, invert } => {
+                        MaskEffectKindV1::Image { resource: resource.0, projection: *projection, invert: *invert }
+                    }
+                },
+            })
+            .collect(),
+    });
+    let content = match &l.content {
+        LayerContent::Paint(p) => ContentV1::Paint {
+            channels: Vec::new(),
+            path: p.path.as_ref().map(|path| PenPathV4 {
+                anchors: path
+                    .anchors
+                    .iter()
+                    .map(|a| PenAnchorV4 {
+                        id: a.id.0,
+                        position: a.position.to_array(),
+                        incoming: a.incoming.to_array(),
+                        outgoing: a.outgoing.to_array(),
+                    })
+                    .collect(),
+                closed: path.closed,
+                radius: path.radius,
+                hardness: path.hardness,
+                opacity: path.opacity,
+                values: path.values.iter().map(|(&channel, value)| PenChannelV4 { channel, value: value.0 }).collect(),
+            }),
+        },
+        LayerContent::Fill(f) => ContentV1::Fill {
+            projection: f.projection,
+            channels: f
+                .channels
+                .iter()
+                .map(|(&channel, c)| FillChannelV1 { channel, enabled: c.enabled, source: c.source.clone(), strength: c.strength })
+                .collect(),
+        },
+        // Open or closed is each person's own view.
+        LayerContent::Group(g) => ContentV1::Folder { expanded: true, children: g.children.iter().map(|c| layer_json(c)).collect() },
+    };
+    let parts = l.parts.as_ref().map(|p| PartsV1 { enabled: p.enabled, kind: p.kind, parts: p.parts.iter().copied().collect() });
+    LayerV1 { id: l.id.0, name: l.name.clone(), visible: l.visible, blend, mask, parts, content }
+}
+
+fn json(doc: &Document) -> Value {
+    let texture_sets = doc
+        .texture_sets
+        .iter()
+        .map(|ts| TextureSetV1 {
+            id: ts.id.0,
+            name: ts.name.clone(),
+            material_slot: ts.material_slot,
+            resolution: ts.resolution,
+            channels: ts.channels.iter().map(|c| ChannelDefV1 { kind: c.kind, format: c.format }).collect(),
+            layers: ts.layers.iter().map(|l| layer_json(l)).collect(),
+            mesh_maps: Vec::new(),
+        })
+        .collect();
+    serde_json::to_value(DocumentV1 { texture_sets, resources: Vec::new() }).expect("schema types serialize")
+}
+
+/// The canonical checkpoint of a project: its document (the committed one, no stroke under way), the images it uses
+/// and its mesh. Baked mesh maps stay local.
+pub(crate) fn encode(doc: &Document, store: &ResourceStore, mesh: &Arc<Mesh>) -> Result<Vec<u8>, Error> {
+    CACHE.with_borrow_mut(|cache| {
+        cache.tiles.retain(|_, (weak, _)| weak.strong_count() > 0);
+        let mut layers = BTreeMap::new();
+        let mut used = Vec::new();
+        for ts in &doc.texture_sets {
+            ts.walk(|l, _| {
+                l.collect_resources(&mut used);
+                let images: Images = rasters(l)
+                    .into_iter()
+                    .map(|(slot, image)| {
+                        let (comps, fill) = (image.comps(), image.fill());
+                        let tiles = (0..image.tile_count())
+                            .filter_map(|i| Some((i as u32, Bytes::Shared(cache.tile(image.tile(i)?, comps, fill)?))))
+                            .collect();
+                        (slot, Image { comps: comps as u8, size: image.width(), fill: fill.map(f32::to_bits), tiles })
+                    })
+                    .collect();
+                if !images.is_empty() {
+                    layers.insert(l.id.0, images);
+                }
+            });
+        }
+        let resources = used
+            .into_iter()
+            .filter_map(|id| {
+                let r = store.get(id)?;
+                let bytes = Bytes::File(r.encoded.clone()?);
+                Some((id.0, Res { kind: kind_byte(r.kind), name: r.name.clone(), bytes }))
+            })
+            .collect();
+        write(&Checkpoint { json: json(doc), mesh: Bytes::Shared(cache.mesh(mesh)), resources, layers })
+    })
+}
+
+// ----- back to a document --------------------------------------------------------------------------------------------
+
+struct Builder<'c, 'a, 'f> {
+    cp: &'c Checkpoint<'a>,
+    left: BTreeSet<(Uuid, Slot)>,
+    ids: HashSet<Uuid>,
+    expanded: &'f dyn Fn(LayerId) -> bool,
+    image: &'f mut dyn FnMut(Uuid, Slot, &Image) -> Result<TiledImage, Error>,
+}
+
+impl Builder<'_, '_, '_> {
+    fn unique(&mut self, id: Uuid) -> Result<(), Error> {
+        if self.ids.insert(id) { Ok(()) } else { Err(invalid(format!("{id} appears twice"))) }
+    }
+
+    fn take(&mut self, layer: Uuid, slot: Slot, resolution: u32, comps: Option<usize>) -> Result<Option<TiledImage>, Error> {
+        let Some(image) = self.cp.layers.get(&layer).and_then(|images| images.get(&slot)) else { return Ok(None) };
+        if image.size != resolution || comps.is_some_and(|c| c != image.comps as usize) {
+            return Err(invalid(format!("raster layout of layer {layer}")));
+        }
+        self.left.remove(&(layer, slot));
+        (self.image)(layer, slot, image).map(Some)
+    }
+
+    fn layer(&mut self, l: &LayerV1, resolution: u32) -> Result<Layer, Error> {
+        self.unique(l.id)?;
+        let mask = match &l.mask {
+            None => None,
+            Some(m) => {
+                let base = self.take(l.id, Slot::Mask, resolution, Some(1))?.ok_or_else(|| invalid("a mask without its base"))?;
+                let mut effects = Vec::new();
+                for e in &m.effects {
+                    self.unique(e.id)?;
+                    let kind = match &e.kind {
+                        MaskEffectKindV1::Paint { .. } => MaskEffectKind::Paint {
+                            image: self.take(l.id, Slot::Effect(e.id), resolution, None)?.ok_or_else(|| invalid("a paint effect without its raster"))?,
+                        },
+                        MaskEffectKindV1::Fill { value, procedural, projection } => {
+                            MaskEffectKind::Fill { value: *value, procedural: *procedural, projection: *projection }
+                        }
+                        MaskEffectKindV1::Generator { generator } => MaskEffectKind::Generator(*generator),
+                        MaskEffectKindV1::Levels { levels } => MaskEffectKind::Levels(*levels),
+                        MaskEffectKindV1::Invert => MaskEffectKind::Invert,
+                        MaskEffectKindV1::Image { resource, projection, invert } => {
+                            MaskEffectKind::Image { resource: ResourceId(*resource), projection: *projection, invert: *invert }
+                        }
+                    };
+                    effects.push(Arc::new(MaskEffect { id: EffectId(e.id), name: e.name.clone(), visible: e.visible, blend: e.blend, opacity: e.opacity, kind }));
+                }
+                Some(Mask { enabled: m.enabled, base, effects })
+            }
+        };
+        let content = match &l.content {
+            ContentV1::Paint { channels, path } => {
+                if !channels.is_empty() {
+                    return Err(invalid("paint channels outside the rasters"));
+                }
+                let mut p = PaintContent::default();
+                if let Some(path) = path {
+                    let source = PenPath {
+                        anchors: path
+                            .anchors
+                            .iter()
+                            .map(|a| PenAnchor { id: AnchorId(a.id), position: a.position.into(), incoming: a.incoming.into(), outgoing: a.outgoing.into() })
+                            .collect(),
+                        closed: path.closed,
+                        radius: path.radius,
+                        hardness: path.hardness,
+                        opacity: path.opacity,
+                        values: path.values.iter().map(|v| (v.channel, ChannelValue(v.value))).collect(),
+                    };
+                    source.validate().map_err(invalid)?;
+                    p.path = Some(source);
+                }
+                for kind in ChannelKind::ALL {
+                    if let Some(image) = self.take(l.id, Slot::Channel(channel_index(kind)), resolution, Some(kind.components() + 1))? {
+                        p.channels.insert(kind, image);
+                    }
+                }
+                LayerContent::Paint(p)
+            }
+            ContentV1::Fill { projection, channels } => LayerContent::Fill(FillContent {
+                projection: *projection,
+                channels: channels.iter().map(|c| (c.channel, FillChannel { enabled: c.enabled, source: c.source.clone(), strength: c.strength })).collect(),
+            }),
+            ContentV1::Folder { children, .. } => LayerContent::Group(GroupContent {
+                expanded: (self.expanded)(LayerId(l.id)),
+                children: children.iter().map(|c| self.layer(c, resolution).map(Arc::new)).collect::<Result<_, _>>()?,
+            }),
+        };
+        Ok(Layer {
+            id: LayerId(l.id),
+            name: l.name.clone(),
+            visible: l.visible,
+            blend: l.blend.iter().map(|b| (b.channel, ChannelBlend { mode: b.mode, opacity: b.opacity })).collect(),
+            mask,
+            parts: l.parts.as_ref().map(|p| PartMask { enabled: p.enabled, kind: p.kind, parts: p.parts.iter().copied().collect() }),
+            content,
+        })
+    }
+}
+
+/// The document a checkpoint describes, `image` making each raster. Fails unless this build would write exactly this
+/// checkpoint for it (every raster belongs to its layer, nothing repeats, lists are in the model's order).
+fn build(
+    cp: &Checkpoint,
+    expanded: &dyn Fn(LayerId) -> bool,
+    image: &mut dyn FnMut(Uuid, Slot, &Image) -> Result<TiledImage, Error>,
+) -> Result<Document, Error> {
+    let file: DocumentV1 = serde_json::from_value(cp.json.clone()).map_err(invalid)?;
+    if file.texture_sets.is_empty() || !file.resources.is_empty() {
+        return Err(invalid("texture sets"));
+    }
+    let left = cp.layers.iter().flat_map(|(&l, images)| images.keys().map(move |&s| (l, s))).collect();
+    let mut b = Builder { cp, left, ids: HashSet::new(), expanded, image };
+    let mut texture_sets = Vec::new();
+    for t in &file.texture_sets {
+        b.unique(t.id)?;
+        if !RESOLUTIONS.contains(&t.resolution) || !t.mesh_maps.is_empty() {
+            return Err(invalid(format!("texture set {}", t.name)));
+        }
+        texture_sets.push(TextureSet {
+            id: TextureSetId(t.id),
+            name: t.name.clone(),
+            material_slot: t.material_slot,
+            resolution: t.resolution,
+            channels: t.channels.iter().map(|c| ChannelDef { kind: c.kind, format: c.format }).collect(),
+            layers: t.layers.iter().map(|l| b.layer(l, t.resolution).map(Arc::new)).collect::<Result<_, _>>()?,
+        });
+    }
+    if !b.left.is_empty() {
+        return Err(invalid("a raster without its layer"));
+    }
+    let doc = Document { texture_sets };
+    if canonical(&json(&doc)) != canonical(&cp.json) {
+        return Err(invalid("not in this build's form"));
+    }
+    Ok(doc)
+}
+
+/// The document's structure, with empty rasters.
+fn skeleton(cp: &Checkpoint) -> Result<Document, Error> {
+    build(cp, &|_| true, &mut |_, _, i| Ok(TiledImage::new(i.size, i.size, i.comps as usize, i.fill.map(f32::from_bits))))
+}
+
+/// Whether every peer can install `cp`: its structure, and whatever differs from `current` (already installed; none:
+/// everything) decodes. Gives the images the document uses.
+fn check(cp: &Checkpoint, current: Option<&Checkpoint>) -> Result<HashSet<Uuid>, Error> {
+    let doc = skeleton(cp)?;
+    if current.is_none_or(|c| cp.mesh != c.mesh) {
+        mesh_from(&cp.mesh)?;
+    }
+    for (id, r) in &cp.resources {
+        if current.and_then(|c| c.resources.get(id)) != Some(r) {
+            subcraft_image::io::decode_bitmap(&r.bytes, Some(&r.name)).map_err(invalid)?;
+        }
+    }
+    for (layer, images) in &cp.layers {
+        for (slot, image) in images {
+            let known = current.and_then(|c| c.layers.get(layer)?.get(slot)).filter(|k| k.comps == image.comps);
+            for (t, blob) in &image.tiles {
+                if known.and_then(|k| k.tiles.get(t)) != Some(blob) {
+                    tile_from(blob, image.comps)?;
+                }
+            }
+        }
+    }
+    let mut used = Vec::new();
+    for ts in &doc.texture_sets {
+        for l in &ts.layers {
+            l.collect_resources(&mut used);
+        }
+    }
+    Ok(used.into_iter().map(|r| r.0).collect())
+}
+
+/// A whole checkpoint `edited` replacing `current`: checked like a merge's result.
+pub(crate) fn check_whole(edited: &Checkpoint, current: Option<&Checkpoint>) -> Result<(), Error> {
+    let used = check(edited, current)?;
+    if edited.resources.keys().any(|id| !used.contains(id)) {
+        return Err(invalid("an unused image"));
+    }
+    Ok(())
+}
+
+// ----- merge ---------------------------------------------------------------------------------------------------------
+
+/// Keyed values, three ways: each key takes the side that changed it (strictly: both changing it is a conflict even to
+/// equal values), and `both` merges a key both sides changed and kept.
+fn merge_map<K: Ord + Copy + std::fmt::Debug, V: PartialEq + Clone>(
+    b: &BTreeMap<K, V>,
+    c: &BTreeMap<K, V>,
+    e: &BTreeMap<K, V>,
+    mut both: impl FnMut(K, Option<&V>, &V, &V) -> Result<V, Error>,
+) -> Result<BTreeMap<K, V>, Error> {
+    let keys: BTreeSet<K> = b.keys().chain(c.keys()).chain(e.keys()).copied().collect();
+    let mut out = BTreeMap::new();
+    for k in keys {
+        let (bv, cv, ev) = (b.get(&k), c.get(&k), e.get(&k));
+        let v = if ev == bv {
+            cv.cloned()
+        } else if cv == bv {
+            ev.cloned()
+        } else {
+            match (cv, ev) {
+                (Some(cv), Some(ev)) => Some(both(k, bv, cv, ev)?),
+                _ => return Err(conflict(format!("{k:?}"))),
+            }
+        };
+        if let Some(v) = v {
+            out.insert(k, v);
+        }
+    }
+    Ok(out)
+}
+
+/// Lists of per-channel settings (a layer's blends, a fill's channels, a pen's values) keyed by their channel, so
+/// the JSON merge takes each channel from whoever changed it.
+fn by_channel(mut json: Value) -> Value {
+    fn walk(v: &mut Value) {
+        match v {
+            Value::Array(items) => {
+                if !items.is_empty() && items.iter().all(|i| i.get("channel").is_some_and(Value::is_string) && i.get("id").is_none()) {
+                    for i in items.iter_mut() {
+                        let channel = i["channel"].clone();
+                        i["id"] = channel;
+                    }
+                }
+                items.iter_mut().for_each(walk);
+            }
+            Value::Object(fields) => fields.values_mut().for_each(walk),
+            _ => {}
+        }
+    }
+    walk(&mut json);
+    json
+}
+
+/// Undoes [`by_channel`], each list in the model's channel order.
+fn in_channel_order(mut json: Value) -> Value {
+    fn walk(v: &mut Value) {
+        match v {
+            Value::Array(items) => {
+                if !items.is_empty() && items.iter().all(|i| i.get("channel").is_some_and(|c| Some(c) == i.get("id"))) {
+                    for i in items.iter_mut() {
+                        i.as_object_mut().expect("has fields").remove("id");
+                    }
+                    let order = |i: &Value| serde_json::from_value::<ChannelKind>(i["channel"].clone()).map_or(u8::MAX, channel_index);
+                    items.sort_by_key(order);
+                }
+                items.iter_mut().for_each(walk);
+            }
+            Value::Object(fields) => fields.values_mut().for_each(walk),
+            _ => {}
+        }
+    }
+    walk(&mut json);
+    json
+}
+
+/// Strict three-way merge, then [`check`]: the layer trees and settings per field (layers, effects and anchors by
+/// id), rasters tile by tile, the mesh as one value and the images as a union.
+pub(crate) fn merge<'a>(b: &Checkpoint<'a>, c: &Checkpoint<'a>, e: &Checkpoint<'a>) -> Result<Checkpoint<'a>, Error> {
+    let [b_json, c_json, e_json] = [&b.json, &c.json, &e.json].map(|j| by_channel(j.clone()));
+    let json = in_channel_order(super::playground_live::merge(&b_json, &c_json, &e_json, &[])?);
+    let mesh = if e.mesh == b.mesh {
+        c.mesh.clone()
+    } else if c.mesh == b.mesh {
+        e.mesh.clone()
+    } else {
+        return Err(conflict("the model"));
+    };
+    let mut resources = BTreeMap::new();
+    for (id, r) in [b, c, e].into_iter().flat_map(|side| &side.resources) {
+        if *resources.entry(*id).or_insert_with(|| r.clone()) != *r {
+            return Err(invalid(format!("two images {id}")));
+        }
+    }
+    let empty = BTreeMap::new();
+    let layers = merge_map(&b.layers, &c.layers, &e.layers, |layer, bl, cl, el| {
+        merge_map(bl.unwrap_or(&empty), cl, el, |slot, bi, ci, ei| {
+            if ci.layout() != ei.layout() || bi.is_some_and(|bi| bi.layout() != ci.layout()) {
+                return Err(conflict(format!("raster {slot:?} of layer {layer}")));
+            }
+            let tiles = merge_map(bi.map_or(&BTreeMap::new(), |bi| &bi.tiles), &ci.tiles, &ei.tiles, |t, _, _, _| {
+                Err(conflict(format!("tile {t} of raster {slot:?} of layer {layer}")))
+            })?;
+            Ok(Image { tiles, ..ci.clone() })
+        })
+    })?;
+    let mut merged = Checkpoint { json, mesh, resources, layers };
+    let used = check(&merged, Some(c))?;
+    merged.resources.retain(|id, _| used.contains(id));
+    Ok(merged)
+}
+
+/// [`merge`] on bytes, for the session's coordinator.
+pub(crate) fn merge_bytes(base: &[u8], current: &[u8], edited: &[u8]) -> Result<Vec<u8>, Error> {
+    write(&merge(&parse(base)?, &parse(current)?, &parse(edited)?)?)
+}
+
+// ----- install -------------------------------------------------------------------------------------------------------
+
+/// What installing a checkpoint takes: the document (local tiles kept where unchanged, folders open as they were),
+/// images new to this store (all of them with a new mesh), and the mesh when it is another one (with its bytes, for
+/// [`known_mesh`]).
+pub(crate) struct Install<'a> {
+    pub doc: Document,
+    pub resources: Vec<Arc<Resource>>,
+    pub mesh: Option<(Mesh, Bytes<'a>)>,
+}
+
+/// `mesh` was installed from `bytes`: its checkpoints reuse them.
+pub(crate) fn known_mesh(mesh: &Arc<Mesh>, bytes: &[u8]) {
+    CACHE.with_borrow_mut(|cache| cache.mesh = Some((Arc::downgrade(mesh), bytes.into())));
+}
+
+pub(crate) fn install<'a>(cp: &Checkpoint<'a>, local: &Document, store: &ResourceStore, mesh: &Arc<Mesh>) -> Result<Install<'a>, Error> {
+    let mut mine: HashMap<(Uuid, Slot), TiledImage> = HashMap::new();
+    let mut folders = HashMap::new();
+    for ts in &local.texture_sets {
+        ts.walk(|l, _| {
+            mine.extend(rasters(l).into_iter().map(|(slot, image)| ((l.id.0, slot), image.clone())));
+            if let LayerContent::Group(g) = &l.content {
+                folders.insert(l.id, g.expanded);
+            }
+        });
+    }
+    CACHE.with_borrow_mut(|cache| {
+        let new_mesh = if cache.mesh(mesh)[..] == cp.mesh[..] { None } else { Some((mesh_from(&cp.mesh)?, cp.mesh.clone())) };
+        let doc = build(cp, &|id| folders.get(&id).copied().unwrap_or(true), &mut |layer, slot, image| {
+            let (comps, fill) = (image.comps as usize, image.fill.map(f32::from_bits));
+            let known = mine.get(&(layer, slot)).filter(|m| m.comps() == comps && m.width() == image.size);
+            let mut out = TiledImage::new(image.size, image.size, comps, fill);
+            for (&t, blob) in &image.tiles {
+                let kept = known
+                    .and_then(|k| k.tile(t as usize))
+                    .filter(|tile| cache.tile(tile, comps, fill).as_deref() == Some(&blob[..]))
+                    .cloned();
+                let tile = match kept {
+                    Some(tile) => tile,
+                    None => {
+                        let tile = Arc::new(tile_from(blob, image.comps)?);
+                        cache.tiles.insert(Arc::as_ptr(&tile) as usize, (Arc::downgrade(&tile), Some(blob.to_vec().into())));
+                        tile
+                    }
+                };
+                out.set_slot(t as usize, Some(tile));
+            }
+            // Unchanged: the very same image, so nothing downstream sees a change.
+            Ok(match known {
+                Some(k) if *k == out => k.clone(),
+                _ => out,
+            })
+        })?;
+        let mut resources = Vec::new();
+        for (&id, r) in &cp.resources {
+            match store.get(ResourceId(id)) {
+                Some(have) if new_mesh.is_some() => resources.push(have.clone()),
+                Some(_) => {}
+                None => {
+                    let bitmap = subcraft_image::io::decode_bitmap(&r.bytes, Some(&r.name)).map_err(invalid)?;
+                    let kind = [ResourceKind::Texture, ResourceKind::Alpha, ResourceKind::Environment][r.kind as usize];
+                    resources.push(Arc::new(Resource {
+                        id: ResourceId(id),
+                        name: r.name.clone(),
+                        kind,
+                        bitmap: Arc::new(bitmap),
+                        source_path: None,
+                        encoded: Some(Arc::new(r.bytes.to_vec())),
+                    }));
+                }
+            }
+        }
+        Ok(Install { doc, resources, mesh: new_mesh })
+    })
+}
