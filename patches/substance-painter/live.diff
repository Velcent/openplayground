+#[test]
+fn presence_shares_the_point_under_the_pointer_and_the_stroke_so_far_which_another_camera_places_on_the_model() {
+    use super::peers::{label, on_screen, path, point};
+    let mut a = app(Session::sample());
+    let (rect, ppp) = (egui::Rect::from_min_size(egui::pos2(40.0, 30.0), egui::vec2(400.0, 300.0)), 2.0);
+    let camera = a.state.camera.paint_camera([800, 600]);
+    // Painting: a stroke under way to the center.
+    a.state.session.begin_stroke().unwrap();
+    a.state.painting = true;
+    for at in [rect.center() - egui::vec2(30.0, 0.0), rect.center() - egui::vec2(0.2, 0.0), rect.center()] {
+        note(&a.state, &camera, rect, ppp, Some(at));
+    }
+    a.live_frame(&egui::Context::default());
+    let state = a.live_presence();
+    let s = a.state.session.selection();
+    assert_eq!((&state["page"], &state["selection"]), (&serde_json::json!(s.texture_set), &serde_json::json!([s.layer.unwrap()])));
+
+    // As someone else's: their pointer and the stroke's newest point where they are under the same camera, unhidden
+    // (a point under a pixel from the last is left out); tagged with their layer.
+    let ann = Presence { id: "a".into(), name: "Ann".into(), color: [1, 2, 3], state: state.clone() };
+    let stroke = path::<3>(&state["stroke"]["points"]).unwrap();
+    assert_eq!(stroke.len(), 2, "{stroke:?}");
+    for p in [point(&state["pointer"]).unwrap(), glam::Vec3::from_array(stroke[1])] {
+        let (at, hidden) = on_screen(&a.state, &camera, rect, ppp, p).unwrap();
+        assert!(at.distance(rect.center()) < 1.0 && !hidden, "{at:?} {hidden}");
+    }
+    assert_eq!(label(&a.state, &ann), format!("Ann · {}", a.state.session.selected_layer().unwrap().name));
+
+    // A slider drag under way (its history entry still coalescing): the layer and the setting's value so far.
+    a.state.session.end_stroke();
+    let layer = a.state.session.selection().layer.unwrap();
+    a.state.session.execute(Command::SetBlendOpacity { layer, channel: ChannelKind::BaseColor, opacity: 0.63 }).unwrap();
+    LIVE.with_borrow_mut(|live| live.down = true);
+    assert_eq!(a.live_presence()["adjust"], serde_json::json!({ "layer": layer, "text": "Base Color · Opacity 63%" }));
+    // Remote junk draws nothing.
+    for junk in [serde_json::json!([1.0, 2.0]), serde_json::json!([1e300, 0, 0]), serde_json::json!(["x", 0, 0])] {
+        assert_eq!(point(&junk), None);
+    }
+    assert_eq!(on_screen(&a.state, &camera, rect, ppp, glam::Vec3::splat(1e6)).filter(|(at, _)| rect.contains(*at)), None);
+}
