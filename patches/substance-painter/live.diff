+//! Live editing in a Playground session (`shell/live.js` drives it through [`web`]); nothing here runs until the shell
+//! connects. The shared project is [`checkpoint`]'s canonical binary checkpoint: the layer trees and settings, the
+//! painted tiles, the images they use and the mesh, without anyone's views (camera, selection, tool, brush, open
+//! folders, panels). A remote change merges into the project at the end of a quiet frame, keeping this person's views
+//! and unsent work, and is no step of the native undo history. While connected, Undo and Redo go to the session,
+//! which reverts only this person's operations, History jumps are off, and New and Open wait for the session's end.
+//! Presence: each person shares the surface point under their pointer on the model and their texture set and layer, and
+//! what they have under way: the stroke they paint (its surface points so far), the pen path they edit (in UV), the
+//! layer setting they drag (its value) and where a layer they drag would drop. [`peers`] draws the others.
+
+pub(crate) mod checkpoint;
+mod peers;
+// The template (patches/live/playground_live.rs, copied next to lib.rs): its JSON merge, canonical form and presence.
+#[path = "../playground_live.rs"]
+#[allow(dead_code)]
+mod playground_live;
+
+use std::collections::VecDeque;
+
+use egui::{Pos2, Rect};
+use glam::{Vec2, Vec3};
+use serde_json::{Value, json};
+use subcraft_app::{Action, Camera, Command};
+
+use super::SubcraftApp;
+use subcraft_app::layer_tree::DropTarget;
+use subcraft_core::LayerId;
+use crate::dialogs::Pending;
+use crate::state::UiState;
+use playground_live::Presence;
+
+/// A remote change waiting for a quiet frame: `edited` relative to `base`, or with no base the whole shared project.
+struct Remote {
+    base: Option<Vec<u8>>,
+    edited: Vec<u8>,
+    done: Done,
+}
+
+/// Settles a remote change: a whole adopted project gives back the checkpoint it replaced, for the shell's draft.
+pub(crate) type Done = Box<dyn FnOnce(Result<Option<Vec<u8>>, String>)>;
+
+#[derive(Default)]
+struct Live {
+    connected: bool,
+    /// The last frame was not quiet: a checkpoint now would catch a gesture half done.
+    busy: bool,
+    /// The committed document as last reported.
+    seen: Option<subcraft_doc::Document>,
+    remote: VecDeque<Remote>,
+    /// Shared changes reported so far.
+    changes: u64,
+    /// This person's pointer on the model: as the 3D view drew it this frame, and as of the last frame (shared).
+    drawn: Option<[f32; 3]>,
+    pointer: Option<[f32; 3]>,
+    /// The stroke this person paints: its surface points so far, and where the newest was on screen.
+    stroke: Vec<[f32; 3]>,
+    stroke_at: Option<Pos2>,
+    /// A pointer is down; the newest history entry (index, time) as of the last frame none was: a slider drag that
+    /// coalesces into one entry changes it.
+    down: bool,
+    rest: Option<(usize, web_time::Instant)>,
+    /// Where a layer this person drags would drop: as the Layers panel marked it this frame, and as of the last frame.
+    marker: Option<DropTarget>,
+    reorder: Option<DropTarget>,
+    /// The others, as the shell gave them.
+    others: Vec<Presence>,
+    #[cfg(test)]
+    undos: Vec<bool>,
+    #[cfg(target_arch = "wasm32")]
+    hooks: Option<web::Hooks>,
+    /// For a repaint when the shell queues a change between frames.
+    #[cfg(target_arch = "wasm32")]
+    ctx: Option<egui::Context>,
+}
+
+thread_local! {
+    static LIVE: std::cell::RefCell<Live> = std::cell::RefCell::default();
+}
+
+pub(crate) fn connect() {
+    LIVE.with_borrow_mut(|live| (live.connected, live.seen) = (true, None));
+}
+
+/// Ends the session's hold on Undo; changes still waiting fail.
+pub(crate) fn disconnect() {
+    let waiting = LIVE.with_borrow_mut(|live| {
+        live.connected = false;
+        live.others.clear();
+        #[cfg(target_arch = "wasm32")]
+        {
+            live.hooks = None;
+        }
+        std::mem::take(&mut live.remote)
+    });
+    for remote in waiting {
+        (remote.done)(Err("Live editing disconnected".into()));
+    }
+}
+
+pub(crate) fn queue(base: Option<Vec<u8>>, edited: Vec<u8>, done: Done) {
+    let refused = LIVE.with_borrow_mut(|live| {
+        if !live.connected {
+            return Some(done);
+        }
+        live.remote.push_back(Remote { base, edited, done });
+        #[cfg(target_arch = "wasm32")]
+        if let Some(ctx) = &live.ctx {
+            ctx.request_repaint();
+        }
+        None
+    });
+    if let Some(done) = refused {
+        done(Err("Live editing is not connected".into()));
+    }
+}
+
+pub(crate) fn connected() -> bool {
+    LIVE.with_borrow(|live| live.connected)
+}
+
+/// Passes Undo or Redo to the session while connected: whether it did.
+pub(crate) fn undo(redo: bool) -> bool {
+    let connected = LIVE.with_borrow_mut(|live| {
+        #[cfg(test)]
+        if live.connected {
+            live.undos.push(redo);
+        }
+        live.connected
+    });
+    #[cfg(target_arch = "wasm32")]
+    if connected {
+        web::call(|hooks| &hooks.undo, &redo.into());
+    }
+    connected
+}
+
+/// SubcraftApp::perform's first step: Undo and Redo go to the session while connected (a pending pen point or image
+/// still undoes first). Whether it took `action`.
+pub(super) fn perform(app: &mut SubcraftApp, action: Action) -> bool {
+    let s = &app.state;
+    match action {
+        Action::Undo => !(s.pen.is_editing() || s.pen.is_pending() || s.asset_preview.is_applying()) && undo(false),
+        Action::Redo => undo(true),
+        _ => false,
+    }
+}
+
+/// SubcraftApp::request's first step: New and Open wait for the session's end. Whether it refused `action`.
+pub(super) fn request(app: &mut SubcraftApp, action: Pending, now: f64) -> bool {
+    let refused = action != Pending::Close && connected();
+    if refused {
+        app.state.set_status("Leave the live session to open or start another project", now);
+    }
+    refused
+}
+
+/// The panels' commands, without History jumps while connected (they would take back the others' changes).
+pub(crate) fn commands(mut cmds: Vec<Command>) -> Vec<Command> {
+    if connected() {
+        cmds.retain(|c| !matches!(c, Command::JumpToHistory(_)));
+    }
+    cmds
+}
+
+/// The model's surface point under `at` (in points) in the 3D view at `rect`.
+fn surface_point(state: &UiState, camera: &Camera, rect: Rect, ppp: f32, at: Pos2) -> Option<Vec3> {
+    state.session.pick(camera, Vec2::new(at.x - rect.min.x, at.y - rect.min.y) * ppp).map(|hit| hit.position)
+}
+
+/// The most points of a stroke or path this person shares (the newest).
+const MAX_POINTS: usize = 200;
+
+/// Notes this person's pointer `at` over the 3D view at `rect`: the surface point under it and, while they paint, the
+/// stroke's points (each at least a pixel on from the last).
+fn note(state: &UiState, camera: &Camera, rect: Rect, ppp: f32, at: Option<Pos2>) {
+    let mine = at.and_then(|at| Some((at, surface_point(state, camera, rect, ppp, at)?)));
+    LIVE.with_borrow_mut(|live| {
+        live.drawn = mine.map(|(_, p)| p.to_array());
+        let Some((at, p)) = mine.filter(|_| state.painting && state.session.is_stroking()) else { return };
+        if live.stroke_at.is_none_or(|last| last.distance(at) * ppp >= 1.0) {
+            if live.stroke.len() == MAX_POINTS {
+                live.stroke.remove(0);
+            }
+            live.stroke.push(p.to_array());
+            live.stroke_at = Some(at);
+        }
+    });
+}
+
+/// The 3D view's overlays (after the render): this person's pointer on the model (and stroke) is noted for the others,
+/// and [`peers`] draws the others through this person's camera.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn draw(state: &UiState, painter: &egui::Painter, rect: Rect) {
+    if !connected() {
+        return;
+    }
+    let ctx = painter.ctx();
+    let ppp = ctx.pixels_per_point();
+    // The 3D view's camera, as viewport::show makes it.
+    let camera = state.camera.paint_camera([(rect.width() * ppp).round().max(1.0) as u32, (rect.height() * ppp).round().max(1.0) as u32]);
+    note(state, &camera, rect, ppp, ctx.pointer_hover_pos().filter(|_| ctx.rect_contains_pointer(painter.layer_id(), rect)));
+    if LIVE.with_borrow(|live| peers::draw_3d(state, painter, &camera, rect, &live.others)) {
+        ctx.request_repaint();
+    }
+}
+
+/// The 2D view's overlays (after the image, under this person's own pen path): the others' pen paths on its texture set.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn draw_uv(state: &UiState, painter: &egui::Painter, image: Rect) {
+    LIVE.with_borrow(|live| peers::draw_uv(state, painter, image, &live.others));
+}
+
+/// A Layers panel row (`layer` of texture set `set`, at `rect`) is drawn: the others' marks on it.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn row(ui: &egui::Ui, set: subcraft_core::TextureSetId, layer: LayerId, rect: Rect) {
+    LIVE.with_borrow(|live| peers::row(ui.painter(), set, layer, rect, &live.others));
+}
+
+/// The Layers panel marks where the layer this person drags would drop.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn reorder(target: DropTarget) {
+    LIVE.with_borrow_mut(|live| live.marker = Some(target));
+}
+
+/// `points` rounded to `scale`, the newest [`MAX_POINTS`].
+fn rounded<const N: usize>(points: &[[f32; N]], scale: f64) -> Vec<[f64; N]> {
+    points[points.len().saturating_sub(MAX_POINTS)..].iter().map(|p| p.map(|c| (f64::from(c) * scale).round() / scale)).collect()
+}
+
+/// The first number that differs between two layers' JSON (as `b` has it), named by the field holding it and the
+/// channel it is for.
+fn changed(a: &Value, b: &Value, field: &str, channel: Option<subcraft_core::ChannelKind>) -> Option<(String, Option<subcraft_core::ChannelKind>, f64)> {
+    use serde::Deserialize as _;
+    match (a, b) {
+        (Value::Number(x), Value::Number(y)) if x != y => Some((field.to_owned(), channel, y.as_f64()?)),
+        (Value::Object(x), Value::Object(y)) => {
+            let channel = y.get("channel").and_then(|c| subcraft_core::ChannelKind::deserialize(c).ok()).or(channel);
+            y.iter().find_map(|(k, v)| changed(x.get(k)?, v, k, channel))
+        }
+        (Value::Array(x), Value::Array(y)) => x.iter().zip(y).find_map(|(x, y)| changed(x, y, field, channel)),
+        _ => None,
+    }
+}
+
+/// The layer setting a slider drag is changing (its history entry still coalescing): the layer, and the setting with its
+/// value so far ("Base Color · Opacity 63%").
+fn adjusting(s: &subcraft_app::Session) -> Option<Value> {
+    let h = s.history();
+    // Its merge key names the layer: "opacity:<layer>:…", "fill:<layer>:…", "projection:<layer>", "effect:<layer>:…".
+    let id = LayerId(uuid::Uuid::parse_str(h.current_merge_key()?.split(':').nth(1)?).ok()?);
+    let find = |doc: &subcraft_doc::Document| doc.texture_sets.iter().find_map(|ts| ts.find(id)).map(|l| serde_json::to_value(checkpoint::layer_json(l)).ok());
+    let before = find(&h.entries().get(h.cursor().checked_sub(1)?)?.doc)??;
+    let (field, channel, v) = changed(&before, &find(h.current())??, "", None)?;
+    let value = match field.as_str() {
+        "opacity" => format!("{:.0}%", v * 100.0),
+        f if f.ends_with("_deg") => format!("{v:.0}°"),
+        _ => format!("{v:.2}"),
+    };
+    let mut name = field.trim_end_matches("_deg").replace('_', " ");
+    if let Some(first) = name.get(..1).map(str::to_uppercase) {
+        name.replace_range(..1, &first);
+    }
+    let text = match channel {
+        Some(c) => format!("{} · {name} {value}", c.display_name()),
+        None => format!("{name} {value}"),
+    };
+    Some(json!({ "layer": id, "text": text }))
+}
+
+impl SubcraftApp {
+    /// The canonical shared project, unless the last frame was busy: then the next quiet frame reports it again.
+    pub(crate) fn live_checkpoint(&self) -> Result<Vec<u8>, String> {
+        let busy = LIVE.with_borrow_mut(|live| {
+            if live.busy {
+                live.seen = None;
+            }
+            live.busy
+        });
+        if busy {
+            return Err("busy".into());
+        }
+        self.live_encode()
+    }
+
+    fn live_encode(&self) -> Result<Vec<u8>, String> {
+        let s = &self.state.session;
+        checkpoint::encode(s.history().current(), s.resources(), &s.scene().mesh)
+    }
+
+    /// This person's presence: the texture set and layer they work on and, while it is on the model, the surface point
+    /// under their pointer (object space, the same on everyone's mesh). What they have under way: the stroke they paint
+    /// (`stroke`: its surface points so far, the brush radius in object units and its base colour), the pen path they
+    /// edit (`pen`: its points in UV and its radius as a share of the UV square), the layer setting a slider drag
+    /// changes (`adjust`: the layer and "Setting value") and where a layer they drag would drop (`reorder`).
+    fn live_presence(&self) -> Value {
+        let (st, session) = (&self.state, &self.state.session);
+        let s = session.selection();
+        let mut state = json!({ "page": s.texture_set, "selection": s.layer.into_iter().collect::<Vec<_>>() });
+        LIVE.with_borrow(|live| {
+            if let Some(p) = live.pointer {
+                state["pointer"] = json!(p.map(|c| (f64::from(c) * 1e4).round() / 1e4));
+            }
+            if !live.stroke.is_empty() {
+                let r = (f64::from(session.brush_radius()) * 1e6).round() / 1e6;
+                state["stroke"] = json!({ "points": rounded(&live.stroke, 1e4), "size": r });
+                if let Some(c) = session.brush.material.channels.get(&subcraft_core::ChannelKind::BaseColor).filter(|c| c.enabled) {
+                    let [r, g, b] = c.value.0;
+                    let c = egui::Color32::from(egui::Rgba::from_rgb(r, g, b));
+                    state["stroke"]["color"] = format!("#{:02x}{:02x}{:02x}", c.r(), c.g(), c.b()).into();
+                }
+            }
+            let h = session.history();
+            if live.down && live.rest != Some((h.cursor(), h.entries()[h.cursor()].time))
+                && let Some(adjust) = adjusting(session)
+            {
+                state["adjust"] = adjust;
+            }
+            let target = match live.reorder {
+                Some(DropTarget::Above(id)) => Some(("above", id)),
+                Some(DropTarget::Below(id)) => Some(("below", id)),
+                Some(DropTarget::Inside(id)) => Some(("inside", id)),
+                _ => None,
+            };
+            if let Some((at, id)) = target {
+                state["reorder"] = json!([at, id]);
+            }
+        });
+        if st.pen.is_editing()
+            && let Some(path) = st.pen.preview(session)
+            && let Ok(line) = path.polyline(0.002)
+        {
+            // Points at least a texel (at 1024²) apart.
+            let mut kept: Vec<[f32; 2]> = Vec::new();
+            for p in line {
+                if kept.last().is_none_or(|q| Vec2::from_array(*q).distance(p) >= 1e-3) {
+                    kept.push(p.to_array());
+                }
+            }
+            state["pen"] = json!({ "points": rounded(&kept, 1e4), "size": (f64::from(path.radius) * 1e6).round() / 1e6 });
+        }
+        // Within the shell's 4 KiB: the newest points that fit.
+        for key in ["stroke", "pen"] {
+            while state.to_string().len() > 4000
+                && let Some(points) = state.get_mut(key).and_then(|v| v.get_mut("points")).and_then(Value::as_array_mut).filter(|p| p.len() > 1)
+            {
+                points.drain(..points.len() / 4 + 1);
+            }
+        }
+        state
+    }
+
+    /// Nothing under way that a remote change would cut short or a checkpoint would catch half done: no pointer down
+    /// (a stroke, a slider drag still coalescing into one history entry), no pen edit or image still being applied,
+    /// no text being typed (a focused slider or button is nothing under way).
+    fn live_quiet(&self, ctx: &egui::Context) -> bool {
+        let s = &self.state;
+        !ctx.input(|i| i.pointer.any_down())
+            && !s.session.is_stroking()
+            && !s.painting
+            && !s.pen.is_editing()
+            && !s.pen.is_pending()
+            && !s.asset_preview.is_applying()
+            && !ctx.text_edit_focused()
+    }
+
+    /// The end of a frame: the remote changes waiting, then a report if the committed document changed, once quiet.
+    fn live_frame(&mut self, ctx: &egui::Context) {
+        let quiet = self.live_quiet(ctx);
+        let waiting = LIVE.with_borrow_mut(|live| {
+            #[cfg(target_arch = "wasm32")]
+            live.ctx.get_or_insert_with(|| ctx.clone());
+            live.busy = !quiet;
+            live.pointer = live.drawn.take();
+            live.reorder = live.marker.take();
+            live.down = ctx.input(|i| i.pointer.any_down());
+            if !self.state.painting {
+                (live.stroke, live.stroke_at) = (Vec::new(), None);
+            }
+            if live.connected && quiet { std::mem::take(&mut live.remote) } else { VecDeque::new() }
+        });
+        for remote in waiting {
+            let result = self.live_apply(remote.base.as_deref(), &remote.edited);
+            (remote.done)(result);
+            ctx.request_repaint();
+        }
+        let h = self.state.session.history();
+        let doc = h.current();
+        let changed = LIVE.with_borrow_mut(|live| {
+            if !live.down {
+                live.rest = Some((h.cursor(), h.entries()[h.cursor()].time));
+            }
+            if !live.connected || !quiet || live.seen.as_ref() == Some(doc) {
+                return false;
+            }
+            live.seen = Some(doc.clone());
+            live.changes += 1;
+            true
+        });
+        #[cfg(target_arch = "wasm32")]
+        if changed {
+            web::call(|hooks| &hooks.changed, &wasm_bindgen::JsValue::NULL);
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        let _ = changed;
+    }
+
+    /// Merges a remote change into the project (or adopts a whole one, giving back the checkpoint it replaced), with no
+    /// undo step of its own.
+    fn live_apply(&mut self, base: Option<&[u8]>, edited: &[u8]) -> Result<Option<Vec<u8>>, String> {
+        // A whole project installs even when this one cannot be shared (too large): it then gives nothing back.
+        let local = self.live_encode();
+        let current = local.as_deref().ok().map(checkpoint::parse).transpose()?;
+        let edited = checkpoint::parse(edited)?;
+        let target = match (base, &current) {
+            (Some(base), Some(current)) => checkpoint::merge(&checkpoint::parse(base)?, current, &edited)?,
+            (Some(_), None) => return Err(local.err().unwrap_or_default()),
+            (None, _) => {
+                checkpoint::check_whole(&edited, current.as_ref())?;
+                // Joined: the welcome hub's New and Open would only be refused now.
+                self.state.welcome.open = false;
+                edited
+            }
+        };
+        let s = &mut self.state.session;
+        let install = checkpoint::install(&target, s.history().current(), s.resources(), &s.scene().mesh)?;
+        match install.mesh {
+            None => s.live_adopt(install.doc, install.resources, false),
+            // Another model: a session of its own, as when opening one.
+            Some((mesh, bytes)) => {
+                let mut store = subcraft_doc::ResourceStore::default();
+                for r in install.resources {
+                    store.insert_shared(r);
+                }
+                self.state.set_session(subcraft_app::Session::from_parts(mesh, install.doc, store, "Live session"));
+                checkpoint::known_mesh(&self.state.session.scene().mesh, &bytes);
+            }
+        }
+        Ok(local.ok().filter(|_| base.is_none()))
+    }
+
+    /// The session ended: native Undo starts over from the project as the session left it.
+    fn live_disconnected(&mut self) {
+        let doc = self.state.session.history().current().clone();
+        self.state.session.live_adopt(doc, Vec::new(), true);
+    }
+}
+
+/// The page's side: the kept runner, the app eframe runs (SubcraftApp, then the session's end-of-frame hook) and the
+/// adapter object the Playground shell drives (`shell/live.js`): `format`; `checkpoint()`, the canonical shared
+/// project, throwing `busy` while a gesture is under way; `merge(base, current, edited)`, the pure strict merge;
+/// `apply(base, edited)`, a promise that merges `edited` (with no base: adopts it whole, resolving to the checkpoint
+/// it replaced) at the end of the next quiet frame; `connect({ changed, undo })`, `disconnect()`, `presence()` and
+/// `showPresence(others)`. The hooks are called from inside a frame: the shell defers its calls back.
+#[cfg(target_arch = "wasm32")]
+pub(crate) mod web {
+    use super::{LIVE, Presence, SubcraftApp};
+    use js_sys::{Function, Object, Promise, Reflect, Uint8Array};
+    use std::cell::OnceCell;
+    use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+    thread_local! {
+        static RUNNER: OnceCell<eframe::WebRunner> = const { OnceCell::new() };
+    }
+
+    /// The page's web runner, kept for the adapter.
+    pub(crate) fn runner() -> eframe::WebRunner {
+        RUNNER.with(|kept| kept.get_or_init(eframe::WebRunner::new).clone())
+    }
+
+    /// The app eframe runs: `app`, offered to the page for live editing.
+    pub(crate) fn wrap(app: SubcraftApp) -> Box<dyn eframe::App> {
+        if let Err(e) = attach(&runner()) {
+            log::error!("subcraft: no live editing: {e:?}");
+        }
+        Box::new(Shell(app))
+    }
+
+    struct Shell(SubcraftApp);
+
+    impl eframe::App for Shell {
+        fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+            self.0.logic(ctx, frame);
+        }
+
+        /// The app's frame, then this frame's edits go out and the others' come in (they show next frame).
+        fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+            eframe::App::ui(&mut self.0, ui, frame);
+            self.0.live_frame(ui.ctx());
+        }
+
+        /// The app itself, which the adapter reaches through the runner.
+        fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+            Some(&mut self.0)
+        }
+
+        fn save(&mut self, storage: &mut dyn eframe::Storage) {
+            self.0.save(storage);
+        }
+
+        fn on_exit(&mut self) {
+            self.0.on_exit();
+        }
+
+        fn auto_save_interval(&self) -> std::time::Duration {
+            self.0.auto_save_interval()
+        }
+
+        fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+            self.0.clear_color(visuals)
+        }
+
+        fn persist_egui_memory(&self) -> bool {
+            self.0.persist_egui_memory()
+        }
+
+        fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+            self.0.raw_input_hook(ctx, raw_input);
+        }
+    }
+
+    pub(super) struct Hooks {
+        pub(super) changed: Function,
+        pub(super) undo: Function,
+    }
+
+    pub(super) fn call(pick: impl FnOnce(&Hooks) -> &Function, arg: &JsValue) {
+        if let Some(hook) = LIVE.with_borrow(|live| live.hooks.as_ref().map(|hooks| pick(hooks).clone())) {
+            let _ = hook.call1(&JsValue::NULL, arg);
+        }
+    }
+
+    /// Offers the adapter as `globalThis.playgroundLiveAdapter`, and to `globalThis.playgroundLive.attach` when the
+    /// shell is there already. A page without the shell never connects.
+    fn attach(runner: &eframe::WebRunner) -> Result<(), JsValue> {
+        let adapter = Object::new();
+        let set = |name: &str, value: JsValue| Reflect::set(&adapter, &name.into(), &value).map(drop);
+        set("format", format!("substance-painter:1:{}", env!("CARGO_PKG_VERSION")).into())?;
+        let app = runner.clone();
+        let checkpoint = move || -> Result<Uint8Array, JsValue> {
+            // Not running yet, or inside a frame: the shell retries a busy checkpoint.
+            let app = app.app_mut::<SubcraftApp>().ok_or("busy")?;
+            Ok(app.live_checkpoint().map_err(|e| JsValue::from_str(&e))?.as_slice().into())
+        };
+        set("checkpoint", Closure::<dyn Fn() -> _>::new(checkpoint).into_js_value())?;
+        let merge = |base: Uint8Array, current: Uint8Array, edited: Uint8Array| -> Result<Uint8Array, JsValue> {
+            let merged = super::checkpoint::merge_bytes(&base.to_vec(), &current.to_vec(), &edited.to_vec());
+            Ok(merged.map_err(|e| JsValue::from_str(&e))?.as_slice().into())
+        };
+        set("merge", Closure::<dyn Fn(_, _, _) -> _>::new(merge).into_js_value())?;
+        let apply = |base: JsValue, edited: Uint8Array| -> Promise {
+            let mut job = Some((base.dyn_ref::<Uint8Array>().map(Uint8Array::to_vec), edited.to_vec()));
+            Promise::new(&mut |resolve, reject| {
+                let Some((base, edited)) = job.take() else { return };
+                super::queue(
+                    base,
+                    edited,
+                    Box::new(move |result| {
+                        let _ = match result {
+                            Ok(None) => resolve.call0(&JsValue::NULL),
+                            Ok(Some(replaced)) => resolve.call1(&JsValue::NULL, &Uint8Array::from(replaced.as_slice())),
+                            Err(e) => reject.call1(&JsValue::NULL, &JsValue::from_str(&e)),
+                        };
+                    }),
+                );
+            })
+        };
+        set("apply", Closure::<dyn Fn(_, _) -> _>::new(apply).into_js_value())?;
+        let connect = |hooks: JsValue| -> Result<(), JsValue> {
+            let get = |name: &str| Reflect::get(&hooks, &name.into())?.dyn_into::<Function>();
+            let hooks = Hooks { changed: get("changed")?, undo: get("undo")? };
+            super::connect();
+            LIVE.with_borrow_mut(|live| {
+                live.hooks = Some(hooks);
+                if let Some(ctx) = &live.ctx {
+                    ctx.request_repaint();
+                }
+            });
+            Ok(())
+        };
+        set("connect", Closure::<dyn Fn(_) -> _>::new(connect).into_js_value())?;
+        let app = runner.clone();
+        let disconnect = move || {
+            super::disconnect();
+            if let Some(mut app) = app.app_mut::<SubcraftApp>() {
+                app.live_disconnected();
+            }
+        };
+        set("disconnect", Closure::<dyn Fn()>::new(disconnect).into_js_value())?;
+        let app = runner.clone();
+        let presence = move || -> Result<JsValue, JsValue> {
+            let app = app.app_mut::<SubcraftApp>().ok_or("busy")?;
+            js_sys::JSON::parse(&app.live_presence().to_string())
+        };
+        set("presence", Closure::<dyn Fn() -> _>::new(presence).into_js_value())?;
+        let show_presence = |others: JsValue| -> Result<(), JsValue> {
+            let text: String = js_sys::JSON::stringify(&others)?.into();
+            let others = Presence::list(&serde_json::from_str(&text).unwrap_or_default());
+            LIVE.with_borrow_mut(|live| {
+                live.others = others;
+                if let Some(ctx) = &live.ctx {
+                    ctx.request_repaint();
+                }
+            });
+            Ok(())
+        };
+        set("showPresence", Closure::<dyn Fn(_) -> _>::new(show_presence).into_js_value())?;
+        let global = js_sys::global();
+        Reflect::set(&global, &"playgroundLiveAdapter".into(), &adapter)?;
+        let attach = Reflect::get(&global, &"playgroundLive".into())
+            .and_then(|live| Reflect::get(&live, &"attach".into()))
+            .ok()
+            .and_then(|attach| attach.dyn_into::<Function>().ok());
+        if let Some(attach) = attach {
+            attach.call1(&global, &adapter)?;
+        }
+        Ok(())
+    }
+}
