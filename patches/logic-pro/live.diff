+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Presence in a Playground session: where each person is and the gesture under way, in the project's terms, so it
+//! shows in the same place for everyone whatever their zoom, scroll or window size.
+//!
+//! This person's state (`mine`, at most a few KiB of JSON):
+//!   `at`      the pointer: `{ "in": "lanes", "track", "fy", "beat" }` (the Tracks area: a track by id, the fraction
+//!             down its row and a beat), or `{ "in": "piano", "track", "region", "beat", "key" }` (the Piano Roll: a
+//!             region by ids, a beat of it and a key as a number), or `{ "in": "strip", "track", "ns", "fx", "fy" }`
+//!             (a track's channel strip in the Mixer or the Inspector, `ns`, and the fractions across and down it);
+//!   `region`  a region being dragged, as it is now: `[track, region, start beat, length in beats]`;
+//!   `notes`   with `track` and `region`: the notes a Piano Roll drag is moving, resizing or drawing, as they are now,
+//!             `[start, length, pitch]` each;
+//!   `fader`   while a channel strip is being worked: `{ "track", "db" }`, its volume as it is now.
+//! The views record where things are as they draw ([`lanes`], [`piano`], [`strip`]), so the pointer can be read in those terms and
+//! the others drawn back: their pointers with name tags, ghosts of what their drags are doing, in their colour, eased
+//! toward where they are.
+
+use super::kit::{self, Presence};
+use super::{ids_now, App};
+use egui::{pos2, vec2, Color32, Id, LayerId, Order, Painter, Pos2, Rangef, Rect, Shape, Stroke, StrokeKind, Ui};
+use serde_json::{json, Value};
+use std::cell::RefCell;
+
+/// The most notes a presence carries.
+const MAX_ITEMS: usize = 50;
+/// The most characters of a name tag, its ellipsis included.
+const MAX_NAME: usize = 24;
+/// How long the others' marks take to go most (1 - 1/e) of the way to where they last were, in seconds.
+const EASE: f64 = 0.08;
+/// The session's pointer arrow, tip first, in points.
+const ARROW: [(f32, f32); 7] = [(0.0, 0.0), (12.5, 11.0), (7.3, 11.0), (10.4, 17.3), (7.6, 18.6), (4.5, 12.2), (0.0, 16.0)];
+const GHOST: f32 = 0.28;
+const GHOST_EDGE: f32 = 0.85;
+
+/// The Tracks area as drawn this frame.
+struct Lanes {
+    rect: Rect,
+    /// Each track's row: top (from the first) and height (0 when folded away).
+    rows: Vec<(f32, f32)>,
+    scroll: (f32, f32),
+    beat_px: f32,
+}
+
+/// The Piano Roll as drawn this frame.
+struct Piano {
+    grid: Rect,
+    region: (usize, usize),
+    beat_px: f32,
+    key_h: f32,
+    scroll: (f32, f32),
+}
+
+impl Piano {
+    fn x(&self, beat: f64) -> f32 {
+        self.grid.left() + beat as f32 * self.beat_px - self.scroll.0
+    }
+    /// The top of `pitch`'s row.
+    fn top(&self, pitch: f64) -> f32 {
+        self.grid.top() + (127.0 - pitch as f32) * self.key_h - self.scroll.1
+    }
+}
+
+#[derive(Default)]
+struct Frame {
+    lanes: Option<Lanes>,
+    piano: Option<Piano>,
+    /// Channel strips of tracks: the track's index, the strip, and where it is (`mixer`, `inspector`).
+    strips: Vec<(usize, Rect, &'static str)>,
+}
+
+/// Someone else, with their marks eased toward their latest state.
+struct Peer {
+    id: String,
+    name: String,
+    color: Color32,
+    state: Value,
+    /// Their pointer's scope (`lanes:<track>`, `piano:<track>:<region>`) and place in it.
+    pointer: Option<(String, [f64; 2])>,
+    /// A region they drag: track id, region id, start and length in beats.
+    region: Option<([u64; 2], [f64; 2])>,
+    notes: Vec<[f64; 3]>,
+}
+
+thread_local! {
+    static FRAME: RefCell<Frame> = RefCell::default();
+    static MINE: RefCell<Value> = const { RefCell::new(Value::Null) };
+    static OTHERS: RefCell<Vec<Peer>> = const { RefCell::new(Vec::new()) };
+}
+
+fn on() -> bool {
+    kit::connected()
+}
+
+fn num(v: &Value) -> Option<f64> {
+    v.as_f64().filter(|n| n.is_finite() && n.abs() < 1.0e7)
+}
+
+// ---------------------------------------------------------------- the views' hooks
+
+/// The Tracks area drew its lanes in `rect`: each track's row (top from the first, height), scrolled by `scroll_x`,
+/// `scroll_y`, `beat_px` points a beat.
+pub fn lanes(rect: Rect, rows: &[(f32, f32)], scroll_x: f32, scroll_y: f32, beat_px: f32) {
+    if on() {
+        FRAME.with_borrow_mut(|f| f.lanes = Some(Lanes { rect, rows: rows.to_vec(), scroll: (scroll_x, scroll_y), beat_px }));
+    }
+}
+
+/// The Piano Roll drew region `(track, region)` (indexes) over `grid`, `beat_px` points a beat and `key_h` a key.
+pub fn piano(grid: Rect, region: (usize, usize), beat_px: f32, key_h: f32, scroll_x: f32, scroll_y: f32) {
+    if on() {
+        FRAME.with_borrow_mut(|f| f.piano = Some(Piano { grid, region, beat_px, key_h, scroll: (scroll_x, scroll_y) }));
+    }
+}
+
+/// A channel strip was drawn at `rect` (in the Mixer or the Inspector, `ns`).
+pub fn strip(rect: Rect, key: crate::mixer::StripKey, ns: &'static str) {
+    if let (true, crate::mixer::StripKey::Track(i)) = (on(), key) {
+        FRAME.with_borrow_mut(|f| f.strips.push((i, rect, ns)));
+    }
+}
+
+// ---------------------------------------------------------------- the frame's end
+
+/// After the window's frame: this person's pointer and drags read in the project's terms, the others' marks eased
+/// and drawn over the views (under menus and dialogs), and the recorded places cleared for the next frame.
+pub fn overlay(ui: &Ui, app: &App) {
+    if !on() {
+        return;
+    }
+    let frame = FRAME.with_borrow_mut(std::mem::take);
+    let ids = ids_now();
+    let pointer = ui.ctx().pointer_latest_pos();
+    let down = ui.input(|i| i.pointer.any_down());
+    let p = &app.project;
+    let region_ids = |(t, r): (usize, usize)| ids.get(t).and_then(|(tid, rids)| Some([*tid, *rids.get(r)?]));
+
+    // Mine.
+    let mut mine = serde_json::Map::new();
+    if let (Some(l), Some(at)) = (&frame.lanes, pointer.filter(|at| frame.lanes.as_ref().is_some_and(|l| l.rect.contains(*at)))) {
+        let y = at.y - l.rect.top() + l.scroll.1;
+        if let Some(t) = l.rows.iter().position(|&(top, h)| h > 0.0 && y >= top && y < top + h) {
+            let (top, h) = l.rows[t];
+            let beat = f64::from((at.x - l.rect.left() + l.scroll.0) / l.beat_px.max(1.0e-3));
+            if let Some((id, _)) = ids.get(t) {
+                mine.insert("at".into(), json!({ "in": "lanes", "track": id, "fy": (y - top) / h.max(1.0), "beat": beat }));
+            }
+        }
+    }
+    if let (Some(pr), Some(at)) = (&frame.piano, pointer.filter(|at| frame.piano.as_ref().is_some_and(|pr| pr.grid.contains(*at)))) {
+        if let Some([t, r]) = region_ids(pr.region) {
+            let beat = f64::from((at.x - pr.grid.left() + pr.scroll.0) / pr.beat_px.max(1.0e-3));
+            let rows_down = f64::from((at.y - pr.grid.top() + pr.scroll.1) / pr.key_h.max(1.0e-3));
+            mine.insert("at".into(), json!({ "in": "piano", "track": t, "region": r, "beat": beat, "key": 128.0 - rows_down }));
+        }
+    }
+    if let Some(&(t, rect, ns)) = pointer.and_then(|at| frame.strips.iter().find(|s| s.1.contains(at))) {
+        if let (Some(at), Some((id, _))) = (pointer, ids.get(t)) {
+            let f = (at - rect.min) / rect.size().max(vec2(1.0, 1.0));
+            mine.insert("at".into(), json!({ "in": "strip", "track": id, "ns": ns, "fx": f.x, "fy": f.y }));
+            if down {
+                mine.insert("fader".into(), json!({ "track": id, "db": p.tracks.get(t).map_or(0.0, |t| t.volume_db) }));
+            }
+        }
+    }
+    if down {
+        // A region being dragged in the Tracks area, or notes in the Piano Roll, as they are now.
+        let pressed = ui.input(|i| i.pointer.press_origin());
+        let from = |r: Option<Rect>| pressed.zip(r).is_some_and(|(at, r)| r.contains(at));
+        if let Some((t, ri)) = app.ui.tracks.selected.filter(|_| from(frame.lanes.as_ref().map(|l| l.rect))) {
+            if let (Some(ids), Some(region)) = (region_ids((t, ri)), p.tracks.get(t).and_then(|t| t.regions.get(ri))) {
+                mine.insert("region".into(), json!([ids[0], ids[1], p.region_start_beats(region), p.region_len_beats(region)]));
+            }
+        }
+        if let Some(pr) = frame.piano.as_ref().filter(|pr| from(Some(pr.grid))) {
+            let (t, r) = pr.region;
+            if let (Some([tid, rid]), Some(region)) = (region_ids((t, r)), p.tracks.get(t).and_then(|t| t.regions.get(r))) {
+                let notes: Vec<[f64; 3]> = app
+                    .ui
+                    .piano
+                    .selected
+                    .iter()
+                    .filter_map(|&i| region.notes.get(i))
+                    .take(MAX_ITEMS)
+                    .map(|n| [f64::from(n.start), f64::from(n.len), f64::from(n.pitch)])
+                    .collect();
+                if !notes.is_empty() {
+                    mine.insert("notes".into(), json!({ "track": tid, "region": rid, "list": notes }));
+                }
+            }
+        }
+    }
+    MINE.set(Value::Object(mine));
+
+    // The others: eased, then drawn.
+    let dt = ui.input(|i| f64::from(i.stable_dt));
+    if OTHERS.with_borrow_mut(|others| others.iter_mut().fold(false, |moving, p| p.step(dt) | moving)) {
+        ui.ctx().request_repaint();
+    }
+    let index = |id: f64| ids.iter().position(|(t, _)| *t as f64 == id);
+    let layer = ui.ctx().layer_painter(LayerId::new(Order::Middle, Id::unique("prowave-live-presence")));
+    if let Some(l) = &frame.lanes {
+        let row = |track: u64| index(track as f64).and_then(|t| l.rows.get(t)).filter(|r| r.1 > 0.0).map(|&(top, h)| Rangef::new(l.rect.top() + top - l.scroll.1, l.rect.top() + top - l.scroll.1 + h));
+        let x = |beat: f64| l.rect.left() + beat as f32 * l.beat_px - l.scroll.0;
+        let all = marks(|peer, marks| {
+            if let Some(([track, _], [start, len])) = peer.region {
+                if let Some(rows) = row(track) {
+                    marks.ghosts.push(Rect::from_x_y_ranges(Rangef::new(x(start), x(start + len)), rows.shrink(1.0)));
+                }
+            }
+            if let Some((scope, [fy, beat])) = &peer.pointer {
+                let track = scope.strip_prefix("lanes:").and_then(|t| t.parse::<u64>().ok());
+                marks.tip = track.and_then(row).map(|rows| pos2(x(*beat), rows.min + rows.span() * *fy as f32));
+            }
+        });
+        paint(&layer.with_clip_rect(l.rect), &all);
+    }
+    if let Some(pr) = &frame.piano {
+        let shown = region_ids(pr.region);
+        let all = marks(|peer, marks| {
+            let here = shown.is_some_and(|[t, r]| peer.state["notes"]["track"].as_u64() == Some(t) && peer.state["notes"]["region"].as_u64() == Some(r));
+            if here {
+                for n in &peer.notes {
+                    let left = pr.x(n[0]);
+                    let top = pr.top(n[2].round());
+                    marks.ghosts.push(Rect::from_min_max(pos2(left, top + 1.0), pos2(pr.x(n[0] + n[1].max(0.0)).max(left + 2.0), top + pr.key_h)));
+                }
+            }
+            if let (Some((scope, [beat, key])), Some([t, r])) = (&peer.pointer, shown) {
+                if *scope == format!("piano:{t}:{r}") {
+                    let k = key.floor();
+                    marks.tip = Some(pos2(pr.x(*beat), pr.top(k) + pr.key_h * (1.0 - (key - k) as f32)));
+                }
+            }
+        });
+        paint(&layer.with_clip_rect(pr.grid), &all);
+    }
+    paint_strips(&layer, &frame.strips, |id| ids.iter().position(|(t, _)| *t == id));
+}
+
+/// The others' pointers on channel strips, with the volume they are setting, over each place's strips.
+fn paint_strips(layer: &Painter, strips: &[(usize, Rect, &'static str)], index: impl Fn(u64) -> Option<usize>) {
+    for ns in ["mixer", "inspector"] {
+        let area = strips.iter().filter(|s| s.2 == ns).fold(Rect::NOTHING, |a, s| a.union(s.1));
+        if !area.is_positive() {
+            continue;
+        }
+        let all = marks(|peer, marks| {
+            let Some((scope, [fx, fy])) = &peer.pointer else { return };
+            let Some((track, place)) = scope.strip_prefix("strip:").and_then(|s| s.split_once(':')) else { return };
+            let Some(t) = track.parse::<u64>().ok().filter(|_| place == ns).and_then(&index) else { return };
+            let Some(&(_, rect, _)) = strips.iter().find(|s| s.0 == t && s.2 == ns) else { return };
+            marks.tip = Some(rect.min + vec2(rect.width() * *fx as f32, rect.height() * *fy as f32));
+            let fader = &peer.state["fader"];
+            if fader["track"].as_u64().and_then(&index) == Some(t) {
+                marks.value = num(&fader["db"]).map(|db| format!("{db:.1} dB"));
+            }
+        });
+        paint(&layer.with_clip_rect(area), &all);
+    }
+}
+
+/// Each other person's marks, as `make` places them.
+fn marks(make: impl Fn(&Peer, &mut Marks)) -> Vec<(Color32, String, Marks)> {
+    OTHERS.with_borrow(|others| {
+        others
+            .iter()
+            .map(|peer| {
+                let mut m = Marks::default();
+                make(peer, &mut m);
+                (peer.color, peer.name.clone(), m)
+            })
+            .collect()
+    })
+}
+
+/// This person's presence for the others.
+pub fn mine(_app: &App) -> Value {
+    MINE.with_borrow(Clone::clone)
+}
+
+/// The others, all of them each time any changes (empty when the session ends).
+pub fn show(list: Vec<Presence>) {
+    OTHERS.with_borrow_mut(|others| {
+        let mut next = Vec::with_capacity(list.len());
+        for p in list {
+            let mut peer = match others.iter().position(|o| o.id == p.id) {
+                Some(i) => others.swap_remove(i),
+                None => Peer { id: p.id.clone(), name: String::new(), color: Color32::GRAY, state: Value::Null, pointer: None, region: None, notes: Vec::new() },
+            };
+            peer.name = short(&p.name);
+            peer.color = Color32::from_rgb(p.color[0], p.color[1], p.color[2]);
+            peer.state = p.state;
+            // What is new shows at once; the frame's end eases the rest.
+            peer.step(0.0);
+            next.push(peer);
+        }
+        *others = next;
+    });
+    crate::web::repaint();
+}
+
+fn short(name: &str) -> String {
+    if name.chars().count() <= MAX_NAME {
+        name.to_owned()
+    } else {
+        name.chars().take(MAX_NAME - 1).chain(['…']).collect()
+    }
+}
+
+impl Peer {
+    /// Where their state puts their marks.
+    #[allow(clippy::type_complexity)]
+    fn targets(&self) -> (Option<(String, [f64; 2])>, Option<([u64; 2], [f64; 2])>, Vec<[f64; 3]>) {
+        let at = &self.state["at"];
+        let id = |v: &Value| v.as_u64();
+        let pointer = match at["in"].as_str() {
+            Some("lanes") => id(&at["track"]).zip(num(&at["fy"]).zip(num(&at["beat"]))).map(|(t, (a, b))| (format!("lanes:{t}"), [a.clamp(0.0, 1.0), b])),
+            Some("strip") => id(&at["track"])
+                .zip(at["ns"].as_str().filter(|ns| matches!(*ns, "mixer" | "inspector")))
+                .zip(num(&at["fx"]).zip(num(&at["fy"])))
+                .map(|((t, ns), (x, y))| (format!("strip:{t}:{ns}"), [x.clamp(0.0, 1.0), y.clamp(0.0, 1.0)])),
+            Some("piano") => id(&at["track"])
+                .zip(id(&at["region"]))
+                .zip(num(&at["beat"]).zip(num(&at["key"])))
+                .map(|((t, r), (b, k))| (format!("piano:{t}:{r}"), [b, k.clamp(0.0, 128.0)])),
+            _ => None,
+        };
+        let g = &self.state["region"];
+        let region = id(&g[0]).zip(id(&g[1])).zip(num(&g[2]).zip(num(&g[3]))).map(|((t, r), (s, l))| ([t, r], [s, l]));
+        let notes = self.state["notes"]["list"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .take(MAX_ITEMS)
+            .filter_map(|t| Some([num(&t[0])?, num(&t[1])?, num(&t[2])?.clamp(0.0, 127.0)]))
+            .collect();
+        (pointer, region, notes)
+    }
+
+    /// `dt` seconds on toward their latest state; whether a mark is still on its way.
+    fn step(&mut self, dt: f64) -> bool {
+        let k = 1.0 - (-dt.clamp(0.0, 0.1) / EASE).exp();
+        let (pointer, region, notes) = self.targets();
+        let mut moving = false;
+        match (&mut self.pointer, pointer) {
+            (Some((s, p)), Some((t, q))) if *s == t => moving |= ease(p, q, k),
+            (s, t) => *s = t,
+        }
+        match (&mut self.region, region) {
+            (Some((s, p)), Some((t, q))) if *s == t => moving |= ease(p, q, k),
+            (s, t) => *s = t,
+        }
+        if self.notes.len() == notes.len() {
+            moving |= self.notes.iter_mut().zip(notes).fold(false, |m, (s, t)| ease(s, t, k) | m);
+        } else {
+            self.notes = notes;
+        }
+        moving
+    }
+}
+
+fn ease<const N: usize>(s: &mut [f64; N], t: [f64; N], k: f64) -> bool {
+    let mut moving = false;
+    for (s, t) in s.iter_mut().zip(t) {
+        *s += (t - *s) * k;
+        if (t - *s).abs() < 1.0e-3 {
+            *s = t;
+        } else {
+            moving = true;
+        }
+    }
+    moving
+}
+
+// ---------------------------------------------------------------- the look
+
+/// What a person shows in a view, in screen terms.
+#[derive(Default)]
+struct Marks {
+    tip: Option<Pos2>,
+    ghosts: Vec<Rect>,
+    /// Shown under the name: the value they are setting.
+    value: Option<String>,
+}
+
+/// White or near-black, whichever reads on `color`.
+fn ink(color: Color32) -> Color32 {
+    let c = egui::Rgba::from(color);
+    if 0.2126 * c.r() + 0.7152 * c.g() + 0.0722 * c.b() > 0.55 {
+        Color32::from_gray(0x11)
+    } else {
+        Color32::WHITE
+    }
+}
+
+/// The others' marks over `painter`'s area in the session's shared look: everyone's ghosts, then pointers with their
+/// name tags.
+fn paint(painter: &Painter, all: &[(Color32, String, Marks)]) {
+    let near = painter.clip_rect().expand(4.0);
+    for (color, _, marks) in all {
+        for ghost in &marks.ghosts {
+            let rect = ghost.intersect(near);
+            if rect.is_positive() {
+                painter.rect(rect, 2.0, color.gamma_multiply(GHOST), Stroke::new(1.5, color.gamma_multiply(GHOST_EDGE)), StrokeKind::Inside);
+            }
+        }
+    }
+    for (color, name, marks) in all {
+        let Some(tip) = marks.tip.filter(|p| painter.clip_rect().contains(*p)) else { continue };
+        let arrow = |at: Pos2| ARROW.iter().map(|&(x, y)| at + vec2(x, y)).collect::<Vec<_>>();
+        painter.add(Shape::convex_polygon(arrow(tip + vec2(0.0, 1.0)), Color32::from_black_alpha(64), Stroke::NONE));
+        painter.add(Shape::convex_polygon(arrow(tip), *color, Stroke::new(1.5, Color32::WHITE)));
+        let mut at = tip + vec2(12.0, 15.0);
+        for text in [Some(name.as_str()), marks.value.as_deref()].into_iter().flatten().filter(|t| !t.is_empty()) {
+            let galley = painter.layout_no_wrap(text.to_owned(), egui::FontId::proportional(12.0), ink(*color));
+            let pad = vec2(7.0, 3.0);
+            let tag = Rect::from_min_size(pos2(at.x.round(), at.y.round()), galley.size() + 2.0 * pad);
+            painter.rect_filled(tag, 6.0, *color);
+            painter.galley(tag.min + pad, galley, ink(*color));
+            at.y = tag.bottom() + 2.0;
+        }
+    }
+}
