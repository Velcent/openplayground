+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::*;
+use kit::Live as _;
+use crate::model::{Note, Project, TrackKind};
+
+fn app() -> App {
+    let project = Project::demo();
+    App {
+        saved: crate::file_commands::content(&project),
+        history: crate::undo::History::new(&project),
+        project,
+        ui: crate::UiState::new(),
+        sync: None,
+        path: None,
+        native_menu: None,
+        bench: None,
+        shots: None,
+        frames_since_record: 0,
+    }
+}
+
+#[test]
+fn views_stay_personal_and_edits_to_different_things_both_stay() {
+    let mut a = app();
+    let base = a.live_document();
+    // Personal settings and views are not in the document.
+    a.project.position_beats = 33.0;
+    a.project.cycle = !a.project.cycle;
+    a.project.tracks[2].height = 3.0;
+    a.project.selected_track = 4;
+    assert_eq!(kit::canonical(&a.live_document()), kit::canonical(&base));
+
+    // One person moves a note of the first region and adds a track in front; the other changes another note of that
+    // region and the volume of the last track.
+    let notes = |a: &App| a.project.tracks[0].regions[0].notes.clone();
+    a.project.tracks[0].regions[0].notes[0].pitch += 1;
+    a.project.tracks.insert(0, crate::model::Track::new("Aux 1", TrackKind::Aux));
+    let mine = a.live_document();
+    a.live_adopt(base.clone()).unwrap();
+    assert_eq!(a.project.position_beats, 33.0, "adopting keeps the playhead");
+    assert_eq!(a.project.tracks[2].height, 3.0, "and the track heights");
+    let last = a.project.tracks.len() - 1;
+    a.project.tracks[last].volume_db = -20.0;
+    let louder: &mut Note = &mut a.project.tracks[0].regions[0].notes[5];
+    louder.vel = 33;
+    let theirs = a.live_document();
+
+    let merged = merge(&base, &mine, &theirs).unwrap();
+    a.live_adopt(merged.clone()).unwrap();
+    assert_eq!(a.project.tracks[0].name, "Aux 1");
+    assert_eq!(a.project.tracks.last().unwrap().volume_db, -20.0, "the volume landed on its own track");
+    let got = notes(&app());
+    let now = &a.project.tracks[1].regions[0].notes;
+    assert_eq!(now.len(), got.len());
+    assert!(now.iter().any(|n| n.vel == 33) && now.iter().any(|n| n.pitch == got[0].pitch + 1));
+    // The adopted document reads back to the same bytes: nobody proposes a fix-up.
+    assert_eq!(kit::canonical(&a.live_document()), kit::canonical(&merged));
+
+    // The same note changed by both is a conflict, not a mix of the two.
+    a.live_adopt(base.clone()).unwrap();
+    a.project.tracks[0].regions[0].notes[0].pitch += 2;
+    assert!(merge(&base, &mine, &a.live_document()).is_err());
+}
