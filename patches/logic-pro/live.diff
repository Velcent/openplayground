+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Live editing in a Playground session (patches/logic-pro.yaml in github.com/daijro/openplayground): the window is the
+//! app the session's kit (`kit`, Playground's template) runs on, and Playground's shell/live.js drives it. Nothing
+//! here runs until a session connects. Web only, and its native tests.
+//!
+//! The shared document is the project as its `.prowave` file has it (`project.json`), shaped so two people's edits
+//! merge: the kit merges objects by key and lists of objects by their `id`. Tracks and regions have no ids in the
+//! model, so they are kept here, beside it, and followed from one look to the next ([`follow`]): what is unchanged
+//! keeps its id, and between unchanged ones an item with the same name, or the only one changed in its place, keeps
+//! the one it had. A note's id is the note itself (a moved note is the old one gone and a new one added, so two people
+//! changing different notes of one region both keep theirs); notes are kept in time order, so every peer has the same
+//! bytes. Personal, never shared: the playhead and transport, the selection, the cycle, the metronome and count-in,
+//! and each track's height, folding, record and input-monitoring buttons. Audio files travel as the session's media,
+//! named by their content: a region plays `media/<hash>-<length>.<ext>`, kept in memory under `/live`.
+
+#[path = "playground_live.rs"]
+#[allow(dead_code)]
+pub mod kit;
+#[cfg(target_arch = "wasm32")]
+mod peers;
+#[cfg(target_arch = "wasm32")]
+pub use peers::{lanes, piano, strip};
+
+use crate::model::Project;
+use crate::App;
+use prowave_project::{NoteDoc, ProjectDoc, RegionDoc, TrackDoc};
+use serde_json::{Map, Value};
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+/// The document's format: peers whose formats differ do not share a document.
+#[cfg(target_arch = "wasm32")]
+pub fn format() -> String {
+    format!("prowave:{}:1", prowave_project::FORMAT_VERSION)
+}
+
+/// Where the session's media are kept: `/live/media/<asset>`, and stand-ins for those not here yet under
+/// `/live/media/missing/`.
+const ROOT: &str = "/live";
+const MISSING: &str = "missing/";
+/// The project's personal fields, and each track's.
+const PERSONAL: [&str; 7] = ["position_beats", "selected_track", "cycle", "cycle_start", "cycle_end", "metronome", "count_in"];
+const TRACK_PERSONAL: [&str; 2] = ["height", "folded"];
+
+/// The tracks as last seen: each one's id, content (personal fields neutral) and its regions' ids.
+#[derive(Default)]
+struct Seen {
+    tracks: Vec<(u64, TrackDoc, Vec<u64>)>,
+    next: u64,
+}
+
+thread_local! {
+    static SEEN: RefCell<Seen> = RefCell::default();
+    /// Asset names of files outside `/live`, by path and length.
+    // ponytail: a file rewritten in place with another of the same length keeps its old name; add its time written
+    // if that ever happens (drops and opens write new paths).
+    static ASSETS: RefCell<HashMap<(PathBuf, u64), String>> = RefCell::default();
+}
+
+// ---------------------------------------------------------------- ids
+
+/// Ids for `cur`, following `prev` (with its ids): unchanged items keep theirs (the longest run of them in order);
+/// between two unchanged ones, an item with the same `name` keeps the one it had, and so does the only one changed in
+/// its place; anything else is new and gets a `fresh` id.
+fn follow<T: PartialEq>(prev: &[(u64, &T)], cur: &[&T], name: impl Fn(&T) -> String, fresh: &mut impl FnMut() -> u64) -> Vec<u64> {
+    let (n, m) = (prev.len(), cur.len());
+    // Longest common subsequence of unchanged items.
+    let mut lcs = vec![0u32; (n + 1) * (m + 1)];
+    let at = |i: usize, j: usize| i * (m + 1) + j;
+    for i in (0..n).rev() {
+        for j in (0..m).rev() {
+            lcs[at(i, j)] = if prev[i].1 == cur[j] { lcs[at(i + 1, j + 1)] + 1 } else { lcs[at(i + 1, j)].max(lcs[at(i, j + 1)]) };
+        }
+    }
+    let mut anchors = Vec::new();
+    let (mut i, mut j) = (0, 0);
+    while i < n && j < m {
+        if prev[i].1 == cur[j] && lcs[at(i, j)] == lcs[at(i + 1, j + 1)] + 1 {
+            anchors.push((i, j));
+            (i, j) = (i + 1, j + 1);
+        } else if lcs[at(i + 1, j)] >= lcs[at(i, j + 1)] {
+            i += 1;
+        } else {
+            j += 1;
+        }
+    }
+    anchors.push((n, m));
+    let mut ids = vec![None; m];
+    let (mut p0, mut c0) = (0, 0);
+    for (pa, ca) in anchors {
+        let mut olds: Vec<usize> = (p0..pa).collect();
+        let news: Vec<usize> = (c0..ca).collect();
+        for &c in &news {
+            if let Some(k) = olds.iter().position(|&p| name(prev[p].1) == name(cur[c])) {
+                ids[c] = Some(prev[olds.remove(k)].0);
+            }
+        }
+        let left: Vec<usize> = news.iter().copied().filter(|&c| ids[c].is_none()).collect();
+        if let ([c], [p]) = (left.as_slice(), olds.as_slice()) {
+            ids[*c] = Some(prev[*p].0);
+        }
+        if pa < n {
+            ids[ca] = Some(prev[pa].0);
+        }
+        (p0, c0) = (pa + 1, ca + 1);
+    }
+    ids.into_iter().map(|id| id.unwrap_or_else(&mut *fresh)).collect()
+}
+
+fn neutral(t: &TrackDoc) -> TrackDoc {
+    TrackDoc { height: 1.0, folded: false, ..t.clone() }
+}
+
+fn note_key(n: &Value) -> (f64, u64, f64, u64) {
+    let num = |k: &str| n[k].as_f64().unwrap_or(0.0);
+    (num("start"), n["pitch"].as_u64().unwrap_or(0), num("len"), n["vel"].as_u64().unwrap_or(0))
+}
+
+/// Notes in time order (then pitch, length, velocity and id), the order every peer keeps them in.
+fn sort_notes(notes: &mut [Value]) {
+    notes.sort_by(|a, b| {
+        let (x, y) = (note_key(a), note_key(b));
+        let id = |n: &Value| n["id"].as_str().map(|s| (s.len(), s.to_owned()));
+        x.0.total_cmp(&y.0).then(x.1.cmp(&y.1)).then(x.2.total_cmp(&y.2)).then(x.3.cmp(&y.3)).then_with(|| id(a).cmp(&id(b)))
+    });
+}
+
+/// A region's notes as the document has them, in time order: each with its id (the note itself, then which of equal
+/// notes it is).
+fn shaped_notes(notes: &[NoteDoc]) -> Value {
+    let mut sorted: Vec<&NoteDoc> = notes.iter().collect();
+    sorted.sort_by(|a, b| a.start.total_cmp(&b.start).then(a.pitch.cmp(&b.pitch)).then(a.len.total_cmp(&b.len)).then(a.vel.cmp(&b.vel)));
+    let (mut previous, mut k) = (String::new(), 0);
+    let shaped = sorted.into_iter().map(|n| {
+        let base = format!("{}@{}+{}v{}", n.pitch, n.start, n.len, n.vel);
+        k = if base == previous { k + 1 } else { 1 };
+        let mut note = object(serde_json::to_value(n).unwrap_or_default());
+        note.insert("id".into(), Value::String(format!("{base}#{k}")));
+        previous = base;
+        Value::Object(note)
+    });
+    Value::Array(shaped.collect())
+}
+
+fn object(v: Value) -> Map<String, Value> {
+    match v {
+        Value::Object(map) => map,
+        _ => Map::new(),
+    }
+}
+
+/// `doc` as the shared document, following the ids `seen` had (and leaving the new ones there).
+fn shape(doc: &ProjectDoc, seen: &mut Seen) -> Value {
+    let Seen { tracks: prev, next } = seen;
+    let mut fresh = || kit::fresh_id(next);
+    let cur: Vec<TrackDoc> = doc.tracks.iter().map(neutral).collect();
+    let ids = follow(
+        &prev.iter().map(|(id, t, _)| (*id, t)).collect::<Vec<_>>(),
+        &cur.iter().collect::<Vec<_>>(),
+        |t| format!("{:?}/{}", t.kind, t.name),
+        &mut fresh,
+    );
+    let mut tracks = Vec::with_capacity(cur.len());
+    let mut now = Vec::with_capacity(cur.len());
+    for (t, &id) in cur.iter().zip(&ids) {
+        let before: Vec<(u64, &RegionDoc)> = prev
+            .iter()
+            .find(|(p, ..)| *p == id)
+            .map(|(_, pt, rids)| rids.iter().copied().zip(&pt.regions).collect())
+            .unwrap_or_default();
+        let rids = follow(&before, &t.regions.iter().collect::<Vec<_>>(), |r| r.name.clone(), &mut fresh);
+        let regions = t
+            .regions
+            .iter()
+            .zip(&rids)
+            .map(|(r, &rid)| {
+                let mut region = object(serde_json::to_value(r).unwrap_or_default());
+                region.insert("id".into(), rid.into());
+                region.insert("notes".into(), shaped_notes(&r.notes));
+                Value::Object(region)
+            })
+            .collect();
+        let mut track = object(serde_json::to_value(t).unwrap_or_default());
+        for k in TRACK_PERSONAL {
+            track.remove(k);
+        }
+        track.insert("id".into(), id.into());
+        track.insert("regions".into(), Value::Array(regions));
+        tracks.push(Value::Object(track));
+        now.push((id, t.clone(), rids));
+    }
+    *prev = now;
+    let mut top = object(serde_json::to_value(doc).unwrap_or_default());
+    for k in PERSONAL {
+        top.remove(k);
+    }
+    top.insert("tracks".into(), Value::Array(tracks));
+    Value::Object(top)
+}
+
+/// The track and region ids a shared document gives.
+fn ids_of(document: &Value) -> Vec<(u64, Vec<u64>)> {
+    let list = |v: &Value| v.as_array().cloned().unwrap_or_default();
+    list(&document["tracks"])
+        .iter()
+        .map(|t| (t["id"].as_u64().unwrap_or(0), list(&t["regions"]).iter().map(|r| r["id"].as_u64().unwrap_or(0)).collect()))
+        .collect()
+}
+
+/// The project file's document a shared document holds; it must read and validate as a file's does.
+pub fn project_of(document: &Value) -> Result<ProjectDoc, String> {
+    fn strip(v: &mut Value) {
+        match v {
+            Value::Object(map) => {
+                map.remove("id");
+                map.values_mut().for_each(strip);
+            }
+            Value::Array(items) => items.iter_mut().for_each(strip),
+            _ => {}
+        }
+    }
+    if !document.is_object() || !document["tracks"].is_array() {
+        return Err("Conflict: not a project".into());
+    }
+    let mut v = document.clone();
+    strip(&mut v);
+    let doc: ProjectDoc = serde_json::from_value(v).map_err(|e| format!("Conflict: {e}"))?;
+    if doc.format_version > prowave_project::FORMAT_VERSION {
+        return Err("Conflict: a newer project format".into());
+    }
+    let bad = doc.tracks.iter().flat_map(|t| &t.regions).filter_map(|r| r.audio.as_deref()).find(|a| asset_name(a).is_none());
+    match bad {
+        Some(a) => Err(format!("Conflict: {a} is not a session's media")),
+        None => Ok(doc),
+    }
+}
+
+/// The three-way merge: the kit's, then notes back in order and folder nesting as the app allows it (the merge of two
+/// valid nestings can need it); the result must read as a project.
+pub fn merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+    let mut merged = kit::merge(base, current, edited, &[])?;
+    let mut allowed = 0;
+    for t in merged["tracks"].as_array_mut().into_iter().flatten() {
+        let indent = t["indent"].as_u64().unwrap_or(0).min(allowed);
+        if t.get("indent").is_some() {
+            t["indent"] = indent.into();
+        }
+        allowed = indent + u64::from(t["kind"] == "Folder");
+        for r in t["regions"].as_array_mut().into_iter().flatten() {
+            if let Some(notes) = r["notes"].as_array_mut() {
+                sort_notes(notes);
+            }
+        }
+    }
+    project_of(&merged)?;
+    Ok(merged)
+}
+
+// ---------------------------------------------------------------- media
+
+/// The asset a region's media path names (`media/<asset>`, or a stand-in's `media/missing/<asset>`), when it is one.
+fn asset_name(path: &str) -> Option<&str> {
+    let name = path.strip_prefix("media/")?;
+    let name = name.strip_prefix(MISSING).unwrap_or(name);
+    let (hash, rest) = name.split_once('-')?;
+    let (len, ext) = rest.split_once('.')?;
+    let ok = hash.len() == 16
+        && hash.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+        && !len.is_empty()
+        && len.bytes().all(|b| b.is_ascii_digit())
+        && (1..=5).contains(&ext.len())
+        && ext.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit());
+    ok.then_some(name)
+}
+
+/// Whether `id` names an asset (and nothing else: no folders).
+fn is_asset(id: &str) -> bool {
+    asset_name(&format!("media/{id}")) == Some(id)
+}
+
+/// The asset name of `bytes` (FNV-1a over the content, its length, the file's type).
+// ponytail: a 64-bit non-cryptographic hash: an editor could forge a file under another's name, which an editor can do
+// to the document anyway; a cryptographic hash if media ever come from people who may not edit.
+fn asset_of(bytes: &[u8], ext: &str) -> String {
+    let hash = bytes.iter().fold(0xcbf2_9ce4_8422_2325u64, |h, &b| (h ^ u64::from(b)).wrapping_mul(0x0100_0000_01b3));
+    let ext: String = ext.to_ascii_lowercase().chars().filter(char::is_ascii_alphanumeric).take(5).collect();
+    format!("{hash:016x}-{}.{}", bytes.len(), if ext.is_empty() { "wav" } else { &ext })
+}
+
+/// The media files in memory (the page's), or on disk in native tests.
+mod files {
+    #[cfg(target_arch = "wasm32")]
+    pub use prowave_playground::std::fs::{metadata, put, read};
+    #[cfg(not(target_arch = "wasm32"))]
+    pub use std::fs::{metadata, read};
+    #[cfg(not(target_arch = "wasm32"))]
+    pub fn put(path: &std::path::Path, bytes: Vec<u8>) {
+        if let Some(dir) = path.parent() {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        let _ = std::fs::write(path, bytes);
+    }
+}
+
+fn is_file(path: &Path) -> bool {
+    files::metadata(path).is_ok_and(|m| m.is_file())
+}
+
+/// Where the session keeps an asset.
+fn kept(asset: &str) -> PathBuf {
+    Path::new(ROOT).join("media").join(asset)
+}
+
+/// The document's media path for an audio file of the project: kept ones by their name; others by their content,
+/// copied in to where the session keeps them.
+fn media_path(source: &Path) -> String {
+    let under = |dir: &Path| source.strip_prefix(dir).ok().and_then(|p| p.to_str()).filter(|n| !n.contains('/')).map(str::to_owned);
+    if let Some(asset) = under(&Path::new(ROOT).join("media").join(MISSING)).or_else(|| under(&Path::new(ROOT).join("media"))) {
+        return format!("media/{asset}");
+    }
+    let len = files::metadata(source).map(|m| m.len()).unwrap_or(0);
+    let asset = ASSETS.with_borrow_mut(|known| {
+        known.get(&(source.to_path_buf(), len)).cloned().unwrap_or_else(|| {
+            let bytes = files::read(source).unwrap_or_default();
+            let asset = asset_of(&bytes, source.extension().and_then(|e| e.to_str()).unwrap_or(""));
+            if !is_file(&kept(&asset)) {
+                files::put(&kept(&asset), bytes);
+            }
+            known.insert((source.to_path_buf(), len), asset.clone());
+            asset
+        })
+    });
+    format!("media/{asset}")
+}
+
+/// One frame of silence, the stand-in for media not here yet.
+fn silence() -> Vec<u8> {
+    let mut wav = Vec::with_capacity(48);
+    wav.extend_from_slice(b"RIFF");
+    wav.extend_from_slice(&38u32.to_le_bytes());
+    wav.extend_from_slice(b"WAVEfmt ");
+    for v in [16u32, 0x0001_0001, 48_000, 96_000, 0x0010_0002] {
+        wav.extend_from_slice(&v.to_le_bytes());
+    }
+    wav.extend_from_slice(b"data");
+    wav.extend_from_slice(&2u32.to_le_bytes());
+    wav.extend_from_slice(&[0, 0]);
+    wav
+}
+
+/// The assets a document's regions play, once each.
+fn assets_in(doc: &ProjectDoc) -> Vec<String> {
+    let mut out: Vec<String> = doc.tracks.iter().flat_map(|t| &t.regions).filter_map(|r| asset_name(r.audio.as_deref()?)).map(str::to_owned).collect();
+    out.sort();
+    out.dedup();
+    out
+}
+
+// ---------------------------------------------------------------- the app
+
+/// The track and region ids as last seen (indexes of the project as of the last look).
+pub fn ids_now() -> Vec<(u64, Vec<u64>)> {
+    SEEN.with_borrow(|s| s.tracks.iter().map(|(id, _, r)| (*id, r.clone())).collect())
+}
+
+/// The project as the shared document.
+pub fn document_of(project: &Project) -> Value {
+    let (mut doc, media) = crate::project_io::to_doc(project);
+    let paths: HashMap<&str, String> = media.iter().map(|m| (m.zip_path.as_str(), media_path(&m.source))).collect();
+    for r in doc.tracks.iter_mut().flat_map(|t| &mut t.regions) {
+        if let Some(a) = r.audio.as_mut() {
+            *a = paths.get(a.as_str()).cloned().unwrap_or_default();
+        }
+    }
+    SEEN.with_borrow_mut(|seen| shape(&doc, seen))
+}
+
+#[cfg(target_arch = "wasm32")]
+fn context() -> egui::Context {
+    crate::web::ctx().unwrap_or_default()
+}
+#[cfg(not(target_arch = "wasm32"))]
+fn context() -> egui::Context {
+    egui::Context::default()
+}
+
+impl App {
+    /// Puts a shared document's project in place: no step of the undo history, this person's personal settings and
+    /// selection kept, the engine following. Media not here yet play silence until they arrive.
+    fn live_install(&mut self, document: &Value) -> Result<(), String> {
+        let mut doc = project_of(document)?;
+        let ids = ids_of(document);
+        for r in doc.tracks.iter_mut().flat_map(|t| &mut t.regions) {
+            let Some(asset) = r.audio.as_deref().and_then(asset_name).map(str::to_owned) else { continue };
+            if !is_file(&kept(&asset)) {
+                let stand_in = Path::new(ROOT).join("media").join(MISSING).join(&asset);
+                if !is_file(&stand_in) {
+                    files::put(&stand_in, silence());
+                }
+                r.audio = Some(format!("media/{MISSING}{asset}"));
+            }
+        }
+        let ctx = context();
+        let (mut p, _missing) = crate::project_io::from_doc(&doc, Path::new(ROOT), &ctx);
+        let old = &self.project;
+        // Waveform overviews already worked out stay (from_doc's are dropped unrun).
+        #[cfg(target_arch = "wasm32")]
+        prowave_playground::std::thread::forget_spawned();
+        let had: HashMap<PathBuf, &crate::model::AudioRegion> =
+            old.tracks.iter().flat_map(|t| &t.regions).filter_map(|r| r.audio.as_ref()).map(|a| (a.file.path.clone(), a)).collect();
+        for a in p.tracks.iter_mut().flat_map(|t| &mut t.regions).filter_map(|r| r.audio.as_mut()) {
+            match had.get(&a.file.path) {
+                Some(o) if o.file.frames == a.file.frames => *a = (*o).clone(),
+                _ => *a = crate::import::audio_region(a.file.clone(), &ctx),
+            }
+        }
+        let old_ids = ids_now();
+        let index = |id: u64| ids.iter().position(|(t, _)| *t == id);
+        for (t, (id, _)) in p.tracks.iter_mut().zip(&ids) {
+            if let Some(o) = old_ids.iter().position(|(o, _)| o == id).and_then(|i| old.tracks.get(i)) {
+                (t.height, t.folded, t.rec, t.monitor) = (o.height, o.folded, o.rec, o.monitor);
+            }
+        }
+        (p.position_beats, p.playing, p.recording) = (old.position_beats, old.playing, old.recording);
+        (p.cycle, p.cycle_start, p.cycle_end) = (old.cycle, old.cycle_start, old.cycle_end);
+        (p.metronome, p.count_in) = (old.metronome, old.count_in);
+        p.selected_track = old_ids.get(old.selected_track).and_then(|(id, _)| index(*id)).unwrap_or(old.selected_track).min(p.tracks.len().saturating_sub(1));
+        // The open region and its selected notes, by id and by value.
+        let region = |ids: &[(u64, Vec<u64>)], (t, r): (usize, usize)| ids.get(t).and_then(|(tid, rids)| Some((*tid, *rids.get(r)?)));
+        let shown = self.ui.tracks.selected.and_then(|at| Some((region(&old_ids, at)?, at)));
+        let notes = |p: &Project, (t, r): (usize, usize)| p.tracks.get(t).and_then(|t| t.regions.get(r)).map(|r| r.notes.clone()).unwrap_or_default();
+        let (old_notes, picked) = match shown {
+            Some((_, at)) => (notes(old, at), std::mem::take(&mut self.ui.piano.selected)),
+            None => (Vec::new(), Vec::new()),
+        };
+        self.ui.tracks.selected = shown.and_then(|((tid, rid), _)| {
+            let t = index(tid)?;
+            Some((t, ids[t].1.iter().position(|r| *r == rid)?))
+        });
+        if let Some(at) = self.ui.tracks.selected {
+            let new = notes(&p, at);
+            let same = |a: &crate::model::Note, b: &crate::model::Note| (a.start, a.len, a.pitch, a.vel) == (b.start, b.len, b.pitch, b.vel);
+            let mut taken = vec![false; new.len()];
+            for o in picked.iter().filter_map(|&i| old_notes.get(i)) {
+                if let Some(k) = (0..new.len()).find(|&k| !taken[k] && same(o, &new[k])) {
+                    taken[k] = true;
+                    self.ui.piano.selected.push(k);
+                }
+            }
+        }
+        p.song_rev = old.song_rev.wrapping_add(1);
+        self.project = p;
+        // The ids are the document's now, and new ones go past its numbered ones.
+        SEEN.with_borrow_mut(|seen| {
+            seen.tracks = doc
+                .tracks
+                .iter()
+                .map(neutral)
+                .zip(&ids)
+                .map(|(mut t, (id, rids))| {
+                    for r in &mut t.regions {
+                        if let Some(a) = r.audio.as_mut() {
+                            *a = a.replacen(&format!("media/{MISSING}"), "media/", 1);
+                        }
+                    }
+                    (*id, t, rids.clone())
+                })
+                .collect();
+            let top = ids.iter().flat_map(|(t, r)| std::iter::once(*t).chain(r.iter().copied())).filter(|id| *id < 1 << 52).max();
+            seen.next = seen.next.max(top.map_or(0, |id| id + 1));
+        });
+        Ok(())
+    }
+}
+
+thread_local! {
+    /// A pointer is down or text is being typed: nothing goes in or out until it ends.
+    static BUSY: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// Goes up on frames where the project may have changed (input, and a while after).
+    static GENERATION: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
+impl kit::Live for App {
+    fn live_document(&self) -> Value {
+        document_of(&self.project)
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        self.live_install(&document)
+    }
+
+    fn live_quiet(&self) -> bool {
+        !BUSY.get()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        // The song revision goes up with what changes without input (a file opened or imported a moment later).
+        Some(GENERATION.get() ^ self.project.song_rev.rotate_left(32))
+    }
+
+    fn live_disconnected(&mut self) {
+        self.history.reset(&self.project);
+    }
+
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let mut out: Vec<(String, String, bool)> = self
+            .project
+            .tracks
+            .iter()
+            .flat_map(|t| &t.regions)
+            .filter_map(|r| {
+                let a = r.audio.as_ref()?;
+                let asset = media_path(&a.file.path).strip_prefix("media/")?.to_owned();
+                let name = a.file.path.file_name()?.to_string_lossy().into_owned();
+                let have = is_file(&kept(&asset));
+                Some((asset, name, have))
+            })
+            .collect();
+        out.sort();
+        out.dedup_by(|a, b| a.0 == b.0);
+        out
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        project_of(document).map(|d| assets_in(&d)).unwrap_or_default()
+    }
+
+    fn live_read_asset(&self, id: &str) -> Option<Vec<u8>> {
+        is_asset(id).then_some(())?;
+        files::read(kept(id)).ok()
+    }
+
+    fn live_write_asset(&mut self, id: &str, _name: &str, bytes: Vec<u8>) {
+        let ext = id.rsplit('.').next().unwrap_or("");
+        if !is_asset(id) || asset_of(&bytes, ext) != id {
+            return;
+        }
+        files::put(&kept(id), bytes);
+        // The regions playing its stand-in play it now: the same document, put in again.
+        let document = document_of(&self.project);
+        let _ = self.live_install(&document);
+    }
+
+    fn live_presence(&self) -> Value {
+        #[cfg(target_arch = "wasm32")]
+        return peers::mine(self);
+        #[cfg(not(target_arch = "wasm32"))]
+        Value::Null
+    }
+
+    fn live_show_presence(&mut self, others: Vec<kit::Presence>) {
+        #[cfg(target_arch = "wasm32")]
+        peers::show(others);
+        #[cfg(not(target_arch = "wasm32"))]
+        drop(others);
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        merge(base, current, edited)
+    }
+
+    fn live_check(document: &Value) -> Result<(), String> {
+        project_of(document).map(drop)
+    }
+}
+
+// ---------------------------------------------------------------- the page
+
+/// The app eframe runs on the page, with the session's frame after the window's, and the adapter offered to the shell.
+#[cfg(target_arch = "wasm32")]
+pub fn wrap(web: crate::web::Web) -> Box<dyn eframe::App> {
+    let with_app = |f: &mut dyn FnMut(&mut App)| crate::web::runner().app_mut::<Shell>().map(|mut shell| f(&mut shell.web.app)).is_some();
+    if let Err(e) = kit::web::attach::<App>(&format(), with_app, crate::web::repaint) {
+        web_sys::console::warn_1(&format!("Pro Wave: no live editing: {e:?}").into());
+    }
+    Box::new(Shell { web, touched: 0 })
+}
+
+#[cfg(target_arch = "wasm32")]
+struct Shell {
+    web: crate::web::Web,
+    /// Frames left in which the project may still change after input.
+    touched: u32,
+}
+
+#[cfg(target_arch = "wasm32")]
+impl eframe::App for Shell {
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        eframe::App::raw_input_hook(&mut self.web, ctx, raw_input);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        let input = ui.input(|i| !i.events.is_empty() || i.pointer.any_down() || !i.raw.dropped_files.is_empty());
+        eframe::App::ui(&mut self.web, ui, frame);
+        let ctx = ui.ctx().clone();
+        BUSY.set(ctx.input(|i| i.pointer.any_down()) || ctx.egui_wants_keyboard_input());
+        // Changes come from input (and land within a few frames), or with a new song revision (live_generation).
+        self.touched = if input { 3 } else { self.touched.saturating_sub(1) };
+        if self.touched > 0 {
+            GENERATION.set(GENERATION.get().wrapping_add(1));
+        }
+        kit::frame(&mut self.web.app);
+        peers::overlay(ui, &self.web.app);
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
