# What it's for: take_theme_drops (files dropped on Preferences' Import tile) reads a dropped file with
# DroppedFile::bytes(), which egui only has off wasm (the browser reads files asynchronously), so the web build
# failed to compile. Off wasm the read is unchanged; on wasm it is an error, so a theme dropped on the tile reports
# it can't be read (Import's file picker and pasting a theme still work).
# Release has no such code (theme-drop-wasm.release.diff is empty); drop this once upstream gates or reads it
# through bytes_async on wasm.
--- a/crates/ui-egui/src/prefs.rs
+++ b/crates/ui-egui/src/prefs.rs
@@ -2737,8 +2737,11 @@
     }
     let files = ctx.input_mut(|i| std::mem::take(&mut i.raw.dropped_files));
     for f in files.iter().take(8) {
-        let text = f
-            .bytes()
+        #[cfg(not(target_arch = "wasm32"))]
+        let read = f.bytes();
+        #[cfg(target_arch = "wasm32")]
+        let read: Result<Vec<u8>, String> = Err("dropping a theme file isn't supported in the browser; use Import".into());
+        let text = read
             .and_then(|b| if b.len() > crate::theme_files::MAX_BYTES { Err("the file is too large for a theme".into()) } else { Ok(b) })
             .and_then(|b| String::from_utf8(b).map_err(|_| "not a theme file".to_string()));
         import_theme_text(app, text);
