# Theme files dropped on Preferences' Import tile compile for the browser (head only: the release has no such code).
# What it's for: take_theme_drops reads a dropped file with DroppedFile::bytes(), which egui only has off the web
#   (there it is the async bytes_async), so the wasm build failed with "no method named `bytes`".
# How: on wasm the read is an error the app shows as the import's status ("Theme import: ..."), as for any
#   unreadable file; Import's file picker and pasted themes still work. Native builds read as before.
# Verify: node scripts/build.mjs check fusion-360 head compiles.
# If upstream changes: re-fit to take_theme_drops; write this empty once it reads through bytes_async on wasm.
--- a/crates/ui-egui/src/prefs.rs
+++ b/crates/ui-egui/src/prefs.rs
@@ -2735,8 +2735,10 @@
     let files = ctx.input_mut(|i| std::mem::take(&mut i.raw.dropped_files));
     for f in files.iter().take(8) {
-        let text = f
-            .bytes()
+        #[cfg(target_arch = "wasm32")]
+        let bytes: Result<Vec<u8>, String> = Err("dropped theme files can't be read in the browser; use Import".to_string());
+        #[cfg(not(target_arch = "wasm32"))]
+        let bytes = f.bytes();
+        let text = bytes
             .and_then(|b| if b.len() > crate::theme_files::MAX_BYTES { Err("the file is too large for a theme".into()) } else { Ok(b) })
             .and_then(|b| String::from_utf8(b).map_err(|_| "not a theme file".to_string()));
         import_theme_text(app, text);
