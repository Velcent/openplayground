+//! Live editing in a Playground session (`playground_live` drives it). The shared document is a design's parametric
+//! feature tree (`Session::doc`); every peer evaluates the bodies from it. The shared design is the one active when the
+//! session started, marked ([`mark`]) so it is followed wherever its tab goes; while another design is active, or after
+//! it closed, the session keeps its last state and remote changes wait for it. This person's own state stays out: the
+//! camera, selection and tools (outside the document anyway), what is hidden, each sketch's Sketch Palette options and
+//! the timeline position Edit Sketch rolled to. Each peer numbers new features, components and occurrences on from a
+//! point of its own ([`jump`]), and keeps its own `next_id`.
+//!
+//! Presence: the scope (active component and sketch), the pointer as a point in the model and the selection; the others'
+//! show over the shared design's viewport in their colors, a pointer with their name and an outline around each item
+//! they selected.
+
+#[path = "playground_live.rs"]
+pub mod playground_live;
+
+use std::cell::{Cell, OnceCell, RefCell};
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Arc;
+
+use egui::{Color32, FontId, Rect, Shape, Stroke, StrokeKind, vec2};
+use serde_json::{Map, Value, json};
+use solidcraft_engine::doc::{Document, FeatureKind};
+use solidcraft_engine::geom::{Aabb3, Vec3};
+use solidcraft_engine::{Sel, Session};
+use solidcraft_ui_egui::viewport::{self, Hit, Proj};
+use solidcraft_ui_egui::{SolveApp, documents};
+
+use playground_live::{Live, Presence, canonical};
+
+thread_local! {
+    /// This frame's pointer is down or text is being typed (`live_quiet` has no context to ask).
+    static INPUT_BUSY: Cell<bool> = const { Cell::new(false) };
+    /// The shared design's mark ([`marker`]).
+    static SHARED: Cell<Option<usize>> = const { Cell::new(None) };
+    /// The active design is the shared one (or none is yet): Undo and Redo go to the session.
+    static ON_SHARED: Cell<bool> = const { Cell::new(true) };
+    /// The shared document as last reported or adopted: what is reported while the shared design is not active.
+    static LAST: RefCell<Option<Value>> = const { RefCell::new(None) };
+    /// Remote changes that came while the shared design was not active: it takes them when it is again.
+    static PENDING: RefCell<Option<(usize, Value)>> = const { RefCell::new(None) };
+    /// Remote changes kept for later, counted (the generation).
+    static KEPT: Cell<u64> = const { Cell::new(0) };
+    /// The session ended while the shared design was not active: its Undo history goes when it is.
+    static FORGET: Cell<Option<usize>> = const { Cell::new(None) };
+    /// The shared design's next id as this person last left it: another value means an id was taken since.
+    static NEXT: Cell<Option<u64>> = const { Cell::new(None) };
+    /// The others in the session.
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+}
+
+const FORMAT: &str = concat!("fusion-360:1:", env!("CARGO_PKG_VERSION"));
+
+/// Marks the shared design's session: a do-nothing callback in `open_preview`, which only `doc.open` reads (and takes,
+/// as the design it was in is replaced). Its address names the design wherever its tab goes; closing or replacing the
+/// design drops it.
+fn mark(s: &mut Session) -> Option<usize> {
+    // A captured byte: the box is an allocation of its own, so each mark has its own address.
+    let token = 0u8;
+    s.open_preview = Some(Box::new(move |_| {
+        std::hint::black_box(token);
+    }));
+    marker(s)
+}
+
+fn marker(s: &Session) -> Option<usize> {
+    s.open_preview.as_deref().map(|f| f as *const _ as *const () as usize)
+}
+
+fn on_shared(app: &SolveApp) -> bool {
+    SHARED.get().is_none_or(|m| marker(&app.session) == Some(m))
+}
+
+fn pending_for(app: &SolveApp) -> bool {
+    PENDING.with_borrow(|p| p.as_ref().is_some_and(|(m, _)| marker(&app.session) == Some(*m)))
+}
+
+/// The end of each frame.
+pub fn frame(app: &mut SolveApp, ctx: &egui::Context) {
+    CTX.with(|c| {
+        c.get_or_init(|| ctx.clone());
+    });
+    INPUT_BUSY.set(ctx.input(|i| i.pointer.any_down()) || ctx.text_edit_focused());
+    if FORGET.get().is_some() && FORGET.get() == marker(&app.session) {
+        FORGET.set(None);
+        forget(&mut app.session);
+    }
+    if pending_for(app)
+        && app.live_quiet()
+        && let Some((_, document)) = PENDING.take()
+        && let Err(e) = install(app, document)
+    {
+        log::warn!("live editing: {e}");
+    }
+    ON_SHARED.set(on_shared(app));
+    playground_live::frame(app);
+    // An id was taken: the next one comes from further on.
+    if playground_live::connected() && SHARED.get().is_some() && on_shared(app) {
+        let next = app.session.doc.next_id;
+        if NEXT.get().is_some_and(|n| n != next) {
+            jump(&mut app.session.doc_mut().next_id);
+        } else {
+            NEXT.set(Some(next));
+        }
+    } else {
+        NEXT.set(None);
+    }
+    draw(app, ctx);
+}
+
+/// While connected, the shared design's next id moves on by a random step after each id taken and each remote change,
+/// so two people adding at once number from different points (one person's ids stay below their next id).
+// ponytail: up to 2^28 per step, 2^24 steps before ids pass MAX_FEATURE_ID (2^52); a per-peer id range if that matters.
+fn jump(next: &mut u64) {
+    *next = next.saturating_add(1 + (playground_live::fresh_id(&mut 0) & ((1 << 28) - 1)));
+    NEXT.set(Some(*next));
+}
+
+/// The session's end, for the shared design: its Undo history goes (it holds others' edits) and so does the mark.
+fn forget(s: &mut Session) {
+    s.undo.clear();
+    s.redo.clear();
+    s.open_preview = None;
+}
+
+/// Undo and Redo of the shared design go to the session (`SolveApp::run`, before anything else).
+fn undo(id: &str) -> bool {
+    matches!(id, "edit.undo" | "edit.redo") && ON_SHARED.get() && playground_live::undo(id == "edit.redo")
+}
+
+#[cfg(target_arch = "wasm32")]
+thread_local! {
+    static RUNNER: OnceCell<eframe::WebRunner> = const { OnceCell::new() };
+}
+
+/// The page's web runner, kept so the session reaches the app between frames.
+#[cfg(target_arch = "wasm32")]
+pub fn runner() -> eframe::WebRunner {
+    RUNNER.with(|r| r.get_or_init(eframe::WebRunner::new).clone())
+}
+
+/// The app eframe runs: `shell`, whose design `app` gives, then the session's end-of-frame hook. Offers live editing
+/// to the Playground shell.
+#[cfg(target_arch = "wasm32")]
+pub fn wrap<S: eframe::App + 'static>(app: fn(&mut S) -> &mut SolveApp, shell: S) -> Box<dyn eframe::App> {
+    let _ = solidcraft_ui_egui::LIVE_UNDO.set(undo);
+    let with_app = move |f: &mut dyn FnMut(&mut SolveApp)| {
+        RUNNER.with(|r| r.get().and_then(|r| r.app_mut::<S>()).map(|mut s| f(app(&mut s))).is_some())
+    };
+    let repaint = || CTX.with(|c| c.get().map_or((), egui::Context::request_repaint));
+    if let Err(e) = playground_live::web::attach::<SolveApp>(FORMAT, with_app, repaint) {
+        log::warn!("live editing: {e:?}");
+    }
+    Box::new(Wrapped(shell, app))
+}
+
+#[cfg(target_arch = "wasm32")]
+struct Wrapped<S>(S, fn(&mut S) -> &mut SolveApp);
+
+#[cfg(target_arch = "wasm32")]
+impl<S: eframe::App + 'static> eframe::App for Wrapped<S> {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.0.logic(ctx, frame);
+    }
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.0.ui(ui, frame);
+        let ctx = ui.ctx().clone();
+        crate::live::frame((self.1)(&mut self.0), &ctx);
+    }
+    /// The shell itself, which the session reaches through the runner.
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(&mut self.0)
+    }
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.0.save(storage);
+    }
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.0.auto_save_interval()
+    }
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.0.clear_color(visuals)
+    }
+    fn persist_egui_memory(&self) -> bool {
+        self.0.persist_egui_memory()
+    }
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.0.raw_input_hook(ctx, raw_input);
+    }
+}
+
+impl Live for SolveApp {
+    fn live_document(&self) -> Value {
+        if (!on_shared(self) || pending_for(self))
+            && let Some(last) = LAST.with_borrow(Clone::clone)
+        {
+            return last;
+        }
+        let mut v = project(&self.session.doc);
+        // Edit Sketch rolls the timeline for the person editing only.
+        if let (Some(marker), Some(o)) = (self.pre_sketch_marker, v.as_object_mut()) {
+            match marker {
+                Some(m) => drop(o.insert("marker".into(), m.into())),
+                None => drop(o.remove("marker")),
+            }
+        }
+        if SHARED.get().is_some() {
+            LAST.set(Some(v.clone()));
+        }
+        v
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        if SHARED.get().is_none() {
+            // A joiner's own design stays theirs: the session's opens in a tab of its own, unless the active design
+            // is blank or is the session's already (the owner's).
+            if !documents::active_is_blank(self) && canonical(&self.live_document()) != canonical(&document) {
+                documents::open_tab(self, Session::default())?;
+            }
+            FORGET.set(None);
+            SHARED.set(mark(&mut self.session));
+        }
+        if on_shared(self) {
+            PENDING.take();
+            install(self, document.clone())?;
+        } else {
+            design(document.clone())?;
+            PENDING.set(SHARED.get().map(|m| (m, document.clone())));
+            KEPT.set(KEPT.get() + 1);
+        }
+        LAST.set(Some(document));
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        !INPUT_BUSY.get()
+            && self.dialog.is_none()
+            && self.params.is_none()
+            && self.applying.is_none()
+            && self.tool.as_ref().is_none_or(|t| t.pts.is_empty() && t.picks.is_empty())
+            && self.viewport.point_drag.is_none()
+            && !self.file_load.busy()
+            && !self.file_picker_busy()
+            && !self.session.model.is_stale()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::hash::DefaultHasher::new();
+        let s = &self.session;
+        (marker(s), s.revision, Arc::as_ptr(&s.doc) as usize, self.pre_sketch_marker, KEPT.get()).hash(&mut h);
+        Some(h.finish())
+    }
+
+    fn live_disconnected(&mut self) {
+        if let Some(m) = SHARED.take() {
+            if marker(&self.session) == Some(m) {
+                forget(&mut self.session);
+            } else {
+                FORGET.set(Some(m));
+            }
+        }
+        LAST.set(None);
+        ON_SHARED.set(true);
+        NEXT.set(None);
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        let (mut base, mut current, mut edited) = (base.clone(), current.clone(), edited.clone());
+        take_counters(&mut base);
+        // Sketch ids count up per prefix: the larger of each side's, so concurrent drawing and Undo reuse none.
+        let mut counters = take_counters(&mut current);
+        for (id, theirs) in take_counters(&mut edited) {
+            let mine = counters.entry(id).or_default();
+            for (prefix, n) in theirs {
+                if n.as_u64() > mine.get(&prefix).and_then(Value::as_u64) {
+                    mine.insert(prefix, n);
+                }
+            }
+        }
+        let mut merged = playground_live::merge(&base, &current, &edited, Self::COUNTERS)?;
+        for f in items(&mut merged, "features") {
+            let id = f.get("id").and_then(Value::as_u64).unwrap_or_default();
+            if let Some(s) = f.get_mut("sketch").and_then(Value::as_object_mut) {
+                s.insert("counters".into(), Value::Object(counters.remove(&id).unwrap_or_default()));
+            }
+        }
+        // Both sides adding a Box (Box1, d1…) merge as two features with one name.
+        let before: BTreeSet<_> = named_twice(&current).union(&named_twice(&edited)).cloned().collect();
+        if let Some(name) = named_twice(&merged).difference(&before).next() {
+            return Err(format!("Conflict: two {name}"));
+        }
+        Ok(merged)
+    }
+
+    /// The design opens, and as it is: one that reading repairs (a component left without an occurrence gets one,
+    /// with a new id) would come out differently on every peer.
+    fn live_check(document: &Value) -> Result<(), String> {
+        if canonical(&project(&design(document.clone())?)) != canonical(document) {
+            return Err("Conflict: the merged design needs repairs".into());
+        }
+        Ok(())
+    }
+
+    /// The scope (active component and sketch), the pointer as a point in the model while it is over the viewport, and
+    /// the selection (up to 3 KB of it).
+    fn live_presence(&self) -> Value {
+        if SHARED.get().is_none() || !on_shared(self) {
+            return Value::Null;
+        }
+        let s = &self.session;
+        let mut room = 3000usize;
+        let selection: Vec<Value> = s
+            .selection
+            .iter()
+            .filter_map(|x| serde_json::to_value(x).ok())
+            .take_while(|v| {
+                room = room.saturating_sub(v.to_string().len());
+                room > 0
+            })
+            .take(50)
+            .collect();
+        let mut p = json!({"component": s.active_component, "sketch": s.active_sketch, "selection": selection});
+        if let Some(at) = pointer(self) {
+            p["pointer"] = json!([at.x, at.y, at.z]);
+        }
+        p
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+}
+
+/// The model point under the pointer: where the pointer's ray meets what it is over, or else the point of the ray
+/// nearest the view's target. `None` while the pointer is not over the viewport.
+fn pointer(app: &SolveApp) -> Option<Vec3> {
+    let v = &app.viewport;
+    let (rect, mouse) = (v.rect?, v.mouse?);
+    let at = match &v.hover {
+        Some(Hit::Face { point, .. } | Hit::Vertex { point, .. } | Hit::Plane { point, .. }) => *point,
+        _ => {
+            let proj = viewport::projection(app, rect);
+            let (o, d) = proj.ray(mouse);
+            o + d * ((proj.cam.target - o).dot(d) / d.len2())
+        }
+    };
+    at.is_finite().then_some(at)
+}
+
+/// The others' pointers (an arrow with their name) and selections (an outline around each item's bounds, as the app
+/// bounds its own selection), in their colors, over the shared design's viewport. Their data come from other people:
+/// whatever does not resolve is skipped.
+fn draw(app: &mut SolveApp, ctx: &egui::Context) {
+    let others = OTHERS.take();
+    if let Some(rect) = app.viewport.rect.filter(|_| !others.is_empty() && SHARED.get().is_some() && on_shared(app)) {
+        let proj = viewport::projection(app, rect);
+        // Over the viewport (the root layer, after everything the app drew there), under dialogs and menus.
+        let painter = ctx.layer_painter(egui::LayerId::background()).with_clip_rect(rect);
+        let own = std::mem::take(&mut app.session.selection);
+        for o in &others {
+            let color = Color32::from_rgb(o.color[0], o.color[1], o.color[2]);
+            for sel in o.state["selection"].as_array().into_iter().flatten().take(50) {
+                let Ok(sel) = serde_json::from_value::<Sel>(sel.clone()) else { continue };
+                app.session.selection = vec![sel];
+                if let Some(r) = viewport::selection_bounds(app).and_then(|b| screen_rect(&proj, &b)) {
+                    painter.rect_stroke(r.expand(3.0), 3.0, Stroke::new(2.0, color), StrokeKind::Outside);
+                }
+            }
+            let at: Option<Vec<f64>> = o.state["pointer"].as_array().and_then(|p| p.iter().map(Value::as_f64).collect());
+            if let Some(&[x, y, z]) = at.as_deref()
+                && let Some(p) = proj.to_screen(Vec3::new(x, y, z)).filter(|p| rect.expand(100.0).contains(*p))
+            {
+                painter.add(Shape::convex_polygon(vec![p, p + vec2(0.0, 17.0), p + vec2(12.0, 12.0)], color, Stroke::new(1.0, Color32::WHITE)));
+                let name: String = o.name.chars().take(40).collect();
+                let text = painter.layout_no_wrap(name, FontId::proportional(12.0), Color32::WHITE);
+                let tag = Rect::from_min_size(p + vec2(12.0, 14.0), text.size() + vec2(8.0, 4.0));
+                painter.rect_filled(tag, 3.0, color);
+                painter.galley(tag.min + vec2(4.0, 2.0), text, Color32::WHITE);
+            }
+        }
+        app.session.selection = own;
+    }
+    OTHERS.set(others);
+}
+
+/// A model box's outline on the screen (none behind the eye, or absurdly large).
+fn screen_rect(proj: &Proj, b: &Aabb3) -> Option<Rect> {
+    let mut r = Rect::NOTHING;
+    for i in 0..8 {
+        let pick = |bit: i32, lo: f64, hi: f64| if i & bit == 0 { lo } else { hi };
+        r.extend_with(proj.to_screen(Vec3::new(pick(1, b.min.x, b.max.x), pick(2, b.min.y, b.max.y), pick(4, b.min.z, b.max.z)))?);
+    }
+    (r.is_finite() && r.width() < 1e5 && r.height() < 1e5).then_some(r)
+}
+
+/// Installs the shared document in the active design, keeping this person's views; no undo step.
+fn install(app: &mut SolveApp, document: Value) -> Result<(), String> {
+    let mut doc = design(document)?;
+    let local = &app.session.doc;
+    doc.next_id = doc.next_id.max(local.next_id);
+    for f in &mut doc.features {
+        if let FeatureKind::Sketch { sketch, .. } = &mut f.kind {
+            sketch.view = local.sketch(f.id).map(|s| s.view.clone()).unwrap_or_default();
+        }
+    }
+    if let Some(marker) = &mut app.pre_sketch_marker {
+        *marker = std::mem::replace(&mut doc.marker, local.marker);
+    }
+    // The same design (the owner adopting its own): nothing to do.
+    if doc == **local {
+        return Ok(());
+    }
+    if playground_live::connected() {
+        jump(&mut doc.next_id);
+    }
+    app.session.doc = Arc::new(doc);
+    app.session.refresh();
+    Ok(())
+}
+
+/// A design as shared: without each peer's next id and what is hidden, sketches without their display options, and
+/// parameters keyed by name (so they merge one by one).
+fn project(doc: &Document) -> Value {
+    let mut v = serde_json::to_value(doc).unwrap_or_default();
+    if let Some(o) = v.as_object_mut() {
+        o.remove("next_id");
+        o.remove("visibility");
+    }
+    for p in items(&mut v, "params") {
+        if let Some(name) = p.get("name").cloned() {
+            p["id"] = name;
+        }
+    }
+    for f in items(&mut v, "features") {
+        if let Some(s) = f.get_mut("sketch").and_then(Value::as_object_mut) {
+            s.remove("view");
+        }
+    }
+    v
+}
+
+fn items<'a>(v: &'a mut Value, key: &'static str) -> impl Iterator<Item = &'a mut Value> {
+    v.get_mut(key).and_then(Value::as_array_mut).into_iter().flatten()
+}
+
+fn take_counters(doc: &mut Value) -> BTreeMap<u64, Map<String, Value>> {
+    let mut out = BTreeMap::new();
+    for f in items(doc, "features") {
+        let id = f.get("id").and_then(Value::as_u64).unwrap_or_default();
+        if let Some(Value::Object(n)) = f.get_mut("sketch").and_then(Value::as_object_mut).and_then(|s| s.remove("counters")) {
+            out.insert(id, n);
+        }
+    }
+    out
+}
+
+/// Feature names and parameter names (user parameters and feature inputs) given twice.
+fn named_twice(doc: &Value) -> BTreeSet<String> {
+    let list = |v: &Value, key: &str| v.get(key).and_then(Value::as_array).cloned().unwrap_or_default();
+    let features = list(doc, "features");
+    let names = features.iter().filter_map(|f| f.get("name")?.as_str()).map(|n| format!("features named {n}"));
+    let inputs = features.iter().flat_map(|f| list(f, "param_names"));
+    let params = list(doc, "params").into_iter().filter_map(|p| p.get("name").cloned()).chain(inputs);
+    let params: Vec<_> = params.filter_map(|n| n.as_str().filter(|n| !n.is_empty()).map(|n| format!("parameters named {n}"))).collect();
+    let mut seen = BTreeSet::new();
+    names.chain(params).filter(|n| !seen.insert(n.clone())).collect()
+}
+
+/// The shared document as a design, checked and upgraded as a design file is.
+fn design(mut document: Value) -> Result<Document, String> {
+    for p in items(&mut document, "params") {
+        if let Some(p) = p.as_object_mut() {
+            p.remove("id");
+        }
+    }
+    Document::from_json(&document.to_string()).map_err(|e| e.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use playground_live::{checkpoint, connect, queue};
+    use solidcraft_ui_egui::Services;
+
+    fn app() -> SolveApp {
+        let mut app = SolveApp::new(Session::default(), Services::default());
+        app.run("sketch.create", json!({"plane": "XY"})).unwrap();
+        app.run("sketch.line", json!({"points": [[0, 0], [10, 0]]})).unwrap();
+        app.finish_sketch();
+        app
+    }
+
+    /// The app under test, its active design shared (as the owner's is).
+    fn bound() -> SolveApp {
+        let mut a = app();
+        let doc = a.live_document();
+        a.live_adopt(doc).unwrap();
+        a
+    }
+
+    /// Another peer: a design holding `document`, changed by `cmd`.
+    fn peer(document: &[u8], cmd: &str, p: Value) -> Vec<u8> {
+        let mut x = app();
+        install(&mut x, serde_json::from_slice(document).unwrap()).unwrap();
+        x.run(cmd, p).unwrap();
+        canonical(&project(&x.session.doc))
+    }
+
+    fn shared(app: &SolveApp) -> Vec<u8> {
+        canonical(&app.live_document())
+    }
+
+    const BOX: (&str, fn() -> Value) = ("solid.box", || json!({"length": "10", "width": "10", "height": "10"}));
+
+    #[test]
+    fn the_shared_design_leaves_out_views_and_adopting_one_keeps_them_without_an_undo_step() {
+        let mut a = bound();
+        let before = shared(&a);
+        let doc = a.live_document();
+        assert!(doc.get("next_id").is_none() && doc["features"][0]["sketch"].get("view").is_none());
+        // Views: the camera and a sketch's display options; below, Edit Sketch's rolled timeline.
+        a.cam.target.x += 5.0;
+        let sketch = a.session.doc.features[0].id;
+        a.session.doc_mut().sketch_mut(sketch).unwrap().view.hide_grid = true;
+        assert_eq!(shared(&a), before);
+        a.run(BOX.0, BOX.1()).unwrap();
+        a.edit_sketch(sketch);
+        assert_ne!(a.session.doc.marker, None, "Edit Sketch rolled the timeline");
+        let with_box = shared(&a);
+        assert_eq!(serde_json::from_slice::<Value>(&with_box).unwrap()["marker"], Value::Null, "the roll is this person's");
+        a.finish_sketch();
+        assert_eq!(shared(&a), with_box);
+        assert_ne!(with_box, before);
+
+        // Someone else's design: a cylinder added; adopting it keeps a's views, is no undo step and reads back the same.
+        let theirs = peer(&with_box, "solid.cylinder", json!({"radius": "5", "height": "10"}));
+        let undo = a.session.undo.len();
+        a.live_adopt(serde_json::from_slice(&theirs).unwrap()).unwrap();
+        assert_eq!(a.session.undo.len(), undo);
+        assert!(a.session.doc.sketch(sketch).unwrap().view.hide_grid);
+        assert_eq!(a.session.doc.features.len(), 3);
+        assert!(a.session.doc.next_id > a.session.doc.features.iter().map(|f| f.id).max().unwrap());
+        assert_eq!(shared(&a), theirs);
+    }
+
+    #[test]
+    fn merges_refuse_twice_given_names_and_designs_that_need_repairs_and_sketch_counters_take_the_larger() {
+        let base = canonical(&project(&app().session.doc));
+        let one: Value = serde_json::from_slice(&peer(&base, BOX.0, BOX.1())).unwrap();
+        let mut two: Value = serde_json::from_slice(&peer(&base, BOX.0, json!({"length": "20", "width": "20", "height": "20"}))).unwrap();
+        let base: Value = serde_json::from_slice(&base).unwrap();
+        // Ids apart, as two people's are while connected.
+        two["features"][1]["id"] = json!(1u64 << 40);
+        let error = SolveApp::live_merge(&base, &one, &two).unwrap_err();
+        assert!(error.contains("two features named Box1"), "{error}");
+        // Each side drew a line in the sketch: counters take the larger.
+        let line = |n: u64| {
+            let mut d = base.clone();
+            d["features"][0]["sketch"]["counters"]["l"] = json!(n);
+            d
+        };
+        let merged = SolveApp::live_merge(&line(1), &line(3), &line(2)).unwrap();
+        assert_eq!(merged["features"][0]["sketch"]["counters"]["l"], 3);
+        // A component left without an occurrence would get a new random one on each peer that reads it.
+        let mut x = app();
+        x.run("component.create", json!({})).unwrap();
+        let with: Value = project(&x.session.doc);
+        let mut without = with.clone();
+        without.as_object_mut().unwrap().remove("occurrences");
+        assert!(SolveApp::live_check(&with).is_ok());
+        let error = SolveApp::live_check(&without).unwrap_err();
+        assert!(error.contains("repairs"), "{error}");
+        assert!(SolveApp::live_check(&Value::Null).is_err());
+    }
+
+    #[test]
+    fn a_remote_change_waits_while_a_dialog_is_open_and_ids_move_on_after_it_and_after_each_taken() {
+        let mut a = bound();
+        connect();
+        let ctx = egui::Context::default();
+        frame(&mut a, &ctx);
+        let base = shared(&a);
+        let theirs = peer(&base, BOX.0, BOX.1());
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        queue(Some(base), theirs.clone(), Box::new(move |r| to.set(r.is_ok())));
+        a.start("solid.sphere");
+        assert!(a.dialog.is_some());
+        frame(&mut a, &ctx);
+        assert!(!done.get() && checkpoint(&a).is_err(), "a busy app waits");
+        a.dialog = None;
+        frame(&mut a, &ctx);
+        assert!(done.get());
+        assert_eq!(shared(&a), theirs);
+        // Their box took the id after the sketch's; this person's next one is further on, and so after taking one.
+        let last = |a: &SolveApp| a.session.doc.features.iter().map(|f| f.id).max().unwrap();
+        assert!(a.session.doc.next_id > last(&a) + 1);
+        a.run("solid.cylinder", json!({"radius": "5", "height": "10"})).unwrap();
+        frame(&mut a, &ctx);
+        assert!(a.session.doc.next_id > last(&a) + 1);
+    }
+
+    #[test]
+    fn the_shared_design_is_followed_wherever_its_tab_goes_and_outlives_it() {
+        let mut a = app();
+        // The session starts on the second of two designs.
+        documents::new_design(&mut a);
+        let doc = a.live_document();
+        a.live_adopt(doc).unwrap();
+        connect();
+        let ctx = egui::Context::default();
+        frame(&mut a, &ctx);
+        let base = shared(&a);
+        // On the other design: the session keeps the shared one, and Undo there is that design's own.
+        documents::switch(&mut a, 0);
+        frame(&mut a, &ctx);
+        assert_eq!(shared(&a), base);
+        assert!(!undo("edit.undo"));
+        // A remote change waits for the shared design, not the open one.
+        let theirs = peer(&base, BOX.0, BOX.1());
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        queue(Some(base), theirs.clone(), Box::new(move |r| to.set(r.is_ok())));
+        frame(&mut a, &ctx);
+        assert!(done.get());
+        assert_eq!(shared(&a), theirs);
+        assert_eq!(a.session.doc.features.len(), 1, "the open design keeps its sketch alone");
+        // The other design closes, so the shared one's tab moves from 1 to 0; it takes the change.
+        documents::close(&mut a, 0, true);
+        assert_eq!(a.docs.active, 0);
+        frame(&mut a, &ctx);
+        assert_eq!(canonical(&project(&a.session.doc)), theirs);
+        assert!(undo("edit.undo"));
+        // A new design opens next to it, then it closes, then the last one does (a blank design takes its place):
+        // the session keeps the shared design as it was, never another one.
+        documents::new_design(&mut a);
+        frame(&mut a, &ctx);
+        assert_eq!(shared(&a), theirs);
+        documents::switch(&mut a, 0);
+        for _ in 0..2 {
+            documents::close(&mut a, 0, true);
+            frame(&mut a, &ctx);
+            assert_eq!(shared(&a), theirs);
+        }
+        assert!(a.session.doc.features.is_empty() && !undo("edit.undo"));
+    }
+
+    #[test]
+    fn presence_gives_the_pointer_as_a_model_point_on_its_ray_and_the_selection() {
+        let mut a = bound();
+        a.run(BOX.0, BOX.1()).unwrap();
+        let body = a.session.world_state().bodies[0].name.clone();
+        a.session.selection = vec![Sel::Body { name: body }];
+        let rect = Rect::from_min_size(egui::Pos2::ZERO, vec2(800.0, 600.0));
+        (a.viewport.rect, a.viewport.mouse, a.viewport.hover) = (Some(rect), None, None);
+        assert!(a.live_presence().get("pointer").is_none(), "no pointer off the viewport");
+        let mouse = egui::pos2(300.0, 200.0);
+        a.viewport.mouse = Some(mouse);
+        let p = a.live_presence();
+        let at: Vec<f64> = serde_json::from_value(p["pointer"].clone()).unwrap();
+        let shown = viewport::projection(&a, rect).to_screen(Vec3::new(at[0], at[1], at[2])).unwrap();
+        assert!((shown - mouse).length() < 0.5, "{shown:?}");
+        assert_eq!(serde_json::from_value::<Vec<Sel>>(p["selection"].clone()).unwrap(), a.session.selection);
+        assert_eq!(p["component"], 0);
+    }
+}
