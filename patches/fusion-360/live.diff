+        disconnect();
+
+        // The others' marks ease toward where they are; a jump wider than a quarter of the view goes at once.
+        let mut shown = json!({ "pointer": [0.0, 0.0, 0.0] });
+        assert!(ease(&mut shown, json!({ "pointer": [10.0, 0.0, 0.0] }), 0.5, 0.01, 20.0));
+        assert_eq!(shown["pointer"], json!([5.0, 0.0, 0.0]));
+        assert!(!ease(&mut shown, json!({ "pointer": [100.0, 0.0, 0.0] }), 0.5, 0.01, 20.0));
+        assert_eq!(shown["pointer"], json!([100.0, 0.0, 0.0]));
+    }
+}
