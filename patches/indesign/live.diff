+//! Live editing in a Playground session: the page's runner, kept for the session to reach the app, and the app eframe
+//! runs: [`WebShell`], then the session's end-of-frame hook.
+
+use super::WebShell;
+use crate::live::{self, playground_live};
+use designcraft_ui_egui::DesignApp;
+use std::cell::OnceCell;
+
+thread_local! {
+    static RUNNER: OnceCell<eframe::WebRunner> = const { OnceCell::new() };
+}
+
+/// A new web runner, kept for [`wrap`].
+pub(super) fn runner() -> eframe::WebRunner {
+    let runner = eframe::WebRunner::new();
+    RUNNER.with(|kept| kept.get_or_init(|| runner.clone()).clone())
+}
+
+/// The app eframe runs: `shell`, offered to the page for live editing.
+pub(super) fn wrap(shell: WebShell) -> Box<dyn eframe::App> {
+    let _ = designcraft_engine::doc::FRESH_ID.set(live::fresh_id);
+    let _ = designcraft_ui_egui::canvas::live::UNDO.set(playground_live::undo);
+    let with_app = |f: &mut dyn FnMut(&mut DesignApp)| {
+        RUNNER.with(|runner| runner.get().and_then(|r| r.app_mut::<WebShell>()).map(|mut shell| f(&mut shell.app)).is_some())
+    };
+    if let Err(e) = playground_live::web::attach::<DesignApp>(live::FORMAT, with_app, live::repaint) {
+        log::error!("live editing unavailable: {e:?}");
+    }
+    Box::new(Live(shell))
+}
+
+struct Live(WebShell);
+
+impl eframe::App for Live {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.0.logic(ctx, frame);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.0.ui(ui, frame);
+        live::frame(&mut self.0.app, ui.ctx());
+    }
+
+    /// The shell itself, which the web entry and the session reach through the runner.
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(&mut self.0)
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.0.save(storage);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.0.auto_save_interval()
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.0.clear_color(visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        self.0.persist_egui_memory()
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.0.raw_input_hook(ctx, raw_input);
+    }
+}
