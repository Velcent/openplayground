+//! Live editing in a Playground session (used by the web app only): the shared document's uid, Undo's hand-off to the
+//! session, and presence. This person's presence is the spread under their pointer (or at their view's centre) by id,
+//! the pointer in that spread's coordinates while it is over the canvas, and the selected frames' ids; the others'
+//! are drawn on the canvas in their color: a pointer arrow with their name, and outlines around their selection.
+
+use super::{Xf, current_slot, item_canvas_xf, path_screen};
+use crate::DesignApp;
+use designcraft_doc::{Document, ItemId};
+use designcraft_geom::Point;
+use designcraft_tools::CanvasLayout;
+use egui::{Color32, FontId, Pos2, Rect, Shape, Stroke, StrokeKind, vec2};
+use serde_json::{Value, json};
+use std::cell::{Cell, RefCell};
+use std::sync::OnceLock;
+
+thread_local! {
+    /// The shared document's `uid`, bound by the web app's adapter while a session is connected.
+    pub static SHARED: Cell<Option<u64>> = const { Cell::new(None) };
+    /// The others in the session: name, color and the state their [`presence`] gave.
+    static OTHERS: RefCell<Vec<(String, [u8; 3], Value)>> = const { RefCell::new(Vec::new()) };
+    /// This person's pointer over the canvas (spread id, point in that spread): seen this frame, and in the last one.
+    static POINTER: Cell<[Option<(u64, [f64; 2])>; 2]> = const { Cell::new([None; 2]) };
+}
+
+/// Passes Undo (false) or Redo (true) to the session: whether it took it. Set by the web app.
+pub static UNDO: OnceLock<fn(bool) -> bool> = OnceLock::new();
+
+fn shared_active(app: &DesignApp) -> bool {
+    app.session.active().is_some_and(|d| SHARED.get() == Some(d.uid))
+}
+
+/// [`DesignApp::run`]'s first step: Undo and Redo of the shared document go to the session (true when it took them).
+pub fn undo(app: &DesignApp, id: &str) -> bool {
+    matches!(id, "edit.undo" | "edit.redo") && shared_active(app) && UNDO.get().is_some_and(|undo| undo(id == "edit.redo"))
+}
+
+/// This person's presence while the shared document is the active one (see the module docs).
+pub fn presence(app: &DesignApp) -> Value {
+    let Some(st) = app.session.active().filter(|_| shared_active(app)) else { return Value::Null };
+    let pointer = POINTER.get()[1];
+    let page = pointer.map(|p| p.0).or_else(|| {
+        let layout = CanvasLayout::new(&st.doc, st.editing_parents);
+        Some(st.doc.spread(layout.slots.get(current_slot(app, &layout)?)?.spread)?.id.0)
+    });
+    let editing = st.selection.text.and_then(|t| t.frame);
+    let selection: Vec<u64> = st.selection.items.iter().chain(&editing).take(50).map(|i| i.0).collect();
+    let mut state = json!({ "page": page, "selection": selection });
+    if let Some((_, p)) = pointer {
+        state["pointer"] = json!(p);
+    }
+    state
+}
+
+/// The others to draw (all of them each time; none once the session ends).
+pub fn show(others: Vec<(String, [u8; 3], Value)>) {
+    OTHERS.set(others);
+}
+
+/// The end of a frame: the pointer seen in it is the one [`presence`] gives.
+pub fn end_frame() {
+    POINTER.set([None, POINTER.get()[0]]);
+}
+
+/// `screen` in the spread under (or nearest to) it: (spread id, point in that spread, to 0.01 pt).
+pub fn to_spread(doc: &Document, layout: &CanvasLayout, xf: &Xf, screen: Pos2) -> Option<(u64, [f64; 2])> {
+    let (r, p) = layout.spread_at(xf.to_canvas(screen))?;
+    Some((doc.spread(r)?.id.0, [p.x, p.y].map(|c| (c * 100.0).round() / 100.0)))
+}
+
+/// Where point `p` of spread `spread` is on this screen; None when that spread is not on this canvas or the numbers
+/// are not sane (they come from other people).
+pub fn to_screen(doc: &Document, layout: &CanvasLayout, xf: &Xf, spread: u64, p: [f64; 2]) -> Option<Pos2> {
+    if !p.iter().all(|c| c.abs() < 1e7) {
+        return None;
+    }
+    let slot = layout.slots.iter().find(|s| doc.spread(s.spread).is_some_and(|sp| sp.id.0 == spread))?;
+    let at = xf.to_screen(slot.to_canvas(Point::new(p[0], p[1])));
+    at.is_finite().then_some(at)
+}
+
+/// In the canvas painter, after the document and this person's selection: notes this person's pointer and draws the
+/// others' selections and pointers (shared document only).
+pub fn draw(app: &DesignApp, painter: &egui::Painter, xf: &Xf) {
+    let Some(st) = app.session.active().filter(|_| shared_active(app)) else { return };
+    let ctx = painter.ctx();
+    let hover = ctx
+        .input(|i| i.pointer.hover_pos())
+        .filter(|p| painter.clip_rect().contains(*p) && ctx.layer_id_at(*p).is_none_or(|l| l == painter.layer_id()));
+    if hover.is_none() && OTHERS.with_borrow(Vec::is_empty) {
+        return;
+    }
+    let (doc, layout) = (&st.doc, CanvasLayout::new(&st.doc, st.editing_parents));
+    if let Some(p) = hover.and_then(|p| to_spread(doc, &layout, xf, p)) {
+        POINTER.set([Some(p), POINTER.get()[1]]);
+    }
+    OTHERS.with_borrow(|others| {
+        for (name, [r, g, b], state) in others {
+            let color = Color32::from_rgb(*r, *g, *b);
+            for id in state["selection"].as_array().into_iter().flatten().take(50).filter_map(Value::as_u64) {
+                outline(painter, xf, doc, &layout, ItemId(id), color);
+            }
+            let p = &state["pointer"];
+            if let (Some(page), Some(x), Some(y)) = (state["page"].as_u64(), p[0].as_f64(), p[1].as_f64())
+                && let Some(at) = to_screen(doc, &layout, xf, page, [x, y])
+            {
+                arrow(painter, at, name, color);
+            }
+        }
+    });
+}
+
+/// An item's edges and bounding box (as this person's own selection draws them) in `color`.
+fn outline(painter: &egui::Painter, xf: &Xf, doc: &Document, layout: &CanvasLayout, id: ItemId, color: Color32) {
+    let (Some(it), Some(loc)) = (doc.item(id), doc.find(id)) else { return };
+    let Some((a, _)) = item_canvas_xf(doc, layout, id).filter(|_| layout.slot(loc.spread).is_some()) else { return };
+    for poly in path_screen(it, xf, a) {
+        painter.add(Shape::line(poly, Stroke::new(1.5, color)));
+    }
+    painter.rect_stroke(xf.rect(a.transform_rect_bbox(it.bounds())), 0.0, Stroke::new(1.0, color), StrokeKind::Middle);
+}
+
+/// A pointer arrow at `at` with a name tag.
+fn arrow(painter: &egui::Painter, at: Pos2, name: &str, color: Color32) {
+    painter.add(Shape::convex_polygon(vec![at, at + vec2(0.0, 16.0), at + vec2(11.0, 11.5)], color, Stroke::new(1.0, Color32::WHITE)));
+    let name: String = name.chars().take(32).collect();
+    if name.is_empty() {
+        return;
+    }
+    let galley = painter.layout_no_wrap(name, FontId::proportional(11.0), Color32::WHITE);
+    let tag = Rect::from_min_size(at + vec2(10.0, 15.0), galley.size() + vec2(8.0, 4.0));
+    painter.rect_filled(tag, 3.0, color);
+    painter.galley(tag.min + vec2(4.0, 2.0), galley, Color32::WHITE);
+}
