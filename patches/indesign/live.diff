+/// Set by the web app for live editing: hands out the ids [`Document::alloc`] counts, unique among the people editing at
+/// once (it raises `next_id` past each).
+#[cfg(target_arch = "wasm32")]
+pub static FRESH_ID: std::sync::OnceLock<fn(&mut u64) -> u64> = std::sync::OnceLock::new();
+
 impl Document {
     /// Allocate a fresh id.
     pub fn alloc(&mut self) -> u64 {
         self.next_id += 1;
+        #[cfg(target_arch = "wasm32")]
+        if let Some(fresh) = FRESH_ID.get() {
+            return fresh(&mut self.next_id);
+        }
         self.next_id
     }
 
