+    #[test]
+    fn a_document_opened_joins_the_session_one_from_another_opens_behind_and_a_closed_one_stays_closed() -> Result<(), String> {
+        let mut app = sample()?;
+        playground_live::connect();
+        let one = app.live_document();
+        // Opening a document while connected adds it.
+        app.run("file.new", json!({}))?;
+        let mut set = app.live_document();
+        assert_eq!(set["documents"].as_array().map(Vec::len), Some(2));
+        // Someone else's new document opens here behind the active one.
+        let mut theirs = one["documents"][0].clone();
+        (theirs["id"], theirs["title"], theirs["name"]) = (json!(7), json!("Theirs"), json!("Theirs"));
+        set["documents"].as_array_mut().ok_or("no documents")?.push(theirs);
+        let active = app.session.active().map(|d| d.uid);
+        app.live_adopt(set.clone())?;
+        assert_eq!(app.session.documents().len(), 3);
+        assert_eq!(app.session.active().map(|d| d.uid), active, "no switch to it");
+        assert_eq!(canonical(&app.live_document()), canonical(&set));
+        // Closing it hides it here only: it stays in the session, and a change to it does not open it again.
+        app.session.close_document(2);
+        assert_eq!(canonical(&app.live_document()), canonical(&set));
+        (set["documents"][2]["title"], set["documents"][2]["name"]) = (json!("Renamed"), json!("Renamed"));
+        app.live_adopt(set.clone())?;
+        assert_eq!(app.session.documents().len(), 2);
+        assert_eq!(canonical(&app.live_document()), canonical(&set));
+        playground_live::disconnect();
+        Ok(())
+    }
