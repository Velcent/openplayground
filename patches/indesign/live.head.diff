+    #[test]
+    fn a_pointer_reaches_its_spread_and_comes_back_through_a_turned_zoomed_view_and_a_drag_shows_its_ghost() -> Result<(), String> {
+        use designcraft_engine::doc::geom::Point;
+        let mut app = sample()?;
+        let doc = &app.session.doc().map_err(|e| e.to_string())?.doc;
+        let layout = designcraft_engine::tools::CanvasLayout::new(doc, false);
+        let xf =
+            crate::canvas::Xf { min: egui::pos2(10.0, 20.0), origin: Point::new(-300.0, 700.0), zoom: 1.5, rot: 1, pivot: egui::pos2(400.0, 300.0) };
+        let screen = egui::pos2(380.0, 520.0);
+        let (spread, p) = crate::canvas::live::to_spread(doc, &layout, &xf, screen).ok_or("no spread")?;
+        assert_ne!(spread, doc.spreads[0].id.0, "the second spread, not the first");
+        let back = xf.to_screen(crate::canvas::live::to_canvas(doc, &layout, spread, p).ok_or("off the canvas")?);
+        assert!((back - screen).length() < 0.05, "{back:?}");
+        assert_eq!(crate::canvas::live::to_canvas(doc, &layout, u64::MAX, p), None);
+        assert_eq!(crate::canvas::live::to_canvas(doc, &layout, spread, [1e300, 0.0]), None);
+
+        // A frame being dragged 10 pt right: the others are shown its ghost there, on its spread.
+        app.live_document();
+        let (it, on) = (doc.spreads[0].items[0].clone(), doc.spreads[0].id.0);
+        app.run("selection.set", json!({"ids": [it.id.0]}))?;
+        app.session.begin_interaction("Move").map_err(|e| e.to_string())?;
+        app.session.preview("transform.move", json!({"dx": 10, "dy": 0})).map_err(|e| e.to_string())?;
+        let presence = app.live_presence();
+        let xs: Vec<f64> = presence["ghosts"][0].as_array().ok_or("no ghost")?.iter().step_by(2).filter_map(Value::as_f64).collect();
+        let left = xs.iter().copied().fold(f64::MAX, f64::min);
+        assert!(presence["on"] == on && (left - (it.bounds().x0 + 10.0)).abs() < 0.5, "{presence}");
+        Ok(())
+    }
