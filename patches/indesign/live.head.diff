+    #[test]
+    fn shares_the_documents_without_views_adopts_them_without_an_undo_step_and_waits_for_a_gesture() -> Result<(), String> {
+        let mut a = sample()?;
+        playground_live::connect();
+        let start = canonical(&a.live_document());
+        // Views: a selection, a rotated spread and a Data Merge preview's filled copy stay out.
+        let ids: Vec<u64> = a.session.doc().map_err(|e| e.to_string())?.doc.spreads[0].items.iter().map(|i| i.id.0).collect();
+        a.run("selection.set", json!({"ids": [ids[0]]}))?;
+        let st = a.session.doc_mut().map_err(|e| e.to_string())?;
+        Arc::make_mut(&mut Arc::make_mut(&mut st.doc).spreads[0]).pages[0].view_rotation = 1;
+        st.preview_stash = Some(st.doc.clone());
+        Arc::make_mut(&mut st.doc).title = "Filled".into();
+        assert_eq!(canonical(&a.live_document()), start, "views are not shared");
+        a.session.stop_data_preview();
+
+        // A joiner with no document open adopts the set whole, files included, and shares the same bytes. (One page
+        // runs one app: A's view of the session waits meanwhile.)
+        let mine = DOCS.take();
+        let mut b = DesignApp::new(Session::new(), Services::default());
+        b.live_adopt(serde_json::from_slice(&start).map_err(|e| e.to_string())?)?;
+        assert_eq!(canonical(&b.live_document()), start);
+        let assets = |app: &DesignApp| app.session.active().map(|d| d.doc.assets.values().map(|a| a.data.len()).collect::<Vec<_>>());
+        assert!(assets(&b).is_some_and(|sizes| !sizes.is_empty() && sizes == assets(&a).unwrap_or_default()));
+
+        // B moves another object; A merges it at a quiet frame, keeping its selection and its own undo history.
+        b.run("selection.set", json!({"ids": [ids[1]]}))?;
+        b.run("transform.move", json!({"dx": 10, "dy": 0}))?;
+        let edited = canonical(&b.live_document());
+        DOCS.set(mine);
+        let undo_steps = a.session.doc().map_err(|e| e.to_string())?.history.undo.len();
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(start.clone()), edited.clone(), Box::new(move |r| to.set(r.is_ok())));
+        a.session.begin_interaction("Drag").map_err(|e| e.to_string())?;
+        playground_live::frame(&mut a);
+        assert!(!done.get(), "a gesture under way holds remote changes");
+        a.session.commit_interaction().map_err(|e| e.to_string())?;
+        playground_live::frame(&mut a);
+        assert!(done.get());
+        assert_eq!(canonical(&a.live_document()), edited);
+        let st = a.session.doc().map_err(|e| e.to_string())?;
+        assert_eq!((st.history.undo.len(), st.selection.items.clone()), (undo_steps, vec![designcraft_engine::doc::ItemId(ids[0])]));
+        assert_eq!(st.doc.spreads[0].pages[0].view_rotation, 1, "the spread stays rotated here");
+
+        // New objects get ids unique to this peer, and the counter stays above them.
+        let mut next = a.session.doc().map_err(|e| e.to_string())?.doc.next_id;
+        let id = fresh_id(&mut next).ok_or("connected")?;
+        assert!(id >> 52 == 1 && next == id);
+        playground_live::disconnect();
+        Ok(())
+    }
