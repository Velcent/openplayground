--- /dev/null
+++ b/apps/align-web/src/lib.rs
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Align's engine for Playground's browser build (patches/pluraleyes.yaml in github.com/daijro/openplayground): a
+//! WASI module the page's worker runs (apps/align-web/www/worker.js). Align's desktop app is built with GPUI, which
+//! has no browser backend, so the page has an interface of its own (www/) over the same engine: align-decode's
+//! pipeline and export, and the desktop app's lane layout (lanes.rs, from crates/align-gpui/src/lane.rs).
+//!
+//!   pg_alloc(len) / pg_free(ptr, len)   memory for the page's bytes
+//!   pg_call(json, len) -> u32           one command, {"cmd": …}; 0 done, 1 failed; the reply (JSON) is at
+//!                                       pg_reply_ptr(), pg_reply_len() bytes long
+//!
+//! Commands: `inspect` (the media's clips), `sync` (synchronize; its progress goes to the page as it happens) and
+//! `export` (the last result, as editor timelines in a folder). The import `playground.progress(json, len)` carries
+//! the progress.
+use std::cell::RefCell;
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::AtomicBool;
+
+use align_core::export_model::{ExportAssemblyOptions, ExportTimeline, TimelineExportFormat, UnmatchedPlacement};
+use align_core::{ClipId, SearchAccuracy, SyncResult, file_name};
+use align_decode::backend::BackendKind;
+use align_decode::pipeline::{Phase, Pipeline, PipelineInput, PipelineOptions, PipelineProgress};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+mod lanes;
+
+#[link(wasm_import_module = "playground")]
+unsafe extern "C" {
+    fn progress(json: *const u8, len: usize);
+}
+
+thread_local! {
+    static REPLY: RefCell<Vec<u8>> = RefCell::default();
+    static PIPELINE: Pipeline = Pipeline::new_in(BackendKind::Portable, Some(PathBuf::from("/.app/cache")));
+    static RESULT: RefCell<Option<SyncResult>> = const { RefCell::new(None) };
+}
+
+fn send_progress(value: &Value) {
+    let text = value.to_string();
+    // SAFETY: both point at live bytes for the call; the page copies them before returning.
+    unsafe { progress(text.as_ptr(), text.len()) }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn pg_alloc(len: usize) -> *mut u8 {
+    let mut v = Vec::<u8>::with_capacity(len.max(1));
+    let p = v.as_mut_ptr();
+    std::mem::forget(v);
+    p
+}
+
+/// # Safety
+/// `ptr` and `len` came from one [`pg_alloc`].
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn pg_free(ptr: *mut u8, len: usize) {
+    drop(unsafe { Vec::from_raw_parts(ptr, 0, len.max(1)) });
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn pg_reply_ptr() -> *const u8 {
+    REPLY.with_borrow(|r| r.as_ptr())
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn pg_reply_len() -> usize {
+    REPLY.with_borrow(|r| r.len())
+}
+
+/// # Safety
+/// The page's bytes, from [`pg_alloc`].
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn pg_call(ptr: *const u8, len: usize) -> u32 {
+    let text = std::str::from_utf8(unsafe { std::slice::from_raw_parts(ptr, len) }).unwrap_or("");
+    let (code, reply) = match serde_json::from_str::<Value>(text).map_err(|e| e.to_string()).and_then(call) {
+        Ok(v) => (0, v),
+        Err(e) => (1, Value::from(e)),
+    };
+    REPLY.set(reply.to_string().into_bytes());
+    code
+}
+
+fn call(request: Value) -> Result<Value, String> {
+    let cmd = request.get("cmd").and_then(Value::as_str).unwrap_or("").to_string();
+    match cmd.as_str() {
+        "inspect" => inspect(serde_json::from_value(request).map_err(|e| e.to_string())?),
+        "sync" => sync(serde_json::from_value(request).map_err(|e| e.to_string())?),
+        "export" => export(serde_json::from_value(request).map_err(|e| e.to_string())?),
+        _ => Err(format!("no command {cmd}")),
+    }
+}
+
+fn inputs(paths: &[PathBuf]) -> Vec<PipelineInput> {
+    paths.iter().cloned().map(PipelineInput::Media).collect()
+}
+
+#[derive(Deserialize)]
+struct Inspect {
+    paths: Vec<PathBuf>,
+}
+
+/// The media's clips, for the sources list, and what couldn't be read.
+fn inspect(r: Inspect) -> Result<Value, String> {
+    let project = PIPELINE.with(|p| p.open(&inputs(&r.paths))).map_err(|e| e.to_string())?;
+    let clips: Vec<Value> = project
+        .clips
+        .iter()
+        .map(|c| {
+            json!({
+                "id": c.id.0,
+                "url": c.url,
+                "name": file_name(&c.url),
+                "kind": c.kind.as_str(),
+                "duration": c.duration.value as f64 / f64::from(c.duration.timescale.max(1)),
+            })
+        })
+        .collect();
+    Ok(json!({ "clips": clips, "warnings": warnings(&project.warnings) }))
+}
+
+fn warnings(w: &[align_core::SyncWarning]) -> Vec<Value> {
+    w.iter().map(|w| json!({ "url": w.url, "message": w.message })).collect()
+}
+
+#[derive(Deserialize)]
+struct Sync {
+    paths: Vec<PathBuf>,
+    #[serde(default)]
+    accuracy: SearchAccuracy,
+}
+
+fn phase(p: &Phase) -> &'static str {
+    match p {
+        Phase::Inspect => "inspect",
+        Phase::Fingerprint => "fingerprint",
+        Phase::Match => "match",
+        Phase::Refine => "refine",
+        Phase::Solve => "solve",
+    }
+}
+
+/// Synchronizes, sending progress (and each clip's waveform) as it goes; keeps the result for `export`.
+fn sync(r: Sync) -> Result<Value, String> {
+    let options = PipelineOptions { generate_waveform_previews: true, search_accuracy: r.accuracy, ..Default::default() };
+    let on_progress = |p: PipelineProgress| {
+        send_progress(&json!({
+            "phase": phase(&p.phase),
+            "completed": p.completed,
+            "total": p.total,
+            "current": p.current.as_deref().map(file_name),
+            "waveform": p.waveform.as_ref().map(|(id, bins)| json!({ "clip": id.0, "bins": bins })),
+        }))
+    };
+    let cancel = AtomicBool::new(false);
+    let result = PIPELINE
+        .with(|p| p.synchronize(&inputs(&r.paths), &[], &options, Some(&on_progress), &cancel))
+        .map_err(|e| e.to_string())?;
+    let timeline = lanes::final_bars(&result);
+    let lanes = lanes::layout_bars(timeline.bars);
+    let unmatched: HashSet<&ClipId> = result.unmatched.iter().collect();
+    let total = result.project.clips.len();
+    let synced = result.project.clips.iter().filter(|c| !unmatched.contains(&c.id)).count();
+    let reply = json!({
+        "lanes": lanes,
+        "rulerTimecode": timeline.ruler_timecode,
+        "synced": synced,
+        "total": total,
+        "warnings": warnings(&result.project.warnings),
+    });
+    RESULT.set(Some(result));
+    Ok(reply)
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Export {
+    directory: PathBuf,
+    formats: Vec<TimelineExportFormat>,
+    #[serde(default)]
+    drift: bool,
+    /// Where `/` (Playground's Files) is on the computer the timelines will be opened on.
+    #[serde(default)]
+    media_folder: Option<String>,
+    #[serde(default)]
+    remove_unmatched: bool,
+}
+
+/// The last result as timelines (and drift-corrected audio) in `directory`; the files written.
+fn export(r: Export) -> Result<Value, String> {
+    let result = RESULT.with_borrow(|r| r.clone()).ok_or("Synchronize first.")?;
+    let options = ExportAssemblyOptions {
+        unmatched: if r.remove_unmatched { UnmatchedPlacement::Remove } else { UnmatchedPlacement::ByOrderAndTime },
+        ..Default::default()
+    };
+    let timeline = ExportTimeline::from_result_with_options(&result, options).map_err(|e| e.to_string())?;
+    std::fs::create_dir_all(&r.directory).map_err(|e| e.to_string())?;
+    let cancel = AtomicBool::new(false);
+    let artifacts = PIPELINE
+        .with(|p| {
+            align_decode::export::export_prepared_many(
+                align_decode::export::ExportBatchRequest {
+                    backend: p.backend(),
+                    timelines: std::slice::from_ref(&timeline),
+                    directory: &r.directory,
+                    formats: &r.formats,
+                    correct_drift: r.drift,
+                    include_replaced_sequence: false,
+                    include_media_files: false,
+                    aaf_frame_duration: None,
+                    include_fcpxml_timeline: true,
+                    include_fcpxml_multicam: true,
+                    group_fcpxml_storylines: false,
+                    cancel: &cancel,
+                },
+                Some(&mut |p: align_decode::export::ExportJobProgress| {
+                    send_progress(&json!({ "phase": "export", "completed": p.completed, "total": p.total }))
+                }),
+            )
+        })
+        .map_err(|e| e.to_string())?;
+    let _ = artifacts;
+    // The timelines and the corrected audio they play.
+    let mut files: Vec<PathBuf> = Vec::new();
+    list_files(&r.directory, &mut files);
+    if let Some(folder) = r.media_folder.as_deref().map(str::trim).filter(|f| !f.is_empty()) {
+        for f in &files {
+            relocate(f, folder).map_err(|e| format!("{}: {e}", f.display()))?;
+        }
+    }
+    Ok(json!({ "files": files }))
+}
+
+fn list_files(path: &Path, out: &mut Vec<PathBuf>) {
+    match std::fs::read_dir(path) {
+        Ok(entries) => {
+            for e in entries.flatten() {
+                list_files(&e.path(), out);
+            }
+        }
+        Err(_) if path.is_file() => out.push(path.to_path_buf()),
+        Err(_) => {}
+    }
+}
+
+/// Points a timeline's media at `folder` on the user's computer: the page's paths start at Files (`/`), so
+/// `file:///take.wav` becomes `file:///Users/me/Shoot/take.wav` (XML, FCPXML) and OpenTimelineIO's plain
+/// `"target_url": "/take.wav"` becomes `"/Users/me/Shoot/take.wav"` (the Resolve script reads those).
+fn relocate(file: &Path, folder: &str) -> std::io::Result<()> {
+    let ext = file.extension().and_then(|e| e.to_str()).unwrap_or("").to_ascii_lowercase();
+    if !matches!(ext.as_str(), "xml" | "fcpxml" | "otio") {
+        return Ok(());
+    }
+    let text = std::fs::read_to_string(file)?;
+    let folder = folder.trim_end_matches(['/', '\\']);
+    let url = align_core::file_url(Path::new(folder));
+    let plain = serde_json::to_string(folder).unwrap_or_default();
+    let plain = &plain[1..plain.len() - 1];
+    let text = text
+        .replace("file:///", &format!("{url}/"))
+        .replace("\"target_url\": \"/", &format!("\"target_url\": \"{plain}/"))
+        .replace("\"target_url\":\"/", &format!("\"target_url\":\"{plain}/"));
+    std::fs::write(file, text)
+}
diff --git a/apps/align-web/www/app.css b/apps/align-web/www/app.css
