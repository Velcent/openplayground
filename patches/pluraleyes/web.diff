+// SPDX-License-Identifier: GPL-3.0-only
+//! The timeline's lanes as Align's desktop app lays them out (crates/align-gpui/src/lane.rs: `final_bars`,
+//! `layout_bars`, `source_name_for`), without GPUI: the result's preview items packed into numbered V and A lanes by
+//! source, for the page to draw.
+use std::collections::{HashMap, HashSet};
+use std::path::Path;
+
+use align_core::export_model::ExportTimeline;
+use align_core::{ClipId, MediaKind, SyncResult, TimelineTrackRequest, allocate};
+use serde::Serialize;
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Bar {
+    pub id: String,
+    pub clip_id: String,
+    pub name: String,
+    #[serde(skip)]
+    pub kind: Option<MediaKind>,
+    #[serde(skip)]
+    pub source_key: String,
+    pub start: f64,
+    pub duration: f64,
+    pub confidence: f64,
+    pub matched: bool,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Lane {
+    pub id: String,
+    /// "V" or "A".
+    pub kind: &'static str,
+    pub number: usize,
+    pub source_name: String,
+    pub clips: Vec<Bar>,
+}
+
+pub struct FinalTimeline {
+    pub bars: Vec<Bar>,
+    pub ruler_timecode: Option<f64>,
+}
+
+pub fn final_bars(result: &SyncResult) -> FinalTimeline {
+    let unmatched: HashSet<ClipId> = result.unmatched.iter().cloned().collect();
+    let Ok(timeline) = ExportTimeline::from_result(result, true) else {
+        return FinalTimeline { bars: Vec::new(), ruler_timecode: None };
+    };
+    let bars = timeline
+        .preview_items(&unmatched)
+        .into_iter()
+        .map(|item| Bar {
+            id: item.id,
+            clip_id: item.clip_id.0,
+            name: item.name,
+            kind: Some(item.kind),
+            source_key: item.source_key,
+            start: item.start,
+            duration: item.duration,
+            confidence: item.confidence,
+            matched: item.matched,
+        })
+        .collect();
+    FinalTimeline { bars, ruler_timecode: timeline.ruler_timecode_start() }
+}
+
+/// Pack bars into V/A numbered lanes.
+pub fn layout_bars(bars: Vec<Bar>) -> Vec<Lane> {
+    let mut lanes = Vec::new();
+    let (video, audio): (Vec<_>, Vec<_>) = bars.into_iter().partition(|bar| bar.kind == Some(MediaKind::Video));
+    for (kind, segments) in [("V", video), ("A", audio)] {
+        let requests: Vec<TimelineTrackRequest> = segments
+            .iter()
+            .map(|b| TimelineTrackRequest::new(b.id.clone(), b.source_key.clone(), b.start, b.duration))
+            .collect();
+        let assignments = allocate(&requests);
+        let mut by_lane: HashMap<usize, Vec<Bar>> = HashMap::new();
+        for bar in segments {
+            by_lane.entry(assignments.get(&bar.id).copied().unwrap_or(0)).or_default().push(bar);
+        }
+        let mut indices: Vec<usize> = by_lane.keys().copied().collect();
+        indices.sort_unstable();
+        for index in indices {
+            let mut sorted = by_lane.remove(&index).unwrap_or_default();
+            sorted.sort_by(|a, b| a.start.total_cmp(&b.start).then_with(|| a.name.cmp(&b.name)));
+            let source_key = sorted.first().map(|b| b.source_key.clone()).unwrap_or_default();
+            let single_source = sorted.iter().all(|b| b.source_key == source_key);
+            lanes.push(Lane {
+                id: format!("{kind}-{index}"),
+                kind,
+                number: index + 1,
+                source_name: if single_source { source_name_for(&source_key) } else { String::new() },
+                clips: sorted,
+            });
+        }
+    }
+    lanes
+}
+
+/// `device:a:b:c` → `a b c`, `span:` → Linked BWF, else folder name.
+pub fn source_name_for(key: &str) -> String {
+    if let Some(rest) = key.strip_prefix("device:") {
+        return rest.replace(':', " ");
+    }
+    if key.starts_with("span:") {
+        return "Linked BWF".to_string();
+    }
+    Path::new(key).file_name().and_then(|n| n.to_str()).unwrap_or("").to_string()
+}
