diff --git a/apps/align-web/www/app.js b/apps/align-web/www/app.js
new file mode 100644
index 0000000..7583451
--- /dev/null
+++ b/apps/align-web/www/app.js
@@ -0,0 +1,456 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Align in Playground (patches/pluraleyes.yaml in github.com/daijro/openplayground): the page. Align's desktop app is
+// built with GPUI, which has no browser backend; this is its workflow over the same engine (worker.js, src/lib.rs):
+// add a shoot, synchronize it, review the lanes, export timelines for an editor.
+//
+// Media come from Playground's Files (globalThis.playgroundFiles) or from the computer (picked or dropped, files or
+// folders), and are read where the engine needs them; nothing from the computer is copied into Files. Files is one
+// flat list, so folders go in names there, as Retake does: "A-CAM › A001.MOV" is /A-CAM/A001.MOV, and each folder is a
+// device of its own on the lanes. An export goes to Files (each file named after the folder chosen) or downloads as
+// one ZIP.
+import { zip } from './zip.js'
+
+const $ = (id) => document.getElementById(id)
+const pg = () => globalThis.playgroundFiles
+const FOLDER = ' › '
+const MEDIA = /\.(mov|mp4|m4v|mts|mxf|r3d|wav|wave|bwf|aif|aiff|aifc|mp3|m4a|aac|caf|flac|ogg|opus)$/i
+const normalize = (p) => '/' + String(p).split('/').filter((s) => s && s !== '.' && s !== '..').join('/')
+const fromApp = (p) => (typeof p === 'string' && p.startsWith('browser:') ? normalize(p.slice(8).split(/\/|\s›\s/).join('/')) : null)
+const toApp = (p) => `browser:/${p.slice(1).split('/').join(FOLDER)}`
+const baseName = (p) => p.split('/').pop()
+const folderOf = (p) => p.slice(0, p.lastIndexOf('/')) || '/'
+const SETTINGS = 'align:settings'
+
+// ---------------------------------------------------------------- the engine, in a worker
+
+const worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' })
+const pending = new Map()
+let nextId = 0
+let started
+const ready = new Promise((resolve, reject) => (started = { resolve, reject }))
+let onProgress = () => {}
+worker.onmessage = ({ data }) => {
+  if (data.id !== undefined) {
+    pending.get(data.id)?.(data)
+    pending.delete(data.id)
+  } else if (data.progress) onProgress(data.progress)
+  else if (data.started) started.resolve()
+  else if (data.failed) started.reject(new Error(data.failed))
+}
+worker.onerror = (e) => started.reject(new Error(e.message))
+;(async () => {
+  // Compiled here, where Playground's loader unpacks the .wasm (page-prelude.js), and run in the worker.
+  const module = await WebAssembly.compileStreaming(fetch(new URL('align.wasm', document.baseURI)))
+  worker.postMessage({ start: true, module })
+})().catch((e) => started.reject(e))
+ready.catch((e) => say(`Align couldn't start: ${e.message}`))
+
+/** One engine command: its reply, and the files it wrote ([{ path, bytes }]). */
+async function call(request) {
+  await ready
+  const out = await new Promise((resolve) => {
+    const id = nextId++
+    pending.set(id, resolve)
+    worker.postMessage({ call: true, id, request })
+  })
+  if (out.error) throw new Error(out.error)
+  return { reply: out.reply, written: out.written }
+}
+
+// ---------------------------------------------------------------- state
+
+/** path → { path, name, kind, duration, error, status } */
+const media = new Map()
+let result = null
+let waveforms = new Map()
+let busy = false
+let zoom = 1
+const settings = Object.assign({ quality: 'balanced', mediaFolder: '' }, JSON.parse(localStorage.getItem(SETTINGS) ?? '{}'))
+$('quality').value = settings.quality
+const saveSettings = () => localStorage.setItem(SETTINGS, JSON.stringify(settings))
+
+function say(text, { warn = false, progress = null } = {}) {
+  $('status').textContent = text
+  $('warn').hidden = !warn
+  $('progress').hidden = progress === null
+  if (progress !== null) {
+    if (progress < 0) $('progress').removeAttribute('value')
+    else $('progress').value = progress
+  }
+}
+
+function freePath(path) {
+  if (!media.has(path)) return path
+  const dot = path.lastIndexOf('.')
+  const [stem, ext] = dot > path.lastIndexOf('/') ? [path.slice(0, dot), path.slice(dot)] : [path, '']
+  for (let i = 2; ; i++) if (!media.has(`${stem} (${i})${ext}`)) return `${stem} (${i})${ext}`
+}
+
+/** Hands media to the engine ([{ path, blob } or { path, bytes }]) and reads what they are. */
+async function add(items) {
+  items = items.filter((i) => MEDIA.test(i.path))
+  if (!items.length) return say('Nothing to add: Align takes audio and video files.', { warn: true })
+  for (const item of items) {
+    item.path = freePath(normalize(item.path))
+    media.set(item.path, { path: item.path, name: baseName(item.path), status: 'Queued' })
+    worker.postMessage({ add: true, path: item.path, blob: item.blob, bytes: item.bytes }, item.bytes ? [item.bytes.buffer] : [])
+  }
+  result = null
+  render()
+  say(`Reading ${items.length} ${items.length === 1 ? 'file' : 'files'}…`, { progress: -1 })
+  await inspect()
+}
+
+async function inspect() {
+  const paths = [...media.keys()]
+  if (!paths.length) return render()
+  try {
+    const { reply } = await call({ cmd: 'inspect', paths })
+    for (const c of reply.clips) Object.assign(media.get(c.url) ?? {}, { kind: c.kind, duration: c.duration, error: null, status: 'Ready' })
+    for (const w of reply.warnings) Object.assign(media.get(w.url) ?? {}, { error: w.message })
+  } catch (e) {
+    say(e.message, { warn: true })
+    return render()
+  }
+  render()
+  const n = media.size
+  say(`Ready to analyze ${n} source ${n === 1 ? 'item' : 'items'}.`)
+}
+
+function remove(path) {
+  media.delete(path)
+  worker.postMessage({ remove: path })
+  result = null
+  render()
+  say(media.size ? `Ready to analyze ${media.size} source ${media.size === 1 ? 'item' : 'items'}.` : 'Add your recordings to begin.')
+}
+
+function clear() {
+  for (const path of media.keys()) worker.postMessage({ remove: path })
+  media.clear()
+  result = null
+  waveforms = new Map()
+  render()
+  say('Add your recordings to begin.')
+}
+
+// ---------------------------------------------------------------- adding media
+
+async function addFromFiles() {
+  if (!pg()) return $('pickFiles').click()
+  const list = (await pg().files('browser:/')).filter((p) => MEDIA.test(p)).sort()
+  const box = $('filesList')
+  box.replaceChildren(
+    ...(list.length
+      ? list.map((p) => {
+          const label = document.createElement('label')
+          const input = Object.assign(document.createElement('input'), { type: 'checkbox', value: p, checked: false })
+          label.append(input, ` ${p.slice('browser:/'.length)}`)
+          return label
+        })
+      : [Object.assign(document.createElement('p'), { className: 'empty-note', textContent: 'No audio or video in Files yet. Add from this computer, or drop files here.' })]),
+  )
+  $('filesAll').onclick = () => box.querySelectorAll('input').forEach((i) => (i.checked = true))
+  const dialog = $('filesDialog')
+  dialog.returnValue = ''
+  dialog.showModal()
+  await new Promise((resolve) => dialog.addEventListener('close', resolve, { once: true }))
+  if (dialog.returnValue !== 'add') return
+  const picked = [...box.querySelectorAll('input:checked')].map((i) => i.value)
+  if (!picked.length) return
+  say(`Loading ${picked.length} from Files…`, { progress: -1 })
+  const items = await Promise.all(picked.map(async (p) => ({ path: fromApp(p), bytes: await pg().read(p) })))
+  await add(items)
+}
+
+const fromComputer = (files) => [...files].map((f) => ({ path: '/' + (f.webkitRelativePath || f.name), blob: f }))
+
+/** Files and folders dropped on the page, with their folders' names. */
+async function dropped(dataTransfer) {
+  const entries = [...dataTransfer.items].map((i) => i.webkitGetAsEntry?.()).filter(Boolean)
+  if (!entries.length) return fromComputer(dataTransfer.files)
+  const out = []
+  const walk = async (entry, dir) => {
+    if (entry.isFile) {
+      const file = await new Promise((resolve, reject) => entry.file(resolve, reject))
+      out.push({ path: `${dir}/${file.name}`, blob: file })
+    } else if (entry.isDirectory) {
+      const reader = entry.createReader()
+      for (;;) {
+        const batch = await new Promise((resolve, reject) => reader.readEntries(resolve, reject))
+        if (!batch.length) break
+        for (const child of batch) await walk(child, `${dir}/${entry.name}`)
+      }
+    }
+  }
+  for (const entry of entries) await walk(entry, '')
+  return out
+}
+
+function chooseAdd(kind) {
+  $('addMenu').hidden = true
+  if (busy) return
+  if (kind === 'files') addFromFiles().catch((e) => say(e.message, { warn: true }))
+  else if (kind === 'computer') $('pickFiles').click()
+  else if (kind === 'folder') $('pickFolder').click()
+}
+
+$('pickFiles').onchange = (e) => (add(fromComputer(e.target.files)), (e.target.value = ''))
+$('pickFolder').onchange = (e) => (add(fromComputer(e.target.files)), (e.target.value = ''))
+$('add').onclick = (e) => {
+  e.stopPropagation()
+  $('addMenu').hidden = !$('addMenu').hidden
+}
+document.addEventListener('click', () => ($('addMenu').hidden = true))
+for (const b of document.querySelectorAll('[data-add]')) b.onclick = () => chooseAdd(b.dataset.add)
+$('clear').onclick = () => !busy && clear()
+
+let depth = 0
+const hasFiles = (e) => [...(e.dataTransfer?.types ?? [])].includes('Files')
+addEventListener('dragenter', (e) => hasFiles(e) && (e.preventDefault(), depth++ === 0 && ($('dropHint').hidden = false)))
+addEventListener('dragover', (e) => hasFiles(e) && e.preventDefault())
+addEventListener('dragleave', (e) => hasFiles(e) && --depth <= 0 && ((depth = 0), ($('dropHint').hidden = true)))
+addEventListener('drop', async (e) => {
+  if (!hasFiles(e)) return
+  e.preventDefault()
+  depth = 0
+  $('dropHint').hidden = true
+  if (!busy) add(await dropped(e.dataTransfer))
+})
+
+// "Open in Align" from Files, and ?open=.
+ready.then(() => pg()?.onOpen((file) => add([{ path: fromApp(file.path) ?? `/${file.name}`, bytes: file.bytes }])))
+
+// ---------------------------------------------------------------- synchronizing
+
+const PHASES = { inspect: 'Reading media', fingerprint: 'Analyzing audio', match: 'Matching', refine: 'Refining', solve: 'Building the timeline', export: 'Exporting' }
+
+async function synchronize() {
+  if (busy || !media.size) return
+  busy = true
+  waveforms = new Map()
+  render()
+  const begun = performance.now()
+  onProgress = (p) => {
+    if (p.waveform) waveforms.set(p.waveform.clip, Float32Array.from(p.waveform.bins))
+    const label = PHASES[p.phase] ?? p.phase
+    say(`${label}${p.total ? ` ${Math.min(p.completed + 1, p.total)} of ${p.total}` : ''}${p.current ? ` · ${p.current}` : '…'}`, { progress: p.total ? p.completed / p.total : -1 })
+    if (p.current) for (const m of media.values()) if (m.name === p.current) m.status = label
+  }
+  say('Starting…', { progress: -1 })
+  try {
+    const { reply } = await call({ cmd: 'sync', paths: [...media.keys()], accuracy: settings.quality })
+    result = reply
+    const seconds = (performance.now() - begun) / 1000
+    say(`Synchronized ${reply.synced} of ${reply.total} clips in ${seconds < 10 ? seconds.toFixed(1) : Math.round(seconds)} s.`, { warn: reply.synced < reply.total })
+  } catch (e) {
+    say(e.message, { warn: true })
+  } finally {
+    busy = false
+    onProgress = () => {}
+    render()
+  }
+}
+
+$('sync').onclick = synchronize
+$('quality').onchange = (e) => ((settings.quality = e.target.value), saveSettings())
+
+// ---------------------------------------------------------------- export
+
+async function exportTimelines() {
+  if (busy || !result) return
+  const dialog = $('exportDialog')
+  const form = dialog.querySelector('form')
+  form.mediaFolder.value = settings.mediaFolder
+  dialog.returnValue = ''
+  dialog.showModal()
+  await new Promise((resolve) => dialog.addEventListener('close', resolve, { once: true }))
+  if (dialog.returnValue !== 'export') return
+  const formats = ['premiereXML', 'resolveXML', 'resolveOTIO', 'finalCutProXML'].filter((f) => form[f].checked)
+  if (form.resolveOTIO.checked) formats.push('resolveScript')
+  if (!formats.length) return say('Pick at least one editor to export for.', { warn: true })
+  settings.mediaFolder = form.mediaFolder.value.trim()
+  saveSettings()
+  const name = 'Align Export'
+  const saved = pg() ? await pg().saveAs({ name, types: [] }) : { download: true }
+  if (!saved) return
+  const directory = saved.download ? `/.export/${name}` : fromApp(saved.path)
+  busy = true
+  render()
+  onProgress = (p) => say(`Exporting ${p.completed} of ${p.total}…`, { progress: p.total ? p.completed / p.total : -1 })
+  try {
+    const { written } = await call({ cmd: 'export', directory, formats, drift: form.drift.checked, mediaFolder: settings.mediaFolder || null, removeUnmatched: form.removeUnmatched.checked })
+    const files = written.filter((w) => w.path.startsWith(directory + '/'))
+    if (saved.download) {
+      const entries = files.map((w) => ({ name: `${name}/${w.path.slice(directory.length + 1)}`, bytes: w.bytes }))
+      const blob = zip(entries)
+      if (pg()) pg().download(`${name}.zip`, blob)
+      else Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: `${name}.zip` }).click()
+      say(`Downloaded ${name}.zip: ${files.length} files.`)
+      for (const w of files) worker.postMessage({ remove: w.path })
+    } else {
+      for (const w of files) pg().write(toApp(w.path), w.bytes)
+      say(`Exported ${files.length} files to Files: ${baseName(directory)}.`)
+    }
+  } catch (e) {
+    say(e.message, { warn: true })
+  } finally {
+    busy = false
+    onProgress = () => {}
+    render()
+  }
+}
+
+$('export').onclick = exportTimelines
+
+// ---------------------------------------------------------------- drawing
+
+const ICON = {
+  video: '<svg viewBox="0 0 16 16"><rect x="1.5" y="4" width="9" height="8" rx="1.5"/><path d="M10.5 7l4-2v6l-4-2"/></svg>',
+  audio: '<svg viewBox="0 0 16 16"><path d="M2 8h1M5 5v6M8 3v10M11 6v4M14 8h-1"/></svg>',
+  folder: '<svg viewBox="0 0 20 20"><path d="M2.5 5.5a1 1 0 0 1 1-1h4l1.5 1.5h7.5a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1z"/></svg>',
+}
+const el = (tag, props = {}, ...children) => {
+  const e = Object.assign(document.createElement(tag), props)
+  e.append(...children)
+  return e
+}
+const duration = (s) => {
+  if (s == null) return ''
+  const h = Math.floor(s / 3600)
+  const m = Math.floor((s % 3600) / 60)
+  const sec = s % 60
+  return `${h ? `${h}:${String(m).padStart(2, '0')}` : m}:${sec.toFixed(1).padStart(4, '0')}`
+}
+
+function render() {
+  const has = media.size > 0
+  $('empty').hidden = has
+  $('sources').hidden = !has || !!result
+  $('timeline').hidden = !result
+  $('zoomBox').hidden = !result
+  $('title').textContent = result ? 'Timeline' : 'Sources'
+  $('sync').disabled = busy || !has
+  $('sync').textContent = result ? 'Synchronize Again' : 'Synchronize'
+  $('export').disabled = busy || !result
+  $('add').disabled = $('clear').disabled = busy
+  if (result) drawTimeline()
+  else if (has) drawSources()
+}
+
+function drawSources() {
+  const groups = new Map()
+  for (const m of media.values()) {
+    const dir = folderOf(m.path)
+    if (!groups.has(dir)) groups.set(dir, [])
+    groups.get(dir).push(m)
+  }
+  const box = $('sources')
+  box.replaceChildren(el('p', { className: 'count', textContent: `${media.size} ${media.size === 1 ? 'item' : 'items'}` }))
+  for (const [dir, items] of [...groups].sort(([a], [b]) => a.localeCompare(b))) {
+    const head = el('header')
+    head.innerHTML = ICON.folder
+    head.append(el('div', {}, el('strong', { textContent: dir === '/' ? 'Media' : baseName(dir) }), el('small', { textContent: `${items.length} ${items.length === 1 ? 'item' : 'items'} · ${items.filter((i) => !i.error).length === items.length ? (busy ? 'Analyzing' : 'Queued') : 'some can’t be read'}` })))
+    const group = el('div', { className: 'group' }, head)
+    for (const m of items.sort((a, b) => a.name.localeCompare(b.name))) {
+      const icon = el('span')
+      icon.innerHTML = m.kind === 'video' ? ICON.video : ICON.audio
+      const del = el('button', { className: 'icon', title: `Remove ${m.name}`, disabled: busy, onclick: () => remove(m.path) })
+      del.innerHTML = '<svg viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8"/></svg>'
+      group.append(
+        el('div', { className: 'item' }, icon, el('span', { className: 'name', textContent: m.name, title: m.path }),
+          m.error ? el('span', { className: 'bad', textContent: m.error }) : el('span', { className: 'meta', textContent: busy ? m.status : duration(m.duration) }), del),
+      )
+    }
+    box.append(group)
+  }
+}
+
+const LABEL = 52
+function drawTimeline() {
+  const lanes = result.lanes
+  const end = Math.max(1, ...lanes.flatMap((l) => l.clips.map((c) => c.start + c.duration)))
+  const fit = Math.max(200, $('scroller').clientWidth - LABEL - 24)
+  const pps = (fit * zoom) / end
+  const width = Math.ceil(end * pps) + 24
+  $('zoomPct').textContent = `${Math.round(zoom * 100)}%`
+  // Ruler: a label every step seconds, at least ~90 px apart.
+  const steps = [1, 2, 5, 10, 15, 30, 60, 120, 300, 600, 900, 1800, 3600, 7200]
+  const step = steps.find((s) => s * pps >= 90) ?? 7200
+  const tc = result.rulerTimecode ?? 0
+  const clock = (t) => {
+    const s = Math.round(tc + t)
+    return `${Math.floor(s / 3600)}:${String(Math.floor((s % 3600) / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`
+  }
+  const ruler = $('ruler')
+  ruler.style.width = `${width}px`
+  ruler.replaceChildren()
+  const ticks = []
+  for (let t = 0; t <= end + 0.001; t += step) {
+    ruler.append(el('span', { textContent: clock(t), style: `left:${t * pps}px` }))
+    ticks.push(t * pps)
+  }
+  const box = $('lanes')
+  box.replaceChildren()
+  for (const lane of lanes) {
+    const track = el('div', { className: 'track', style: `width:${width}px` })
+    for (const x of ticks) track.append(el('div', { className: 'gridline', style: `left:${x}px` }))
+    lane.clips.forEach((c, i) => {
+      const next = lane.clips[i + 1]
+      const x = c.start * pps
+      const w = Math.max(2, Math.min(c.duration * pps, next ? next.start * pps - x : Infinity))
+      const clip = el('div', { className: `clip ${c.matched ? '' : 'unmatched'}`, style: `left:${x}px;width:${w}px`, title: `${c.name}\n${c.matched ? `Synchronized · confidence ${(c.confidence * 100).toFixed(0)}%` : 'Not matched'}` })
+      const bins = waveforms.get(c.clipId)
+      if (bins && w > 12) clip.append(wave(bins, w))
+      const name = el('span', { className: 'name' })
+      name.innerHTML = lane.kind === 'V' ? ICON.video : ICON.audio
+      name.append(c.name)
+      clip.append(name)
+      track.append(clip)
+    })
+    box.append(el('div', { className: 'lane' }, el('div', { className: 'label', textContent: `${lane.kind}${lane.number}`, title: lane.sourceName }), track))
+  }
+}
+
+function wave(bins, width) {
+  const height = 31
+  const canvas = el('canvas', { width: Math.min(4000, Math.ceil(width)), height })
+  const g = canvas.getContext('2d')
+  g.fillStyle = '#fff'
+  const n = canvas.width
+  for (let x = 0; x < n; x++) {
+    const v = bins[Math.floor((x / n) * bins.length)] ?? 0
+    const h = Math.max(1, v * (height - 6))
+    g.fillRect(x, (height - h) / 2, 1, h)
+  }
+  return canvas
+}
+
+$('zoom').oninput = (e) => {
+  zoom = Number(e.target.value)
+  if (result) drawTimeline()
+}
+$('scroller').addEventListener(
+  'wheel',
+  (e) => {
+    if (!(e.ctrlKey || e.metaKey || e.altKey) || !result) return
+    e.preventDefault()
+    zoom = Math.min(40, Math.max(1, zoom * (e.deltaY < 0 ? 1.15 : 1 / 1.15)))
+    $('zoom').value = zoom
+    drawTimeline()
+  },
+  { passive: false },
+)
+addEventListener('resize', () => result && drawTimeline())
+
+addEventListener('keydown', (e) => {
+  if (!(e.ctrlKey || e.metaKey) || e.altKey || document.querySelector('dialog[open]')) return
+  const k = e.key.toLowerCase()
+  if (k === 'o') chooseAdd('files')
+  else if (k === 'r') synchronize()
+  else if (k === 'e') exportTimelines()
+  else return
+  e.preventDefault()
+})
+
+render()
diff --git a/apps/align-web/www/engine.js b/apps/align-web/www/engine.js
new file mode 100644
index 0000000..28806a9
--- /dev/null
+++ b/apps/align-web/www/engine.js
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Align in Playground (patches/pluraleyes.yaml in github.com/daijro/openplayground): the engine, a WASI module
+// (apps/align-web/src/lib.rs), over the in-memory files of wasi.js. `call` runs one command; `progress(update)` gets
+// what a running command reports.
+import { Files, wasi } from './wasi.js'
+
+export const files = new Files()
+
+export async function start(source, progress) {
+  const { imports, setMemory } = wasi(files)
+  const decoder = new TextDecoder()
+  const encoder = new TextEncoder()
+  let x
+  const env = {
+    wasi_snapshot_preview1: imports,
+    playground: { progress: (p, l) => progress(JSON.parse(decoder.decode(new Uint8Array(x.memory.buffer, p, l).slice()))) },
+  }
+  source = await source
+  const instance = source instanceof WebAssembly.Module ? await WebAssembly.instantiate(source, env) : (await WebAssembly.instantiate(source, env)).instance
+  x = instance.exports
+  setMemory(x.memory)
+  x._initialize?.()
+  return {
+    /** One command: its reply, or a throw with its error. */
+    call(request) {
+      const bytes = encoder.encode(JSON.stringify(request))
+      const ptr = x.pg_alloc(bytes.length)
+      new Uint8Array(x.memory.buffer, ptr, bytes.length).set(bytes)
+      let code
+      try {
+        code = x.pg_call(ptr, bytes.length)
+      } finally {
+        x.pg_free(ptr, bytes.length)
+      }
+      const reply = JSON.parse(decoder.decode(new Uint8Array(x.memory.buffer, x.pg_reply_ptr(), x.pg_reply_len()).slice()))
+      if (code !== 0) throw new Error(reply)
+      return reply
+    },
+  }
+}
