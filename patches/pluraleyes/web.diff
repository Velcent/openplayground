+/* SPDX-License-Identifier: GPL-3.0-only
+   Align in Playground (patches/pluraleyes.yaml in github.com/daijro/openplayground): the look of Align's desktop app
+   (crates/align-gpui), light or dark with the system. */
+:root {
+  color-scheme: light dark;
+  --bg: #ffffff;
+  --panel: #f5f5f7;
+  --row: #fbfbfd;
+  --line: #e3e3e8;
+  --grid: #ececf1;
+  --text: #1d1d1f;
+  --muted: #6e6e73;
+  --accent: #0a7cff;
+  --synced: #2fb34d;
+  --unmatched: #f39a1d;
+  --pending: #3b8cff;
+  --clip-text: #ffffff;
+  --shadow: 0 8px 30px rgb(0 0 0 / 0.18);
+  font: 13px/1.4 -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #1e1e20;
+    --panel: #262628;
+    --row: #2a2a2d;
+    --line: #38383c;
+    --grid: #2f2f33;
+    --text: #f2f2f4;
+    --muted: #a1a1a6;
+    --accent: #3a93ff;
+    --shadow: 0 8px 30px rgb(0 0 0 / 0.5);
+  }
+}
+* { box-sizing: border-box; }
+[hidden] { display: none !important; }
+html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); }
+/* Below Playground's bar (its shell.css sets --pg-bar). */
+#app { position: fixed; inset: var(--pg-bar, 0px) 0 0 0; display: grid; grid-template-rows: auto 1fr auto; }
+button { font: inherit; color: inherit; background: var(--panel); border: 1px solid var(--line); border-radius: 7px; padding: 4px 12px; cursor: pointer; }
+button:hover:not(:disabled) { filter: brightness(0.97); }
+button:disabled { opacity: 0.45; cursor: default; }
+button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
+button.link { background: none; border: none; color: var(--accent); }
+button.link:disabled { color: var(--muted); }
+button.icon { background: none; border: none; padding: 4px; width: 28px; height: 28px; display: grid; place-items: center; }
+button.icon:hover:not(:disabled) { background: var(--panel); }
+button.icon svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
+select, input { font: inherit; color: inherit; }
+select { background: var(--panel); border: 1px solid var(--line); border-radius: 7px; padding: 3px 6px; }
+
+.toolbar { display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-bottom: 1px solid var(--line); }
+.toolbar h1 { font-size: 13px; font-weight: 600; margin: 0 0 0 12px; }
+.toolbar .spacer { flex: 1; text-align: center; }
+.quality { display: flex; align-items: center; gap: 6px; padding: 0 4px 0 10px; background: var(--panel); border-radius: 7px; color: var(--muted); }
+.quality select { border: none; background: none; color: var(--text); }
+.menu-host { position: relative; }
+.menu { position: absolute; top: 32px; left: 0; z-index: 10; min-width: 230px; display: grid; padding: 5px; background: var(--bg); border: 1px solid var(--line); border-radius: 9px; box-shadow: var(--shadow); }
+.menu button { background: none; border: none; text-align: left; padding: 6px 10px; border-radius: 6px; }
+.menu button:hover { background: var(--accent); color: #fff; }
+
+#main { position: relative; overflow: hidden; background: var(--bg); }
+.empty { height: 100%; display: grid; place-content: center; justify-items: center; gap: 8px; text-align: center; padding: 24px; }
+.empty img { border-radius: 22px; }
+.empty h2 { font-size: 22px; margin: 8px 0 0; }
+.empty p { color: var(--muted); max-width: 440px; margin: 0 0 8px; }
+.row { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
+.drop-hint { position: absolute; inset: 10px; display: grid; place-items: center; border: 2px dashed var(--accent); border-radius: 14px; background: color-mix(in srgb, var(--accent) 8%, transparent); color: var(--accent); font-size: 18px; font-weight: 600; pointer-events: none; }
+
+.sources { height: 100%; overflow: auto; padding: 14px 18px; }
+.sources .count { color: var(--muted); margin: 0 0 8px; font-size: 12px; }
+.group { background: var(--row); border: 1px solid var(--line); border-radius: 9px; margin-bottom: 8px; overflow: hidden; }
+.group > header { display: flex; align-items: center; gap: 10px; padding: 9px 12px; }
+.group > header svg { width: 18px; height: 18px; fill: none; stroke: var(--muted); stroke-width: 1.3; }
+.group > header strong { font-weight: 600; }
+.group > header small { display: block; color: var(--muted); font-size: 11px; }
+.item { display: flex; align-items: center; gap: 10px; padding: 6px 12px 6px 40px; border-top: 1px solid var(--line); }
+.item > span:first-child svg { width: 15px; height: 15px; fill: none; stroke: var(--muted); stroke-width: 1.3; display: block; }
+.item .name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.item .meta { color: var(--muted); font-variant-numeric: tabular-nums; }
+.item .bad { color: var(--unmatched); }
+.item button.icon { width: 22px; height: 22px; opacity: 0.5; }
+.item button.icon:hover { opacity: 1; }
+
+.timeline { height: 100%; }
+.scroller { height: 100%; overflow: auto; position: relative; }
+.ruler { position: sticky; top: 0; z-index: 3; height: 30px; background: var(--bg); border-bottom: 1px solid var(--line); margin-left: 52px; }
+.ruler span { position: absolute; top: 8px; transform: translateX(-50%); color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.lanes { position: relative; }
