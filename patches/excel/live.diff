@@ -0,0 +1,390 @@
+//! Live editing in a Playground session (web only): the shared document is the workbook open when the session started
+//! (pinned by uid; if its window closes the session goes on with it as it was), as JSON. Sheets are keyed by name,
+//! cells by address with their style inline (style ids are positions in a table each copy grows on its own), objects
+//! by id. Formula results are recalculated where the workbook is, not shared. This person's active sheet, zoom, sheet
+//! view mode, gridlines, headings and Show Formulas, scroll position and active cell, Watch Window, selection and the
+//! file data GridCraft does not model stay local.
+
+use std::cell::{Cell as Flag, RefCell};
+use std::sync::Arc;
+
+use gridcraft_engine::core::{CellRef, Value as CellValue};
+use gridcraft_engine::model::{Cell, CellStore, Formula, Sheet, Style, StyleId, StyleTable, Workbook};
+use gridcraft_engine::{DocState, Mode, Session};
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value, json};
+
+use crate::SheetApp;
+use crate::grid::Drag;
+use crate::playground_live::{self, Live};
+
+/// Sheet fields that are this person's view.
+const VIEW: [&str; 7] = ["zoom", "view", "view_active", "view_top_left", "show_gridlines", "show_headings", "show_formulas"];
+/// The defined name holding the Watch Window's list, which the app keeps through Undo as view state.
+const WATCH: &str = "_sc_watch";
+
+thread_local! {
+    /// The shared workbook's `DocState::uid` (0: none yet).
+    static SHARED: Flag<u64> = const { Flag::new(0) };
+    /// The shared workbook as last seen, which the session goes on with if its window closes.
+    static LAST: RefCell<Option<Arc<Workbook>>> = const { RefCell::new(None) };
+    /// A pointer is down or a text field has the keyboard (as of the last frame).
+    static GESTURE: Flag<bool> = const { Flag::new(false) };
+}
+
+/// The end of each frame (web): [`playground_live::frame`], told whether a pointer or the keyboard is busy.
+pub fn frame(app: &mut SheetApp, ctx: &egui::Context) {
+    GESTURE.set(ctx.input(|i| i.pointer.any_down()) || ctx.text_edit_focused());
+    playground_live::frame(app);
+}
+
+/// Whether the active workbook is the one the session shares (its Undo and Redo go to the session).
+pub fn shared_active(s: &Session) -> bool {
+    SHARED.get() != 0 && s.active().is_some_and(|d| d.uid == SHARED.get())
+}
+
+/// The shared workbook's index, pinning the active one when nothing is shared yet; `None` once its window closed.
+fn pinned(s: &Session) -> Option<usize> {
+    if SHARED.get() == 0
+        && let Some(d) = s.active()
+    {
+        SHARED.set(d.uid);
+    }
+    s.documents().iter().position(|d| d.uid == SHARED.get())
+}
+
+/// The shared workbook: the pinned one, else as it was when its window closed (a blank one if none was ever open).
+fn shared(s: &Session) -> Arc<Workbook> {
+    match pinned(s).and_then(|i| s.documents().get(i)) {
+        Some(d) => {
+            LAST.set(Some(d.wb.clone()));
+            d.wb.clone()
+        }
+        None => LAST.with_borrow(Clone::clone).unwrap_or_default(),
+    }
+}
+
+/// Runs `f` on document `i` (the session lends out only the active one).
+fn with_doc<R>(s: &mut Session, i: usize, f: impl FnOnce(&mut DocState) -> R) -> Option<R> {
+    let active = s.active_index();
+    s.set_active(i);
+    let r = s.active_mut().map(f);
+    s.set_active(active);
+    r
+}
+
+/// A cell as shared: its formula or value, and its style unless that is Normal.
+#[derive(Serialize, Deserialize)]
+struct SharedCell {
+    #[serde(default, skip_serializing_if = "CellValue::is_empty")]
+    value: CellValue,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    formula: Option<Arc<Formula>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    style: Option<Style>,
+}
+
+fn document(wb: &Workbook) -> serde_json::Result<Value> {
+    let normal = wb.styles.get(StyleId::DEFAULT);
+    let mut sheets = Vec::new();
+    for sh in &wb.sheets {
+        let mut v = serde_json::to_value(Sheet { cells: CellStore::new(), ..(**sh).clone() })?;
+        if let Some(m) = v.as_object_mut() {
+            for k in VIEW {
+                m.remove(k);
+            }
+        }
+        v["id"] = sh.name.clone().into();
+        let mut cells = Map::new();
+        for (at, cell) in sh.cells.iter() {
+            let style = wb.styles.get(cell.style);
+            let shared = SharedCell {
+                // A formula's result is recalculated where the workbook is.
+                value: if cell.formula.is_some() { CellValue::Empty } else { cell.value.clone() },
+                formula: cell.formula.clone(),
+                style: (style != normal).then(|| style.clone()),
+            };
+            if !shared.value.is_empty() || shared.formula.is_some() || shared.style.is_some() {
+                cells.insert(at.a1(), serde_json::to_value(shared)?);
+            }
+        }
+        v["cells"] = Value::Object(cells);
+        for (key, lines) in [("rows", &sh.rows), ("cols", &sh.cols)] {
+            for (i, line) in lines {
+                if let Some(id) = line.style {
+                    v[key][i.to_string()]["style"] = serde_json::to_value(wb.styles.get(id))?;
+                }
+            }
+        }
+        sheets.push(v);
+    }
+    let mut v = serde_json::to_value(Workbook { sheets: vec![], ..wb.clone() })?;
+    if let Some(m) = v.as_object_mut() {
+        m.remove("active_sheet");
+        m.insert("styles".into(), serde_json::to_value(normal)?);
+        m.insert("sheets".into(), Value::Array(sheets));
+    }
+    if let Some(names) = v["names"].as_array_mut() {
+        names.retain(|n| n["name"] != WATCH);
+    }
+    Ok(v)
+}
+
+/// The shared `document` as a workbook, with this person's views, Watch Window and unmodelled file data from `local`.
+fn install(local: &Workbook, document: Value) -> Result<Workbook, String> {
+    let json = |e: serde_json::Error| e.to_string();
+    let mut m: Map<String, Value> = serde_json::from_value(document).map_err(json)?;
+    let normal: Style = serde_json::from_value(m.remove("styles").unwrap_or_default()).map_err(json)?;
+    let incoming: Vec<Map<String, Value>> = serde_json::from_value(m.remove("sheets").unwrap_or_default()).map_err(json)?;
+    m.extend([("active_sheet".into(), json!(0)), ("styles".into(), json!({"styles": []})), ("sheets".into(), json!([]))]);
+    let mut wb: Workbook = serde_json::from_value(Value::Object(m)).map_err(json)?;
+    // Styles this copy has keep their ids.
+    wb.styles = if *local.styles.get(StyleId::DEFAULT) == normal { local.styles.clone() } else { StyleTable::with_default(normal) };
+    let blank = serde_json::to_value(Sheet::new("")).map_err(json)?;
+    for mut s in incoming {
+        let cells = s.insert("cells".into(), blank["cells"].clone()).unwrap_or_else(|| json!({}));
+        for k in VIEW {
+            s.insert(k.into(), blank[k].clone());
+        }
+        for key in ["rows", "cols"] {
+            for line in s.get_mut(key).and_then(Value::as_object_mut).into_iter().flat_map(|m| m.values_mut()) {
+                if let Some(style) = line.get_mut("style").filter(|v| v.is_object()) {
+                    *style = wb.styles.intern(serde_json::from_value(style.take()).map_err(json)?).0.into();
+                }
+            }
+        }
+        let mut sh: Sheet = serde_json::from_value(Value::Object(s)).map_err(json)?;
+        for (a1, cell) in serde_json::from_value::<Map<String, Value>>(cells).map_err(json)? {
+            let at = CellRef::parse(&a1).ok_or_else(|| format!("invalid cell `{a1}`"))?;
+            let c: SharedCell = serde_json::from_value(cell).map_err(json)?;
+            // A merge can combine fields into a cell GridCraft would store differently, which would change it again.
+            let empty = c.value.is_empty() && c.formula.is_none() && c.style.is_none();
+            if empty || (c.formula.is_some() && !c.value.is_empty()) || c.style.as_ref() == Some(wb.styles.get(StyleId::DEFAULT)) {
+                return Err(format!("cell {a1} of {} is not one GridCraft stores", sh.name));
+            }
+            let style = c.style.map_or(StyleId::DEFAULT, |s| wb.styles.intern(s));
+            sh.cells.set(at, Cell { value: c.value, formula: c.formula, style });
+        }
+        if let Some(old) = local.sheets.iter().find(|old| old.name == sh.name) {
+            (sh.zoom, sh.view, sh.view_active, sh.view_top_left) = (old.zoom, old.view, old.view_active, old.view_top_left);
+            (sh.show_gridlines, sh.show_headings, sh.show_formulas) = (old.show_gridlines, old.show_headings, old.show_formulas);
+            sh.preserved = old.preserved.clone();
+        }
+        wb.sheets.push(Arc::new(sh));
+    }
+    if wb.sheets.is_empty() {
+        return Err("a workbook without sheets".into());
+    }
+    let active = local.active().map(|sh| &sh.name);
+    wb.active_sheet = wb.sheets.iter().position(|sh| Some(&sh.name) == active).unwrap_or(local.active_sheet.min(wb.sheets.len() - 1));
+    wb.names.extend(local.names.iter().filter(|n| n.name == WATCH).cloned());
+    (wb.preserved, wb.source_dir) = (local.preserved.clone(), local.source_dir.clone());
+    Ok(wb)
+}
+
+impl Live for SheetApp {
+    fn live_document(&self) -> Value {
+        // Serializing the model cannot fail (every map key is text); a null would fail every peer's check.
+        document(&shared(&self.session)).unwrap_or_default()
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let s = &mut self.session;
+        if SHARED.get() == 0 && s.active().is_none() {
+            // Joining with no workbook open: a window for the shared one.
+            s.new_workbook();
+        }
+        let current = shared(s);
+        if self::document(&current).ok().as_ref() == Some(&document) {
+            return Ok(());
+        }
+        let mut wb = install(&current, document).map_err(|e| format!("Invalid shared workbook: {e}"))?;
+        let Some(i) = pinned(s) else {
+            LAST.set(Some(Arc::new(wb)));
+            return Ok(());
+        };
+        with_doc(s, i, |d| {
+            d.calc.recalc_all(&mut wb);
+            d.wb = Arc::new(wb);
+            d.revision += 1;
+            LAST.set(Some(d.wb.clone()));
+        });
+        Ok(())
+    }
+
+    /// Whether every peer can install `document` (two people deleting a sheet each can leave none).
+    fn live_check(document: &Value) -> Result<(), String> {
+        // ponytail: decodes the whole workbook per merge (O(cells)); a lighter schema check if big sessions lag.
+        install(&Workbook::default(), document.clone()).map(drop).map_err(|e| format!("Conflict: {e}"))
+    }
+
+    fn live_quiet(&self) -> bool {
+        let g = &self.grid;
+        !GESTURE.get()
+            && self.editor.is_none()
+            && self.text_box_editor.is_none()
+            && self.session.mode == Mode::Ready
+            && g.drag == Drag::None
+            && !g.drag_select
+            && g.ink.is_empty()
+            && g.hf_edit.is_none()
+            && g.ruler_drag.is_none()
+            && g.renaming_tab.is_none()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        use std::hash::{Hash, Hasher};
+        let s = &self.session;
+        let mut h = std::hash::DefaultHasher::new();
+        match pinned(s).and_then(|i| s.documents().get(i)) {
+            Some(d) => (d.uid, d.revision, Arc::as_ptr(&d.wb) as usize).hash(&mut h),
+            None => LAST.with_borrow(|wb| wb.as_ref().map(Arc::as_ptr)).hash(&mut h),
+        }
+        Some(h.finish())
+    }
+
+    fn live_disconnected(&mut self) {
+        let s = &mut self.session;
+        if let Some(i) = s.documents().iter().position(|d| d.uid == SHARED.get()) {
+            // Its steps hold other people's edits.
+            with_doc(s, i, |d| {
+                d.undo.clear();
+                d.redo.clear();
+            });
+        }
+        (SHARED.set(0), LAST.set(None));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Services;
+    use crate::playground_live::{self as live, canonical};
+
+    /// Another person's app, its workbook not shared yet (each page pins its own).
+    fn app() -> SheetApp {
+        let mut s = Session::new();
+        s.new_workbook();
+        pin(None);
+        SheetApp::new(s, Services::default())
+    }
+
+    /// Switches the test to `app`'s page: its active workbook is the shared one.
+    fn pin(app: Option<&SheetApp>) {
+        SHARED.set(app.and_then(|a| a.session.active()).map_or(0, |d| d.uid));
+        LAST.set(None);
+    }
+
+    fn run(app: &mut SheetApp, id: &str, params: Value) {
+        app.session.execute(id, params).unwrap();
+    }
+
+    fn input(app: &SheetApp, a1: &str) -> String {
+        let d = app.session.active().unwrap();
+        d.wb.sheet(0).unwrap().cell(CellRef::parse(a1).unwrap()).map(|c| c.input_text()).unwrap_or_default()
+    }
+
+    #[test]
+    fn the_workbook_round_trips_without_views_or_results_and_adopting_it_keeps_this_persons_views() {
+        let mut a = app();
+        run(&mut a, "cell.set", json!({"cell": "A1", "input": "2"}));
+        run(&mut a, "cell.set", json!({"cell": "B1", "input": "=A1*3"}));
+        run(&mut a, "home.bold", json!({"range": "B1", "on": true}));
+        run(&mut a, "home.insertSheet", json!({"name": "Notes"}));
+        let doc = a.live_document();
+        assert_eq!(doc["sheets"][0]["cells"]["B1"]["formula"]["text"], "A1*3");
+        assert!(doc["sheets"][0]["cells"]["B1"].get("value").is_none(), "formula results are not shared");
+        assert_eq!(doc["sheets"][0]["cells"]["B1"]["style"]["font"]["bold"], true, "styles are inline");
+        assert_eq!(doc["sheets"][1]["id"], "Notes");
+
+        // Views are not shared.
+        run(&mut a, "view.zoom", json!({"percent": 150}));
+        run(&mut a, "view.gridlines", json!({"on": false}));
+        run(&mut a, "sheet.activate", json!({"sheet": 0}));
+        a.store_view_state();
+        assert_eq!(canonical(&a.live_document()), canonical(&doc));
+
+        let mut b = app();
+        run(&mut b, "home.insertSheet", json!({"name": "Notes"}));
+        run(&mut b, "view.zoom", json!({"percent": 70}));
+        let undo = b.session.active().unwrap().undo.len();
+        b.live_adopt(doc.clone()).unwrap();
+        assert_eq!(canonical(&b.live_document()), canonical(&doc), "the workbook arrives whole");
+        let d = b.session.active().unwrap();
+        assert_eq!(d.wb.sheets[d.wb.active_sheet].name, "Notes", "this person's active sheet");
+        assert_eq!(d.wb.sheets[1].zoom, 70, "and zoom stay");
+        assert_eq!(d.wb.sheets[0].value(CellRef::parse("B1").unwrap()), CellValue::Number(6.0), "results are recalculated");
+        assert_eq!(d.undo.len(), undo, "no native undo step");
+    }
+
+    #[test]
+    fn edits_and_styles_in_different_cells_merge_and_a_remote_change_waits_for_the_cell_editor() {
+        let mut a = app();
+        live::connect();
+        let base = a.live_document();
+        let mut b = app();
+        b.live_adopt(base.clone()).unwrap();
+        // Both add a new style: each copy gives it the next id in its own table.
+        run(&mut a, "cell.set", json!({"cell": "A1", "input": "1"}));
+        run(&mut a, "home.italic", json!({"range": "A1", "on": true}));
+        run(&mut b, "cell.set", json!({"cell": "C3", "input": "x"}));
+        run(&mut b, "home.bold", json!({"range": "C3", "on": true}));
+        let edited = b.live_document();
+        pin(Some(&a));
+        let merged = SheetApp::live_merge(&base, &a.live_document(), &edited).unwrap();
+        assert_eq!(merged["sheets"][0]["cells"]["A1"]["style"]["font"]["italic"], true);
+        assert_eq!(merged["sheets"][0]["cells"]["C3"]["style"]["font"]["bold"], true);
+        SheetApp::live_check(&merged).unwrap();
+
+        a.begin_edit(Some("5".into()), false);
+        assert!(!a.live_quiet());
+        live::queue(Some(canonical(&base)), canonical(&edited), Box::new(|r| assert_eq!(r, Ok(None))));
+        live::frame(&mut a);
+        assert_eq!(input(&a, "C3"), "", "a remote change waits while a cell is being typed");
+        a.editor = None;
+        a.session.mode = Mode::Ready;
+        live::frame(&mut a);
+        assert_eq!((input(&a, "A1"), input(&a, "C3")), ("1".into(), "x".into()));
+        live::disconnect();
+    }
+
+    #[test]
+    fn the_shared_workbook_stays_pinned_after_its_window_closes_and_undo_elsewhere_stays_native() {
+        let mut a = app();
+        run(&mut a, "cell.set", json!({"cell": "A1", "input": "shared"}));
+        let doc = a.live_document();
+        assert!(shared_active(&a.session));
+        a.session.new_workbook();
+        run(&mut a, "cell.set", json!({"cell": "A1", "input": "private"}));
+        assert!(!shared_active(&a.session), "Undo in another workbook is its own");
+        assert_eq!(canonical(&a.live_document()), canonical(&doc));
+        let shared = a.session.documents().iter().position(|d| d.title == "Book1").unwrap();
+        a.session.close_document(shared);
+        assert_eq!(canonical(&a.live_document()), canonical(&doc), "not the private workbook");
+        a.session.close_document(0);
+        assert_eq!(canonical(&a.live_document()), canonical(&doc), "never null");
+        let mut edited = doc.clone();
+        edited["sheets"][0]["cells"]["B2"] = json!({"value": {"t": "Number", "v": 7.0}});
+        a.live_adopt(edited.clone()).unwrap();
+        assert_eq!(canonical(&a.live_document()), canonical(&edited), "remote changes go on in it");
+    }
+
+    #[test]
+    fn a_merge_every_peer_would_refuse_is_a_conflict() {
+        let mut a = app();
+        run(&mut a, "home.insertSheet", json!({"name": "S2"}));
+        let base = a.live_document();
+        let mut b = app();
+        b.live_adopt(base.clone()).unwrap();
+        run(&mut b, "home.deleteSheet", json!({"sheet": 1}));
+        let edited = b.live_document();
+        pin(Some(&a));
+        run(&mut a, "home.deleteSheet", json!({"sheet": 0}));
+        let merged = SheetApp::live_merge(&base, &a.live_document(), &edited).unwrap();
+        assert_eq!(merged["sheets"], json!([]), "each deleted a different sheet");
+        assert!(SheetApp::live_check(&merged).is_err());
+        assert!(SheetApp::live_check(&Value::Null).is_err());
+        SheetApp::live_check(&base).unwrap();
+    }
+}
