+    #[test]
+    fn a_remote_change_waits_while_recording_and_undo_goes_to_the_session() {
+        let (mut a, mut b) = (demo(), demo());
+        let ctx = egui::Context::default();
+        playground_live::connect();
+        let base = canonical(&a.live_document());
+        toggle(&mut b, 0);
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(base), canonical(&b.live_document()), Box::new(move |r| to.set(r.is_ok())));
+        a.session.mixrec.seq = a.session.state.active_sequence;
+        frame(&mut a, &ctx);
+        assert!(!done.get() && enabled(&a, 0), "a mixer automation pass holds remote changes");
+        a.session.mixrec.seq = None;
+        frame(&mut a, &ctx);
+        assert!(done.get() && !enabled(&a, 0));
+        toggle(&mut a, 1);
+        crate::menus::invoke(&mut a, &ctx, "edit.undo", json!({})).unwrap();
+        assert!(!enabled(&a, 1), "Undo is the session's while connected");
+        assert_eq!(playground_live::activity().1, [false]);
+        playground_live::disconnect();
+        a.live_disconnected();
+        assert!(!a.session.history.can_undo());
+    }
