index 0000000..d67db37
--- /dev/null
+++ b/crates/ui-egui/src/live.rs
@@ -0,0 +1,182 @@
+//! Live editing in a Playground session (web only). The shared document is the open project (`Project`). What each
+//! person sees for themselves (selection, playheads, open sequences, Timeline zoom and scroll, panels, the Source
+//! monitor) already lives outside it, in the engine's `EditorState` and the UI. Imported media stay in the browser
+//! that imported them.
+
+use std::cell::Cell;
+use std::sync::Arc;
+
+use filmcraft_project::Project;
+use filmcraft_project::playground_live::{self, Live};
+use serde_json::Value;
+
+use crate::FilmcraftApp;
+
+thread_local! {
+    /// The last frame had a pointer button down or a text field focused.
+    static INPUT: Cell<bool> = const { Cell::new(false) };
+}
+
+/// The end of a frame: [`playground_live::frame`], with what egui knows of the pointer and the keyboard.
+pub fn frame(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    INPUT.set(ctx.input(|i| i.pointer.any_down()) || ctx.text_edit_focused());
+    playground_live::frame(app);
+}
+
+/// Gives each bin entry the id of the item or bin it holds (`keyed`), or takes it away again, so what two people add
+/// to one bin merges entry by entry.
+fn key_bins(bin: &mut Value, keyed: bool) {
+    for entry in bin.get_mut("children").and_then(Value::as_array_mut).into_iter().flatten() {
+        let Some(entry) = entry.as_object_mut() else { continue };
+        let id = entry.get("Item").cloned().or_else(|| entry.get("Bin").and_then(|b| b.get("id")).cloned());
+        match id {
+            Some(id) if keyed => entry.insert("id".into(), id),
+            _ => entry.remove("id"),
+        };
+        if let Some(bin) = entry.get_mut("Bin") {
+            key_bins(bin, keyed);
+        }
+    }
+}
+
+impl Live for FilmcraftApp {
+    const COUNTERS: &'static [&'static str] = &["next_id"];
+
+    fn live_document(&self) -> Value {
+        let mut doc = serde_json::to_value(&*self.session.project).unwrap_or_default();
+        if let Some(root) = doc.get_mut("root") {
+            key_bins(root, true);
+        }
+        doc
+    }
+
+    fn live_adopt(&mut self, mut document: Value) -> Result<(), String> {
+        if let Some(root) = document.get_mut("root") {
+            key_bins(root, false);
+        }
+        let project: Project = serde_json::from_value(document).map_err(|e| format!("Invalid project: {e}"))?;
+        let s = &mut self.session;
+        // A merge that breaks a sequence (clips overlapping, a sequence nested in itself) is a conflict.
+        for item in project.sequences() {
+            let check = |p: &Project| p.sequence(item.id).map(|q| q.check());
+            if let Some(Err(e)) = check(&project)
+                && !matches!(check(&s.project), Some(Err(_)))
+            {
+                return Err(format!("Conflict: {e}"));
+            }
+        }
+        if project.nest_cycle().is_some() && s.project.nest_cycle().is_none() {
+            return Err("Conflict: a sequence nested in itself".into());
+        }
+        s.project = Arc::new(project);
+        s.fix_state();
+        s.bump_view();
+        s.previews.live.publish_project(s.project.clone());
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        let s = &self.session;
+        !INPUT.get() && s.trim_play.dynamic.is_none() && !s.mixrec.active() && !s.mcrec.active() && !s.voiceover.recording()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.session.revision)
+    }
+
+    /// Undo steps from the session hold other people's edits: native Undo starts again from here.
+    fn live_disconnected(&mut self) {
+        let h = &mut self.session.history;
+        (h.undo, h.redo, h.merge_key) = (Vec::new(), Vec::new(), None);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use filmcraft_engine::Session;
+    use filmcraft_time::Tick;
+    use playground_live::canonical;
+    use serde_json::json;
+
+    fn demo() -> FilmcraftApp {
+        let mut s = Session::default();
+        s.execute("file.openDemoProject", json!({})).unwrap();
+        FilmcraftApp::new(s)
+    }
+
+    /// Enables or disables the first clip of a video track.
+    fn toggle(app: &mut FilmcraftApp, track: usize) -> filmcraft_project::ClipId {
+        let clip = app.session.active_sequence().unwrap().video_tracks[track].items[0].id;
+        app.session.execute("clip.enable", json!({"clips": [clip.0]})).unwrap();
+        clip
+    }
+
+    fn enabled(app: &FilmcraftApp, track: usize) -> bool {
+        app.session.active_sequence().unwrap().video_tracks[track].items[0].enabled
+    }
+
+    #[test]
+    fn the_shared_document_is_the_project_without_views() {
+        let mut app = demo();
+        let before = canonical(&app.live_document());
+        app.session.set_playhead(Tick(48_000));
+        app.session.state.selection = vec![app.session.active_sequence().unwrap().video_tracks[0].items[1].id];
+        app.session.state.open_sequences.clear();
+        assert_eq!(canonical(&app.live_document()), before, "views are not shared");
+        toggle(&mut app, 0);
+        let doc = app.live_document();
+        assert_ne!(canonical(&doc), before);
+        let first = &doc["root"]["children"][0];
+        assert!(first["id"] == first["Item"] || first["id"] == first["Bin"]["id"], "bin entries are keyed");
+    }
+
+    #[test]
+    fn adopting_keeps_views_is_no_undo_step_and_bins_merge_entry_by_entry() {
+        let (mut a, mut b) = (demo(), demo());
+        toggle(&mut b, 0);
+        a.session.set_playhead(Tick(48_000));
+        let (playhead, steps) = (a.session.playhead(), a.session.history.undo.len());
+        a.live_adopt(b.live_document()).unwrap();
+        assert_eq!(canonical(&a.live_document()), canonical(&b.live_document()));
+        assert!(!enabled(&a, 0));
+        assert_eq!((a.session.playhead(), a.session.history.undo.len()), (playhead, steps));
+        // Two people add a bin each (the ids differ while connected).
+        let base = a.live_document();
+        a.session.execute("file.newBin", json!({"name": "A"})).unwrap();
+        Arc::make_mut(&mut b.session.project).next_id += 100;
+        b.session.execute("file.newBin", json!({"name": "B"})).unwrap();
+        let merged = FilmcraftApp::live_merge(&base, &a.live_document(), &b.live_document()).unwrap();
+        a.live_adopt(merged).unwrap();
+        let names: Vec<_> = a.session.project.root.children.iter().filter_map(|e| match e {
+            filmcraft_project::BinEntry::Bin(b) => Some(b.name.as_str()),
+            _ => None,
+        }).collect();
+        assert!(names.contains(&"A") && names.contains(&"B"), "{names:?}");
+    }
+
+    #[test]
+    fn a_remote_change_waits_while_recording_and_undo_goes_to_the_session() {
+        let (mut a, mut b) = (demo(), demo());
+        let ctx = egui::Context::default();
+        playground_live::connect();
+        let base = canonical(&a.live_document());
+        toggle(&mut b, 0);
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(base), canonical(&b.live_document()), Box::new(move |r| to.set(r.is_ok())));
+        a.session.mixrec.seq = a.session.state.active_sequence;
+        frame(&mut a, &ctx);
+        assert!(!done.get() && enabled(&a, 0), "a mixer automation pass holds remote changes");
+        a.session.mixrec.seq = None;
+        frame(&mut a, &ctx);
+        assert!(done.get() && !enabled(&a, 0));
+        toggle(&mut a, 1);
+        crate::menus::invoke(&mut a, &ctx, "edit.undo", json!({})).unwrap();
+        assert!(!enabled(&a, 1), "Undo is the session's while connected");
+        assert_eq!(playground_live::activity().1, [false]);
+        playground_live::disconnect();
+        a.live_disconnected();
+        assert!(!a.session.history.can_undo());
+    }
+}
