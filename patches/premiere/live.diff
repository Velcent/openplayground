+/// Register a `Blob` at exactly `path` (media from a Playground session keep the path the project gives them);
+/// false, and nothing changes, when the path is taken.
+pub fn register_blob_at(path: &str, blob: web_sys::Blob) -> bool {
+    FS.with(|fs| {
+        let mut fs = fs.borrow_mut();
+        if fs.entries.contains_key(path) {
+            return false;
+        }
+        let (id, size) = (fs.next_id, blob.size() as u64);
+        fs.next_id += 1;
+        fs.blobs.insert(id, blob);
+        fs.entries.insert(path.to_string(), Entry::Blob { id, size });
+        true
+    })
+}
+
 /// Put bytes at a path (no download).
 pub fn put(path: &str, data: Vec<u8>) {
