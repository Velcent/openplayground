+    /// Adds a copy of V1's last clip, `gap` clip durations after it, with id `id`.
+    fn append(app: &mut FilmcraftApp, id: u64, gap: i64) {
+        let seq = app.session.state.active_sequence.unwrap();
+        let track = &mut Arc::make_mut(&mut app.session.project).sequence_mut(seq).unwrap().video_tracks[0];
+        let mut clip = track.items.last().unwrap().clone();
+        (clip.id, clip.link, clip.start) = (filmcraft_project::ClipId(id), None, track.end() + Tick(clip.duration.0 * gap));
+        track.items.push(clip);
+    }
