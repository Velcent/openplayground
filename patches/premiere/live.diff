+//! Live editing in a Playground session (`patches/premiere.yaml` wires it in): the web app wrapped so each frame ends
+//! with the session's work, the adapter attached to the running app, and the media the shared project refers to
+//! read from and installed into the browser's file table ([`crate::fs`]). The model side is
+//! `filmcraft_ui_egui::live`.
+
+use filmcraft_engine::Services;
+use filmcraft_engine::project::playground_live::web;
+use filmcraft_ui_egui::FilmcraftApp;
+use wasm_bindgen::prelude::*;
+
+use crate::{WebApp, fs};
+
+/// The web app, ending each frame with live editing's ([`filmcraft_ui_egui::live::frame`]).
+pub struct Shell(pub WebApp);
+
+impl eframe::App for Shell {
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.0.ui(ui, frame);
+        filmcraft_ui_egui::live::frame(&mut self.0.app, ui.ctx());
+    }
+
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.0.logic(ctx, frame);
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.0.raw_input_hook(ctx, raw_input);
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.0.save(storage);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.0.auto_save_interval()
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.0.clear_color(visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        self.0.persist_egui_memory()
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
+
+/// This page shows a Playground session (`?pg-session=<room>`): the session's project is not this browser's own, so
+/// it neither reopens nor overwrites the browser's unsaved-changes snapshot ([`crate::recovery`]).
+pub fn in_session() -> bool {
+    let search = web_sys::window().and_then(|w| w.location().search().ok()).unwrap_or_default();
+    web_sys::UrlSearchParams::new_with_str(&search).is_ok_and(|p| p.has("pg-session"))
+}
+
+/// Offers the running app to a Playground session (`runner` has started it).
+pub fn attach(runner: &eframe::WebRunner) {
+    let live = runner.clone();
+    let attached = web::attach::<FilmcraftApp>(
+        concat!("premiere:1:", env!("CARGO_PKG_VERSION")),
+        move |with| live.app_mut::<Shell>().map(|mut shell| with(&mut shell.0.app)).is_some(),
+        crate::repaint,
+    )
+    .and_then(|()| share_media());
+    if let Err(e) = attached {
+        log::error!("live editing: {e:?}");
+    }
+}
+
+/// The media the shared project refers to travel as session files: read as the `Blob`s this browser has, and media
+/// another person imported installed under the project's path (imported files kept in OPFS like an import), without an
+/// edit. A path this browser uses already keeps its own file.
+fn share_media() -> Result<(), JsValue> {
+    let adapter = js_sys::Reflect::get(&js_sys::global(), &"playgroundLiveAdapter".into())?;
+    let read = |path: String| fs::blob(&path).ok_or_else(|| JsValue::from_str("Missing media"));
+    let read = Closure::<dyn Fn(String) -> Result<web_sys::Blob, JsValue>>::new(read);
+    js_sys::Reflect::set(&adapter, &"readAsset".into(), &read.into_js_value())?;
+    let write = |path: String, _name: String, bytes: js_sys::Uint8Array| -> Result<(), JsValue> {
+        if fs::WebServices.file_size(&path).is_ok() {
+            return Ok(());
+        }
+        match path.strip_prefix("/files/") {
+            // Free, so registering the name gives exactly this path.
+            Some(name) => {
+                let file = web_sys::File::new_with_u8_array_sequence(&js_sys::Array::of1(&bytes), name)?;
+                let at = fs::register_blob(name, file.clone().into());
+                crate::recovery::keep_media(&at, &file);
+            }
+            None => fs::put(&path, bytes.to_vec()),
+        }
+        crate::post(move |w, _| filmcraft_ui_egui::live::media_arrived(&mut w.app, &path));
+        Ok(())
+    };
+    let write = Closure::<dyn Fn(String, String, js_sys::Uint8Array) -> Result<(), JsValue>>::new(write);
+    js_sys::Reflect::set(&adapter, &"writeAsset".into(), &write.into_js_value())?;
+    Ok(())
+}
