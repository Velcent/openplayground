+    #[test]
+    fn adopting_keeps_views_is_no_undo_step_and_bins_merge_entry_by_entry() {
+        let (mut a, mut b) = (demo(), demo());
+        toggle(&mut b, 0);
+        a.session.set_playhead(Tick(48_000));
+        local(&mut a, "mine");
+        let (playhead, steps) = (a.session.playhead(), a.session.history.undo.len());
+        a.live_adopt(b.live_document()).unwrap();
+        assert_eq!(canonical(&a.live_document()), canonical(&b.live_document()));
+        assert!(!enabled(&a, 0));
+        assert_eq!((a.session.playhead(), a.session.history.undo.len()), (playhead, steps));
+        assert_eq!(a.session.project.settings.renderer, "mine");
+        assert!(a.session.active_sequence().unwrap().audio_tracks[0].mixer.record_arm);
+        // Two people add a bin each (the ids differ while connected).
+        let base = a.live_document();
+        a.session.execute("file.newBin", json!({"name": "A"})).unwrap();
+        Arc::make_mut(&mut b.session.project).next_id += 100;
+        b.session.execute("file.newBin", json!({"name": "B"})).unwrap();
+        let merged = FilmcraftApp::live_merge(&base, &a.live_document(), &b.live_document()).unwrap();
+        a.live_adopt(merged).unwrap();
+        let names: Vec<_> = a
