+    fn presence_is_the_sequence_the_timeline_pointer_as_track_and_time_and_the_selected_clips() {
+        let mut app = demo();
+        let seq = app.session.active_sequence().unwrap();
+        let (v1, clip) = (seq.video_tracks[0].id, seq.video_tracks[0].items[1].id);
+        let content = Rect::from_min_max(pos2(100.0, 50.0), pos2(1100.0, 450.0));
+        let rect = Rect::from_min_max(pos2(100.0, 50.0), pos2(1100.0, 100.0));
+        let row = crate::panels::timeline::Row { track: v1, kind: filmcraft_project::TrackKind::Video, index: 0, rect, lane: false };
+        app.tl.layout = Some(Layout { content, ruler: content, rows: vec![row], pps: 100.0, scroll: 2.0, split_y: 300.0 });
+        app.session.state.selection = vec![clip];
+        POINTER.set(Some(pos2(350.0, 75.0)));
+        let sequence = app.session.state.active_sequence.unwrap().0;
+        let pointer = json!({"track": v1.0, "time": Tick::from_seconds_f64(4.5).0});
+        assert_eq!(app.live_presence(), json!({"sequence": sequence, "pointer": pointer, "selection": [clip.0]}));
+        POINTER.set(Some(pos2(350.0, 200.0)));
+        assert_eq!(app.live_presence(), json!({"sequence": sequence, "selection": [clip.0]}), "no track under the pointer");
+    }
