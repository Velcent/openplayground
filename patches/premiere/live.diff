+    #[test]
+    fn imported_media_are_shared_by_path_and_come_back_when_they_arrive() {
+        let mut app = demo();
+        let dir = std::env::temp_dir().join(format!("filmcraft-live-media-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("tone.wav").to_string_lossy().into_owned();
+        let wav = filmcraft_media::wav::write_wav16(&[0.25; 4800], 1, 48_000);
+        std::fs::write(&path, &wav).unwrap();
+        let out = app.session.execute("file.import", json!({"paths": [path]})).unwrap();
+        let item = filmcraft_project::ItemId(out["items"][0].as_u64().unwrap());
+        assert_eq!(app.live_assets(), [(path.clone(), "tone.wav".into(), true)], "the demo's generators are not shared");
+        assert_eq!(FilmcraftApp::live_assets_of(&app.live_document()), [path.clone()]);
+        // Another person's browser: the file has not arrived yet, so the item shows the offline slate.
+        std::fs::remove_file(&path).unwrap();
+        let s = &app.session;
+        s.media.remove(item);
+        s.media.source_for(&s.project, item, &*s.services);
+        assert!(s.media.offline_status(item).is_some() && !app.live_assets()[0].2);
+        let (doc, steps) = (canonical(&app.live_document()), app.session.history.undo.len());
+        std::fs::write(&path, &wav).unwrap();
+        media_arrived(&mut app, &path);
+        let s = &app.session;
+        s.media.source_for(&s.project, item, &*s.services);
+        assert!(s.media.offline_status(item).is_none() && app.live_assets()[0].2);
+        assert_eq!((canonical(&app.live_document()), app.session.history.undo.len()), (doc, steps), "no edit");
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
