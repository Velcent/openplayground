+/// Live editing in a Playground session: the media the shared project refers to travel as session files. They are
+/// read as the `Blob`s this browser has, and media another person imported are installed under the project's path,
+/// kept in OPFS like an import, without an edit. A path this browser uses already keeps its own file.
+pub fn share_media() -> Result<(), JsValue> {
+    let adapter = js_sys::Reflect::get(&js_sys::global(), &"playgroundLiveAdapter".into())?;
+    let read = |path: String| fs::blob(&path).ok_or_else(|| JsValue::from_str("Missing media"));
+    js_sys::Reflect::set(&adapter, &"readAsset".into(), &Closure::<dyn Fn(String) -> Result<web_sys::Blob, JsValue>>::new(read).into_js_value())?;
+    let write = |path: String, _name: String, bytes: js_sys::Uint8Array| -> Result<(), JsValue> {
+        let file = web_sys::File::new_with_u8_array_sequence(&js_sys::Array::of1(&bytes), path.rsplit('/').next().unwrap_or(&path))?;
+        if fs::register_blob_at(&path, file.clone().into()) {
+            crate::recovery::keep_media(&path, &file);
+            crate::post(move |w, _| filmcraft_ui_egui::live::media_arrived(&mut w.app, &path));
+        }
+        Ok(())
+    };
+    js_sys::Reflect::set(&adapter, &"writeAsset".into(), &Closure::<dyn Fn(String, String, js_sys::Uint8Array) -> Result<(), JsValue>>::new(write).into_js_value())?;
+    Ok(())
+}
