+//! Live editing in a Playground session (web only). The shared document is the open project (`Project`). What each
+//! person sees for themselves (selection, playheads, open sequences, Timeline zoom and scroll, panels, the Source
+//! monitor) already lives outside it, in the engine's `EditorState` and the UI; so does what belongs to this machine:
+//! the renderer, the scratch disks and record-armed tracks. Imported media (files the project refers to by path,
+//! `/files/<name>` on the web) travel as session files: the web host reads and installs their bytes.
+//! Presence: each person's sequence, Timeline pointer (track and time), playhead, selected clips and the clip or
+//! transition drag under way, drawn on the others' Timeline in that person's color and eased toward where it last was;
+//! a playhead flies a flag with its person's name at the top of the ruler.
+
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeSet, HashMap};
+use std::sync::Arc;
+
+use egui::emath::GuiRounding as _;
+use egui::{Color32, Pos2, Rect, Shape, Stroke, StrokeKind, Vec2, pos2, vec2};
+use filmcraft_project::playground_live::{self, Live, Presence};
+use filmcraft_project::{ClipId, MediaClip, MediaRef, Project, ProjectItem, ProjectSettings, Sequence};
+use filmcraft_time::Tick;
+use serde_json::{Map, Value, json};
+
+use crate::FilmcraftApp;
+use crate::panels::timeline::{Drag, Layout, Row, preview_drag};
+use crate::theme::Tokens;
+
+thread_local! {
+    /// The last frame had a pointer button down or a text field focused.
+    static INPUT: Cell<bool> = const { Cell::new(false) };
+    /// Where the pointer was at the end of the last frame that showed the Timeline.
+    static POINTER: Cell<Option<Pos2>> = const { Cell::new(None) };
+    /// The Timeline was shown this frame ([`paint_timeline`]).
+    static SHOWN: Cell<bool> = const { Cell::new(false) };
+    /// The others in the session, with their marks as this person's Timeline last drew them.
+    static OTHERS: RefCell<Vec<(Presence, Shown)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Clips sent as this person's selection, or as a drag's, at most.
+const MAX_SELECTION: usize = 50;
+
+/// Project settings that belong to this machine.
+const LOCAL_SETTINGS: [&str; 2] = ["renderer", "scratch"];
+
+/// Lists the model keeps in time order (`start`).
+const TIMED: [&str; 4] = ["items", "transitions", "markers", "captions"];
+
+/// How long the others' marks take to go most (1 - 1/e) of the way to their latest place, in seconds.
+const EASE: f64 = 0.08;
+
+/// The most characters of a name tag.
+const MAX_NAME: usize = 24;
+
+/// The end of a frame: [`playground_live::frame`], with what egui knows of the pointer and the keyboard.
+pub fn frame(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    INPUT.set(ctx.input(|i| i.pointer.any_down()) || ctx.text_edit_focused());
+    POINTER.set(if SHOWN.take() { ctx.pointer_hover_pos() } else { None });
+    playground_live::frame(app);
+}
+
+/// Another person's moving marks as this Timeline last drew them, eased toward their latest presence: the pointer
+/// (seconds, row), the playhead (seconds) and a drag's ghosts (whether a transition; start, row, duration). A row counts
+/// the tracks from the top, plus the fraction down one; -1 is the ruler. All in the sequence's terms, so this person's
+/// own scrolling and zooming never lag.
+#[derive(Default)]
+struct Shown {
+    pointer: Option<[f64; 2]>,
+    playhead: Option<[f64; 1]>,
+    ghosts: Vec<(bool, [f64; 3])>,
+}
+
+impl Shown {
+    /// `dt` seconds on toward `to`; `px`: points a second and a row; `far`: a quarter of the view's width and height,
+    /// past which a mark goes at once, as it does when first seen or when the drag's ghosts change. Whether a mark is
+    /// still on its way.
+    fn step(&mut self, to: Shown, dt: f32, [x, y]: [f64; 2], [fx, fy]: [f64; 2]) -> bool {
+        let k = 1.0 - (-f64::from(dt.clamp(0.0, 0.1)) / EASE).exp();
+        let mut moving = ease_to(&mut self.pointer, to.pointer, k, [x, y], [fx, fy]);
+        moving |= ease_to(&mut self.playhead, to.playhead, k, [x], [fx]);
+        if self.ghosts.len() == to.ghosts.len() && self.ghosts.iter().zip(&to.ghosts).all(|(s, t)| s.0 == t.0) {
+            for (s, t) in self.ghosts.iter_mut().zip(to.ghosts) {
+                moving |= ease(&mut s.1, t.1, k, [x, y, x], [fx, fy, fx]);
+            }
+        } else {
+            self.ghosts = to.ghosts;
+        }
+        moving
+    }
+}
+
+/// [`ease`], where a mark that was not there or is gone goes at once.
+fn ease_to<const N: usize>(s: &mut Option<[f64; N]>, t: Option<[f64; N]>, k: f64, px: [f64; N], far: [f64; N]) -> bool {
+    if let (Some(s), Some(t)) = (s.as_mut(), t) {
+        return ease(s, t, k, px, far);
+    }
+    *s = t;
+    false
+}
+
+/// `s` moved `k` of the way to `t`; all of it after a jump wider than `far` points on an axis, or once under half a
+/// point remains (`px`: points a unit). Whether it is still on its way.
+fn ease<const N: usize>(s: &mut [f64; N], t: [f64; N], k: f64, px: [f64; N], far: [f64; N]) -> bool {
+    let off = |s: &[f64; N], i: usize| ((t[i] - s[i]) * px[i]).abs();
+    if (0..N).any(|i| !(off(s, i) <= far[i])) {
+        *s = t;
+        return false;
+    }
+    for i in 0..N {
+        s[i] += (t[i] - s[i]) * k;
+    }
+    let moving = (0..N).any(|i| off(s, i) >= 0.5);
+    if !moving {
+        *s = t;
+    }
+    moving
+}
+
+/// Where a person's presence `state` puts their marks, in [`Shown`]'s terms (`row`: a track's row from the top).
+/// Remote data: what does not resolve is left out.
+fn targets(state: &Value, row: impl Fn(u64) -> Option<f64>) -> Shown {
+    let seconds = |v: &Value| v.as_i64().map(|t| Tick(t).seconds());
+    let down = |v: &Value| v.as_f64().filter(|y| (0.0..=1.0).contains(y)).unwrap_or(0.5);
+    let p = &state["pointer"];
+    let on = match p.get("track") {
+        Some(track) => track.as_u64().and_then(&row),
+        None => Some(-1.0),
+    };
+    let ghost = |g: &Value, transition| Some((transition, [seconds(&g[1])?, row(g[0].as_u64()?)?, seconds(&g[2])?.max(0.0)]));
+    Shown {
+        pointer: seconds(&p["time"]).zip(on).map(|(t, on)| [t, on + down(&p["y"])]),
+        playhead: seconds(&state["playhead"]).map(|t| [t]),
+        ghosts: (state["ghosts"].as_array().into_iter().flatten().take(MAX_SELECTION))
+            .filter_map(|g| ghost(g, false))
+            .chain(ghost(&state["transition"], true))
+            .collect(),
+    }
+}
+
+/// The others on this person's Timeline, in their colors, when they show the same sequence: their playheads and the
+/// ghosts of their drags, then outlines around their selected clips (where the clips are in this person's project),
+/// then their pointers. Called after the Timeline drew its clips and ruler, before its own playhead (`layout` is this
+/// frame's), so this person's playhead stays on top.
+pub fn paint_timeline(app: &FilmcraftApp, ui: &egui::Ui, layout: &Layout) {
+    SHOWN.set(true);
+    let (Some(id), Some(seq)) = (app.session.state.active_sequence, app.session.active_sequence()) else { return };
+    let (content, ruler) = (layout.content, layout.ruler);
+    let mut rows: Vec<&Row> = layout.rows.iter().collect();
+    rows.sort_by(|a, b| a.rect.min.y.total_cmp(&b.rect.min.y));
+    let row = |track: u64| rows.iter().position(|r| r.track.0 == track).map(|i| i as f64);
+    // The band of row `v`, moved down by its fraction: the ruler's, or a track's.
+    let band = |v: f64| {
+        if v < 0.0 {
+            return Some(ruler.translate(vec2(0.0, (v.max(-1.0) + 1.0) as f32 * ruler.height())));
+        }
+        let i = (v as usize).min(rows.len().checked_sub(1)?);
+        let r = rows[i].rect;
+        Some(r.translate(vec2(0.0, (v - i as f64) as f32 * r.height())))
+    };
+    // Remote numbers: x clamped to just past the visible area.
+    let x = |t: Tick| layout.x_of(t).clamp(content.min.x - 8.0, content.max.x + 8.0);
+    let at = |s: f64| x(Tick::from_seconds_f64(s));
+    // Video rows show above the divider, audio rows below it.
+    let area = |r: Rect| match r.center().y < layout.split_y {
+        true => Rect::from_x_y_ranges(content.x_range(), content.min.y..=layout.split_y),
+        false => Rect::from_x_y_ranges(content.x_range(), layout.split_y..=content.max.y),
+    };
+    let marks = ui.painter().with_clip_rect(content);
+    let tall = ui.painter().with_clip_rect(Rect::from_min_max(pos2(content.min.x, ruler.min.y), content.max));
+    let px = [layout.pps, rows.first().map_or(30.0, |r| f64::from(r.rect.height()))];
+    let far = [f64::from(content.width()) / 4.0, f64::from(content.height()) / 4.0];
+    let dt = ui.input(|i| i.stable_dt);
+    let mut moving = false;
+    OTHERS.with_borrow_mut(|others| {
+        let mut here: Vec<_> = others.iter_mut().filter(|(o, _)| o.state["sequence"].as_u64() == Some(id.0)).collect();
+        for (o, shown) in &mut here {
+            moving |= shown.step(targets(&o.state, row), dt, px, far);
+            let color = Color32::from_rgb(o.color[0], o.color[1], o.color[2]);
+            if let Some(at) = shown.playhead.map(|[s]| layout.x_of(Tick::from_seconds_f64(s))).filter(|x| content.x_range().contains(*x)) {
+                playhead(&tall, tall.round_to_pixel_center(at), [ruler.min.y + 1.0, content.max.y], content.max.x, color, &o.name);
+            }
+            for &(transition, [s, v, d]) in &shown.ghosts {
+                let Some(r) = band(v) else { continue };
+                let (x0, x1) = (at(s), at(s + d));
+                let top = if transition { 17.0 } else { 1.0 };
+                let body = Rect::from_min_max(pos2(x0, r.min.y + top), pos2(x1.max(x0 + 1.0), r.max.y - 1.0));
+                let edge = Stroke::new(1.5, color.gamma_multiply(0.85));
+                marks.with_clip_rect(area(r)).rect(body, 0.0, color.gamma_multiply(0.28), edge, StrokeKind::Inside);
+            }
+        }
+        for (o, _) in &here {
+            let color = Color32::from_rgb(o.color[0], o.color[1], o.color[2]);
+            for clip in o.state["selection"].as_array().into_iter().flatten().take(MAX_SELECTION).filter_map(Value::as_u64) {
+                let Some((track, item)) = seq.find_item(ClipId(clip)) else { continue };
+                let Some(r) = layout.rows.iter().find(|r| r.track == track) else { continue };
+                // The Timeline's own selection border (draw_clip), in their color.
+                let (x0, x1) = (x(item.start), x(item.end()));
+                let body = Rect::from_min_max(pos2(x0, r.rect.min.y + 1.0), pos2(x1.max(x0 + 1.0), r.rect.max.y - 1.0));
+                marks.with_clip_rect(area(r.rect)).rect_stroke(body, 0.0, Stroke::new(2.0, color), StrokeKind::Inside);
+            }
+        }
+        for (o, shown) in &here {
+            let tip = shown.pointer.and_then(|[s, v]| Some(pos2(layout.x_of(Tick::from_seconds_f64(s)), band(v)?.min.y)));
+            if let Some(tip) = tip.filter(|p| tall.clip_rect().contains(*p)) {
+                cursor(ui.painter(), tip, Color32::from_rgb(o.color[0], o.color[1], o.color[2]), &o.name);
+            }
+        }
+    });
+    if moving {
+        ui.ctx().request_repaint();
+    }
+}
+
+/// A pointer at `tip` with a name tag, in `color` (the look every Playground app shares).
+fn cursor(painter: &egui::Painter, tip: Pos2, color: Color32, name: &str) {
+    const ARROW: [[f32; 2]; 7] = [[0.0, 0.0], [0.0, 16.0], [4.5, 12.2], [7.6, 18.6], [10.4, 17.3], [7.3, 11.0], [12.5, 11.0]];
+    // Star-shaped around the tip (its first point), which is what a filled path's triangle fan needs.
+    let arrow = |d: Vec2| ARROW.iter().map(|&[x, y]| tip + d + vec2(x, y)).collect::<Vec<_>>();
+    let shadow = Color32::from_black_alpha(64);
+    painter.add(Shape::convex_polygon(arrow(vec2(0.0, 1.0)), shadow, Stroke::new(1.5, shadow)));
+    painter.add(Shape::convex_polygon(arrow(Vec2::ZERO), color, Stroke::new(1.5, Color32::WHITE)));
+    if name.is_empty() {
+        return;
+    }
+    let text = tag_text(painter, name, color);
+    let tag = Rect::from_min_size((tip + vec2(12.0, 15.0)).round_to_pixels(painter.pixels_per_point()), text.size() + 2.0 * PAD);
+    painter.rect_filled(tag, 6.0, color);
+    painter.galley(tag.min + PAD, text, color);
+}
+
+/// The space around a name tag's text.
+const PAD: Vec2 = vec2(7.0, 3.0);
+
+/// A name tag's text: the name cut to [`MAX_NAME`] characters, 12 px semibold, white or (on a light `color`) near-black.
+fn tag_text(painter: &egui::Painter, name: &str, color: Color32) -> Arc<egui::Galley> {
+    let name: String = match name.chars().count() > MAX_NAME {
+        true => name.chars().take(MAX_NAME - 1).chain(['…']).collect(),
+        false => name.to_owned(),
+    };
+    let l = egui::Rgba::from(color);
+    let ink = match 0.2126 * l.r() + 0.7152 * l.g() + 0.0722 * l.b() > 0.55 {
+        true => Color32::from_gray(0x11),
+        false => Color32::WHITE,
+    };
+    painter.layout_no_wrap(name, Tokens::semibold(12.0), ink)
+}
+
+/// Another person's playhead at `x` (a pixel centre), from `top` to `bottom`: a line 1.5 px wide in 85% of their
+/// color, and at its top a flag with their name, in the shared tag look ([`flag`]).
+fn playhead(painter: &egui::Painter, x: f32, [top, bottom]: [f32; 2], right: f32, color: Color32, name: &str) {
+    painter.line_segment([pos2(x, top), pos2(x, bottom)], Stroke::new(1.5, color.gamma_multiply(0.85)));
+    if name.is_empty() {
+        return;
+    }
+    let text = tag_text(painter, name, color);
+    let (rect, left) = flag(x, top, text.size() + 2.0 * PAD, right);
+    let rect = rect.round_to_pixels(painter.pixels_per_point());
+    // Square where it meets the line.
+    let corners = match left {
+        true => egui::CornerRadius { ne: 0, ..egui::CornerRadius::same(6) },
+        false => egui::CornerRadius { nw: 0, ..egui::CornerRadius::same(6) },
+    };
+    painter.rect_filled(rect, corners, color);
+    painter.galley(rect.min + PAD, text, color);
+}
+
+/// Where a playhead's flag of `size` goes on its line at `x` from `top`: hanging right of the line, flush with its left
+/// edge, or left of it (`true`) where it would pass `right`.
+fn flag(x: f32, top: f32, size: Vec2, right: f32) -> (Rect, bool) {
+    let left = x + size.x > right;
+    let x = if left { x + 0.75 - size.x } else { x - 0.75 };
+    (Rect::from_min_size(pos2(x, top), size), left)
+}
+
+/// The clips a drag under way has elsewhere so far ([`preview_drag`], what this person's Timeline shows), each as
+/// `[track, start, duration]` (ticks), in clip order; and a transition dragged by its middle or an end.
+fn dragged(app: &FilmcraftApp, seq: &Sequence, state: &mut Map<String, Value>) {
+    let (mut moved, mut edited) = (HashMap::new(), HashMap::new());
+    preview_drag(app, seq, &mut moved, &mut edited);
+    let mut ghosts: Vec<_> = moved.into_iter().filter_map(|(c, (start, len, to))| Some((c, to.or(seq.find_item(c).map(|f| f.0))?, start, len))).collect();
+    ghosts.sort_by_key(|g| g.0.0);
+    if !ghosts.is_empty() {
+        let ghosts: Vec<_> = ghosts.into_iter().take(MAX_SELECTION).map(|(_, track, start, len)| json!([track.0, start.0, len.0])).collect();
+        state.insert("ghosts".into(), ghosts.into());
+    }
+    if let Some(Drag::Transition { id, start, duration, .. }) = &app.tl.drag
+        && let Some(track) = seq.all_tracks().find(|t| t.transitions.iter().any(|t| t.id == *id))
+    {
+        state.insert("transition".into(), json!([track.id.0, start.0, duration.0]));
+    }
+}
+
+/// The files a media item reads: its media and its proxy (generators have none).
+fn files(m: &MediaClip) -> impl Iterator<Item = &str> {
+    [Some(&m.media), m.proxy.as_ref()].into_iter().flatten().filter_map(|r| match r {
+        MediaRef::File { path } => Some(path.as_str()),
+        MediaRef::Generator(_) => None,
+    })
+}
+
+/// The name another person's media file installs under: the `<name>` of an id in FilmCraft's own `/files/<name>` form,
+/// which the browser's file table registers at exactly that id. Anything else stores nothing: it would land at another
+/// path, still count as missing, and arrive again on every session change.
+pub fn session_file_name(id: &str) -> Option<&str> {
+    id.strip_prefix("/files/").filter(|n| !n.contains(['/', '\\']) && !matches!(*n, "" | "." | ".."))
+}
+
+/// Media someone else imported arrived at `path` (the web host registered them): the items that showed them missing
+/// read them again. Not an edit: the project refers to them already.
+pub fn media_arrived(app: &mut FilmcraftApp, path: &str) {
+    let s = &mut app.session;
+    for item in s.project.items.values().filter(|i| i.as_media().is_some_and(|m| files(m).any(|f| f == path))) {
+        s.media.remove(item.id);
+    }
+    filmcraft_engine::relink::refresh(s);
+    s.bump_view();
+}
+
+/// Gives each bin entry the id of the item or bin it holds (`keyed`), or takes it away again, so what two people add
+/// to one bin merges entry by entry.
+fn key_bins(bin: &mut Value, keyed: bool) {
+    for entry in bin.get_mut("children").and_then(Value::as_array_mut).into_iter().flatten() {
+        let Some(entry) = entry.as_object_mut() else { continue };
+        let id = entry.get("Item").cloned().or_else(|| entry.get("Bin").and_then(|b| b.get("id")).cloned());
+        match id {
+            Some(id) if keyed => entry.insert("id".into(), id),
+            _ => entry.remove("id"),
+        };
+        if let Some(bin) = entry.get_mut("Bin") {
+            key_bins(bin, keyed);
+        }
+    }
+}
+
+/// Puts back in time order the lists a merge combined from both sides: two people's clips added after the same one
+/// come in the order of the sides, and clips must stay sorted by start (the Timeline searches them). A value taken
+/// whole from one side is that person's own and stays as it is.
+fn by_start(key: &str, merged: &mut Value, current: Option<&Value>, edited: Option<&Value>) {
+    if current == Some(&*merged) || edited == Some(&*merged) {
+        return;
+    }
+    match merged {
+        Value::Object(map) => {
+            for (k, v) in map.iter_mut() {
+                by_start(k, v, current.and_then(|c| c.get(k)), edited.and_then(|e| e.get(k)));
+            }
+        }
+        Value::Array(list) => {
+            fn by_id<'a>(side: Option<&'a Value>, id: Option<&Value>) -> Option<&'a Value> {
+                let id = id?;
+                side?.as_array()?.iter().find(|x| x.get("id") == Some(id))
+            }
+            for item in list.iter_mut() {
+                let id = item.get("id").cloned();
+                by_start("", item, by_id(current, id.as_ref()), by_id(edited, id.as_ref()));
+            }
+            if TIMED.contains(&key) && list.iter().all(|x| x.get("start").is_some_and(Value::is_i64)) {
+                list.sort_by_key(|x| (x["start"].as_i64(), x.get("id").and_then(Value::as_u64)));
+            }
+        }
+        _ => {}
+    }
+}
+
+/// The project a shared document describes, with this machine's `local` settings.
+fn project_of(mut document: Value, local: &ProjectSettings) -> Result<Project, String> {
+    if let Some(root) = document.get_mut("root") {
+        key_bins(root, false);
+    }
+    let local = serde_json::to_value(local).map_err(|e| e.to_string())?;
+    if let Some(settings) = document.get_mut("settings").and_then(Value::as_object_mut) {
+        for key in LOCAL_SETTINGS {
+            settings.insert(key.into(), local[key].clone());
+        }
+    }
+    serde_json::from_value(document).map_err(|e| format!("Invalid project: {e}"))
+}
+
+impl Live for FilmcraftApp {
+    const COUNTERS: &'static [&'static str] = &["next_id"];
+
+    fn live_document(&self) -> Value {
+        let mut doc = serde_json::to_value(&*self.session.project).unwrap_or_default();
+        if let Some(root) = doc.get_mut("root") {
+            key_bins(root, true);
+        }
+        if let Some(settings) = doc.get_mut("settings").and_then(Value::as_object_mut) {
+            for key in LOCAL_SETTINGS {
+                settings.remove(key);
+            }
+        }
+        let sequences = doc.get_mut("items").and_then(Value::as_object_mut).into_iter().flat_map(|items| items.values_mut());
+        for q in sequences.filter_map(|item| item.get_mut("kind")?.get_mut("Sequence")?.as_object_mut()) {
+            let tracks = q.iter_mut().filter(|(k, _)| matches!(k.as_str(), "video_tracks" | "audio_tracks" | "submix_tracks"));
+            for track in tracks.flat_map(|(_, list)| list.as_array_mut().into_iter().flatten()) {
+                if let Some(mixer) = track.get_mut("mixer").and_then(Value::as_object_mut) {
+                    mixer.remove("record_arm");
+                }
+            }
+        }
+        doc
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        let mut merged = playground_live::merge(base, current, edited, Self::COUNTERS)?;
+        by_start("", &mut merged, Some(current), Some(edited));
+        Ok(merged)
+    }
+
+    /// What every peer can install: a project whose sequences keep their invariants (clips sorted, none overlapping,
+    /// none nested in itself).
+    fn live_check(document: &Value) -> Result<(), String> {
+        let project = project_of(document.clone(), &ProjectSettings::default())?;
+        for item in project.sequences() {
+            if let Some(Err(e)) = project.sequence(item.id).map(|q| q.check()) {
+                return Err(format!("Conflict: {e}"));
+            }
+        }
+        match project.nest_cycle() {
+            Some(_) => Err("Conflict: a sequence nested in itself".into()),
+            None => Ok(()),
+        }
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let s = &mut self.session;
+        let mut project = project_of(document, &s.project.settings)?;
+        for item in project.items.values_mut() {
+            let old = s.project.sequence(item.id);
+            let Some(q) = item.as_sequence_mut() else { continue };
+            for t in q.video_tracks.iter_mut().chain(&mut q.audio_tracks).chain(&mut q.submix_tracks) {
+                let mut was = old.into_iter().flat_map(|o| o.video_tracks.iter().chain(&o.audio_tracks).chain(&o.submix_tracks));
+                t.mixer.record_arm = was.find(|o| o.id == t.id).is_some_and(|o| o.mixer.record_arm);
+            }
+        }
+        s.project = Arc::new(project);
+        s.fix_state();
+        s.bump_view();
+        s.previews.live.publish_project(s.project.clone());
+        Ok(())
+    }
+
+    /// The files the project refers to, by path: two different files imported under one name by two people each keep
+    /// their own.
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let s = &self.session;
+        let paths: BTreeSet<&str> = s.project.items.values().filter_map(ProjectItem::as_media).flat_map(files).collect();
+        let name = |p: &str| p.rsplit(['/', '\\']).next().unwrap_or(p).to_string();
+        paths.into_iter().map(|p| (p.to_string(), name(p), s.services.file_size(p).is_ok())).collect()
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        let media = document["items"].as_object().into_iter().flat_map(|items| items.values()).filter_map(|i| i["kind"].get("Media"));
+        let paths: BTreeSet<&str> = media.flat_map(|m| [&m["media"], &m["proxy"]]).filter_map(|r| r["File"]["path"].as_str()).collect();
+        paths.into_iter().map(String::from).collect()
+    }
+
+    /// The sequence shown; the Timeline pointer as a time and how far down a track (or the ruler) it is; the playhead;
+    /// the selected clips; and a drag under way, where it has its clips or transition so far ([`dragged`]).
+    fn live_presence(&self) -> Value {
+        let Some(sequence) = self.session.state.active_sequence else { return Value::Null };
+        let mut state = Map::new();
+        state.insert("sequence".into(), json!(sequence.0));
+        if let Some((p, l)) = POINTER.get().zip(self.tl.layout.as_ref()) {
+            // How far down `r` the pointer is, in thousandths.
+            let down = |r: Rect| (f64::from((p.y - r.min.y) / r.height()).clamp(0.0, 1.0) * 1000.0).round() / 1000.0;
+            let time = l.tick_at(p.x).0;
+            if l.content.contains(p)
+                && let Some(row) = l.row_at(p.y)
+            {
+                state.insert("pointer".into(), json!({"track": row.track.0, "time": time, "y": down(row.rect)}));
+            } else if l.ruler.contains(p) {
+                state.insert("pointer".into(), json!({"time": time, "y": down(l.ruler)}));
+            }
+        }
+        state.insert("playhead".into(), json!(self.session.playhead().0));
+        let selection: Vec<u64> = self.session.state.selection.iter().take(MAX_SELECTION).map(|c| c.0).collect();
+        state.insert("selection".into(), json!(selection));
+        if let Some(seq) = self.session.active_sequence() {
+            dragged(self, seq, &mut state);
+        }
+        Value::Object(state)
+    }
+
+    /// Someone still on the same sequence keeps their marks where this Timeline drew them, to ease on from there.
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.with_borrow_mut(|old| {
+            let mut new: Vec<(Presence, Shown)> = others.into_iter().map(|o| (o, Shown::default())).collect();
+            for (o, shown) in &mut new {
+                if let Some(was) = old.iter_mut().find(|(w, _)| w.id == o.id && w.state["sequence"] == o.state["sequence"]) {
+                    *shown = std::mem::take(&mut was.1);
+                }
+            }
+            *old = new;
+        });
+    }
+
+    fn live_quiet(&self) -> bool {
+        let s = &self.session;
+        !INPUT.get() && s.trim_play.dynamic.is_none() && !s.mixrec.active() && !s.mcrec.active() && !s.voiceover.recording()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.session.revision)
+    }
+
+    /// Undo steps from the session hold other people's edits: native Undo starts again from here.
+    fn live_disconnected(&mut self) {
+        let h = &mut self.session.history;
+        (h.undo, h.redo, h.merge_key) = (Vec::new(), Vec::new(), None);
+    }
+}
