+    /// Enables or disables the first clip of a video track.
+    fn toggle(app: &mut FilmcraftApp, track: usize) -> filmcraft_project::ClipId {
+        let clip = app.session.active_sequence().unwrap().video_tracks[track].items[0].id;
+        app.session.execute("clip.enable", json!({"clips": [clip.0]})).unwrap();
+        clip
+    }
+
+    /// Sets what belongs to this machine: the renderer, a scratch disk, the record arm of A1.
+    fn local(app: &mut FilmcraftApp, name: &str) {
+        let seq = app.session.state.active_sequence.unwrap();
+        let p = Arc::make_mut(&mut app.session.project);
+        (p.settings.renderer, p.settings.scratch.captured) = (name.into(), Some(name.into()));
+        p.sequence_mut(seq).unwrap().audio_tracks[0].mixer.record_arm = true;
+    }
+
+    /// Adds a copy of V1's last clip, `gap` clip durations after it, with id `id`.
+    fn append(app: &mut FilmcraftApp, id: u64, gap: i64) {
+        let seq = app.session.state.active_sequence.unwrap();
+        let track = &mut Arc::make_mut(&mut app.session.project).sequence_mut(seq).unwrap().video_tracks[0];
+        let mut clip = track.items.last().unwrap().clone();
+        (clip.id, clip.link, clip.start) = (filmcraft_project::ClipId(id), None, track.end() + Tick(clip.duration.0 * gap));
+        track.items.push(clip);
+    }
+
+    fn enabled(app: &FilmcraftApp, track: usize) -> bool {
+        app.session.active_sequence().unwrap().video_tracks[track].items[0].enabled
+    }
