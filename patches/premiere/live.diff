+    #[test]
+    fn clips_two_people_add_after_the_same_clip_merge_in_time_order_and_overlaps_conflict() {
+        let base = demo();
+        let merge = |later: i64, earlier: i64| {
+            let (mut a, mut b) = (demo(), demo());
+            append(&mut a, 900_001, later);
+            append(&mut b, 900_002, earlier);
+            // The side merged first (this one's) added the later clip: in side order the track would be unsorted.
+            FilmcraftApp::live_merge(&base.live_document(), &a.live_document(), &b.live_document())
+        };
+        let merged = merge(3, 1).unwrap();
+        FilmcraftApp::live_check(&merged).unwrap();
+        let mut app = demo();
+        app.live_adopt(merged).unwrap();
+        let items = &app.session.active_sequence().unwrap().video_tracks[0].items;
+        assert_eq!(items.iter().rev().take(2).map(|i| i.id.0).collect::<Vec<_>>(), [900_001, 900_002]);
+        // Two clips put in the same place cannot both stay: a conflict, never a document no one can install.
+        assert!(FilmcraftApp::live_check(&merge(1, 1).unwrap()).unwrap_err().contains("overlap"));
+        assert!(FilmcraftApp::live_check(&json!(null)).is_err());
+    }
