+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! Live editing in a Playground session (the shell's `shell/live.js` drives it through `playground_live::web`);
+//! nothing here runs until the shell connects, and native builds never call it.
+//!
+//! The shared document is the package being edited: its main graph and every graph in it (nodes with their ids,
+//! parameters, positions and wires, the graph settings, published parameters, comment frames, embedded resources),
+//! as canonical JSON with the nodes sorted by id. Views stay personal: pan and zoom, the selection, the graph shown
+//! (a subgraph this person entered), open panels, the 2D and 3D previews. A remote change installs at the end of a
+//! quiet frame with no undo step of its own, keeping this person's selection (by id), view and graph; the evaluator's
+//! node cache then recomputes only the nodes whose inputs changed. While connected, Undo and Redo go to the session,
+//! and switching to, adding or closing another package waits for the session's end (the session shares one).
+//!
+//! The merge is the template's three-way merge keyed by node id: a node or wire added on either side survives, a
+//! removed one goes, a parameter (or a node's position) changed on one side takes that change, and the same value
+//! changed on both sides is a conflict. A wire's slot is one value (source and output together). Two people adding
+//! a node at once both pick the next free id: the side not yet accepted is renumbered past every id in use. Wires,
+//! published parameters and outputs that lead to a node the other side deleted are dropped (deleting a node drops
+//! them too, so the result is as if the deletion came second). The check refuses cycles.
+
+#[path = "gui_live/peers.rs"]
+mod peers;
+// The template (patches/live/playground_live.rs, copied next to this file): its merge, canonical form and glue.
+#[path = "playground_live.rs"]
+#[allow(dead_code)]
+mod playground_live;
+
+use super::{auto_layout_if_unplaced, App, Graph, Node, Screen};
+use eframe::egui;
+use materialcraft::graph::{b64_decode, b64_encode, Comment, Exposed};
+use playground_live::{Error, Live, Presence};
+use serde_json::{json, Map, Value};
+use std::collections::{HashMap, HashSet};
+
+#[allow(unused_imports)]
+pub(crate) use playground_live::{connected, undo};
+
+thread_local! {
+    /// The egui context, for the input state (`live_quiet`, presence) and repaints after a remote change.
+    static CTX: std::cell::OnceCell<egui::Context> = const { std::cell::OnceCell::new() };
+}
+
+fn with_ctx<R>(f: impl FnOnce(&egui::Context) -> R) -> Option<R> {
+    CTX.with(|c| c.get().map(f))
+}
+
+// ---------------------------------------------------------------- the shared document
+
+/// An f32 exactly as JSON (null for NaN, which JSON lacks).
+fn num(v: f32) -> Value {
+    serde_json::Number::from_f64(f64::from(v)).map_or(Value::Null, Value::Number)
+}
+
+fn pair(p: [f32; 2]) -> Value {
+    json!([num(p[0]), num(p[1])])
+}
+
+/// `graph` as shared: nodes by id, each wire as `[from]` or `[from, output]` on its slot; linked subgraphs (copies of
+/// other files) stay out, as in a saved file.
+fn graph_json(g: &Graph) -> Value {
+    let nodes: Vec<Value> = g
+        .nodes
+        .iter()
+        .map(|(id, n)| {
+            let ins: Map<String, Value> = n
+                .ins
+                .iter()
+                .map(|(slot, from)| (slot.clone(), n.in_out.get(slot).map_or_else(|| json!([from]), |out| json!([from, out]))))
+                .collect();
+            json!({
+                "id": id,
+                "kind": n.kind,
+                "pos": pair(n.pos),
+                "nums": n.nums.iter().map(|(k, v)| (k.clone(), num(*v))).collect::<Map<_, _>>(),
+                "strs": n.strs,
+                "ins": ins,
+            })
+        })
+        .collect();
+    json!({
+        "size": g.size,
+        "height": g.height,
+        "seed_offset": g.seed_offset,
+        "meta": g.meta,
+        "resources": g.resources.iter().map(|(k, v)| (k.clone(), Value::from(b64_encode(v)))).collect::<Map<_, _>>(),
+        "nodes": nodes,
+        "outputs": g.outputs,
+        "output_pins": g.output_pins,
+        "exposed": g.exposed.iter().map(|e| json!({
+            "id": format!("{}.{}", e.node, e.param), "label": e.label, "node": e.node, "param": e.param, "min": num(e.min), "max": num(e.max),
+        })).collect::<Vec<_>>(),
+        "comments": g.comments.iter().map(|c| json!({"text": c.text, "pos": pair(c.pos), "size": pair(c.size), "color": c.color})).collect::<Vec<_>>(),
+        "subgraphs": g.subgraphs.iter().map(|(k, s)| (k.clone(), graph_json(s))).collect::<Map<_, _>>(),
+    })
+}
+
+fn bad(what: &str) -> Error {
+    format!("Invalid shared graph: {what}")
+}
+
+fn f32_of(v: &Value) -> Result<f32, Error> {
+    match v {
+        Value::Null => Ok(f32::NAN),
+        v => v.as_f64().map(|x| x as f32).ok_or_else(|| bad("number")),
+    }
+}
+
+fn pair_of(v: &Value) -> Result<[f32; 2], Error> {
+    Ok([f32_of(&v[0])?, f32_of(&v[1])?])
+}
+
+fn u32_of(v: &Value) -> Result<u32, Error> {
+    v.as_u64().and_then(|x| u32::try_from(x).ok()).ok_or_else(|| bad("id"))
+}
+
+fn str_of(v: &Value) -> Result<String, Error> {
+    v.as_str().map(str::to_owned).ok_or_else(|| bad("text"))
+}
+
+fn entries(v: &Value) -> impl Iterator<Item = (&String, &Value)> {
+    v.as_object().into_iter().flatten()
+}
+
+fn items(v: &Value) -> impl Iterator<Item = &Value> {
+    v.as_array().into_iter().flatten()
+}
+
+/// The graph a shared document describes (lenient: [`check`] asks that it gives the same document back).
+fn graph_of(v: &Value) -> Result<Graph, Error> {
+    if !v.is_object() {
+        return Err(bad("not a graph"));
+    }
+    let mut g = Graph::default();
+    g.size = v["size"].as_u64().ok_or_else(|| bad("size"))? as usize;
+    g.height = v["height"].as_u64().unwrap_or(0) as usize;
+    g.seed_offset = v["seed_offset"].as_u64().and_then(|s| u32::try_from(s).ok()).unwrap_or(0);
+    for (k, s) in entries(&v["meta"]) {
+        g.meta.insert(k.clone(), str_of(s)?);
+    }
+    for (k, s) in entries(&v["resources"]) {
+        g.resources.insert(k.clone(), b64_decode(s.as_str().unwrap_or_default())?.into());
+    }
+    for n in items(&v["nodes"]) {
+        let mut node = Node { kind: str_of(&n["kind"])?, pos: pair_of(&n["pos"])?, ..Default::default() };
+        for (k, x) in entries(&n["nums"]) {
+            node.nums.insert(k.clone(), f32_of(x)?);
+        }
+        for (k, s) in entries(&n["strs"]) {
+            node.strs.insert(k.clone(), str_of(s)?);
+        }
+        for (slot, wire) in entries(&n["ins"]) {
+            node.ins.insert(slot.clone(), u32_of(&wire[0])?);
+            if let Some(out) = wire[1].as_str() {
+                node.in_out.insert(slot.clone(), out.to_owned());
+            }
+        }
+        g.nodes.insert(u32_of(&n["id"])?, node);
+    }
+    for o in items(&v["outputs"]) {
+        g.outputs.push((str_of(&o[0])?, u32_of(&o[1])?));
+    }
+    for (k, s) in entries(&v["output_pins"]) {
+        g.output_pins.insert(k.clone(), str_of(s)?);
+    }
+    for e in items(&v["exposed"]) {
+        g.exposed.push(Exposed { label: str_of(&e["label"])?, node: u32_of(&e["node"])?, param: str_of(&e["param"])?, min: f32_of(&e["min"])?, max: f32_of(&e["max"])? });
+    }
+    for c in items(&v["comments"]) {
+        let color = c["color"].as_u64().and_then(|c| u8::try_from(c).ok()).ok_or_else(|| bad("frame colour"))?;
+        g.comments.push(Comment { text: str_of(&c["text"])?, pos: pair_of(&c["pos"])?, size: pair_of(&c["size"])?, color });
+    }
+    for (k, s) in entries(&v["subgraphs"]) {
+        g.subgraphs.insert(k.clone(), graph_of(s)?);
+    }
+    Ok(g)
+}
+
+/// The package when this person is inside a subgraph: each level back in its parent, as `exit_sub` puts it (graphs
+/// made inside go up), but with what `enter_sub` lent it for the visit given back (the parent's other graphs and
+/// resources, and its size and seed unless they were changed here), so that entering a graph changes nothing.
+fn package(app: &App) -> std::borrow::Cow<'_, Graph> {
+    if app.parents.is_empty() {
+        return std::borrow::Cow::Borrowed(&app.g);
+    }
+    let mut level = app.g.clone();
+    for (parent, name) in app.parents.iter().rev() {
+        let mut up = parent.clone();
+        for (k, v) in std::mem::take(&mut level.subgraphs) {
+            up.subgraphs.entry(k).or_insert(v);
+        }
+        match parent.subgraphs.get(name) {
+            Some(stored) => {
+                (level.subgraphs, level.resources) = (stored.subgraphs.clone(), stored.resources.clone());
+                if level.size == parent.size {
+                    level.size = stored.size;
+                }
+                if level.seed_offset == parent.seed_offset {
+                    level.seed_offset = stored.seed_offset;
+                }
+            }
+            None => level.resources.clear(),
+        }
+        up.subgraphs.insert(name.clone(), level);
+        level = up;
+    }
+    std::borrow::Cow::Owned(level)
+}
+
+/// `doc` without what evaluating it ignores (node positions, comment frames).
+fn evaluated(doc: &Value) -> Value {
+    fn strip(g: &mut Value) {
+        if let Some(g) = g.as_object_mut() {
+            g.remove("comments");
+        }
+        for n in g.get_mut("nodes").and_then(Value::as_array_mut).into_iter().flatten() {
+            if let Some(n) = n.as_object_mut() {
+                n.remove("pos");
+            }
+        }
+        for (_, sub) in g.get_mut("subgraphs").and_then(Value::as_object_mut).into_iter().flatten() {
+            strip(sub);
+        }
+    }
+    let mut doc = doc.clone();
+    strip(&mut doc);
+    doc
+}
+
+/// Installs `root` as the package, back inside the subgraphs this person was in (as `enter_sub` opens them, as far as
+/// they still exist), keeping their selection where its nodes still are; `evaluate`: the change needs an evaluation.
+fn install(app: &mut App, root: Graph, evaluate: bool) {
+    let path: Vec<String> = app.parents.iter().map(|(_, n)| n.clone()).collect();
+    app.parents.clear();
+    app.g = root;
+    for name in &path {
+        let Some(mut w) = app.g.subgraphs.get(name).cloned() else { break };
+        w.subgraphs = app.g.subgraphs.clone();
+        w.subgraphs.remove(name);
+        w.resources = app.g.resources.clone();
+        w.seed_offset = app.g.seed_offset;
+        w.size = app.g.size;
+        auto_layout_if_unplaced(&mut w);
+        let parent = std::mem::replace(&mut app.g, w);
+        app.parents.push((parent, name.clone()));
+    }
+    if app.parents.len() < path.len() {
+        // The graph this person was in is gone: show the one around it.
+        app.clear_views();
+        app.need_fit = true;
+    }
+    let g = &app.g;
+    app.sel.retain(|id| g.nodes.contains_key(id));
+    if app.active.is_some_and(|a| !g.nodes.contains_key(&a)) {
+        app.active = None;
+    }
+    if app.sel_comment.is_some_and(|c| c >= g.comments.len()) {
+        app.sel_comment = None;
+    }
+    if app.pkgs.is_empty() {
+        // Nothing was open (the start screen): the session's package opens in the editor.
+        app.ws_fresh();
+        app.screen = Screen::Editor;
+        app.file = None;
+        app.undo.clear();
+        app.redo.clear();
+        app.need_fit = true;
+    }
+    app.dirty |= evaluate || app.need_fit;
+    app.modified = true;
+}
+
+// ---------------------------------------------------------------- merge and check
+
+fn node_ids(g: &Value) -> HashMap<u64, &Value> {
+    items(&g["nodes"]).filter_map(|n| Some((n["id"].as_u64()?, n))).collect()
+}
+
+/// Nodes `current` and `edited` both added under one id (different nodes): `current`'s get ids past every id in use,
+/// in every graph both keep, with the wires, published parameters and outputs that name them.
+fn renumber(base: &Value, current: &mut Value, edited: &Value) {
+    let (b, c, e) = (node_ids(base), node_ids(current), node_ids(edited));
+    let mut clashes: Vec<u64> = c.iter().filter(|(id, n)| !b.contains_key(id) && e.get(id).is_some_and(|m| m != *n)).map(|(id, _)| *id).collect();
+    clashes.sort_unstable();
+    let next = b.keys().chain(c.keys()).chain(e.keys()).max().map_or(1, |m| m + 1);
+    let map: HashMap<u64, u64> = clashes.into_iter().zip(next..).collect();
+    if !map.is_empty() {
+        let to = |v: &mut Value| {
+            if let Some(n) = v.as_u64().and_then(|id| map.get(&id)) {
+                *v = (*n).into();
+            }
+        };
+        for n in current.get_mut("nodes").and_then(Value::as_array_mut).into_iter().flatten() {
+            to(&mut n["id"]);
+            for (_, wire) in n.get_mut("ins").and_then(Value::as_object_mut).into_iter().flatten() {
+                to(&mut wire[0]);
+            }
+        }
+        for x in current.get_mut("exposed").and_then(Value::as_array_mut).into_iter().flatten() {
+            to(&mut x["node"]);
+            x["id"] = format!("{}.{}", x["node"], x["param"].as_str().unwrap_or_default()).into();
+        }
+        for o in current.get_mut("outputs").and_then(Value::as_array_mut).into_iter().flatten() {
+            to(&mut o[1]);
+        }
+    }
+    for (name, sub) in current.get_mut("subgraphs").and_then(Value::as_object_mut).into_iter().flatten() {
+        if let (Some(bs), Some(es)) = (base["subgraphs"].get(name), edited["subgraphs"].get(name)) {
+            renumber(bs, sub, es);
+        }
+    }
+}
+
+/// The merged graph as the app keeps it: nodes in id order, and nothing that leads to a node no longer there.
+fn repair(g: &mut Value) {
+    let ids: HashSet<u64> = node_ids(g).into_keys().collect();
+    let gone = |v: &Value| !v.as_u64().is_some_and(|id| ids.contains(&id));
+    if let Some(nodes) = g.get_mut("nodes").and_then(Value::as_array_mut) {
+        nodes.sort_by_key(|n| n["id"].as_u64());
+        for n in nodes.iter_mut() {
+            if let Some(ins) = n.get_mut("ins").and_then(Value::as_object_mut) {
+                ins.retain(|_, wire| !gone(&wire[0]));
+            }
+        }
+    }
+    if let Some(exposed) = g.get_mut("exposed").and_then(Value::as_array_mut) {
+        exposed.retain(|x| !gone(&x["node"]));
+    }
+    if let Some(outputs) = g.get_mut("outputs").and_then(Value::as_array_mut) {
+        outputs.retain(|o| !gone(&o[1]));
+    }
+    for (_, sub) in g.get_mut("subgraphs").and_then(Value::as_object_mut).into_iter().flatten() {
+        repair(sub);
+    }
+}
+
+/// No cycles in any graph of the package (the editor refuses wires that would make one).
+fn acyclic(g: &Graph) -> Result<(), Error> {
+    g.check_cycles().map_err(|e| format!("Conflict: {e}"))?;
+    g.subgraphs.values().try_for_each(acyclic)
+}
+
+/// Whether every peer can install `doc`: it reads as a package that gives the same document back, without cycles.
+fn check(doc: &Value) -> Result<(), Error> {
+    let g = graph_of(doc)?;
+    if playground_live::canonical(&graph_json(&g)) != playground_live::canonical(doc) {
+        return Err(bad("not as MaterialCraft writes it"));
+    }
+    acyclic(&g)
+}
+
+// ---------------------------------------------------------------- the app's side
+
+impl Live for App {
+    fn live_document(&self) -> Value {
+        graph_json(&package(self))
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), Error> {
+        let root = graph_of(&document)?;
+        // Moving nodes or frames needs no new evaluation: the node cache keeps the rest from recomputing what did not change.
+        let evaluate = evaluated(&self.live_document()) != evaluated(&document);
+        install(self, root, evaluate);
+        with_ctx(egui::Context::request_repaint);
+        Ok(())
+    }
+
+    /// No pointer down (node, frame or slider drags, a wire or box being dragged out), no wire being connected, box
+    /// being drawn or add-node menu open. Typing is quiet: each key writes the document, as it does here anyway.
+    fn live_quiet(&self) -> bool {
+        !with_ctx(|ctx| ctx.input(|i| i.pointer.any_down())).unwrap_or(false)
+            && self.connecting.is_none()
+            && self.connecting_in.is_none()
+            && self.rubber.is_none()
+            && self.search.is_none()
+    }
+
+    fn live_disconnected(&mut self) {
+        self.undo.clear();
+        self.redo.clear();
+    }
+
+    fn live_presence(&self) -> Value {
+        peers::mine(self)
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        peers::show(others);
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+        let mut current = current.clone();
+        renumber(base, &mut current, edited);
+        let mut merged = playground_live::merge(base, &current, edited, &[])?;
+        repair(&mut merged);
+        Ok(merged)
+    }
+
+    fn live_check(document: &Value) -> Result<(), Error> {
+        check(document)
+    }
+}
+
+fn hold(app: &mut App, refuse: bool) -> bool {
+    let held = refuse && connected();
+    if held {
+        app.status("The live session shares this package: leave the session to switch, add or close packages", false);
+    }
+    held
+}
+
+/// `App::switch_pkg`'s first step: while connected, the editor stays on the shared package. Whether it refused.
+pub(crate) fn hold_switch(app: &mut App, to: usize) -> bool {
+    let refuse = to != app.pkg_active;
+    hold(app, refuse)
+}
+
+/// `App::add_pkg_active`'s first step: a new package next to the shared one waits for the session's end (from the
+/// start screen, with nothing in the editor, it becomes the shared package).
+pub(crate) fn hold_add(app: &mut App) -> bool {
+    let refuse = app.screen == Screen::Editor;
+    hold(app, refuse)
+}
+
+/// `App::close_pkg`'s first step: closing the shared package while others are open would put one of them in its place.
+pub(crate) fn hold_close(app: &mut App, i: usize) -> bool {
+    let refuse = i == app.pkg_active && app.pkgs.len() > 1;
+    hold(app, refuse)
+}
+
+/// The end of each frame, after the app's own: the others' marks over the graph, then the session's frame (remote
+/// changes in, this person's out, once quiet), then what this person's presence compares their gestures with.
+pub(crate) fn frame(app: &mut App, ctx: &egui::Context) {
+    CTX.with(|c| {
+        c.get_or_init(|| ctx.clone());
+    });
+    peers::draw(app, ctx);
+    playground_live::frame(app);
+    peers::note(app, ctx);
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) mod web {
+    //! The page's side: the kept web runner, and the app eframe runs (the page's editor, then the session's frame
+    //! hook), offered to the Playground shell as its live-editing adapter.
+    use super::App;
+    use eframe::egui;
+    use std::cell::OnceCell;
+
+    thread_local! {
+        static RUNNER: OnceCell<eframe::WebRunner> = const { OnceCell::new() };
+    }
+
+    /// The page's web runner, kept for the adapter.
+    pub(crate) fn runner() -> eframe::WebRunner {
+        RUNNER.with(|kept| kept.get_or_init(eframe::WebRunner::new).clone())
+    }
+
+    /// The app eframe runs: `page` (the page's app, `editor` reaching the editor in it), then the session's frame.
+    pub(crate) fn wrap<T: eframe::App + 'static>(page: T, editor: fn(&mut T) -> &mut App) -> Box<dyn eframe::App> {
+        let with_app = move |f: &mut dyn FnMut(&mut App)| runner().app_mut::<Shell<T>>().map(|mut s| f(editor(&mut s.0))).is_some();
+        let repaint = || {
+            super::with_ctx(egui::Context::request_repaint);
+        };
+        let format = concat!("substance-designer:1:", env!("CARGO_PKG_VERSION"));
+        if let Err(e) = super::playground_live::web::attach::<App>(format, with_app, repaint) {
+            warn(&format!("materialcraft: no live editing: {e:?}"));
+        }
+        Box::new(Shell(page, editor))
+    }
+
+    #[wasm_bindgen::prelude::wasm_bindgen]
+    extern "C" {
+        #[wasm_bindgen(js_namespace = console)]
+        fn warn(text: &str);
+    }
+
+    struct Shell<T>(T, fn(&mut T) -> &mut App);
+
+    impl<T: eframe::App + 'static> eframe::App for Shell<T> {
+        fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+            self.0.ui(ui, frame);
+            super::frame((self.1)(&mut self.0), ui.ctx());
+        }
+
+        fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+            self.0.logic(ctx, frame);
+        }
+
+        fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+            self.0.raw_input_hook(ctx, raw_input);
+        }
+
+        fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+            self.0.clear_color(visuals)
+        }
+
+        fn save(&mut self, storage: &mut dyn eframe::Storage) {
+            self.0.save(storage);
+        }
+
+        fn persist_egui_memory(&self) -> bool {
+            self.0.persist_egui_memory()
+        }
+
+        fn auto_save_interval(&self) -> std::time::Duration {
+            self.0.auto_save_interval()
+        }
+
+        fn on_exit(&mut self, gl: Option<&eframe::glow::Context>) {
+            self.0.on_exit(gl);
+        }
+
+        /// The shell itself: the adapter reaches the editor through it.
+        fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+            Some(self)
+        }
+    }
+}
