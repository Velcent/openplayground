+#[test]
+fn adopting_keeps_this_persons_graph_selection_and_views() {
+    let mut app = app();
+    app.enter_sub("sub");
+    (app.sel, app.active, app.pan, app.zoom) = ([5, 6].into(), Some(6), vec2(12.0, 34.0), 1.7);
+    let shared = app.live_document();
+    // Views are not shared, the selection neither.
+    app.sel.insert(7);
+    app.pan = vec2(0.0, 0.0);
+    assert_eq!(app.live_document(), shared);
+    (app.sel, app.pan) = ([5, 6].into(), vec2(12.0, 34.0));
+
+    // Someone else drops node 6 of the subgraph and changes node 5.
+    let mut theirs = package();
+    let sub = theirs.subgraphs.get_mut("sub").unwrap();
+    sub.nodes.remove(&6);
+    sub.nodes.get_mut(&7).unwrap().ins.clear();
+    sub.nodes.get_mut(&5).unwrap().nums.insert("scale".into(), 3.0);
+    let doc = graph_json(&theirs);
+    let undo = app.undo.len();
+    app.live_adopt(doc.clone()).unwrap();
+    assert_eq!(app.parents.iter().map(|(_, n)| n.as_str()).collect::<Vec<_>>(), ["sub"]);
+    assert_eq!(app.g.nodes[&5].nums["scale"], 3.0);
+    assert_eq!((app.sel.iter().copied().collect::<Vec<_>>(), app.active), (vec![5], None));
+    assert_eq!((app.pan, app.zoom, app.undo.len()), (vec2(12.0, 34.0), 1.7, undo));
+    assert_eq!(playground_live::canonical(&app.live_document()), playground_live::canonical(&doc), "no change of its own");
+    // A node moved elsewhere needs no new evaluation.
+    app.dirty = false;
+    theirs.subgraphs.get_mut("sub").unwrap().nodes.get_mut(&5).unwrap().pos = [7.0, 8.0];
+    app.live_adopt(graph_json(&theirs)).unwrap();
+    assert!(!app.dirty && app.g.nodes[&5].pos == [7.0, 8.0]);
+}
