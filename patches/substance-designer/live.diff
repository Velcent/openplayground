+// SPDX-License-Identifier: MIT OR Apache-2.0
+use super::*;
+use eframe::egui::{pos2, vec2};
+
+const PACKAGE: &str = "size 256
+node 1 perlin _x=0 _y=0 scale=4
+node 2 blur _x=150 _y=0 in=@1 radius=2
+node 3 blend _x=300 _y=0 fg=@2 bg=@1
+node 4 levels _x=0 _y=200
+node 9 output _x=450 _y=0 in=@3 usage=\"basecolor\"
+expose \"Scale\" 1 scale 1 32
+subgraph sub
+node 5 perlin _x=0 _y=0 scale=8
+node 6 invert _x=150 _y=0 in=@5
+node 7 output _x=300 _y=0 in=@6 usage=\"out\"
+end
+";
+
+fn package() -> Graph {
+    Graph::parse_unchecked(PACKAGE).unwrap()
+}
+
+fn app() -> App {
+    let mut app = App::new(&eframe::CreationContext::_new_kittest(egui::Context::default()));
+    app.ws_fresh();
+    app.screen = Screen::Editor;
+    app.g = package();
+    app
+}
+
+fn merge(b: &Graph, c: &Graph, e: &Graph) -> Result<Graph, Error> {
+    let merged = App::live_merge(&graph_json(b), &graph_json(c), &graph_json(e))?;
+    App::live_check(&merged)?;
+    graph_of(&merged)
+}
+
+#[test]
+fn concurrent_graph_edits_merge_by_node_and_wire() {
+    let base = package();
+    // Each side adds a node (both pick id 10), one wires node 3's mask from it and publishes its scale; the other
+    // drops node 2 and moves node 3.
+    let (mut a, mut b) = (base.clone(), base.clone());
+    a.nodes.insert(10, Node { kind: "perlin".into(), pos: [0.0, 200.0], ..Default::default() });
+    a.nodes.get_mut(&3).unwrap().ins.insert("mask".into(), 10);
+    a.exposed.push(Exposed { label: "A".into(), node: 10, param: "scale".into(), min: 0.0, max: 1.0 });
+    a.nodes.get_mut(&1).unwrap().nums.insert("scale".into(), 6.0);
+    a.nodes.get_mut(&1).unwrap().pos = [10.0, 20.0];
+    b.nodes.insert(10, Node { kind: "invert".into(), pos: [0.0, 400.0], ..Default::default() });
+    b.nodes.remove(&2);
+    b.nodes.get_mut(&3).unwrap().ins.remove("fg");
+    b.nodes.get_mut(&3).unwrap().pos = [300.0, 50.0];
+    let m = merge(&base, &a, &b).unwrap();
+    // B's node keeps id 10 (accepted), A's is renumbered past every id, with its wire and published parameter.
+    assert_eq!(m.nodes[&10].kind, "invert");
+    assert_eq!(m.nodes[&11].kind, "perlin");
+    assert_eq!(m.nodes[&3].ins.get("mask"), Some(&11));
+    assert!(m.exposed.iter().any(|e| e.label == "A" && e.node == 11));
+    // A removal goes, a parameter one side changed is taken, positions merge per node.
+    assert!(!m.nodes.contains_key(&2));
+    assert_eq!(m.nodes[&1].nums["scale"], 6.0);
+    assert_eq!((m.nodes[&1].pos, m.nodes[&3].pos), ([10.0, 20.0], [300.0, 50.0]));
+
+    // The same parameter changed on both sides conflicts (even to one value).
+    let mut b = base.clone();
+    b.nodes.get_mut(&1).unwrap().nums.insert("scale".into(), 6.0);
+    assert!(merge(&base, &a, &b).is_err());
+
+    // A wire to a node the other side deleted is dropped, with what published it.
+    let (mut a, mut b) = (base.clone(), base.clone());
+    a.nodes.get_mut(&3).unwrap().ins.insert("mask".into(), 2);
+    b.nodes.remove(&2);
+    b.nodes.get_mut(&3).unwrap().ins.remove("fg");
+    let m = merge(&base, &a, &b).unwrap();
+    assert!(m.nodes[&3].ins.get("mask").is_none() && !m.nodes.contains_key(&2));
+
+    // Two wires that make a cycle together are refused.
+    let (mut a, mut b) = (base.clone(), base.clone());
+    a.nodes.get_mut(&4).unwrap().ins.insert("in".into(), 3);
+    b.nodes.get_mut(&2).unwrap().ins.insert("in".into(), 4);
+    assert!(merge(&base, &a, &b).unwrap_err().contains("ycle"));
+    // A document MaterialCraft would not write back the same is refused.
+    let mut odd = graph_json(&base);
+    odd["nodes"][0]["pos"][0] = json!(0.1);
+    assert!(App::live_check(&odd).is_err());
+}
