+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! Presence in a live session. Each person shares the graph they are in (the subgraph path), their pointer over it
+//! and their selected nodes (and comment frame), in graph coordinates, and what they have under way: the nodes and
+//! frames they drag (where they are so far), a wire they drag out of a socket, the box they select with, the add-node
+//! menu (where the node would land and what they typed, or a node dragged from the library) and a parameter they drag
+//! (its value). Over the graph, for the others in the same graph and in their colour: ghosts of what they move, their
+//! wire and box, then outlines of their selection and value tags, then their pointers with their names. Presence
+//! arrives about ten times a second: pointers and ghosts ease toward their latest place in graph coordinates, so this
+//! person's own panning and zooming never lags them. Everything in a state comes from another person: what doesn't
+//! read as ids or numbers in range is skipped.
+// The painting is web only (its hook is); native tests use the projection.
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+use super::{connected, with_ctx, Live, Presence};
+use super::super::{card_body, node_slots, sd_outs, App, Graph, Screen, BAR, CARD, CARD_H};
+use materialcraft::params::{pdefs, PK};
+use eframe::egui::{self, epaint::CubicBezierShape, vec2, Color32, FontId, LayerId, Pos2, Rect, Shape, Stroke, StrokeKind, Vec2};
+use serde_json::{json, Value};
+use std::cell::RefCell;
+use std::collections::{BTreeMap, HashMap};
+
+/// How long the others' marks take to go most (1 - 1/e) of the way to where they last were, in seconds.
+const EASE: f32 = 0.08;
+/// The most items of a kind a presence carries.
+const MOST: usize = 50;
+
+/// What this person's presence needs from the frames: the pointer over the graph and the graph at rest.
+#[derive(Default)]
+struct Mine {
+    /// This person's pointer over the graph (in graph coordinates), as of the last frame.
+    pointer: Option<[f32; 2]>,
+    /// The graph shown as of the last quiet frame: what a gesture under way has moved or changed since.
+    rest: Option<Rest>,
+}
+
+struct Rest {
+    graph: Vec<String>,
+    pos: HashMap<u32, [f32; 2]>,
+    frames: Vec<[f32; 4]>,
+    /// The inspected node's numbers.
+    nums: Option<(u32, BTreeMap<String, f32>)>,
+}
+
+/// A person's moving marks as last drawn, in graph coordinates.
+#[derive(Default)]
+struct Shown {
+    pointer: Option<[f32; 2]>,
+    ghosts: HashMap<u32, [f32; 2]>,
+}
+
+thread_local! {
+    static MINE: RefCell<Mine> = RefCell::default();
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+    static SHOWN: RefCell<HashMap<String, Shown>> = RefCell::default();
+}
+
+/// The graph this person is in: the subgraphs entered, outermost first (none: the package's main graph).
+fn scope(app: &App) -> Vec<String> {
+    app.parents.iter().map(|(_, n)| n.clone()).collect()
+}
+
+/// To a hundredth of a unit (presence is small, and that is under a pixel at any zoom).
+fn r(v: f32) -> f64 {
+    (f64::from(v) * 100.0).round() / 100.0
+}
+
+fn r2(p: [f32; 2]) -> Value {
+    json!([r(p[0]), r(p[1])])
+}
+
+fn cut(text: &str, n: usize) -> String {
+    match text.chars().nth(n) {
+        Some(_) => text.chars().take(n - 1).chain(['…']).collect(),
+        None => text.to_owned(),
+    }
+}
+
+/// "Label value" for parameter `key` of a `kind` node, as the Properties panel shows it.
+fn param_text(kind: &str, key: &str, v: f32) -> String {
+    match pdefs(kind).into_iter().find(|d| d.name == key) {
+        Some(d) => match d.k {
+            PK::F { .. } => format!("{} {v:.2}", d.label),
+            PK::I { .. } => format!("{} {}", d.label, v.round()),
+            PK::E { opts, .. } => format!("{} {}", d.label, opts.get(v.round().max(0.0) as usize).unwrap_or(&"")),
+            PK::B { .. } => format!("{} {}", d.label, if v > 0.5 { "on" } else { "off" }),
+        },
+        None => format!("{key} {v:.2}"),
+    }
+}
+
+/// The end of a frame: this person's pointer over the graph (not over a window or menu on it), and the graph at rest
+/// when nothing is under way.
+pub(super) fn note(app: &App, ctx: &egui::Context) {
+    if !connected() {
+        MINE.take();
+        return;
+    }
+    let over = |p: &Pos2| app.screen == Screen::Editor && app.canvas_rect.contains(*p) && ctx.layer_id_at(*p).is_none_or(|l| l.order == egui::Order::Background);
+    let pointer = ctx.pointer_hover_pos().filter(over).map(|p| app.screen_to_world(p)).map(|w| [w.x, w.y]);
+    let quiet = app.live_quiet();
+    MINE.with_borrow_mut(|m| {
+        m.pointer = pointer;
+        if quiet {
+            m.rest = Some(Rest {
+                graph: scope(app),
+                pos: app.g.nodes.iter().map(|(id, n)| (*id, n.pos)).collect(),
+                frames: app.g.comments.iter().map(|c| [c.pos[0], c.pos[1], c.size[0], c.size[1]]).collect(),
+                nums: app.active.and_then(|a| Some((a, app.g.nodes.get(&a)?.nums.clone()))),
+            });
+        }
+    });
+}
+
+/// This person's presence (see the module's doc); `Null` off the editor.
+pub(super) fn mine(app: &App) -> Value {
+    if app.screen != Screen::Editor {
+        return Value::Null;
+    }
+    let graph = scope(app);
+    let mut s = json!({ "graph": graph, "selection": app.sel.iter().take(MOST).collect::<Vec<_>>() });
+    if let Some(ci) = app.sel_comment {
+        s["frame"] = ci.into();
+    }
+    let busy = !app.live_quiet();
+    MINE.with_borrow(|m| {
+        if let Some(p) = m.pointer {
+            s["pointer"] = r2(p);
+        }
+        let Some(rest) = m.rest.as_ref().filter(|rest| busy && rest.graph == graph) else { return };
+        let moving: Vec<Value> = app
+            .g
+            .nodes
+            .iter()
+            .filter(|(id, n)| rest.pos.get(id).is_some_and(|p| *p != n.pos))
+            .take(MOST)
+            .map(|(id, n)| json!([id, r(n.pos[0]), r(n.pos[1])]))
+            .collect();
+        if !moving.is_empty() {
+            s["moving"] = moving.into();
+        }
+        if rest.frames.len() == app.g.comments.len() {
+            let frames: Vec<Value> = app
+                .g
+                .comments
+                .iter()
+                .enumerate()
+                .filter(|(i, c)| rest.frames[*i] != [c.pos[0], c.pos[1], c.size[0], c.size[1]])
+                .take(MOST)
+                .map(|(i, c)| json!([i, r(c.pos[0]), r(c.pos[1]), r(c.size[0]), r(c.size[1])]))
+                .collect();
+            if !frames.is_empty() {
+                s["frames"] = frames.into();
+            }
+        }
+        if let Some((id, before)) = rest.nums.as_ref().filter(|(id, _)| app.active == Some(*id)) {
+            let node = app.g.nodes.get(id);
+            let changed = node.and_then(|n| n.nums.iter().find(|(k, v)| before.get(*k).map(|b| b.to_bits()) != Some(v.to_bits())));
+            if let (Some(n), Some((k, v))) = (node, changed) {
+                s["param"] = json!({ "node": id, "key": k, "text": cut(&param_text(&n.kind, k, *v), 40) });
+            }
+        }
+    });
+    if let Some(from) = app.connecting {
+        s["wire"] = json!({ "from": from, "out": app.connecting_out });
+    } else if let Some((to, slot)) = &app.connecting_in {
+        s["wire"] = json!({ "to": to, "slot": slot });
+    }
+    if let Some(start) = app.rubber {
+        let w = app.screen_to_world(start);
+        s["band"] = r2([w.x, w.y]);
+    }
+    if let Some(st) = &app.search {
+        s["adding"] = json!({ "at": r2([st.world.x, st.world.y]), "text": cut(&st.text, 40) });
+    } else if let (Some(label), Some(p)) = (with_ctx(egui::DragAndDrop::payload::<String>).flatten(), s["pointer"].as_array().cloned()) {
+        // A node dragged from the library lands centred on the pointer.
+        let at = |i: usize, half: f32| p[i].as_f64().unwrap_or_default() as f32 - half;
+        s["adding"] = json!({ "at": r2([at(0, CARD * 0.5), at(1, CARD_H * 0.5)]), "text": cut(&label, 40) });
+    }
+    s
+}
+
+/// The others, as the shell gave them.
+pub(super) fn show(others: Vec<Presence>) {
+    OTHERS.set(others);
+}
+
+// ---------------------------------------------------------------- the others, drawn
+
+/// A finite number of a sane size (remote data).
+fn coord(v: &Value) -> Option<f32> {
+    v.as_f64().filter(|c| c.abs() < 1e7).map(|c| c as f32)
+}
+
+fn xy(x: &Value, y: &Value) -> Option<[f32; 2]> {
+    Some([coord(x)?, coord(y)?])
+}
+
+fn point(v: &Value) -> Option<[f32; 2]> {
+    xy(&v[0], &v[1])
+}
+
+fn id(v: &Value) -> Option<u32> {
+    v.as_u64().and_then(|id| u32::try_from(id).ok())
+}
+
+/// The graph someone is in, when it reads as one.
+fn graph_of(o: &Presence) -> Option<Vec<String>> {
+    o.state["graph"].as_array().filter(|g| g.len() <= 32)?.iter().map(|n| n.as_str().map(str::to_owned)).collect()
+}
+
+/// A node's card, as the graph canvas lays it out (see `canvas`).
+struct Card {
+    pos: [f32; 2],
+    dot: bool,
+    body: f32,
+    slots: Vec<&'static str>,
+    outs: Vec<String>,
+}
+
+impl Card {
+    fn of(g: &Graph, id: u32) -> Option<Card> {
+        let n = g.nodes.get(&id)?;
+        let slots: Vec<&'static str> = node_slots(n, &g.subgraphs).into_iter().map(|s| s.0).collect();
+        let outs = sd_outs(n, &g.subgraphs);
+        Some(Card { pos: n.pos, dot: n.kind == "sbs:passthrough", body: card_body(slots.len(), outs.len()), slots, outs })
+    }
+
+    fn size(&self) -> Vec2 {
+        if self.dot {
+            vec2(24.0, 24.0)
+        } else {
+            vec2(CARD, BAR + self.body)
+        }
+    }
+
+    /// Where output `name` leaves the card, from its corner (in graph units).
+    fn out_port(&self, name: Option<&str>) -> Vec2 {
+        if !self.outs.is_empty() {
+            let i = name.and_then(|n| self.outs.iter().position(|o| o == n)).unwrap_or(0);
+            vec2(CARD, BAR + self.body * (i as f32 + 1.0) / (self.outs.len() as f32 + 1.0))
+        } else if self.dot {
+            vec2(24.0, 12.0)
+        } else {
+            vec2(CARD, BAR + self.body * 0.5)
+        }
+    }
+
+    /// Where input `slot` enters the card.
+    fn in_port(&self, slot: &str) -> Option<Vec2> {
+        let i = self.slots.iter().position(|s| *s == slot)?;
+        Some(if self.dot { vec2(0.0, 12.0) } else { vec2(0.0, BAR + self.body * (i as f32 + 1.0) / (self.slots.len() as f32 + 1.0)) })
+    }
+}
+
+/// `s` `k` of the way on toward `t` (graph units, `z` screen points each), all of it after a jump farther than `far`
+/// points or once under half a point remains. Whether it is still on its way.
+fn ease(s: &mut [f32; 2], t: [f32; 2], k: f32, z: f32, far: f32) -> bool {
+    let off = |s: &[f32; 2]| (t[0] - s[0]).abs().max((t[1] - s[1]).abs()) * z;
+    if off(s) > far {
+        *s = t;
+    }
+    s[0] += (t[0] - s[0]) * k;
+    s[1] += (t[1] - s[1]) * k;
+    let moving = off(s) >= 0.5;
+    if !moving {
+        *s = t;
+    }
+    moving
+}
+
+/// [`ease`] for a mark that comes and goes: it shows at once where it first does.
+fn step(s: &mut Option<[f32; 2]>, t: Option<[f32; 2]>, k: f32, z: f32, far: f32) -> bool {
+    match (s.as_mut(), t) {
+        (Some(s), Some(t)) => ease(s, t, k, z, far),
+        _ => {
+            *s = t;
+            false
+        }
+    }
+}
+
+fn rgb(c: [u8; 3]) -> Color32 {
+    Color32::from_rgb(c[0], c[1], c[2])
+}
+
+/// `c` at `a` (0–1) opacity.
+fn alpha(c: Color32, a: f32) -> Color32 {
+    Color32::from_rgba_unmultiplied(c.r(), c.g(), c.b(), (a * 255.0).round() as u8)
+}
+
+/// Relative luminance (sRGB) of `c`.
+fn luminance(c: Color32) -> f32 {
+    let lin = |v: u8| {
+        let v = f32::from(v) / 255.0;
+        if v <= 0.04045 {
+            v / 12.92
+        } else {
+            ((v + 0.055) / 1.055).powf(2.4)
+        }
+    };
+    0.2126 * lin(c.r()) + 0.7152 * lin(c.g()) + 0.0722 * lin(c.b())
+}
+
+const TAG_PAD: Vec2 = vec2(7.0, 3.0);
+
+fn tag_galley(painter: &egui::Painter, text: &str, color: Color32) -> std::sync::Arc<egui::Galley> {
+    let ink = if luminance(color) > 0.55 { Color32::from_rgb(0x11, 0x11, 0x11) } else { Color32::WHITE };
+    painter.layout_no_wrap(text.to_owned(), FontId::proportional(12.0), ink)
+}
+
+/// A name or value tag filled with `color`, its top left at `at` (on a pixel).
+fn tag(painter: &egui::Painter, at: Pos2, galley: std::sync::Arc<egui::Galley>, color: Color32) {
+    let ppp = painter.pixels_per_point();
+    let at = (at.to_vec2() * ppp).round().to_pos2() / ppp;
+    painter.rect_filled(Rect::from_min_size(at, galley.size() + 2.0 * TAG_PAD), 6.0, color);
+    painter.galley(at + TAG_PAD, galley, color);
+}
+
+/// The pointer arrow, tip at (0, 0), in points.
+const ARROW: [[f32; 2]; 7] = [[0.0, 0.0], [0.0, 16.0], [4.5, 12.2], [7.6, 18.6], [10.4, 17.3], [7.3, 11.0], [12.5, 11.0]];
+
+/// `points` filled as a fan from the first (the arrow is star-shaped around its tip).
+fn fan(points: &[Pos2], fill: Color32) -> Shape {
+    let mut mesh = egui::Mesh::default();
+    for p in points {
+        mesh.colored_vertex(*p, fill);
+    }
+    for i in 1..points.len() as u32 - 1 {
+        mesh.add_triangle(0, i, i + 1);
+    }
+    Shape::mesh(mesh)
+}
+
+/// A person's pointer: the arrow in their colour with a white outline and a soft shadow, and their name tag.
+fn pointer(painter: &egui::Painter, tip: Pos2, color: Color32, name: &str) {
+    let ppp = painter.pixels_per_point();
+    let tip = (tip.to_vec2() * ppp).round().to_pos2() / ppp;
+    let arrow = |off: Vec2| ARROW.map(|[x, y]| tip + off + vec2(x, y));
+    painter.add(fan(&arrow(vec2(0.0, 1.0)), Color32::from_black_alpha(64)));
+    painter.add(fan(&arrow(Vec2::ZERO), color));
+    painter.add(Shape::closed_line(arrow(Vec2::ZERO).to_vec(), Stroke::new(1.5, Color32::WHITE)));
+    tag(painter, tip + vec2(12.0, 15.0), tag_galley(painter, &cut(name, 24), color), color);
+}
+
+/// Something being moved (a card or frame at `r`, its corners rounded by `radius`): filled at 28%, edged at 85%.
+fn ghost(painter: &egui::Painter, r: Rect, radius: f32, dot: bool, color: Color32) {
+    let (fill, edge) = (alpha(color, 0.28), Stroke::new(1.5, alpha(color, 0.85)));
+    if dot {
+        painter.circle(r.center(), r.width() * 0.375, fill, edge);
+    } else {
+        painter.rect(r, radius, fill, edge, StrokeKind::Inside);
+    }
+}
+
+/// A box being dragged out: 1.5 points dashed (4 on, 3 off).
+fn band(painter: &egui::Painter, r: Rect, color: Color32) {
+    let corners = [r.left_top(), r.right_top(), r.right_bottom(), r.left_bottom(), r.left_top()];
+    painter.extend(Shape::dashed_line(&corners, Stroke::new(1.5, color), 4.0, 3.0));
+}
+
+/// A wire as the canvas draws its links.
+fn wire(painter: &egui::Painter, a: Pos2, b: Pos2, z: f32, color: Color32) {
+    let dx = ((b.x - a.x).abs() * 0.5).max(40.0 * z);
+    let points = [a, a + vec2(dx, 0.0), b - vec2(dx, 0.0), b];
+    painter.add(CubicBezierShape::from_points_stroke(points, false, Color32::TRANSPARENT, Stroke::new(2.0 * z.max(0.7), alpha(color, 0.85))));
+}
+
+/// Over the graph canvas, after the app's frame (above the graph, under windows and menus): for the others in the
+/// graph shown here, what they have under way, their selections and value tags, then their pointers and names.
+pub(super) fn draw(app: &App, ctx: &egui::Context) {
+    OTHERS.with_borrow(|others| {
+        SHOWN.with_borrow_mut(|shown| {
+            let graph = scope(app);
+            let here: Vec<&Presence> = others.iter().filter(|o| app.screen == Screen::Editor && graph_of(o).as_ref() == Some(&graph)).collect();
+            // Someone back in this graph shows at once where they are.
+            shown.retain(|id, _| here.iter().any(|o| o.id == *id));
+            if here.is_empty() {
+                return;
+            }
+            let rect = app.canvas_rect;
+            let painter = ctx.layer_painter(LayerId::background()).with_clip_rect(rect);
+            let (z, org) = (app.zoom, rect.min + app.pan);
+            let at = |p: [f32; 2]| org + vec2(p[0], p[1]) * z;
+            let k = 1.0 - (-ctx.input(|i| i.stable_dt).clamp(0.0, 0.1) / EASE).exp();
+            let far = rect.width().max(rect.height()) / 4.0;
+            let mut moving = false;
+            for o in &here {
+                let s = shown.entry(o.id.clone()).or_default();
+                moving |= step(&mut s.pointer, point(&o.state["pointer"]), k, z, far);
+            }
+            // What they have under way.
+            for o in &here {
+                let (s, color, st) = (shown.entry(o.id.clone()).or_default(), rgb(o.color), &o.state);
+                let mut ghosts = HashMap::new();
+                for m in st["moving"].as_array().into_iter().flatten().take(MOST) {
+                    let (Some(id), Some(to)) = (id(&m[0]), xy(&m[1], &m[2])) else { continue };
+                    let Some(card) = Card::of(&app.g, id) else { continue };
+                    let mut p = s.ghosts.get(&id).copied().unwrap_or(to);
+                    moving |= ease(&mut p, to, k, z, far);
+                    ghost(&painter, Rect::from_min_size(at(p), card.size() * z), 3.0 * z, card.dot, color);
+                    ghosts.insert(id, p);
+                }
+                s.ghosts = ghosts;
+                for f in st["frames"].as_array().into_iter().flatten().take(MOST) {
+                    if let (Some(p), Some(size)) = (xy(&f[1], &f[2]), xy(&f[3], &f[4])) {
+                        ghost(&painter, Rect::from_min_size(at(p), vec2(size[0], size[1]) * z), 4.0 * z, false, color);
+                    }
+                }
+                if let Some(tip) = s.pointer.map(at) {
+                    let w = &st["wire"];
+                    if let Some(c) = id(&w["from"]).and_then(|from| Card::of(&app.g, from)) {
+                        wire(&painter, at(c.pos) + c.out_port(w["out"].as_str()) * z, tip, z, color);
+                    } else if let Some(c) = id(&w["to"]).and_then(|to| Card::of(&app.g, to)) {
+                        if let Some(port) = w["slot"].as_str().and_then(|slot| c.in_port(slot)) {
+                            wire(&painter, tip, at(c.pos) + port * z, z, color);
+                        }
+                    }
+                    if let Some(start) = point(&st["band"]) {
+                        band(&painter, Rect::from_two_pos(at(start), tip), color);
+                    }
+                }
+                if let Some(p) = point(&st["adding"]["at"]) {
+                    let card = Rect::from_min_size(at(p), vec2(CARD, CARD_H) * z);
+                    band(&painter, card, color);
+                    let text = st["adding"]["text"].as_str().filter(|t| !t.is_empty()).map_or_else(|| "Add node".to_owned(), |t| format!("Add {}", cut(t, 40)));
+                    tag(&painter, card.left_top() + vec2(0.0, -24.0), tag_galley(&painter, &text, color), color);
+                }
+            }
+            // Their selections, outside this person's own outline (one ring each), and the values they drag.
+            let mut rings: HashMap<u32, f32> = HashMap::new();
+            for o in &here {
+                let color = rgb(o.color);
+                for sel in o.state["selection"].as_array().into_iter().flatten().take(MOST) {
+                    let Some(card) = id(sel).and_then(|i| Card::of(&app.g, i).map(|c| (i, c))) else { continue };
+                    let ring = rings.entry(card.0).or_insert(0.0);
+                    let r = Rect::from_min_size(at(card.1.pos), card.1.size() * z);
+                    if card.1.dot {
+                        painter.circle_stroke(r.center(), 9.0 * z + 3.0 + *ring, Stroke::new(2.0, color));
+                    } else {
+                        painter.rect_stroke(r.expand(2.0 + *ring), 3.0 * z + 2.0 + *ring, Stroke::new(2.0, color), StrokeKind::Outside);
+                    }
+                    *ring += 2.0;
+                }
+                if let Some(c) = o.state["frame"].as_u64().and_then(|i| app.g.comments.get(usize::try_from(i).ok()?)) {
+                    painter.rect_stroke(Rect::from_min_size(at(c.pos), vec2(c.size[0], c.size[1]) * z).expand(2.0), 4.0 * z + 2.0, Stroke::new(2.0, color), StrokeKind::Outside);
+                }
+                let param = &o.state["param"];
+                if let (Some(card), Some(text)) = (id(&param["node"]).and_then(|i| Card::of(&app.g, i)), param["text"].as_str()) {
+                    let galley = tag_galley(&painter, &cut(text, 40), color);
+                    let h = galley.size().y + 2.0 * TAG_PAD.y;
+                    tag(&painter, at(card.pos) - vec2(0.0, h + 4.0), galley, color);
+                }
+            }
+            // Pointers over everything of theirs.
+            for o in &here {
+                if let Some(p) = shown.get(&o.id).and_then(|s| s.pointer) {
+                    pointer(&painter, at(p), rgb(o.color), &o.name);
+                }
+            }
+            if moving {
+                ctx.request_repaint();
+            }
+        });
+    });
+}
