+#[test]
+fn presence_carries_a_node_drag_under_way() {
+    let mut app = app();
+    let ctx = egui::Context::default();
+    playground_live::connect();
+    app.sel = [2, 3].into();
+    frame(&mut app, &ctx);
+    // The pointer goes down on node 2 and drags it with node 3 (as the canvas does).
+    let press = egui::Event::PointerButton { pos: pos2(5.0, 5.0), button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() };
+    pass(&ctx, vec![press], |_| {});
+    for id in [2, 3] {
+        app.g.nodes.get_mut(&id).unwrap().pos[1] += 40.5;
+    }
+    let state = mine(&app);
+    assert_eq!(state["selection"], json!([2, 3]));
+    assert_eq!(state["moving"], json!([[2, 150.0, 40.5], [3, 300.0, 40.5]]));
+    // Remote presence is read defensively: drawing junk paints nothing and never panics.
+    peers::show(vec![Presence { id: "x".into(), name: "X".into(), color: [1, 2, 3], state: json!({"graph": [], "moving": [[2, "a"], [99, 1, 2]], "pointer": [1e30, 0], "wire": {"from": 99}}) }]);
+    pass(&ctx, Vec::new(), |ctx| peers::draw(&app, ctx));
+}
+
+/// One egui pass with `events`, its output dropped.
+fn pass(ctx: &egui::Context, events: Vec<egui::Event>, mut f: impl FnMut(&egui::Context)) {
+    ctx.run_ui(egui::RawInput { events, ..Default::default() }, |ui| f(ui.ctx())).textures_delta.clear();
+}
+
+fn mine(app: &App) -> Value {
+    app.live_presence()
+}
