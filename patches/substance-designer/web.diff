@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! MaterialCraft's browser build in Playground (patches/substance-designer.yaml in github.com/daijro/openplayground).
+//! wasm32-unknown-unknown has no files, threads or clock, so the modules that use them take `std` from here instead
+//! (one `#[cfg(target_arch = "wasm32")] use crate::playground::std;` line each): the same std, except
+//!   fs      an in-memory file system: opened, saved and exported files live here for the session, and writes to
+//!           `browser:` paths and to the Downloads folder are handed to the page (see `fs::on_write`);
+//!   thread  `scope` runs its threads one after another, `spawn` queues the job for the page to run between frames;
+//!   time    web-time's Instant and SystemTime, which work in the browser;
+//!   env     temp_dir() is /tmp instead of a panic.
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod fs {
+        pub use ::std::fs::*;
+        use ::std::{cell::RefCell, collections::BTreeMap, io, path::{Component, Path, PathBuf}, sync::OnceLock};
+
+        thread_local! {
+            static FILES: RefCell<BTreeMap<PathBuf, (Vec<u8>, web_time::SystemTime)>> = RefCell::default();
+        }
+        static ON_WRITE: OnceLock<fn(&Path, &[u8])> = OnceLock::new();
+
+        /// Called after every write with the path and the bytes (the page forwards some of them).
+        pub fn on_write(f: fn(&Path, &[u8])) {
+            let _ = ON_WRITE.set(f);
+        }
+
+        /// `a/./b/../c` -> `a/c`, so a link's `base.join(relative)` finds the file it points at.
+        fn key(p: &Path) -> PathBuf {
+            let mut out = PathBuf::new();
+            for c in p.components() {
+                match c {
+                    Component::CurDir => {}
+                    Component::ParentDir => {
+                        out.pop();
+                    }
+                    c => out.push(c),
+                }
+            }
+            out
+        }
+
+        fn missing(p: &Path) -> io::Error {
+            io::Error::new(io::ErrorKind::NotFound, format!("{} is not open in this browser tab", p.display()))
+        }
+
+        /// Store a file without telling the page (files the page itself hands in).
+        pub fn put(p: &Path, bytes: Vec<u8>) {
+            FILES.with(|f| f.borrow_mut().insert(key(p), (bytes, web_time::SystemTime::now())));
+        }
+
+        pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(p: P, bytes: C) -> io::Result<()> {
+            put(p.as_ref(), bytes.as_ref().to_vec());
+            if let Some(f) = ON_WRITE.get() {
+                f(&key(p.as_ref()), bytes.as_ref());
+            }
+            Ok(())
+        }
+
+        pub fn read<P: AsRef<Path>>(p: P) -> io::Result<Vec<u8>> {
+            FILES.with(|f| f.borrow().get(&key(p.as_ref())).map(|e| e.0.clone())).ok_or_else(|| missing(p.as_ref()))
+        }
+
+        pub fn read_to_string<P: AsRef<Path>>(p: P) -> io::Result<String> {
+            String::from_utf8(read(p)?).map_err(|e| io::Error::new(io::ErrorKind::InvalidData, e))
+        }
+
+        pub fn create_dir_all<P: AsRef<Path>>(_: P) -> io::Result<()> {
+            Ok(())
+        }
+
+        pub struct Metadata(u64, web_time::SystemTime);
+        impl Metadata {
+            pub fn len(&self) -> u64 {
+                self.0
+            }
+            pub fn modified(&self) -> io::Result<web_time::SystemTime> {
+                Ok(self.1)
+            }
+            pub fn is_file(&self) -> bool {
+                true
+            }
+        }
+
+        pub fn metadata<P: AsRef<Path>>(p: P) -> io::Result<Metadata> {
+            FILES.with(|f| f.borrow().get(&key(p.as_ref())).map(|e| Metadata(e.0.len() as u64, e.1))).ok_or_else(|| missing(p.as_ref()))
+        }
+
+        pub struct DirEntry(PathBuf);
+        impl DirEntry {
+            pub fn path(&self) -> PathBuf {
+                self.0.clone()
+            }
+            pub fn file_name(&self) -> ::std::ffi::OsString {
+                self.0.file_name().unwrap_or_default().to_os_string()
+            }
+        }
+
+        pub fn read_dir<P: AsRef<Path>>(p: P) -> io::Result<::std::vec::IntoIter<io::Result<DirEntry>>> {
+            let dir = key(p.as_ref());
+            Ok(FILES.with(|f| f.borrow().keys().filter(|k| k.parent() == Some(&dir)).map(|k| Ok(DirEntry(k.clone()))).collect::<Vec<_>>()).into_iter())
+        }
+    }
+
+    pub mod thread {
+        pub use ::std::thread::*;
+        use ::std::{cell::RefCell, collections::VecDeque, sync::OnceLock};
+
+        thread_local! {
+            static QUEUE: RefCell<VecDeque<Box<dyn FnOnce()>>> = RefCell::default();
+        }
+        static WAKE: OnceLock<fn()> = OnceLock::new();
+
+        /// Called when a job is queued (the page schedules `run_one`).
+        pub fn on_spawn(f: fn()) {
+            let _ = WAKE.set(f);
+        }
+
+        /// Queue `f` (a background job: an evaluation, the start page's thumbnails); `run_one` runs it.
+        pub fn spawn<F: FnOnce() -> T + 'static, T: 'static>(f: F) {
+            QUEUE.with(|q| q.borrow_mut().push_back(Box::new(move || drop(f()))));
+            if let Some(wake) = WAKE.get() {
+                wake();
+            }
+        }
+
+        /// Run the oldest queued job; false when there was none.
+        pub fn run_one() -> bool {
+            let job = QUEUE.with(|q| q.borrow_mut().pop_front());
+            job.map(|j| j()).is_some()
+        }
+
+        pub fn pending() -> bool {
+            QUEUE.with(|q| !q.borrow().is_empty())
+        }
+
+        pub struct Scope(());
+        impl Scope {
+            pub fn spawn<F: FnOnce() -> T, T>(&self, f: F) {
+                f();
+            }
+        }
+
+        /// Like `std::thread::scope`, with every spawned closure run at once, in order.
+        pub fn scope<F: FnOnce(&Scope) -> T, T>(f: F) -> T {
+            f(&Scope(()))
+        }
+    }
+
+    pub mod time {
+        pub use web_time::*;
+    }
+
+    pub mod env {
+        pub use ::std::env::*;
+        pub fn temp_dir() -> ::std::path::PathBuf {
+            "/tmp".into()
+        }
+    }
+}
+
+/// `craft_atomic::atomic_write` into the in-memory file system (safe saves are the page's business).
+pub mod craft_atomic {
+    pub fn atomic_write(path: &::std::path::Path, bytes: &[u8]) -> ::std::io::Result<()> {
+        super::std::fs::write(path, bytes)
+    }
+}
+
+/// The 3D viewport's OpenGL 3.3 shaders as WebGL2 (GLSL ES 3.00) ones.
+pub fn glsl_es(src: impl AsRef<str>) -> String {
+    src.as_ref().replacen("#version 330 core", "#version 300 es\nprecision highp float;\nprecision highp int;", 1)
+}
diff --git a/src/playground_gui.rs b/src/playground_gui.rs
new file mode 100644
index 0000000..b217a51
--- /dev/null
+++ b/src/playground_gui.rs
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! The editor in the browser, in Playground (patches/substance-designer.yaml in github.com/daijro/openplayground).
+//! A child of the editor module (src/gui.rs declares it on wasm only), so it can drive `App` like the menus do.
+//!
+//! Files: the editor asks for paths through rfd's blocking dialogs. In the browser the `rfd` and `craft_settings`
+//! names in the editor are these shims, and files go through the page's `globalThis.playgroundFiles` (Playground's
+//! browser storage, with "From computer…" and downloads):
+//!   Open, Link package     the explorer opens; the picked files land in the in-memory file system
+//!                          (crate::playground::std::fs) and the editor's own open_file / link_package runs again,
+//!                          now getting them;
+//!   Save As, Publish       Save As asks "keep in browser storage / download"; kept files are `browser:/…` paths that
+//!                          Save writes back to; a file from the computer saves as a download;
+//!   bitmaps, SVG, fonts,   pick_file answers at once with a path under Imports/ that the picked file fills a moment
+//!   meshes                 later (the graph then evaluates again);
+//!   export, bake folders   pick_folder answers "Downloads": everything written there is downloaded.
+//! Background jobs (crate::playground::std::thread::spawn) run one per timer tick, between frames.
+
+use super::App;
+use crate::playground::std::{fs, thread};
+use eframe::egui;
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+use wasm_bindgen::{closure::Closure, JsCast as _, JsValue};
+
+/// The folder pick_folder answers: files written in it are downloaded.
+const DOWNLOADS: &str = "Downloads";
+
+#[derive(Clone, Copy, PartialEq)]
+enum Ask {
+    Open,
+    Link,
+    SaveAs,
+    Publish,
+}
+
+#[derive(Default)]
+struct State {
+    /// A dialog the editor asked for this frame: (what for, file types, suggested file name).
+    request: Option<(Ask, Vec<String>, String)>,
+    /// The page answered: run that dialog's editor function again, which then gets these paths.
+    answer: Option<(Ask, Vec<PathBuf>)>,
+    /// A pick_file that answered at once with this Imports/ path; the page fills it.
+    import: Option<(PathBuf, Vec<String>)>,
+    /// Files have arrived: evaluate the graph again.
+    refresh: bool,
+    imports: usize,
+    unsaved: Option<bool>,
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::default();
+    static CTX: std::cell::OnceCell<egui::Context> = const { std::cell::OnceCell::new() };
+    static TIMER: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+fn with<T>(f: impl FnOnce(&mut State) -> T) -> T {
+    STATE.with(|s| f(&mut s.borrow_mut()))
+}
+
+fn repaint() {
+    CTX.with(|c| c.get().map(|c| c.request_repaint()));
+}
+
+/// rfd's blocking FileDialog, answered by the page (see the top of this file).
+pub mod rfd {
+    use super::{with, Ask, DOWNLOADS};
+    use std::path::PathBuf;
+
+    #[derive(Default)]
+    pub struct FileDialog {
+        exts: Vec<String>,
+        name: String,
+    }
+
+    impl FileDialog {
+        pub fn new() -> Self {
+            Self::default()
+        }
+        pub fn add_filter(mut self, _name: impl Into<String>, exts: &[impl ToString]) -> Self {
+            self.exts.extend(exts.iter().map(|e| e.to_string()));
+            self
+        }
+        pub fn set_file_name(mut self, name: impl Into<String>) -> Self {
+            self.name = name.into();
+            self
+        }
+        pub fn set_directory(self, _dir: impl AsRef<std::path::Path>) -> Self {
+            self
+        }
+        fn ask(self, ask: Ask) -> Option<Vec<PathBuf>> {
+            with(|s| match s.answer.take() {
+                Some((a, paths)) if a == ask => Some(paths),
+                _ => {
+                    s.request = Some((ask, self.exts, self.name));
+                    None
+                }
+            })
+        }
+        pub fn pick_files(self) -> Option<Vec<PathBuf>> {
+            self.ask(Ask::Open)
+        }
+        pub fn pick_file(self) -> Option<PathBuf> {
+            if self.exts.iter().any(|e| e == "mcg" || e == "mca") {
+                return self.ask(Ask::Link)?.into_iter().next();
+            }
+            with(|s| {
+                s.imports += 1;
+                let p = PathBuf::from(format!("Imports/{}.{}", s.imports, self.exts.first().map(String::as_str).unwrap_or("bin")));
+                s.import = Some((p.clone(), self.exts));
+                Some(p)
+            })
+        }
+        pub fn save_file(self) -> Option<PathBuf> {
+            let ask = if self.exts.iter().any(|e| e == "mca") { Ask::Publish } else { Ask::SaveAs };
+            self.ask(ask)?.into_iter().next()
+        }
+        pub fn pick_folder(self) -> Option<PathBuf> {
+            Some(PathBuf::from(DOWNLOADS))
+        }
+    }
+}
+
+/// craft-settings without a settings folder: the editor's preferences last as long as the page.
+pub mod craft_settings {
+    pub use ::craft_settings::*;
+
+    pub enum Location {
+        Auto,
+    }
+
+    pub struct TickResult {
+        pub next_deadline: Option<crate::playground::std::time::Instant>,
+    }
+
+    pub struct SettingsStore<T>(T);
+
+    impl<T: Settings> SettingsStore<T> {
+        pub fn open(_: Location) -> (Self, ()) {
+            (Self(T::default()), ())
+        }
+        pub fn path(&self) -> Option<&std::path::Path> {
+            None
+        }
+        pub fn get(&self) -> &T {
+            &self.0
+        }
+        pub fn set(&mut self, value: T) -> bool {
+            self.0 = value;
+            true
+        }
+        pub fn update(&mut self, f: impl FnOnce(&mut T)) -> bool {
+            f(&mut self.0);
+            true
+        }
+        pub fn tick<I>(&mut self, _now: I) -> TickResult {
+            TickResult { next_deadline: None }
+        }
+        pub fn flush(&mut self) -> Result<(), ()> {
+            Ok(())
+        }
+    }
+}
+
+// ---------------------------------------------------------------- the page's playgroundFiles
+
+fn api() -> Option<JsValue> {
+    js_sys::Reflect::get(&js_sys::global(), &"playgroundFiles".into()).ok().filter(JsValue::is_object)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has no playgroundFiles or the call threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = api()?;
+    let f = js_sys::Reflect::get(&api, &method.into()).ok()?.dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+fn object(fields: &[(&str, JsValue)]) -> JsValue {
+    let o = js_sys::Object::new();
+    for (k, v) in fields {
+        let _ = js_sys::Reflect::set(&o, &(*k).into(), v);
+    }
+    o.into()
+}
+
+fn types(exts: &[String]) -> JsValue {
+    exts.iter().map(|e| JsValue::from_str(e)).collect::<js_sys::Array>().into()
+}
+
+fn bytes(b: &[u8]) -> JsValue {
+    js_sys::Uint8Array::from(b).into()
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+/// Await `playgroundFiles[method](...)` without blocking the editor, then hand the result to `done`.
+fn later(method: &'static str, args: Vec<JsValue>, done: impl FnOnce(JsValue) + 'static) {
+    let Some(promise) = call(method, &args).and_then(|p| p.dyn_into::<js_sys::Promise>().ok()) else {
+        return log(&format!("MaterialCraft: no playgroundFiles.{method} on this page"));
+    };
+    wasm_bindgen_futures::spawn_local(async move {
+        match wasm_bindgen_futures::JsFuture::from(promise).await {
+            Ok(v) => done(v),
+            Err(e) => log(&format!("MaterialCraft: playgroundFiles.{method} failed: {e:?}")),
+        }
+        repaint();
+    });
+}
+
+fn log(s: &str) {
+    web_sys::console::warn_1(&s.into());
+}
+
+/// Files the page handed in ([{path, name, bytes}]), stored in the in-memory file system: a stored file keeps its
+/// `browser:/…` path; one from the computer becomes Downloads/<name>, so saving it downloads it.
+fn arrived(files: &JsValue) -> Vec<PathBuf> {
+    let Some(list) = files.dyn_ref::<js_sys::Array>() else { return Vec::new() };
+    list.iter()
+        .map(|f| {
+            let path = get(&f, "path").as_string().map(PathBuf::from).unwrap_or_else(|| Path::new(DOWNLOADS).join(get(&f, "name").as_string().unwrap_or_default()));
+            fs::put(&path, js_sys::Uint8Array::new(&get(&f, "bytes")).to_vec());
+            path
+        })
+        .collect()
+}
+
+fn answer(ask: Ask, paths: Vec<PathBuf>) {
+    if !paths.is_empty() {
+        with(|s| s.answer = Some((ask, paths)));
+    }
+}
+
+/// What the editor writes: `browser:` paths go to browser storage, Downloads/ to the person's downloads.
+fn on_write(path: &Path, data: &[u8]) {
+    let name = path.to_string_lossy();
+    if name.starts_with("browser:") {
+        call("write", &[name.as_ref().into(), bytes(data)]);
+    } else if let Ok(rest) = path.strip_prefix(DOWNLOADS) {
+        let file = rest.to_string_lossy().replace('/', "-");
+        call("download", &[file.into(), bytes(data)]);
+    }
+}
+
+/// Run one queued background job on a timer, after the frame that queued it is on screen.
+fn on_spawn() {
+    if TIMER.with(|t| t.replace(true)) {
+        return;
+    }
+    let tick = Closure::once_into_js(|| {
+        TIMER.with(|t| t.set(false));
+        thread::run_one();
+        if thread::pending() {
+            on_spawn();
+        }
+        repaint();
+    });
+    if let Some(w) = web_sys::window() {
+        let _ = w.set_timeout_with_callback_and_timeout_and_arguments_0(tick.unchecked_ref(), 0);
+    }
+}
+
+// ---------------------------------------------------------------- the editor, with the dialogs answered
+
+struct Web(App);
+
+impl Web {
+    /// After the editor's frame: send the dialog it asked for to the page, run the one the page answered.
+    fn after(&mut self) {
+        let app = &mut self.0;
+        if let Some((ask, exts, name)) = with(|s| s.request.take()) {
+            match ask {
+                Ask::Open | Ask::Link => later("open", vec![object(&[("types", types(&exts))])], move |v| answer(ask, arrived(&v))),
+                Ask::SaveAs | Ask::Publish => {
+                    app.goto_root();
+                    let text = if ask == Ask::Publish { app.g.publish().unwrap_or_default() } else { app.g.to_text() };
+                    let name = app.file.as_ref().and_then(|f| f.file_stem()).zip(exts.first()).map(|(s, e)| format!("{}.{e}", s.to_string_lossy())).unwrap_or(name);
+                    let args = object(&[("name", name.into()), ("types", types(&exts)), ("bytes", bytes(text.as_bytes()))]);
+                    later("saveAs", vec![args], move |v| answer(ask, get(&v, "path").as_string().map(PathBuf::from).into_iter().collect()));
+                }
+            }
+        }
+        if let Some((path, exts)) = with(|s| s.import.take()) {
+            later("open", vec![object(&[("types", types(&exts))])], move |v| {
+                if let Some(bytes) = arrived(&v).first().and_then(|p| fs::read(p).ok()) {
+                    fs::put(&path, bytes);
+                    with(|s| s.refresh = true);
+                }
+            });
+        }
+        match with(|s| s.answer.as_ref().map(|a| a.0)) {
+            Some(Ask::Open) => app.open_file(),
+            Some(Ask::Link) => app.link_package(),
+            Some(Ask::SaveAs) => app.save_as(),
+            Some(Ask::Publish) => app.publish(),
+            None => {}
+        }
+        // (an editor function that returned before its dialog leaves the answer unused)
+        with(|s| s.answer = None);
+        if with(|s| std::mem::take(&mut s.refresh)) {
+            app.dirty = true;
+        }
+        let unsaved = app.modified || app.pkgs.iter().flatten().any(|p| p.modified);
+        if with(|s| s.unsaved.replace(unsaved)) != Some(unsaved) {
+            call("setUnsaved", &[unsaved.into()]);
+        }
+    }
+}
+
+impl eframe::App for Web {
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.0.ui(ui, frame);
+        self.after();
+    }
+
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.0.logic(ctx, frame);
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.0.raw_input_hook(ctx, raw_input);
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.0.clear_color(visuals)
+    }
+
+    fn on_exit(&mut self, gl: Option<&eframe::glow::Context>) {
+        self.0.on_exit(gl);
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
+
+/// Start the editor on the page's canvas (#materialcraft_canvas).
+pub fn start() {
+    fs::on_write(on_write);
+    thread::on_spawn(on_spawn);
+    // Playground's Files ("Open in MaterialCraft", ?open=browser:/…) hands a stored file to the editor
+    let open = Closure::<dyn Fn(JsValue)>::new(|f: JsValue| {
+        answer(Ask::Open, arrived(&js_sys::Array::of1(&f).into()));
+        repaint();
+    });
+    call("onOpen", &[open.into_js_value()]);
+    wasm_bindgen_futures::spawn_local(async {
+        let document = web_sys::window().and_then(|w| w.document()).expect("no document");
+        let canvas = document.get_element_by_id("materialcraft_canvas").and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok()).expect("no #materialcraft_canvas");
+        let options = eframe::WebOptions { depth_buffer: 24, ..Default::default() };
+        let started = eframe::WebRunner::new()
+            .start(
+                canvas,
+                options,
+                Box::new(|cc| {
+                    CTX.with(|c| c.set(cc.egui_ctx.clone()).ok());
+                    let mut app = App::new(cc);
+                    // one thread here: previews stop at 1024 px (a 2048 px pass holds the page for seconds); the
+                    // 2D view's size menu still offers the graph's own size
+                    app.prev_size = 1024;
+                    Ok(Box::new(Web(app)))
+                }),
+            )
+            .await;
+        if let Some(loading) = document.get_element_by_id("materialcraft_loading") {
+            match started {
+                Ok(()) => loading.remove(),
+                Err(e) => loading.set_text_content(Some(&format!("MaterialCraft could not start: {e:?}"))),
+            }
+        }
+    });
+}
