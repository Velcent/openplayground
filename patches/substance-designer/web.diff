+# MaterialCraft in the browser, for Playground (patches/substance-designer.yaml in github.com/daijro/openplayground).
+# The editor is src/gui.rs, built into the library on wasm (src/lib.rs); src/playground*.rs hold the web parts.
+# Build with: trunk build --release   (from apps/materialcraft-web)
+[package]
+name = "materialcraft-web"
+version = "0.1.0"
+edition = "2021"
+license = "MIT OR Apache-2.0"
+publish = false
+
+[[bin]]
+name = "materialcraft-web"
+path = "src/main.rs"
+
+[dependencies]
+materialcraft = { path = "../..", features = ["gui"] }
+
+# its own workspace (the repository root is a plain package)
+[workspace]
+
+[profile.release]
+opt-level = 3
+lto = true
+codegen-units = 1
