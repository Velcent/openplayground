index 0000000..eee840c
--- /dev/null
+++ b/crates/engine/src/live_playground.rs
@@ -0,0 +1,412 @@
+//! Playground live editing of one open document (the web build; [`playground_live`] is the adapter the Playground shell
+//! drives). The shared document is the collaboration core's snapshot of the file ([`Replica::snapshot`]: layers with
+//! their properties, styles, variables, comments, images) without its name and opening page, which stay this person's
+//! like the selection, page and view. Merges are the core's three-way branch merge ([`merge::plan`]), strict: a
+//! property both sides wrote is a conflict, even when they wrote the same value. Derived data (auto layout, instances)
+//! is recomputed after a merge.
+//!
+//! The session edits the document in front when it connects. Once its tab is closed, or a native live session
+//! (`collab.*`) has the document, the session keeps the last one it saw, and the others' next change opens it in a tab.
+//!
+//! Presence: each person shares the page they look at, their pointer on it (page coordinates) and their selection
+//! (ids as strings: JavaScript numbers lose the low bits of client-space ids); the canvas draws the others'
+//! (`figcraft_ui_egui::live::playground`).
+
+use std::cell::{Cell, RefCell};
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+use figcraft_collab::merge::{self, Key, Side};
+use figcraft_collab::{Change, DocProp, Entry, Prop, Recompute as _, Replica};
+use figcraft_doc::{Document, NodeId};
+use serde::Deserialize as _;
+use serde_json::Value;
+
+use crate::collab::EngineRecompute;
+use crate::{DocState, EngineError, Result as EngineResult, Session};
+use playground_live::{Error, Live, Presence};
+
+/// The Playground adapter (patches/live/playground_live.rs, copied next to this file).
+#[path = "playground_live.rs"]
+pub mod playground_live;
+
+/// Most selected ids a presence carries.
+const MAX_SELECTION: usize = 50;
+
+thread_local! {
+    /// The document the connected session edits (`None`: none yet, the one in front).
+    static BOUND: Cell<Option<u64>> = const { Cell::new(None) };
+    /// A pointer button was down, or a text field had the keyboard, in the last frame.
+    static HELD: Cell<bool> = const { Cell::new(false) };
+    /// The shared document last seen in its tab.
+    static SEEN: RefCell<Option<Arc<Document>>> = const { RefCell::new(None) };
+    /// The pointer over the canvas this frame, and in the last frame (page coordinates).
+    static POINTED: Cell<Option<(f64, f64)>> = const { Cell::new(None) };
+    static POINTER: Cell<Option<(f64, f64)>> = const { Cell::new(None) };
+    /// The others, as the shell last showed them.
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+}
+
+/// The end of each frame (`held`: a pointer button is down or a text field has the keyboard).
+pub fn frame(s: &mut Session, held: bool) {
+    HELD.set(held);
+    POINTER.set(POINTED.take());
+    playground_live::frame(s);
+}
+
+/// The pointer over the canvas in this frame (page coordinates; the canvas tells, while it shows).
+pub fn point(at: Option<(f64, f64)>) {
+    POINTED.set(at);
+}
+
+/// Someone else on the page in front of the session's document: their pointer and the selected layers there.
+pub struct Other {
+    pub name: String,
+    pub color: [u8; 3],
+    pub pointer: Option<(f64, f64)>,
+    pub selection: Vec<NodeId>,
+}
+
+/// The others on the page in front, when it is the session's document (what does not resolve is left out).
+pub fn others(s: &Session) -> Vec<Other> {
+    let Some(ds) = in_front(s) else { return Vec::new() };
+    let id = |v: &Value| v.as_str()?.parse().ok().map(NodeId);
+    let coordinate = |v: &Value| v.as_f64().filter(|c| c.abs() < 1e9);
+    OTHERS.with_borrow(|others| {
+        others
+            .iter()
+            .filter(|p| id(&p.state["page"]) == Some(ds.page))
+            .map(|p| Other {
+                name: p.name.clone(),
+                color: p.color,
+                pointer: coordinate(&p.state["pointer"][0]).zip(coordinate(&p.state["pointer"][1])),
+                selection: p.state["selection"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .take(MAX_SELECTION)
+                    .filter_map(id)
+                    .filter(|n| ds.doc.page_of(*n) == Some(ds.page))
+                    .collect(),
+            })
+            .collect()
+    })
+}
+
+/// The session's document in its tab, unless a native live session has it.
+fn bound(s: &Session) -> Option<&DocState> {
+    let uid = BOUND.get().or_else(|| s.ds().ok().map(|d| d.uid))?;
+    s.docs.iter().find(|d| d.uid == uid).filter(|_| !s.live.iter().any(|l| l.doc_uid == Some(uid)))
+}
+
+/// The session's document: in its tab, else the last one seen there. Binds it while connected.
+fn current(s: &Session) -> Option<Arc<Document>> {
+    let Some(ds) = bound(s) else { return SEEN.with_borrow(Clone::clone) };
+    if playground_live::connected() {
+        BOUND.set(Some(ds.uid));
+        SEEN.set(Some(ds.doc.clone()));
+    }
+    Some(ds.doc.clone())
+}
+
+/// Undo or Redo (`redo`) of the document in front goes to the Playground session while it edits that document.
+pub(crate) fn undo(s: &Session, redo: bool) -> bool {
+    in_front(s).is_some() && playground_live::undo(redo)
+}
+
+/// The session's document, when its tab is the one in front.
+fn in_front(s: &Session) -> Option<&DocState> {
+    bound(s).filter(|d| s.ds().is_ok_and(|a| a.uid == d.uid))
+}
+
+/// Document `uid` is the session's: it takes no branches (their id spaces are per file, the same on every peer).
+pub(crate) fn refuse_branches(s: &Session, cmd: &str, uid: u64) -> EngineResult<()> {
+    if playground_live::connected() && bound(s).is_some_and(|d| d.uid == uid) {
+        return Err(EngineError::Disabled(cmd.into(), "branches aren't available in a live session".into()));
+    }
+    Ok(())
+}
+
+/// `doc` as shared: its snapshot without the file name and opening page.
+fn shared(doc: &Document) -> Result<Value, Error> {
+    let mut changes = Replica::new(doc.clone()).snapshot().map_err(|e| e.to_string())?;
+    changes.retain(|c| !matches!(c, Change::SetDoc { prop: DocProp::Name | DocProp::CurrentPage, .. }));
+    serde_json::to_value(changes).map_err(|e| e.to_string())
+}
+
+fn document(shared: &Value) -> Result<Document, Error> {
+    let invalid = |e: String| format!("Invalid shared document: {e}");
+    let changes = Vec::<Change>::deserialize(shared).map_err(|e| invalid(e.to_string()))?;
+    Ok(Replica::from_snapshot(&changes).map_err(|e| invalid(e.to_string()))?.document().clone())
+}
+
+/// What a change writes, as the core's merge names conflicts (creations write nothing another side can: ids are per
+/// client; images are content-addressed).
+fn written(c: &Change) -> Option<Key> {
+    Some(match c {
+        Change::Set { id, prop: Prop::Position, .. } => Key::Node(*id, Prop::Parent),
+        Change::Set { id, prop, .. } => Key::Node(*id, *prop),
+        Change::Delete { id } => Key::Layer(*id),
+        Change::SetDoc { prop, .. } => Key::Doc(*prop),
+        Change::Create { .. } | Change::Put { entry: Entry::Image(_), .. } | Change::Remove { entry: Entry::Image(_) } => return None,
+        Change::Put { entry, .. } | Change::Remove { entry } => Key::Entry(entry.clone()),
+    })
+}
+
+impl Live for Session {
+    fn live_document(&self) -> Value {
+        current(self).and_then(|doc| shared(&doc).ok()).unwrap_or(Value::Null)
+    }
+
+    /// Installs the shared document as others' edits are ([`Session::apply_remote`]): no undo step, the page,
+    /// selection and view stay; with its tab closed it opens in a new one. New ids come from this person's own space
+    /// ([`Document::set_client_id`]).
+    fn live_adopt(&mut self, shared: Value) -> Result<(), Error> {
+        let mut doc = document(&shared)?;
+        let mine = current(self);
+        doc.name = mine.as_ref().map_or_else(|| "Untitled".into(), |m| m.name.clone());
+        if let Some(m) = &mine {
+            doc.current_page = m.current_page;
+            doc.published.clone_from(&m.published);
+        }
+        // 32 of the session's random bits.
+        let client = match mine.map_or(0, |m| m.client_id()) {
+            0 => (playground_live::fresh_id(&mut 0) as u32).max(1),
+            c => c,
+        };
+        doc.set_client_id(client);
+        match bound(self).map(|ds| ds.uid) {
+            Some(uid) => self.apply_remote(uid, Arc::new(doc)),
+            None => {
+                let ds = DocState::new(doc, None);
+                BOUND.set(Some(ds.uid));
+                SEEN.set(Some(ds.doc.clone()));
+                self.active = self.docs.len();
+                self.docs.push(ds);
+            }
+        }
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        !HELD.get() && bound(self).is_none_or(|ds| ds.interaction.is_none() && ds.preview.is_none() && ds.text_preview.is_none())
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        current(self).map(|doc| bound(self).map_or(0, |ds| ds.revision) ^ (Arc::as_ptr(&doc) as usize as u64).rotate_left(32))
+    }
+
+    /// Native undo steps from the session would take back others' edits.
+    fn live_disconnected(&mut self) {
+        SEEN.set(None);
+        let Some(uid) = BOUND.take() else { return };
+        if let Some(ds) = self.docs.iter_mut().find(|d| d.uid == uid) {
+            ds.history.undo.clear();
+            ds.history.redo.clear();
+        }
+    }
+
+    /// What every peer installs reads as a document.
+    fn live_check(shared: &Value) -> Result<(), Error> {
+        document(shared).map(drop)
+    }
+
+    /// The page in front, the pointer on it and the selection, while the session's document is in front.
+    fn live_presence(&self) -> Value {
+        let Some(ds) = in_front(self) else { return Value::Null };
+        let selection: Vec<String> = ds.selection.iter().take(MAX_SELECTION).map(|n| n.0.to_string()).collect();
+        let mut state = serde_json::json!({ "page": ds.page.0.to_string(), "selection": selection });
+        if let Some((x, y)) = POINTER.get().filter(|(x, y)| x.is_finite() && y.is_finite()) {
+            state["pointer"] = serde_json::json!([x, y]);
+        }
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+        if edited == base {
+            return Ok(current.clone());
+        }
+        if current == base {
+            return Ok(edited.clone());
+        }
+        let (base, current, edited) = (document(base)?, document(current)?, document(edited)?);
+        let plan = merge::plan(&base, &edited, &current).map_err(|e| e.to_string())?;
+        let theirs: BTreeSet<Key> = plan.main.iter().filter_map(written).collect();
+        let both = plan.branch.iter().filter_map(written).find(|k| theirs.contains(k));
+        if let Some(key) = plan.conflicts.first().map(|c| c.key.clone()).or(both) {
+            return Err(format!("Conflict at {key}"));
+        }
+        let (mut doc, touched) = plan.merge(&current, Side::Branch, &|_| None).map_err(|e| e.to_string())?;
+        EngineRecompute.recompute(&mut doc, &current, &touched);
+        shared(&doc)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::playground_live::{activity, canonical, connect, disconnect, frame, queue};
+    use super::*;
+    use serde_json::json;
+    use std::cell::RefCell;
+    use std::rc::Rc;
+
+    fn rect(s: &mut Session, x: f64) -> NodeId {
+        let made = s.execute("node.create", &json!({"type": "rectangle", "x": x, "y": 0, "width": 50, "height": 50})).unwrap();
+        NodeId(made["id"].as_u64().unwrap())
+    }
+
+    fn rename(s: &mut Session, id: NodeId, name: &str) {
+        s.execute("node.set", &json!({"id": id, "props": {"name": name}})).unwrap();
+    }
+
+    /// Another person's document (the binding is per thread: one session per page).
+    fn theirs(s: &Session) -> Value {
+        let mine = (BOUND.take(), SEEN.take());
+        let shared = s.live_document();
+        (BOUND.set(mine.0), SEEN.set(mine.1));
+        shared
+    }
+
+    fn name(s: &Session, id: NodeId) -> String {
+        s.doc().unwrap().node(id).unwrap().name.clone()
+    }
+
+    #[test]
+    fn the_shared_document_leaves_out_the_name_page_and_views() {
+        let mut s = Session::new();
+        let r = rect(&mut s, 0.0);
+        let shared = canonical(&s.live_document());
+        let ds = s.ds_mut().unwrap();
+        ds.view.zoom = 4.0;
+        ds.selection = vec![r];
+        let doc = Arc::make_mut(&mut ds.doc);
+        doc.name = "Mine".into();
+        doc.current_page = None;
+        assert_eq!(canonical(&s.live_document()), shared);
+        rename(&mut s, r, "Card");
+        assert_ne!(canonical(&s.live_document()), shared);
+    }
+
+    #[test]
+    fn adopting_keeps_this_persons_views_and_adds_no_undo_step() {
+        let mut a = Session::new();
+        rect(&mut a, 0.0);
+        let mut b = Session::new();
+        b.ds_mut().unwrap().view.zoom = 2.0;
+        let page = b.ds().unwrap().page;
+        b.live_adopt(theirs(&a)).unwrap();
+        assert_eq!(canonical(&b.live_document()), canonical(&theirs(&a)));
+        let ds = b.ds().unwrap();
+        assert_eq!((ds.view.zoom, ds.page, ds.history.undo.len(), ds.doc.name.as_str()), (2.0, page, 0, "Untitled"));
+        assert_ne!(ds.doc.client_id(), 0, "new ids come from this person's space");
+    }
+
+    #[test]
+    fn remote_changes_wait_for_gestures_merge_by_layer_and_undo_goes_to_the_session() {
+        let mut a = Session::new();
+        let (r1, r2) = (rect(&mut a, 0.0), rect(&mut a, 100.0));
+        let base = theirs(&a);
+        let mut b = Session::new();
+        b.live_adopt(base.clone()).unwrap();
+        rename(&mut a, r1, "A");
+        connect();
+        rename(&mut b, r2, "B");
+        b.begin_interaction("Move").unwrap();
+        let done = Rc::new(RefCell::new(None));
+        let to = done.clone();
+        queue(Some(canonical(&base)), canonical(&theirs(&a)), Box::new(move |r| *to.borrow_mut() = Some(r)));
+        frame(&mut b);
+        assert!(done.borrow().is_none(), "a gesture holds others' changes back");
+        b.commit_interaction().unwrap();
+        frame(&mut b);
+        assert_eq!(*done.borrow(), Some(Ok(None)));
+        assert_eq!((name(&b, r1), name(&b, r2)), ("A".into(), "B".into()));
+        // Both sides writing one property conflict, even with the same value.
+        let renamed = theirs(&a);
+        assert!(Session::live_merge(&base, &renamed, &renamed).unwrap_err().contains("Conflict"));
+        assert!(b.undo().unwrap());
+        assert_eq!(name(&b, r2), "B", "Undo is the session's");
+        assert_eq!(activity().1, [false]);
+        disconnect();
+        b.live_disconnected();
+        assert!(!b.undo().unwrap(), "native Undo starts again from the session's document");
+    }
+
+    #[test]
+    fn only_documents_every_peer_can_install_merge() {
+        let mut a = Session::new();
+        rect(&mut a, 0.0);
+        let base = theirs(&a);
+        for garbage in [Value::Null, json!([]), json!({"pages": []}), json!([{"create": {"id": 1}}])] {
+            assert!(Session::live_check(&garbage).is_err(), "{garbage}");
+        }
+        assert_eq!(Session::live_check(&base), Ok(()));
+        // The coordinator's shortcut (nobody else changed it) is checked too.
+        let mut b = Session::new();
+        b.live_adopt(base.clone()).unwrap();
+        connect();
+        let done = Rc::new(RefCell::new(None));
+        let to = done.clone();
+        queue(Some(canonical(&base)), b"null".to_vec(), Box::new(move |r| *to.borrow_mut() = Some(r)));
+        frame(&mut b);
+        assert!(done.borrow().as_ref().is_some_and(Result::is_err));
+        assert_eq!(canonical(&b.live_document()), canonical(&base));
+        disconnect();
+    }
+
+    #[test]
+    fn presence_is_the_page_pointer_and_selection_and_shows_only_what_resolves_here() {
+        let mut a = Session::new();
+        let r = rect(&mut a, 0.0);
+        a.ds_mut().unwrap().selection = vec![r];
+        point(Some((12.5, -3.0)));
+        super::frame(&mut a, false);
+        let mine = Live::live_presence(&a);
+        assert_eq!(mine["selection"], json!([r.0.to_string()]));
+        let mut b = Session::new();
+        b.live_adopt(theirs(&a)).unwrap();
+        let ann = |state: Value| Presence::list(&json!([{"id": "a", "name": "Ann", "color": "#e6194b", "state": state}]));
+        b.live_show_presence(ann(mine.clone()));
+        let shown = others(&b);
+        assert_eq!((shown[0].name.as_str(), shown[0].pointer, shown[0].selection.clone()), ("Ann", Some((12.5, -3.0)), vec![r]));
+        b.live_show_presence(ann(json!({"page": mine["page"], "pointer": [1e300, 1], "selection": ["999", 7, "x", null]})));
+        let shown = others(&b);
+        assert_eq!((shown[0].pointer, shown[0].selection.len()), (None, 0));
+        b.live_show_presence(ann(json!({"page": "424242", "pointer": [1, 2]})));
+        assert!(others(&b).is_empty(), "another page");
+        b.live_show_presence(Vec::new());
+        assert!(others(&b).is_empty());
+    }
+
+    #[test]
+    fn a_closed_tab_keeps_its_document_and_the_others_next_change_reopens_it() {
+        let mut a = Session::new();
+        let r = rect(&mut a, 0.0);
+        let base = theirs(&a);
+        let mut b = Session::new();
+        b.live_adopt(base.clone()).unwrap();
+        connect();
+        let shared = canonical(&b.live_document());
+        let uid = b.ds().unwrap().uid;
+        let branch = b.execute("branch.create", &json!({})).unwrap_err().to_string();
+        assert!(branch.contains("live session"), "branch id spaces would be the same on every peer: {branch}");
+        b.docs.clear();
+        assert_eq!(canonical(&b.live_document()), shared, "the last document, not none");
+        assert!(b.live_quiet());
+        rename(&mut a, r, "A");
+        let done = Rc::new(RefCell::new(None));
+        let to = done.clone();
+        queue(Some(shared), canonical(&theirs(&a)), Box::new(move |r| *to.borrow_mut() = Some(r)));
+        super::frame(&mut b, true);
+        assert!(done.borrow().is_none(), "a held pointer holds others' changes back");
+        super::frame(&mut b, false);
+        assert_eq!(*done.borrow(), Some(Ok(None)));
+        assert_eq!((b.docs.len(), name(&b, r), b.ds().unwrap().doc.name.as_str()), (1, "A".into(), "Untitled"));
+        assert_ne!(b.ds().unwrap().uid, uid);
+        disconnect();
+    }
+}
