+//! Live editing in a Playground session (`figcraft_engine::live_playground`): this person's pointer over the canvas
+//! for the others, and the others' pointers, names and selections on the page in front, drawn like a live session's.
+
+use super::{MAX_OUTLINES, name_tag, pointer};
+use crate::FigApp;
+use egui::{Align2, Color32, Shape, Stroke, vec2};
+use figcraft_engine::live_playground as live;
+
+/// On the canvas, over the document: the others' selection outlines, then their pointers with their names.
+pub(super) fn draw(app: &FigApp, painter: &egui::Painter) {
+    let at = painter.ctx().input(|i| i.pointer.hover_pos()).filter(|p| app.canvas.rect.contains(*p)).map(|p| app.to_page(p));
+    live::point(at.map(|p| (p.x, p.y)));
+    let Ok(ds) = app.session.ds() else { return };
+    for other in live::others(&app.session) {
+        let [r, g, b] = other.color;
+        let fill = Color32::from_rgb(r, g, b);
+        for id in other.selection.iter().take(MAX_OUTLINES) {
+            if let Some(q) = crate::canvas::node_quad(app, &ds.doc, *id) {
+                painter.add(Shape::closed_line(q.to_vec(), Stroke::new(1.5, fill)));
+            }
+        }
+        if let Some((x, y)) = other.pointer {
+            let tip = app.to_screen(x, y);
+            pointer(painter, tip, fill);
+            if !other.name.is_empty() {
+                name_tag(painter, tip + vec2(12.0, 16.0), Align2::LEFT_TOP, &other.name, fill);
+            }
+        }
+    }
+}
