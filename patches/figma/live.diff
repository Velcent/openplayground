+
+    /// `f` as the other person.
+    fn as_them<T>(f: impl FnOnce() -> T) -> T {
+        let swap = || THEIRS.with_borrow_mut(|t| (t.0, t.1, t.2) = (DOCS.replace(t.0.take()), OPENED.replace(t.1), JOINED.replace(t.2)));
+        swap();
+        let out = f();
+        swap();
+        out
+    }
