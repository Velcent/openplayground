+        b.live_show_presence(ann(json!({"doc": mine["doc"], "page": "424242", "pointer": [1, 2]})));
+        assert!(others(&b).is_empty(), "another page");
+        b.live_show_presence(ann(json!({"doc": 7, "page": mine["page"], "pointer": [1, 2]})));
+        assert!(others(&b).is_empty(), "another file");
+        b.live_show_presence(Vec::new());
+        assert!(others(&b).is_empty());
+    }
+
+    #[test]
+    fn files_opened_join_the_session_as_tabs_behind_and_closing_one_is_personal() {
+        let mut a = Session::new();
+        rect(&mut a, 0.0);
+        let mut b = Session::new();
+        b.live_adopt(theirs(&a)).unwrap();
+        connect();
+        // A file opened while connected joins the session.
+        b.execute("file.new", &json!({})).unwrap();
+        let mut set = b.live_document();
+        assert_eq!(set["documents"].as_array().unwrap().len(), 2);
+        // Someone else's opens here behind the one in front.
+        let mut new = set["documents"][0].clone();
+        (new["id"], new["name"]) = (json!(77), json!("Theirs"));
+        set["documents"].as_array_mut().unwrap().push(new);
+        let front = b.ds().unwrap().uid;
+        b.live_adopt(set.clone()).unwrap();
+        assert_eq!((b.docs.len(), b.ds().unwrap().uid), (3, front), "no switch to it");
+        assert_eq!(canonical(&b.live_document()), canonical(&set));
+        // Closing it hides it here only: a change to it is kept, and does not open it again.
+        b.docs.remove(2);
+        assert_eq!(canonical(&b.live_document()), canonical(&set));
+        set["documents"][2]["name"] = json!("Renamed");
+        b.live_adopt(set.clone()).unwrap();
+        assert_eq!(b.docs.len(), 2);
+        assert_eq!(canonical(&b.live_document()), canonical(&set));
+        assert_eq!(closed(), [(77, "Renamed".to_string())]);
+        let branch = b.execute("branch.create", &json!({})).unwrap_err().to_string();
+        assert!(branch.contains("live session"), "branch id spaces would be the same on every peer: {branch}");
+        reopen(&mut b, 77);
+        assert_eq!((b.docs.len(), b.ds().unwrap().doc.name.as_str()), (3, "Renamed"));
+        disconnect();
+    }
+}
diff --git a/crates/ui-egui/src/live/playground.rs b/crates/ui-egui/src/live/playground.rs
new file mode 100644
index 0000000..a3a8bcc
--- /dev/null
+++ b/crates/ui-egui/src/live/playground.rs
@@ -0,0 +1,303 @@
+//! Live editing in a Playground session (`figcraft_engine::live_playground`): this person's pointer over the canvas
+//! for the others, and the others on the page in front, in their colors: the layers they move, resize or turn (ghosts
+//! in the layers' own shape), the shapes and selection boxes they drag out (dashed), what they draw with the Pencil or
+//! the Pen, then their selections, then their pointers with their names, under this person's own selection and tool
+//! overlays; each easing toward its latest state. The tabs show dots for the others on each file, and Home lists the
+//! session's files closed here.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+use egui::{Color32, CornerRadius, Mesh, Painter, Pos2, Rect, Sense, Shape, Stroke, Ui, Vec2, pos2, vec2};
+use figcraft_doc::{Document, NodeKind};
+use figcraft_engine::live_playground::{self as live, Ghost, rings};
+use figcraft_geom::{Affine, BezPath, Point};
+
+use crate::FigApp;
+use crate::theme::{ACCENT, Tokens, semibold};
+
+/// How long the others' marks take to go most (1 - 1/e) of the way to their latest state, in seconds.
+const EASE: f64 = 0.08;
+
+thread_local! {
+    /// The others' marks as last drawn, by person: they ease on from there.
+    static SHOWN: RefCell<HashMap<String, Shown>> = RefCell::new(HashMap::new());
+}
+
+/// A person's moving marks as last drawn, in page coordinates.
+#[derive(Default)]
+struct Shown {
+    pointer: Option<[f64; 2]>,
+    /// The layers moved: their page transform and size, by key.
+    ghosts: Vec<(String, [f64; 8])>,
+    /// The box the bands are drawn into (their own box, as last received).
+    frame: Option<[f64; 4]>,
+    /// The newest point of the strokes.
+    head: Option<[f64; 2]>,
+}
+
+/// `s` `k` of the way on toward `t`, all of it after a jump of more than `far` pixels or once under half a pixel
+/// remains (`px`: pixels a unit of each part). Whether it is still on its way.
+fn ease<const N: usize>(s: &mut [f64; N], t: [f64; N], k: f64, px: [f64; N], far: f64) -> bool {
+    let off = |s: &[f64; N]| s.iter().zip(t).zip(px).map(|((s, t), px)| ((t - s) * px).abs()).fold(0.0, f64::max);
+    if off(s) > far {
+        *s = t;
+    }
+    s.iter_mut().zip(t).for_each(|(s, t)| *s += (t - *s) * k);
+    let moving = off(s) >= 0.5;
+    if !moving {
+        *s = t;
+    }
+    moving
+}
+
+/// [`ease`] for a mark that may come and go: it shows at once where it first does.
+fn step<const N: usize>(s: &mut Option<[f64; N]>, t: Option<[f64; N]>, k: f64, px: [f64; N], far: f64) -> bool {
+    match (s.as_mut(), t) {
+        (Some(s), Some(t)) => ease(s, t, k, px, far),
+        _ => {
+            *s = t;
+            false
+        }
+    }
+}
+
+/// The box around `lines`, as `[x0, y0, x1, y1]`.
+fn bounds(lines: &[Vec<Point>]) -> Option<[f64; 4]> {
+    let mut points = lines.iter().flatten();
+    let first = points.next()?;
+    Some(points.fold([first.x, first.y, first.x, first.y], |b, p| [b[0].min(p.x), b[1].min(p.y), b[2].max(p.x), b[3].max(p.y)]))
+}
+
+/// The affine taking box `from` onto box `to`; a side with no extent keeps its size.
+fn fit(from: [f64; 4], to: [f64; 4]) -> Affine {
+    let scale = |a: f64, b: f64| if a > 1e-9 { b / a } else { 1.0 };
+    let (sx, sy) = (scale(from[2] - from[0], to[2] - to[0]), scale(from[3] - from[1], to[3] - to[1]));
+    Affine::translate((to[0], to[1])) * Affine::scale_non_uniform(sx, sy) * Affine::translate((-from[0], -from[1]))
+}
+
+fn rgb([r, g, b]: [u8; 3]) -> Color32 {
+    Color32::from_rgb(r, g, b)
+}
+
+/// `color` at `alpha` (0–1).
+fn alpha(color: Color32, alpha: f32) -> Color32 {
+    Color32::from_rgba_unmultiplied(color.r(), color.g(), color.b(), (alpha * 255.0).round() as u8)
+}
+
+/// A layer being moved (`v`: its page transform and size so far) in its own shape when it is one here, else its box.
+fn outline(doc: &Document, g: &Ghost, v: [f64; 8]) -> BezPath {
+    let (w, h) = (v[6], v[7]);
+    let own = g.id.and_then(|id| doc.node(id)).and_then(|n| match &n.kind {
+        NodeKind::Vector { .. } => {
+            let scale = |to: f64, from: f64| if from > 1e-9 { to / from } else { 1.0 };
+            let mut path = figcraft_doc::geometry::shape_path(n)?;
+            path.apply_affine(Affine::scale_non_uniform(scale(w, n.width), scale(h, n.height)));
+            Some(path)
+        }
+        _ => {
+            let mut n = n.clone();
+            (n.width, n.height) = (w, h);
+            figcraft_doc::geometry::shape_path(&n)
+        }
+    });
+    let mut path = own.unwrap_or_else(|| figcraft_geom::rounded_rect(w, h, [0.0; 4], 0.0));
+    path.apply_affine(Affine::new([v[0], v[1], v[2], v[3], v[4], v[5]]));
+    path
+}
+
+/// On the canvas, after the document and before this person's own selection and tool overlays: the others' gestures in
+/// progress, their selections, their pointers with their names. Hands this person's pointer to the session first.
+pub(crate) fn draw(app: &FigApp, painter: &Painter) {
+    let ctx = painter.ctx();
+    let at = ctx.input(|i| i.pointer.hover_pos()).filter(|p| app.canvas.rect.contains(*p)).map(|p| app.to_page(p));
+    live::point(at.map(|p| (p.x, p.y)));
+    let others = live::others(&app.session);
+    let Ok(ds) = app.session.ds() else { return };
+    SHOWN.with_borrow_mut(|shown| {
+        // Someone back on this page shows at once where they are.
+        shown.retain(|id, _| others.iter().any(|o| o.id == *id));
+        if others.is_empty() {
+            return;
+        }
+        let dt = f64::from(ctx.input(|i| i.stable_dt).clamp(0.0, 0.1));
+        let k = if app.reduce_motion() { 1.0 } else { 1.0 - (-dt / EASE).exp() };
+        let far = f64::from(app.canvas.rect.width().min(app.canvas.rect.height())) / 4.0;
+        let px = ds.view.zoom.max(1e-9);
+        let screen = |p: &Point| app.to_screen(p.x, p.y);
+        let mut moving = false;
+        for o in &others {
+            let (s, color) = (shown.entry(o.id.clone()).or_default(), rgb(o.color));
+            // Layers moved, resized or turned: in their own shape where they are so far.
+            let mut ghosts = Vec::new();
+            for g in &o.ghosts {
+                let t = [g.m[0], g.m[1], g.m[2], g.m[3], g.m[4], g.m[5], g.w, g.h];
+                let mut v = s.ghosts.iter().find(|(key, _)| *key == g.key).map_or(t, |(_, v)| *v);
+                let size = g.w.max(g.h).max(1.0) * px;
+                moving |= ease(&mut v, t, k, [size, size, size, size, px, px, px, px], far);
+                ghost(painter, rings(&outline(&ds.doc, g, v), px).iter().map(|r| r.iter().map(screen).collect()).collect(), color);
+                ghosts.push((g.key.clone(), v));
+            }
+            s.ghosts = ghosts;
+            // Shapes being drawn and selection boxes: dashed, drawn into their box as it eases.
+            let target = bounds(&o.bands);
+            moving |= step(&mut s.frame, target, k, [px; 4], far);
+            if let Some((from, to)) = target.zip(s.frame) {
+                let at = fit(from, to);
+                for band in &o.bands {
+                    let band: Vec<Pos2> = band.iter().map(|p| screen(&(at * *p))).collect();
+                    painter.extend(Shape::dashed_line(&band, Stroke::new(1.5, color), 4.0, 3.0));
+                }
+            }
+            // Strokes: their newest point eases.
+            let mut strokes = o.strokes.clone();
+            let head = strokes.last().and_then(|l| l.last()).map(|p| [p.x, p.y]);
+            moving |= step(&mut s.head, head, k, [px; 2], far);
+            if let (Some(last), Some([x, y])) = (strokes.last_mut().and_then(|l| l.last_mut()), s.head) {
+                *last = Point::new(x, y);
+            }
+            for l in &strokes {
+                stroke(painter, l.iter().map(screen).collect(), (o.width * px).clamp(2.0, 400.0) as f32, color);
+            }
+            // Where a layer dragged in auto layout would go.
+            if let Some([a, b]) = o.line {
+                painter.line_segment([screen(&a), screen(&b)], Stroke::new(2.0, color));
+            }
+        }
+        // Selected layers, outlined as the canvas outlines this person's own.
+        for o in &others {
+            for q in o.selection.iter().filter_map(|id| crate::canvas::node_quad(app, &ds.doc, *id)) {
+                painter.add(Shape::closed_line(q.to_vec(), Stroke::new(2.0, rgb(o.color))));
+            }
+        }
+        // Pointers, with their names.
+        for o in &others {
+            let s = shown.entry(o.id.clone()).or_default();
+            moving |= step(&mut s.pointer, o.pointer.map(|(x, y)| [x, y]), k, [px; 2], far);
+            if let Some([x, y]) = s.pointer {
+                pointer(painter, app.to_screen(x, y), rgb(o.color), &o.name);
+            }
+        }
+        if moving {
+            ctx.request_repaint();
+        }
+    });
+}
+
+/// Outlines being moved or changed (screen points): the closed ones filled with `color` at 28%, all edged at 85%.
+fn ghost(painter: &Painter, rings: Vec<Vec<Pos2>>, color: Color32) {
+    let closed = |r: &&Vec<Pos2>| r.len() > 3 && r.first() == r.last();
+    fill(painter, rings.iter().filter(closed), alpha(color, 0.28));
+    let edge = Stroke::new(1.5, alpha(color, 0.85));
+    for r in rings.into_iter().filter(|r| r.len() >= 2) {
+        match closed(&&r) {
+            true => painter.add(Shape::closed_line(r[..r.len() - 1].to_vec(), edge)),
+            false => painter.add(Shape::line(r, edge)),
+        };
+    }
+}
+
+/// The inside of closed polylines (screen points, even-odd), in rows a point high across what the painter shows.
+fn fill<'a>(painter: &Painter, rings: impl Iterator<Item = &'a Vec<Pos2>>, color: Color32) {
+    let edges: Vec<(Pos2, Pos2)> = rings.flat_map(|r| r.windows(2).map(|w| (w[0], w[1]))).collect();
+    // ponytail: every edge per row; an active-edge table if ghosts of many complex layers get slow.
+    if edges.is_empty() || edges.len() > 4_000 {
+        return;
+    }
+    let clip = painter.clip_rect();
+    let (top, bottom) = edges.iter().fold((f32::MAX, f32::MIN), |(t, b), (p, q)| (t.min(p.y).min(q.y), b.max(p.y).max(q.y)));
+    let (mut y, bottom) = (top.max(clip.top()).floor() + 0.5, bottom.min(clip.bottom()));
+    let (mut mesh, mut xs) = (Mesh::default(), Vec::new());
+    while y < bottom {
+        xs.clear();
+        xs.extend(edges.iter().filter(|(p, q)| (p.y <= y) != (q.y <= y)).map(|(p, q)| p.x + (y - p.y) / (q.y - p.y) * (q.x - p.x)));
+        xs.sort_by(f32::total_cmp);
+        for span in xs.chunks_exact(2) {
+            let (x0, x1) = (span[0].max(clip.left()), span[1].min(clip.right()));
+            if x1 > x0 {
+                mesh.add_colored_rect(Rect::from_min_max(pos2(x0, y - 0.5), pos2(x1, y + 0.5)), color);
+            }
+        }
+        y += 1.0;
+    }
+    painter.add(mesh);
+}
+
+/// A stroke being drawn (screen points): `color` at 70%, `width` wide, with round ends.
+fn stroke(painter: &Painter, line: Vec<Pos2>, width: f32, color: Color32) {
+    let color = alpha(color, 0.7);
+    let ends = [(line[0], line[1]), (line[line.len() - 1], line[line.len() - 2])];
+    painter.add(Shape::line(line, Stroke::new(width, color)));
+    for (end, next) in ends {
+        let d = (end - next).normalized();
+        if d.is_finite() && width > 3.0 {
+            let half = (0..=12).map(|i| std::f32::consts::PI * i as f32 / 12.0);
+            painter.add(Shape::convex_polygon(half.map(|a| end + (d.rot90() * a.cos() + d * a.sin()) * width / 2.0).collect(), color, Stroke::NONE));
+        }
+    }
+}
+
+/// The pointer arrow, tip at (0, 0), in points; and the triangles that fill it.
+const ARROW: [[f32; 2]; 7] = [[0.0, 0.0], [0.0, 16.0], [4.5, 12.2], [7.6, 18.6], [10.4, 17.3], [7.3, 11.0], [12.5, 11.0]];
+const ARROW_FILL: [[u32; 3]; 5] = [[0, 1, 2], [0, 2, 5], [0, 5, 6], [2, 3, 4], [2, 4, 5]];
+/// The most characters of a name tag, its ellipsis included.
+const MAX_NAME: usize = 24;
+
+/// Another person's pointer at `tip`: an arrow in their color with a white edge and a soft shadow, and a tag with
+/// their name.
+fn pointer(painter: &Painter, tip: Pos2, color: Color32, name: &str) {
+    let at = |offset: Vec2| ARROW.map(|[x, y]| tip + offset + vec2(x, y)).to_vec();
+    let filled = |points: Vec<Pos2>, color: Color32| {
+        let mut mesh = Mesh::default();
+        points.into_iter().for_each(|p| mesh.colored_vertex(p, color));
+        ARROW_FILL.into_iter().for_each(|[a, b, c]| mesh.add_triangle(a, b, c));
+        mesh
+    };
+    painter.add(filled(at(vec2(0.0, 1.0)), Color32::from_black_alpha(64)));
+    painter.add(filled(at(Vec2::ZERO), color));
+    painter.add(Shape::closed_line(at(Vec2::ZERO), Stroke::new(1.5, Color32::WHITE)));
+    let name: String = match name.chars().nth(MAX_NAME) {
+        Some(_) => name.chars().take(MAX_NAME - 1).chain(['…']).collect(),
+        None => name.into(),
+    };
+    if name.is_empty() {
+        return;
+    }
+    // Relative luminance: dark ink on light colors.
+    let c = egui::Rgba::from(color);
+    let ink = if 0.2126 * c.r() + 0.7152 * c.g() + 0.0722 * c.b() > 0.55 { Color32::from_gray(0x11) } else { Color32::WHITE };
+    let text = painter.layout_no_wrap(name, semibold(12.0), ink);
+    let tag = Rect::from_min_size(tip + vec2(12.0, 15.0), text.size() + vec2(14.0, 6.0));
+    painter.rect_filled(tag, CornerRadius::same(6), color);
+    painter.galley(tag.min + vec2(7.0, 3.0), text, ink);
+}
+
+/// Dots at the bottom of a tab (`r`, of open file `uid`) in the colors of the others on its file.
+pub(crate) fn tab(ui: &Ui, uid: u64, r: Rect) {
+    let here = live::here(uid);
+    let left = r.center().x - 4.0 * (here.len().max(1) - 1) as f32;
+    for (k, color) in here.into_iter().enumerate() {
+        ui.painter().circle(pos2(left + 8.0 * k as f32, r.bottom() - 6.0), 3.0, rgb(color), Stroke::new(1.0, Color32::WHITE));
+    }
+}
+
+/// Home's "In this session": the session's files closed here, a row each that opens it again.
+pub(crate) fn home(app: &mut FigApp, ui: &mut Ui, t: &Tokens) {
+    let closed = live::closed();
+    if closed.is_empty() {
+        return;
+    }
+    ui.add_space(28.0);
+    ui.label(egui::RichText::new("In this session").font(semibold(12.0)).color(t.text_secondary));
+    ui.add_space(12.0);
+    for (id, name) in closed {
+        let (r, _) = ui.allocate_exact_size(vec2(ui.available_width().min(640.0), 36.0), Sense::hover());
+        let resp = ui.interact(r, ui.id().with(("in this session", id)), Sense::click());
+        let row = crate::home::FileRow { mark: Some((crate::icons::Icon::Logo, ACCENT)), name: &name, ink: t.text, detail: "", detail_size: 11.0, detail_ink: t.text_secondary };
+        crate::home::file_row(ui, t, r, &resp, &row);
+        if resp.clicked() {
+            live::reopen(&mut app.session, id);
+            app.ui.home = false;
+        }
+    }
+}
