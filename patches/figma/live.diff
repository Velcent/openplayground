+/// Offers Playground live editing of the document in front to the page (`figcraft_engine::playground_live`).
+fn attach_live(runner: eframe::WebRunner, ctx: std::rc::Rc<std::cell::OnceCell<egui::Context>>) {
+    let attached = figcraft_engine::playground_live::web::attach::<Session>(
+        concat!("figma:1:", env!("CARGO_PKG_VERSION")),
+        move |f| runner.app_mut::<WebShell>().map(|mut shell| f(&mut shell.fig.session)).is_some(),
+        move || {
+            if let Some(ctx) = ctx.get() {
+                ctx.request_repaint();
+            }
+        },
+    );
+    if let Err(e) = attached {
+        log::error!("figcraft-web: no live editing: {e:?}");
+    }
+}
