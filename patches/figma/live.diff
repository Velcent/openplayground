+//! Live editing in a Playground session (`figcraft_engine::live_playground`): the page's runner, kept for the session
+//! to reach the app, and the app eframe runs: [`WebShell`], then the session's end-of-frame hook.
+
+use super::WebShell;
+use figcraft_engine::Session;
+use figcraft_engine::live_playground::{self as live, playground_live};
+use std::cell::OnceCell;
+
+thread_local! {
+    static RUNNER: OnceCell<eframe::WebRunner> = const { OnceCell::new() };
+    static CONTEXT: OnceCell<egui::Context> = const { OnceCell::new() };
+}
+
+/// A new web runner, kept for [`wrap`].
+pub(super) fn runner() -> eframe::WebRunner {
+    let runner = eframe::WebRunner::new();
+    RUNNER.with(|kept| kept.get_or_init(|| runner.clone()).clone())
+}
+
+/// The app eframe runs: `shell`, offered to the page for live editing of the document in front.
+pub(super) fn wrap(shell: WebShell) -> Box<dyn eframe::App> {
+    let attached = playground_live::web::attach::<Session>(
+        concat!("figma:1:", env!("CARGO_PKG_VERSION")),
+        |with| RUNNER.with(|runner| runner.get().and_then(|r| r.app_mut::<WebShell>()).map(|mut shell| with(&mut shell.fig.session)).is_some()),
+        || {
+            CONTEXT.with(|ctx| {
+                if let Some(ctx) = ctx.get() {
+                    ctx.request_repaint();
+                }
+            });
+        },
+    );
+    if let Err(e) = attached {
+        log::error!("figcraft-web: no live editing: {e:?}");
+    }
+    Box::new(Live(shell))
+}
+
+struct Live(WebShell);
+
+impl eframe::App for Live {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.0.logic(ctx, frame);
+    }
+
+    /// The shell's frame, then this frame's edits go out and others' come in (they show next frame).
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.0.ui(ui, frame);
+        let ctx = ui.ctx();
+        CONTEXT.with(|kept| {
+            kept.get_or_init(|| ctx.clone());
+        });
+        let session = &mut self.0.fig.session;
+        let revision = session.ds().map(|d| d.revision).ok();
+        let typing = ctx.memory(|m| m.focused()).is_some_and(|id| egui::TextEdit::load_state(ctx, id).is_some());
+        live::frame(session, typing || ctx.input(|i| i.pointer.any_down()));
+        if session.ds().map(|d| d.revision).ok() != revision {
+            ctx.request_repaint();
+        }
+    }
+
+    /// The shell itself, which the session reaches through the runner.
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(&mut self.0)
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.0.save(storage);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.0.auto_save_interval()
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.0.clear_color(visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        self.0.persist_egui_memory()
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.0.raw_input_hook(ctx, raw_input);
+    }
+}
