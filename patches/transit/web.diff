@@ -0,0 +1,12 @@
+# Playground's browser build of transit (patches/transit.yaml in github.com/daijro/openplayground): std's clock as
+# wasm32-unknown-unknown can have it. Native builds compile it empty.
+[package]
+name = "transit-playground"
+version = "0.1.0"
+edition = "2024"
+description = "transit in the browser: the clock std lacks on wasm32-unknown-unknown"
+license = "MIT OR Apache-2.0"
+publish = false
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+web-time = "1"
