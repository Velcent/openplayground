+++ b/crates/transit-playground/src/lib.rs
@@ -0,0 +1,16 @@
+//! transit in the browser, for Playground (patches/transit.yaml in github.com/daijro/openplayground).
+//!
+//! wasm32-unknown-unknown has no clock: std's `Instant::now` and `SystemTime::now` panic there ("time not implemented
+//! on this platform"). The modules that read the clock take `std` from here instead, through one
+//! `#[cfg(target_arch = "wasm32")] use transit_playground::std;` line at each one's end (a local `std` shadows the
+//! standard library's name in that module; everything else in it still comes from the real std): `time` is web-time's,
+//! the browser's clock.
+#![cfg(target_arch = "wasm32")]
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod time {
+        pub use web_time::*;
+    }
+}
