+//! transit in the browser, for Playground (patches/transit.yaml in github.com/daijro/openplayground): a page has no MIDI
+//! ports, so the Player's MIDI read-backs that the studio UI asks for each frame answer "nothing here" (the native
+//! `midi_out` and `native` modules need the MIDI device layer).
+
+use super::{MapHeard, MapMsg, MapSpec, Player, PlayerError, monitor};
+
+/// The external MIDI destinations as the UI reads them: none on the web.
+pub mod midi_out {
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub enum DestinationState {
+        Pending,
+        Connected,
+        Missing,
+        Failed(String),
+    }
+
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub struct TrackOutput {
+        pub track: transit_model::TrackId,
+        pub port: String,
+        pub state: DestinationState,
+    }
+
+    #[derive(Clone, Debug, Default, PartialEq, Eq)]
+    pub struct OutputStatus {
+        pub tracks: Vec<TrackOutput>,
+    }
+}
+
+/// [`Player::midi_status`]'s answer, the fields the UI reads.
+#[derive(Clone, Debug, Default)]
+pub struct Status {
+    pub timing_quality: Option<crate::device_clock::Quality>,
+    pub output: midi_out::OutputStatus,
+}
+
+impl Player {
+    pub fn set_midi_monitor(&self, _enabled: bool, _show_clock: bool) {}
+    pub fn midi_activity(&self) -> (monitor::Activity, String) {
+        Default::default()
+    }
+    pub fn take_midi_monitor(&self, _events: &mut Vec<monitor::MonitorEvent>, _max: usize) -> monitor::Report {
+        monitor::Report::default()
+    }
+    pub fn midi_status(&self) -> Result<Status, PlayerError> {
+        Err(PlayerError::Busy)
+    }
+
+    // MIDI Learn (the mappings are plain data, `midi_map`; no port ever feeds them here).
+    pub fn set_midi_mappings(&self, _specs: Vec<MapSpec>) {}
+    pub fn midi_map_epoch(&self) -> u32 {
+        0
+    }
+    pub fn midi_map_heard(&self) -> Vec<MapHeard> {
+        Vec::new()
+    }
+    pub fn midi_map_ports_open(&self) -> Option<Vec<bool>> {
+        None
+    }
+    pub fn set_midi_learn(&self, _armed: bool) {}
+    pub fn sync_midi_map(&self, _values: &[(f32, u32)]) {}
+    pub fn take_midi_map_events(&self) -> Vec<MapMsg> {
+        Vec::new()
+    }
+    pub fn midi_map_generation(&self) -> u32 {
+        0
+    }
+    pub fn midi_map_activity(&self) -> u64 {
+        0
+    }
+    pub fn midi_learn_armed(&self) -> bool {
+        false
+    }
+    pub fn midi_map_dropped(&self) -> u64 {
+        0
+    }
+}
