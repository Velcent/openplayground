+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Services;
+    use serde_json::json;
+    use transit_engine::Engine;
+    use playground_live::{self as live, canonical};
+    use transit_model::{ChannelFormat, Clip, ClipId, TrackHeight, TrackKind};
+
+    fn two_tracks() -> StudioApp {
+        let mut engine = Engine::default();
+        let s = engine.session_mut();
+        s.add_track(TrackKind::Audio, ChannelFormat::Mono, Some("Kick"));
+        s.add_track(TrackKind::Audio, ChannelFormat::Mono, Some("Snare"));
+        engine.mark_clean();
+        StudioApp::new(engine, None, Services::default())
+    }
+
+    fn mute(app: &mut StudioApp, track: usize) {
+        let id = app.engine.session().tracks[track].id;
+        app.run("mix.mute", json!({"tracks": [id]})).unwrap();
+    }
+
+    #[test]
+    fn the_shared_document_leaves_out_views() {
+        let mut app = two_tracks();
+        let before = canonical(&app.live_document());
+        let s = app.engine.session_mut();
+        s.edit.zoom.samples_per_px = 7.0;
+        s.edit.selection.start = 480;
+        let t = &mut s.tracks[0];
+        (t.height, t.view, t.pinned, t.mixer.record_arm) = (TrackHeight::Large, "volume".into(), true, true);
+        app.ui.track_height = 120.0;
+        assert_eq!(canonical(&app.live_document()), before, "views are not shared");
+        mute(&mut app, 0);
+        let doc = app.live_document();
+        assert!(doc.get("edit").is_none());
+        assert_eq!(doc["tracks"][0]["mixer"]["mute"], true);
+        assert_eq!(doc["tracks"][0]["playlists"][0]["id"], "Kick");
+    }
+
+    #[test]
+    fn adopting_keeps_views_and_is_no_undo_step() {
+        let mut app = two_tracks();
+        let mut other = two_tracks();
+        mute(&mut other, 1);
+        other.engine.session_mut().add_track(TrackKind::Midi, ChannelFormat::Mono, Some("Keys"));
+        let s = app.engine.session_mut();
+        s.edit.selection.start = 480;
+        s.tracks[1].height = TrackHeight::Large;
+        app.live_adopt(other.live_document()).unwrap();
+        let s = app.engine.session();
+        assert!(s.tracks[1].mixer.mute && s.tracks[1].height == TrackHeight::Large && s.edit.selection.start == 480);
+        assert!(!app.engine.can_undo());
+        assert_eq!(canonical(&app.live_document()), canonical(&other.live_document()));
+    }
+
+    #[test]
+    fn a_remote_change_waits_for_the_gesture_and_undo_goes_to_the_session() {
+        let mut app = two_tracks();
+        let mut other = two_tracks();
+        live::connect();
+        let base = canonical(&app.live_document());
+        mute(&mut other, 0);
+        let done = std::rc::Rc::new(std::cell::Cell::new(false));
+        let to = done.clone();
+        live::queue(Some(base), canonical(&other.live_document()), Box::new(move |r| to.set(r.is_ok())));
+        app.dialog = Some(crate::Dialog::Bounce);
+        live::frame(&mut app);
+        assert!(!done.get() && !app.engine.session().tracks[0].mixer.mute, "an open dialog holds remote changes");
+        app.dialog = None;
+        live::frame(&mut app);
+        assert!(done.get() && app.engine.session().tracks[0].mixer.mute);
+        mute(&mut app, 1);
+        app.run("edit.undo", json!({})).unwrap();
+        assert!(app.engine.session().tracks[1].mixer.mute, "Undo is the session's while connected");
+        assert_eq!(live::activity().1, [false]);
+        assert!(app.run("session.new", json!({})).is_err(), "the shared session stays open");
+        live::disconnect();
+        app.live_disconnected();
+        assert!(!app.engine.can_undo());
+    }
+
+    #[test]
+    fn imported_audio_travels_by_source_id_and_installs_without_an_edit() {
+        let with_import = |level: f32, frames: usize| {
+            let mut app = StudioApp::new(transit_engine::demo::demo_engine(), None, Services::default());
+            let buf = transit_audio_io::AudioBuffer { sample_rate: 48_000, channels: vec![vec![level; frames]] };
+            let wav = EncodeOptions { format: FileFormat::Wav, bit_depth: BitDepth::Float32, dither: false, bwf: None };
+            let bytes = transit_audio_io::encode(&buf, &wav).unwrap();
+            transit_engine::io::import_audio_bytes(&mut app.engine, "a.wav", &bytes, None, None, 0).unwrap();
+            app
+        };
+        let (owner, mut peer) = (with_import(0.5, 480), with_import(-0.25, 960));
+        let id = owner.engine.session().sources.last().unwrap().id.to_string();
+        assert_eq!(owner.live_assets(), [(id.clone(), "a.wav".into(), true)], "the demo's audio is not shared");
+        assert!(StudioApp::live_assets_of(&owner.live_document()).contains(&id));
+        peer.live_adopt(owner.live_document()).unwrap();
+        assert_eq!(peer.live_assets(), [(id.clone(), "a.wav".into(), false)], "the peer's own audio under that id is not it");
+        let doc = canonical(&peer.live_document());
+        peer.live_write_asset(&id, "a.wav", owner.live_read_asset(&id).unwrap());
+        assert_eq!(peer.live_read_asset(&id), owner.live_read_asset(&id));
+        assert!(canonical(&peer.live_document()) == doc && !peer.engine.can_undo());
+    }
+
+    #[test]
+    fn a_pointer_travels_as_track_time_and_height_and_lands_through_the_viewers_own_zoom() {
+        let mut app = two_tracks();
+        let ids: Vec<u64> = app.engine.session().tracks.iter().map(|t| t.id.0).collect();
+        let row = |id: u64, y0: f32, y1: f32| crate::arrange::TrackRow { id, header: [0.0, y0, 100.0, y1], lane: [100.0, y0, 900.0, y1], ..Default::default() };
+        let l = &mut app.arrange.layout;
+        (l.timeline, l.samples_per_px, l.scroll) = ([100.0, 50.0, 900.0, 600.0], 100.0, 0);
+        l.tracks = vec![row(ids[0], 50.0, 150.0), row(ids[1], 150.0, 250.0)];
+        let p = pointer(&app, pos2(400.0, 200.0)).unwrap();
+        assert_eq!(p, json!({"track": ids[1], "at": 30_000, "y": 0.5}));
+        assert!(pointer(&app, pos2(50.0, 200.0)).is_none(), "over the track headers");
+        let mut other = two_tracks();
+        let l = &mut other.arrange.layout;
+        (l.timeline, l.samples_per_px, l.scroll) = ([100.0, 50.0, 900.0, 600.0], 200.0, 0);
+        l.tracks = vec![row(ids[1], 50.0, 250.0)];
+        let a = Arrangement::of(&other).unwrap();
+        let (row_i, at) = (a.row(&p["track"]).unwrap(), time(&p["at"]).unwrap());
+        assert_eq!((row_i, a.x(at)), (0, 250.0), "half as far at twice the samples per point");
+        other.ui.mixer_full = true;
+        assert!(Arrangement::of(&other).is_none(), "the full mixer hides the arrangement");
+    }
+
+    #[test]
+    fn clips_added_or_moved_at_once_merge_in_start_order() {
+        let mut app = two_tracks();
+        let s = app.engine.session_mut();
+        for (id, at) in [(10, 0), (11, 100), (12, 200), (13, 300)] {
+            s.tracks[0].playlists[0].clips.push(Clip::audio(ClipId(id), "c", SourceId(9), 0, at, 50));
+        }
+        let base = app.live_document();
+        let edited = |edit: &dyn Fn(&mut Session)| {
+            let mut app = two_tracks();
+            app.live_adopt(base.clone()).unwrap();
+            let s = app.engine.session_mut();
+            edit(s);
+            s.tracks[0].playlists[0].sort();
+            app.live_document()
+        };
+        let clip = |s: &mut Session, id: u64, at: i64| s.tracks[0].playlists[0].clips.push(Clip::audio(ClipId(id), "c", SourceId(9), 0, at, 50));
+        let moved = |s: &mut Session, id: u64, at: i64| s.find_clip_mut(ClipId(id)).unwrap().start = at;
+        let added = (edited(&|s| clip(s, 1000, 150)), edited(&|s| clip(s, 2000, 120)));
+        let reordered = (edited(&|s| moved(s, 10, 250)), edited(&|s| moved(s, 13, 50)));
+        for (c, e) in [added, reordered] {
+            let merged = StudioApp::live_merge(&base, &c, &e).unwrap();
+            let starts: Vec<_> = merged["tracks"][0]["playlists"][0]["clips"].as_array().unwrap().iter().map(|c| c["start"].as_i64()).collect();
+            assert!(starts.is_sorted(), "{starts:?}");
+            app.live_adopt(merged.clone()).unwrap();
+            assert_eq!(canonical(&app.live_document()), canonical(&merged), "the receiver does not sort it again");
+        }
+        assert!(StudioApp::live_merge(&base, &base, &json!(null)).is_err());
+    }
+}
