+//! Live editing in a Playground session (patches/transit.yaml in github.com/daijro/openplayground): the page's app
+//! offered to the session, each frame ending with the others drawn and the session's frame hook
+//! (`transit_ui_studio::live`, the model side).
+
+use super::{Shell, repaint, runner};
+use transit_ui_studio::StudioApp;
+
+/// The app the runner starts: `shell`, offered to the page for live editing.
+pub(super) fn wrap(shell: Shell) -> Box<dyn eframe::App> {
+    let attached = playground_live::web::attach::<StudioApp>(
+        concat!("transit:1:", env!("CARGO_PKG_VERSION")),
+        |with| runner().app_mut::<Live>().map(|mut live| with(&mut live.0.app)).is_some(),
+        repaint,
+    );
+    if let Err(e) = attached {
+        log::error!("live editing: {e:?}");
+    }
+    Box::new(Live(shell))
+}
+
+struct Live(Shell);
+
+impl eframe::App for Live {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.0.logic(ctx, frame);
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw: &mut egui::RawInput) {
+        self.0.raw_input_hook(ctx, raw);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.0.ui(ui, frame);
+        transit_ui_studio::live::frame(&mut self.0.app, ui.ctx());
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
