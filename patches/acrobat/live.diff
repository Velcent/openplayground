+//! Playground live editing of one PDF (web only; the template [`playground_live`], copied next to this file, drives
+//! it). The shared document is the PDF the session started from plus every object that differs from it, as JSON:
+//! `{"pdf": base64, "objects": {"<number>": base64("N G obj … endobj") or null when deleted}, "trailer"?: base64(the
+//! trailer's own entries), "rewrite"?: true}`; `{}` before anyone shares a PDF, and `{"refused": why}` for PDFs this
+//! version does not share (encrypted, signed, XFA forms, read-only). Objects are written by the PDF writer, so equal
+//! graphs give equal bytes and one edit changes only the objects it touched.
+//!
+//! The merge is per object, then per dictionary key: arrays of references (`/Annots`, `/Kids`, `/Fields`, …) merge as
+//! sets that keep their order, so two comments on one page both stay; a value both sides changed is a conflict.
+//! Objects both sides added under one number are told apart by giving the unsent side's (`current`'s) new objects
+//! fresh numbers. The coordinator checks every document it records the way receivers install it (written, then
+//! inspected); receivers check by installing.
+//!
+//! Presence: `{"page": <page object number>, "pointer"?: [x, y] in that page's user space, "selection": [object numbers
+//! of selected comments]}`, drawn on the pages shown ([`paint`]). The web entry runs the app wrapped ([`wrap`]), so each
+//! frame ends with the session's [`frame`]; the engine's `live_playground` installs graphs without undo steps.
+
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+#[allow(dead_code)] // fresh_id: PdfCraft numbers objects through the merge
+#[path = "playground_live.rs"]
+mod playground_live;
+
+use crate::PdfCraftApp;
+use playground_live::{Error, Live, Presence};
+use base64::Engine as _;
+use pdfcraft_cos::{Dict, Document, Lexer, Name, ObjRef, Object, SaveOptions, Stream, parse_indirect, serialize, write_incremental};
+use pdfcraft_engine::DocId;
+use serde_json::{Map, Value, json};
+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};
+use std::rc::Rc;
+use std::sync::Arc;
+
+const B64: base64::engine::GeneralPurpose = base64::engine::general_purpose::STANDARD;
+/// Trailer entries that describe the file's layout, not the document: each save writes its own.
+const LAYOUT: &[&[u8]] = &[b"Size", b"Prev", b"XRefStm", b"Type", b"W", b"Index", b"Filter", b"DecodeParms", b"Length"];
+
+/// The PDF a session started from, opened once.
+struct Base {
+    pdf: String,
+    doc: Document,
+    /// Above every object number the file uses.
+    next: u32,
+}
+
+#[derive(Default)]
+struct State {
+    /// The shared document's tab: the active one when the session first needs a document.
+    pin: Option<DocId>,
+    /// Its graph as last read, still reported once the tab is closed.
+    last: Option<Document>,
+    base: Option<Rc<Base>>,
+    /// The last base decoded for a merge of another file.
+    other: Option<Rc<Base>>,
+    generation: u64,
+    /// The shared tab became a PDF that is not shared (signed, encrypted): for the rest of the session it reports its
+    /// last shared state, and remote changes leave it alone.
+    paused: bool,
+    /// Inside [`frame`], where merged documents are this browser's to install: installing checks them.
+    in_frame: bool,
+    notice: Option<String>,
+    ctx: Option<egui::Context>,
+    /// The others in the session, as the shell last showed them.
+    others: Vec<Presence>,
+    ids: Option<Rc<Ids>>,
+}
+
+thread_local! {
+    static STATE: std::cell::RefCell<State> = std::cell::RefCell::default();
+}
+
+fn conflict(what: impl std::fmt::Display) -> Error {
+    format!("Conflict at {what}")
+}
+
+fn base_of(bytes: Arc<Vec<u8>>, pdf: Option<String>) -> Result<Rc<Base>, Error> {
+    let doc = Document::open(bytes.clone()).map_err(|e| format!("The shared PDF does not open: {e}"))?;
+    let size = u32::try_from(doc.trailer().int(b"Size").unwrap_or(0)).unwrap_or(u32::MAX);
+    let next = doc.object_numbers().last().map_or(1, |n| n.saturating_add(1)).max(size);
+    Ok(Rc::new(Base { pdf: pdf.unwrap_or_else(|| B64.encode(&*bytes)), doc, next }))
+}
+
+fn base_for(pdf: &str) -> Result<Rc<Base>, Error> {
+    let known = STATE.with_borrow(|s| [&s.base, &s.other].into_iter().flatten().find(|b| b.pdf == pdf).cloned());
+    if let Some(base) = known {
+        return Ok(base);
+    }
+    let bytes = B64.decode(pdf).map_err(|e| format!("Invalid shared document: {e}"))?;
+    let base = base_of(Arc::new(bytes), Some(pdf.to_owned()))?;
+    STATE.with_borrow_mut(|s| s.other = Some(base.clone()));
+    Ok(base)
+}
+
+/// An object as the shared document holds it: `N G obj … endobj`.
+fn text(r: ObjRef, o: &Object) -> Vec<u8> {
+    let mut out = format!("{} {} obj\n", r.num, r.generation).into_bytes();
+    serialize(o, &mut out);
+    out.extend_from_slice(b"\nendobj\n");
+    out
+}
+
+fn own_entries(trailer: &Dict) -> Dict {
+    trailer.iter().filter(|(k, _)| !LAYOUT.contains(&k.as_slice())).map(|(k, v)| (k.clone(), v.clone())).collect()
+}
+
+/// An object number's state: its generation and object, or `None` when deleted.
+type Entry = Option<(u16, Object)>;
+
+/// A shared document read back.
+struct Shared<'a> {
+    pdf: &'a str,
+    objects: BTreeMap<u32, Entry>,
+    /// The trailer's own entries, when they differ from the base's.
+    trailer: Option<Dict>,
+    rewrite: bool,
+}
+
+/// Reads a shared document, strictly: anything [`project`] would not write back byte for byte is refused, and so is
+/// no document (`{}`, nothing open yet).
+fn read(doc: &Value) -> Result<Shared<'_>, Error> {
+    let Some(map) = doc.as_object() else { return Err("Invalid shared document: not an object".into()) };
+    if let Some(why) = map.get("refused") {
+        return Err(why.as_str().unwrap_or("This PDF can't be edited live").to_owned());
+    }
+    if map.is_empty() {
+        return Err("Open a PDF to share it live.".into());
+    }
+    let invalid = |what: &str| format!("Invalid shared document: {what}");
+    if map.keys().any(|k| !["pdf", "objects", "trailer", "rewrite"].contains(&k.as_str())) {
+        return Err(invalid("unknown entry"));
+    }
+    let pdf = map.get("pdf").and_then(Value::as_str).ok_or_else(|| invalid("no PDF"))?;
+    let decode = |v: &str| B64.decode(v).map_err(|e| invalid(&e.to_string()));
+    let mut objects = BTreeMap::new();
+    for (key, value) in map.get("objects").and_then(Value::as_object).ok_or_else(|| invalid("no objects"))? {
+        let num: u32 = key.parse().ok().filter(|n: &u32| n.to_string() == *key).ok_or_else(|| invalid("object number"))?;
+        let entry = match value {
+            Value::Null => None,
+            Value::String(s) => {
+                let bytes = decode(s)?;
+                let (r, o) = parse_indirect(&bytes, 0, &|_| None).map_err(|e| invalid(&e.to_string()))?;
+                if r.num != num || text(r, &o) != bytes {
+                    return Err(invalid(&format!("object {num}")));
+                }
+                Some((r.generation, o))
+            }
+            _ => return Err(invalid(&format!("object {num}"))),
+        };
+        objects.insert(num, entry);
+    }
+    let trailer = match map.get("trailer") {
+        None => None,
+        Some(v) => {
+            let bytes = decode(v.as_str().ok_or_else(|| invalid("trailer"))?)?;
+            let Ok(Object::Dict(d)) = Lexer::new(&bytes, 0).object() else { return Err(invalid("trailer")) };
+            let mut again = Vec::new();
+            serialize(&Object::Dict(d.clone()), &mut again);
+            if again != bytes {
+                return Err(invalid("trailer"));
+            }
+            Some(d)
+        }
+    };
+    let rewrite = match map.get("rewrite") {
+        None => false,
+        Some(Value::Bool(true)) => true,
+        Some(_) => return Err(invalid("rewrite")),
+    };
+    Ok(Shared { pdf, objects, trailer, rewrite })
+}
+
+/// The shared document of `cos`, a state of `base`'s file (or of a later save of it).
+fn project(cos: &Document, base: &Base) -> Value {
+    let same = Arc::ptr_eq(cos.bytes(), base.doc.bytes()) || cos.bytes() == base.doc.bytes();
+    let numbers: BTreeSet<u32> =
+        if same { cos.modified_objects().into_iter().collect() } else { cos.object_numbers().into_iter().chain(base.doc.object_numbers()).collect() };
+    let mut objects = Map::new();
+    for num in numbers {
+        let now = cos.try_get(num).unwrap_or_else(|_| Arc::new(Object::Null));
+        let was = base.doc.try_get(num).unwrap_or_else(|_| Arc::new(Object::Null));
+        let written = |doc: &Document, o: &Object| text(ObjRef::new(num, doc.generation(num)), o);
+        let value = match (&*now, &*was) {
+            (Object::Null, Object::Null) => continue,
+            (Object::Null, _) => Value::Null,
+            (now, Object::Null) => Value::String(B64.encode(written(cos, now))),
+            (now, was) => {
+                let now = written(cos, now);
+                if now == written(&base.doc, was) {
+                    continue;
+                }
+                Value::String(B64.encode(now))
+            }
+        };
+        objects.insert(num.to_string(), value);
+    }
+    let mut out = json!({"pdf": base.pdf, "objects": objects});
+    let trailer = own_entries(cos.trailer());
+    if trailer != own_entries(base.doc.trailer()) {
+        let mut bytes = Vec::new();
+        serialize(&Object::Dict(trailer), &mut bytes);
+        out["trailer"] = B64.encode(bytes).into();
+    }
+    if cos.full_save_required() {
+        out["rewrite"] = true.into();
+    }
+    out
+}
+
+/// The graph a shared document describes.
+fn build(shared: &Shared, base: &Base) -> Document {
+    let mut cos = base.doc.clone();
+    for (&num, entry) in &shared.objects {
+        match entry {
+            Some((generation, o)) => cos.set(ObjRef::new(num, *generation), o.clone()),
+            None => cos.free(ObjRef::new(num, base.doc.generation(num))),
+        }
+    }
+    if let Some(own) = &shared.trailer {
+        let mut trailer: Dict =
+            base.doc.trailer().iter().filter(|(k, _)| LAYOUT.contains(&k.as_slice())).map(|(k, v)| (k.clone(), v.clone())).collect();
+        for (k, v) in own.iter() {
+            trailer.set(k.clone(), v.clone());
+        }
+        *cos.trailer_mut() = trailer;
+    }
+    if shared.rewrite {
+        cos.require_full_save();
+    }
+    cos
+}
+
+fn refs(o: &Object, out: &mut Vec<ObjRef>) {
+    match o {
+        Object::Ref(r) => out.push(*r),
+        Object::Array(a) => a.iter().for_each(|x| refs(x, out)),
+        Object::Dict(d) => d.iter().for_each(|(_, x)| refs(x, out)),
+        Object::Stream(s) => s.dict.iter().for_each(|(_, x)| refs(x, out)),
+        _ => {}
+    }
+}
+
+/// A merged document's canonical form, once nothing changed refers to an object the merge deleted.
+fn merged(shared: &Shared, base: &Base) -> Result<Value, Error> {
+    for (num, entry) in &shared.objects {
+        let mut to = Vec::new();
+        if let Some((_, o)) = entry {
+            refs(o, &mut to);
+        }
+        if let Some(gone) = to.iter().find(|r| matches!(shared.objects.get(&r.num), Some(None))) {
+            return Err(format!("Conflict: object {} was deleted while object {num} still uses it", gone.num));
+        }
+    }
+    Ok(project(&build(shared, base), base))
+}
+
+/// Whether every peer can install `doc`: it is canonical, and its file writes and inspects as installing does.
+fn validate(doc: &Value) -> Result<(), Error> {
+    let shared = read(doc)?;
+    let base = base_for(shared.pdf)?;
+    let cos = build(&shared, &base);
+    if project(&cos, &base) != *doc {
+        return Err("Invalid shared document: not in its canonical form".into());
+    }
+    let bytes = write_incremental(&cos, &SaveOptions::default()).map_err(|e| format!("Conflict: the PDF can't be written: {e}"))?;
+    pdfcraft_render::inspect(Arc::new(bytes), None).map_err(|e| format!("Conflict: the PDF does not open: {e}"))?;
+    Ok(())
+}
+
+/// Points references at renumbered objects.
+fn renumbered(o: Object, map: &HashMap<u32, u32>) -> Object {
+    match o {
+        Object::Ref(r) => Object::Ref(map.get(&r.num).map_or(r, |&num| ObjRef::new(num, r.generation))),
+        Object::Array(a) => Object::Array(a.into_iter().map(|x| renumbered(x, map)).collect()),
+        Object::Dict(d) => Object::Dict(d.iter().map(|(k, v)| (k.clone(), renumbered(v.clone(), map))).collect()),
+        Object::Stream(s) => {
+            Object::Stream(Stream { dict: s.dict.iter().map(|(k, v)| (k.clone(), renumbered(v.clone(), map))).collect(), raw: s.raw })
+        }
+        other => other,
+    }
+}
+
+/// Objects both sides added under one number stay two objects: `side`'s get numbers above every one in use.
+fn renumber(b: &Shared, c: &Shared, side: &mut Shared, base: &Base) -> Result<(), Error> {
+    let new = |s: &Shared| -> BTreeSet<u32> {
+        s.objects.keys().filter(|n| !b.objects.contains_key(n) && base.doc.xref_entry(**n).is_none()).copied().collect()
+    };
+    let used = [&b.objects, &c.objects, &side.objects].iter().filter_map(|o| o.keys().next_back()).max().map_or(0, |n| n.saturating_add(1));
+    let mut next = used.max(base.next);
+    let mut map = HashMap::new();
+    for n in new(c).intersection(&new(side)) {
+        map.insert(*n, next);
+        next = next.checked_add(1).ok_or_else(|| conflict("the object numbers"))?;
+    }
+    if map.is_empty() {
+        return Ok(());
+    }
+    #[cfg(test)]
+    tests::RENUMBERED.set(tests::RENUMBERED.get() + 1);
+    for (num, entry) in std::mem::take(&mut side.objects) {
+        let entry = if b.objects.get(&num) == Some(&entry) { entry } else { entry.map(|(g, o)| (g, renumbered(o, &map))) };
+        side.objects.insert(map.get(&num).copied().unwrap_or(num), entry);
+    }
+    if side.trailer != b.trailer {
+        side.trailer = side.trailer.take().map(|t| t.iter().map(|(k, v)| (k.clone(), renumbered(v.clone(), &map))).collect());
+    }
+    Ok(())
+}
+
+/// A three-way merge of one value (`b` the common base): one side's change applies where the other left it alone;
+/// dictionaries merge by key, streams by data and dictionary, arrays of references as ordered sets.
+fn merge_object(b: &Object, c: &Object, e: &Object, at: &str) -> Result<Object, Error> {
+    if c == b {
+        return Ok(e.clone());
+    }
+    if e == b {
+        return Ok(c.clone());
+    }
+    let refs = |a: &[Object]| a.iter().map(Object::as_ref).collect::<Option<Vec<ObjRef>>>();
+    match (b, c, e) {
+        (Object::Dict(b), Object::Dict(c), Object::Dict(e)) => Ok(Object::Dict(merge_dict(b, c, e, at)?)),
+        (Object::Stream(b), Object::Stream(c), Object::Stream(e)) => {
+            let raw = if c.raw == b.raw {
+                e.raw.clone()
+            } else if e.raw == b.raw {
+                c.raw.clone()
+            } else {
+                return Err(conflict(format!("{at} (stream data)")));
+            };
+            Ok(Object::Stream(Stream { dict: merge_dict(&b.dict, &c.dict, &e.dict, at)?, raw }))
+        }
+        (Object::Array(b), Object::Array(c), Object::Array(e)) => match (refs(b), refs(c), refs(e)) {
+            (Some(b), Some(c), Some(e)) => Ok(Object::Array(merge_refs(&b, &c, &e, at)?.into_iter().map(Object::Ref).collect())),
+            _ => Err(conflict(at)),
+        },
+        _ => Err(conflict(at)),
+    }
+}
+
+/// Keys keep the base's order; keys either side added follow, by name.
+fn merge_dict(b: &Dict, c: &Dict, e: &Dict, at: &str) -> Result<Dict, Error> {
+    let added: BTreeSet<&Name> = c.iter().chain(e.iter()).map(|(k, _)| k).filter(|k| !b.contains(k)).collect();
+    let mut out = Dict::new();
+    for key in b.iter().map(|(k, _)| k).chain(added) {
+        let (vb, vc, ve) = (b.get(key), c.get(key), e.get(key));
+        let value = if ve == vb {
+            vc.cloned()
+        } else if vc == vb {
+            ve.cloned()
+        } else {
+            let at = format!("{at} /{}", String::from_utf8_lossy(key));
+            match (vb, vc, ve) {
+                (Some(vb), Some(vc), Some(ve)) => Some(merge_object(vb, vc, ve, &at)?),
+                // Both sides started the same list (a page's first comments): an empty one before.
+                (None, Some(vc @ Object::Array(_)), Some(ve @ Object::Array(_))) => Some(merge_object(&Object::Array(Vec::new()), vc, ve, &at)?),
+                _ => return Err(conflict(at)),
+            }
+        };
+        if let Some(v) = value {
+            out.set(key.clone(), v);
+        }
+    }
+    Ok(out)
+}
+
+/// References as a set: each side's additions and removals apply (the same one on both sides is a conflict), the
+/// order one side gave the rest stays, and additions follow the item before them (by number where both sides add at
+/// one place).
+fn merge_refs(b: &[ObjRef], c: &[ObjRef], e: &[ObjRef], at: &str) -> Result<Vec<ObjRef>, Error> {
+    let set = |a: &[ObjRef]| a.iter().copied().collect::<HashSet<ObjRef>>();
+    let (bs, cs, es) = (set(b), set(c), set(e));
+    if bs.len() != b.len() || cs.len() != c.len() || es.len() != e.len() {
+        return Err(conflict(at));
+    }
+    let (added_c, added_e) = (&cs - &bs, &es - &bs);
+    if !added_c.is_disjoint(&added_e) || !(&bs - &cs).is_disjoint(&(&bs - &es)) {
+        return Err(conflict(at));
+    }
+    let kept: HashSet<ObjRef> = bs.iter().filter(|r| cs.contains(r) && es.contains(r)).copied().collect();
+    let order = |a: &[ObjRef]| a.iter().filter(|r| kept.contains(r)).copied().collect::<Vec<_>>();
+    let (bo, co, eo) = (order(b), order(c), order(e));
+    let kept_order = if co == bo {
+        eo
+    } else if eo == bo {
+        co
+    } else {
+        return Err(conflict(format!("{at} (order)")));
+    };
+    let mut after: BTreeMap<Option<ObjRef>, Vec<ObjRef>> = BTreeMap::new();
+    for (side, added) in [(c, &added_c), (e, &added_e)] {
+        let mut previous = None;
+        for r in side {
+            if added.contains(r) {
+                after.entry(previous).or_default().push(*r);
+            }
+            if added.contains(r) || kept.contains(r) {
+                previous = Some(*r);
+            }
+        }
+    }
+    after.values_mut().for_each(|v| v.sort());
+    let mut out = Vec::with_capacity(kept.len() + added_c.len() + added_e.len());
+    let mut stack: Vec<ObjRef> = after.remove(&None).unwrap_or_default().into_iter().rev().collect();
+    let mut rest: Vec<ObjRef> = kept_order.into_iter().rev().collect();
+    while let Some(r) = stack.pop().or_else(|| rest.pop()) {
+        if let Some(children) = after.remove(&Some(r)) {
+            stack.extend(children.into_iter().rev());
+        }
+        out.push(r);
+    }
+    Ok(out)
+}
+
+/// The three-way merge of shared documents: `current` is the side not accepted yet (a proposal on the coordinator,
+/// this browser's unsent work on a receiver), and its new objects move when both sides added one under one number.
+fn merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+    let (b, mut c, e) = (read(base)?, read(current)?, read(edited)?);
+    if current == base {
+        return Ok(edited.clone());
+    }
+    if edited == base {
+        return Ok(current.clone());
+    }
+    if b.pdf != c.pdf || b.pdf != e.pdf {
+        return Err(conflict("the document (it was replaced)"));
+    }
+    let base = base_for(b.pdf)?;
+    renumber(&b, &e, &mut c, &base)?;
+    let numbers: BTreeSet<u32> = b.objects.keys().chain(c.objects.keys()).chain(e.objects.keys()).copied().collect();
+    let mut objects = BTreeMap::new();
+    for num in numbers {
+        let (vb, vc, ve) = (b.objects.get(&num), c.objects.get(&num), e.objects.get(&num));
+        let entry = if ve == vb {
+            vc.cloned()
+        } else if vc == vb {
+            ve.cloned()
+        } else {
+            let state = |v: Option<&Entry>| match v {
+                Some(entry) => entry.clone(),
+                None => Some((base.doc.generation(num), (*base.doc.try_get(num).unwrap_or_else(|_| Arc::new(Object::Null))).clone())),
+            };
+            let at = format!("object {num}");
+            match (state(vb), state(vc), state(ve)) {
+                (Some((_, ob)), Some((gc, oc)), Some((ge, oe))) if gc == ge => Some(Some((gc, merge_object(&ob, &oc, &oe, &at)?))),
+                _ => return Err(conflict(at)),
+            }
+        };
+        if let Some(entry) = entry {
+            objects.insert(num, entry);
+        }
+    }
+    let own = own_entries(base.doc.trailer());
+    let [tb, tc, te] = [&b.trailer, &c.trailer, &e.trailer].map(|t| t.clone().unwrap_or_else(|| own.clone()));
+    let trailer = merge_dict(&tb, &tc, &te, "the trailer")?;
+    let result = Shared { pdf: b.pdf, objects, trailer: (trailer != own).then_some(trailer), rewrite: c.rewrite || e.rewrite };
+    merged(&result, &base)
+}
+
+/// Why a document is not shared, if it isn't.
+fn refusal(doc: &pdfcraft_engine::Document) -> Option<String> {
+    let why = match doc.live_cos() {
+        None => "it can't be edited",
+        Some(cos) if cos.security().is_some() || cos.encryption_changed() => "it is encrypted",
+        Some(_) if doc.is_signed() => "it is signed",
+        Some(_) if doc.xfa.is_some() || doc.info.xfa.is_some() => "it has an XFA form",
+        Some(_) => return None,
+    };
+    Some(format!("This PDF can't be edited live: {why}. Live editing shares unencrypted, unsigned PDFs without XFA forms."))
+}
+
+/// Whether `id` is the shared document (Undo and Redo go to the session).
+pub(crate) fn shared(id: DocId) -> bool {
+    STATE.with_borrow(|s| s.pin == Some(id) && !s.paused) && playground_live::connected()
+}
+
+/// Commands that act otherwise on the shared document while live: Undo and Redo go to the session (whatever this
+/// browser's own history holds), and Revert, which would take back everyone's edits, is off.
+pub(crate) fn command_enabled(app: &PdfCraftApp, id: &str) -> Option<bool> {
+    if app.combine_showing() || !app.active_ids().is_some_and(|(_, doc)| shared(doc)) {
+        return None;
+    }
+    match id {
+        "edit.undo" | "edit.redo" => Some(true),
+        "file.revert" => Some(false),
+        _ => None,
+    }
+}
+
+/// Undo or Redo of the shared document goes to the session: whether it did (the app's Undo then stops).
+pub(crate) fn undo(app: &PdfCraftApp, undo: bool) -> bool {
+    app.active_ids().is_some_and(|(_, id)| shared(id)) && playground_live::undo(!undo)
+}
+
+/// The end of each frame.
+pub(crate) fn frame(app: &mut PdfCraftApp) {
+    STATE.with_borrow_mut(|s| (s.ctx.clone_from(&app.ctx), s.in_frame = true));
+    pdfcraft_engine::live_playground::share(STATE.with_borrow(|s| s.pin).filter(|&id| shared(id)));
+    playground_live::frame(app);
+    STATE.with_borrow_mut(|s| s.in_frame = false);
+    if let Some(notice) = STATE.with_borrow_mut(|s| s.notice.take()) {
+        app.notify(notice);
+    }
+}
+
+/// Views of `id` after its graph changed from `before`: the reader's place and a selected comment that is still
+/// where it was stay. When the pages changed, everything else that points at a page index starts afresh.
+fn views_changed(app: &mut PdfCraftApp, id: DocId, before: Option<&Document>) {
+    let Some(doc) = app.session.get(id) else { return };
+    let pages = |cos: Option<&Document>| cos.map(|c| pdfcraft_model::pages(c).into_iter().map(|p| (p.obj, p.dict)).collect::<Vec<_>>());
+    let (old, new) = (pages(before), pages(doc.live_cos()));
+    let annot = |pages: &Option<Vec<(ObjRef, Dict)>>, cos: Option<&Document>, page: usize, index: usize| -> Option<ObjRef> {
+        let (_, dict) = pages.as_ref()?.get(page)?;
+        cos?.resolve(dict.get(b"Annots")?).as_array()?.get(index)?.as_ref()
+    };
+    let same_pages = old.as_ref().map(|o| o.iter().map(|p| p.0).collect::<Vec<_>>()) == new.as_ref().map(|n| n.iter().map(|p| p.0).collect());
+    for view in app.views.iter_mut().filter(|v| v.id == id) {
+        let kept = view
+            .comments
+            .selected
+            .filter(|&(page, index)| annot(&old, before, page, index).is_some_and(|r| annot(&new, doc.live_cos(), page, index) == Some(r)));
+        if same_pages {
+            view.document_changed(&doc.info);
+        } else {
+            view.document_replaced(&doc.info);
+        }
+        view.comments.selected = kept;
+    }
+}
+
+impl PdfCraftApp {
+    /// The shared document's tab, binding the active document the first time one is needed.
+    fn live_pin(&self) -> Option<DocId> {
+        let active = self.active_ids().map(|(_, id)| id);
+        STATE.with_borrow_mut(|s| {
+            if s.pin.is_none()
+                && let Some(id) = active
+            {
+                (s.pin, s.base, s.last, s.paused) = (Some(id), None, None, false);
+                s.notice = self.session.get(id).and_then(refusal);
+            }
+            s.pin
+        })
+    }
+}
+
+impl Live for PdfCraftApp {
+    fn live_document(&self) -> Value {
+        let Some(id) = self.live_pin() else { return json!({}) };
+        let cos = match self.session.get(id) {
+            Some(doc) => match refusal(doc) {
+                // Shared before (then signed or protected here): its last shared state stays the one reported for the
+                // rest of the session, and this browser says why.
+                Some(why) if STATE.with_borrow(|s| s.last.is_some()) => {
+                    STATE.with_borrow_mut(|s| {
+                        if !s.paused {
+                            s.paused = true;
+                            s.notice = Some(format!("Live editing is paused for this PDF: your changes to it stay in this browser. {why}"));
+                        }
+                    });
+                    None
+                }
+                Some(why) => return json!({ "refused": why }),
+                None if STATE.with_borrow(|s| s.paused) => None,
+                None => doc.live_cos().cloned(),
+            },
+            None => None,
+        };
+        let Some(cos) = cos.or_else(|| STATE.with_borrow(|s| s.last.clone())) else { return json!({}) };
+        let base = match STATE.with_borrow(|s| s.base.clone()) {
+            Some(base) => base,
+            None => match base_of(cos.bytes().clone(), None) {
+                Ok(base) => base,
+                Err(why) => return json!({ "refused": why }),
+            },
+        };
+        let document = project(&cos, &base);
+        STATE.with_borrow_mut(|s| (s.base, s.last) = (Some(base), Some(cos)));
+        document
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let shared = read(&document)?;
+        let base = base_for(shared.pdf)?;
+        let cos = build(&shared, &base);
+        let pin = self.live_pin();
+        let (same_file, paused) = STATE.with_borrow(|s| (s.base.as_ref().is_some_and(|b| b.pdf == base.pdf), s.paused));
+        let id = match pin {
+            // Closed or paused: the shared state is kept as the one reported, the tab is left alone.
+            Some(id) if paused || self.session.get(id).is_none() => {
+                STATE.with_borrow_mut(|s| (s.base, s.last, s.generation) = (Some(base), Some(cos), s.generation.wrapping_add(1)));
+                return Ok(());
+            }
+            Some(id) if same_file => id,
+            // Another file than the one this tab shows (or no tab yet): it opens in a tab of its own.
+            _ => {
+                let open: HashSet<DocId> = self.views.iter().map(|v| v.id).collect();
+                self.open_bytes("Shared document.pdf", None, base.doc.bytes().to_vec())?;
+                self.views.iter().map(|v| v.id).find(|id| !open.contains(id)).ok_or("The shared PDF did not open")?
+            }
+        };
+        let before = self.session.get(id).and_then(|d| d.live_cos()).cloned();
+        self.session.live_replace_graph(id, cos).map_err(|e| e.to_string())?;
+        STATE.with_borrow_mut(|s| (s.pin, s.base) = (Some(id), Some(base)));
+        views_changed(self, id, before.as_ref());
+        if let Some(ctx) = &self.ctx {
+            ctx.request_repaint();
+        }
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        let input = self.ctx.as_ref().is_some_and(|ctx| ctx.input(|i| i.pointer.any_down()) || ctx.text_edit_focused());
+        let gesture = self.views.iter().any(|v| {
+            v.comments.gesture.is_some()
+                || v.comments.composer.is_some()
+                || v.comments.editing.is_some()
+                || v.line_editor.is_some()
+                || v.content.draft.is_some()
+                || v.fill_text.is_some()
+                || v.forms.focus.is_some()
+                || v.pending_edit.is_some()
+                || v.block_drag.is_some()
+                || v.org_drag.is_some()
+                || v.panel_drag.is_some()
+                || v.marquee.is_some()
+                || v.camera.is_some()
+        });
+        !input && !gesture && !self.modal_open() && !self.palette_open
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        let id = self.live_pin();
+        let now = id.and_then(|id| Some(self.session.get(id)?.edit_generation().wrapping_add(id.0 << 40).wrapping_add(1)));
+        STATE.with_borrow_mut(|s| {
+            s.generation = now.unwrap_or(s.generation);
+            Some(s.generation)
+        })
+    }
+
+    fn live_disconnected(&mut self) {
+        if let Some(id) = STATE.with_borrow(|s| s.pin) {
+            self.session.live_clear_history(id);
+        }
+        pdfcraft_engine::live_playground::share(None);
+        STATE.with_borrow_mut(|s| *s = State { ctx: s.ctx.take(), ..State::default() });
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+        merge(base, current, edited)
+    }
+
+    /// The coordinator checks fully; a receiver's merge is checked by installing it (the same write and inspection).
+    fn live_check(document: &Value) -> Result<(), Error> {
+        if STATE.with_borrow(|s| s.in_frame) { read(document).map(drop) } else { validate(document) }
+    }
+
+    fn live_presence(&self) -> Value {
+        presence(self).unwrap_or(Value::Null)
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        STATE.with_borrow_mut(|s| s.others = others);
+    }
+}
+
+/// The shared document's page and comment object numbers (what presence refers to), for one state of its graph.
+struct Ids {
+    doc: DocId,
+    generation: u64,
+    /// Each page's object number and geometry.
+    pages: Vec<(u32, pdfcraft_render::PageInfo)>,
+    /// Each annotation's object number: its page, index in `/Annots` and rectangle in user space.
+    annots: HashMap<u32, (usize, usize, [f32; 4])>,
+}
+
+/// [`Ids`] of document `id` as it is now, read again only after a change.
+fn ids(app: &PdfCraftApp, id: DocId) -> Option<Rc<Ids>> {
+    let doc = app.session.get(id)?;
+    let generation = doc.edit_generation();
+    if let Some(ids) = STATE.with_borrow(|s| s.ids.clone()).filter(|i| i.doc == id && i.generation == generation) {
+        return Some(ids);
+    }
+    let cos = doc.live_cos()?;
+    let pages = pdfcraft_model::pages(cos);
+    let lists: Vec<Vec<Option<u32>>> = pages
+        .iter()
+        .map(|p| {
+            let list = p.dict.get(b"Annots").map(|a| cos.resolve(a));
+            list.and_then(|l| Some(l.as_array()?.iter().map(|o| o.as_ref().map(|r| r.num)).collect())).unwrap_or_default()
+        })
+        .collect();
+    let annots = doc
+        .info
+        .annotations
+        .iter()
+        .filter_map(|a| Some((lists.get(a.page)?.get(a.index).copied().flatten()?, (a.page, a.index, a.rect))))
+        .collect();
+    let pages = pages.iter().zip(&doc.info.pages).map(|(p, info)| (p.obj.num, info.clone())).collect();
+    let ids = Rc::new(Ids { doc: id, generation, pages, annots });
+    STATE.with_borrow_mut(|s| s.ids = Some(ids.clone()));
+    Some(ids)
+}
+
+/// This person's presence: the page under the pointer (else the current one), the pointer in its user space while it
+/// is over a page, and the selected comment.
+fn presence(app: &PdfCraftApp) -> Option<Value> {
+    let (i, id) = app.active_ids().filter(|&(_, id)| shared(id))?;
+    let (ids, view) = (ids(app, id)?, app.views.get(i)?);
+    let pointer = app.ctx.as_ref().and_then(|ctx| ctx.pointer_hover_pos()).filter(|p| !view.organize && view.viewport_rect().contains(*p));
+    let at = pointer.and_then(|p| {
+        let (page, _) = view.visible_page_rects().into_iter().find(|(_, r)| r.contains(p))?;
+        Some((page, view.page_xform(page)?.screen_to_view(p)))
+    });
+    let (num, info) = ids.pages.get(at.map_or(view.current, |(page, _)| page))?;
+    let selected = view.comments.selected.and_then(|(page, index)| ids.annots.iter().find(|(_, a)| (a.0, a.1) == (page, index)).map(|(n, _)| *n));
+    let mut state = json!({ "page": num, "selection": selected.into_iter().collect::<Vec<_>>() });
+    if let Some((_, (x, y))) = at {
+        state["pointer"] = json!(info.view_to_user(x, y).map(|v| (f64::from(v) * 10.0).round() / 10.0));
+    }
+    Some(state)
+}
+
+/// Draws the others' selected comments and pointers (with their names) on the pages `view` shows, in their colors.
+pub(crate) fn paint(view: &crate::DocView, area: egui::Rect, ui: &egui::Ui) {
+    use egui::{Color32, CornerRadius, Pos2, Rect, Stroke, StrokeKind, vec2};
+    STATE.with_borrow(|s| {
+        let Some(ids) = s.ids.as_ref().filter(|ids| ids.doc == view.id && !s.others.is_empty() && shared(view.id)) else { return };
+        let painter = ui.painter().with_clip_rect(area);
+        let screen = |page: usize, [x, y]: [f32; 2]| -> Option<Pos2> {
+            let (xf, (_, info)) = (view.page_xform(page)?, ids.pages.get(page)?);
+            let v = info.user_to_view(x, y);
+            Some(xf.norm_to_screen(v[0] / xf.pw, v[1] / xf.ph))
+        };
+        for other in &s.others {
+            let color = Color32::from_rgb(other.color[0], other.color[1], other.color[2]);
+            let num = |v: &Value| v.as_u64().and_then(|n| u32::try_from(n).ok());
+            for n in other.state["selection"].as_array().into_iter().flatten().take(50).filter_map(num) {
+                let Some(&(page, _, r)) = ids.annots.get(&n) else { continue };
+                if let (Some(a), Some(b)) = (screen(page, [r[0], r[1]]), screen(page, [r[2], r[3]])) {
+                    painter.rect_stroke(Rect::from_two_pos(a, b).expand(2.0), CornerRadius::ZERO, Stroke::new(2.0, color), StrokeKind::Middle);
+                }
+            }
+            let page = num(&other.state["page"]).and_then(|n| ids.pages.iter().position(|(p, _)| *p == n));
+            let xy = other.state["pointer"].as_array().filter(|a| a.len() == 2).and_then(|a| Some([a[0].as_f64()? as f32, a[1].as_f64()? as f32]));
+            let at = page.zip(xy.filter(|xy| xy.iter().all(|v| v.abs() < 1e6))).and_then(|(page, xy)| screen(page, xy));
+            let Some(at) = at.filter(|at| area.contains(*at)) else { continue };
+            let arrow = vec![at, at + vec2(0.0, 17.0), at + vec2(12.0, 12.0)];
+            painter.add(egui::Shape::convex_polygon(arrow, color, Stroke::new(1.0, Color32::WHITE)));
+            let name = painter.layout_no_wrap(other.name.clone(), egui::FontId::proportional(12.0), Color32::WHITE);
+            let tag = Rect::from_min_size(at + vec2(10.0, 16.0), name.size() + vec2(8.0, 4.0));
+            painter.rect_filled(tag, CornerRadius::same(3), color);
+            painter.galley(tag.min + vec2(4.0, 2.0), name, Color32::WHITE);
+        }
+    });
+}
