+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::playground_live::{canonical, checkpoint, connect, disconnect, queue};
+    use pdfcraft_engine::{Edit, NewAnnotation, NoteIcon, Session, Shape, Style};
+
+    fn note(page: usize, text: &str) -> Edit {
+        let style = Style { color: [1.0, 0.8, 0.0], opacity: 1.0, width: 1.0, fill: None };
+        Edit::AddAnnotation(NewAnnotation {
+            page,
+            shape: Shape::Note { at: [40.0, 150.0], icon: NoteIcon::Comment },
+            style,
+            contents: text.into(),
+            author: text.into(),
+        })
+    }
+
+    fn rotate(page: usize, degrees: i64) -> Edit {
+        Edit::RotatePages { pages: vec![page], degrees }
+    }
+
+    /// The shared document of `bytes` after `edits` in a browser of its own.
+    fn edited(bytes: &Arc<Vec<u8>>, base: &Base, edits: Vec<Edit>) -> Value {
+        let mut session = Session::new();
+        let id = session.open("other.pdf", None, bytes.clone(), None).unwrap();
+        for edit in edits {
+            session.apply(id, edit).unwrap();
+        }
+        project(session.get(id).unwrap().cos().unwrap(), base)
+    }
+
+    #[test]
+    fn the_shared_pdf_leaves_views_out_and_a_remote_change_waits_keeps_views_and_is_no_undo_step() {
+        let mut app = PdfCraftApp::new();
+        let bytes = app.session.create_blank(200.0, 200.0, 2).unwrap();
+        app.open_bytes("shared.pdf", None, bytes.to_vec()).unwrap();
+        connect();
+        let start = app.live_document();
+        assert_eq!(start["objects"], json!({}), "an unedited PDF is just its file");
+        let base = base_for(start["pdf"].as_str().unwrap()).unwrap();
+        (app.views[0].zoom, app.views[0].current) = (3.0, 1);
+        app.views[0].comments.selected = None;
+        assert_eq!(app.live_document(), start, "views are not shared");
+
+        let remote = edited(&bytes, &base, vec![rotate(1, 90)]);
+        let done = std::rc::Rc::new(std::cell::RefCell::new(None));
+        let to = done.clone();
+        queue(Some(canonical(&start)), canonical(&remote), Box::new(move |r| *to.borrow_mut() = Some(r)));
+        app.palette_open = true;
+        crate::playground_live::frame(&mut app);
+        assert!(done.borrow().is_none() && checkpoint(&app) == Err("busy".into()), "a busy app waits");
+        app.palette_open = false;
+        crate::playground_live::frame(&mut app);
+        assert_eq!(*done.borrow(), Some(Ok(None)));
+        assert_eq!(canonical(&app.live_document()), canonical(&remote), "same document, same bytes");
+        assert_eq!((app.views[0].zoom, app.views[0].current), (3.0, 1), "this person's view stays");
+        let doc = app.session.get(app.views[0].id).unwrap();
+        assert!(doc.can_undo().is_none() && pdfcraft_model::pages(doc.cos().unwrap())[1].dict.int(b"Rotate") == Some(90));
+        disconnect();
+    }
+
+    #[test]
+    fn comments_on_one_page_merge_with_fresh_numbers_alike_everywhere_and_one_key_changed_twice_conflicts() {
+        let bytes = Session::new().create_blank(200.0, 200.0, 2).unwrap();
+        let base = base_of(bytes.clone(), None).unwrap();
+        let b = edited(&bytes, &base, vec![]);
+        let c = edited(&bytes, &base, vec![rotate(0, 90), note(1, "c")]);
+        let e = edited(&bytes, &base, vec![note(1, "e"), rotate(1, 90)]);
+        // The coordinator moves the proposal's new objects; the proposer, merging the accepted change into its
+        // unsent work, moves its own: both get the same document.
+        let merged = merge(&b, &c, &e, false).unwrap();
+        assert_eq!(merged, merge(&b, &e, &c, true).unwrap());
+        let cos = build(&read(&merged).unwrap().unwrap(), &base);
+        let pages = pdfcraft_model::pages(&cos);
+        let annots = cos.resolve(pages[1].dict.get(b"Annots").unwrap()).as_array().unwrap().clone();
+        let contents: BTreeSet<String> =
+            annots.iter().filter_map(|a| cos.resolve(a).as_dict()?.get(b"Contents")?.as_string().map(|s| s.to_text())).collect();
+        assert_eq!(contents, ["c".to_string(), "e".to_string()].into(), "both comments, as two objects");
+        assert_eq!([0, 1].map(|p| pages[p].dict.int(b"Rotate")), [Some(90), Some(90)]);
+
+        let again = edited(&bytes, &base, vec![rotate(0, 180)]);
+        assert!(merge(&b, &c, &again, false).unwrap_err().contains("/Rotate"), "both turned page 1");
+    }
+}
