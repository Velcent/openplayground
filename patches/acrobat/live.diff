+//! Playground live editing (web only; the playground-live crate, patches/live/kit, drives it and draws the others). The
+//! shared document is the set of PDFs open in the session, `{"documents": [{"id", "name", ...that PDF}]}` by id: the
+//! one shown when the session started and every PDF opened, created or dropped here or by the others since, which
+//! reaches the others as a tab behind theirs. Closing a tab is this person's own: the PDF stays in the session, up to
+//! date, and Home lists it to open again. One PDF is the file it was opened from plus every object that differs from
+//! it, as JSON: `{"pdf": base64, "objects": {"<number>": base64("N G obj … endobj") or null when deleted}, "trailer"?:
+//! base64(the trailer's own entries), "rewrite"?: true}`. Objects are written by the PDF writer, so equal graphs give
+//! equal bytes and one edit changes only the objects it touched. PDFs this version does not share (encrypted, signed,
+//! XFA forms, read-only) stay this person's own, and they are told why.
+//!
+//! The merge is per PDF (by id), per object, then per dictionary key: arrays of references (`/Annots`, `/Kids`,
+//! `/Fields`, …) merge as sets that keep their order, so two comments on one page both stay; a value both sides
+//! changed is a conflict. Objects both sides added under one number are told apart by giving the unsent side's
+//! (`current`'s) new objects fresh numbers. The coordinator checks every document it records the way receivers install
+//! it (written, then inspected); receivers check by installing.
+//!
+//! Presence: `{"doc", "page": <page object number>, "pointer"?: [x, y] in that page's user space, "selection": [object
+//! numbers of selected comments]}` and the gesture under way: `draw` (a comment being drawn: its tool, points and
+//! width), `ghost` (a comment being moved or resized: its number and rectangle), `text` (a text selection being
+//! dragged, as rectangles), `typing` (text being typed into a comment, a form field or a text box: where, and its
+//! end). Drawn on the pages shown in the session's look by [`paint`] ([`presence`]: pointers, tags, ghosts, outlines,
+//! dashed bands, easing; a drawing's strokes are PdfCraft's own, in the person's colour); dots on the tabs
+//! ([`tab_dots`]) and Home's "In this session" ([`session_list`]) show who is on which PDF. The web entry runs the app
+//! wrapped ([`wrap`]), so each frame ends with the session's [`frame`]; the engine's `live_playground` installs graphs
+//! without undo steps.
+
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+use crate::{DocView, PdfCraftApp};
+use base64::Engine as _;
+use egui::{Color32, Pos2, Rect, Shape, Stroke, pos2, vec2};
+use pdfcraft_cos::{Dict, Document, Lexer, Name, ObjRef, Object, SaveOptions, Stream, parse_indirect, serialize, write_incremental};
+use pdfcraft_engine::DocId;
+use playground_live::{Error, Live, Presence, presence};
+use serde_json::{Map, Value, json};
+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};
+use std::rc::Rc;
+use std::sync::Arc;
+
+const B64: base64::engine::GeneralPurpose = base64::engine::general_purpose::STANDARD;
+/// Trailer entries that describe the file's layout, not the document: each save writes its own.
+const LAYOUT: &[&[u8]] = &[b"Size", b"Prev", b"XRefStm", b"Type", b"W", b"Index", b"Filter", b"DecodeParms", b"Length"];
+
+/// A file a shared PDF was opened from, opened once.
+struct Base {
+    pdf: String,
+    doc: Document,
+    /// Above every object number the file uses.
+    next: u32,
+}
+
+/// A PDF of the session.
+struct Doc {
+    /// Its id in the session.
+    id: u64,
+    name: String,
+    /// Its tab here; `None` once this person closed it.
+    tab: Option<DocId>,
+    base: Rc<Base>,
+    /// Its graph as last read or installed: what the session goes on with while its tab is closed.
+    last: Document,
+    /// The tab's edit generation `last` was read at.
+    seen: u64,
+    /// It became a PDF that is not shared (signed, encrypted here): for the rest of the session it reports its last
+    /// shared state, and remote changes leave the tab alone.
+    paused: bool,
+}
+
+#[derive(Default)]
+struct State {
+    /// The session's PDFs, by id.
+    docs: Vec<Doc>,
+    /// Tabs opened from then on are new PDFs of the session (tab ids only grow).
+    since: Option<u64>,
+    /// For [`playground_live::fresh_id`].
+    next: u64,
+    /// Changes to `docs`, for [`Live::live_generation`].
+    revision: u64,
+    /// Files of shared PDFs decoded for merges.
+    bases: Vec<Rc<Base>>,
+    /// Tabs whose PDF is not shared, told why once.
+    told: HashSet<DocId>,
+    /// PDFs the coordinator checked already (a hash of their canonical bytes).
+    checked: HashSet<u64>,
+    /// Inside [`frame`], where merged documents are this browser's to install: installing checks them.
+    in_frame: bool,
+    notice: Option<String>,
+    ctx: Option<egui::Context>,
+    ids: Option<Rc<Ids>>,
+}
+
+thread_local! {
+    static STATE: std::cell::RefCell<State> = std::cell::RefCell::default();
+}
+
+fn conflict(what: impl std::fmt::Display) -> Error {
+    format!("Conflict at {what}")
+}
+
+fn base_of(bytes: Arc<Vec<u8>>, pdf: Option<String>) -> Result<Rc<Base>, Error> {
+    let doc = Document::open(bytes.clone()).map_err(|e| format!("The shared PDF does not open: {e}"))?;
+    let size = u32::try_from(doc.trailer().int(b"Size").unwrap_or(0)).unwrap_or(u32::MAX);
+    let next = doc.object_numbers().last().map_or(1, |n| n.saturating_add(1)).max(size);
+    Ok(Rc::new(Base { pdf: pdf.unwrap_or_else(|| B64.encode(&*bytes)), doc, next }))
+}
+
+/// The decoded file of a shared document's `pdf`: one of the session's, or decoded once and kept for a while.
+fn base_for(pdf: &str) -> Result<Rc<Base>, Error> {
+    let known = STATE.with_borrow(|s| s.docs.iter().map(|d| &d.base).chain(&s.bases).find(|b| b.pdf.len() == pdf.len() && b.pdf == pdf).cloned());
+    if let Some(base) = known {
+        return Ok(base);
+    }
+    let bytes = B64.decode(pdf).map_err(|e| format!("Invalid shared document: {e}"))?;
+    let base = base_of(Arc::new(bytes), Some(pdf.to_owned()))?;
+    STATE.with_borrow_mut(|s| {
+        s.bases.insert(0, base.clone());
+        s.bases.truncate(4);
+    });
+    Ok(base)
+}
+
+/// An object as the shared document holds it: `N G obj … endobj`.
+fn text(r: ObjRef, o: &Object) -> Vec<u8> {
+    let mut out = format!("{} {} obj\n", r.num, r.generation).into_bytes();
+    serialize(o, &mut out);
+    out.extend_from_slice(b"\nendobj\n");
+    out
+}
+
+fn own_entries(trailer: &Dict) -> Dict {
+    trailer.iter().filter(|(k, _)| !LAYOUT.contains(&k.as_slice())).map(|(k, v)| (k.clone(), v.clone())).collect()
+}
+
+/// An object number's state: its generation and object, or `None` when deleted.
+type Entry = Option<(u16, Object)>;
+
+/// A shared document read back.
+struct Shared<'a> {
+    pdf: &'a str,
+    objects: BTreeMap<u32, Entry>,
+    /// The trailer's own entries, when they differ from the base's.
+    trailer: Option<Dict>,
+    rewrite: bool,
+}
+
+/// Reads one PDF of a shared document (its `id` and `name` aside), strictly: anything [`project`] would not write back
+/// byte for byte is refused.
+fn read(doc: &Value) -> Result<Shared<'_>, Error> {
+    let Some(map) = doc.as_object() else { return Err("Invalid shared document: not an object".into()) };
+    let invalid = |what: &str| format!("Invalid shared document: {what}");
+    if map.keys().any(|k| !["pdf", "objects", "trailer", "rewrite", "id", "name"].contains(&k.as_str())) {
+        return Err(invalid("unknown entry"));
+    }
+    let pdf = map.get("pdf").and_then(Value::as_str).ok_or_else(|| invalid("no PDF"))?;
+    let decode = |v: &str| B64.decode(v).map_err(|e| invalid(&e.to_string()));
+    let mut objects = BTreeMap::new();
+    for (key, value) in map.get("objects").and_then(Value::as_object).ok_or_else(|| invalid("no objects"))? {
+        let num: u32 = key.parse().ok().filter(|n: &u32| n.to_string() == *key).ok_or_else(|| invalid("object number"))?;
+        let entry = match value {
+            Value::Null => None,
+            Value::String(s) => {
+                let bytes = decode(s)?;
+                let (r, o) = parse_indirect(&bytes, 0, &|_| None).map_err(|e| invalid(&e.to_string()))?;
+                if r.num != num || text(r, &o) != bytes {
+                    return Err(invalid(&format!("object {num}")));
+                }
+                Some((r.generation, o))
+            }
+            _ => return Err(invalid(&format!("object {num}"))),
+        };
+        objects.insert(num, entry);
+    }
+    let trailer = match map.get("trailer") {
+        None => None,
+        Some(v) => {
+            let bytes = decode(v.as_str().ok_or_else(|| invalid("trailer"))?)?;
+            let Ok(Object::Dict(d)) = Lexer::new(&bytes, 0).object() else { return Err(invalid("trailer")) };
+            let mut again = Vec::new();
+            serialize(&Object::Dict(d.clone()), &mut again);
+            if again != bytes {
+                return Err(invalid("trailer"));
+            }
+            Some(d)
+        }
+    };
+    let rewrite = match map.get("rewrite") {
+        None => false,
+        Some(Value::Bool(true)) => true,
+        Some(_) => return Err(invalid("rewrite")),
+    };
+    Ok(Shared { pdf, objects, trailer, rewrite })
+}
+
+/// The shared document of `cos`, a state of `base`'s file (or of a later save of it).
+fn project(cos: &Document, base: &Base) -> Value {
+    let same = Arc::ptr_eq(cos.bytes(), base.doc.bytes()) || cos.bytes() == base.doc.bytes();
+    let numbers: BTreeSet<u32> =
+        if same { cos.modified_objects().into_iter().collect() } else { cos.object_numbers().into_iter().chain(base.doc.object_numbers()).collect() };
+    let mut objects = Map::new();
+    for num in numbers {
+        let now = cos.try_get(num).unwrap_or_else(|_| Arc::new(Object::Null));
+        let was = base.doc.try_get(num).unwrap_or_else(|_| Arc::new(Object::Null));
+        let written = |doc: &Document, o: &Object| text(ObjRef::new(num, doc.generation(num)), o);
+        let value = match (&*now, &*was) {
+            (Object::Null, Object::Null) => continue,
+            (Object::Null, _) => Value::Null,
+            (now, Object::Null) => Value::String(B64.encode(written(cos, now))),
+            (now, was) => {
+                let now = written(cos, now);
+                if now == written(&base.doc, was) {
+                    continue;
+                }
+                Value::String(B64.encode(now))
+            }
+        };
+        objects.insert(num.to_string(), value);
+    }
+    let mut out = json!({"pdf": base.pdf, "objects": objects});
+    let trailer = own_entries(cos.trailer());
+    if trailer != own_entries(base.doc.trailer()) {
+        let mut bytes = Vec::new();
+        serialize(&Object::Dict(trailer), &mut bytes);
+        out["trailer"] = B64.encode(bytes).into();
+    }
+    if cos.full_save_required() {
+        out["rewrite"] = true.into();
+    }
+    out
+}
+
+/// The graph a shared document describes.
+fn build(shared: &Shared, base: &Base) -> Document {
+    let mut cos = base.doc.clone();
+    for (&num, entry) in &shared.objects {
+        match entry {
+            Some((generation, o)) => cos.set(ObjRef::new(num, *generation), o.clone()),
+            None => cos.free(ObjRef::new(num, base.doc.generation(num))),
+        }
+    }
+    if let Some(own) = &shared.trailer {
+        let mut trailer: Dict =
+            base.doc.trailer().iter().filter(|(k, _)| LAYOUT.contains(&k.as_slice())).map(|(k, v)| (k.clone(), v.clone())).collect();
+        for (k, v) in own.iter() {
+            trailer.set(k.clone(), v.clone());
+        }
+        *cos.trailer_mut() = trailer;
+    }
+    if shared.rewrite {
+        cos.require_full_save();
+    }
+    cos
+}
+
+fn refs(o: &Object, out: &mut Vec<ObjRef>) {
+    match o {
+        Object::Ref(r) => out.push(*r),
+        Object::Array(a) => a.iter().for_each(|x| refs(x, out)),
+        Object::Dict(d) => d.iter().for_each(|(_, x)| refs(x, out)),
+        Object::Stream(s) => s.dict.iter().for_each(|(_, x)| refs(x, out)),
+        _ => {}
+    }
+}
+
+/// A merged document's canonical form, once nothing changed refers to an object the merge deleted.
+fn merged(shared: &Shared, base: &Base) -> Result<Value, Error> {
+    for (num, entry) in &shared.objects {
+        let mut to = Vec::new();
+        if let Some((_, o)) = entry {
+            refs(o, &mut to);
+        }
+        if let Some(gone) = to.iter().find(|r| matches!(shared.objects.get(&r.num), Some(None))) {
+            return Err(format!("Conflict: object {} was deleted while object {num} still uses it", gone.num));
+        }
+    }
+    Ok(project(&build(shared, base), base))
+}
+
+/// Whether every peer can install the PDF `doc`: it is canonical, and its file writes and inspects as installing does.
+fn validate(doc: &Value) -> Result<(), Error> {
+    let shared = read(doc)?;
+    let base = base_for(shared.pdf)?;
+    let cos = build(&shared, &base);
+    let mut again = project(&cos, &base);
+    for key in ["id", "name"] {
+        if let Some(v) = doc.get(key) {
+            again[key] = v.clone();
+        }
+    }
+    if again != *doc {
+        return Err("Invalid shared document: not in its canonical form".into());
+    }
+    let bytes = write_incremental(&cos, &SaveOptions::default()).map_err(|e| format!("Conflict: the PDF can't be written: {e}"))?;
+    pdfcraft_render::inspect(Arc::new(bytes), None).map_err(|e| format!("Conflict: the PDF does not open: {e}"))?;
+    Ok(())
+}
+
+/// Points references at renumbered objects.
+fn renumbered(o: Object, map: &HashMap<u32, u32>) -> Object {
+    match o {
+        Object::Ref(r) => Object::Ref(map.get(&r.num).map_or(r, |&num| ObjRef::new(num, r.generation))),
+        Object::Array(a) => Object::Array(a.into_iter().map(|x| renumbered(x, map)).collect()),
+        Object::Dict(d) => Object::Dict(d.iter().map(|(k, v)| (k.clone(), renumbered(v.clone(), map))).collect()),
+        Object::Stream(s) => {
+            Object::Stream(Stream { dict: s.dict.iter().map(|(k, v)| (k.clone(), renumbered(v.clone(), map))).collect(), raw: s.raw })
+        }
+        other => other,
+    }
+}
+
+/// Objects both sides added under one number stay two objects: `side`'s get numbers above every one in use.
+fn renumber(b: &Shared, c: &Shared, side: &mut Shared, base: &Base) -> Result<(), Error> {
+    let new = |s: &Shared| -> BTreeSet<u32> {
+        s.objects.keys().filter(|n| !b.objects.contains_key(n) && base.doc.xref_entry(**n).is_none()).copied().collect()
+    };
+    let used = [&b.objects, &c.objects, &side.objects].iter().filter_map(|o| o.keys().next_back()).max().map_or(0, |n| n.saturating_add(1));
+    let mut next = used.max(base.next);
+    let mut map = HashMap::new();
+    for n in new(c).intersection(&new(side)) {
+        map.insert(*n, next);
+        next = next.checked_add(1).ok_or_else(|| conflict("the object numbers"))?;
+    }
+    if map.is_empty() {
+        return Ok(());
+    }
+    #[cfg(test)]
+    tests::RENUMBERED.set(tests::RENUMBERED.get() + 1);
+    for (num, entry) in std::mem::take(&mut side.objects) {
+        let entry = if b.objects.get(&num) == Some(&entry) { entry } else { entry.map(|(g, o)| (g, renumbered(o, &map))) };
+        side.objects.insert(map.get(&num).copied().unwrap_or(num), entry);
+    }
+    if side.trailer != b.trailer {
+        side.trailer = side.trailer.take().map(|t| t.iter().map(|(k, v)| (k.clone(), renumbered(v.clone(), &map))).collect());
+    }
+    Ok(())
+}
+
+/// A three-way merge of one value (`b` the common base): one side's change applies where the other left it alone;
+/// dictionaries merge by key, streams by data and dictionary, arrays of references as ordered sets.
+fn merge_object(b: &Object, c: &Object, e: &Object, at: &str) -> Result<Object, Error> {
+    if c == b {
+        return Ok(e.clone());
+    }
+    if e == b {
+        return Ok(c.clone());
+    }
+    let refs = |a: &[Object]| a.iter().map(Object::as_ref).collect::<Option<Vec<ObjRef>>>();
+    match (b, c, e) {
+        (Object::Dict(b), Object::Dict(c), Object::Dict(e)) => Ok(Object::Dict(merge_dict(b, c, e, at)?)),
+        (Object::Stream(b), Object::Stream(c), Object::Stream(e)) => {
+            let raw = if c.raw == b.raw {
+                e.raw.clone()
+            } else if e.raw == b.raw {
+                c.raw.clone()
+            } else {
+                return Err(conflict(format!("{at} (stream data)")));
+            };
+            Ok(Object::Stream(Stream { dict: merge_dict(&b.dict, &c.dict, &e.dict, at)?, raw }))
+        }
+        (Object::Array(b), Object::Array(c), Object::Array(e)) => match (refs(b), refs(c), refs(e)) {
+            (Some(b), Some(c), Some(e)) => Ok(Object::Array(merge_refs(&b, &c, &e, at)?.into_iter().map(Object::Ref).collect())),
+            _ => Err(conflict(at)),
+        },
+        _ => Err(conflict(at)),
+    }
+}
+
+/// Keys keep the base's order; keys either side added follow, by name.
+fn merge_dict(b: &Dict, c: &Dict, e: &Dict, at: &str) -> Result<Dict, Error> {
+    let added: BTreeSet<&Name> = c.iter().chain(e.iter()).map(|(k, _)| k).filter(|k| !b.contains(k)).collect();
+    let mut out = Dict::new();
+    for key in b.iter().map(|(k, _)| k).chain(added) {
+        let (vb, vc, ve) = (b.get(key), c.get(key), e.get(key));
+        let value = if ve == vb {
+            vc.cloned()
+        } else if vc == vb {
+            ve.cloned()
+        } else {
+            let at = format!("{at} /{}", String::from_utf8_lossy(key));
+            match (vb, vc, ve) {
+                (Some(vb), Some(vc), Some(ve)) => Some(merge_object(vb, vc, ve, &at)?),
+                // Both sides started the same list (a page's first comments): an empty one before.
+                (None, Some(vc @ Object::Array(_)), Some(ve @ Object::Array(_))) => Some(merge_object(&Object::Array(Vec::new()), vc, ve, &at)?),
+                _ => return Err(conflict(at)),
+            }
+        };
+        if let Some(v) = value {
+            out.set(key.clone(), v);
+        }
+    }
+    Ok(out)
+}
+
+/// References as a set: each side's additions and removals apply (the same one on both sides is a conflict), the
+/// order one side gave the rest stays, and additions follow the item before them (by number where both sides add at
+/// one place).
+fn merge_refs(b: &[ObjRef], c: &[ObjRef], e: &[ObjRef], at: &str) -> Result<Vec<ObjRef>, Error> {
+    let set = |a: &[ObjRef]| a.iter().copied().collect::<HashSet<ObjRef>>();
+    let (bs, cs, es) = (set(b), set(c), set(e));
+    if bs.len() != b.len() || cs.len() != c.len() || es.len() != e.len() {
+        return Err(conflict(at));
+    }
+    let (added_c, added_e) = (&cs - &bs, &es - &bs);
+    if !added_c.is_disjoint(&added_e) || !(&bs - &cs).is_disjoint(&(&bs - &es)) {
+        return Err(conflict(at));
+    }
+    let kept: HashSet<ObjRef> = bs.iter().filter(|r| cs.contains(r) && es.contains(r)).copied().collect();
+    let order = |a: &[ObjRef]| a.iter().filter(|r| kept.contains(r)).copied().collect::<Vec<_>>();
+    let (bo, co, eo) = (order(b), order(c), order(e));
+    let kept_order = if co == bo {
+        eo
+    } else if eo == bo {
+        co
+    } else {
+        return Err(conflict(format!("{at} (order)")));
+    };
+    let mut after: BTreeMap<Option<ObjRef>, Vec<ObjRef>> = BTreeMap::new();
+    for (side, added) in [(c, &added_c), (e, &added_e)] {
+        let mut previous = None;
+        for r in side {
+            if added.contains(r) {
+                after.entry(previous).or_default().push(*r);
+            }
+            if added.contains(r) || kept.contains(r) {
+                previous = Some(*r);
+            }
+        }
+    }
+    after.values_mut().for_each(|v| v.sort());
+    let mut out = Vec::with_capacity(kept.len() + added_c.len() + added_e.len());
+    let mut stack: Vec<ObjRef> = after.remove(&None).unwrap_or_default().into_iter().rev().collect();
+    let mut rest: Vec<ObjRef> = kept_order.into_iter().rev().collect();
+    while let Some(r) = stack.pop().or_else(|| rest.pop()) {
+        if let Some(children) = after.remove(&Some(r)) {
+            stack.extend(children.into_iter().rev());
+        }
+        out.push(r);
+    }
+    Ok(out)
+}
+
+/// The three-way merge of one PDF: `current` is the side not accepted yet (a proposal on the coordinator, this
+/// browser's unsent work on a receiver), and its new objects move when both sides added one under one number.
+fn merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+    let (b, mut c, e) = (read(base)?, read(current)?, read(edited)?);
+    if current == base {
+        return Ok(edited.clone());
+    }
+    if edited == base {
+        return Ok(current.clone());
+    }
+    if b.pdf != c.pdf || b.pdf != e.pdf {
+        return Err(conflict("the document (it was replaced)"));
+    }
+    let base = base_for(b.pdf)?;
+    renumber(&b, &e, &mut c, &base)?;
+    let numbers: BTreeSet<u32> = b.objects.keys().chain(c.objects.keys()).chain(e.objects.keys()).copied().collect();
+    let mut objects = BTreeMap::new();
+    for num in numbers {
+        let (vb, vc, ve) = (b.objects.get(&num), c.objects.get(&num), e.objects.get(&num));
+        let entry = if ve == vb {
+            vc.cloned()
+        } else if vc == vb {
+            ve.cloned()
+        } else {
+            let state = |v: Option<&Entry>| match v {
+                Some(entry) => entry.clone(),
+                None => Some((base.doc.generation(num), (*base.doc.try_get(num).unwrap_or_else(|_| Arc::new(Object::Null))).clone())),
+            };
+            let at = format!("object {num}");
+            match (state(vb), state(vc), state(ve)) {
+                (Some((_, ob)), Some((gc, oc)), Some((ge, oe))) if gc == ge => Some(Some((gc, merge_object(&ob, &oc, &oe, &at)?))),
+                _ => return Err(conflict(at)),
+            }
+        };
+        if let Some(entry) = entry {
+            objects.insert(num, entry);
+        }
+    }
+    let own = own_entries(base.doc.trailer());
+    let [tb, tc, te] = [&b.trailer, &c.trailer, &e.trailer].map(|t| t.clone().unwrap_or_else(|| own.clone()));
+    let trailer = merge_dict(&tb, &tc, &te, "the trailer")?;
+    let result = Shared { pdf: b.pdf, objects, trailer: (trailer != own).then_some(trailer), rewrite: c.rewrite || e.rewrite };
+    merged(&result, &base)
+}
+
+/// Why a document is not shared, if it isn't.
+fn refusal(doc: &pdfcraft_engine::Document) -> Option<String> {
+    let why = match doc.live_cos() {
+        None => "it can't be edited",
+        Some(cos) if cos.security().is_some() || cos.encryption_changed() => "it is encrypted",
+        Some(_) if doc.is_signed() => "it is signed",
+        Some(_) if doc.xfa.is_some() || doc.info.xfa.is_some() => "it has an XFA form",
+        Some(_) => return None,
+    };
+    Some(format!("This PDF can't be edited live: {why}. Live editing shares unencrypted, unsigned PDFs without XFA forms."))
+}
+
+/// The PDFs of a shared document, each `(id, the PDF with its id and name)`, in order of id; strictly.
+fn entries(document: &Value) -> Result<Vec<(u64, &Value)>, Error> {
+    let invalid = |what: &str| format!("Invalid shared document: {what}");
+    let map = document.as_object().ok_or_else(|| invalid("not an object"))?;
+    let list = map.get("documents").and_then(Value::as_array).filter(|_| map.len() == 1).ok_or_else(|| invalid("no list of documents"))?;
+    let mut out: Vec<(u64, &Value)> = Vec::with_capacity(list.len());
+    for v in list {
+        let id = v.get("id").and_then(Value::as_u64).filter(|n| *n < 1 << 53).ok_or_else(|| invalid("a document's id"))?;
+        if !v.get("name").is_some_and(Value::is_string) {
+            return Err(invalid("a document's name"));
+        }
+        if out.last().is_some_and(|(last, _)| *last >= id) {
+            return Err(invalid("documents out of order"));
+        }
+        out.push((id, v));
+    }
+    Ok(out)
+}
+
+/// The three-way merge of shared documents, PDF by PDF ([`merge`]; a name both sides changed is a conflict); a PDF
+/// one side added joins the set.
+fn merge_set(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+    if current == base {
+        return Ok(edited.clone());
+    }
+    if edited == base {
+        return Ok(current.clone());
+    }
+    let (b, c, e) = (entries(base)?, entries(current)?, entries(edited)?);
+    fn find<'a>(list: &[(u64, &'a Value)], id: u64) -> Option<&'a Value> {
+        list.iter().find(|(i, _)| *i == id).map(|(_, v)| *v)
+    }
+    let ids: BTreeSet<u64> = b.iter().chain(&c).chain(&e).map(|(id, _)| *id).collect();
+    let mut out = Vec::with_capacity(ids.len());
+    for id in ids {
+        let (vb, vc, ve) = (find(&b, id), find(&c, id), find(&e, id));
+        let entry = if ve == vb {
+            vc.cloned()
+        } else if vc == vb {
+            ve.cloned()
+        } else {
+            let (Some(vb), Some(vc), Some(ve)) = (vb, vc, ve) else { return Err(conflict(format!("document {id}"))) };
+            let name = if ve["name"] == vb["name"] {
+                &vc["name"]
+            } else if vc["name"] == vb["name"] {
+                &ve["name"]
+            } else {
+                return Err(conflict(format!("the name of document {id}")));
+            };
+            let mut merged = merge(vb, vc, ve)?;
+            (merged["id"], merged["name"]) = (id.into(), name.clone());
+            Some(merged)
+        };
+        out.extend(entry);
+    }
+    Ok(json!({ "documents": out }))
+}
+
+/// The session's id of the PDF in tab `tab`, while it is shared and the session connected.
+fn session_id(tab: DocId) -> Option<u64> {
+    STATE.with_borrow(|s| s.docs.iter().find(|d| d.tab == Some(tab) && !d.paused).map(|d| d.id)).filter(|_| playground_live::connected())
+}
+
+/// Whether `id` is a PDF of the session (Undo and Redo go to the session).
+pub(crate) fn shared(id: DocId) -> bool {
+    session_id(id).is_some()
+}
+
+/// Commands that act otherwise on a shared document while live: Undo and Redo go to the session (whatever this
+/// browser's own history holds), and Revert, which would take back everyone's edits, is off.
+pub(crate) fn command_enabled(app: &PdfCraftApp, id: &str) -> Option<bool> {
+    if app.combine_showing() || !app.active_ids().is_some_and(|(_, doc)| shared(doc)) {
+        return None;
+    }
+    match id {
+        "edit.undo" | "edit.redo" => Some(true),
+        "file.revert" => Some(false),
+        _ => None,
+    }
+}
+
+/// Undo or Redo of a shared document goes to the session: whether it did (the app's Undo then stops).
+pub(crate) fn undo(app: &PdfCraftApp, undo: bool) -> bool {
+    app.active_ids().is_some_and(|(_, id)| shared(id)) && playground_live::undo(!undo)
+}
+
+/// The end of each frame, after the others were drawn: the presence look's (name tags in PdfCraft's semibold), then
+/// the session's.
+pub(crate) fn frame(app: &mut PdfCraftApp) {
+    if let Some(ctx) = &app.ctx {
+        presence::set_font(crate::theme::semibold(12.0));
+        presence::end_frame(ctx);
+    }
+    STATE.with_borrow_mut(|s| (s.ctx.clone_from(&app.ctx), s.in_frame = true));
+    let tabs = STATE.with_borrow(|s| s.docs.iter().filter(|d| !d.paused).filter_map(|d| d.tab).collect());
+    pdfcraft_engine::live_playground::share(if playground_live::connected() { tabs } else { Vec::new() });
+    playground_live::frame(app);
+    STATE.with_borrow_mut(|s| s.in_frame = false);
+    // The shown PDF's pages and comments, which the others' marks refer to.
+    if let Some((_, id)) = app.active_ids().filter(|&(_, id)| shared(id)) {
+        ids(app, id);
+    }
+    if let Some(notice) = STATE.with_borrow_mut(|s| s.notice.take()) {
+        app.notify(notice);
+    }
+}
+
+/// Views of `id` after its graph changed from `before`: the reader's place and a selected comment that is still
+/// where it was stay. When the pages changed, everything else that points at a page index starts afresh.
+fn views_changed(app: &mut PdfCraftApp, id: DocId, before: Option<&Document>) {
+    let Some(doc) = app.session.get(id) else { return };
+    let pages = |cos: Option<&Document>| cos.map(|c| pdfcraft_model::pages(c).into_iter().map(|p| (p.obj, p.dict)).collect::<Vec<_>>());
+    let (old, new) = (pages(before), pages(doc.live_cos()));
+    let annot = |pages: &Option<Vec<(ObjRef, Dict)>>, cos: Option<&Document>, page: usize, index: usize| -> Option<ObjRef> {
+        let (_, dict) = pages.as_ref()?.get(page)?;
+        cos?.resolve(dict.get(b"Annots")?).as_array()?.get(index)?.as_ref()
+    };
+    let same_pages = old.as_ref().map(|o| o.iter().map(|p| p.0).collect::<Vec<_>>()) == new.as_ref().map(|n| n.iter().map(|p| p.0).collect());
+    for view in app.views.iter_mut().filter(|v| v.id == id) {
+        let kept = view
+            .comments
+            .selected
+            .filter(|&(page, index)| annot(&old, before, page, index).is_some_and(|r| annot(&new, doc.live_cos(), page, index) == Some(r)));
+        if same_pages {
+            view.document_changed(&doc.info);
+        } else {
+            view.document_replaced(&doc.info);
+        }
+        view.comments.selected = kept;
+    }
+}
+
+/// Brings the session's PDFs up to date with this page's tabs: the shown one when nothing is shared yet, each one
+/// opened since (a new PDF of the session), the latest graph of each open one, and which ones were closed here.
+fn register(app: &PdfCraftApp) {
+    let active = app.active_ids().map(|(_, id)| id);
+    STATE.with_borrow_mut(|s| {
+        let since = *s.since.get_or_insert_with(|| app.views.iter().map(|v| v.id.0 + 1).max().unwrap_or(0));
+        let (mut changed, mut notice) = (false, None);
+        for d in &mut s.docs {
+            let Some(tab) = d.tab else { continue };
+            let Some(doc) = app.session.get(tab) else {
+                d.tab = None;
+                changed = true;
+                continue;
+            };
+            if d.paused {
+                continue;
+            }
+            if let Some(why) = refusal(doc) {
+                d.paused = true;
+                notice = Some(format!("Live editing is paused for this PDF: your changes to it stay in this browser. {why}"));
+                changed = true;
+            } else if doc.edit_generation() != d.seen || doc.name != d.name {
+                if let Some(cos) = doc.live_cos() {
+                    d.last = cos.clone();
+                }
+                (d.seen, d.name) = (doc.edit_generation(), doc.name.clone());
+                changed = true;
+            }
+        }
+        let first = s.docs.is_empty();
+        let fresh: Vec<DocId> = (app.views.iter().map(|v| v.id))
+            .filter(|&id| (id.0 >= since || first && Some(id) == active) && !s.told.contains(&id) && !s.docs.iter().any(|d| d.tab == Some(id)))
+            .collect();
+        for tab in fresh {
+            let Some(doc) = app.session.get(tab) else { continue };
+            let opened = match (refusal(doc), doc.live_cos()) {
+                (None, Some(cos)) => base_of(cos.bytes().clone(), None).map(|base| (base, cos.clone())),
+                (why, _) => Err(why.unwrap_or_default()),
+            };
+            match opened {
+                Ok((base, last)) => {
+                    let id = new_id(&mut s.next);
+                    let at = s.docs.partition_point(|d| d.id < id);
+                    let (name, seen) = (doc.name.clone(), doc.edit_generation());
+                    s.docs.insert(at, Doc { id, name, tab: Some(tab), base, last, seen, paused: false });
+                    changed = true;
+                }
+                Err(why) => {
+                    s.told.insert(tab);
+                    notice = Some(why).filter(|w| !w.is_empty());
+                }
+            }
+        }
+        if changed {
+            s.revision += 1;
+        }
+        if notice.is_some() {
+            s.notice = notice;
+        }
+    });
+}
+
+/// A new id for a PDF of the session: [`playground_live::fresh_id`]'s random one, also before the session connects
+/// (two people's PDFs never share one).
+fn new_id(next: &mut u64) -> u64 {
+    let id = playground_live::fresh_id(next);
+    #[cfg(target_arch = "wasm32")]
+    if id < 1 << 52 {
+        return (1 << 52) | (js_sys::Math::random() * (1u64 << 52) as f64) as u64;
+    }
+    id
+}
+
+/// The shared document entry of `d`.
+fn entry(d: &Doc) -> Value {
+    let mut v = project(&d.last, &d.base);
+    (v["id"], v["name"]) = (d.id.into(), d.name.clone().into());
+    v
+}
+
+impl PdfCraftApp {
+    /// Opens a PDF of the session in a tab of its own, behind this person's.
+    fn live_open(&mut self, name: &str, base: &Base, cos: Document) -> Result<DocId, String> {
+        let bytes = base.doc.bytes().clone();
+        let prepared = self.session.prepare_open(name, None, bytes.clone(), None).map_err(|e| e.to_string())?;
+        let active = self.active;
+        let id = self.finish_open(name, None, bytes.len(), prepared, false)?;
+        self.active = active;
+        if let Err(e) = self.live_install(id, cos, base, name) {
+            // Shown as the file it was opened from: never this PDF of the session.
+            STATE.with_borrow_mut(|s| s.told.insert(id));
+            return Err(e);
+        }
+        Ok(id)
+    }
+
+    /// Puts the session's graph `cos` of a PDF in tab `tab` unless it is there already, with no undo step.
+    fn live_install(&mut self, tab: DocId, cos: Document, base: &Base, name: &str) -> Result<(), String> {
+        let Some(doc) = self.session.get(tab) else { return Ok(()) };
+        if doc.name != name {
+            self.session.live_rename(tab, name);
+        }
+        let before = self.session.get(tab).and_then(|d| d.live_cos()).cloned();
+        if before.as_ref().is_some_and(|b| project(b, base) == project(&cos, base)) {
+            return Ok(());
+        }
+        self.session.live_replace_graph(tab, cos).map_err(|e| e.to_string())?;
+        views_changed(self, tab, before.as_ref());
+        Ok(())
+    }
+}
+
+impl Live for PdfCraftApp {
+    /// `{"documents": [{"id", "name", ...PDF}]}`: every PDF of the session, open here or not.
+    fn live_document(&self) -> Value {
+        register(self);
+        STATE.with_borrow(|s| json!({ "documents": s.docs.iter().map(entry).collect::<Vec<_>>() }))
+    }
+
+    /// Each PDF goes into its tab here; one new to this browser opens in a tab behind this person's, one they closed
+    /// stays closed (and up to date). Joining, a tab showing the same file takes the session's PDF, and the session's
+    /// first PDF comes to the front unless this person already looks at one of them.
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        // Decoded before anything changes: (id, name, file, graph).
+        let mut plan = Vec::new();
+        for (id, v) in entries(&document)? {
+            let shared = read(v)?;
+            let base = base_for(shared.pdf)?;
+            let cos = build(&shared, &base);
+            plan.push((id, v["name"].as_str().unwrap_or_default().to_owned(), base, cos));
+        }
+        register(self);
+        let old = STATE.with_borrow_mut(|s| std::mem::take(&mut s.docs));
+        let joining = !plan.is_empty() && !plan.iter().any(|(id, ..)| old.iter().any(|d| d.id == *id));
+        let mut docs: Vec<Doc> = Vec::with_capacity(plan.len());
+        let mut failed = None;
+        for (id, name, base, cos) in plan {
+            let prev = old.iter().find(|d| d.id == id);
+            let same_file = || {
+                let tabs = old.iter().filter(|d| d.base.pdf.len() == base.pdf.len() && d.base.pdf == base.pdf).filter_map(|d| d.tab);
+                tabs.filter(|t| !docs.iter().any(|x| x.tab == Some(*t))).next()
+            };
+            let tab = match prev {
+                Some(p) => p.tab,
+                None if joining => same_file(),
+                None => None,
+            };
+            let paused = prev.is_some_and(|p| p.paused);
+            let tab = match tab.filter(|t| self.session.get(*t).is_some()) {
+                Some(t) if paused => Some(t),
+                Some(t) => {
+                    if let Err(e) = self.live_install(t, cos.clone(), &base, &name) {
+                        failed.get_or_insert(e);
+                    }
+                    Some(t)
+                }
+                // Closed here: it stays closed.
+                None if prev.is_some() => None,
+                None => self.live_open(&name, &base, cos.clone()).map_err(|e| failed.get_or_insert(e).clone()).ok(),
+            };
+            let seen = tab.and_then(|t| self.session.get(t)).map_or(0, |d| d.edit_generation());
+            docs.push(Doc { id, name, tab, base, last: cos, seen, paused });
+        }
+        let looking = self.active_ids().is_some_and(|(_, id)| docs.iter().any(|d| d.tab == Some(id)));
+        if joining
+            && !looking
+            && let Some(t) = docs.first().and_then(|d| d.tab)
+        {
+            self.active = self.views.iter().position(|v| v.id == t);
+        }
+        STATE.with_borrow_mut(|s| {
+            s.docs = docs;
+            s.revision += 1;
+        });
+        if let Some(ctx) = &self.ctx {
+            ctx.request_repaint();
+        }
+        failed.map_or(Ok(()), Err)
+    }
+
+    fn live_quiet(&self) -> bool {
+        let gesture = self.views.iter().any(|v| {
+            v.comments.gesture.is_some()
+                || v.comments.composer.is_some()
+                || v.comments.editing.is_some()
+                || v.line_editor.is_some()
+                || v.content.draft.is_some()
+                || v.fill_text.is_some()
+                || v.forms.focus.is_some()
+                || v.pending_edit.is_some()
+                || v.block_drag.is_some()
+                || v.org_drag.is_some()
+                || v.panel_drag.is_some()
+                || v.marquee.is_some()
+                || v.camera.is_some()
+        });
+        presence::quiet() && !gesture && !self.modal_open() && !self.palette_open
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        register(self);
+        Some(STATE.with_borrow(|s| s.revision))
+    }
+
+    fn live_disconnected(&mut self) {
+        for tab in STATE.with_borrow(|s| s.docs.iter().filter_map(|d| d.tab).collect::<Vec<_>>()) {
+            self.session.live_clear_history(tab);
+        }
+        pdfcraft_engine::live_playground::share(Vec::new());
+        STATE.with_borrow_mut(|s| *s = State { ctx: s.ctx.take(), ..State::default() });
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+        merge_set(base, current, edited)
+    }
+
+    /// The coordinator checks fully (each PDF once); a receiver's merge is checked by installing it (the same write
+    /// and inspection).
+    fn live_check(document: &Value) -> Result<(), Error> {
+        use std::hash::{Hash, Hasher};
+        let in_frame = STATE.with_borrow(|s| s.in_frame);
+        for (_, pdf) in entries(document)? {
+            if in_frame {
+                read(pdf)?;
+                continue;
+            }
+            let mut h = std::hash::DefaultHasher::new();
+            playground_live::canonical(pdf).hash(&mut h);
+            let key = h.finish();
+            if !STATE.with_borrow(|s| s.checked.contains(&key)) {
+                validate(pdf)?;
+                STATE.with_borrow_mut(|s| {
+                    if s.checked.len() > 256 {
+                        s.checked.clear();
+                    }
+                    s.checked.insert(key);
+                });
+            }
+        }
+        Ok(())
+    }
+
+    fn live_presence(&self) -> Value {
+        presence(self).unwrap_or(Value::Null)
+    }
+
+    /// Their marks ease by PDF and page ([`paint`]): who goes to another one shows there at once.
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        presence::show(others);
+    }
+}
+
+/// A comment as presence names it: its page, index in `/Annots`, rectangle in user space, whether it is an oval, and
+/// the boxes of the text it marks up (highlights and the like, outlined box by box as the app outlines its own).
+struct Annot {
+    page: usize,
+    index: usize,
+    rect: [f32; 4],
+    oval: bool,
+    boxes: Vec<[f32; 4]>,
+}
+
+/// A shared PDF's page and comment object numbers (what presence refers to), for one state of its graph.
+struct Ids {
+    doc: DocId,
+    generation: u64,
+    /// Each page's object number and geometry.
+    pages: Vec<(u32, pdfcraft_render::PageInfo)>,
+    annots: HashMap<u32, Annot>,
+}
+
+impl Ids {
+    fn annot_at(&self, page: usize, index: usize) -> Option<u32> {
+        self.annots.iter().find(|(_, a)| (a.page, a.index) == (page, index)).map(|(n, _)| *n)
+    }
+
+    fn page(&self, num: &Value) -> Option<usize> {
+        let num = num.as_u64()?;
+        self.pages.iter().position(|(p, _)| u64::from(*p) == num)
+    }
+}
+
+/// [`Ids`] of document `id` as it is now, read again only after a change.
+fn ids(app: &PdfCraftApp, id: DocId) -> Option<Rc<Ids>> {
+    let doc = app.session.get(id)?;
+    let generation = doc.edit_generation();
+    if let Some(ids) = STATE.with_borrow(|s| s.ids.clone()).filter(|i| i.doc == id && i.generation == generation) {
+        return Some(ids);
+    }
+    let cos = doc.live_cos()?;
+    let pages = pdfcraft_model::pages(cos);
+    let lists: Vec<Vec<Option<u32>>> = pages
+        .iter()
+        .map(|p| {
+            let list = p.dict.get(b"Annots").map(|a| cos.resolve(a));
+            list.and_then(|l| Some(l.as_array()?.iter().map(|o| o.as_ref().map(|r| r.num)).collect())).unwrap_or_default()
+        })
+        .collect();
+    let annots = (doc.info.annotations.iter())
+        .filter_map(|a| {
+            let num = lists.get(a.page)?.get(a.index).copied().flatten()?;
+            let markup = matches!(a.subtype.as_str(), "Highlight" | "Underline" | "StrikeOut" | "Squiggly");
+            let bbox = |q: &[f32; 8]| {
+                let (xs, ys) = ([q[0], q[2], q[4], q[6]], [q[1], q[3], q[5], q[7]]);
+                [xs.into_iter().fold(f32::MAX, f32::min), ys.into_iter().fold(f32::MAX, f32::min), xs.into_iter().fold(f32::MIN, f32::max), ys.into_iter().fold(f32::MIN, f32::max)]
+            };
+            let boxes = if markup { a.quads.iter().take(MAX_ITEMS).map(bbox).collect() } else { Vec::new() };
+            Some((num, Annot { page: a.page, index: a.index, rect: a.rect, oval: a.subtype == "Circle", boxes }))
+        })
+        .collect();
+    let pages = pages.iter().zip(&doc.info.pages).map(|(p, info)| (p.obj.num, info.clone())).collect();
+    let ids = Rc::new(Ids { doc: id, generation, pages, annots });
+    STATE.with_borrow_mut(|s| s.ids = Some(ids.clone()));
+    Some(ids)
+}
+
+/// The most points of a stroke, items of a list and characters of typed text a presence holds.
+const MAX_POINTS: usize = 200;
+const MAX_ITEMS: usize = 50;
+const MAX_TEXT: usize = 200;
+/// The most bytes of a presence (the shell sends at most 4 KiB).
+const MAX_BYTES: usize = 4000;
+
+/// User-space numbers to a tenth (of a point: below a pixel at any usual zoom), so a presence stays small.
+fn tenth(x: impl Into<f64>) -> f64 {
+    (x.into() * 10.0).round() / 10.0
+}
+
+fn rect_value(r: [f32; 4]) -> Value {
+    json!([tenth(r[0].min(r[2])), tenth(r[1].min(r[3])), tenth(r[0].max(r[2])), tenth(r[1].max(r[3]))])
+}
+
+/// This person's presence on the shown PDF: the page of their gesture (else under the pointer, else the current one),
+/// the pointer in its user space, the selected comment, and the gesture under way ([`Live::live_presence`]).
+fn presence(app: &PdfCraftApp) -> Option<Value> {
+    use crate::comments::{CommentTool as T, Gesture};
+    let (i, id) = app.active_ids()?;
+    let doc_id = session_id(id)?;
+    let (ids, view, doc) = (ids(app, id)?, app.views.get(i)?, app.session.get(id)?);
+    let info = &doc.info;
+    let ctx = app.ctx.as_ref();
+    let latest = ctx.and_then(|ctx| ctx.pointer_hover_pos());
+    let hover = latest.filter(|p| !view.organize && view.viewport_rect().contains(*p));
+    let gesture = view.comments.gesture.as_ref();
+    let pressed = ctx.is_some_and(|ctx| ctx.input(|i| i.pointer.primary_down()));
+    let text = view.selection_quads(info).filter(|_| pressed && gesture.is_none());
+    let page = match gesture {
+        Some(Gesture::Draw { page, .. } | Gesture::Move { page, .. } | Gesture::Resize { page, .. }) => *page,
+        _ => (text.as_ref().map(|(page, _)| *page))
+            .or_else(|| hover.and_then(|p| view.visible_page_rects().into_iter().find(|(_, r)| r.contains(p)).map(|(page, _)| page)))
+            .unwrap_or(view.current),
+    };
+    let (num, page_info) = ids.pages.get(page)?;
+    let selected = view.comments.selected.and_then(|(page, index)| ids.annot_at(page, index));
+    let mut state = json!({ "doc": doc_id, "page": num, "selection": selected.into_iter().collect::<Vec<_>>() });
+    let xf = view.page_xform(page);
+    let user = |p: Pos2| {
+        let (x, y) = xf?.screen_to_view(p);
+        Some(page_info.view_to_user(x, y))
+    };
+    if let Some([x, y]) = hover.and_then(user) {
+        state["pointer"] = json!([tenth(x), tenth(y)]);
+    }
+    let zoom = xf.map_or(1.0, |xf| xf.rect.width() / xf.pw.max(1.0)).max(1e-3);
+    match gesture {
+        Some(Gesture::Draw { tool, points, .. }) => {
+            let name = match tool {
+                T::Ink => "ink",
+                T::Eraser => "eraser",
+                T::Line => "line",
+                T::Arrow => "arrow",
+                T::Rectangle => "rect",
+                T::Oval => "oval",
+                T::Polygon => "polygon",
+                T::PolyLine => "polyline",
+                T::Cloud => "cloud",
+                T::Callout => "callout",
+                _ => "",
+            };
+            // Points closer than a pixel apart go, but the newest stays; clicked vertices end at the pointer.
+            let min = 1.0 / f64::from(zoom);
+            let mut kept: Vec<[f64; 2]> = Vec::new();
+            for (k, p) in points.iter().enumerate().filter(|(_, p)| p.iter().all(|v| v.is_finite())) {
+                if k + 1 == points.len() || kept.last().is_none_or(|q| (q[0] - p[0]).hypot(q[1] - p[1]) >= min) {
+                    kept.push(*p);
+                }
+            }
+            if tool.clicks_points()
+                && let Some([x, y]) = latest.and_then(user)
+            {
+                kept.push([x.into(), y.into()]);
+            }
+            let newest = &kept[kept.len().saturating_sub(MAX_POINTS)..];
+            let width = if *tool == T::Eraser { 12.0 / f64::from(zoom) } else { app.comment_prefs.style(*tool).width };
+            if !name.is_empty() && !newest.is_empty() {
+                let points: Vec<Value> = newest.iter().map(|p| json!([tenth(p[0]), tenth(p[1])])).collect();
+                state["draw"] = json!({ "tool": name, "points": points, "width": tenth(width) });
+            }
+        }
+        Some(&Gesture::Move { page, index, from }) | Some(&Gesture::Resize { page, index, from, .. }) => {
+            let a = info.annotations.iter().find(|a| (a.page, a.index) == (page, index));
+            if let (Some(a), Some(xf), Some(p), Some(n)) = (a, xf, latest, ids.annot_at(page, index)) {
+                let r = xf.user_rect(info, page, a.rect);
+                let r = match gesture {
+                    Some(&Gesture::Resize { handle, aspect_ratio, .. }) => {
+                        let shift = ctx.is_some_and(|ctx| ctx.input(|i| i.modifiers.shift));
+                        let ratio = aspect_ratio.or((shift && r.width() > 0.0 && r.height() > 0.0).then(|| r.width() / r.height()));
+                        resized(r, handle, p - from, ratio)
+                    }
+                    _ => r.translate(p - from),
+                };
+                if let (Some(a), Some(b)) = (user(r.left_top()), user(r.right_bottom())) {
+                    state["ghost"] = json!({ "id": n, "rect": rect_value([a[0], a[1], b[0], b[1]]) });
+                }
+            }
+        }
+        _ => {}
+    }
+    if let Some((_, quads)) = &text {
+        let bbox = |q: &[f64; 8]| {
+            let (xs, ys) = ([q[0], q[2], q[4], q[6]], [q[1], q[3], q[5], q[7]]);
+            let (min, max) = (|v: [f64; 4]| v.into_iter().fold(f64::MAX, f64::min), |v: [f64; 4]| v.into_iter().fold(f64::MIN, f64::max));
+            json!([tenth(min(xs)), tenth(min(ys)), tenth(max(xs)), tenth(max(ys))])
+        };
+        state["text"] = quads.iter().take(MAX_ITEMS).map(bbox).collect();
+    }
+    if let Some((page, rect, typed)) = typing(view, doc).filter(|(.., t)| !t.is_empty())
+        && let Some((num, _)) = ids.pages.get(page)
+    {
+        let n = typed.chars().count();
+        let end: String = typed.chars().skip(n.saturating_sub(MAX_TEXT)).collect();
+        state["typing"] = json!({ "page": num, "rect": rect_value(rect), "text": end });
+    }
+    // Within what the shell sends: the oldest points go first.
+    while state.to_string().len() > MAX_BYTES {
+        match state["draw"]["points"].as_array_mut() {
+            Some(points) if points.len() > 2 => drop(points.drain(..points.len() / 2)),
+            _ => {
+                state.as_object_mut()?.remove("typing");
+                state.as_object_mut()?.remove("text");
+                if state.to_string().len() > MAX_BYTES {
+                    return None;
+                }
+            }
+        }
+    }
+    Some(state)
+}
+
+/// A comment's box on screen `r` resized by dragging its `handle` by `d`, as the app resizes it: from a corner, the
+/// proportions `ratio` (the box's own, or its current ones while Shift is held) stay.
+fn resized(r: Rect, (hx, hy): (i8, i8), d: egui::Vec2, ratio: Option<f32>) -> Rect {
+    let (sx, sy) = (f32::from(hx), f32::from(hy));
+    if hx != 0
+        && hy != 0
+        && let Some(ratio) = ratio.filter(|v| v.is_finite() && *v > 0.0)
+    {
+        let width = (r.width() + sx * d.x).max((r.height() + sy * d.y) * ratio).max(4.0).max(4.0 * ratio);
+        let anchor = pos2(if hx < 0 { r.right() } else { r.left() }, if hy < 0 { r.bottom() } else { r.top() });
+        return Rect::from_two_pos(anchor, anchor + vec2(sx * width, sy * width / ratio));
+    }
+    let mut r = r;
+    match hx {
+        -1 => r.min.x += d.x,
+        1 => r.max.x += d.x,
+        _ => {}
+    }
+    match hy {
+        -1 => r.min.y += d.y,
+        1 => r.max.y += d.y,
+        _ => {}
+    }
+    Rect::from_two_pos(r.min, r.max)
+}
+
+/// Text being typed in `view`: its page, where (a user-space rectangle, or a point as one) and the text so far, in a
+/// new comment, a comment edited in the Comments panel, a form field, Fill & Sign text, added text or a paragraph being
+/// edited.
+fn typing<'a>(view: &'a DocView, doc: &'a pdfcraft_engine::Document) -> Option<(usize, [f32; 4], &'a str)> {
+    let at = |p: [f64; 2]| [p[0] as f32, p[1] as f32, p[0] as f32, p[1] as f32];
+    let rect = |r: [f64; 4]| r.map(|v| v as f32);
+    if let Some(c) = &view.comments.composer {
+        return Some((c.page, at(c.at), &c.text));
+    }
+    if let Some((page, index, text)) = &view.comments.editing {
+        let a = doc.info.annotations.iter().find(|a| (a.page, a.index) == (*page, *index))?;
+        return Some((*page, a.rect, text));
+    }
+    if let Some(t) = &view.fill_text {
+        return Some((t.page, at(t.at), &t.text));
+    }
+    if let Some(f) = &view.forms.focus {
+        let w = doc.form.iter().find(|x| x.name == f.name)?.widgets.get(f.widget)?;
+        return Some((w.page?, rect(w.rect), &f.text));
+    }
+    if let Some(d) = &view.content.draft {
+        // Display space: view space with y up.
+        let p = doc.info.pages.get(d.page)?;
+        let h = f64::from(p.height);
+        let (a, b) = (p.view_to_user(d.rect[0] as f32, (h - d.rect[3]) as f32), p.view_to_user(d.rect[2] as f32, (h - d.rect[1]) as f32));
+        return Some((d.page, [a[0], a[1], b[0], b[1]], &d.text));
+    }
+    let e = view.line_editor.as_ref()?;
+    Some((e.page, rect(view.edit_lines.get(&e.page)?.1.get(e.block)?.rect), &e.text))
+}
+
+/// Coordinates beyond this are not drawn (remote data).
+const FAR_OUT: f64 = 1e6;
+/// Selected text's fill and a live stroke, in the person's colour at these opacities (the kit's ghost fill, and
+/// PdfCraft's own stroke).
+const GHOST: f32 = 0.28;
+const LIVE_STROKE: f32 = 0.7;
+
+/// `N` numbers in range, or none.
+fn numbers<const N: usize>(v: &Value) -> Option<[f64; N]> {
+    let items = v.as_array().filter(|a| a.len() == N)?;
+    let mut out = [0.0; N];
+    for (o, x) in out.iter_mut().zip(items) {
+        *o = x.as_f64().filter(|x| x.abs() < FAR_OUT)?;
+    }
+    Some(out)
+}
+
+/// A person's mark `key` eased toward `target` (user space of their page; `zoom` points a unit, a jump past `far`
+/// points goes at once), by PDF and page: someone gone to another page shows there at once.
+fn eased<const N: usize>(ctx: &egui::Context, o: &Presence, key: &str, target: [f64; N], zoom: f64, far: f64) -> Option<[f64; N]> {
+    presence::ease(ctx, &o.id, &format!("{key} {} {}", o.state["doc"], o.state["page"]), target, [zoom; N], [far; N])
+}
+
+/// The oval in `r`, as 64 points.
+fn ring(r: Rect) -> Vec<Pos2> {
+    (0..64)
+        .map(|i| std::f32::consts::TAU * i as f32 / 64.0)
+        .map(|t| r.center() + vec2(t.cos() * r.width() / 2.0, t.sin() * r.height() / 2.0))
+        .collect()
+}
+
+/// Draws the others on the PDF `view` shows, on its pages, in the session's look ([`presence`]; after the pages, the
+/// find bar and every popup come after): their drawings under way, moved comments' ghosts and selected text, then
+/// their selected comments outlined, then what they type, then their pointers with their names, each in their colour
+/// and eased toward their latest presence.
+pub(crate) fn paint(view: &DocView, area: Rect, ui: &egui::Ui) {
+    if !playground_live::connected() {
+        return;
+    }
+    let ctx = ui.ctx();
+    let shown = STATE.with_borrow(|s| Some((s.docs.iter().find(|d| d.tab == Some(view.id) && !d.paused)?.id, s.ids.clone().filter(|i| i.doc == view.id)?)));
+    let Some((doc, ids)) = shown else { return };
+    let others: Vec<Presence> = presence::others().into_iter().filter(|o| o.state["doc"].as_u64() == Some(doc)).collect();
+    let painter = ui.painter().with_clip_rect(area);
+    let far = area.height() / 4.0;
+    // Who is here, on which page, where that page is drawn and at what zoom.
+    let here: Vec<(&Presence, usize, crate::canvas::PageXform, f32)> = (others.iter())
+        .filter_map(|o| {
+            let page = ids.page(&o.state["page"])?;
+            let xf = view.page_xform(page)?;
+            let zoom = (xf.rect.width() / xf.pw.max(1.0)).max(1e-3);
+            Some((o, page, xf, zoom))
+        })
+        .collect();
+    let at = |page: usize, xf: &crate::canvas::PageXform, [x, y]: [f64; 2]| -> Option<Pos2> {
+        let v = ids.pages.get(page)?.1.user_to_view(x as f32, y as f32);
+        Some(xf.norm_to_screen(v[0] / xf.pw, v[1] / xf.ph))
+    };
+    let screen_rect = |page: usize, xf: &crate::canvas::PageXform, r: [f64; 4]| Some(Rect::from_two_pos(at(page, xf, [r[0], r[1]])?, at(page, xf, [r[2], r[3]])?));
+    for &(o, page, ref xf, zoom) in &here {
+        let (state, color) = (&o.state, presence::color(o));
+        if let Some(draw) = state["draw"].as_object() {
+            let points = draw["points"].as_array().into_iter().flatten().take(MAX_POINTS);
+            let mut pts: Vec<Pos2> = points.filter_map(|p| at(page, xf, numbers::<2>(p)?)).collect();
+            // The newest point eases.
+            let tip = draw["points"].as_array().and_then(|p| p.last()).and_then(numbers::<2>).and_then(|t| eased(ctx, o, "tip", t, zoom.into(), far.into()));
+            if let (Some(last), Some(tip)) = (pts.last_mut(), tip.and_then(|t| at(page, xf, t))) {
+                *last = tip;
+            }
+            let width = draw["width"].as_f64().filter(|w| (0.0..1000.0).contains(w)).unwrap_or(1.0) as f32;
+            match (draw["tool"].as_str().unwrap_or_default(), pts.as_slice()) {
+                ("ink" | "eraser", _) => {
+                    painter.add(Shape::line(pts, Stroke::new((width * zoom).max(2.0), color.gamma_multiply(LIVE_STROKE))));
+                }
+                ("rect", &[a, b]) => {
+                    let r = Rect::from_two_pos(a, b);
+                    presence::dashed(&painter, &[r.left_top(), r.right_top(), r.right_bottom(), r.left_bottom()], true, color);
+                }
+                ("oval", &[a, b]) => {
+                    presence::dashed(&painter, &ring(Rect::from_two_pos(a, b)), true, color);
+                }
+                ("line" | "arrow" | "callout", &[a, b]) => {
+                    presence::dashed(&painter, &[a, b], false, color);
+                    if draw["tool"] == "arrow" && a.distance(b) > 1.0 {
+                        let (d, s) = ((a - b).normalized(), (6.0 + 3.0 * width) * zoom);
+                        let turn = |v: egui::Vec2, t: f32| vec2(v.x * t.cos() - v.y * t.sin(), v.x * t.sin() + v.y * t.cos());
+                        presence::dashed(&painter, &[b + turn(d, 0.52) * s, b, b + turn(d, -0.52) * s], false, color);
+                    }
+                    if draw["tool"] == "callout" {
+                        let r = Rect::from_min_size(b, vec2(160.0, 40.0) * zoom);
+                        presence::dashed(&painter, &[r.left_top(), r.right_top(), r.right_bottom(), r.left_bottom()], true, color);
+                    }
+                }
+                ("polygon" | "polyline" | "cloud", _) => presence::dashed(&painter, &pts, false, color),
+                _ => {}
+            }
+        }
+        let ghost = ids.annots.get(&state["ghost"]["id"].as_u64().and_then(|n| u32::try_from(n).ok()).unwrap_or(0));
+        let rect = numbers::<4>(&state["ghost"]["rect"]).and_then(|r| eased(ctx, o, "ghost", r, zoom.into(), far.into()));
+        if let (Some(a), Some(r)) = (ghost, rect.and_then(|r| screen_rect(page, xf, r))) {
+            match a.oval {
+                true => presence::ghost_shape(&painter, &ring(r), color),
+                false => presence::ghost(&painter, r, color),
+            }
+        }
+        for r in state["text"].as_array().into_iter().flatten().take(MAX_ITEMS).filter_map(|r| screen_rect(page, xf, numbers::<4>(r)?)) {
+            painter.rect_filled(r, 1.0, color.gamma_multiply(GHOST));
+        }
+    }
+    // Their selected comments, on whichever shown page they are, where they were (a moved one's ghost is above).
+    for o in &others {
+        let numbers = o.state["selection"].as_array().into_iter().flatten().take(MAX_ITEMS).filter_map(Value::as_u64);
+        for a in numbers.filter_map(|n| ids.annots.get(&u32::try_from(n).ok()?)) {
+            let Some(xf) = view.page_xform(a.page) else { continue };
+            let boxes = if a.boxes.is_empty() { std::slice::from_ref(&a.rect) } else { &a.boxes[..] };
+            for r in boxes.iter().filter_map(|r| screen_rect(a.page, &xf, r.map(f64::from))) {
+                // 2 px, from 1 to 3 px outside the comment.
+                presence::outline(&painter, r.expand(3.0), presence::color(o));
+            }
+        }
+    }
+    // What they type, in a tag above where it goes.
+    for o in &others {
+        let t = &o.state["typing"];
+        let (Some(page), Some(r), Some(text)) = (ids.page(&t["page"]), numbers::<4>(&t["rect"]), t["text"].as_str()) else { continue };
+        let Some(r) = view.page_xform(page).and_then(|xf| screen_rect(page, &xf, r)) else { continue };
+        let n = text.chars().count();
+        let end: String = text.chars().skip(n.saturating_sub(40)).map(|c| if c.is_control() { ' ' } else { c }).collect();
+        let shown = if n > 40 { format!("…{end}") } else { end };
+        let size = presence::label_size(&painter, &shown);
+        presence::label(&painter, r.left_top() - vec2(0.0, size.y + 4.0), presence::color(o), &shown);
+    }
+    for &(o, page, ref xf, zoom) in &here {
+        let pointer = numbers::<2>(&o.state["pointer"]).and_then(|p| eased(ctx, o, "pointer", p, zoom.into(), far.into()));
+        if let Some(tip) = pointer.and_then(|p| at(page, xf, p)).filter(|t| area.expand(20.0).contains(*t)) {
+            presence::cursor(&painter, tip, presence::color(o), &o.name);
+        }
+    }
+}
+
+/// The others in a PDF of the session: their colours, at most four.
+fn on(doc: u64) -> Vec<Color32> {
+    presence::others().iter().filter(|o| o.state["doc"].as_u64() == Some(doc)).take(4).map(presence::color).collect()
+}
+
+/// Dots in the colours of the others on the PDF in tab `i` (drawn at `tab`, right after the tab strip draws it), in
+/// its top right corner above the close button.
+pub(crate) fn tab_dots(app: &PdfCraftApp, ui: &egui::Ui, i: usize, tab: Rect) {
+    let Some(doc) = app.views.get(i).and_then(|v| session_id(v.id)) else { return };
+    for (k, color) in on(doc).into_iter().enumerate() {
+        ui.painter().circle(pos2(tab.right() - 16.0 - 9.0 * k as f32, tab.top() + 6.0), 3.5, color, Stroke::new(1.0, Color32::WHITE));
+    }
+}
+
+/// Home's "In this session" (in a session, above Recent): a row for each PDF of the session, with dots in the colours
+/// of the others on it; a click goes to it, opening it again when this person closed it.
+pub(crate) fn session_list(app: &mut PdfCraftApp, ui: &mut egui::Ui) {
+    use crate::theme::{self, Tokens};
+    if !playground_live::connected() {
+        return;
+    }
+    register(app);
+    let rows: Vec<(u64, String, Option<DocId>)> = STATE.with_borrow(|s| s.docs.iter().map(|d| (d.id, d.name.clone(), d.tab)).collect());
+    if rows.is_empty() {
+        return;
+    }
+    let t = Tokens::get(ui.ctx());
+    ui.label(egui::RichText::new("In this session").font(theme::semibold(17.0)));
+    ui.add_space(8.0);
+    let mut chosen = None;
+    for (id, name, tab) in rows {
+        let (rect, resp) = ui.allocate_exact_size(vec2(ui.available_width(), 46.0), egui::Sense::click());
+        resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, &name));
+        let press = theme::Press::track(ui, &resp);
+        press.wash(ui, rect, 8, false);
+        let body = rect.translate(press.offset());
+        crate::icons::paint(ui, Rect::from_min_size(body.min + vec2(10.0, 11.0), vec2(24.0, 24.0)), "file-text", 22.0, Color32::from_rgb(0xE0, 0x3E, 0x3E));
+        let dots = on(id);
+        for (k, color) in dots.iter().enumerate() {
+            ui.painter().circle(pos2(body.right() - 20.0 - 11.0 * k as f32, body.center().y), 4.0, *color, Stroke::new(1.0, Color32::WHITE));
+        }
+        let width = body.right() - 36.0 - 11.0 * dots.len() as f32 - (body.left() + 46.0);
+        let detail = if tab.is_some() { "Open in a tab" } else { "Closed here: open it again" };
+        crate::widgets::row_text(ui, body.min + vec2(46.0, 15.0), &name, theme::medium(13.5), t.text, width);
+        crate::widgets::row_text(ui, body.min + vec2(46.0, 32.0), detail, theme::regular(11.0), t.text_faint, width);
+        if theme::hand(resp).on_hover_text(if tab.is_some() { "Go to it" } else { "Open it again" }).clicked() {
+            chosen = Some((id, tab));
+        }
+    }
+    ui.add_space(26.0);
+    let Some((id, tab)) = chosen else { return };
+    let tab = match tab {
+        Some(tab) => Some(tab),
+        None => {
+            let found = STATE.with_borrow(|s| s.docs.iter().find(|d| d.id == id).map(|d| (d.name.clone(), d.base.clone(), d.last.clone())));
+            let Some((name, base, last)) = found else { return };
+            match app.live_open(&name, &base, last) {
+                Ok(tab) => {
+                    let seen = app.session.get(tab).map_or(0, |d| d.edit_generation());
+                    STATE.with_borrow_mut(|s| s.docs.iter_mut().filter(|d| d.id == id).for_each(|d| (d.tab, d.seen) = (Some(tab), seen)));
+                    Some(tab)
+                }
+                Err(e) => {
+                    app.notify(format!("Couldn't open {name}: {e}"));
+                    None
+                }
+            }
+        }
+    };
+    if let Some(i) = tab.and_then(|tab| app.views.iter().position(|v| v.id == tab)) {
+        app.active = Some(i);
+    }
+}
