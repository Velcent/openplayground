+    /// `pdf` (one PDF of a shared document) after `edits` in a browser of its own.
+    fn edited_pdf(pdf: &Value, edits: Vec<Edit>) -> Value {
+        let (shared, base) = (read(pdf).unwrap(), base_for(pdf["pdf"].as_str().unwrap()).unwrap());
+        let mut session = Session::new();
+        let id = session.open("other.pdf", None, base.doc.bytes().clone(), None).unwrap();
+        session.live_replace_graph(id, build(&shared, &base)).unwrap();
+        for edit in edits {
+            session.apply(id, edit).unwrap();
+        }
+        let mut out = project(session.get(id).unwrap().live_cos().unwrap(), &base);
+        for key in ["id", "name"] {
+            if let Some(v) = pdf.get(key) {
+                out[key] = v.clone();
+            }
+        }
+        out
+    }
+
+    /// The shared document `doc` after `edits` to its PDF number `i`, in a browser of its own.
+    fn edited_at(doc: &Value, i: usize, edits: Vec<Edit>) -> Value {
+        let mut doc = doc.clone();
+        doc["documents"][i] = edited_pdf(&doc["documents"][i], edits);
+        doc
+    }
+
+    /// The shared document `doc` after `edits` to its first PDF.
+    fn edited(doc: &Value, edits: Vec<Edit>) -> Value {
+        edited_at(doc, 0, edits)
+    }
+
+    /// The shared document `doc` with `pdf` added (by its id).
+    fn with(doc: &Value, pdf: Value) -> Value {
+        let mut list = doc["documents"].as_array().unwrap().clone();
+        list.push(pdf);
+        list.sort_by_key(|d| d["id"].as_u64());
+        json!({ "documents": list })
+    }
+
+    /// A blank PDF of `pages` pages as a PDF of the session, `id` named `name`.
+    fn named(pages: usize, id: u64, name: &str) -> Value {
+        let mut pdf = blank(pages);
+        (pdf["id"], pdf["name"]) = (id.into(), name.into());
+        pdf
+    }
+
+    /// A blank PDF of `pages` pages, as a shared document.
+    fn blank(pages: usize) -> Value {
+        let bytes = Session::new().create_blank(200.0, 200.0, pages).unwrap();
+        project(&Document::open(bytes.clone()).unwrap(), &base_of(bytes, None).unwrap())
+    }
+
+    /// Delivers an accepted change the way the shell does, then runs a frame.
+    fn receive(app: &mut PdfCraftApp, before: &Value, after: &Value) -> Option<Result<Option<Vec<u8>>, Error>> {
+        let done = std::rc::Rc::new(std::cell::RefCell::new(None));
+        let to = done.clone();
+        queue(Some(canonical(before)), canonical(after), Box::new(move |r| *to.borrow_mut() = Some(r)));
+        frame(app);
+        done.take()
+    }
