+    /// A random edit of `doc`, changing the graph the way PdfCraft's edits do (new objects from the allocator).
+    fn random_edit(doc: &Value, rng: &mut u64, tag: &str) -> Value {
+        let mut next = |n: usize| {
+            (*rng ^= *rng << 13, *rng ^= *rng >> 7, *rng ^= *rng << 17);
+            (*rng % n as u64) as usize
+        };
+        let (shared, base) = (read(doc).unwrap(), base_for(doc["pdf"].as_str().unwrap()).unwrap());
+        let mut cos = build(&shared, &base);
+        let pages = pdfcraft_model::pages(&cos);
+        let page = pages[next(pages.len())].obj;
+        let annots: Vec<ObjRef> = cos
+            .dict(&Object::Ref(page))
+            .and_then(|d| Some(d.get(b"Annots")?.as_array()?.iter().filter_map(Object::as_ref).collect()))
+            .unwrap_or_default();
+        let pick = next(4);
+        if pick == 0 {
+            cos.update_dict(page, |d| d.set(b"Rotate".to_vec(), (d.int(b"Rotate").unwrap_or(0) + 90) % 360)).unwrap();
+        } else if pick == 1 || annots.is_empty() {
+            let note: Dict = [
+                (b"Type".to_vec(), Object::name("Annot")),
+                (b"Subtype".to_vec(), Object::name("Text")),
+                (b"Contents".to_vec(), pdfcraft_cos::PdfString::text(tag).into()),
+                (b"P".to_vec(), page.into()),
+            ]
+            .into_iter()
+            .collect();
+            let r = cos.add(note);
+            cos.update_dict(page, |d| {
+                let mut list = d.get(b"Annots").and_then(Object::as_array).cloned().unwrap_or_default();
+                list.push(r.into());
+                d.set(b"Annots".to_vec(), list);
+            })
+            .unwrap();
+        } else if pick == 2 {
+            let gone = annots[next(annots.len())];
+            cos.update_dict(page, |d| d.set(b"Annots".to_vec(), annots.iter().filter(|r| **r != gone).map(|r| Object::Ref(*r)).collect::<Vec<_>>()))
+                .unwrap();
+            cos.free(gone);
+        } else {
+            cos.update_dict(annots[next(annots.len())], |d| d.set(b"Contents".to_vec(), pdfcraft_cos::PdfString::text(tag))).unwrap();
+        }
+        project(&cos, &base)
+    }
+
+    /// Peers edit at random; the coordinator rebases each proposal over later entries with merge(before, proposal,
+    /// entry) and checks it, receivers rebase unsent work with merge(before, local, entry). A peer whose own entry
+    /// comes back while it made no further edits must hold exactly that entry (otherwise it would propose a phantom
+    /// change), and once everything is sent every peer holds the head. LIVE_SIM_ROUNDS sets the length.
+    #[test]
+    fn peers_rebasing_stepwise_reach_the_coordinators_bytes() {
+        struct Peer {
+            live: Value,
+            acked: usize,
+            /// The proposal in flight: whether the live document holds it unchanged since (no edit, no restore), and
+            /// whether it holds it at all (a conflict restores the accepted document).
+            inflight: Option<(bool, bool)>,
+            inbox: std::collections::VecDeque<usize>,
+        }
+        let rounds: usize = std::env::var("LIVE_SIM_ROUNDS").ok().and_then(|n| n.parse().ok()).unwrap_or(600);
+        let start = blank(2);
+        let mut journal = vec![(start.clone(), usize::MAX)];
+        let mut peers: Vec<Peer> = (0..3).map(|_| Peer { live: start.clone(), acked: 0, inflight: None, inbox: Default::default() }).collect();
+        let mut queue: std::collections::VecDeque<(usize, usize, Value)> = Default::default();
+        let (mut rng, mut seq) = (std::env::var("LIVE_SIM_SEED").ok().and_then(|n| n.parse().ok()).unwrap_or(0x9E37_79B9_7F4A_7C15u64), 0);
+        let (mut accepted, mut rejected, mut divergences) = (0, 0, 0);
+        RENUMBERED.set(0);
+        let mut step = |peers: &mut Vec<Peer>,
+                        queue: &mut std::collections::VecDeque<_>,
+                        journal: &mut Vec<(Value, usize)>,
+                        action: usize,
+                        p: usize,
+                        rng: &mut u64| match action {
+            0 => {
+                seq += 1;
+                let peer = &mut peers[p];
+                peer.live = random_edit(&peer.live, rng, &format!("{p}.{seq}"));
+                if let Some((unchanged, _)) = peer.inflight.as_mut() {
+                    *unchanged = false;
+                }
+            }
+            1 => {
+                let peer = &mut peers[p];
+                if peer.inflight.is_none() && peer.live != journal[peer.acked].0 {
+                    peer.inflight = Some((true, true));
+                    queue.push_back((p, peer.acked, peer.live.clone()));
+                }
+            }
+            2 => {
+                let Some((author, base, proposal)) = queue.pop_front() else { return };
+                let rebased = merge(&journal[base].0, &journal[base].0, &proposal)
+                    .and_then(|first| (base + 1..journal.len()).try_fold(first, |next, i| merge(&journal[i - 1].0, &next, &journal[i].0)));
+                match rebased.and_then(|next| validate(&next).map(|()| next)) {
+                    Ok(next) => {
+                        journal.push((next, author));
+                        peers.iter_mut().for_each(|peer| peer.inbox.push_back(journal.len() - 1));
+                        accepted += 1;
+                    }
+                    Err(_) => {
+                        // The shell's reject: unsent work in the live document goes back to the acknowledged one.
+                        let peer = &mut peers[author];
+                        if peer.inflight.take().is_some_and(|(_, in_live)| in_live) {
+                            peer.live = journal[peer.acked].0.clone();
+                        }
+                        rejected += 1;
+                    }
+                }
+            }
+            _ => {
+                let peer = &mut peers[p];
+                let Some(revision) = peer.inbox.pop_front() else { return };
+                let (after, author) = &journal[revision];
+                let own = (*author == p).then(|| peer.inflight.take()).flatten();
+                if let Some((unchanged, true)) = own {
+                    if unchanged && peer.live != *after {
+                        divergences += 1;
+                    }
+                } else {
+                    // The shell's apply(before, after), whose merge returns `after` when nothing is unsent.
+                    peer.live = merge(&journal[peer.acked].0, &peer.live, after).unwrap_or_else(|_| {
+                        peer.inflight = peer.inflight.map(|_| (false, false));
+                        after.clone()
+                    });
+                }
+                peer.acked = revision;
+            }
+        };
+        for _ in 0..rounds {
+            let pick = |rng: &mut u64, n: usize| {
+                (*rng ^= *rng << 13, *rng ^= *rng >> 7, *rng ^= *rng << 17);
+                (*rng % n as u64) as usize
+            };
+            let (action, p) = ([0, 0, 0, 0, 1, 1, 2, 2, 3, 3][pick(&mut rng, 10)], pick(&mut rng, 3));
+            step(&mut peers, &mut queue, &mut journal, action, p, &mut rng);
+        }
+        // Everything still unsent goes out and comes back.
+        for _ in 0..200 {
+            for p in 0..3 {
+                for action in [1, 2, 3, 3, 3] {
+                    step(&mut peers, &mut queue, &mut journal, action, p, &mut rng);
+                }
+            }
+        }
+        eprintln!("{rounds} rounds: {accepted} accepted, {rejected} conflicts, {} renumbered, {divergences} divergences", RENUMBERED.get());
+        assert_eq!(divergences, 0, "a peer's own entry differs from what it holds");
+        let head = &journal.last().unwrap().0;
+        assert!(peers.iter().all(|peer| peer.live == *head), "every peer holds the head");
+        assert!(accepted > 20 && rejected > 0 && RENUMBERED.get() > 0, "the run exercised merges, conflicts and fresh numbers");
+    }
+}
