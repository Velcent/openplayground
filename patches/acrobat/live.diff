+/// The web runner, kept for the session to reach the app (the web entry starts it).
+#[cfg(target_arch = "wasm32")]
+pub fn runner() -> eframe::WebRunner {
+    thread_local! {
+        static RUNNER: std::cell::OnceCell<eframe::WebRunner> = const { std::cell::OnceCell::new() };
+    }
+    let runner = eframe::WebRunner::new();
+    let kept = runner.clone();
+    let attached = playground_live::web::attach::<PdfCraftApp>(
+        &format!("acrobat:1:{}", env!("CARGO_PKG_VERSION")),
+        |f| RUNNER.with(|r| r.get().and_then(|r| r.app_mut::<PdfCraftApp>()).map(|mut app| f(&mut app)).is_some()),
+        || {
+            if let Some(ctx) = STATE.with_borrow(|s| s.ctx.clone()) {
+                ctx.request_repaint();
+            }
+        },
+    );
+    if let Err(e) = attached {
+        eframe::web_sys::console::error_1(&e);
+    }
+    RUNNER.with(|r| r.get_or_init(|| kept).clone())
+}
+
+/// The app the web entry runs: `app`, each frame ending with the session's [`frame`].
+#[cfg(target_arch = "wasm32")]
+pub fn wrap(app: PdfCraftApp) -> Box<dyn eframe::App> {
+    Box::new(Wrapped(app))
+}
+
+#[cfg(target_arch = "wasm32")]
+struct Wrapped(PdfCraftApp);
+
+#[cfg(target_arch = "wasm32")]
+impl eframe::App for Wrapped {
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw: &mut egui::RawInput) {
+        self.0.raw_input_hook(ctx, raw);
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.0.save(storage);
+    }
+
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.0.logic(ctx, frame);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, f: &mut eframe::Frame) {
+        self.0.ui(ui, f);
+        frame(&mut self.0);
+    }
+
+    /// The app itself, which the session reaches through the runner.
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(&mut self.0)
+    }
+}
