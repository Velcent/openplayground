+    #[test]
+    fn a_remote_page_change_resets_page_indices_and_keeps_a_selected_comment() {
+        let mut app = app_with(3);
+        assert!(app.apply_edit(note(0, "mine")));
+        let mine = app.live_document();
+        app.views[0].comments.selected = Some((0, 0));
+        let turned = edited(&mine, vec![rotate(2, 90)]);
+        assert!(matches!(receive(&mut app, &mine, &turned), Some(Ok(None))));
+        assert_eq!(app.views[0].comments.selected, Some((0, 0)), "the same pages: the selection stays");
+
+        app.views[0].pending_redaction = Some((2, vec![[0.0; 8]]));
+        let fewer = edited(&turned, vec![Edit::DeletePages { pages: vec![1] }]);
+        assert!(matches!(receive(&mut app, &turned, &fewer), Some(Ok(None))));
+        assert!(app.views[0].pending_redaction.is_none(), "no stale page index survives a page change");
+        assert_eq!(app.views[0].comments.selected, Some((0, 0)), "its comment is where it was");
+        disconnect();
