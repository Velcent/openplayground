+        frame(&mut app);
+        app.session.mark_saved(id, saved, None).unwrap();
+        assert_eq!(app.live_document(), mine, "a save does not change the shared document");
+
+        let remote = edited(&mine, vec![rotate(1, 90)]);
+        app.palette_open = true;
+        assert!(receive(&mut app, &mine, &remote).is_none() && checkpoint(&app) == Err("busy".into()), "a busy app waits");
+        app.palette_open = false;
+        frame(&mut app);
+        assert_eq!(canonical(&app.live_document()), canonical(&remote), "same document, same bytes");
+        assert_eq!((app.views[0].zoom, app.views[0].current), (3.0, 1), "this person's view stays");
+        let doc = app.session.get(id).unwrap();
+        assert!(doc.can_undo().is_none(), "no undo step, and none left from before (the camera slider replays them)");
+        assert_eq!(pdfcraft_model::pages(doc.live_cos().unwrap())[1].dict.int(b"Rotate"), Some(90));
+        disconnect();
+    }
+
+    #[test]
+    fn presence_names_the_page_and_the_selected_comment_by_object_number() {
+        let mut app = app_with(2);
+        assert!(app.apply_edit(note(1, "mine")));
+        let _ = app.live_document();
+        (app.views[0].current, app.views[0].comments.selected) = (1, Some((1, 0)));
+        let id = app.views[0].id;
+        let cos = app.session.get(id).unwrap().live_cos().unwrap().clone();
+        let pages = pdfcraft_model::pages(&cos);
+        let comment = cos.resolve(pages[1].dict.get(b"Annots").unwrap()).as_array().unwrap()[0].as_ref().unwrap();
+        assert_eq!(app.live_presence(), json!({"page": pages[1].obj.num, "selection": [comment.num]}), "no pointer off the canvas");
+        assert_eq!(ids(&app, id).unwrap().annots[&comment.num].0, 1, "the others' outline finds it by its number");
+        disconnect();
+    }
