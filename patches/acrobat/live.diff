+//! Playground live editing (web only; `pdfcraft_ui_egui`'s `live` module drives it): what a shared document needs of
+//! the session's editing state. A child of the crate root, so it reaches `Document`'s and `Session`'s private parts.
+
+use crate::{DocId, Document, EditError, Session, guard};
+use std::cell::RefCell;
+
+thread_local! {
+    /// The documents a live session shares: their saves keep the working graph.
+    static SHARED: RefCell<Vec<DocId>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Marks the documents a live session shares (none: no session).
+pub fn share(ids: Vec<DocId>) {
+    SHARED.set(ids);
+}
+
+/// Whether a save of `id` keeps its graph ([`Session::mark_saved`] asks first): a shared document must not take the
+/// save's own changes (`/ModDate`, a rewritten file), which are not everyone's.
+pub(crate) fn keeps_graph(id: DocId) -> bool {
+    SHARED.with_borrow(|ids| ids.contains(&id))
+}
+
+impl Document {
+    /// The working object graph, when the document can be edited.
+    pub fn live_cos(&self) -> Option<&pdfcraft_cos::Document> {
+        self.editor.as_ref().map(|e| &e.cos)
+    }
+}
+
+impl Session {
+    /// Installs `cos` as the working graph the way Undo does, with no undo step; Undo and Redo start again from it
+    /// (their steps lack the change). On a failed refresh the document stays as it was.
+    pub fn live_replace_graph(&mut self, id: DocId, cos: pdfcraft_cos::Document) -> Result<(), EditError> {
+        let doc = self.doc_mut(id)?;
+        doc.edit_notices.clear();
+        let editor = doc.editor.as_mut().ok_or_else(|| EditError::ReadOnly(doc.read_only_reason.clone().unwrap_or_default()))?;
+        let previous = std::mem::replace(&mut editor.cos, cos);
+        if let Err(e) = guard(|| Self::refresh(doc)).unwrap_or_else(|m| Err(EditError::Reopen(m))) {
+            if let Some(editor) = doc.editor.as_mut() {
+                editor.cos = previous;
+            }
+            if !matches!(guard(|| Self::refresh(doc)), Ok(Ok(()))) {
+                Self::show_released(doc);
+            }
+            return Err(e);
+        }
+        doc.dirty = true;
+        doc.generation += 1;
+        self.live_clear_history(id);
+        Ok(())
+    }
+
+    /// Forgets Undo and Redo: a live session ended, and its steps hold other people's edits.
+    pub fn live_clear_history(&mut self, id: DocId) {
+        if let Ok(Some(e)) = self.doc_mut(id).map(|d| d.editor.as_mut()) {
+            e.undo.clear();
+            e.redo.clear();
+        }
+    }
+
+    /// Names document `id` as the session does.
+    pub fn live_rename(&mut self, id: DocId, name: &str) {
+        if let Ok(doc) = self.doc_mut(id) {
+            name.clone_into(&mut doc.name);
+        }
+    }
+
+    /// A save of the shared document: nothing unsaved, the graph kept. The next save writes the file as opened plus
+    /// every change again.
+    pub(crate) fn live_mark_saved(&mut self, id: DocId) -> Result<(), EditError> {
+        self.doc_mut(id)?.dirty = false;
+        Ok(())
+    }
+}
