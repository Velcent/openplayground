+pub const FORMAT: &str = concat!("powerpoint:2:", env!("CARGO_PKG_VERSION"));
+
+/// The most selected ids, moved shapes and stroke points a presence carries.
+const MAX_SHOWN: usize = 50;
+const MAX_GHOSTS: usize = 24;
+const MAX_STROKE: usize = 200;
+/// The shell sends no presence over 4 KiB.
+const MAX_PRESENCE: usize = 4000;
+/// Names in tags are cut to this many characters.
+const MAX_NAME: usize = 24;
+/// How long the others' marks take to go most (1 - 1/e) of the way to where they last were, in seconds.
+const EASE: f64 = 0.08;
+/// A pointer's arrow, tip first: egui fills a closed path as a fan from its first point, which this shape allows.
+const ARROW: [[f32; 2]; 7] = [[0.0, 0.0], [12.5, 11.0], [7.3, 11.0], [10.4, 17.3], [7.6, 18.6], [4.5, 12.2], [0.0, 16.0]];
+/// A thumbnail's badges: their side, their gap, their inset from the image's top right, how many show (the last one
+/// "+N" when more are on the slide) and how long one takes to fade in (seconds).
+const BADGE: f32 = 16.0;
+const BADGE_GAP: f32 = 2.0;
+const BADGE_INSET: f32 = 4.0;
+const MAX_BADGES: usize = 3;
+const BADGE_FADE: f64 = 0.12;
+
+thread_local! {
+    /// The session's presentations as this page knows them.
+    static SHARED: RefCell<Shared> = RefCell::new(Shared::default());
+    /// A pointer is down or a text field (the notes, a ribbon box) has the keyboard.
+    static UI_BUSY: Cell<bool> = const { Cell::new(false) };
+    static CTX: RefCell<Option<egui::Context>> = const { RefCell::new(None) };
+    /// This person's pointer over the canvas, in slide points, as of the last frame.
+    static POINTER: Cell<Option<[f64; 2]>> = const { Cell::new(None) };
+    /// The others in the session, as they last showed themselves.
+    static OTHERS: RefCell<Vec<Peer>> = const { RefCell::new(Vec::new()) };
+    /// When the others' marks were last drawn (egui's clock): easing goes by the time that passed, however slow frames are.
+    static DRAWN: Cell<f64> = const { Cell::new(0.0) };
+}
+
+/// The session's presentations on this page: the one active when it started (or that it joined into), and every one
+/// opened, created or imported here or by the others since.
+#[derive(Default)]
+struct Shared {
+    docs: Vec<Doc>,
+    /// Windows that stay this person's own: open before the session started (but its first presentation), or whose
+    /// presentation left the session (an Undo of its opening).
+    own: Vec<u64>,
+    /// For [`playground_live::fresh_id`].
+    next: u64,
+}
+
+/// A presentation of the session.
+struct Doc {
+    /// Its id in the session.
+    id: u64,
+    /// Its window here (`DocState::uid`); none once this person closed it.
+    uid: Option<u64>,
+    /// As last seen: what the session goes on with while it is closed here.
+    doc: Arc<Presentation>,
+    title: String,
+}
+
+/// Hooks the engine's Undo and Redo, the model's id allocator, the canvas, the slide thumbnails and File › Home.
+pub fn install() {
+    let _ = deckcraft_engine::LIVE_UNDO.set(undo);
+    let _ = deckcraft_engine::model::LIVE_ALLOC.set(alloc_id);
+    let _ = deckcraft_ui_egui::LIVE_PAINT.set(paint);
+    let _ = deckcraft_ui_egui::LIVE_HOME.set(session_list);
+    let _ = deckcraft_ui_egui::LIVE_THUMB.set(badges);
+}
+
+/// The end of a frame. `kept`: the slide rect from before the frame, put back when the canvas was not drawn (the
+/// caller cleared it so a drawn canvas shows).
+pub fn frame(app: &mut SlideApp, ui: &egui::Ui, kept: Option<Rect>) {
+    let ctx = ui.ctx();
+    UI_BUSY.set(ctx.input(|i| i.pointer.any_down()) || ctx.egui_wants_keyboard_input());
+    CTX.with_borrow_mut(|c| _ = c.get_or_insert_with(|| ctx.clone()));
+    let canvas = app.canvas_rect.zip(app.slide_rect).map(|(canvas, slide)| (canvas, slide.min, app.canvas_scale));
+    if app.slide_rect.is_none() {
+        app.slide_rect = kept;
+    }
+    let hover = ctx.input(|i| i.pointer.hover_pos());
+    POINTER.set(canvas.and_then(|(rect, origin, scale)| {
+        let p = hover.filter(|p| rect.contains(*p))?;
+        let at = |v: f32, o: f32| round(f64::from((v - o) / scale));
+        Some([at(p.x, origin.x), at(p.y, origin.y)])
+    }));
+    playground_live::frame(app);
+}
+
+pub fn repaint() {
+    CTX.with_borrow(|c| c.iter().for_each(egui::Context::request_repaint));
+}
+
+/// The session id of the active presentation when it is one of the session's (its Undo and Redo go to the session).
+fn active_id(s: &Session) -> Option<u64> {
+    let uid = s.active()?.uid;
+    SHARED.with_borrow(|sh| sh.docs.iter().find(|d| d.uid == Some(uid)).map(|d| d.id))
+}
+
+/// Brings the session's presentations up to date with this page's windows: the active one when nothing is shared yet,
+/// each one opened since (a new presentation of the session), the latest of each that is open, and which were closed.
+fn sync(s: &Session) {
+    SHARED.with_borrow_mut(|sh| {
+        if sh.docs.is_empty() {
+            let Some(d) = s.active() else { return };
+            sh.own = s.documents().iter().map(|o| o.uid).filter(|&uid| uid != d.uid).collect();
+            let id = playground_live::fresh_id(&mut sh.next);
+            sh.docs.push(Doc { id, uid: Some(d.uid), doc: d.doc.clone(), title: d.title.clone() });
+        }
+        for doc in &mut sh.docs {
+            match s.documents().iter().find(|d| Some(d.uid) == doc.uid) {
+                Some(d) => (doc.doc, doc.title) = (d.doc.clone(), d.title.clone()),
+                None => doc.uid = None,
+            }
+        }
+        for d in s.documents() {
+            if !sh.own.contains(&d.uid) && !sh.docs.iter().any(|doc| doc.uid == Some(d.uid)) {
+                let id = playground_live::fresh_id(&mut sh.next);
+                sh.docs.push(Doc { id, uid: Some(d.uid), doc: d.doc.clone(), title: d.title.clone() });
+            }
+        }
+    });
+}
+
+/// Runs `f` with window `i` active (the session lends out only the active one), then puts the active window back.
+fn with_doc<R>(s: &mut Session, i: usize, f: impl FnOnce(&mut Session) -> R) -> R {
+    let active = s.active_index();
+    s.set_active(i);
+    let r = f(s);
+    if let Some(active) = active {
+        s.set_active(active);
+    }
+    r
+}
+
+/// `Session::execute`'s first step: the session takes Undo and Redo while one of its presentations is the active one.
+pub fn undo(session: &mut Session, command: &str) -> bool {
+    let redo = match command {
+        "edit.undo" => false,
+        "edit.redo" => true,
+        _ => return false,
+    };
+    if active_id(session).is_none() {
+        return false;
+    }
+    // As before any Undo, an input method's composition settles first.
+    session.end_composition();
+    playground_live::undo(redo)
+}
+
+/// `Presentation::alloc_id`'s first step: while connected an unused id from 2^30..2^31, random, so two people adding
+/// objects at once do not pick the same one. None: the usual next id.
+pub fn alloc_id(p: &mut Presentation) -> Option<u32> {
+    if !playground_live::connected() {
+        return None;
+    }
+    loop {
+        let fresh = playground_live::fresh_id(&mut u64::from(p.next_id));
+        let id = 0x4000_0000 | (fresh as u32 & 0x3FFF_FFFF);
+        if !uses_id(p, id) {
+            p.next_id = p.next_id.max(id);
+            return Some(id);
+        }
+    }
+}
+
+/// Whether a slide, shape, layout, master or media item has `id`.
+fn uses_id(p: &Presentation, id: u32) -> bool {
+    let mut used = p.media.iter().any(|m| m.id.0 == id);
+    let mut tree = |own: u32, shapes: &[deckcraft_engine::model::Shape]| {
+        used |= own == id;
+        walk(shapes, &mut |sh, _| used |= sh.id.0 == id);
+    };
+    for s in &p.slides {
+        tree(s.id.0, &s.shapes);
+    }
+    for m in p.masters.iter().chain(&p.notes_master).chain(&p.handout_master) {
+        tree(m.id.0, &m.shapes);
+        for l in &m.layouts {
+            tree(l.id.0, &l.shapes);
+        }
+    }
+    used
+}
+
+fn json<T: serde::Serialize + ?Sized>(value: &T) -> Value {
+    serde_json::to_value(Finite(value)).unwrap_or_default()
+}
+
+/// One presentation as shared.
+// ponytail: serializes every presentation of the session when one changes; cache by Arc if big sessions lag.
+fn project(doc: &Presentation) -> Value {
+    let mut v = json(doc);
+    v.as_object_mut().map(|o| (o.remove("nextId"), o.remove("guides")));
+    for (m, item) in v.get_mut("media").and_then(Value::as_array_mut).into_iter().flatten().zip(&doc.media) {
+        m["data"] = base64_encode(&item.data).into();
+    }
+    v
+}
+
+/// Old `Arc`s for the items whose JSON (`incoming`; `was` for `old`) did not change, so caches keyed by them (slide
+/// textures) stay warm and parts the JSON leaves out stay.
+fn reuse<T>(new: &mut [Arc<T>], incoming: &Value, was: &Value, old: &[Arc<T>]) {
+    let (Some(incoming), Some(was)) = (incoming.as_array(), was.as_array()) else { return };
+    // ponytail: quadratic in the item count, fine for slides and masters; index by id if decks grow huge.
+    for (n, v) in new.iter_mut().zip(incoming) {
+        if let Some(o) = was.iter().position(|w| w == v).and_then(|j| old.get(j)) {
+            *n = o.clone();
+        }
+    }
+}
+
+/// In a changed slide, a shape whose JSON did not change stays as it was, with the parts the JSON leaves out (a chart's
+/// package parts from the file: its embedded workbook).
+fn keep_shapes(new: &mut Arc<Slide>, old: &Slide) {
+    // ponytail: serializes every shape of the slide (group members again with their group); fine for slide-sized trees.
+    walk(&old.shapes, &mut |o, _| {
+        if let Some(n) = find_shape_mut(&mut Arc::make_mut(new).shapes, o.id)
+            && json(&*n) == json(o)
+        {
+            *n = o.clone();
+        }
+    });
+}
+
+fn invalid(e: impl std::fmt::Display) -> String {
+    format!("Invalid shared document: {e}")
+}
+
+/// A shared presentation (`document`, without its id and name) as this page installs it, keeping from `old` (this page's
+/// copy) the drawing guides, the id counter and every part whose JSON did not change.
+fn installed(old: &Presentation, mut document: Value) -> Result<Presentation, String> {
+    let was = json(old);
+    // The drawing guides stay this person's own (newer upstream only).
+    if let Some(guides) = was.get("guides") {
+        document["guides"] = guides.clone();
+    }
+    let mut doc = Presentation::deserialize(&document).map_err(invalid)?;
+    reuse(&mut doc.slides, &document["slides"], &was["slides"], &old.slides);
+    for s in &mut doc.slides {
+        if let Some(o) = old.slides.iter().find(|o| o.id == s.id && !Arc::ptr_eq(o, s)) {
+            keep_shapes(s, o);
+        }
+    }
+    reuse(&mut doc.masters, &document["masters"], &was["masters"], &old.masters);
+    for (extra, kept, key) in [(&mut doc.notes_master, &old.notes_master, "notesMaster"), (&mut doc.handout_master, &old.handout_master, "handoutMaster")] {
+        if was[key] == document[key] {
+            extra.clone_from(kept);
+        }
+    }
+    for (item, v) in doc.media.iter_mut().zip(document["media"].as_array().into_iter().flatten()) {
+        let data = v["data"].as_str().and_then(base64_decode).unwrap_or_default();
+        item.data = old.media.iter().find(|o| o.id == item.id && *o.data == data).map_or_else(|| Arc::new(data), |o| o.data.clone());
+    }
+    doc.next_id = old.next_id;
+    doc.fix_next_id();
+    Ok(doc)
+}
+
+/// The session's presentations in a shared document: (id, name, presentation).
+fn entries(document: &Value) -> Result<Vec<(u64, String, Value)>, String> {
+    let list = document["documents"].as_array().ok_or("no list of presentations")?;
+    let entry = |v: &Value| {
+        let id = v["id"].as_u64().ok_or("a presentation without an id")?;
+        let name = v["name"].as_str().ok_or("a presentation without a name")?.to_owned();
+        let mut doc = v.clone();
+        doc.as_object_mut().ok_or("not a presentation")?.retain(|k, _| k != "id" && k != "name");
+        Ok((id, name, doc))
+    };
+    list.iter().map(entry).collect()
+}
+
+/// What adopting the session's presentations does to each, worked out before anything changes: (id, name, this page's
+/// copy as (window, presentation) if it has one, the presentation to install if it changed).
+type Plan = Vec<(u64, String, Option<(Option<u64>, Arc<Presentation>)>, Option<Presentation>)>;
+
+/// The plan, and whether this page is joining (it knows none of the session's presentations yet).
+fn plan(docs: &[Doc], incoming: Vec<(u64, String, Value)>) -> Result<(bool, Plan), String> {
+    // Joining: the session's first presentation goes into the window this page offered (its active one).
+    let joining = !incoming.iter().any(|(id, ..)| docs.iter().any(|d| d.id == *id));
+    let blank = Presentation::default();
+    let mut plan = Vec::new();
+    for (i, (id, title, document)) in incoming.into_iter().enumerate() {
+        let old = if joining && i == 0 { docs.first() } else { docs.iter().find(|d| d.id == id) };
+        let doc = match old.filter(|d| project(&d.doc) == document) {
+            Some(_) => None,
+            None => Some(installed(old.map_or(&blank, |d| &d.doc), document)?),
+        };
+        plan.push((id, title, old.map(|d| (d.uid, d.doc.clone())), doc));
+    }
+    Ok((joining, plan))
+}
+
+/// Installs `doc` (when it changed) and `title` in the active window, keeping this person's slide and, unless it
+/// changed, the text being edited. Its window and presentation after.
+fn put(s: &mut Session, doc: Option<Presentation>, title: String) -> Option<(u64, Arc<Presentation>)> {
+    let st = s.active_mut()?;
+    st.title = title;
+    if let Some(doc) = doc {
+        let slide = st.doc.slides.get(st.selection.slide).map(|s| s.id);
+        let text = |st: &DocState| {
+            st.selection.text.as_ref().map(|t| (t.notes.then(|| st.current_slide().map(|s| s.notes.clone())), st.shape(t.shape).cloned()))
+        };
+        let editing = text(st);
+        st.doc = Arc::new(doc);
+        st.revision += 1;
+        if let Some(at) = slide.and_then(|id| st.doc.slide_index(id)) {
+            st.selection.slide = at;
+        }
+        if text(st) != editing {
+            st.selection.text = None;
+        }
+        let _ = s.select(|_, _| {});
+    }
+    s.active().map(|st| (st.uid, st.doc.clone()))
+}
+
+fn round(v: f64) -> f64 {
+    (v * 10.0).round() / 10.0
+}
+
+/// A geometry's flags in presence: 1 flipped horizontally, 2 vertically, 4 a line (its box's corner to corner).
+fn flags(x: &Xfrm, line: bool) -> u8 {
+    u8::from(x.flip_h) | u8::from(x.flip_v) << 1 | u8::from(line) << 2
+}
+
+/// The shapes a move, resize or rotation under way has somewhere new, read from the app's own drag (it writes the
+/// presentation as it goes; the interaction keeps it from before): `[id, x, y, w, h, rot, flags]` each, slide points.
+fn ghosts(s: &Session, st: &DocState) -> Option<Value> {
+    let i = st.interaction.as_ref().filter(|_| s.tool.dragging())?;
+    let before = i.doc.slides.get(i.selection.slide).filter(|_| i.selection.target == Target::Slides);
+    let moved = st.selection.shapes.iter().filter_map(|&id| {
+        let sh = st.shape(id)?;
+        let x = xfrm_of(&st.doc, &st.selection, sh);
+        let was = before.and_then(|b| find_shape(&b.shapes, id)).map(|o| xfrm_of(&i.doc, &i.selection, o));
+        (was != Some(x)).then(|| json!([id.0, round(x.x), round(x.y), round(x.w), round(x.h), round(x.rot), flags(&x, sh.is_line())]))
+    });
+    let list: Vec<Value> = moved.take(MAX_GHOSTS).collect();
+    (!list.is_empty()).then(|| list.into())
+}
+
+/// A shape, line, text box or table being drawn: its rubber band `[x, y, w, h, flags]`.
+fn band(s: &Session) -> Option<Value> {
+    let x = s.tool.preview.filter(|_| s.tool.dragging())?;
+    let line = matches!(&s.tool.kind, ToolKind::Shape { preset } if is_line_like(preset));
+    Some(json!([round(x.x), round(x.y), round(x.w), round(x.h), flags(&x, line)]))
+}
+
+/// Ink being drawn (pen or highlighter) or a freeform path: its points at least a pixel apart at this person's zoom
+/// `z`, the newest [`MAX_STROKE`], as one flat list, and the pen's width (points; 0 for a path's hairline).
+fn stroke(s: &Session, z: f32) -> Option<(Value, f64)> {
+    let t = &s.tool;
+    let (points, width): (Vec<[f64; 2]>, f64) = match &t.kind {
+        ToolKind::Ink { mode, width, .. } if mode != "eraser" && t.ink_preview.len() > 1 => (t.ink_preview.iter().map(|p| [p.0, p.1]).collect(), *width),
+        _ if t.drawing_freeform() && t.path_preview.len() > 1 => (t.path_preview.iter().map(|p| [p.x, p.y]).collect(), 0.0),
+        _ => return None,
+    };
+    let mut kept: Vec<[f64; 2]> = Vec::new();
+    for p in points {
+        if kept.last().is_none_or(|q| (p[0] - q[0]).hypot(p[1] - q[1]) * f64::from(z) >= 1.0) {
+            kept.push(p);
+        }
+    }
+    let kept = &kept[kept.len().saturating_sub(MAX_STROKE)..];
+    (kept.len() >= 2).then(|| (kept.iter().flatten().map(|v| round(*v)).collect(), round(width)))
+}
+
+/// Another person as they last showed themselves, with their moving marks where this canvas last drew them (slide
+/// points), eased toward where they are: the pointer, the moved shapes' ghosts, the rubber band, and the stroke ([its
+/// length, how far its shown end is behind its newest point]; a length of infinity: not seen yet, shown whole at once),
+/// and when their badge first showed on their slide's thumbnail (egui's clock; NaN: not yet).
+struct Peer {
+    who: Presence,
+    pointer: Option<[f64; 2]>,
+    ghosts: Vec<Ghost>,
+    band: Option<([f64; 4], u8)>,
+    ink: [f64; 2],
+    arrived: f64,
+}
+
+/// A moved shape's ghost: (id, [x, y, w, h, rot], flags).
+type Ghost = (u32, [f64; 5], u8);
+
+impl Peer {
+    /// One frame on toward this person's latest state (`k`: the share of the way, `z`: screen points a slide point,
+    /// `far`: the jump in screen points that goes at once). Whether a mark is still on its way.
+    fn step(&mut self, k: f64, z: f64, far: f64) -> bool {
+        let state = &self.who.state;
+        let mut moving = false;
+        match (&mut self.pointer, pointer_at(&state["pointer"])) {
+            (Some(s), Some(t)) => moving |= ease(s, &t, k, z, far),
+            (s, t) => *s = t,
+        }
+        let mut ghosts = ghosts_at(&state["drag"]);
+        for (id, t, _) in &mut ghosts {
+            if let Some((_, s, _)) = self.ghosts.iter().find(|g| g.0 == *id) {
+                // A rotation goes the short way round.
+                t[4] = s[4] + (t[4] - s[4] + 540.0).rem_euclid(360.0) - 180.0;
+                let mut at = *s;
+                moving |= ease(&mut at, t, k, z, far);
+                *t = at;
+            }
+        }
+        self.ghosts = ghosts;
+        match (&mut self.band, band_at(&state["create"])) {
+            (Some((s, f)), Some((t, g))) if *f == g => moving |= ease(s, &t, k, z, far),
+            (s, t) => *s = t,
+        }
+        let stroke = stroke_at(&state["stroke"]);
+        if stroke.is_empty() {
+            self.ink = [0.0; 2];
+        } else {
+            let [seen, behind] = &mut self.ink;
+            let length = length(&stroke);
+            *behind = (*behind + length - *seen).max(0.0);
+            *seen = length;
+            moving |= ease(std::slice::from_mut(behind), &[0.0], k, z, far);
+        }
+        moving
+    }
+}
+
+/// `s` moved `k` of the way to `t` (slide points, `z` screen points each), all of it after a jump of more than `far`
+/// screen points or once under half a point remains. Whether it is still on its way.
+fn ease(s: &mut [f64], t: &[f64], k: f64, z: f64, far: f64) -> bool {
+    let off = |s: &[f64]| s.iter().zip(t).map(|(s, t)| (t - s).abs() * z).fold(0.0, f64::max);
+    let k = if off(s) > far { 1.0 } else { k };
+    s.iter_mut().zip(t).for_each(|(s, t)| *s += (t - *s) * k);
+    let moving = off(s) >= 0.5;
+    if !moving {
+        s.copy_from_slice(t);
+    }
+    moving
+}
+
+/// A number from another person's presence, if it is one worth drawing.
+fn number(v: &Value) -> Option<f64> {
+    v.as_f64().filter(|v| v.abs() < 1e6)
+}
+
+fn pointer_at(v: &Value) -> Option<[f64; 2]> {
+    Some([number(&v[0])?, number(&v[1])?])
+}
+
+/// The ghosts of a move (see [`ghosts`]); what does not resolve is left out.
+fn ghosts_at(v: &Value) -> Vec<Ghost> {
+    let ghost = |g: &Value| {
+        let id = u32::try_from(g[0].as_u64()?).ok()?;
+        let [x, y, w, h, rot] = [1, 2, 3, 4, 5].map(|i| number(&g[i]));
+        Some((id, [x?, y?, w?.max(0.0), h?.max(0.0), rot?], u8::try_from(g[6].as_u64()?).ok()?))
+    };
+    v.as_array().into_iter().flatten().take(MAX_GHOSTS).filter_map(ghost).collect()
+}
+
+/// A rubber band (see [`band`]).
+fn band_at(v: &Value) -> Option<([f64; 4], u8)> {
+    let [x, y, w, h] = [0, 1, 2, 3].map(|i| number(&v[i]));
+    Some(([x?, y?, w?.max(0.0), h?.max(0.0)], u8::try_from(v[4].as_u64()?).ok()?))
+}
+
+/// A stroke's points from its flat list; none unless every number is one worth drawing.
+fn stroke_at(v: &Value) -> Vec<[f64; 2]> {
+    let numbers = v.as_array().into_iter().flatten().take(2 * MAX_STROKE).map(number);
+    numbers.collect::<Option<Vec<f64>>>().unwrap_or_default().chunks_exact(2).map(|p| [p[0], p[1]]).collect()
+}
+
+fn length(stroke: &[[f64; 2]]) -> f64 {
+    stroke.windows(2).map(|w| (w[1][0] - w[0][0]).hypot(w[1][1] - w[0][1])).sum()
+}
+
+fn xfrm(at: [f64; 4], rot: f64, flags: u8) -> Xfrm {
+    Xfrm { x: at[0], y: at[1], w: at[2], h: at[3], rot, flip_h: flags & 1 != 0, flip_v: flags & 2 != 0 }
+}
+
+/// A shape's outline at size `w` × `h` (shape-local points) when it is one convex path (rectangles, ellipses, rounded
+/// rectangles, triangles…), so it fills as it is drawn.
+fn convex_outline(sh: &deckcraft_engine::model::Shape, w: f64, h: f64) -> Option<Vec<Point>> {
+    let mut points: Vec<Point> = Vec::new();
+    let mut paths = 0;
+    preset_flatten(&deckcraft_engine::render::shape_geometry(sh, w, h).outline(), &mut |el| match el {
+        PathEl::MoveTo(q) => {
+            paths += 1;
+            points.push(q);
+        }
+        PathEl::LineTo(q) if points.last().is_none_or(|p| (*p - q).hypot() > 1e-6) => points.push(q),
+        _ => {}
+    });
+    let n = points.len();
+    let turn = |i: usize| (points[(i + 1) % n] - points[i]).cross(points[(i + 2) % n] - points[(i + 1) % n]);
+    let convex = (0..n).all(|i| turn(i) >= -1e-6) || (0..n).all(|i| turn(i) <= 1e-6);
+    (paths == 1 && n >= 3 && convex).then_some(points)
+}
+
+/// A shape moved, resized or rotated, where it is going: its own outline when this page has it and it is convex, else
+/// its box, filled faintly with an edge; a line as a band along it.
+fn paint_ghost(p: &Painter, xf: Xf, st: &DocState, &(id, at, f): &Ghost, color: Color32) {
+    let x = xfrm([at[0], at[1], at[2], at[3]], at[4], f);
+    let a = x.affine();
+    let edge = Stroke::new(1.5, color.gamma_multiply(0.85));
+    if f & 4 != 0 {
+        let ends = [xf.to_screen(a * Point::new(0.0, 0.0)), xf.to_screen(a * Point::new(x.w, x.h))];
+        p.line_segment(ends, Stroke::new(6.0, color.gamma_multiply(0.28)));
+        p.line_segment(ends, edge);
+        return;
+    }
+    let corners = || vec![Point::new(0.0, 0.0), Point::new(x.w, 0.0), Point::new(x.w, x.h), Point::new(0.0, x.h)];
+    let local = st.shape(ShapeId(id)).and_then(|sh| convex_outline(sh, x.w, x.h)).unwrap_or_else(corners);
+    p.add(PathShape::convex_polygon(local.into_iter().map(|q| xf.to_screen(a * q)).collect(), color.gamma_multiply(0.28), edge));
+}
+
+/// A rubber band: its box (or line) dashed.
+fn paint_band(p: &Painter, xf: Xf, (at, f): ([f64; 4], u8), color: Color32) {
+    let x = xfrm(at, 0.0, f);
+    let a = x.affine();
+    let corners: &[(f64, f64)] = if f & 4 != 0 { &[(0.0, 0.0), (1.0, 1.0)] } else { &[(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0), (0.0, 0.0)] };
+    let line: Vec<Pos2> = corners.iter().map(|&(u, v)| xf.to_screen(a * Point::new(u * x.w, v * x.h))).collect();
+    p.extend(Shape::dashed_line(&line, Stroke::new(1.5, color), 4.0, 3.0));
+}
+
+/// A stroke being drawn, up to `behind` slide points short of its newest point: translucent, as wide as the pen.
+fn paint_stroke(p: &Painter, xf: Xf, stroke: &[[f64; 2]], width: f64, behind: f64, color: Color32) {
+    let Some(&first) = stroke.first() else { return };
+    let at = |q: [f64; 2]| xf.to_screen(Point::new(q[0], q[1]));
+    let mut left = length(stroke) - behind;
+    let mut line = vec![at(first)];
+    for w in stroke.windows(2) {
+        let d = (w[1][0] - w[0][0]).hypot(w[1][1] - w[0][1]);
+        if d >= left {
+            let f = if d > 0.0 { (left / d).max(0.0) } else { 0.0 };
+            line.push(at([w[0][0] + (w[1][0] - w[0][0]) * f, w[0][1] + (w[1][1] - w[0][1]) * f]));
+            break;
+        }
+        left -= d;
+        line.push(at(w[1]));
+    }
+    let width = (width.clamp(0.0, 200.0) as f32 * xf.scale).max(2.0);
+    // ponytail: egui's own joins and butt caps; round ones would show only on wide highlighter strokes.
+    p.add(PathShape::line(line, Stroke::new(width, color.gamma_multiply(0.7))));
+}
+
+/// A person's selected shapes outlined in `color`: the box DeckCraft outlines its own selection with, or the line.
+fn paint_selection(p: &Painter, xf: Xf, st: &DocState, state: &Value, color: Color32) {
+    let stroke = Stroke::new(2.0, color);
+    let ids = state["selection"].as_array().into_iter().flatten().take(MAX_SHOWN);
+    for sh in ids.filter_map(|id| st.shape(ShapeId(u32::try_from(id.as_u64()?).ok()?))) {
+        let x = xfrm_of(&st.doc, &st.selection, sh);
+        let a = x.affine();
+        let corner = |cx: f64, cy: f64| xf.to_screen(a * Point::new(cx, cy));
+        if sh.is_line() {
+            p.line_segment([corner(0.0, 0.0), corner(x.w, x.h)], stroke);
+        } else {
+            p.add(Shape::closed_line(vec![corner(0.0, 0.0), corner(x.w, 0.0), corner(x.w, x.h), corner(0.0, x.h)], stroke));
+        }
+    }
+}
+
+/// A pointer: the arrow, its tip at `tip`, in `color` with a white edge and a soft shadow.
+fn paint_arrow(p: &Painter, tip: Pos2, color: Color32) {
+    let points: Vec<Pos2> = ARROW.iter().map(|&[x, y]| tip + vec2(x, y)).collect();
+    let shadow = points.iter().map(|q| *q + vec2(0.0, 1.0)).collect();
+    p.add(PathShape::convex_polygon(shadow, Color32::from_black_alpha(64), Stroke::NONE));
+    p.add(PathShape::convex_polygon(points, color, Stroke::new(1.5, Color32::WHITE)));
+}
+
+/// A name tag in `color`, its top left at `at`. Dark text on light colors.
+fn paint_tag(p: &Painter, at: Pos2, name: &str, color: Color32) {
+    if name.is_empty() {
+        return;
+    }
+    let name: String = if name.chars().count() > MAX_NAME { name.chars().take(MAX_NAME - 1).chain(['…']).collect() } else { name.into() };
+    let ink = ink(color);
+    let text = p.layout_no_wrap(name, theme::bold(12.0), ink);
+    let r = Rect::from_min_size(at, text.size() + vec2(14.0, 6.0));
+    p.rect_filled(r, 6.0, color);
+    p.galley(r.min + vec2(7.0, 3.0), text, ink);
+}
+
+/// Text on `color`: dark on light colors, else white.
+fn ink(color: Color32) -> Color32 {
+    let lin = egui::ecolor::linear_f32_from_gamma_u8;
+    let luminance = 0.2126 * lin(color.r()) + 0.7152 * lin(color.g()) + 0.0722 * lin(color.b());
+    if luminance > 0.55 { Color32::from_gray(0x11) } else { Color32::WHITE }
+}
+
+fn color(o: &Peer) -> Color32 {
+    let [r, g, b] = o.who.color;
+    Color32::from_rgb(r, g, b)
+}
+
+/// The canvas's overlays call it first: the others on this person's presentation and slide, in their colors, under this
+/// person's own overlays: what they are moving or drawing, then their selections, then their pointers with their names.
+/// Marks ease toward where they were last shown, repainting until they get there.
+fn paint(app: &SlideApp, p: &Painter, xf: Xf) {
+    OTHERS.with_borrow_mut(|others| {
+        let (Some(doc), Some(st)) = (active_id(&app.session).filter(|_| !others.is_empty()), app.session.active()) else { return };
+        let Some(slide) = st.doc.slides.get(st.selection.slide).filter(|_| st.selection.target == Target::Slides) else { return };
+        let on = |s: &Value| s["doc"].as_u64() == Some(doc) && s["slide"].as_u64() == Some(u64::from(slide.id.0));
+        let mut here: Vec<&mut Peer> = others.iter_mut().filter(|o| on(&o.who.state)).collect();
+        let now = p.ctx().input(|i| i.time);
+        let dt = (now - DRAWN.replace(now)).clamp(0.0, 0.1);
+        let (k, z) = (1.0 - (-dt / EASE).exp(), f64::from(xf.scale));
+        let far = 0.25 * f64::from(p.clip_rect().width().max(p.clip_rect().height()));
+        let mut moving = false;
+        for o in &mut here {
+            moving |= o.step(k, z, far);
+        }
+        if moving {
+            p.ctx().request_repaint();
+        }
+        for o in &here {
+            for g in &o.ghosts {
+                paint_ghost(p, xf, st, g, color(o));
+            }
+            if let Some(band) = o.band {
+                paint_band(p, xf, band, color(o));
+            }
+            let width = number(&o.who.state["width"]).unwrap_or(0.0);
+            paint_stroke(p, xf, &stroke_at(&o.who.state["stroke"]), width, o.ink[1], color(o));
+        }
+        for o in &here {
+            paint_selection(p, xf, st, &o.who.state, color(o));
+        }
+        for o in &here {
+            if let Some(at) = o.pointer {
+                let tip = xf.to_screen(Point::new(at[0], at[1]));
+                paint_arrow(p, tip, color(o));
+                paint_tag(p, tip + vec2(12.0, 15.0), &o.who.name, color(o));
+            }
+        }
+    });
+}
+
+/// Who of the others is on each slide of presentation `doc`: slide id → their places in `others`, in session order.
+fn on_slides(others: &[Peer], doc: u64) -> BTreeMap<u64, Vec<usize>> {
+    let mut on: BTreeMap<u64, Vec<usize>> = BTreeMap::new();
+    for (k, o) in others.iter().enumerate() {
+        if o.who.state["doc"].as_u64() == Some(doc)
+            && let Some(slide) = o.who.state["slide"].as_u64()
+        {
+            on.entry(slide).or_default().push(k);
+        }
+    }
+    on
+}
+
+/// The Slides pane and the Slide Sorter call it for each thumbnail (`img`: its image, `i`: its slide): a square badge in
+/// each other person's color with their initial, at the image's top right, the first on the right and the rest to its
+/// left, the last of [`MAX_BADGES`] "+N" for the rest; hovering one shows who. Each fades in where its person arrives.
+fn badges(app: &SlideApp, ui: &egui::Ui, img: Rect, i: usize) {
+    let (Some(doc), Some(st)) = (active_id(&app.session), app.session.active()) else { return };
+    let Some(slide) = st.doc.slides.get(i).map(|s| u64::from(s.id.0)) else { return };
+    let now = ui.input(|inp| inp.time);
+    OTHERS.with_borrow_mut(|others| {
+        let Some(on) = on_slides(others, doc).remove(&slide) else { return };
+        let shown = if on.len() > MAX_BADGES { MAX_BADGES - 1 } else { on.len() };
+        let mut right = img.right() - BADGE_INSET;
+        let mut badge = |n: usize, label: String, fill: Color32, alpha: f32, tip: String| {
+            let r = Rect::from_min_size(pos2(right - BADGE, img.top() + BADGE_INSET), vec2(BADGE, BADGE));
+            right -= BADGE + BADGE_GAP;
+            let p = ui.painter();
+            p.rect_filled(r, 0.0, fill.gamma_multiply(alpha));
+            p.text(r.center(), Align2::CENTER_CENTER, label, theme::bold(10.5), ink(fill).gamma_multiply(alpha));
+            ui.interact(r, ui.id().with(("live-badge", i, n)), Sense::hover()).on_hover_text(tip);
+        };
+        for (n, &k) in on[..shown].iter().enumerate() {
+            let o = &mut others[k];
+            if o.arrived.is_nan() {
+                o.arrived = now;
+            }
+            let alpha = ((now - o.arrived) / BADGE_FADE).clamp(0.0, 1.0) as f32;
+            if alpha < 1.0 {
+                ui.ctx().request_repaint();
+            }
+            let initial = o.who.name.chars().next().map_or_else(|| "?".into(), |c| c.to_uppercase().collect());
+            badge(n, initial, color(o), alpha, o.who.name.clone());
+        }
+        if on.len() > shown {
+            let names: Vec<&str> = on[shown..].iter().map(|&k| others[k].who.name.as_str()).collect();
+            badge(shown, format!("+{}", names.len()), Color32::from_gray(0x55), 1.0, names.join("\n"));
+        }
+    });
+}
+
+/// File › Home in a session: the session's presentations, a row each with dots in the colors of the others on it; a
+/// click goes to one, opening it again if this person closed it. Whether it did (the File view then closes).
+fn session_list(app: &mut SlideApp, ui: &mut egui::Ui) -> bool {
+    if !playground_live::connected() {
+        return false;
+    }
+    sync(&app.session);
+    let rows: Vec<(u64, String, Option<u64>)> = SHARED.with_borrow(|sh| sh.docs.iter().map(|d| (d.id, d.title.clone(), d.uid)).collect());
+    if rows.is_empty() {
+        return false;
+    }
+    let (t, here) = (Tokens::get(ui.ctx()), active_id(&app.session));
+    ui.label(RichText::new("In this session").font(theme::bold(16.0)).color(t.text));
+    ui.add_space(6.0);
+    let width = ui.available_width().min(720.0);
+    let mut chosen = None;
+    for (id, title, uid) in rows {
+        let (rect, resp) = ui.allocate_exact_size(vec2(width, 44.0), Sense::click());
+        resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, &title));
+        let p = ui.painter();
+        if resp.hovered() || here == Some(id) {
+            p.rect_filled(rect, 3.0, t.hover);
+        }
+        let note = match (here == Some(id), uid) {
+            (true, _) => "You are here",
+            (false, Some(_)) => "Open",
+            (false, None) => "Closed here: click to open it again",
+        };
+        icons::paint(p, Rect::from_center_size(pos2(rect.left() + 20.0, rect.center().y), vec2(22.0, 22.0)), Icon::Slide, t.text, false);
+        p.text(pos2(rect.left() + 44.0, rect.center().y - 8.0), Align2::LEFT_CENTER, &title, theme::font(13.0), t.text);
+        p.text(pos2(rect.left() + 44.0, rect.center().y + 9.0), Align2::LEFT_CENTER, note, theme::font(11.0), t.text_dim);
+        let names = OTHERS.with_borrow(|others| {
+            let on = others.iter().filter(|o| o.who.state["doc"].as_u64() == Some(id));
+            on.enumerate()
+                .map(|(k, o)| {
+                    p.circle(pos2(rect.right() - 16.0 - 16.0 * k as f32, rect.center().y), 5.0, color(o), Stroke::new(1.5, Color32::WHITE));
+                    o.who.name.clone()
+                })
+                .collect::<Vec<_>>()
+        });
+        let resp = if names.is_empty() { resp } else { resp.on_hover_text(names.join(", ")) };
+        if resp.clicked() {
+            chosen = Some((id, uid));
+        }
+    }
+    ui.add_space(22.0);
+    let Some((id, uid)) = chosen else { return false };
+    let s = &mut app.session;
+    match uid.and_then(|uid| s.documents().iter().position(|d| d.uid == uid)) {
+        Some(i) => s.set_active(i),
+        None => {
+            // Open again: a window of its own with the session's copy.
+            let found = SHARED.with_borrow(|sh| sh.docs.iter().find(|d| d.id == id).map(|d| ((*d.doc).clone(), d.title.clone())));
+            let Some((doc, title)) = found else { return false };
+            let i = s.add_document(DocState::new(doc, None, title));
+            let uid = s.documents()[i].uid;
+            SHARED.with_borrow_mut(|sh| sh.docs.iter_mut().filter(|d| d.id == id).for_each(|d| d.uid = Some(uid)));
+        }
+    }
+    true
+}
+
+impl Live for SlideApp {
+    /// `{ documents: [{ id, name, ...presentation }] }`: every presentation of the session, open here or not.
+    fn live_document(&self) -> Value {
+        sync(&self.session);
+        SHARED.with_borrow(|sh| {
+            let docs = sh.docs.iter().map(|d| {
+                let mut v = project(&d.doc);
+                (v["id"], v["name"]) = (d.id.into(), d.title.clone().into());
+                v
+            });
+            json!({"documents": docs.collect::<Vec<_>>()})
+        })
+    }
+
+    /// Each presentation goes into its window here; one new to the session opens behind this person's, one they closed
+    /// stays closed.
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let incoming = entries(&document)?;
+        sync(&self.session);
+        let (joining, plan) = SHARED.with_borrow(|sh| plan(&sh.docs, incoming))?;
+        let s = &mut self.session;
+        let mut active = s.active_index();
+        let (mut docs, mut opened) = (Vec::new(), None);
+        for (id, title, old, doc) in plan {
+            let at = old.as_ref().and_then(|o| o.0).and_then(|uid| s.documents().iter().position(|d| d.uid == uid));
+            docs.push(match (at, old) {
+                (Some(i), _) => {
+                    let Some((uid, doc)) = with_doc(s, i, |s| put(s, doc, title.clone())) else { continue };
+                    Doc { id, uid: Some(uid), doc, title }
+                }
+                (None, Some((_, last))) => Doc { id, uid: None, doc: doc.map_or(last, Arc::new), title },
+                (None, None) => {
+                    let i = s.add_document(DocState::new(doc.unwrap_or_default(), None, title.clone()));
+                    match active {
+                        Some(a) => s.set_active(a),
+                        None => active = Some(i),
+                    }
+                    if !joining {
+                        opened = Some(title.clone());
+                    }
+                    let d = &s.documents()[i];
+                    Doc { id, uid: Some(d.uid), doc: d.doc.clone(), title }
+                }
+            });
+        }
+        SHARED.with_borrow_mut(|sh| {
+            // A window whose presentation left the session (an Undo of its opening) stays, as this person's own.
+            let gone: Vec<u64> = sh.docs.iter().filter_map(|d| d.uid).filter(|uid| !docs.iter().any(|d| d.uid == Some(*uid))).collect();
+            sh.own.extend(gone);
+            sh.docs = docs;
+        });
+        if let Some(title) = opened {
+            let text = format!("“{title}” was opened in this session. File › Home lists the session's presentations.");
+            self.toast = Some(deckcraft_ui_egui::toast::Toast { text, at: deckcraft_ui_egui::now_ms() });
+        }
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        !UI_BUSY.get()
+            && !self.session.tool.dragging()
+            && !self.session.tool.drawing_freeform()
+            && self.session.documents().iter().all(|d| d.interaction.is_none() && d.composition.is_none())
+    }
+
+    /// Every window's presentation (a new `Arc` and revision for every change) and the session's presentations.
+    fn live_generation(&self) -> Option<u64> {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::hash::DefaultHasher::new();
+        for d in self.session.documents() {
+            (d.uid, d.revision, Arc::as_ptr(&d.doc) as usize, &d.title).hash(&mut h);
+        }
+        SHARED.with_borrow(|sh| sh.docs.iter().for_each(|d| (d.id, d.uid, Arc::as_ptr(&d.doc) as usize).hash(&mut h)));
+        Some(h.finish())
+    }
+
+    fn live_disconnected(&mut self) {
+        let shared = SHARED.take();
+        let s = &mut self.session;
+        for i in 0..s.documents().len() {
+            if shared.docs.iter().any(|d| d.uid == Some(s.documents()[i].uid)) {
+                // Their steps hold other people's edits.
+                with_doc(s, i, |s| {
+                    if let Some(st) = s.active_mut() {
+                        st.history.undo.clear();
+                        st.history.redo.clear();
+                    }
+                });
+            }
+        }
+    }
+
+    /// Only presentations every peer can open are recorded, each id once.
+    fn live_check(document: &Value) -> Result<(), String> {
+        let docs = entries(document).map_err(|e| format!("Conflict: {e}"))?;
+        for (i, (id, _, doc)) in docs.iter().enumerate() {
+            if docs[..i].iter().any(|d| d.0 == *id) {
+                return Err("Conflict: two presentations with one id".into());
+            }
+            Presentation::deserialize(doc).map_err(invalid)?;
+        }
+        Ok(())
+    }
+
+    /// `{doc, slide, pointer?, selection, drag?, create?, stroke?, width?}` on a slide of the session's presentations
+    /// (`{doc}` on their masters and layouts): see [`ghosts`], [`band`] and [`stroke`].
+    fn live_presence(&self) -> Value {
+        let (Some(doc), Some(st)) = (active_id(&self.session), self.session.active()) else { return Value::Null };
+        let Some(slide) = st.doc.slides.get(st.selection.slide).filter(|_| st.selection.target == Target::Slides) else {
+            return json!({"doc": doc});
+        };
+        let selection: Vec<u32> = st.selection.shapes.iter().take(MAX_SHOWN).map(|id| id.0).collect();
+        let mut v = json!({"doc": doc, "slide": slide.id.0, "selection": selection});
+        if let Some(p) = POINTER.get() {
+            v["pointer"] = json!(p);
+        }
+        for (key, mark) in [("drag", ghosts(&self.session, st)), ("create", band(&self.session))] {
+            if let Some(mark) = mark {
+                v[key] = mark;
+            }
+        }
+        if let Some((points, width)) = stroke(&self.session, self.canvas_scale) {
+            (v["stroke"], v["width"]) = (points, width.into());
+        }
+        // The shell sends nothing bigger: the stroke's oldest points go first.
+        while v.to_string().len() > MAX_PRESENCE
+            && let Some(s) = v.get_mut("stroke").and_then(Value::as_array_mut).filter(|s| s.len() > 4)
+        {
+            s.drain(..s.len() / 4 * 2);
+        }
+        v
+    }
+
+    /// Who is still on the same presentation and slide keeps their marks where they were drawn, to ease on from there.
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.with_borrow_mut(|old| {
+            *old = (others.into_iter())
+                .map(|who| {
+                    let place = |s: &Value| (s["doc"].clone(), s["slide"].clone());
+                    let same = |o: &&Peer| o.who.id == who.id && place(&o.who.state) == place(&who.state);
+                    let kept = old.iter().find(same).map(|o| (o.pointer, o.ghosts.clone(), o.band, o.ink, o.arrived));
+                    let (pointer, ghosts, band, ink, arrived) = kept.unwrap_or((None, Vec::new(), None, [f64::INFINITY, 0.0], f64::NAN));
+                    Peer { who, pointer, ghosts, band, ink, arrived }
+                })
+                .collect();
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use deckcraft_engine::model::chart::ChartPart;
+    use deckcraft_engine::model::{DrawGuide, ShapeKind};
+    use deckcraft_engine::{EngineError, Interaction, Mods, PointerEvent, PointerKind};
+    use deckcraft_ui_egui::Services;
+    use playground_live::canonical;
+
+    fn sample() -> Result<SlideApp, String> {
+        let mut app = SlideApp::new(Session::new(), Services::default());
+        deckcraft_engine::sample::open_sample(&mut app.session).map_err(|e| e.to_string())?;
+        Ok(app)
+    }
+
+    fn e(e: EngineError) -> String {
+        e.to_string()
+    }
+
+    /// Switches the test to another page: the session as this page knows it goes into `page`, `page`'s comes in.
+    fn switch(page: &mut Shared) {
+        SHARED.with_borrow_mut(|s| std::mem::swap(s, page));
+    }
+
+    fn parse(bytes: &[u8]) -> Result<Value, String> {
+        serde_json::from_slice(bytes).map_err(|e| e.to_string())
+    }
+
+    #[test]
+    fn shares_the_deck_without_views_adopts_it_without_an_undo_step_and_waits_for_a_gesture() -> Result<(), String> {
+        install();
+        SHARED.take();
+        let mut a = sample()?;
+        // A chart with package parts from a file, which the JSON leaves out.
+        let chart = a.session.execute("insert.chart", &json!({})).map_err(e)?["id"].as_u64().unwrap_or_default();
+        a.session.edit(|d, _| {
+            let shape = find_shape_mut(&mut Arc::make_mut(&mut d.slides[0]).shapes, ShapeId(chart as u32));
+            if let Some(ShapeKind::Chart(c)) = shape.map(|s| &mut s.kind) {
+                c.kept.parts.push(ChartPart { name: "ppt/embeddings/Workbook.xlsx".into(), content_type: "xlsx".into(), bytes: vec![1, 2] });
+            }
+            Ok(())
+        })
+        .map_err(e)?;
+        let kept = |app: &SlideApp| {
+            let st = app.session.documents().first().map(|d| d.doc.clone());
+            st.and_then(|d| match &d.slides[0].shapes.iter().find(|s| u64::from(s.id.0) == chart)?.kind {
+                ShapeKind::Chart(c) => Some(c.kept.parts.len()),
+                _ => None,
+            })
+        };
+        playground_live::connect();
+        assert_eq!(a.live_presence(), Value::Null, "nothing is shared before the session reads it");
+        let start = canonical(&a.live_document());
+        let doc = parse(&start)?["documents"][0]["id"].clone();
+        let ids: Vec<u32> = a.session.doc().map_err(e)?.doc.slides[0].shapes.iter().map(|s| s.id.0).collect();
+        a.session.execute("edit.select", &json!({"ids": [ids[2]]})).map_err(e)?;
+        let slide = a.session.doc().map_err(e)?.doc.slides[0].id.0;
+        assert_eq!(a.live_presence(), json!({"doc": doc, "slide": slide, "selection": [ids[2]]}));
+
+        // The band at the bottom moved, held mid-way (dragged with Ctrl: no snapping): the others see its ghost there.
+        let at = |kind, x, y| PointerEvent { kind, x, y, mods: Mods { cmd: kind == PointerKind::Drag, ..Mods::default() }, ..Default::default() };
+        a.session.pointer(at(PointerKind::Down, 30.0, 505.0)).map_err(e)?;
+        a.session.pointer(at(PointerKind::Drag, 50.0, 465.0)).map_err(e)?;
+        assert_eq!(ghosts_at(&a.live_presence()["drag"]), [(ids[2], [20.0, 430.0, 960.0, 70.0, 0.0], 0)]);
+        a.session.pointer(at(PointerKind::Drag, 30.0, 505.0)).map_err(e)?;
+        a.session.pointer(at(PointerKind::Up, 30.0, 505.0)).map_err(e)?;
+        assert!(a.live_presence().get("drag").is_none(), "no ghost at rest");
+
+        a.session.execute("slide.next", &json!({})).map_err(e)?;
+        a.ui.zoom = Some(2.0);
+        a.session.edit(|d, _| Ok(d.guides.push(DrawGuide { vertical: true, pos: 100.0 }))).map_err(e)?;
+        assert_eq!(canonical(&a.live_document()), start, "views are not shared");
+        let text = String::from_utf8_lossy(&start).into_owned();
+        assert!(!text.contains("\"nextId\"") && !text.contains("\"guides\""));
+
+        // A joiner adopts it whole into its window and shares the same bytes.
+        let mut page = Shared::default();
+        switch(&mut page);
+        let mut b = sample()?;
+        b.session.execute("slide.new", &json!({})).map_err(e)?;
+        b.live_adopt(parse(&start)?)?;
+        assert_eq!((canonical(&b.live_document()), b.session.documents().len()), (start.clone(), 1));
+
+        // B types into the subtitle; A merges it at a quiet frame, keeping its views, its guides, its undo history,
+        // the slides that did not change and the chart's parts.
+        b.session.execute("slide.first", &json!({})).map_err(e)?;
+        b.session.execute("edit.select", &json!({"ids": [ids[1]]})).map_err(e)?;
+        b.session.type_text("B").map_err(e)?;
+        b.session.key("Escape", Mods::default()).map_err(e)?;
+        let edited = canonical(&b.live_document());
+        assert_ne!(edited, start);
+        switch(&mut page);
+        let st = a.session.doc().map_err(e)?;
+        let (undo_steps, selection, second) = (st.history.undo.len(), st.selection.clone(), st.doc.slides[1].clone());
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(start.clone()), edited.clone(), Box::new(move |r| to.set(r.is_ok())));
+        let st = a.session.doc_mut().map_err(e)?;
+        st.interaction = Some(Interaction { label: "Move".into(), doc: st.doc.clone(), selection: st.selection.clone() });
+        playground_live::frame(&mut a);
+        assert!(!done.get(), "a gesture under way holds remote changes");
+        a.session.doc_mut().map_err(e)?.interaction = None;
+        playground_live::frame(&mut a);
+        assert!(done.get());
+        assert_eq!(canonical(&a.live_document()), edited);
+        let st = a.session.doc().map_err(e)?;
+        assert_eq!((st.history.undo.len(), &st.selection, st.doc.guides.len()), (undo_steps, &selection, 1));
+        assert!(Arc::ptr_eq(&st.doc.slides[1], &second), "an unchanged slide keeps its Arc");
+        assert_eq!((kept(&a), kept(&b)), (Some(1), Some(0)), "parts stay where they were");
+
+        // Undo goes to the session; new objects get unused ids unique to this peer.
+        assert_eq!(a.session.execute("edit.undo", &json!({})).map_err(e)?, Value::Null);
+        assert_eq!(playground_live::activity().1, [false]);
+        let id = a.session.edit(|d, _| Ok(d.alloc_id())).map_err(e)?.unwrap_or_default();
+        assert!((0x4000_0000..0x8000_0000).contains(&id) && a.session.doc().map_err(e)?.doc.next_id >= id);
+
+        // Only the session's presentations, each id once, are recorded or installed.
+        for bad in [json!(null), json!([1]), json!({"slides": 5}), json!({"documents": [{"id": 1, "name": "x", "slides": 5}]})] {
+            assert!(SlideApp::live_check(&bad).is_err() && a.live_adopt(bad).is_err());
+        }
+        let one = parse(&edited)?["documents"][0].clone();
+        assert!(SlideApp::live_check(&json!({"documents": [one.clone(), one]})).is_err());
+        assert!(SlideApp::live_check(&parse(&edited)?).is_ok());
+        playground_live::disconnect();
+        Ok(())
+    }
+
+    #[test]
+    fn the_slide_strip_badges_the_others_on_each_slide_of_this_presentation() {
+        let mut a = SlideApp::new(Session::new(), Services::default());
+        let who = |name: &str, doc: u64, slide: u32| Presence { id: name.into(), name: name.into(), color: [1, 2, 3], state: json!({"doc": doc, "slide": slide}) };
+        a.live_show_presence(vec![who("A", 7, 2), who("B", 7, 3), who("C", 8, 2)]);
+        let model = OTHERS.with_borrow(|o| on_slides(o, 7).into_iter().map(|(s, on)| (s, on.iter().map(|&k| o[k].who.name.clone()).collect())).collect::<Vec<(u64, Vec<String>)>>());
+        assert_eq!(model, [(2, vec!["A".to_string()]), (3, vec!["B".to_string()])]);
+        a.live_show_presence(Vec::new());
+    }
+
+    #[test]
+    fn a_presentation_opened_in_a_session_reaches_the_others_behind_their_own_and_stays_closed_where_closed() -> Result<(), String> {
+        install();
+        SHARED.take();
+        let mut a = sample()?;
+        // Open before the session: this person's own.
+        a.session.execute("file.new", &json!({})).map_err(e)?;
+        a.session.set_active(0);
+        playground_live::connect();
+        let base = a.live_document();
+        assert_eq!(base["documents"].as_array().map(Vec::len), Some(1));
+        let mut page = Shared::default();
+        switch(&mut page);
+        let mut b = sample()?;
+        b.live_adopt(base)?;
+        switch(&mut page);
+
+        a.session.execute("file.new", &json!({})).map_err(e)?;
+        a.session.execute("slide.new", &json!({})).map_err(e)?;
+        let opened = a.live_document();
+        assert_eq!(opened["documents"].as_array().map(Vec::len), Some(2), "it joins the session");
+        assert!(active_id(&a.session).is_some(), "its Undo goes to the session");
+        a.session.set_active(1);
+        assert!(active_id(&a.session).is_none(), "but not the one open before");
+
+        switch(&mut page);
+        b.live_adopt(opened.clone())?;
+        assert_eq!((b.session.documents().len(), b.session.active_index()), (2, Some(0)), "a window behind b's own");
+        assert!(b.toast.is_some(), "and a word about it");
+        assert_eq!(canonical(&b.live_document()), canonical(&opened));
+        b.session.close_document(1);
+        assert_eq!(canonical(&b.live_document()), canonical(&opened), "closing is personal");
+        let mut edited = opened.clone();
+        edited["documents"][1]["firstSlideNumber"] = json!(5);
+        b.live_adopt(edited.clone())?;
+        assert_eq!(b.session.documents().len(), 1, "a change does not open it again");
+        assert_eq!(canonical(&b.live_document()), canonical(&edited));
+        switch(&mut page);
+        playground_live::disconnect();
+        Ok(())
+    }
+}
