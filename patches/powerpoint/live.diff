+//! Playground live editing (`playground_live`): the shared document is one presentation's model as JSON (written as
+//! the native save writes it, non-finite numbers as 0) with its media's bytes and without the id counter, the drawing
+//! guides or this person's views (selection, current slide, zoom, panes). Native undo history stays local; while
+//! connected, Undo and Redo of the shared presentation go to the session.
+//!
+//! Presence: each person shares the slide they show, their pointer on it (slide points) and their selected shapes; the
+//! others on the same slide are drawn over the canvas in their color (`web/live.rs` calls [`frame`] after each frame).
+//!
+//! Upstream calls in through two hooks (rules in patches/powerpoint.yaml): `deckcraft_engine::LIVE_UNDO` at the top of
+//! `Session::execute` and `deckcraft_model::LIVE_ALLOC` at the top of `Presentation::alloc_id`.
+
+// The frame hook and drawing run in the browser only.
+#![cfg_attr(test, allow(dead_code))]
+
+#[path = "playground_live.rs"]
+#[allow(dead_code)]
+pub mod playground_live;
+mod finite;
+
+use deckcraft_engine::geom::Point;
+use deckcraft_engine::model::{Presentation, ShapeId, Slide, find_shape_mut, walk};
+use deckcraft_engine::cmd::{base64_decode, base64_encode, xfrm_of};
+use deckcraft_engine::{DocState, Session, Target};
+use deckcraft_ui_egui::SlideApp;
+use egui::{Color32, FontId, Pos2, Rect, Shape, Stroke, vec2};
+use finite::Finite;
+use playground_live::{Live, Presence};
+use serde::Deserialize as _;
+use serde_json::{Value, json};
+use std::cell::{Cell, RefCell};
+use std::sync::Arc;
+
+pub const FORMAT: &str = concat!("powerpoint:1:", env!("CARGO_PKG_VERSION"));
+
+thread_local! {
+    /// The shared presentation, bound when the session first reads it: the active one's `uid` (None: nothing was open)
+    /// and its last document, which stays the shared one after its window closes.
+    static SHARED: RefCell<Option<(Option<u64>, Arc<Presentation>)>> = const { RefCell::new(None) };
+    /// A pointer is down or a text field (the notes, a ribbon box) has the keyboard.
+    static UI_BUSY: Cell<bool> = const { Cell::new(false) };
+    static CTX: RefCell<Option<egui::Context>> = const { RefCell::new(None) };
+    /// This person's pointer over the canvas, in slide points, as of the last frame.
+    static POINTER: Cell<Option<[f64; 2]>> = const { Cell::new(None) };
+    /// The others in the session, as the shell last gave them.
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Hooks the engine's Undo and Redo and the model's id allocator.
+pub fn install() {
+    let _ = deckcraft_engine::LIVE_UNDO.set(undo);
+    let _ = deckcraft_engine::model::LIVE_ALLOC.set(alloc_id);
+}
+
+/// The end of a frame. `kept`: the slide rect from before the frame, put back when the canvas was not drawn (the
+/// caller cleared it so a drawn canvas shows).
+pub fn frame(app: &mut SlideApp, ui: &egui::Ui, kept: Option<Rect>) {
+    let ctx = ui.ctx();
+    UI_BUSY.set(ctx.input(|i| i.pointer.any_down()) || ctx.egui_wants_keyboard_input());
+    CTX.with_borrow_mut(|c| _ = c.get_or_insert_with(|| ctx.clone()));
+    let canvas = app.canvas_rect.zip(app.slide_rect).map(|(canvas, slide)| (canvas, slide.min, app.canvas_scale));
+    if app.slide_rect.is_none() {
+        app.slide_rect = kept;
+    }
+    let hover = ctx.input(|i| i.pointer.hover_pos());
+    POINTER.set(canvas.and_then(|(rect, origin, scale)| {
+        let p = hover.filter(|p| rect.contains(*p))?;
+        let at = |v: f32, o: f32| (f64::from((v - o) / scale) * 10.0).round() / 10.0;
+        Some([at(p.x, origin.x), at(p.y, origin.y)])
+    }));
+    if let Some(canvas) = canvas {
+        draw_presence(app, ui, canvas);
+    }
+    playground_live::frame(app);
+}
+
+pub fn repaint() {
+    CTX.with_borrow(|c| c.iter().for_each(egui::Context::request_repaint));
+}
+
+/// The uid of the shared presentation, once bound.
+fn shared_uid() -> Option<u64> {
+    SHARED.with_borrow(|s| s.as_ref().and_then(|s| s.0))
+}
+
+/// `Session::execute`'s first step: the session takes Undo and Redo while the shared presentation is the active one.
+pub fn undo(session: &mut Session, command: &str) -> bool {
+    let redo = match command {
+        "edit.undo" => false,
+        "edit.redo" => true,
+        _ => return false,
+    };
+    if shared_uid().is_none() || session.active().map(|d| d.uid) != shared_uid() {
+        return false;
+    }
+    // As before any Undo, an input method's composition settles first.
+    session.end_composition();
+    playground_live::undo(redo)
+}
+
+/// `Presentation::alloc_id`'s first step: while connected an unused id from 2^30..2^31, random, so two people adding
+/// objects at once do not pick the same one. None: the usual next id.
+pub fn alloc_id(p: &mut Presentation) -> Option<u32> {
+    if !playground_live::connected() {
+        return None;
+    }
+    loop {
+        let fresh = playground_live::fresh_id(&mut u64::from(p.next_id));
+        let id = 0x4000_0000 | (fresh as u32 & 0x3FFF_FFFF);
+        if !uses_id(p, id) {
+            p.next_id = p.next_id.max(id);
+            return Some(id);
+        }
+    }
+}
+
+/// Whether a slide, shape, layout, master or media item has `id`.
+fn uses_id(p: &Presentation, id: u32) -> bool {
+    let mut used = p.media.iter().any(|m| m.id.0 == id);
+    let mut tree = |own: u32, shapes: &[deckcraft_engine::model::Shape]| {
+        used |= own == id;
+        walk(shapes, &mut |sh, _| used |= sh.id.0 == id);
+    };
+    for s in &p.slides {
+        tree(s.id.0, &s.shapes);
+    }
+    for m in p.masters.iter().chain(&p.notes_master).chain(&p.handout_master) {
+        tree(m.id.0, &m.shapes);
+        for l in &m.layouts {
+            tree(l.id.0, &l.shapes);
+        }
+    }
+    used
+}
+
+/// The shared presentation's uid, its index while open, and its document.
+fn shared(app: &SlideApp) -> (Option<u64>, Option<usize>, Arc<Presentation>) {
+    let docs = app.session.documents();
+    SHARED.with_borrow_mut(|s| {
+        let (uid, last) = s.get_or_insert_with(|| match app.session.active() {
+            Some(d) => (Some(d.uid), d.doc.clone()),
+            None => (None, Arc::new(Presentation::default())),
+        });
+        let i = uid.and_then(|uid| docs.iter().position(|d| d.uid == uid));
+        if let Some(i) = i {
+            *last = docs[i].doc.clone();
+        }
+        (*uid, i, last.clone())
+    })
+}
+
+fn json<T: serde::Serialize + ?Sized>(value: &T) -> Value {
+    serde_json::to_value(Finite(value)).unwrap_or_default()
+}
+
+fn project(doc: &Presentation) -> Value {
+    let mut v = json(doc);
+    v.as_object_mut().map(|o| (o.remove("nextId"), o.remove("guides")));
+    for (m, item) in v.get_mut("media").and_then(Value::as_array_mut).into_iter().flatten().zip(&doc.media) {
+        m["data"] = base64_encode(&item.data).into();
+    }
+    v
+}
+
+/// Old `Arc`s for the items whose JSON (`incoming`; `was` for `old`) did not change, so caches keyed by them (slide
+/// textures) stay warm and parts the JSON leaves out stay.
+fn reuse<T>(new: &mut [Arc<T>], incoming: &Value, was: &Value, old: &[Arc<T>]) {
+    let (Some(incoming), Some(was)) = (incoming.as_array(), was.as_array()) else { return };
+    // ponytail: quadratic in the item count, fine for slides and masters; index by id if decks grow huge.
+    for (n, v) in new.iter_mut().zip(incoming) {
+        if let Some(o) = was.iter().position(|w| w == v).and_then(|j| old.get(j)) {
+            *n = o.clone();
+        }
+    }
+}
+
+/// In a changed slide, a shape whose JSON did not change stays as it was, with the parts the JSON leaves out (a chart's
+/// package parts from the file: its embedded workbook).
+fn keep_shapes(new: &mut Arc<Slide>, old: &Slide) {
+    // ponytail: serializes every shape of the slide (group members again with their group); fine for slide-sized trees.
+    walk(&old.shapes, &mut |o, _| {
+        if let Some(n) = find_shape_mut(&mut Arc::make_mut(new).shapes, o.id)
+            && json(&*n) == json(o)
+        {
+            *n = o.clone();
+        }
+    });
+}
+
+fn invalid(e: impl std::fmt::Display) -> String {
+    format!("Invalid shared document: {e}")
+}
+
+/// A number from another person's presence, if it is one worth drawing.
+fn coordinate(v: &Value) -> Option<f32> {
+    v.as_f64().filter(|v| v.abs() < 1e6).map(|v| v as f32)
+}
+
+/// The others on the slide this person shows: their selected shapes outlined and their pointer with their name, in
+/// their color. `canvas`: the canvas rect and the slide's screen origin and scale this frame.
+fn draw_presence(app: &SlideApp, ui: &egui::Ui, (canvas, origin, scale): (Rect, Pos2, f32)) {
+    OTHERS.with_borrow(|others| {
+        let Some(st) = app.session.active().filter(|d| others.len() > 0 && Some(d.uid) == shared_uid()) else { return };
+        let Some(slide) = st.doc.slides.get(st.selection.slide).filter(|_| st.selection.target == Target::Slides) else { return };
+        let painter = ui.painter().with_clip_rect(canvas);
+        let screen = |p: Point| Pos2::new(origin.x + p.x as f32 * scale, origin.y + p.y as f32 * scale);
+        for other in others.iter().filter(|o| o.state["slide"].as_u64() == Some(u64::from(slide.id.0))) {
+            let [r, g, b] = other.color;
+            let color = Color32::from_rgb(r, g, b);
+            let stroke = Stroke::new(2.0, color);
+            let ids = other.state["selection"].as_array().into_iter().flatten().take(50);
+            for sh in ids.filter_map(|id| st.shape(ShapeId(u32::try_from(id.as_u64()?).ok()?))) {
+                let x = xfrm_of(&st.doc, &st.selection, sh);
+                let a = x.affine();
+                let corner = |cx: f64, cy: f64| screen(a * Point::new(cx, cy));
+                if sh.is_line() {
+                    painter.line_segment([corner(0.0, 0.0), corner(x.w, x.h)], stroke);
+                } else {
+                    let c = [corner(0.0, 0.0), corner(x.w, 0.0), corner(x.w, x.h), corner(0.0, x.h)];
+                    painter.add(Shape::closed_line(c.to_vec(), stroke));
+                }
+            }
+            let pointer = &other.state["pointer"];
+            let (Some(x), Some(y)) = (coordinate(&pointer[0]), coordinate(&pointer[1])) else { continue };
+            let tip = Pos2::new(origin.x + x * scale, origin.y + y * scale);
+            painter.add(Shape::convex_polygon(vec![tip, tip + vec2(0.0, 16.0), tip + vec2(11.0, 11.0)], color, Stroke::new(1.0, Color32::WHITE)));
+            let name: String = other.name.chars().take(32).collect();
+            let text = painter.layout_no_wrap(name, FontId::proportional(11.0), Color32::WHITE);
+            let tag = Rect::from_min_size(tip + vec2(10.0, 14.0), text.size() + vec2(8.0, 4.0));
+            painter.rect_filled(tag, 3.0, color);
+            painter.galley(tag.min + vec2(4.0, 2.0), text, Color32::WHITE);
+        }
+    });
+}
+
+impl Live for SlideApp {
+    fn live_document(&self) -> Value {
+        project(&shared(self).2)
+    }
+
+    fn live_adopt(&mut self, mut document: Value) -> Result<(), String> {
+        Self::live_check(&document)?;
+        let (uid, i, old) = shared(self);
+        let was = json(&*old);
+        // The drawing guides stay this person's own (newer upstream only).
+        if let Some(guides) = was.get("guides") {
+            document["guides"] = guides.clone();
+        }
+        let mut doc = Presentation::deserialize(&document).map_err(invalid)?;
+        reuse(&mut doc.slides, &document["slides"], &was["slides"], &old.slides);
+        for s in &mut doc.slides {
+            if let Some(o) = old.slides.iter().find(|o| o.id == s.id && !Arc::ptr_eq(o, s)) {
+                keep_shapes(s, o);
+            }
+        }
+        reuse(&mut doc.masters, &document["masters"], &was["masters"], &old.masters);
+        for (extra, kept, key) in [(&mut doc.notes_master, &old.notes_master, "notesMaster"), (&mut doc.handout_master, &old.handout_master, "handoutMaster")] {
+            if was[key] == document[key] {
+                extra.clone_from(kept);
+            }
+        }
+        for (item, v) in doc.media.iter_mut().zip(document["media"].as_array().into_iter().flatten()) {
+            let data = v["data"].as_str().and_then(base64_decode).unwrap_or_default();
+            item.data = old.media.iter().find(|o| o.id == item.id && *o.data == data).map_or_else(|| Arc::new(data), |o| o.data.clone());
+        }
+        doc.next_id = old.next_id;
+        doc.fix_next_id();
+        let doc = Arc::new(doc);
+        SHARED.with_borrow_mut(|s| s.as_mut().map(|s| s.1 = doc.clone()));
+        let i = match (uid, i) {
+            (_, Some(i)) => i,
+            // Its window was closed: the session's document lives on here, unseen.
+            (Some(_), None) => return Ok(()),
+            // Nothing was open: it opens.
+            (None, None) => {
+                let title = self.session.next_untitled();
+                let i = self.session.add_document(DocState::new((*doc).clone(), None, title));
+                let st = &self.session.documents()[i];
+                SHARED.set(Some((Some(st.uid), st.doc.clone())));
+                return Ok(());
+            }
+        };
+        let active = self.session.active_index();
+        self.session.set_active(i);
+        let st = self.session.active_mut().ok_or("No presentation")?;
+        // The same slide stays current, and text being edited stays so unless it changed.
+        let slide = old.slides.get(st.selection.slide).map(|s| s.id);
+        let text = |st: &DocState| {
+            st.selection.text.as_ref().map(|t| (t.notes.then(|| st.current_slide().map(|s| s.notes.clone())), st.shape(t.shape).cloned()))
+        };
+        let editing = text(st);
+        st.doc = doc;
+        st.revision += 1;
+        if let Some(at) = slide.and_then(|id| st.doc.slide_index(id)) {
+            st.selection.slide = at;
+        }
+        if text(st) != editing {
+            st.selection.text = None;
+        }
+        let _ = self.session.select(|_, _| {});
+        if let Some(active) = active {
+            self.session.set_active(active);
+        }
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        !UI_BUSY.get()
+            && !self.session.tool.dragging()
+            && !self.session.tool.drawing_freeform()
+            && self.session.documents().iter().all(|d| d.interaction.is_none() && d.composition.is_none())
+    }
+
+    /// The shared document's address: a new one for every change, and none is reused while it is held here.
+    fn live_generation(&self) -> Option<u64> {
+        Some(Arc::as_ptr(&shared(self).2) as u64)
+    }
+
+    fn live_disconnected(&mut self) {
+        let Some((Some(uid), _)) = SHARED.take() else { return };
+        let Some(i) = self.session.documents().iter().position(|d| d.uid == uid) else { return };
+        let active = self.session.active_index();
+        self.session.set_active(i);
+        if let Some(st) = self.session.active_mut() {
+            st.history.undo.clear();
+            st.history.redo.clear();
+        }
+        if let Some(active) = active {
+            self.session.set_active(active);
+        }
+    }
+
+    /// Only a presentation every peer can open is recorded.
+    fn live_check(document: &Value) -> Result<(), String> {
+        if !document.is_object() {
+            return Err("Conflict: not a presentation".into());
+        }
+        Presentation::deserialize(document).map(drop).map_err(invalid)
+    }
+
+    /// `{slide, pointer?, selection}` on a slide of the shared presentation (`{}` on its masters and layouts).
+    fn live_presence(&self) -> Value {
+        let Some(st) = self.session.active().filter(|d| shared_uid() == Some(d.uid)) else { return Value::Null };
+        let Some(slide) = st.doc.slides.get(st.selection.slide).filter(|_| st.selection.target == Target::Slides) else {
+            return json!({});
+        };
+        let selection: Vec<u32> = st.selection.shapes.iter().take(50).map(|id| id.0).collect();
+        let mut v = json!({"slide": slide.id.0, "selection": selection});
+        if let Some(p) = POINTER.get() {
+            v["pointer"] = json!(p);
+        }
+        v
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use deckcraft_engine::model::chart::ChartPart;
+    use deckcraft_engine::model::{DrawGuide, ShapeKind};
+    use deckcraft_engine::{EngineError, Interaction, Mods};
+    use deckcraft_ui_egui::Services;
+    use playground_live::canonical;
+
+    fn sample() -> Result<SlideApp, String> {
+        let mut app = SlideApp::new(Session::new(), Services::default());
+        deckcraft_engine::sample::open_sample(&mut app.session).map_err(|e| e.to_string())?;
+        Ok(app)
+    }
+
+    fn e(e: EngineError) -> String {
+        e.to_string()
+    }
+
+    #[test]
+    fn shares_the_deck_without_views_adopts_it_without_an_undo_step_and_waits_for_a_gesture() -> Result<(), String> {
+        install();
+        let mut a = sample()?;
+        // A chart with package parts from a file, which the JSON leaves out.
+        let chart = a.session.execute("insert.chart", &json!({})).map_err(e)?["id"].as_u64().unwrap_or_default();
+        a.session.edit(|d, _| {
+            let shape = find_shape_mut(&mut Arc::make_mut(&mut d.slides[0]).shapes, ShapeId(chart as u32));
+            if let Some(ShapeKind::Chart(c)) = shape.map(|s| &mut s.kind) {
+                c.kept.parts.push(ChartPart { name: "ppt/embeddings/Workbook.xlsx".into(), content_type: "xlsx".into(), bytes: vec![1, 2] });
+            }
+            Ok(())
+        })
+        .map_err(e)?;
+        let kept = |app: &SlideApp| {
+            let st = app.session.documents().first().map(|d| d.doc.clone());
+            st.and_then(|d| match &d.slides[0].shapes.iter().find(|s| u64::from(s.id.0) == chart)?.kind {
+                ShapeKind::Chart(c) => Some(c.kept.parts.len()),
+                _ => None,
+            })
+        };
+        playground_live::connect();
+        assert_eq!(a.live_presence(), Value::Null, "nothing is shared before the session reads it");
+        let start = canonical(&a.live_document());
+        let ids: Vec<u32> = a.session.doc().map_err(e)?.doc.slides[0].shapes.iter().map(|s| s.id.0).collect();
+        a.session.execute("edit.select", &json!({"ids": [ids[0]]})).map_err(e)?;
+        assert_eq!(a.live_presence(), json!({"slide": a.session.doc().map_err(e)?.doc.slides[0].id.0, "selection": [ids[0]]}));
+        a.session.execute("slide.next", &json!({})).map_err(e)?;
+        a.ui.zoom = Some(2.0);
+        a.session.edit(|d, _| Ok(d.guides.push(DrawGuide { vertical: true, pos: 100.0 }))).map_err(e)?;
+        assert_eq!(canonical(&a.live_document()), start, "views are not shared");
+        let text = String::from_utf8_lossy(&start).into_owned();
+        assert!(!text.contains("\"nextId\"") && !text.contains("\"guides\""));
+
+        // A joiner adopts it whole and shares the same bytes (each peer has its own binding: swapped while B acts).
+        let mut other = None;
+        let switch = |other: &mut Option<_>| SHARED.with_borrow_mut(|s| std::mem::swap(s, other));
+        switch(&mut other);
+        let mut b = sample()?;
+        b.session.execute("slide.new", &json!({})).map_err(e)?;
+        b.live_adopt(serde_json::from_slice(&start).map_err(|e| e.to_string())?)?;
+        assert_eq!(canonical(&b.live_document()), start);
+
+        // B types into the subtitle; A merges it at a quiet frame, keeping its views, its guides, its undo history,
+        // the slides that did not change and the chart's parts.
+        b.session.execute("slide.first", &json!({})).map_err(e)?;
+        b.session.execute("edit.select", &json!({"ids": [ids[1]]})).map_err(e)?;
+        b.session.type_text("B").map_err(e)?;
+        b.session.key("Escape", Mods::default()).map_err(e)?;
+        let edited = canonical(&b.live_document());
+        assert_ne!(edited, start);
+        switch(&mut other);
+        let st = a.session.doc().map_err(e)?;
+        let (undo_steps, selection, second) = (st.history.undo.len(), st.selection.clone(), st.doc.slides[1].clone());
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(start.clone()), edited.clone(), Box::new(move |r| to.set(r.is_ok())));
+        let st = a.session.doc_mut().map_err(e)?;
+        st.interaction = Some(Interaction { label: "Move".into(), doc: st.doc.clone(), selection: st.selection.clone() });
+        playground_live::frame(&mut a);
+        assert!(!done.get(), "a gesture under way holds remote changes");
+        a.session.doc_mut().map_err(e)?.interaction = None;
+        playground_live::frame(&mut a);
+        assert!(done.get());
+        assert_eq!(canonical(&a.live_document()), edited);
+        let st = a.session.doc().map_err(e)?;
+        assert_eq!((st.history.undo.len(), &st.selection, st.doc.guides.len()), (undo_steps, &selection, 1));
+        assert!(Arc::ptr_eq(&st.doc.slides[1], &second), "an unchanged slide keeps its Arc");
+        assert_eq!((kept(&a), kept(&b)), (Some(1), Some(0)), "parts stay where they were");
+
+        // Undo goes to the session; new objects get unused ids unique to this peer.
+        assert_eq!(a.session.execute("edit.undo", &json!({})).map_err(e)?, Value::Null);
+        assert_eq!(playground_live::activity().1, [false]);
+        let id = a.session.edit(|d, _| Ok(d.alloc_id())).map_err(e)?.unwrap_or_default();
+        assert!((0x4000_0000..0x8000_0000).contains(&id) && a.session.doc().map_err(e)?.doc.next_id >= id);
+
+        // Another presentation becomes active: it is not shared, its Undo is its own and it shows no presence.
+        a.session.execute("file.new", &json!({})).map_err(e)?;
+        a.session.execute("slide.new", &json!({})).map_err(e)?;
+        assert_eq!((canonical(&a.live_document()), a.live_presence()), (edited.clone(), Value::Null));
+        let slides = a.session.doc().map_err(e)?.doc.slides.len();
+        a.session.execute("edit.undo", &json!({})).map_err(e)?;
+        assert_eq!((a.session.doc().map_err(e)?.doc.slides.len(), playground_live::activity().1.len()), (slides - 1, 1));
+
+        // The shared one closes: it stays the shared document, and remote changes still reach it.
+        a.session.close_document(0);
+        assert_eq!(canonical(&a.live_document()), edited);
+        let mut later: Value = serde_json::from_slice(&edited).map_err(|e| e.to_string())?;
+        later["firstSlideNumber"] = json!(5);
+        a.live_adopt(later.clone())?;
+        assert_eq!((canonical(&a.live_document()), a.session.documents().len()), (canonical(&later), 1));
+
+        // Only presentations are recorded or installed.
+        for bad in [json!(null), json!([1]), json!({"slides": 5})] {
+            assert!(SlideApp::live_check(&bad).is_err() && a.live_adopt(bad).is_err());
+        }
+        assert!(SlideApp::live_check(&later).is_ok());
+        playground_live::disconnect();
+        Ok(())
+    }
+}
diff --git a/apps/deckcraft-web/src/live/finite.rs b/apps/deckcraft-web/src/live/finite.rs
new file mode 100644
index 0000000..440fdfc
--- /dev/null
+++ b/apps/deckcraft-web/src/live/finite.rs
@@ -0,0 +1,163 @@
+//! Non-finite floats written as 0: serde_json writes NaN and ±infinity as `null`, which does not read back as a number,
+//! so one NaN in the model (a rotation, a crop) would make the shared document fail to install on every peer. The same
+//! adapter as upstream's crates/format/src/finite.rs (absent from older releases); delete this copy and use
+//! `deckcraft_format::finite` once every channel has it public.
+
+use serde::ser::{self, Serialize, Serializer};
+
+/// `T`, serialized with non-finite floats written as 0.
+pub struct Finite<'a, T: ?Sized>(pub &'a T);
+
+impl<T: ?Sized + Serialize> Serialize for Finite<'_, T> {
+    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        self.0.serialize(Wrap(s))
+    }
+}
+
+struct Wrap<S>(S);
+
+macro_rules! pass {
+    ($($m:ident($t:ty)),* $(,)?) => {
+        $(fn $m(self, v: $t) -> Result<S::Ok, S::Error> { self.0.$m(v) })*
+    };
+}
+
+impl<S: Serializer> Serializer for Wrap<S> {
+    type Ok = S::Ok;
+    type Error = S::Error;
+    type SerializeSeq = Wrap<S::SerializeSeq>;
+    type SerializeTuple = Wrap<S::SerializeTuple>;
+    type SerializeTupleStruct = Wrap<S::SerializeTupleStruct>;
+    type SerializeTupleVariant = Wrap<S::SerializeTupleVariant>;
+    type SerializeMap = Wrap<S::SerializeMap>;
+    type SerializeStruct = Wrap<S::SerializeStruct>;
+    type SerializeStructVariant = Wrap<S::SerializeStructVariant>;
+
+    pass!(
+        serialize_bool(bool),
+        serialize_i8(i8),
+        serialize_i16(i16),
+        serialize_i32(i32),
+        serialize_i64(i64),
+        serialize_i128(i128),
+        serialize_u8(u8),
+        serialize_u16(u16),
+        serialize_u32(u32),
+        serialize_u64(u64),
+        serialize_u128(u128),
+        serialize_char(char),
+        serialize_str(&str),
+        serialize_bytes(&[u8]),
+    );
+
+    fn serialize_f32(self, v: f32) -> Result<S::Ok, S::Error> {
+        self.0.serialize_f32(if v.is_finite() { v } else { 0.0 })
+    }
+    fn serialize_f64(self, v: f64) -> Result<S::Ok, S::Error> {
+        self.0.serialize_f64(if v.is_finite() { v } else { 0.0 })
+    }
+    fn serialize_none(self) -> Result<S::Ok, S::Error> {
+        self.0.serialize_none()
+    }
+    fn serialize_some<T: ?Sized + Serialize>(self, v: &T) -> Result<S::Ok, S::Error> {
+        self.0.serialize_some(&Finite(v))
+    }
+    fn serialize_unit(self) -> Result<S::Ok, S::Error> {
+        self.0.serialize_unit()
+    }
+    fn serialize_unit_struct(self, name: &'static str) -> Result<S::Ok, S::Error> {
+        self.0.serialize_unit_struct(name)
+    }
+    fn serialize_unit_variant(self, name: &'static str, i: u32, variant: &'static str) -> Result<S::Ok, S::Error> {
+        self.0.serialize_unit_variant(name, i, variant)
+    }
+    fn serialize_newtype_struct<T: ?Sized + Serialize>(self, name: &'static str, v: &T) -> Result<S::Ok, S::Error> {
+        self.0.serialize_newtype_struct(name, &Finite(v))
+    }
+    fn serialize_newtype_variant<T: ?Sized + Serialize>(self, name: &'static str, i: u32, variant: &'static str, v: &T) -> Result<S::Ok, S::Error> {
+        self.0.serialize_newtype_variant(name, i, variant, &Finite(v))
+    }
+    fn serialize_seq(self, len: Option<usize>) -> Result<Self::SerializeSeq, S::Error> {
+        self.0.serialize_seq(len).map(Wrap)
+    }
+    fn serialize_tuple(self, len: usize) -> Result<Self::SerializeTuple, S::Error> {
+        self.0.serialize_tuple(len).map(Wrap)
+    }
+    fn serialize_tuple_struct(self, name: &'static str, len: usize) -> Result<Self::SerializeTupleStruct, S::Error> {
+        self.0.serialize_tuple_struct(name, len).map(Wrap)
+    }
+    fn serialize_tuple_variant(self, name: &'static str, i: u32, variant: &'static str, len: usize) -> Result<Self::SerializeTupleVariant, S::Error> {
+        self.0.serialize_tuple_variant(name, i, variant, len).map(Wrap)
+    }
+    fn serialize_map(self, len: Option<usize>) -> Result<Self::SerializeMap, S::Error> {
+        self.0.serialize_map(len).map(Wrap)
+    }
+    fn serialize_struct(self, name: &'static str, len: usize) -> Result<Self::SerializeStruct, S::Error> {
+        self.0.serialize_struct(name, len).map(Wrap)
+    }
+    fn serialize_struct_variant(
+        self,
+        name: &'static str,
+        i: u32,
+        variant: &'static str,
+        len: usize,
+    ) -> Result<Self::SerializeStructVariant, S::Error> {
+        self.0.serialize_struct_variant(name, i, variant, len).map(Wrap)
+    }
+    fn is_human_readable(&self) -> bool {
+        self.0.is_human_readable()
+    }
+}
+
+macro_rules! compound {
+    ($tr:ident, $m:ident) => {
+        impl<S: ser::$tr> ser::$tr for Wrap<S> {
+            type Ok = S::Ok;
+            type Error = S::Error;
+            fn $m<T: ?Sized + Serialize>(&mut self, v: &T) -> Result<(), S::Error> {
+                self.0.$m(&Finite(v))
+            }
+            fn end(self) -> Result<S::Ok, S::Error> {
+                self.0.end()
+            }
+        }
+    };
+}
+compound!(SerializeSeq, serialize_element);
+compound!(SerializeTuple, serialize_element);
+compound!(SerializeTupleStruct, serialize_field);
+compound!(SerializeTupleVariant, serialize_field);
+
+impl<S: ser::SerializeMap> ser::SerializeMap for Wrap<S> {
+    type Ok = S::Ok;
+    type Error = S::Error;
+    fn serialize_key<T: ?Sized + Serialize>(&mut self, k: &T) -> Result<(), S::Error> {
+        self.0.serialize_key(&Finite(k))
+    }
+    fn serialize_value<T: ?Sized + Serialize>(&mut self, v: &T) -> Result<(), S::Error> {
+        self.0.serialize_value(&Finite(v))
+    }
+    fn end(self) -> Result<S::Ok, S::Error> {
+        self.0.end()
+    }
+}
+
+macro_rules! fields {
+    ($tr:ident) => {
+        impl<S: ser::$tr> ser::$tr for Wrap<S> {
+            type Ok = S::Ok;
+            type Error = S::Error;
+            fn serialize_field<T: ?Sized + Serialize>(&mut self, key: &'static str, v: &T) -> Result<(), S::Error> {
+                self.0.serialize_field(key, &Finite(v))
+            }
+            fn skip_field(&mut self, key: &'static str) -> Result<(), S::Error> {
+                self.0.skip_field(key)
+            }
+            fn end(self) -> Result<S::Ok, S::Error> {
+                self.0.end()
+            }
+        }
+    };
+}
+fields!(SerializeStruct);
+fields!(SerializeStructVariant);
diff --git a/apps/deckcraft-web/src/web/live.rs b/apps/deckcraft-web/src/web/live.rs
