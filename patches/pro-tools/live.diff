@@ -0,0 +1,427 @@
+//! Live editing in a Playground session (web only). The shared document is the session without anyone's views: no
+//! Edit-window state (`edit`: selection, playhead, zoom, tools, modes, view flags), and per track no height, lane view,
+//! folder state, pin, record arm or input monitor. Audio reaches everyone as session files, one per source id (the
+//! built-in demo's synthesized audio excepted: every browser makes the same). Presence: each person's pointer over the
+//! Edit window's tracks (track, time, height in the row) and selection (tracks, clips, time range), drawn over the others'
+//! tracks in their color.
+
+use crate::SoundApp;
+use crate::edit_window::{rect, sample_at, x_of};
+use egui::{Color32, Pos2, Rect, Shape, Stroke, StrokeKind, Ui, pos2, vec2};
+use serde_json::{Value, json};
+use serde::Deserialize as _;
+use soundcraft_model::playground_live::{self, Live};
+use soundcraft_audio_io::{BitDepth, EncodeOptions, FileFormat};
+use soundcraft_model::playground_live::Presence;
+use soundcraft_model::{ClipId, EditState, Session, Source, SourceAudio, SourceId, Track, TrackId};
+use std::cell::RefCell;
+use std::sync::Arc;
+
+thread_local! {
+    /// The others in the session, as the shell last gave them.
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Copies what each person keeps of a track for themselves.
+fn keep_views(t: &mut Track, from: &Track) {
+    t.height = from.height;
+    t.view.clone_from(&from.view);
+    t.folder_open = from.folder_open;
+    t.pinned = from.pinned;
+    t.mixer.record_arm = from.mixer.record_arm;
+    t.mixer.input_monitor = from.mixer.input_monitor;
+}
+
+/// A new track's views: what the shared document gives every track.
+fn fresh(t: &Track) -> Track {
+    Track::new(t.id, "", t.kind, t.format, t.color)
+}
+
+/// Every playlist's clips in a shared document.
+fn clip_lists(doc: &mut Value) -> impl Iterator<Item = &mut Vec<Value>> {
+    fn items(v: Option<&mut Value>) -> impl Iterator<Item = &mut Value> {
+        v.and_then(Value::as_array_mut).into_iter().flatten()
+    }
+    items(doc.get_mut("tracks")).flat_map(|t| items(t.get_mut("playlists"))).filter_map(|p| p.get_mut("clips").and_then(Value::as_array_mut))
+}
+
+/// Undo and Redo ([`SoundApp::run`]) go to the session while one is connected: true when it took them.
+pub(crate) fn undo(command: &str) -> bool {
+    matches!(command, "edit.undo" | "edit.redo") && playground_live::undo(command == "edit.redo")
+}
+
+/// A connected session shares the open session, which then stays open: nothing replaces it (see
+/// [`crate::bounce::refuses_session_switch`]). True when refused; the status line says why.
+pub(crate) fn refuses_session_switch(app: &mut SoundApp) -> bool {
+    let refused = playground_live::connected();
+    if refused {
+        app.ui.status = "Leave the live session first: it shares this session".into();
+    }
+    refused
+}
+
+/// Whether two records describe the same audio (saving changes only where it is kept).
+fn same_audio(a: &Source, b: &Source) -> bool {
+    (&a.name, a.channels, a.frames, a.sample_rate) == (&b.name, b.channels, b.frames, b.sample_rate)
+}
+
+/// The Edit window's track under `p`, the time there and how far down its row (0 to 1), as of the last frame.
+fn pointer_at(app: &SoundApp, p: Pos2) -> Option<Value> {
+    let tl = rect(app.edit_layout.timeline);
+    let (track, r) = app.edit_layout.rows.iter().find(|(_, r)| (r[1]..r[3]).contains(&p.y)).filter(|_| tl.contains(p))?;
+    let y = (f64::from((p.y - r[1]) / (r[3] - r[1])) * 100.0).round() / 100.0;
+    Some(json!({"track": track, "at": sample_at(app.engine.session(), tl, p.x), "y": y}))
+}
+
+/// Where another person's pointer ([`pointer_at`]) is on this person's Edit window.
+fn pointer_pos(app: &SoundApp, v: &Value) -> Option<Pos2> {
+    let (track, at, y) = (v["track"].as_u64()?, v["at"].as_i64().filter(|at| at.unsigned_abs() < 1 << 48)?, v["y"].as_f64()?);
+    let (_, r) = app.edit_layout.rows.iter().find(|(id, _)| *id == track)?;
+    let tl = rect(app.edit_layout.timeline);
+    let p = pos2(x_of(app.engine.session(), tl, at), r[1] + (r[3] - r[1]) * y.clamp(0.0, 1.0) as f32);
+    tl.contains(p).then_some(p)
+}
+
+/// The others' pointers with their names, and outlines around what they selected, over the Edit window's tracks.
+pub(crate) fn draw_presence(app: &SoundApp, ui: &Ui) {
+    let (s, tl) = (app.engine.session(), rect(app.edit_layout.timeline));
+    let painter = ui.painter().with_clip_rect(tl);
+    let ids = |v: &Value| v.as_array().into_iter().flatten().filter_map(Value::as_u64).take(50).collect::<Vec<_>>();
+    let x = |at: Option<i64>| at.filter(|at| at.unsigned_abs() < 1 << 48).map(|at| x_of(s, tl, at));
+    // An outline from time `a` to `b` (at least 2 points wide: an insertion point) on a lane, when any of it shows.
+    let outline = |a: f32, b: f32, (y0, y1): (f32, f32), width: f32, color: Color32| {
+        if b >= tl.min.x && a <= tl.max.x {
+            let r = Rect::from_min_max(pos2(a.max(tl.min.x - 4.0), y0), pos2(b.max(a + 2.0).min(tl.max.x + 4.0), y1));
+            painter.rect_stroke(r, 2.0, Stroke::new(width, color), StrokeKind::Inside);
+        }
+    };
+    // The main lane of a track's row (alternate playlists below it are this person's view).
+    let lane = |track: u64| {
+        let (_, r) = app.edit_layout.rows.iter().find(|(id, _)| *id == track)?;
+        let h = s.track(TrackId(track)).map_or(r[3] - r[1], |t| t.height.points().min(r[3] - r[1]));
+        Some((r[1] + 1.0, r[1] + h - 1.0))
+    };
+    OTHERS.with_borrow(|others| {
+        for o in others {
+            let color = Color32::from_rgb(o.color[0], o.color[1], o.color[2]);
+            let state = &o.state["selection"];
+            let range = &state["range"];
+            if let (Some(a), Some(b)) = (x(range[0].as_i64()), x(range[1].as_i64())) {
+                for ys in ids(&state["tracks"]).into_iter().filter_map(lane) {
+                    outline(a, b, ys, 1.5, color);
+                }
+            }
+            for clip in ids(&state["clips"]) {
+                if let Some((track, c)) = s.find_clip(ClipId(clip))
+                    && let (Some(ys), Some(a), Some(b)) = (lane(track.0), x(Some(c.start)), x(Some(c.end())))
+                {
+                    outline(a, b, ys, 2.0, color);
+                }
+            }
+            if let Some(p) = pointer_pos(app, &o.state["pointer"]) {
+                let arrow = vec![p, p + vec2(0.0, 15.0), p + vec2(10.0, 10.5)];
+                painter.add(Shape::convex_polygon(arrow, color, Stroke::new(1.0, Color32::WHITE)));
+                let name = painter.layout_no_wrap(o.name.clone(), crate::theme::regular(11.0), Color32::WHITE);
+                let tag = Rect::from_min_size(p + vec2(10.0, 12.0), name.size() + vec2(8.0, 4.0));
+                painter.rect_filled(tag, 3.0, color);
+                painter.galley(tag.min + vec2(4.0, 2.0), name, Color32::WHITE);
+            }
+        }
+    });
+}
+
+impl Live for SoundApp {
+    const COUNTERS: &'static [&'static str] = &["next_id"];
+
+    fn live_document(&self) -> Value {
+        let mut s = self.engine.session().clone();
+        for t in &mut s.tracks {
+            keep_views(t, &fresh(t));
+        }
+        s.sources.iter_mut().for_each(|s| s.unsaved = false);
+        let mut doc = serde_json::to_value(&s).unwrap_or_default();
+        if let Some(doc) = doc.as_object_mut() {
+            doc.remove("edit");
+        }
+        // Playlists keyed by their name, so clips merge one by one (a track with two of one name merges them whole).
+        for t in doc["tracks"].as_array_mut().into_iter().flatten() {
+            for p in t["playlists"].as_array_mut().into_iter().flatten() {
+                p["id"] = p["name"].clone();
+            }
+        }
+        doc
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        // A playlist keeps its clips in (start, id) order: merge them as sets (id order on every side), then sort them.
+        let by_id = |doc: &Value| {
+            let mut doc = doc.clone();
+            clip_lists(&mut doc).for_each(|clips| clips.sort_by_key(|c| c["id"].as_u64()));
+            doc
+        };
+        let mut doc = playground_live::merge(&by_id(base), &by_id(current), &by_id(edited), Self::COUNTERS)?;
+        clip_lists(&mut doc).for_each(|clips| clips.sort_by_key(|c| (c["start"].as_i64(), c["id"].as_u64())));
+        // Only a session the app opens.
+        let edit = serde_json::to_value(EditState::default()).map_err(|e| e.to_string())?;
+        doc.as_object_mut().ok_or("Not a session")?.insert("edit".into(), edit);
+        Session::deserialize(&doc).map_err(|e| format!("Invalid session: {e}"))?;
+        doc.as_object_mut().map(|doc| doc.remove("edit"));
+        Ok(doc)
+    }
+
+    fn live_adopt(&mut self, mut document: Value) -> Result<(), String> {
+        let current = self.engine.session();
+        let edit = serde_json::to_value(&current.edit).map_err(|e| e.to_string())?;
+        document.as_object_mut().ok_or("Not a session")?.insert("edit".into(), edit);
+        let mut s: Session = serde_json::from_value(document).map_err(|e| format!("Invalid session: {e}"))?;
+        // Repairs what a merge can break (clip order, a removed active playlist); the id counter stays as shared.
+        let next_id = s.next_id;
+        s.sanitize();
+        s.next_id = next_id;
+        for t in &mut s.tracks {
+            let new = fresh(t);
+            keep_views(t, current.track(t.id).unwrap_or(&new));
+        }
+        for src in &mut s.sources {
+            src.unsaved = current.source(src.id).is_some_and(|c| c.unsaved);
+        }
+        s.pool = current.pool.clone();
+        // Source ids before the session were counted on each side: this browser's own audio under a shared source's id
+        // is not that source's (it then arrives as a session file).
+        for src in &s.sources {
+            if current.source(src.id).is_some_and(|c| !same_audio(c, src)) {
+                s.pool.remove(src.id);
+            }
+        }
+        s.folder = current.folder.clone();
+        *self.engine.session_mut() = s;
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        let input = self.docking_context.as_ref().is_some_and(|ctx| ctx.input(|i| i.pointer.any_down()) || ctx.egui_wants_keyboard_input());
+        !input
+            && self.gesture.is_none()
+            && self.dialogs.open.is_none()
+            && self.bounce.is_none()
+            && !self.engine.transport.recording
+            && self.touched.is_empty()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.engine.revision)
+    }
+
+    /// Forgets Undo and Redo: their steps hold other people's edits. A step pushed with no history kept clears both.
+    fn live_disconnected(&mut self) {
+        let limit = std::mem::replace(&mut self.engine.history_limit, 0);
+        self.engine.push_undo("", Arc::new(Session::default()));
+        self.engine.history_limit = limit;
+    }
+
+    /// `{ pointer?: { track, at, y }, selection: { tracks, clips, range: [start, end] } }` (see [`pointer_at`]; an
+    /// empty range is the insertion point).
+    fn live_presence(&self) -> Value {
+        let s = self.engine.session();
+        let edit = self.ui.window == crate::MainWindow::Edit || self.ui.mix_separate;
+        let hover = self.docking_context.as_ref().and_then(|ctx| ctx.input(|i| i.pointer.hover_pos())).filter(|_| edit);
+        let selection = json!({
+            "tracks": s.edit.selected_tracks.iter().take(50).collect::<Vec<_>>(),
+            "clips": s.edit.selected_clips.iter().take(50).collect::<Vec<_>>(),
+            "range": [s.edit.selection.start, s.edit.selection.end],
+        });
+        let mut state = json!({"selection": selection});
+        if let Some(pointer) = hover.and_then(|p| pointer_at(self, p)) {
+            state["pointer"] = pointer;
+        }
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let (s, demo) = (self.engine.session(), soundcraft_engine::demo::cached_demo_session());
+        let built_in = |id| matches!((s.pool.get(id), demo.pool.get(id)), (Some(a), Some(b)) if Arc::ptr_eq(a, b));
+        s.sources.iter().filter(|src| !built_in(src.id)).map(|src| (src.id.0.to_string(), format!("{}.wav", src.name), s.pool.contains(src.id))).collect()
+    }
+
+    /// Every source id (the demo's too, which `live_assets` leaves out: nobody shares it).
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        document["sources"].as_array().into_iter().flatten().filter_map(|s| s["id"].as_u64()).map(|id| id.to_string()).collect()
+    }
+
+    /// The source's audio as a 32-bit float WAV, as a saved bundle carries it.
+    fn live_read_asset(&self, id: &str) -> Option<Vec<u8>> {
+        let audio = self.engine.session().pool.get(SourceId(id.parse().ok()?))?;
+        let wav = EncodeOptions { format: FileFormat::Wav, bit_depth: BitDepth::Float32, dither: false, bwf: None };
+        soundcraft_audio_io::encode(&audio.buffer, &wav).ok()
+    }
+
+    /// Into the pool, as opening a bundle decodes it, if it is the audio the source describes.
+    fn live_write_asset(&mut self, id: &str, _name: &str, bytes: Vec<u8>) {
+        let Some(src) = id.parse().ok().and_then(|id| self.engine.session().source(SourceId(id))) else { return };
+        let Ok((_, buf)) = soundcraft_audio_io::decode(&bytes, Some("wav")) else { return };
+        if (buf.num_channels(), buf.frames() as u64, buf.sample_rate) == (usize::from(src.channels), src.frames, src.sample_rate) {
+            let id = src.id;
+            self.engine.session_mut().pool.insert(id, Arc::new(SourceAudio::new(buf)));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Gesture, Services};
+    use serde_json::json;
+    use soundcraft_engine::Engine;
+    use soundcraft_model::playground_live::{self as live, canonical};
+    use soundcraft_model::{ChannelFormat, Clip, ClipId, SourceId, TrackHeight, TrackKind};
+
+    fn two_tracks() -> SoundApp {
+        let mut engine = Engine::default();
+        let s = engine.session_mut();
+        s.add_track(TrackKind::Audio, ChannelFormat::Mono, Some("Kick"));
+        s.add_track(TrackKind::Audio, ChannelFormat::Mono, Some("Snare"));
+        engine.mark_clean();
+        SoundApp::new(engine, None, Services::default())
+    }
+
+    fn mute(app: &mut SoundApp, track: usize) {
+        let id = app.engine.session().tracks[track].id;
+        app.run("mix.mute", json!({"tracks": [id]})).unwrap();
+    }
+
+    #[test]
+    fn the_shared_document_leaves_out_views() {
+        let mut app = two_tracks();
+        let before = canonical(&app.live_document());
+        let s = app.engine.session_mut();
+        s.edit.zoom.samples_per_px = 7.0;
+        s.edit.selection.start = 480;
+        let t = &mut s.tracks[0];
+        (t.height, t.view, t.pinned, t.mixer.record_arm) = (TrackHeight::Large, "volume".into(), true, true);
+        assert_eq!(canonical(&app.live_document()), before, "views are not shared");
+        mute(&mut app, 0);
+        let doc = app.live_document();
+        assert!(doc.get("edit").is_none());
+        assert_eq!(doc["tracks"][0]["mixer"]["mute"], true);
+        assert_eq!(doc["tracks"][0]["playlists"][0]["id"], "Kick");
+    }
+
+    #[test]
+    fn adopting_keeps_views_and_is_no_undo_step() {
+        let mut app = two_tracks();
+        let mut other = two_tracks();
+        mute(&mut other, 1);
+        other.engine.session_mut().add_track(TrackKind::Midi, ChannelFormat::Mono, Some("Keys"));
+        let s = app.engine.session_mut();
+        s.edit.selection.start = 480;
+        s.tracks[1].height = TrackHeight::Large;
+        app.live_adopt(other.live_document()).unwrap();
+        let s = app.engine.session();
+        assert!(s.tracks[1].mixer.mute && s.tracks[1].height == TrackHeight::Large && s.edit.selection.start == 480);
+        assert_eq!(s.tracks[2].view, "notes", "a new track gets its own default views");
+        assert!(!app.engine.can_undo());
+        assert_eq!(canonical(&app.live_document()), canonical(&other.live_document()));
+    }
+
+    #[test]
+    fn a_remote_change_waits_for_the_gesture_and_undo_goes_to_the_session() {
+        let mut app = two_tracks();
+        let mut other = two_tracks();
+        live::connect();
+        let base = canonical(&app.live_document());
+        mute(&mut other, 0);
+        let done = std::rc::Rc::new(std::cell::Cell::new(false));
+        let to = done.clone();
+        live::queue(Some(base), canonical(&other.live_document()), Box::new(move |r| to.set(r.is_ok())));
+        app.gesture = Some(Gesture::Scrub { last: 0 });
+        live::frame(&mut app);
+        assert!(!done.get() && !app.engine.session().tracks[0].mixer.mute, "a gesture holds remote changes");
+        app.gesture = None;
+        live::frame(&mut app);
+        assert!(done.get() && app.engine.session().tracks[0].mixer.mute);
+        mute(&mut app, 1);
+        app.run("edit.undo", json!({})).unwrap();
+        assert!(app.engine.session().tracks[1].mixer.mute, "Undo is the session's while connected");
+        assert_eq!(live::activity().1, [false]);
+        assert!(app.run("session.new", json!({})).is_err(), "the shared session stays open");
+        live::disconnect();
+        app.live_disconnected();
+        assert!(!app.engine.can_undo());
+    }
+
+    #[test]
+    fn imported_audio_travels_by_source_id_and_installs_without_an_edit() {
+        let with_import = |level: f32, frames: usize| {
+            let mut app = SoundApp::new(soundcraft_engine::demo::demo_engine(), None, Services::default());
+            let buf = soundcraft_audio_io::AudioBuffer { sample_rate: 48_000, channels: vec![vec![level; frames]] };
+            let wav = EncodeOptions { format: FileFormat::Wav, bit_depth: BitDepth::Float32, dither: false, bwf: None };
+            let bytes = soundcraft_audio_io::encode(&buf, &wav).unwrap();
+            soundcraft_engine::io::import_audio_bytes(&mut app.engine, "a.wav", &bytes, None, None, 0).unwrap();
+            app
+        };
+        let (owner, mut peer) = (with_import(0.5, 480), with_import(-0.25, 960));
+        let listed = owner.live_assets();
+        let id = owner.engine.session().sources.last().unwrap().id.to_string();
+        assert_eq!(listed, [(id.clone(), "a.wav".into(), true)], "the demo's audio is not shared");
+        assert!(SoundApp::live_assets_of(&owner.live_document()).contains(&id));
+        peer.live_adopt(owner.live_document()).unwrap();
+        assert_eq!(peer.live_assets(), [(id.clone(), "a.wav".into(), false)], "the peer's own audio under that id is not it");
+        let doc = canonical(&peer.live_document());
+        peer.live_write_asset(&id, "a.wav", owner.live_read_asset(&id).unwrap());
+        assert_eq!(peer.live_read_asset(&id), owner.live_read_asset(&id));
+        assert!(canonical(&peer.live_document()) == doc && !peer.engine.can_undo());
+    }
+
+    #[test]
+    fn a_pointer_travels_as_track_time_and_height_and_lands_through_the_viewers_own_zoom() {
+        let mut app = two_tracks();
+        let ids: Vec<u64> = app.engine.session().tracks.iter().map(|t| t.id.0).collect();
+        app.edit_layout.timeline = [100.0, 50.0, 900.0, 600.0];
+        app.edit_layout.rows = vec![(ids[0], [0.0, 50.0, 900.0, 150.0]), (ids[1], [0.0, 151.0, 900.0, 251.0])];
+        let pointer = pointer_at(&app, pos2(400.0, 201.0)).unwrap();
+        assert_eq!((pointer["track"].as_u64(), pointer["y"].as_f64()), (Some(ids[1]), Some(0.5)));
+        assert!(pointer_at(&app, pos2(50.0, 201.0)).is_none(), "over the track headers");
+        let mut other = two_tracks();
+        other.engine.session_mut().edit.zoom.samples_per_px *= 2.0;
+        other.edit_layout.timeline = app.edit_layout.timeline;
+        other.edit_layout.rows = vec![(ids[1], [0.0, 50.0, 900.0, 250.0])];
+        assert_eq!(pointer_pos(&other, &pointer), Some(pos2(250.0, 150.0)), "half as far at twice the samples per point");
+        for junk in [json!({"track": ids[1], "at": i64::MAX, "y": 0.5}), json!({"track": "a", "at": 0, "y": 0}), json!(null)] {
+            assert_eq!(pointer_pos(&other, &junk), None);
+        }
+    }
+
+    #[test]
+    fn clips_added_or_moved_at_once_merge_in_start_order() {
+        let mut app = two_tracks();
+        let s = app.engine.session_mut();
+        for (id, at) in [(10, 0), (11, 100), (12, 200), (13, 300)] {
+            s.tracks[0].playlists[0].clips.push(Clip::audio(ClipId(id), "c", SourceId(9), 0, at, 50));
+        }
+        let base = app.live_document();
+        let edited = |edit: &dyn Fn(&mut Session)| {
+            let mut app = two_tracks();
+            app.live_adopt(base.clone()).unwrap();
+            let s = app.engine.session_mut();
+            edit(s);
+            s.tracks[0].playlists[0].sort();
+            app.live_document()
+        };
+        let clip = |s: &mut Session, id: u64, at: i64| s.tracks[0].playlists[0].clips.push(Clip::audio(ClipId(id), "c", SourceId(9), 0, at, 50));
+        let moved = |s: &mut Session, id: u64, at: i64| s.find_clip_mut(ClipId(id)).unwrap().start = at;
+        let added = (edited(&|s| clip(s, 1000, 150)), edited(&|s| clip(s, 2000, 120)));
+        let reordered = (edited(&|s| moved(s, 10, 250)), edited(&|s| moved(s, 13, 50)));
+        for (c, e) in [added, reordered] {
+            let merged = SoundApp::live_merge(&base, &c, &e).unwrap();
+            let starts: Vec<_> = merged["tracks"][0]["playlists"][0]["clips"].as_array().unwrap().iter().map(|c| c["start"].as_i64()).collect();
+            assert!(starts.is_sorted(), "{starts:?}");
+            app.live_adopt(merged.clone()).unwrap();
+            assert_eq!(canonical(&app.live_document()), canonical(&merged), "the receiver does not sort it again");
+        }
+        assert!(SoundApp::live_merge(&base, &base, &json!(null)).is_err());
+    }
+}
