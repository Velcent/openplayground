@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT OR Apache-2.0
+# Playground's browser build of TraceDraw (patches/coreldraw.yaml in github.com/daijro/openplayground), into the
+# folder given ($1): upstream's own (scripts/web/build.sh, and the `web` job of .github/workflows/build.yml) with the
+# font folder, the font catalog and the Help, built for speed (the release profile; build.mjs then runs wasm-opt -O3)
+# where upstream builds for size (profile.web and wasm-opt -Oz).
+set -euo pipefail
+DIST=$(realpath -m "$1")
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+TARGET=${CARGO_TARGET_DIR:-$ROOT/target}
+cd "$ROOT"
+
+# build.rs bundles Liberation, DejaVu Sans and Noto Sans Devanagari and Bengali into the module (a page has no system
+# fonts) and font_folder.py copies TeX Gyre and more DejaVu: on CI they are installed first, as upstream's CI does.
+# Found wherever this machine keeps them (build.rs looks in Debian's folders only).
+if [ -n "${CI:-}" ] && command -v apt-get >/dev/null; then
+  { sudo apt-get update -q && sudo apt-get install -yq --no-install-recommends fonts-liberation fonts-dejavu-core \
+    fonts-dejavu-extra fonts-noto-core fonts-texgyre; } >/dev/null || echo "::warning::TraceDraw: could not install its fonts"
+fi
+TRACEDRAW_WEB_FONTS=$(find /usr/share/fonts \( -name 'Liberation*.ttf' -o -name 'DejaVuSans*.ttf' \
+  -o -name 'NotoSansDevanagari-Regular.ttf' -o -name 'NotoSansBengali-Regular.ttf' \) -printf '%h\n' 2>/dev/null | sort -u | paste -sd: || true)
+export TRACEDRAW_WEB_FONTS
+
+cargo build --release --target wasm32-unknown-unknown -p tracedraw
+mkdir -p "$DIST"
+wasm-bindgen --target web --no-typescript --out-dir "$DIST" "$TARGET/wasm32-unknown-unknown/release/tracedraw.wasm"
+
+# The page with the module's size (its splash shows the download) and the version, as upstream's CI writes them.
+version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
+git describe --tags --exact-match >/dev/null 2>&1 || version="$version-dev.$(git rev-parse --short=7 HEAD)"
+size=$(wc -c < "$DIST/tracedraw_bg.wasm" | tr -d ' ')
+sed -e "s/data-wasm-size=\"0\"/data-wasm-size=\"$size\"/" -e "s/@VERSION@/$version/" web/index.html > "$DIST/index.html"
+cp web/FONTS.md "$DIST/"
+cp assets/icon/tracedraw-256.png "$DIST/icon-256.png"
+
+# The font folder (free fonts from google/fonts and this machine, fetched by the page as text needs them), the font
+# catalog (every other google/fonts family, fetched from GitHub) and the Help in every interface language. The page
+# works without the fonts' lists (the bundled fonts only), so a download that fails twice leaves them out.
+python3 web/font_folder.py web/fonts.txt "$DIST/fonts" || python3 web/font_folder.py web/fonts.txt "$DIST/fonts" ||
+  { echo "::warning::TraceDraw: no font folder"; rm -rf "$DIST/fonts"; }
+python3 web/font_catalog.py web/fonts.txt "$DIST/fonts" || python3 web/font_catalog.py web/fonts.txt "$DIST/fonts" ||
+  echo "::warning::TraceDraw: no font catalog"
+python3 web/help_site.py docs/help apps/tracedraw/lang "$DIST/help"
