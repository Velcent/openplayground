+    /// Adds or removes a keyframe of a Transform property of the comp's `layer`th layer.
+    fn key(app: &mut EffectcraftApp, layer: usize, prop: &str) {
+        let id = app.session.active_comp().unwrap().layers[layer].id.0;
+        app.session.execute("keys.toggleTransform", json!({"layer": id, "prop": prop})).unwrap();
+    }
