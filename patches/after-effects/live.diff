+            .flat_map(|x| comps.iter().map(move |y| (*x, *y)))
+            .find(|(x, y)| x != y && !p.comp_contains(*x, *y) && !p.comp_contains(*y, *x))
+            .unwrap();
+        // At the same time A nests X in Y and B nests Y in X.
+        a.session.execute("layer.addItem", json!({"comp": y.0, "item": x.0})).unwrap();
