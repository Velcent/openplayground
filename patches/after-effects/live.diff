+//! Live editing in a Playground session (web only): the adapter template ([`playground_live`]), the shared project's
+//! binding ([`LIVE_PROJECT`]) and [`Session::execute`]'s first step, which hands Undo, Redo and History jumps to the
+//! session while the shared project is open. The frontend (`effectcraft_ui_egui::playground`) implements the adapter.
+
+use serde_json::Value;
+
+use crate::{EngineError, Result, Session, history};
+
+#[path = "playground_live.rs"]
+pub mod playground_live;
+
+thread_local! {
+    /// The [`crate::scriptui::ScriptUi::project_epoch`] of the project a connected session shares (the frontend sets
+    /// it). Undo, Redo and History jumps go to the session only while that project is open.
+    pub static LIVE_PROJECT: std::cell::Cell<Option<u64>> = const { std::cell::Cell::new(None) };
+}
+
+impl Session {
+    /// [`Session::execute`]'s first step: while the shared project is open in a connected session, Undo, Redo and
+    /// History jumps go to the session, which takes back only this person's edits. `None`: run the command as usual.
+    pub fn live_execute(&mut self, id: &str, params: &Value) -> Option<Result<Value>> {
+        let n = match self.live_steps(id, params)? {
+            Ok(n) => n,
+            Err(e) => return Some(Err(e)),
+        };
+        for _ in 0..n.unsigned_abs() {
+            playground_live::undo(n > 0);
+        }
+        Some(Ok(Value::Null))
+    }
+
+    /// The steps along the History's working line (negative: back) that Undo, Redo or a History jump takes, or an
+    /// error for a state on another branch, which the session can't reach.
+    fn live_steps(&self, id: &str, p: &Value) -> Option<Result<i64>> {
+        if !matches!(id, "edit.undo" | "edit.redo" | "edit.history.goto")
+            || !playground_live::connected()
+            || LIVE_PROJECT.get() != Some(self.script_ui.project_epoch)
+        {
+            return None;
+        }
+        Some(match (id, p.get("steps").and_then(Value::as_i64)) {
+            ("edit.undo", _) => Ok(-1),
+            ("edit.redo", _) => Ok(1),
+            (_, Some(n)) => Ok(n),
+            _ => {
+                let line: Vec<_> = self.history_tree().into_iter().filter(|n| n.line).collect();
+                let at = |f: &dyn Fn(&history::HistoryNode) -> bool| line.iter().position(f);
+                let target = match (p.get("id").and_then(Value::as_str), p.get("index").and_then(Value::as_u64)) {
+                    (Some(id), _) => at(&|n| n.id == id),
+                    (None, Some(i)) => at(&|n| n.index as u64 == i),
+                    _ => None,
+                };
+                match (target, at(&|n| n.current)) {
+                    (Some(t), Some(c)) => Ok(t as i64 - c as i64),
+                    _ => Err(EngineError::Other("While editing live, only states on the History's current line can be reached".into())),
+                }
+            }
+        })
+    }
+}
