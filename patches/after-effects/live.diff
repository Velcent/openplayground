@@ -0,0 +1,21 @@
+//! Live editing in a Playground session (web only): what the comp viewer is drawing that its document gets only at the
+//! end of the gesture, for the others to see as it is drawn (`crate::playground`). A child of the viewer, which keeps
+//! that state private: the Pen's path in progress and a shape tool drag's rubber band.
+
+use effectcraft_engine::project::LayerId;
+
+use super::{Gesture, ViewerMap, pen_id, shape_drag};
+use crate::EffectcraftApp;
+
+/// The path the Pen is drawing: its layer and mask (or shape path) uid.
+pub(crate) fn pen(ctx: &egui::Context) -> Option<(LayerId, u64)> {
+    ctx.data(|d| d.get_temp(pen_id()))
+}
+
+/// The shape a shape tool drag would make now, as the viewer's own ghost shows it: its kind (`mask_path`'s) and its
+/// centre and size in comp pixels.
+pub(crate) fn band(ctx: &egui::Context, app: &EffectcraftApp, map: &ViewerMap) -> Option<(&'static str, [f64; 4])> {
+    let Some(Gesture::Create { tool, start }) = ctx.data(|d| d.get_temp(egui::Id::new("viewer-gesture"))) else { return None };
+    let d = shape_drag(app, tool, start, map.to_comp(ctx.pointer_latest_pos()?), ctx.input(|i| i.modifiers))?;
+    Some((d.kind, [d.centre[0], d.centre[1], d.size[0], d.size[1]]))
+}
diff --git a/crates/ui-egui/src/playground.rs b/crates/ui-egui/src/playground.rs
new file mode 100644
index 0000000..bc81c2b
--- /dev/null
+++ b/crates/ui-egui/src/playground.rs
@@ -0,0 +1,1008 @@
+//! Live editing in a Playground session (web only). The shared document is the project open when the session started
+//! (`Project`), minus what is this person's: the id counter, each comp's Resolution, Draft 3D and Hide Shy Layers
+//! switches (viewer and Timeline toggles), which footage is missing in this browser, and the Render Queue (its jobs,
+//! outputs and status). Selection, current times, open comps, panels and tools already live outside the project.
+//! Property nodes carry their uid as `id`, so the property tree merges node by node, as layers (by `id`) and items
+//! (keyed by id) do. A remote change is only installed: what an edit brings about elsewhere (a shared Global Light,
+//! Essential Properties, analyses to redo) comes from its author's own edit. The footage files the shared project names
+//! (by path, in the page's file table) reach everyone through the session ([`media`]). Opening another project leaves
+//! the session's document as it was, still merging remote changes. Presence: each person shares the comp they show,
+//! their pointer over its viewer in comp pixels and their selected layers, and what a gesture under way has done so
+//! far (the document gets it only when the gesture ends): the others' are drawn over the viewer and the Timeline.
+
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Arc;
+
+use effectcraft_engine::Services;
+use effectcraft_engine::commands::shape_tool::mask_path;
+use effectcraft_engine::geom::Mat3;
+use effectcraft_engine::playground::LIVE_PROJECT;
+use effectcraft_engine::playground::playground_live::{self, Live, Presence};
+use effectcraft_engine::render::EvalCtx;
+use effectcraft_engine::time::Tick;
+use effectcraft_project::{Footage, ItemId, ItemKind, Layer, LayerId, LayerSource, Project};
+use egui::{Color32, Pos2, Rect, Shape, Stroke, pos2, vec2};
+use serde_json::{Value, json};
+
+use crate::EffectcraftApp;
+use crate::panels::viewer::{ViewerMap, l2c, layer_outline};
+use crate::panels::viewer_overlays::{PathInfo, flatten, path_of};
+use crate::theme::Tokens;
+
+/// New ids per person while connected: a range of this many (see [`bind`]). Past it (4M ids in one session) the
+/// counter would rescan every frame and run into ids others may hand out.
+const RANGE: u64 = 1 << 22;
+
+thread_local! {
+    /// The web entry's runner ([`runner`]).
+    #[cfg(target_arch = "wasm32")]
+    static RUNNER: RefCell<Option<eframe::WebRunner>> = const { RefCell::new(None) };
+    /// The comp viewer as shown last ([`viewer`]): the pass, its layer and clip.
+    static VIEWER: Cell<Option<(u64, egui::LayerId, Rect)>> = const { Cell::new(None) };
+    /// This person's pointer over the comp viewer in the last frame, in comp pixels.
+    static POINTER: Cell<Option<[f64; 2]>> = const { Cell::new(None) };
+    /// The others' presence ([`Live::live_show_presence`]).
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+    /// The last frame had a pointer button down or a text field focused.
+    static INPUT: Cell<bool> = const { Cell::new(false) };
+    /// The Timeline as shown last ([`timeline`]): the pass and its layer.
+    static TIMELINE: Cell<Option<(u64, egui::LayerId)>> = const { Cell::new(None) };
+    /// The last frame had a pointer button down: a gesture may be under way.
+    static DOWN: Cell<bool> = const { Cell::new(false) };
+    /// The project and the current time as of the last frame without a button down: what the others have.
+    static REST: RefCell<Option<(Arc<Project>, Tick)>> = const { RefCell::new(None) };
+    /// What the comp viewer was drawing in the last frame ([`Drawing`]).
+    static DRAWING: Cell<Drawing> = const { Cell::new(Drawing { zoom: 1.0, pen: None, band: None }) };
+    /// The others' marks as last drawn, eased toward their latest presence, by person ([`Shown`]).
+    static SHOWN: RefCell<BTreeMap<String, Shown>> = const { RefCell::new(BTreeMap::new()) };
+    /// While connected: the start of this person's id range.
+    static IDS: Cell<Option<u64>> = const { Cell::new(None) };
+    /// While connected: the shared project as it last was here, which stays the session's document once another
+    /// project is opened.
+    static SHARED: RefCell<Option<Arc<Project>>> = const { RefCell::new(None) };
+}
+
+/// The web entry's runner, in place of `eframe::WebRunner::new()`: kept for the adapter's access to the app.
+#[cfg(target_arch = "wasm32")]
+pub fn runner() -> eframe::WebRunner {
+    let runner = eframe::WebRunner::new();
+    RUNNER.set(Some(runner.clone()));
+    runner
+}
+
+/// The web entry's app, in place of `Box::new(app)`: [`Web`], with `app` reaching the EffectCraft app inside.
+#[cfg(target_arch = "wasm32")]
+pub fn boxed<T: eframe::App + 'static>(app: fn(&mut T) -> &mut EffectcraftApp, inner: T) -> Box<dyn eframe::App> {
+    Box::new(Web { inner, app, attached: false })
+}
+
+/// The web app with live editing: each frame ends with [`frame`]; the first one offers the adapter to the page.
+#[cfg(target_arch = "wasm32")]
+pub struct Web<T> {
+    inner: T,
+    app: fn(&mut T) -> &mut EffectcraftApp,
+    attached: bool,
+}
+
+#[cfg(target_arch = "wasm32")]
+impl<T: eframe::App + 'static> eframe::App for Web<T> {
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.inner.raw_input_hook(ctx, raw_input);
+    }
+
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.inner.logic(ctx, frame);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.inner.ui(ui, frame);
+        let ctx = ui.ctx().clone();
+        self::frame((self.app)(&mut self.inner), &ctx);
+        if !std::mem::replace(&mut self.attached, true) {
+            let with_app = |with: &mut dyn FnMut(&mut EffectcraftApp)| {
+                RUNNER.with_borrow(|r| r.as_ref().and_then(|r| r.app_mut::<Self>()).map(|mut web| with((web.app)(&mut web.inner))).is_some())
+            };
+            let format = concat!("after-effects:1:", env!("CARGO_PKG_VERSION"));
+            if let Err(e) = playground_live::web::attach::<EffectcraftApp>(format, with_app, move || ctx.request_repaint()) {
+                log::error!("live editing: {e:?}");
+            }
+        }
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.inner.save(storage);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.inner.auto_save_interval()
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.inner.clear_color(visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        self.inner.persist_egui_memory()
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
+
+/// The end of a frame: [`playground_live::frame`], with what egui knows of the pointer and the keyboard; then this
+/// person's gestures for their presence and the others' over the comp viewer and the Timeline.
+pub fn frame(app: &mut EffectcraftApp, ctx: &egui::Context) {
+    let down = ctx.input(|i| i.pointer.any_down());
+    INPUT.set(down || ctx.text_edit_focused());
+    bind(app);
+    playground_live::frame(app);
+    if open(app) && playground_live::connected() {
+        SHARED.set(Some(app.session.project.clone()));
+    }
+    DOWN.set(down);
+    if !down {
+        REST.set(Some((app.session.project.clone(), app.session.time())));
+    }
+    // The comp viewer's mapping, when it was shown this frame (`panels::viewer::show` publishes it).
+    let pass = ctx.cumulative_pass_nr();
+    let shown = VIEWER.get().filter(|(p, ..)| *p == pass);
+    let shown = shown.zip(ctx.data(|d| d.get_temp::<ViewerMap>(egui::Id::new("viewer-map"))));
+    POINTER.set(shown.and_then(|((_, layer, clip), map)| {
+        let at = ctx.pointer_hover_pos().filter(|p| map.area.intersect(clip).contains(*p))?;
+        ctx.layer_id_at(at).is_none_or(|l| l == layer).then(|| map.to_comp(at))
+    }));
+    DRAWING.set(match shown {
+        Some((_, map)) => {
+            let band = crate::panels::viewer::playground::band(ctx, app, &map);
+            Drawing { zoom: map.zoom, pen: crate::panels::viewer::playground::pen(ctx), band }
+        }
+        None => Drawing { zoom: 1.0, pen: None, band: None },
+    });
+    // How far the others' marks go this frame toward their latest presence.
+    let k = 1.0 - (-f64::from(ctx.input(|i| i.stable_dt).clamp(0.0, 0.1)) / EASE).exp();
+    let mut moving = false;
+    OTHERS.with_borrow(|others| {
+        if let Some(((_, layer, clip), map)) = shown {
+            moving |= draw_viewer(app, &ctx.layer_painter(layer).with_clip_rect(map.area.intersect(clip)), &map, others, k);
+        }
+        if let Some((_, layer)) = TIMELINE.get().filter(|(p, _)| *p == pass) {
+            moving |= draw_timeline(app, &ctx.layer_painter(layer), others, k);
+        }
+    });
+    if moving {
+        ctx.request_repaint();
+    }
+}
+
+/// The comp viewer's first step (`panels::viewer::show`): it is on screen this frame, on this layer.
+pub fn viewer(ui: &egui::Ui) {
+    VIEWER.set(Some((ui.ctx().cumulative_pass_nr(), ui.layer_id(), ui.clip_rect())));
+}
+
+/// The Timeline's first step (`panels::timeline::show`): it is on screen this frame, on this layer.
+pub fn timeline(ui: &egui::Ui) {
+    TIMELINE.set(Some((ui.ctx().cumulative_pass_nr(), ui.layer_id())));
+}
+
+/// What the comp viewer was drawing in a frame: its magnification (points per comp pixel), the Pen's path in progress
+/// (layer, path uid) and a shape tool drag's rubber band (`mask_path` kind, centre and size in comp pixels).
+#[derive(Clone, Copy)]
+struct Drawing {
+    zoom: f32,
+    pen: Option<(LayerId, u64)>,
+    band: Option<(&'static str, [f64; 4])>,
+}
+
+/// The kinds of rubber band a presence may name (`mask_path`'s).
+const BANDS: [&str; 5] = ["rect", "rounded", "ellipse", "polygon", "star"];
+
+/// The most points a shared path keeps (the newest).
+const MAX_POINTS: usize = 200;
+
+/// The most a presence may weigh (the shell sends nothing heavier than 4 KiB).
+const MAX_PRESENCE: usize = 4000;
+
+/// How long the others' marks take to go most (1 - 1/e) of the way to their latest place, in seconds.
+const EASE: f64 = 0.08;
+
+/// A person's marks as this person last drew them, eased toward their latest presence: per mark (a name), its numbers
+/// in the document's terms (comp pixels, seconds), over the viewer and the Timeline of the comp `page`.
+#[derive(Default)]
+struct Shown {
+    page: u64,
+    viewer: Marks,
+    timeline: Marks,
+}
+
+type Marks = Vec<(String, Vec<f64>)>;
+
+/// `shown` moved `k` of the way toward `targets` (`px`: screen points per unit), all of the way for a mark new or of
+/// another shape, a jump of over `far` points, or under half a point left. `moving`: a mark is still on its way.
+fn ease(shown: &Marks, targets: Marks, k: f64, px: f64, far: f64, moving: &mut bool) -> Marks {
+    let step = |(name, to): (String, Vec<f64>)| {
+        let off = |at: &[f64]| at.iter().zip(&to).map(|(a, b)| ((b - a) * px).abs()).fold(0.0, f64::max);
+        let from = shown.iter().find(|(n, at)| *n == name && at.len() == to.len() && off(at) <= far);
+        let mut at: Vec<f64> = from.map_or(to.clone(), |(_, at)| at.iter().zip(&to).map(|(a, b)| a + (b - a) * k).collect());
+        if off(&at) < 0.5 {
+            at = to;
+        } else {
+            *moving = true;
+        }
+        (name, at)
+    };
+    targets.into_iter().map(step).collect()
+}
+
+/// A person's marks in the same comp: their eased form, from `targets` and how they were last drawn (all new on another
+/// comp). `timeline`: the Timeline's, else the viewer's.
+fn eased(person: &Presence, page: u64, timeline: bool, targets: Marks, (k, px, far): (f64, f64, f64), moving: &mut bool) -> Marks {
+    SHOWN.with_borrow_mut(|shown| {
+        let s = shown.entry(person.id.clone()).or_default();
+        if s.page != page {
+            *s = Shown { page, ..Shown::default() };
+        }
+        let marks = if timeline { &mut s.timeline } else { &mut s.viewer };
+        *marks = ease(marks, targets, k, px, far, moving);
+        marks.clone()
+    })
+}
+
+fn mark<'a>(marks: &'a Marks, name: &str) -> Option<&'a [f64]> {
+    marks.iter().find(|(n, _)| n == name).map(|(_, v)| v.as_slice())
+}
+
+fn color(p: &Presence) -> Color32 {
+    Color32::from_rgb(p.color[0], p.color[1], p.color[2])
+}
+
+/// The others who show this comp, over its viewer, eased toward their latest presence: under their selected layers'
+/// outlines the ghosts of the layers they drag where the drag has them so far, their paths being drawn and their
+/// shape tools' rubber bands; then their pointers with their names, all in their colors. What doesn't resolve here
+/// (another comp, a layer gone, a wild number) is skipped. Whether a mark is still on its way.
+fn draw_viewer(app: &EffectcraftApp, painter: &egui::Painter, map: &ViewerMap, others: &[Presence], k: f64) -> bool {
+    let Some((cid, comp)) = app.session.active_comp_id().and_then(|c| Some((c, app.session.project.comp(c)?))) else { return false };
+    let ectx = EvalCtx { project: &app.session.project, comp_id: cid, comp, time: app.session.time(), expr: app.session.expr.as_deref(), footage: None };
+    let pace = (k, f64::from(map.zoom), f64::from(map.area.width().max(map.area.height())) / 4.0);
+    let screen = |c: &[f64]| map.to_screen([c[0], c[1]]);
+    let (mut under, mut outlines, mut over, mut moving) = (vec![], vec![], vec![], false);
+    for p in others.iter().filter(|p| p.state["page"].as_u64() == Some(cid.0)) {
+        let (color, state) = (color(p), &p.state);
+        let mut targets: Marks = point(&state["pointer"]).map(|at| ("pointer".to_string(), at.to_vec())).into_iter().collect();
+        for g in list(&state["ghosts"], 50) {
+            let id = g[0].as_u64().filter(|id| comp.layers.iter().any(|l| l.id.0 == *id));
+            if let (Some(id), Some(at)) = (id, points(g, 1, 3, 16)) {
+                targets.push((format!("ghost {id}"), at.concat()));
+            }
+        }
+        // A path's newest point eases (an open one's: a closed path ends where it starts).
+        let strokes: Vec<_> = list(&state["strokes"], 8).filter_map(|s| points(s, 0, 2, MAX_POINTS)).collect();
+        for (i, s) in strokes.iter().enumerate().filter(|(_, s)| s.first() != s.last()) {
+            targets.push((format!("stroke {i}"), s[s.len() - 1].to_vec()));
+        }
+        let band = (state["band"].as_array()).and_then(|b| {
+            let kind = BANDS.into_iter().find(|k| b.first().and_then(Value::as_str) == Some(*k))?;
+            let [x, y, w, h] = [1, 2, 3, 4].map(|i| b.get(i).and_then(num));
+            Some((kind, [x?, y?, w.filter(|w| (0.0..1e5).contains(w))?, h.filter(|h| (0.0..1e5).contains(h))?]))
+        });
+        if let Some((_, b)) = band {
+            targets.push(("band".into(), b.to_vec()));
+        }
+        let marks = eased(p, cid.0, false, targets, pace, &mut moving);
+        let (fill, edge) = (color.gamma_multiply(0.28), Stroke::new(1.5, color.gamma_multiply(0.85)));
+        for (_, at) in marks.iter().filter(|(n, _)| n.starts_with("ghost ")) {
+            under.push(Shape::convex_polygon(at.chunks(2).map(screen).collect(), fill, edge));
+        }
+        for (i, s) in strokes.iter().enumerate() {
+            let mut line: Vec<Pos2> = s.iter().map(|c| map.to_screen(*c)).collect();
+            let stroke = Stroke::new(2.0, color.gamma_multiply(0.7));
+            if s.first() == s.last() {
+                line.pop();
+                under.push(Shape::closed_line(line, stroke));
+            } else {
+                if let (Some(end), Some(at)) = (line.last_mut(), mark(&marks, &format!("stroke {i}"))) {
+                    *end = screen(at);
+                }
+                under.push(Shape::line(line, stroke));
+            }
+        }
+        if let (Some((kind, _)), Some(b)) = (band, mark(&marks, "band"))
+            && let Some(sp) = mask_path(kind, [b[0], b[1]], [b[2], b[3]])
+        {
+            let mut line = flatten(&sp, &Mat3::IDENTITY, map);
+            if line.first() != line.last()
+                && let Some(first) = line.first().copied()
+            {
+                line.push(first);
+            }
+            under.extend(Shape::dashed_line(&line, Stroke::new(1.5, color), 4.0, 3.0));
+        }
+        for l in list(&state["selection"], 50).filter_map(|id| comp.layers.iter().find(|l| Some(l.id.0) == id.as_u64())) {
+            let outline = layer_outline(&ectx, l);
+            if outline.len() > 2 {
+                outlines.push(Shape::closed_line(outline.iter().map(|c| map.to_screen(*c)).collect(), Stroke::new(2.0, color)));
+            }
+        }
+        if let Some(at) = mark(&marks, "pointer") {
+            cursor(painter, &mut over, screen(at), color, &p.name);
+        }
+    }
+    painter.extend(under);
+    painter.extend(outlines);
+    painter.extend(over);
+    moving
+}
+
+/// The others who show this comp, over the Timeline's time graph, eased toward their latest presence: the keyframes
+/// they drag where the drag has them so far (on the property's row, or the layer's while its properties are folded)
+/// and the current time they scrub, a line, in their colors. Whether a mark is still on its way.
+fn draw_timeline(app: &EffectcraftApp, painter: &egui::Painter, others: &[Presence], k: f64) -> bool {
+    let Some((cid, comp)) = app.session.active_comp_id().and_then(|c| Some((c, app.session.project.comp(c)?))) else { return false };
+    // Where the Timeline put its ruler, rows and keys this frame (its automation ids) and its time mapping.
+    let rect = |id: &str| app.auto.elements.iter().rev().find(|e| e.id == id).map(|e| Rect::from_min_size(pos2(e.rect[0], e.rect[1]), vec2(e.rect[2], e.rect[3])));
+    let (Some(ruler), Some(rows)) = (rect("timeline.ruler"), rect("timeline.layerMarquee")) else { return false };
+    let Some((x0, start, pps)) = painter.ctx().data(|d| d.get_temp::<(f32, f64, f64)>(egui::Id::new("timeline-map"))) else { return false };
+    let x = |secs: f64| x0 + ((secs - start) * pps) as f32;
+    let painter = painter.with_clip_rect(Rect::from_x_y_ranges(ruler.x_range(), ruler.min.y..=rows.max.y).intersect(painter.clip_rect()));
+    let key_rows = painter.clip_rect().intersect(Rect::from_x_y_ranges(ruler.x_range(), rows.y_range()));
+    let pace = (k, pps, f64::from(ruler.width()) / 4.0);
+    let (mut keys, mut lines, mut moving) = (vec![], vec![], false);
+    for p in others.iter().filter(|p| p.state["page"].as_u64() == Some(cid.0)) {
+        let (color, state) = (color(p), &p.state);
+        let mut targets: Marks = num(&state["time"]).map(|t| ("time".to_string(), vec![t])).into_iter().collect();
+        // A key on a layer and property of this comp: its row, by the property's or (folded) the layer's automation id.
+        let row = |key: &Value| {
+            let [layer, prop] = [0, 1].map(|i| key.get(i).and_then(Value::as_u64));
+            let l = comp.layers.iter().find(|l| Some(l.id.0) == layer)?;
+            let prop = prop.filter(|uid| l.props.find(*uid).is_some())?;
+            let r = rect(&format!("timeline.prop.{prop}.row")).or_else(|| rect(&format!("timeline.layer.{}.row", l.id.0)))?;
+            Some((format!("key {} {prop}", l.id.0), r.center().y))
+        };
+        let mut dragged = vec![];
+        for (i, key) in list(&state["keys"], 50).enumerate() {
+            if let (Some((name, y)), Some(t)) = (row(key), key.get(2).and_then(num)) {
+                dragged.push((format!("{name} {i}"), y));
+                targets.push((format!("{name} {i}"), vec![t]));
+            }
+        }
+        let marks = eased(p, cid.0, true, targets, pace, &mut moving);
+        if !app.ui.timeline.graph_editor {
+            for (name, y) in dragged {
+                let Some(&[t]) = mark(&marks, &name) else { continue };
+                let c = pos2(x(t), y);
+                if key_rows.contains(c) {
+                    let diamond = vec![c - vec2(0.0, 5.5), c + vec2(5.5, 0.0), c + vec2(0.0, 5.5), c - vec2(5.5, 0.0)];
+                    keys.push(Shape::convex_polygon(diamond, color.gamma_multiply(0.28), Stroke::new(1.5, color.gamma_multiply(0.85))));
+                }
+            }
+        }
+        if let Some(&[t]) = mark(&marks, "time") {
+            lines.push(Shape::line_segment([pos2(x(t), ruler.min.y + 12.0), pos2(x(t), rows.max.y)], Stroke::new(1.5, color)));
+        }
+    }
+    painter.extend(keys);
+    painter.extend(lines);
+    moving
+}
+
+/// A person's pointer at `tip`: an arrow in their color with a white edge over a soft shadow, and their name on a tag
+/// of their color in white or (a light color) near-black.
+fn cursor(painter: &egui::Painter, shapes: &mut Vec<Shape>, tip: Pos2, color: Color32, name: &str) {
+    const ARROW: [[f32; 2]; 7] = [[0.0, 0.0], [0.0, 16.0], [4.5, 12.2], [7.6, 18.6], [10.4, 17.3], [7.3, 11.0], [12.5, 11.0]];
+    let tip = pos2(painter.round_to_pixel_center(tip.x), painter.round_to_pixel_center(tip.y));
+    let arrow = |dy: f32| ARROW.iter().map(|[x, y]| tip + vec2(*x, *y + dy)).collect();
+    // The fan from the tip fills this (concave) arrow exactly: its corners go round the tip in order.
+    shapes.push(Shape::convex_polygon(arrow(1.0), Color32::from_black_alpha(64), Stroke::NONE));
+    shapes.push(Shape::convex_polygon(arrow(0.0), color, Stroke::new(1.5, Color32::WHITE)));
+    if name.is_empty() {
+        return;
+    }
+    let name: String = if name.chars().count() > 24 { name.chars().take(23).chain(['…']).collect() } else { name.into() };
+    let ink = if luminance(color) > 0.55 { Color32::from_rgb(0x11, 0x11, 0x11) } else { Color32::WHITE };
+    let text = painter.layout_no_wrap(name, Tokens::semibold(12.0), ink);
+    let tag = Rect::from_min_size(tip + vec2(12.0, 15.0), text.size() + vec2(14.0, 6.0));
+    shapes.push(Shape::rect_filled(tag, 6.0, color));
+    shapes.push(Shape::galley(tag.min + vec2(7.0, 3.0), text, ink));
+}
+
+/// A color's relative luminance (sRGB, 0 black to 1 white).
+fn luminance(c: Color32) -> f32 {
+    let lin = |v: u8| {
+        let v = f32::from(v) / 255.0;
+        if v <= 0.04045 { v / 12.92 } else { ((v + 0.055) / 1.055).powf(2.4) }
+    };
+    0.2126 * lin(c.r()) + 0.7152 * lin(c.g()) + 0.0722 * lin(c.b())
+}
+
+/// A number from someone else's presence: finite and within reach of any comp or time.
+fn num(v: &Value) -> Option<f64> {
+    v.as_f64().filter(|x| x.abs() < 1e6)
+}
+
+/// A pointer from someone else's presence: two finite numbers within reach of any comp.
+fn point(v: &Value) -> Option<[f64; 2]> {
+    Some([num(v.get(0)?)?, num(v.get(1)?)?])
+}
+
+/// The first `max` items of a list in someone else's presence (none when it is no list).
+fn list(v: &Value, max: usize) -> impl Iterator<Item = &Value> {
+    v.as_array().into_iter().flatten().take(max)
+}
+
+/// The numbers of list `v` from `skip` on as points (x, y, x, y…): from `min` to `max` of them, every one a number.
+fn points(v: &Value, skip: usize, min: usize, max: usize) -> Option<Vec<[f64; 2]>> {
+    let v = v.as_array()?.get(skip..)?;
+    if v.len() % 2 != 0 || !(2 * min..=2 * max).contains(&v.len()) {
+        return None;
+    }
+    v.chunks(2).map(|c| Some([num(&c[0])?, num(&c[1])?])).collect()
+}
+
+/// A tenth of a comp pixel.
+fn tenth(v: f64) -> f64 {
+    (v * 10.0).round() / 10.0
+}
+
+/// What this person is doing that the document gets only when the gesture ends, measured against the project and time
+/// the others have ([`REST`]), in comp `cid`: the outlines of selected layers a drag has moved, scaled or turned so far
+/// (`ghosts`: [layer id, x, y, …] in comp pixels), the Pen's path and the selected layers' paths being edited
+/// (`strokes`: [x, y, …]), a shape tool drag's rubber band (`band`: [kind, centre x, y, width, height]), the keyframes
+/// a drag has moved (`keys`: [layer id, property uid, comp seconds]) and the current time being scrubbed (`time`).
+fn gestures(app: &EffectcraftApp, cid: ItemId, state: &mut Value) {
+    let s = &app.session;
+    let Some(comp) = s.project.comp(cid) else { return };
+    let (drawing, time) = (DRAWING.get(), s.time());
+    let now = EvalCtx { project: &s.project, comp_id: cid, comp, time, expr: s.expr.as_deref(), footage: None };
+    let line = |p: PathInfo| polyline(&flatten(&p.sp, &p.m, &ViewerMap { origin: Pos2::ZERO, zoom: 1.0, comp: [0.0; 2], area: Rect::NOTHING }), drawing.zoom);
+    let pen = drawing.pen.filter(|(l, _)| comp.layer(*l).is_some());
+    let mut strokes: Vec<Vec<f64>> = pen.and_then(|(l, uid)| path_of(&now, l, uid)).map(line).into_iter().collect();
+    if let Some((kind, b)) = drawing.band {
+        state["band"] = json!([kind, tenth(b[0]), tenth(b[1]), tenth(b[2]), tenth(b[3])]);
+    }
+    if let Some((before, rest_time)) = REST.with_borrow(|r| r.clone()).filter(|_| DOWN.get()) {
+        if rest_time != time {
+            state["time"] = json!((time.seconds() * 1e4).round() / 1e4);
+        }
+        if let Some(old) = before.comp(cid).filter(|_| !Arc::ptr_eq(&before, &s.project)) {
+            let then = EvalCtx { project: &before, comp: old, ..now };
+            let mut ghosts = vec![];
+            for l in s.state.selected_layers.iter().take(50).filter_map(|id| comp.layer(*id)) {
+                let Some(o) = old.layer(l.id) else { continue };
+                // Moved, scaled or turned (a path drawn or edited changes only its box: a stroke shows that).
+                let outline = layer_outline(&now, l);
+                if outline.len() > 2 && l2c(&now, l) != l2c(&then, o) {
+                    ghosts.push(std::iter::once(json!(l.id.0)).chain(outline.iter().flatten().map(|v| json!(tenth(*v)))).collect::<Value>());
+                }
+                for uid in paths(&now, l).into_iter().filter(|uid| pen != Some((l.id, *uid))) {
+                    if let Some(p) = path_of(&now, l.id, uid).filter(|p| path_of(&then, l.id, uid).is_none_or(|q| q.sp != p.sp)) {
+                        strokes.push(line(p));
+                    }
+                }
+            }
+            if !ghosts.is_empty() {
+                state["ghosts"] = ghosts.into();
+            }
+            // The selected keys, when some are where the others have none: a drag has moved them.
+            let has = |c: &effectcraft_project::Comp, k: &&effectcraft_engine::KeyRef| {
+                c.layer(k.layer).and_then(|l| l.props.find(k.prop)).is_some_and(|p| p.keys.iter().any(|x| x.time == k.time))
+            };
+            let keys: Vec<_> = s.state.selected_keys.iter().filter(|k| has(comp, k)).take(50).collect();
+            if keys.iter().any(|k| !has(old, k)) {
+                let at = |k: &effectcraft_engine::KeyRef| Some(json!([k.layer.0, k.prop, (comp.layer(k.layer)?.comp_time(k.time).seconds() * 1e4).round() / 1e4]));
+                state["keys"] = keys.into_iter().filter_map(at).collect();
+            }
+        }
+    }
+    if !strokes.is_empty() {
+        state["strokes"] = strokes.into_iter().take(8).collect();
+    }
+}
+
+/// The uids of a layer's masks and shape paths.
+fn paths(ectx: &EvalCtx, l: &Layer) -> Vec<u64> {
+    let shapes = effectcraft_engine::viewer::shape_paths(ectx, l).into_iter().map(|(uid, _)| uid);
+    l.masks().into_iter().flat_map(|m| m.groups()).map(|g| g.uid).chain(shapes).collect()
+}
+
+/// A path's points (comp pixels) as [x, y, …], a tenth of a pixel each: points under a screen point (at `zoom`) from
+/// the last kept go, the last one stays; of more than [`MAX_POINTS`], the newest.
+fn polyline(pts: &[Pos2], zoom: f32) -> Vec<f64> {
+    let min = 1.0 / zoom.max(1e-3);
+    let mut kept: Vec<Pos2> = vec![];
+    for (i, p) in pts.iter().enumerate() {
+        if i + 1 == pts.len() || kept.last().is_none_or(|q| q.distance(*p) >= min) {
+            kept.push(*p);
+        }
+    }
+    kept[kept.len().saturating_sub(MAX_POINTS)..].iter().flat_map(|p| [tenth(f64::from(p.x)), tenth(f64::from(p.y))]).collect()
+}
+
+/// Cuts a presence until the shell sends it ([`MAX_PRESENCE`]): each time the heaviest list loses its older half (a
+/// lone path, the older half of its points).
+fn fit(state: &mut Value) {
+    while state.to_string().len() > MAX_PRESENCE {
+        let weight = |key: &&str| state.get(*key).map_or(0, |v| v.to_string().len());
+        let Some(key) = ["strokes", "ghosts", "keys", "selection"].into_iter().max_by_key(weight) else { break };
+        let Some(list) = state.get_mut(key).and_then(Value::as_array_mut).filter(|l| !l.is_empty()) else { break };
+        let n = list.len();
+        match list.get_mut(0).and_then(Value::as_array_mut) {
+            Some(pts) if n == 1 && pts.len() > 4 => drop(pts.drain(..pts.len() / 4 * 2)),
+            _ => drop(list.drain(..n.div_ceil(2))),
+        }
+    }
+}
+
+/// The shared project: the open one, or the one the session kept once another was opened.
+fn shared_project(app: &EffectcraftApp) -> Arc<Project> {
+    match SHARED.with_borrow(|p| p.clone()) {
+        Some(p) if !open(app) => p,
+        _ => app.session.project.clone(),
+    }
+}
+
+/// A footage item's files: the file, and an image sequence's frames.
+fn files(f: &Footage) -> impl Iterator<Item = &String> {
+    std::iter::once(&f.path).chain(&f.sequence)
+}
+
+/// The media files a project names: its footage items' and proxies' files that live in the page's file table (`/…`),
+/// not saved projects. The document names them by path, so that is their id: two different files imported under one
+/// name each stay with the person who has them, and nothing here is overwritten.
+fn media(p: &Project) -> BTreeSet<String> {
+    p.items
+        .values()
+        .flat_map(|i| [if let ItemKind::Footage(f) = &i.kind { Some(f) } else { None }, i.proxy.as_ref().map(|x| &x.footage)])
+        .flatten()
+        .flat_map(files)
+        .filter(|p| p.starts_with('/') && !p.to_ascii_lowercase().ends_with(".ecproj"))
+        .cloned()
+        .collect()
+}
+
+/// Which of `paths` this browser has, from listings of their folders (`Services::exists` asks a disk the web lacks).
+fn present(services: &dyn Services, paths: &BTreeSet<String>) -> BTreeSet<String> {
+    let dirs: BTreeSet<&str> = paths.iter().map(|p| p.rsplit_once('/').map_or("", |(d, _)| d)).collect();
+    dirs.into_iter().flat_map(|d| services.list_dir(d)).filter(|p| paths.contains(p)).collect()
+}
+
+/// Whether the project open here is the shared one (always, when not connected).
+fn open(app: &EffectcraftApp) -> bool {
+    LIVE_PROJECT.get().is_none_or(|epoch| epoch == app.session.script_ui.project_epoch)
+}
+
+/// Connected: binds the session to the open project, and keeps its id counter in this person's range. Items, layers,
+/// property uids and Essential Graphics controls all take ids from `Project::next_id`, which about 150 places copy and
+/// write back; while connected it counts from a random start in [2^32, 2^40), so what two people add at the same time
+/// gets different ids, and imports (which offset a file's ids by the counter) stay far below 2^53. A counter lifted
+/// past every id in the project (Import Project's `fix_next_id`) comes back to the range.
+fn bind(app: &mut EffectcraftApp) {
+    if !playground_live::connected() {
+        return;
+    }
+    let start = match IDS.get() {
+        Some(start) => start,
+        None => {
+            // 52 random bits.
+            let random = playground_live::fresh_id(&mut 0) & ((1 << 52) - 1);
+            let start = (1 << 32) + random % ((1 << 40) - (1 << 32));
+            LIVE_PROJECT.set(Some(app.session.script_ui.project_epoch));
+            IDS.set(Some(start));
+            start
+        }
+    };
+    if open(app) && !(start..start + RANGE).contains(&app.session.project.next_id) {
+        let next = after_own(&shared(&app.session.project), start);
+        Arc::make_mut(&mut app.session.project).next_id = next;
+    }
+}
+
+/// The first id of the range from `start` above every item, layer and control id and property uid of `doc` in that
+/// range: what others added to it is skipped.
+fn after_own(doc: &Value, start: u64) -> u64 {
+    let id = |v: Option<&Value>| v.and_then(Value::as_u64).filter(|n| (start..start + RANGE).contains(n)).map_or(start, |n| n + 1);
+    match doc {
+        Value::Object(map) => map.values().map(|v| after_own(v, start)).fold(id(map.get("id")).max(id(map.get("uid"))), u64::max),
+        Value::Array(items) => items.iter().map(|v| after_own(v, start)).fold(start, u64::max),
+        _ => start,
+    }
+}
+
+/// The shared document of a project: without the local fields, property nodes keyed by uid.
+fn shared(p: &Project) -> Value {
+    let mut doc = serde_json::to_value(p).unwrap_or_default();
+    if let Some(map) = doc.as_object_mut() {
+        for local in ["next_id", "render_queue", "render_prefs"] {
+            map.remove(local);
+        }
+    }
+    for item in doc.get_mut("items").and_then(Value::as_object_mut).into_iter().flat_map(|items| items.values_mut()) {
+        if let Some(kind) = item.get_mut("kind").and_then(Value::as_object_mut) {
+            // A comp's view switches, a footage item's Missing.
+            for local in ["resolution", "draft_3d", "hide_shy", "missing"] {
+                kind.remove(local);
+            }
+        }
+    }
+    key_nodes(&mut doc);
+    doc
+}
+
+/// Gives each property node its uid as `id`, so a children list merges node by node.
+fn key_nodes(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            if map.contains_key("node")
+                && let Some(uid) = map.get("uid").cloned()
+            {
+                map.insert("id".into(), uid);
+            }
+            map.values_mut().for_each(key_nodes);
+        }
+        Value::Array(items) => items.iter_mut().for_each(key_nodes),
+        _ => {}
+    }
+}
+
+/// The project a shared document holds, when every peer can install it as it is: it reads as a project with no value
+/// to correct (out of bounds), items under their own ids, and no composition nested in itself
+/// (`Project::comp_contains` would never return).
+fn project_of(document: &Value) -> Result<Project, String> {
+    let mut doc = document.clone();
+    doc.as_object_mut().ok_or("Conflict: not a project")?.insert("next_id".into(), 0.into());
+    let (p, notes) = Project::from_json_repaired(&doc.to_string()).map_err(|e| format!("Conflict: not a project ({e})"))?;
+    if !notes.is_empty() {
+        return Err(format!("Conflict: {}", notes.join("; ")));
+    }
+    if p.items.iter().any(|(id, item)| *id != item.id) {
+        return Err("Conflict: an item under another id".into());
+    }
+    let mut left: std::collections::BTreeMap<_, Vec<_>> = p
+        .comps()
+        .map(|(id, c)| (*id, c.layers.iter().filter_map(|l| if let LayerSource::Comp { item } = l.source { Some(item) } else { None }).collect()))
+        .collect();
+    // Comps that nest no comp left go, until none can: what stays is a cycle.
+    loop {
+        let leaves: Vec<_> = left.iter().filter(|(_, nested)| nested.iter().all(|n| !left.contains_key(n))).map(|(id, _)| *id).collect();
+        if leaves.is_empty() {
+            break;
+        }
+        for id in leaves {
+            left.remove(&id);
+        }
+    }
+    if !left.is_empty() {
+        return Err("Conflict: a composition nested in itself".into());
+    }
+    Ok(p)
+}
+
+impl Live for EffectcraftApp {
+    fn live_document(&self) -> Value {
+        shared(&shared_project(self))
+    }
+
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let paths = media(&shared_project(self));
+        let have = present(&*self.session.services, &paths);
+        paths.into_iter().map(|p| (p.clone(), p.rsplit('/').next().unwrap_or_default().to_string(), have.contains(&p))).collect()
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        project_of(document).map(|p| media(&p).into_iter().collect()).unwrap_or_default()
+    }
+
+    fn live_read_asset(&self, id: &str) -> Option<Vec<u8>> {
+        self.session.services.read_file(id).ok()
+    }
+
+    /// Stores the file as an import does (in the page's file table, which persists it) and hands it to the media pool,
+    /// which forgets what it decoded without it; a file this browser has already stays. Footage that now has all its
+    /// files is no longer Missing here, and the rendered frames go: neither an undo step nor a change to the document.
+    fn live_write_asset(&mut self, id: &str, _name: &str, bytes: Vec<u8>) {
+        let s = &mut self.session;
+        if !present(&*s.services, &BTreeSet::from([id.to_string()])).is_empty() || s.services.store_file(id, &bytes).is_err() {
+            return;
+        }
+        if let Some(importer) = &s.importer {
+            importer.register(id, &bytes);
+        }
+        let here = present(&*s.services, &media(&s.project));
+        let found: Vec<_> = (s.project.items.values())
+            .filter(|i| matches!(&i.kind, ItemKind::Footage(f) if f.missing && files(f).all(|p| here.contains(p))))
+            .map(|i| i.id)
+            .collect();
+        let dirty = s.is_dirty();
+        if !found.is_empty() {
+            let p = Arc::make_mut(&mut s.project);
+            for id in found {
+                if let Some(ItemKind::Footage(f)) = p.item_mut(id).map(|i| &mut i.kind) {
+                    f.missing = false;
+                }
+            }
+        }
+        s.layer_cache.clear();
+        s.events.push(effectcraft_engine::Event::PurgeCaches);
+        // Thumbnails render again; the project isn't modified.
+        s.bump();
+        if !dirty {
+            s.mark_saved();
+        }
+    }
+
+    fn live_check(document: &Value) -> Result<(), String> {
+        project_of(document).map(drop)
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let mut p = project_of(&document)?;
+        if !open(self) {
+            SHARED.set(Some(Arc::new(p)));
+            return Ok(());
+        }
+        let s = &mut self.session;
+        let cur = s.project.clone();
+        p.next_id = match IDS.get() {
+            Some(start) => cur.next_id.max(after_own(&document, start)),
+            None => cur.next_id.max(p.next_id),
+        };
+        p.render_queue = cur.render_queue.clone();
+        p.render_prefs = cur.render_prefs.clone();
+        for (id, item) in &mut p.items {
+            match (&mut item.kind, cur.items.get(id).map(|i| &i.kind)) {
+                (ItemKind::Comp(c), Some(ItemKind::Comp(old))) => {
+                    let c = Arc::make_mut(c);
+                    (c.resolution, c.draft_3d, c.hide_shy) = (old.resolution, old.draft_3d, old.hide_shy);
+                }
+                (ItemKind::Footage(f), Some(ItemKind::Footage(old))) => f.missing = old.missing,
+                _ => {}
+            }
+        }
+        s.project = Arc::new(p);
+        s.sanitize_state();
+        s.bump();
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        // A dialog may hold a preview it takes back on Cancel (Layer Styles); on-canvas text is being typed.
+        !INPUT.get() && self.dialog.is_none() && self.session.state.text_edit.is_none()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        if open(self) { Some(self.session.revision) } else { SHARED.with_borrow(|p| p.as_ref().map(|p| Arc::as_ptr(p) as u64)) }
+    }
+
+    /// The comp shown, the pointer over its viewer (comp pixels), the selected layers and a gesture's marks so far
+    /// ([`gestures`]); nothing while another project is open.
+    fn live_presence(&self) -> Value {
+        let Some(comp) = self.session.active_comp_id().filter(|_| open(self)) else { return Value::Null };
+        let selection: Vec<u64> = self.session.state.selected_layers.iter().take(50).map(|l| l.0).collect();
+        let mut state = json!({ "page": comp.0, "selection": selection });
+        if let Some(p) = POINTER.get() {
+            state["pointer"] = json!(p.map(tenth));
+        }
+        gestures(self, comp, &mut state);
+        fit(&mut state);
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        SHOWN.with_borrow_mut(|shown| shown.retain(|id, _| others.iter().any(|p| p.id == *id)));
+        OTHERS.set(others);
+    }
+
+    /// Undo steps from the session hold other people's edits: native Undo starts again from here.
+    fn live_disconnected(&mut self) {
+        if open(self) {
+            self.session.history.clear();
+        }
+        LIVE_PROJECT.set(None);
+        IDS.set(None);
+        SHARED.set(None);
+    }
+}
