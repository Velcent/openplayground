+        assert!(EffectcraftApp::live_check(&merged).unwrap_err().contains("nested in itself"));
+        assert!(EffectcraftApp::live_check(&Value::Null).is_err());
+        // A value a project file can't hold (a comp of a billion pixels) would be corrected on reading.
+        let mut huge = base.clone();
