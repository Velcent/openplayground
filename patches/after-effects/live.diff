+    }
+
+    #[test]
+    fn the_shared_document_is_the_project_without_views_or_local_state() {
+        let mut app = demo();
+        let before = canonical(&app.live_document());
+        EffectcraftApp::live_check(&app.live_document()).expect("a project reads back as it is");
+        let c = comp(&app);
+        app.session.set_resolution(c, Resolution::Half).unwrap();
+        Arc::make_mut(&mut app.session.project).comp_mut(c).unwrap().hide_shy = true;
+        app.session.state.selected_layers = vec![app.session.active_comp().unwrap().layers[1].id];
+        app.session.state.times.insert(c, effectcraft_time::Tick(1000));
+        Arc::make_mut(&mut app.session.project).next_id += 10;
+        assert_eq!(canonical(&app.live_document()), before, "views, switches and the id counter are not shared");
+        key(&mut app, 0, "position");
+        let doc = app.live_document();
+        assert_ne!(canonical(&doc), before);
+        let node = &doc["items"][c.0.to_string()]["kind"]["layers"][0]["props"]["children"][0];
+        assert!(node["id"].is_u64() && node["id"] == node["uid"], "property nodes are keyed by uid: {node}");
+    }
+
+    #[test]
+    fn adopting_only_installs_keeps_local_state_and_starts_nothing() {
+        let (mut a, mut b) = (demo(), demo());
+        let c = comp(&a);
+        a.session.set_resolution(c, Resolution::Quarter).unwrap();
+        let base = a.live_document();
+        // A keys layer 1's Position; B layer 1's Opacity and applies a Warp Stabilizer to layer 2.
+        let opacity = keys(&a, 0, "opacity");
+        key(&mut a, 0, "position");
+        key(&mut b, 0, "opacity");
+        let layer = b.session.active_comp().unwrap().layers[1].id.0;
+        b.session.execute("effect.apply", json!({"effect": "ec.distort.warpstabilizer", "layers": [layer]})).unwrap();
+        assert!(!b.session.warp_pending.is_empty(), "the author's edit queues the analysis");
+        let (position, steps) = (keys(&a, 0, "position"), a.session.history.undo.len());
+        let merged = EffectcraftApp::live_merge(&base, &a.live_document(), &b.live_document()).unwrap();
+        EffectcraftApp::live_check(&merged).unwrap();
+        a.live_adopt(merged.clone()).unwrap();
+        assert_eq!(canonical(&a.live_document()), canonical(&merged), "adopting changes nothing in the document");
+        assert_eq!(keys(&a, 0, "position"), position);
+        assert!(keys(&a, 0, "opacity") == keys(&b, 0, "opacity") && keys(&a, 0, "opacity") != opacity);
+        assert!(a.session.warp_pending.is_empty(), "receivers start no analysis");
+        assert_eq!(a.session.history.undo.len(), steps, "no undo step");
+        assert_eq!(a.session.project.comp(c).unwrap().resolution, Resolution::Quarter, "Resolution stays");
+    }
+
+    #[test]
+    fn merges_not_every_peer_could_install_are_conflicts() {
+        let (mut a, mut b) = (demo(), demo());
+        let base = a.live_document();
+        let p = a.session.project.clone();
+        let comps: Vec<ItemId> = p.comps().map(|(id, _)| *id).collect();
+        let (x, y) = comps
+            .iter()
+            .flat_map(|x| comps.iter().map(move |y| (*x, *y)))
+            .find(|(x, y)| x != y && !p.comp_contains(*x, *y) && !p.comp_contains(*y, *x))
+            .unwrap();
+        // At the same time A nests X in Y and B nests Y in X.
+        a.session.execute("layer.addItem", json!({"comp": y.0, "item": x.0})).unwrap();
+        b.session.execute("layer.addItem", json!({"comp": x.0, "item": y.0})).unwrap();
+        let merged = EffectcraftApp::live_merge(&base, &a.live_document(), &b.live_document()).unwrap();
+        assert!(EffectcraftApp::live_check(&merged).unwrap_err().contains("nested in itself"));
+        assert!(EffectcraftApp::live_check(&Value::Null).is_err());
+        // A value a project file can't hold (a comp of a billion pixels) would be corrected on reading.
+        let mut huge = base.clone();
+        huge["items"][x.0.to_string()]["kind"]["width"] = json!(1_000_000_000);
+        assert!(EffectcraftApp::live_check(&huge).is_err());
+        assert!(a.live_adopt(huge).is_err());
+    }
