+//! Live editing in a Playground session (web only). The shared document is the project open when the session started
+//! (`Project`), minus what is this person's: the id counter, each comp's Resolution, Draft 3D and Hide Shy Layers
+//! switches (viewer and Timeline toggles), which footage is missing in this browser, and the Render Queue (its jobs,
+//! outputs and status). Selection, current times, open comps, panels and tools already live outside the project.
+//! Property nodes carry their uid as `id`, so the property tree merges node by node, as layers (by `id`) and items
+//! (keyed by id) do. A remote change is only installed: what an edit brings about elsewhere (a shared Global Light,
+//! Essential Properties, analyses to redo) comes from its author's own edit. The footage files the shared project names
+//! (by path, in the page's file table) reach everyone through the session ([`media`]). Opening another project leaves
+//! the session's document as it was, still merging remote changes. Presence: each person shares the comp they show,
+//! their pointer over its viewer in comp pixels and their selected layers; the others' are drawn over the viewer.
+
+use std::cell::{Cell, RefCell};
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+use effectcraft_engine::Services;
+use effectcraft_engine::playground::LIVE_PROJECT;
+use effectcraft_engine::playground::playground_live::{self, Live, Presence};
+use effectcraft_engine::render::EvalCtx;
+use effectcraft_project::{Footage, ItemKind, LayerSource, Project};
+use egui::{Color32, Rect, Stroke, vec2};
+use serde_json::{Value, json};
+
+use crate::EffectcraftApp;
+use crate::panels::viewer::{ViewerMap, layer_outline};
+
+/// New ids per person while connected: a range of this many (see [`bind`]). Past it (4M ids in one session) the
+/// counter would rescan every frame and run into ids others may hand out.
+const RANGE: u64 = 1 << 22;
+
+thread_local! {
+    /// The web entry's runner ([`runner`]).
+    #[cfg(target_arch = "wasm32")]
+    static RUNNER: RefCell<Option<eframe::WebRunner>> = const { RefCell::new(None) };
+    /// The comp viewer as shown last ([`viewer`]): the pass, its layer and clip.
+    static VIEWER: Cell<Option<(u64, egui::LayerId, Rect)>> = const { Cell::new(None) };
+    /// This person's pointer over the comp viewer in the last frame, in comp pixels.
+    static POINTER: Cell<Option<[f64; 2]>> = const { Cell::new(None) };
+    /// The others' presence ([`Live::live_show_presence`]).
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+    /// The last frame had a pointer button down or a text field focused.
+    static INPUT: Cell<bool> = const { Cell::new(false) };
+    /// While connected: the start of this person's id range.
+    static IDS: Cell<Option<u64>> = const { Cell::new(None) };
+    /// While connected: the shared project as it last was here, which stays the session's document once another
+    /// project is opened.
+    static SHARED: RefCell<Option<Arc<Project>>> = const { RefCell::new(None) };
+}
+
+/// The web entry's runner, in place of `eframe::WebRunner::new()`: kept for the adapter's access to the app.
+#[cfg(target_arch = "wasm32")]
+pub fn runner() -> eframe::WebRunner {
+    let runner = eframe::WebRunner::new();
+    RUNNER.set(Some(runner.clone()));
+    runner
+}
+
+/// The web entry's app, in place of `Box::new(app)`: [`Web`], with `app` reaching the EffectCraft app inside.
+#[cfg(target_arch = "wasm32")]
+pub fn boxed<T: eframe::App + 'static>(app: fn(&mut T) -> &mut EffectcraftApp, inner: T) -> Box<dyn eframe::App> {
+    Box::new(Web { inner, app, attached: false })
+}
+
+/// The web app with live editing: each frame ends with [`frame`]; the first one offers the adapter to the page.
+#[cfg(target_arch = "wasm32")]
+pub struct Web<T> {
+    inner: T,
+    app: fn(&mut T) -> &mut EffectcraftApp,
+    attached: bool,
+}
+
+#[cfg(target_arch = "wasm32")]
+impl<T: eframe::App + 'static> eframe::App for Web<T> {
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.inner.raw_input_hook(ctx, raw_input);
+    }
+
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.inner.logic(ctx, frame);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.inner.ui(ui, frame);
+        let ctx = ui.ctx().clone();
+        self::frame((self.app)(&mut self.inner), &ctx);
+        if !std::mem::replace(&mut self.attached, true) {
+            let with_app = |with: &mut dyn FnMut(&mut EffectcraftApp)| {
+                RUNNER.with_borrow(|r| r.as_ref().and_then(|r| r.app_mut::<Self>()).map(|mut web| with((web.app)(&mut web.inner))).is_some())
+            };
+            let format = concat!("after-effects:1:", env!("CARGO_PKG_VERSION"));
+            if let Err(e) = playground_live::web::attach::<EffectcraftApp>(format, with_app, move || ctx.request_repaint()) {
+                log::error!("live editing: {e:?}");
+            }
+        }
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.inner.save(storage);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.inner.auto_save_interval()
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.inner.clear_color(visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        self.inner.persist_egui_memory()
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
+
+/// The end of a frame: [`playground_live::frame`], with what egui knows of the pointer and the keyboard.
+pub fn frame(app: &mut EffectcraftApp, ctx: &egui::Context) {
+    INPUT.set(ctx.input(|i| i.pointer.any_down()) || ctx.text_edit_focused());
+    bind(app);
+    playground_live::frame(app);
+    if open(app) && playground_live::connected() {
+        SHARED.set(Some(app.session.project.clone()));
+    }
+    // The comp viewer's mapping, when it was shown this frame (`panels::viewer::show` publishes it).
+    let shown = VIEWER.get().filter(|(pass, ..)| *pass == ctx.cumulative_pass_nr());
+    let shown = shown.zip(ctx.data(|d| d.get_temp::<ViewerMap>(egui::Id::new("viewer-map"))));
+    POINTER.set(shown.and_then(|((_, layer, clip), map)| {
+        let at = ctx.pointer_hover_pos().filter(|p| map.area.intersect(clip).contains(*p))?;
+        ctx.layer_id_at(at).is_none_or(|l| l == layer).then(|| map.to_comp(at))
+    }));
+    if let Some(((_, layer, clip), map)) = shown {
+        OTHERS.with_borrow(|others| draw_others(app, &ctx.layer_painter(layer).with_clip_rect(map.area.intersect(clip)), &map, others));
+    }
+}
+
+/// The comp viewer's first step (`panels::viewer::show`): it is on screen this frame, on this layer.
+pub fn viewer(ui: &egui::Ui) {
+    VIEWER.set(Some((ui.ctx().cumulative_pass_nr(), ui.layer_id(), ui.clip_rect())));
+}
+
+/// The others who show this comp, over its viewer: the outlines of their selected layers and their pointer with their
+/// name, in their color. What doesn't resolve here (another comp, a layer gone, a wild number) is skipped.
+fn draw_others(app: &EffectcraftApp, painter: &egui::Painter, map: &ViewerMap, others: &[Presence]) {
+    let Some((cid, comp)) = app.session.active_comp_id().and_then(|c| Some((c, app.session.project.comp(c)?))) else { return };
+    let ectx = EvalCtx { project: &app.session.project, comp_id: cid, comp, time: app.session.time(), expr: app.session.expr.as_deref(), footage: None };
+    for p in others.iter().filter(|p| p.state["page"].as_u64() == Some(cid.0)) {
+        let color = Color32::from_rgb(p.color[0], p.color[1], p.color[2]);
+        let ids = p.state["selection"].as_array().into_iter().flatten().take(50).filter_map(Value::as_u64);
+        for l in ids.filter_map(|id| comp.layers.iter().find(|l| l.id.0 == id)) {
+            let outline = layer_outline(&ectx, l);
+            if outline.len() > 2 {
+                painter.add(egui::Shape::closed_line(outline.iter().map(|c| map.to_screen(*c)).collect(), Stroke::new(2.0, color)));
+            }
+        }
+        let Some(at) = point(&p.state["pointer"]).map(|c| map.to_screen(c)) else { continue };
+        let arrow = vec![at, at + vec2(0.0, 15.0), at + vec2(10.0, 10.5)];
+        painter.add(egui::Shape::convex_polygon(arrow, color, Stroke::new(1.0, Color32::WHITE)));
+        let [r, g, b] = p.color.map(f32::from);
+        let ink = if 0.299 * r + 0.587 * g + 0.114 * b > 150.0 { Color32::BLACK } else { Color32::WHITE };
+        let name = painter.layout_no_wrap(p.name.chars().take(32).collect(), egui::FontId::proportional(11.0), ink);
+        let tag = Rect::from_min_size(at + vec2(10.0, 14.0), name.size() + vec2(8.0, 4.0));
+        painter.rect_filled(tag, 3.0, color);
+        painter.galley(tag.min + vec2(4.0, 2.0), name, ink);
+    }
+}
+
+/// A pointer from someone else's presence: two finite numbers within reach of any comp.
+fn point(v: &Value) -> Option<[f64; 2]> {
+    let [x, y] = [v.get(0)?.as_f64()?, v.get(1)?.as_f64()?];
+    (x.abs() < 1e6 && y.abs() < 1e6).then_some([x, y])
+}
+
+/// The shared project: the open one, or the one the session kept once another was opened.
+fn shared_project(app: &EffectcraftApp) -> Arc<Project> {
+    match SHARED.with_borrow(|p| p.clone()) {
+        Some(p) if !open(app) => p,
+        _ => app.session.project.clone(),
+    }
+}
+
+/// A footage item's files: the file, and an image sequence's frames.
+fn files(f: &Footage) -> impl Iterator<Item = &String> {
+    std::iter::once(&f.path).chain(&f.sequence)
+}
+
+/// The media files a project names: its footage items' and proxies' files that live in the page's file table (`/…`),
+/// not saved projects. The document names them by path, so that is their id: two different files imported under one
+/// name each stay with the person who has them, and nothing here is overwritten.
+fn media(p: &Project) -> BTreeSet<String> {
+    p.items
+        .values()
+        .flat_map(|i| [if let ItemKind::Footage(f) = &i.kind { Some(f) } else { None }, i.proxy.as_ref().map(|x| &x.footage)])
+        .flatten()
+        .flat_map(files)
+        .filter(|p| p.starts_with('/') && !p.to_ascii_lowercase().ends_with(".ecproj"))
+        .cloned()
+        .collect()
+}
+
+/// Which of `paths` this browser has, from listings of their folders (`Services::exists` asks a disk the web lacks).
+fn present(services: &dyn Services, paths: &BTreeSet<String>) -> BTreeSet<String> {
+    let dirs: BTreeSet<&str> = paths.iter().map(|p| p.rsplit_once('/').map_or("", |(d, _)| d)).collect();
+    dirs.into_iter().flat_map(|d| services.list_dir(d)).filter(|p| paths.contains(p)).collect()
+}
+
+/// Whether the project open here is the shared one (always, when not connected).
+fn open(app: &EffectcraftApp) -> bool {
+    LIVE_PROJECT.get().is_none_or(|epoch| epoch == app.session.script_ui.project_epoch)
+}
+
+/// Connected: binds the session to the open project, and keeps its id counter in this person's range. Items, layers,
+/// property uids and Essential Graphics controls all take ids from `Project::next_id`, which about 150 places copy and
+/// write back; while connected it counts from a random start in [2^32, 2^40), so what two people add at the same time
+/// gets different ids, and imports (which offset a file's ids by the counter) stay far below 2^53. A counter lifted
+/// past every id in the project (Import Project's `fix_next_id`) comes back to the range.
+fn bind(app: &mut EffectcraftApp) {
+    if !playground_live::connected() {
+        return;
+    }
+    let start = match IDS.get() {
+        Some(start) => start,
+        None => {
+            // 52 random bits.
+            let random = playground_live::fresh_id(&mut 0) & ((1 << 52) - 1);
+            let start = (1 << 32) + random % ((1 << 40) - (1 << 32));
+            LIVE_PROJECT.set(Some(app.session.script_ui.project_epoch));
+            IDS.set(Some(start));
+            start
+        }
+    };
+    if open(app) && !(start..start + RANGE).contains(&app.session.project.next_id) {
+        let next = after_own(&shared(&app.session.project), start);
+        Arc::make_mut(&mut app.session.project).next_id = next;
+    }
+}
+
+/// The first id of the range from `start` above every item, layer and control id and property uid of `doc` in that
+/// range: what others added to it is skipped.
+fn after_own(doc: &Value, start: u64) -> u64 {
+    let id = |v: Option<&Value>| v.and_then(Value::as_u64).filter(|n| (start..start + RANGE).contains(n)).map_or(start, |n| n + 1);
+    match doc {
+        Value::Object(map) => map.values().map(|v| after_own(v, start)).fold(id(map.get("id")).max(id(map.get("uid"))), u64::max),
+        Value::Array(items) => items.iter().map(|v| after_own(v, start)).fold(start, u64::max),
+        _ => start,
+    }
+}
+
+/// The shared document of a project: without the local fields, property nodes keyed by uid.
+fn shared(p: &Project) -> Value {
+    let mut doc = serde_json::to_value(p).unwrap_or_default();
+    if let Some(map) = doc.as_object_mut() {
+        for local in ["next_id", "render_queue", "render_prefs"] {
+            map.remove(local);
+        }
+    }
+    for item in doc.get_mut("items").and_then(Value::as_object_mut).into_iter().flat_map(|items| items.values_mut()) {
+        if let Some(kind) = item.get_mut("kind").and_then(Value::as_object_mut) {
+            // A comp's view switches, a footage item's Missing.
+            for local in ["resolution", "draft_3d", "hide_shy", "missing"] {
+                kind.remove(local);
+            }
+        }
+    }
+    key_nodes(&mut doc);
+    doc
+}
+
+/// Gives each property node its uid as `id`, so a children list merges node by node.
+fn key_nodes(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            if map.contains_key("node")
+                && let Some(uid) = map.get("uid").cloned()
+            {
+                map.insert("id".into(), uid);
+            }
+            map.values_mut().for_each(key_nodes);
+        }
+        Value::Array(items) => items.iter_mut().for_each(key_nodes),
+        _ => {}
+    }
+}
+
+/// The project a shared document holds, when every peer can install it as it is: it reads as a project with no value
+/// to correct (out of bounds), items under their own ids, and no composition nested in itself
+/// (`Project::comp_contains` would never return).
+fn project_of(document: &Value) -> Result<Project, String> {
+    let mut doc = document.clone();
+    doc.as_object_mut().ok_or("Conflict: not a project")?.insert("next_id".into(), 0.into());
+    let (p, notes) = Project::from_json_repaired(&doc.to_string()).map_err(|e| format!("Conflict: not a project ({e})"))?;
+    if !notes.is_empty() {
+        return Err(format!("Conflict: {}", notes.join("; ")));
+    }
+    if p.items.iter().any(|(id, item)| *id != item.id) {
+        return Err("Conflict: an item under another id".into());
+    }
+    let mut left: std::collections::BTreeMap<_, Vec<_>> = p
+        .comps()
+        .map(|(id, c)| (*id, c.layers.iter().filter_map(|l| if let LayerSource::Comp { item } = l.source { Some(item) } else { None }).collect()))
+        .collect();
+    // Comps that nest no comp left go, until none can: what stays is a cycle.
+    loop {
+        let leaves: Vec<_> = left.iter().filter(|(_, nested)| nested.iter().all(|n| !left.contains_key(n))).map(|(id, _)| *id).collect();
+        if leaves.is_empty() {
+            break;
+        }
+        for id in leaves {
+            left.remove(&id);
+        }
+    }
+    if !left.is_empty() {
+        return Err("Conflict: a composition nested in itself".into());
+    }
+    Ok(p)
+}
+
+impl Live for EffectcraftApp {
+    fn live_document(&self) -> Value {
+        shared(&shared_project(self))
+    }
+
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let paths = media(&shared_project(self));
+        let have = present(&*self.session.services, &paths);
+        paths.into_iter().map(|p| (p.clone(), p.rsplit('/').next().unwrap_or_default().to_string(), have.contains(&p))).collect()
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        project_of(document).map(|p| media(&p).into_iter().collect()).unwrap_or_default()
+    }
+
+    fn live_read_asset(&self, id: &str) -> Option<Vec<u8>> {
+        self.session.services.read_file(id).ok()
+    }
+
+    /// Stores the file as an import does (in the page's file table, which persists it) and hands it to the media pool,
+    /// which forgets what it decoded without it; a file this browser has already stays. Footage that now has all its
+    /// files is no longer Missing here, and the rendered frames go: neither an undo step nor a change to the document.
+    fn live_write_asset(&mut self, id: &str, _name: &str, bytes: Vec<u8>) {
+        let s = &mut self.session;
+        if !present(&*s.services, &BTreeSet::from([id.to_string()])).is_empty() || s.services.store_file(id, &bytes).is_err() {
+            return;
+        }
+        if let Some(importer) = &s.importer {
+            importer.register(id, &bytes);
+        }
+        let here = present(&*s.services, &media(&s.project));
+        let found: Vec<_> = (s.project.items.values())
+            .filter(|i| matches!(&i.kind, ItemKind::Footage(f) if f.missing && files(f).all(|p| here.contains(p))))
+            .map(|i| i.id)
+            .collect();
+        let dirty = s.is_dirty();
+        if !found.is_empty() {
+            let p = Arc::make_mut(&mut s.project);
+            for id in found {
+                if let Some(ItemKind::Footage(f)) = p.item_mut(id).map(|i| &mut i.kind) {
+                    f.missing = false;
+                }
+            }
+        }
+        s.layer_cache.clear();
+        s.events.push(effectcraft_engine::Event::PurgeCaches);
+        // Thumbnails render again; the project isn't modified.
+        s.bump();
+        if !dirty {
+            s.mark_saved();
+        }
+    }
+
+    fn live_check(document: &Value) -> Result<(), String> {
+        project_of(document).map(drop)
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let mut p = project_of(&document)?;
+        if !open(self) {
+            SHARED.set(Some(Arc::new(p)));
+            return Ok(());
+        }
+        let s = &mut self.session;
+        let cur = s.project.clone();
+        p.next_id = match IDS.get() {
+            Some(start) => cur.next_id.max(after_own(&document, start)),
+            None => cur.next_id.max(p.next_id),
+        };
+        p.render_queue = cur.render_queue.clone();
+        p.render_prefs = cur.render_prefs.clone();
+        for (id, item) in &mut p.items {
+            match (&mut item.kind, cur.items.get(id).map(|i| &i.kind)) {
+                (ItemKind::Comp(c), Some(ItemKind::Comp(old))) => {
+                    let c = Arc::make_mut(c);
+                    (c.resolution, c.draft_3d, c.hide_shy) = (old.resolution, old.draft_3d, old.hide_shy);
+                }
+                (ItemKind::Footage(f), Some(ItemKind::Footage(old))) => f.missing = old.missing,
+                _ => {}
+            }
+        }
+        s.project = Arc::new(p);
+        s.sanitize_state();
+        s.bump();
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        // A dialog may hold a preview it takes back on Cancel (Layer Styles); on-canvas text is being typed.
+        !INPUT.get() && self.dialog.is_none() && self.session.state.text_edit.is_none()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        if open(self) { Some(self.session.revision) } else { SHARED.with_borrow(|p| p.as_ref().map(|p| Arc::as_ptr(p) as u64)) }
+    }
+
+    /// The comp shown, the pointer over its viewer (comp pixels) and the selected layers; nothing while another project
+    /// is open.
+    fn live_presence(&self) -> Value {
+        let Some(comp) = self.session.active_comp_id().filter(|_| open(self)) else { return Value::Null };
+        let selection: Vec<u64> = self.session.state.selected_layers.iter().take(50).map(|l| l.0).collect();
+        let mut state = json!({ "page": comp.0, "selection": selection });
+        if let Some(p) = POINTER.get() {
+            state["pointer"] = json!(p.map(|v| (v * 10.0).round() / 10.0));
+        }
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+
+    /// Undo steps from the session hold other people's edits: native Undo starts again from here.
+    fn live_disconnected(&mut self) {
+        if open(self) {
+            self.session.history.clear();
+        }
+        LIVE_PROJECT.set(None);
+        IDS.set(None);
+        SHARED.set(None);
+    }
+}
