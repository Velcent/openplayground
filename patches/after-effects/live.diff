+        Arc::make_mut(&mut app.session.project).comp_mut(c).unwrap().hide_shy = true;
+        app.session.state.selected_layers = vec![app.session.active_comp().unwrap().layers[1].id];
+        app.session.state.times.insert(c, effectcraft_time::Tick(1000));
+        Arc::make_mut(&mut app.session.project).next_id += 10;
