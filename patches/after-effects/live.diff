+    #[test]
+    fn a_remote_change_waits_while_busy_ids_are_peer_unique_and_undo_goes_to_the_session() {
+        let (mut a, mut b) = (demo(), demo());
+        let ctx = egui::Context::default();
+        playground_live::connect();
+        frame(&mut a, &ctx);
+        let start = IDS.get().unwrap();
+        assert_eq!(a.session.project.next_id, start, "connected, ids come from this person's range");
+        let base = canonical(&a.live_document());
+        key(&mut b, 1, "opacity");
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(base), canonical(&b.live_document()), Box::new(move |r| to.set(r.is_ok())));
+        a.dialog = Some(crate::Dialog::LayerStyles);
+        frame(&mut a, &ctx);
+        assert!(!done.get() && keys(&a, 1, "opacity") != keys(&b, 1, "opacity"), "an open dialog holds remote changes");
+        a.dialog = None;
+        frame(&mut a, &ctx);
+        assert!(done.get() && keys(&a, 1, "opacity") == keys(&b, 1, "opacity"));
+        a.session.execute("layer.newNull", json!({})).unwrap();
+        assert!(a.session.active_comp().unwrap().layers.iter().any(|l| (start..start + RANGE).contains(&l.id.0)));
+        // A counter lifted past others' ids (Import Project) comes back to the range.
+        Arc::make_mut(&mut a.session.project).next_id = start + RANGE + 5;
+        frame(&mut a, &ctx);
+        assert!(a.session.project.next_id > start && a.session.project.next_id < start + 100);
+        key(&mut a, 0, "position");
+        let (positions, steps) = (keys(&a, 0, "position"), a.session.history.undo.len());
+        a.session.execute("edit.undo", json!({})).unwrap();
+        a.session.execute("edit.history.goto", json!({"steps": 1})).unwrap();
+        assert_eq!((keys(&a, 0, "position"), a.session.history.undo.len()), (positions, steps), "Undo is the session's while connected");
+        assert_eq!(playground_live::activity().1, [false, true]);
+        // Another project opened here: the session keeps the shared one, and Undo is this project's again.
+        frame(&mut a, &ctx);
+        let shared = canonical(&a.live_document());
+        a.session.execute("file.newProject", json!({})).unwrap();
+        frame(&mut a, &ctx);
+        assert_eq!(canonical(&a.live_document()), shared);
+        let _ = a.session.execute("edit.undo", json!({}));
+        assert_eq!(playground_live::activity().1.len(), 2);
+        playground_live::disconnect();
+        a.live_disconnected();
+        assert!(IDS.get().is_none() && LIVE_PROJECT.get().is_none());
+    }
