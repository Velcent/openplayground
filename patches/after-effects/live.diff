+    #[test]
+    fn adopting_only_installs_keeps_local_state_and_starts_nothing() {
+        let (mut a, mut b) = (demo(), demo());
+        let c = comp(&a);
+        a.session.set_resolution(c, Resolution::Quarter).unwrap();
+        let base = a.live_document();
+        // A keys layer 1's Position; B layer 1's Opacity and applies a Warp Stabilizer to layer 2.
+        let opacity = keys(&a, 0, "opacity");
+        key(&mut a, 0, "position");
+        key(&mut b, 0, "opacity");
+        let layer = b.session.active_comp().unwrap().layers[1].id.0;
+        b.session.execute("effect.apply", json!({"effect": "ec.distort.warpstabilizer", "layers": [layer]})).unwrap();
+        assert!(!b.session.warp_pending.is_empty(), "the author's edit queues the analysis");
+        let (position, steps) = (keys(&a, 0, "position"), a.session.history.undo.len());
+        let merged = EffectcraftApp::live_merge(&base, &a.live_document(), &b.live_document()).unwrap();
+        EffectcraftApp::live_check(&merged).unwrap();
+        a.live_adopt(merged.clone()).unwrap();
+        assert_eq!(canonical(&a.live_document()), canonical(&merged), "adopting changes nothing in the document");
+        assert_eq!(keys(&a, 0, "position"), position);
+        assert!(keys(&a, 0, "opacity") == keys(&b, 0, "opacity") && keys(&a, 0, "opacity") != opacity);
+        assert!(a.session.warp_pending.is_empty(), "receivers start no analysis");
+        assert_eq!(a.session.history.undo.len(), steps, "no undo step");
+        assert_eq!(a.session.project.comp(c).unwrap().resolution, Resolution::Quarter, "Resolution stays");
+    }
