+        let mut a = demo();
+        let table = Arc::new(Table::default());
+        a.session.services = table.clone();
+        table.write_file("/mine.png", b"local").unwrap();
+        let footage = Footage { path: "/clip.png".into(), missing: true, width: 8, height: 8, has_video: true, ..Default::default() };
+        Arc::make_mut(&mut a.session.project).add_item("clip", Default::default(), None, ItemKind::Footage(footage));
+        a.session.mark_saved();
+        assert_eq!(a.live_assets(), [("/clip.png".to_string(), "clip.png".to_string(), false)], "only what the project names");
+        assert_eq!(EffectcraftApp::live_assets_of(&a.live_document()), ["/clip.png"]);
+        let (doc, steps) = (canonical(&a.live_document()), a.session.history.undo.len());
+        a.live_write_asset("/clip.png", "clip.png", b"pixels".to_vec());
+        a.live_write_asset("/clip.png", "clip.png", b"other".to_vec());
+        assert_eq!(a.live_read_asset("/clip.png").as_deref(), Some(&b"pixels"[..]), "stored once, never overwritten");
+        assert_eq!(a.live_assets()[0].2, true);
+        assert!(a.session.project.items.values().all(|i| !matches!(&i.kind, ItemKind::Footage(f) if f.missing)), "no longer Missing");
+        assert_eq!((canonical(&a.live_document()), a.session.history.undo.len(), a.session.is_dirty()), (doc, steps, false));
+        assert!(a.session.drain_events().contains(&effectcraft_engine::Event::PurgeCaches));
+    }
