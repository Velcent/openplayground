index 0000000..4369263
--- /dev/null
+++ b/crates/ui-egui/src/app/live/peers.rs
@@ -0,0 +1,329 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! Presence in a live session. Each person shares the page they are on (its path in the notebooks folder, or the
+//! notebook or section selected when no page is open), their pointer over the page (from the page's top left, so it
+//! lands on the same words at any scroll), their caret (block and character) and where their selection starts. Here,
+//! for the others: a dot in their colour on the tree row of the page they are on (on the nearest row shown when it is
+//! folded away), and on the same page the stroke they are drawing, their selection, their caret with their name and
+//! their pointer with its name tag. Pointers ease toward their latest place; carets jump with the typing. Someone who joins with no page open
+//! lands on the page the others are on. Pointers, name tags, colors and easing are the presence look's
+//! (playground_live::presence); the dots, carets, selections and strokes are drawn here in its colors.
+//! Everything in a state comes from another person: what doesn't read as a path or numbers in range is skipped.
+// The painting is web only (its hooks are); native tests use the projection.
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+use super::super::{Editor, NoteCraftApp};
+use super::{Presence, connected, valid};
+use crate::pageedit;
+use crate::theme::Tokens;
+use egui::{Color32, LayerId, Pos2, Rect, Shape, Stroke, vec2};
+use notecraft_formats::markdown::Block;
+use playground_live::presence;
+use serde_json::{Value, json};
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+/// The most readings of a stroke being drawn that a presence carries (the newest).
+const INK_POINTS: usize = 150;
+
+/// Where the page is drawn this frame.
+#[derive(Default)]
+struct Page {
+    /// The top left of the page's text (it moves with the scroll), and the clip of the page's scroll area.
+    origin: Option<Pos2>,
+    width: f32,
+    clip: Option<Rect>,
+    /// Each block as drawn, by index: its top left, how wide its column is, and the id of the ui it was drawn in
+    /// (a container's: its text box's id derives from it).
+    tops: Vec<(Pos2, f32, egui::Id)>,
+}
+
+thread_local! {
+    static PAGE: RefCell<Page> = RefCell::default();
+    /// This person's pointer over the page (from its top left), as of the last frame.
+    static POINTER: RefCell<Option<[f32; 2]>> = const { RefCell::new(None) };
+    /// The tree rows drawn this frame: path, row, clip.
+    static ROWS: RefCell<Vec<(PathBuf, Rect, Rect)>> = const { RefCell::new(Vec::new()) };
+    /// Someone who joined has been taken to the others' page.
+    static JOINED: RefCell<bool> = const { RefCell::new(false) };
+    /// The notebooks folder.
+    static ROOT: RefCell<PathBuf> = RefCell::default();
+    /// The page's widget id, which its text boxes' ids derive from.
+    static PAGE_ID: RefCell<Option<egui::Id>> = const { RefCell::new(None) };
+}
+
+/// The page or node this person is on, as a path in the notebooks folder.
+fn place(app: &NoteCraftApp) -> Option<String> {
+    let root = app.session.root();
+    let dir = app.editor.as_ref().map(|e| &e.dir).or(app.selected.as_ref())?;
+    let rel = dir.strip_prefix(root).ok()?.to_string_lossy().replace('\\', "/");
+    (!rel.is_empty()).then_some(rel)
+}
+
+/// To a tenth of a point (presence stays small).
+fn r(v: f32) -> f64 {
+    (f64::from(v) * 10.0).round() / 10.0
+}
+
+pub(super) fn mine(app: &NoteCraftApp) -> Value {
+    if app.backstage.is_some() {
+        return Value::Null;
+    }
+    let Some(page) = place(app) else { return Value::Null };
+    let mut s = json!({ "page": page });
+    if let Some(p) = POINTER.with_borrow(|p| *p).filter(|_| app.editor.is_some()) {
+        s["pointer"] = json!([r(p[0]), r(p[1])]);
+    }
+    if let Some(c) = app.editor.as_ref().and_then(|e| e.caret.as_ref()) {
+        s["caret"] = json!([c.block, c.selection.0]);
+        // A selection (being dragged out or made): where it starts.
+        if c.selection.1 != c.selection.0 {
+            s["selection"] = json!([c.block, c.selection.1]);
+        }
+    }
+    // The stroke being drawn: its width and its readings (the newest, a point every 2 points of travel).
+    if let Some(stroke) = app.pad.as_ref().and_then(|p| p.drawing_now.as_ref()) {
+        let mut points: Vec<[f32; 3]> = Vec::new();
+        for d in &stroke.dabs {
+            if points.last().is_none_or(|q| (q[0] - d.x).abs().max((q[1] - d.y).abs()) >= 2.0) {
+                points.push([d.x, d.y, d.pressure]);
+            }
+        }
+        let from = points.len().saturating_sub(INK_POINTS);
+        let pts: Vec<Value> = points[from..].iter().map(|p| json!([p[0].round(), p[1].round(), (p[2] * 100.0).round() / 100.0])).collect();
+        s["ink"] = json!({ "width": r(stroke.width), "points": pts });
+    }
+    s
+}
+
+pub(super) fn show(others: Vec<Presence>) {
+    if others.is_empty() {
+        JOINED.set(false);
+    }
+    presence::show(others);
+}
+
+/// A path someone gave, when it is one these notebooks could have.
+fn page_of(o: &Presence) -> Option<&str> {
+    o.state["page"].as_str().filter(|p| p.len() < 1024 && p.split('/').all(|s| !s.is_empty() && !s.starts_with('.') && !s.contains(['\\', ':'])))
+}
+
+/// A finite number of a sane size (remote data).
+fn coord(v: &Value) -> Option<f32> {
+    v.as_f64().filter(|c| c.abs() < 1e6).map(|c| c as f32)
+}
+
+/// Someone who just joined, with no page open, goes to the page the others are on (once).
+pub(super) fn join(app: &mut NoteCraftApp) {
+    if !connected() || JOINED.with_borrow(|j| *j) || app.editor.is_some() {
+        return;
+    }
+    let pages: Vec<String> = presence::others().iter().filter_map(page_of).map(str::to_owned).collect();
+    let root = app.session.root().to_path_buf();
+    if let Some(page) = pages.iter().find(|p| valid(&format!("{p}/index.html")) && notecraft_store::tree::page_file(&root.join(p)).is_some()) {
+        JOINED.set(true);
+        app.open_path(page);
+    }
+}
+
+/// The end of a frame: this person's pointer over the page (not over a window or menu on it).
+pub(super) fn note(app: &NoteCraftApp, ctx: &egui::Context) {
+    let pointer = PAGE.with_borrow(|page| {
+        let origin = page.origin.filter(|_| connected() && app.editor.is_some())?;
+        let p = ctx.pointer_hover_pos().filter(|p| page.clip.is_some_and(|c| c.contains(*p)))?;
+        ctx.layer_id_at(p).is_none_or(|l| l.order == egui::Order::Background).then_some([p.x - origin.x, p.y - origin.y])
+    });
+    POINTER.set(pointer);
+    PAGE.with_borrow_mut(|page| page.origin = None);
+    ROWS.with_borrow_mut(Vec::clear);
+}
+
+pub(super) fn page_start(ui: &egui::Ui) {
+    PAGE_ID.set(Some(ui.id()));
+    PAGE.with_borrow_mut(|p| {
+        (p.origin, p.width, p.clip) = (Some(ui.next_widget_position()), ui.available_width(), Some(ui.clip_rect()));
+        p.tops.clear();
+    });
+}
+
+/// Puts this person's text box cursor (`selection`: the cursor, then where it started) in block `block` before the
+/// next frame's keys arrive: a remote change moved the text, or the block (the box is keyed by the block's place,
+/// pageedit's `("page-block", i)`). False when the page was never drawn.
+pub(super) fn place_caret(ctx: &egui::Context, was: usize, block: usize, selection: (usize, usize)) -> bool {
+    // The container the caret was in (a block that moved stays in its container).
+    let Some(ui) = PAGE.with_borrow(|p| p.tops.get(was).map(|t| t.2)).or_else(|| PAGE_ID.with_borrow(|p| *p)) else { return false };
+    let id = ui.with(("page-block", block));
+    let mut state = egui::TextEdit::load_state(ctx, id).unwrap_or_default();
+    let at = |n| egui::text::CCursor::new(n);
+    state.cursor.set_char_range(Some(egui::text::CCursorRange { primary: at(selection.0), secondary: at(selection.1), h_pos: None }));
+    state.store(ctx, id);
+    ctx.memory_mut(|m| m.request_focus(id));
+    true
+}
+
+pub(super) fn block_top(i: usize, ui: &egui::Ui) {
+    PAGE.with_borrow_mut(|p| {
+        if p.tops.len() == i && i < 100_000 {
+            p.tops.push((ui.next_widget_position(), ui.available_width(), ui.id()));
+        }
+    });
+}
+
+pub(super) fn row(path: &Path, rect: Rect, clip: Rect) {
+    if connected() {
+        ROWS.with_borrow_mut(|rows| rows.push((path.to_path_buf(), rect, clip)));
+    }
+}
+
+/// The type size of a block and whether it is strong, as the page draws it (pageedit's `size_of`).
+fn size_of(block: &Block) -> (f32, bool) {
+    match block {
+        Block::Heading { level, .. } => ([28.0, 22.0, 18.0].get(usize::from(*level).saturating_sub(1)).copied().unwrap_or(16.0), true),
+        Block::Code { .. } | Block::MathBlock(_) => (13.5, false),
+        _ => (14.5, false),
+    }
+}
+
+/// How far a block's text starts from the page's left edge (a bullet, a number, a box, a quote bar), as drawn.
+fn lead(block: &Block, editing: bool) -> f32 {
+    match block {
+        Block::Item { depth, .. } => 8.0 + *depth as f32 * 18.0 + 22.0,
+        Block::Quote(_) => {
+            if editing {
+                18.0
+            } else {
+                12.0
+            }
+        }
+        Block::Code { .. } | Block::MathBlock(_) => {
+            if editing {
+                0.0
+            } else {
+                8.0
+            }
+        }
+        _ => 0.0,
+    }
+}
+
+/// Where someone's caret (at character `b` of block `i`, with the selection from `a`) shows: the caret's rectangle
+/// and the selection's band on each line. While this person writes in that block it shows with its marks; otherwise
+/// the marks are not drawn, so the text is measured without them (a close guess for marked-up words).
+fn marks(ui: &egui::Ui, page: &Page, ed: &Editor, i: usize, (a, b): (usize, usize), t: &Tokens) -> Option<(Rect, Vec<Rect>)> {
+    let (block, (top, column, _)) = (ed.blocks.get(i)?, *page.tops.get(i)?);
+    let editing = ed.caret.as_ref().is_some_and(|c| c.block == i);
+    let text = ed.caret.as_ref().filter(|_| editing).map_or_else(|| pageedit::block_text(block), |c| c.text.clone());
+    // Character `n` of the block's text, as drawn.
+    let (mut shown, mut skip, mut x) = (text.clone(), 0, 0.0_f32);
+    if !editing {
+        shown = pageedit::without_marks(&text);
+        if let (Some(_), rest) = notecraft_model::Tag::split(&shown) {
+            (skip, shown, x) = (shown.chars().count() - rest.chars().count(), rest.to_owned(), 29.0);
+        }
+    }
+    let at = |n: usize| -> usize {
+        let before: String = text.chars().take(n).collect();
+        let n = if editing { before.chars().count() } else { pageedit::without_marks(&before).chars().count() };
+        n.saturating_sub(skip).min(shown.chars().count())
+    };
+    let (size, strong) = size_of(block);
+    let left = lead(block, editing) + x;
+    let galley = ui.fonts_mut(|f| f.layout_job(crate::pagetext::inline_job(&shown, size, strong, t, (column - left).max(1.0), Default::default())));
+    let y = if !editing && matches!(block, Block::Heading { .. }) { 6.0 } else { 0.0 };
+    let place = |r: Rect| r.translate(top.to_vec2() + vec2(left, y));
+    let cursor = |n: usize| galley.pos_from_cursor(egui::text::CCursor::new(n));
+    let caret = place(cursor(at(b))).with_max_x(place(cursor(at(b))).min.x + 2.0);
+    let (from, to) = (cursor(at(a.min(b))), cursor(at(a.max(b))));
+    let mut bands = Vec::new();
+    if a != b {
+        for row in galley.rows.iter().map(|r| r.rect()).filter(|r| r.max.y > from.min.y + 0.5 && r.min.y < to.max.y - 0.5) {
+            let x0 = if row.min.y <= from.min.y + 0.5 { from.min.x } else { row.min.x };
+            let x1 = if row.max.y >= to.max.y - 0.5 { to.min.x } else { row.max.x };
+            bands.push(place(Rect::from_x_y_ranges(x0..=x1.max(x0), row.y_range())));
+        }
+    }
+    Some((caret, bands))
+}
+
+/// After the page's blocks: the others on this page, their carets with their names, then their pointers (eased by
+/// the presence look, which repaints while one is on its way).
+pub(super) fn page_end(ui: &egui::Ui, ed: &Editor, t: &Tokens) {
+    let others = presence::others();
+    PAGE.with_borrow(|page| {
+        let (Some(origin), Some(clip)) = (page.origin, page.clip) else { return };
+        let root = ROOT.with_borrow(Clone::clone);
+        let here: Vec<&Presence> = others.iter().filter(|o| page_of(o).is_some_and(|p| root.join(p) == ed.dir)).collect();
+        let painter = ui.painter().with_clip_rect(clip);
+        // What they are drawing, at its pen's width, in their colour, see-through.
+        for o in &here {
+            let ink = &o.state["ink"];
+            let width = coord(&ink["width"]).unwrap_or(3.0).clamp(0.5, 60.0);
+            let points: Vec<Pos2> = ink["points"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .take(INK_POINTS)
+                .filter_map(|p| Some(origin + vec2(coord(&p[0])?, coord(&p[1])?)))
+                .collect();
+            let color = presence::color(o).gamma_multiply(0.7);
+            if let [first, ..] = points.as_slice() {
+                painter.circle_filled(*first, width / 2.0, color);
+            }
+            if points.len() > 1 {
+                painter.add(Shape::line(points.clone(), Stroke::new(width, color)));
+                painter.circle_filled(points[points.len() - 1], width / 2.0, color);
+            }
+        }
+        for o in &here {
+            let caret = &o.state["caret"];
+            let n = |v: &Value| v.as_u64().and_then(|n| usize::try_from(n).ok()).map(|n| n.min(1_000_000));
+            let (Some(i), Some(b)) = (n(&caret[0]), n(&caret[1])) else { continue };
+            let a = n(&o.state["selection"][1]).filter(|_| n(&o.state["selection"][0]) == Some(i)).unwrap_or(b);
+            if let Some((rect, bands)) = marks(ui, page, ed, i, (a, b), t) {
+                let color = presence::color(o);
+                for band in bands {
+                    painter.rect_filled(band, 2.0, color.gamma_multiply(0.28));
+                }
+                painter.rect_filled(rect, 1.0, color);
+                presence::tag(&painter, rect.left_top() - vec2(0.0, 19.0), color, &o.name);
+            }
+        }
+        let far = f64::from(clip.width().max(clip.height()) / 4.0);
+        for o in &here {
+            let Some(to) = coord(&o.state["pointer"][0]).zip(coord(&o.state["pointer"][1])) else { continue };
+            let to = [f64::from(to.0), f64::from(to.1)];
+            if let Some([x, y]) = presence::ease(ui.ctx(), &o.id, "pointer", to, [1.0; 2], [far; 2]) {
+                presence::cursor(&painter, origin + vec2(x as f32, y as f32), presence::color(o), &o.name);
+            }
+        }
+    });
+}
+
+/// The tree: a dot in each other person's colour on the row of the page or node they are on, or on the nearest row
+/// above it that shows when its branch is folded.
+pub(super) fn rows(app: &NoteCraftApp, ctx: &egui::Context) {
+    let root = app.session.root();
+    ROOT.with_borrow_mut(|r| r.clone_from(&root.to_path_buf()));
+    let others = presence::others();
+    ROWS.with_borrow(|rows| {
+        let mut dots: HashMap<usize, usize> = HashMap::new();
+        for o in &others {
+            let Some(page) = page_of(o).map(|p| root.join(p)) else { continue };
+            let Some(at) = rows
+                .iter()
+                .enumerate()
+                .filter(|(_, (path, ..))| page.starts_with(path))
+                .max_by_key(|(_, (path, ..))| path.components().count())
+                .map(|(i, _)| i)
+            else {
+                continue;
+            };
+            let n = dots.entry(at).or_insert(0);
+            let (_, rect, clip) = &rows[at];
+            let painter = ctx.layer_painter(LayerId::background()).with_clip_rect(*clip);
+            let c = egui::pos2(rect.max.x - 62.0 - *n as f32 * 11.0, rect.center().y);
+            painter.circle(c, 4.5, presence::color(o), Stroke::new(1.5, Color32::WHITE));
+            *n += 1;
+        }
+    });
+}
