+// SPDX-License-Identifier: MIT OR Apache-2.0
+use super::*;
+use notecraft_engine::Session;
+use notecraft_store::Settings;
+use notecraft_store::testing::TempDir;
+
+#[test]
+fn two_people_typing_in_one_page_merge_without_losing_a_character() {
+    let base = "<h1>T</h1>\n<p>Hello world</p>\n<p>Second</p>\n";
+    // Different places of one line, and another line.
+    let alice = "<h1>T</h1>\n<p>Hello brave world</p>\n<p>Second</p>\n";
+    let bob = "<h1>T</h1>\n<p>Hello world!</p>\n<p>Second line</p>\n";
+    let want = "<h1>T</h1>\n<p>Hello brave world!</p>\n<p>Second line</p>\n";
+    assert_eq!(text::merge(base, alice, bob), want);
+    assert_eq!(text::merge(base, bob, alice), want);
+    // The same place: both keep their letters, in one order whichever came first.
+    let (a, b) = ("<h1>T</h1>\n<p>Hello Aworld</p>\n<p>Second</p>\n", "<h1>T</h1>\n<p>Hello Bworld</p>\n<p>Second</p>\n");
+    assert_eq!(text::merge(base, a, b), "<h1>T</h1>\n<p>Hello ABworld</p>\n<p>Second</p>\n");
+    assert_eq!(text::merge(base, b, a), text::merge(base, a, b));
+    // The same change from both (a page written back the same way on both sides) counts once.
+    let rewritten = "<h1>T</h1>\n<p>Hello world</p>\n\n<p>Second</p>\n";
+    assert_eq!(text::merge(base, rewritten, &rewritten.replace("Hello", "Hello A")), rewritten.replace("Hello", "Hello A"));
+    // A word deleted on one side while the other types into it: the typing stays, the rest of the word goes.
+    let deleted = "<h1>T</h1>\n<p>Hello </p>\n<p>Second</p>\n";
+    let typed = "<h1>T</h1>\n<p>Hello woXrld</p>\n<p>Second</p>\n";
+    assert_eq!(text::merge(base, deleted, typed), "<h1>T</h1>\n<p>Hello X</p>\n<p>Second</p>\n");
+
+    // The notebooks merge file by file: pages both changed merge as text, a page removed while changed conflicts.
+    let doc = |page: &str, other: Option<&str>| {
+        let mut files = Flat::from([("nb/_node.toml".to_owned(), "kind = \"notebook\"\n".into()), ("nb/s/p/index.html".to_owned(), page.into())]);
+        if let Some(o) = other {
+            files.insert("nb/s/q/index.md".to_owned(), o.into());
+        }
+        json!({ "files": nest(files), "media": {} })
+    };
+    let merged = NoteCraftApp::live_merge(&doc(base, Some("x")), &doc(alice, Some("x")), &doc(bob, Some("y"))).expect("merge");
+    assert_eq!(merged, doc(want, Some("y")));
+    assert!(NoteCraftApp::live_merge(&doc(base, Some("x")), &doc(alice, Some("x")), &doc(base, None)).is_ok_and(|m| m == doc(alice, None)));
+    assert!(NoteCraftApp::live_merge(&doc(base, Some("x")), &doc(base, Some("z")), &doc(base, None)).is_err());
+    // Ink (the page's ink.svg): two people drawing on one page at once both keep their strokes.
+    use notecraft_ink::{Dab, Drawing, Rgb, Stroke, Tool, svg};
+    let sheet = |xs: &[f32]| {
+        let mut d = Drawing::new(820.0, 1100.0);
+        for x in xs {
+            let mut s = Stroke::new(Tool::Pen, Rgb::BLACK, 3.0);
+            for i in 0..5 {
+                s.add(Dab::new(x + i as f32 * 10.0, 20.0, 0.5));
+            }
+            d.add(s);
+        }
+        svg::write(&d, svg::Flavour::Editable)
+    };
+    let drawn = text::merge(&sheet(&[0.0]), &sheet(&[0.0, 100.0]), &sheet(&[0.0, 200.0]));
+    assert_eq!(svg::read(&drawn).expect("still a drawing").0.strokes.len(), 3);
+    // Also the first strokes on a page, the file new on both sides.
+    let first = Flat::from([("nb/s/p/ink.svg".to_owned(), sheet(&[100.0]).into())]);
+    let other = Flat::from([("nb/s/p/ink.svg".to_owned(), sheet(&[200.0]).into())]);
+    let (none, a, b) =
+        (json!({ "files": {}, "media": {} }), json!({ "files": nest(first), "media": {} }), json!({ "files": nest(other), "media": {} }));
+    let merged = NoteCraftApp::live_merge(&none, &a, &b).expect("both drew");
+    let ink = merged["files"]["nb"]["s"]["p"]["ink.svg"].as_str().expect("ink");
+    assert_eq!(svg::read(ink).expect("one drawing").0.strokes.len(), 2);
+    // A path that leaves the notebooks folder is never installed.
+    let mut bad = doc(base, None);
+    bad["files"][".."] = json!({ "escape": { "index.html": "x" } });
+    assert!(NoteCraftApp::live_check(&bad).is_err());
+}
+
+#[test]
+fn a_remote_change_to_the_page_being_written_keeps_the_typing_and_moves_the_caret() {
+    let t = TempDir::new("live1");
+    let root = t.path().join("notes");
+    let mut session = Session::new(&root, Settings::at(root.join(".notecraft").join("settings.toml"))).expect("session");
+    notecraft_engine::sample::create_sample(&mut session, None).expect("sample");
+    let mut app = NoteCraftApp::new(session);
+    app.open_path("my-notebook/work/projects/project-x");
+    app.expand_all();
+    let open = app.open.clone();
+    // The page as NoteCraft writes it once someone has written on it.
+    let ed = app.editor.as_mut().expect("page");
+    ed.body = pageedit::to_body(ed.format, &ed.blocks);
+    ed.dirty_since = Some(std::time::Instant::now());
+    app.save_page_now();
+    let base = app.live_document();
+    assert!(parts(&base).expect("parts").0.keys().all(|k| !k.contains(".notecraft")), "settings stay personal");
+
+    // This person types "Hi " at the start of the paragraph under the title, not saved yet: it is shared already.
+    let ed = app.editor.as_mut().expect("page");
+    let mut c = Caret { block: 1, text: pageedit::block_text(&ed.blocks[1]), focus: false, selection: (0, 0), place: None, ..Default::default() };
+    c.text.insert_str(0, "Hi ");
+    c.selection = (3, 3);
+    pageedit::set_block_text(&mut ed.blocks[1], &c.text);
+    ed.caret = Some(c);
+    ed.body = pageedit::to_body(ed.format, &ed.blocks);
+    ed.dirty_since = Some(std::time::Instant::now());
+    let mine = app.live_document();
+    let page = |doc: &Value| parts(doc).expect("parts").0["my-notebook/work/projects/project-x/index.html"].as_str().expect("page").to_owned();
+    assert!(page(&mine).contains("Hi Kickoff"));
+
+    // Meanwhile someone adds a paragraph above it and types at the end of the same paragraph.
+    let theirs_text = page(&base).replacen("</h1>\n", "</h1>\n<p>Top</p>\n", 1).replacen(".</p>\n", ".!</p>\n", 1);
+    let mut theirs = base.clone();
+    theirs["files"]["my-notebook"]["work"]["projects"]["project-x"]["index.html"] = theirs_text.into();
+    let merged = NoteCraftApp::live_merge(&base, &mine, &theirs).expect("merge");
+    app.live_adopt(merged.clone()).expect("adopt");
+
+    let ed = app.editor.as_ref().expect("still open");
+    let c = ed.caret.as_ref().expect("caret");
+    assert_eq!(pageedit::block_text(&ed.blocks[1]), "Top");
+    assert_eq!(c.block, 2, "the caret went down with its paragraph");
+    assert!(c.text.starts_with("Hi Kickoff") && c.text.ends_with(".!"), "{}", c.text);
+    assert_eq!((c.selection, c.place), ((3, 3), Some(3)), "and stayed after what this person typed");
+    assert_eq!(app.open, open, "the tree stays as this person left it");
+    assert_eq!(playground_live::canonical(&app.live_document()), playground_live::canonical(&merged), "no change of its own");
+}
