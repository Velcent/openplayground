+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! Live editing in a Playground session (the shell's `shell/live.js` drives it through `playground_live::web`);
+//! nothing here runs until the shell connects, and native builds never call it.
+//!
+//! The shared document is the notebooks folder as its files, nested like its folders: every notebook, section group
+//! and section (`_node.toml`), every page (`index.html` / `index.md`) and its ink (`ink.svg`) as text (`files`), and
+//! each picture or attached file of a page as a content id (`media`; its bytes travel as session media). The page being written
+//! counts as it is on screen, not as last saved, so every keystroke reaches the others. Each page's `updated` time
+//! stays out: it is each browser's own (when it last saw a change). Personal things stay out too: the settings
+//! (`.notecraft/`), which branches are open, the page shown, the caret, the source pane, the theme.
+//!
+//! The merge goes file by file: a file one side changed takes that change; a file both changed merges as text
+//! (`text.rs`: by line, then by character; never a conflict, never a lost character), and so does one both added (over
+//! the lines they share: two people's first strokes on a page). A file one side removed while the other changed it
+//! conflicts. A remote change installs at the end of a
+//! quiet frame (no button held): the files are written, the tree is read again, and the open page takes the merged
+//! text with the caret moved to where its text went.
+//!
+//! While connected, Ctrl+Z and Ctrl+Y (the text boxes' own undo, which would also take back what others typed into
+//! the same block) go to the session, which takes back only this person's edits (the web entry routes the keys).
+//!
+//! The session and the presence look (pointers, name tags, colors, easing) are the playground-live crate's
+//! (patches/live/kit); the tree's dots, carets, selections and strokes being drawn are NoteCraft's own (`peers.rs`).
+// The page and tree hooks are web only; native tests use the rest.
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+#[path = "live/peers.rs"]
+mod peers;
+#[path = "live/text.rs"]
+mod text;
+
+use super::{Editor, NoteCraftApp};
+use crate::pageedit::{self, Caret};
+use crate::preview;
+use notecraft_formats::markdown::Block;
+use notecraft_formats::{frontmatter, html};
+use notecraft_model::{PageFormat, kv, time::iso_now};
+use playground_live::{Error, Live, Presence};
+use serde_json::{Map, Value, json};
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::path::Path;
+#[cfg(not(target_arch = "wasm32"))]
+use std::path::PathBuf;
+
+#[cfg(target_arch = "wasm32")]
+use notecraft_model::playground::std::fs;
+#[cfg(not(target_arch = "wasm32"))]
+use std::fs;
+
+pub use playground_live::{connected, undo};
+
+thread_local! {
+    /// Pictures and files the shared document names that have not arrived here yet: path -> content id.
+    static WANTED: RefCell<BTreeMap<String, String>> = const { RefCell::new(BTreeMap::new()) };
+    /// The egui context, for the input state (`live_quiet`, presence) and repaints after a remote change.
+    static CTX: std::cell::OnceCell<egui::Context> = const { std::cell::OnceCell::new() };
+}
+
+fn with_ctx<R>(f: impl FnOnce(&egui::Context) -> R) -> Option<R> {
+    CTX.with(|c| c.get().map(f))
+}
+
+// ---------------------------------------------------------------- the files
+
+/// What a file of the notebooks folder is to the shared document: a node's or a page's text, or a page's media.
+#[derive(PartialEq)]
+enum Kind {
+    Text,
+    Media,
+}
+
+fn kind(rel: &str) -> Option<Kind> {
+    let mut parts = rel.rsplit('/');
+    let (name, parent) = (parts.next()?, parts.next());
+    if parent == Some("assets") {
+        return Some(Kind::Media);
+    }
+    matches!(name, "_node.toml" | "index.html" | "index.md" | "ink.svg").then_some(Kind::Text)
+}
+
+/// A path the shared document may name: inside the notebooks folder, no dot folders, a file that belongs there.
+fn valid(rel: &str) -> bool {
+    rel.len() < 1024 && rel.split('/').all(|p| !p.is_empty() && !p.starts_with('.') && !p.contains(['\\', ':', '\0'])) && kind(rel).is_some()
+}
+
+/// A content id as `fs::content_id` gives it.
+fn valid_id(id: &str) -> bool {
+    id.split_once('-').is_some_and(|(h, n)| {
+        h.len() == 16 && h.bytes().all(|b| b.is_ascii_hexdigit()) && !n.is_empty() && n.len() < 13 && n.bytes().all(|b| b.is_ascii_digit())
+    })
+}
+
+fn rel_of(root: &Path, path: &Path) -> Option<String> {
+    let rel = path.strip_prefix(root).ok()?.to_string_lossy().replace('\\', "/");
+    valid(&rel).then_some(rel)
+}
+
+/// Every file at or below `dir` with its bytes and content id.
+#[cfg(target_arch = "wasm32")]
+fn walk(dir: &Path, f: &mut dyn FnMut(&Path, &[u8], &str)) {
+    fs::walk(dir, f);
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn walk(dir: &Path, f: &mut dyn FnMut(&Path, &[u8], &str)) {
+    let mut paths: Vec<PathBuf> = fs::read_dir(dir).into_iter().flatten().flatten().map(|e| e.path()).collect();
+    paths.sort();
+    for p in paths {
+        if p.is_dir() {
+            walk(&p, f);
+        } else if let Ok(bytes) = fs::read(&p) {
+            f(&p, &bytes, &content_id(&bytes));
+        }
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+use fs::content_id;
+
+#[cfg(not(target_arch = "wasm32"))]
+fn content_id(bytes: &[u8]) -> String {
+    let hash = bytes.iter().fold(0xcbf2_9ce4_8422_2325_u64, |h, b| (h ^ u64::from(*b)).wrapping_mul(0x0100_0000_01b3));
+    format!("{hash:016x}-{}", bytes.len())
+}
+
+/// The page's `updated` time set to `value` where the page has one (blank: as shared).
+fn stamp(rel: &str, text: &str, value: &str) -> String {
+    if rel.ends_with("index.html") && text.contains("name=\"notecraft:updated\" content=\"") {
+        html::set_meta(text, "notecraft:updated", value)
+    } else if rel.ends_with("index.md") {
+        let (front, body) = frontmatter::split_front(text);
+        if front.is_empty() {
+            return text.to_owned();
+        }
+        let line = if value.is_empty() { "updated:".to_owned() } else { format!("updated: {value}") };
+        format!("{}{body}", kv::replace_line(&front, "updated:", &line))
+    } else {
+        text.to_owned()
+    }
+}
+
+/// A page file with `body` in it, as `page.save` writes it (but for the time).
+fn with_body(text: &str, format: PageFormat, body: &str) -> String {
+    match format {
+        PageFormat::Html => html::replace_inner(text, body),
+        PageFormat::Cmgfm => format!("{}\n{}", frontmatter::split_front(text).0, body.trim_start_matches('\n')),
+    }
+}
+
+/// The editable part of a page file, as `page.load` reads it.
+fn body_of(text: &str, format: PageFormat) -> String {
+    match format {
+        PageFormat::Html => html::inner(text),
+        PageFormat::Cmgfm => frontmatter::split_front(text).1.trim_start_matches('\n').to_owned(),
+    }
+}
+
+/// Files by their path in the notebooks folder.
+type Flat = BTreeMap<String, Value>;
+
+/// Files as the shared document holds them: nested like their folders (`{"my-notebook": {"_node.toml": …}}`).
+fn nest(flat: Flat) -> Value {
+    let mut root = Map::new();
+    for (rel, v) in flat {
+        let (dirs, name) = rel.rsplit_once('/').map_or((None, rel.as_str()), |(d, n)| (Some(d), n));
+        let mut at = Some(&mut root);
+        for d in dirs.into_iter().flat_map(|d| d.split('/')) {
+            at = at.and_then(|m| m.entry(d).or_insert_with(|| Map::new().into()).as_object_mut());
+        }
+        if let Some(m) = at {
+            m.insert(name.to_owned(), v);
+        }
+    }
+    root.into()
+}
+
+/// The files of a nested part of the shared document, by path; a folder without files is refused.
+fn flat(tree: &Value, prefix: &str, out: &mut Flat) -> Result<(), Error> {
+    for (k, v) in tree.as_object().ok_or_else(|| format!("Invalid shared notebooks at {prefix}"))? {
+        let path = if prefix.is_empty() { k.clone() } else { format!("{prefix}/{k}") };
+        match v {
+            Value::Object(m) if !m.is_empty() => flat(v, &path, out)?,
+            Value::String(_) => {
+                out.insert(path, v.clone());
+            }
+            _ => return Err(format!("Invalid shared notebooks at {path}")),
+        }
+    }
+    Ok(())
+}
+
+/// The shared document's files and media, by path.
+fn parts(doc: &Value) -> Result<(Flat, Flat), Error> {
+    let (mut files, mut media) = (Flat::new(), Flat::new());
+    flat(&doc["files"], "", &mut files)?;
+    flat(&doc["media"], "", &mut media)?;
+    Ok((files, media))
+}
+
+fn document(app: &NoteCraftApp) -> Value {
+    let root = app.session.root();
+    let (mut files, mut media) = (Flat::new(), Flat::new());
+    walk(root, &mut |path, bytes, id| {
+        let Some(rel) = rel_of(root, path) else { return };
+        if kind(&rel) == Some(Kind::Text) {
+            let text = stamp(&rel, &String::from_utf8_lossy(bytes), "");
+            files.insert(rel, text.into());
+        } else {
+            media.insert(rel, id.into());
+        }
+    });
+    // The page being written, as it is on screen: the window saves it a moment later.
+    if let Some(ed) = app.editor.as_ref().filter(|e| e.dirty_since.is_some()) {
+        let file = ed.dir.join(ed.format.file_name());
+        if let (Some(rel), Ok(text)) = (rel_of(root, &file), fs::read_to_string(&file)) {
+            let text = stamp(&rel, &with_body(&text, ed.format, &ed.body), "");
+            files.insert(rel, text.into());
+        }
+    }
+    WANTED.with_borrow(|w| {
+        for (rel, id) in w {
+            media.entry(rel.clone()).or_insert_with(|| id.clone().into());
+        }
+    });
+    json!({ "files": nest(files), "media": nest(media) })
+}
+
+/// Whether every peer can install `doc`: files and media under paths that stay in the notebooks folder.
+fn check(doc: &Value) -> Result<(), Error> {
+    let (files, media) = parts(doc)?;
+    if doc.as_object().map_or(0, Map::len) != 2 {
+        return Err("Invalid shared notebooks: unknown parts".into());
+    }
+    for (rel, text) in &files {
+        if !valid(rel) || kind(rel) != Some(Kind::Text) || text.as_str().is_none_or(|t| t.len() > notecraft_store::page::MAX_PAGE_BYTES) {
+            return Err(format!("Invalid shared notebooks: {rel}"));
+        }
+    }
+    for (rel, id) in &media {
+        if !valid(rel) || kind(rel) != Some(Kind::Media) || !id.as_str().is_some_and(valid_id) || files.contains_key(rel) {
+            return Err(format!("Invalid shared notebooks: {rel}"));
+        }
+    }
+    Ok(())
+}
+
+/// The bytes of a file here with content `id`.
+fn find(root: &Path, id: &str) -> Option<Vec<u8>> {
+    let mut found = None;
+    walk(root, &mut |_, bytes, have| {
+        if found.is_none() && have == id {
+            found = Some(bytes.to_vec());
+        }
+    });
+    found
+}
+
+/// Removes `dir` and the folders above it (below `root`) while they are empty.
+fn prune(root: &Path, dir: Option<&Path>) {
+    let mut dir = dir;
+    while let Some(d) = dir.filter(|d| d.starts_with(root) && *d != root) {
+        if fs::read_dir(d).map(|mut r| r.next().is_some()).unwrap_or(true) || fs::remove_dir(d).is_err() {
+            return;
+        }
+        dir = d.parent();
+    }
+}
+
+fn adopt(app: &mut NoteCraftApp, doc: Value) -> Result<(), Error> {
+    check(&doc)?;
+    let current = document(app);
+    if current == doc {
+        return Ok(());
+    }
+    let root = app.session.root().to_path_buf();
+    let ((cf, cm), (df, dm)) = (parts(&current)?, parts(&doc)?);
+    let gone = cf.keys().filter(|k| !df.contains_key(*k)).chain(cm.keys().filter(|k| !dm.contains_key(*k)));
+    for rel in gone {
+        let path = root.join(rel);
+        let _ = fs::remove_file(&path);
+        WANTED.with_borrow_mut(|w| w.remove(rel));
+        prune(&root, path.parent());
+    }
+    let write = |rel: &str, bytes: &[u8]| {
+        let path = root.join(rel);
+        if let Some(dir) = path.parent() {
+            let _ = fs::create_dir_all(dir);
+        }
+        fs::write(path, bytes).map_err(|e| format!("Could not write {rel}: {e}"))
+    };
+    for (rel, text) in df.iter().filter(|(k, v)| cf.get(*k) != Some(*v)) {
+        write(rel, stamp(rel, text.as_str().unwrap_or_default(), &iso_now()).as_bytes())?;
+    }
+    for (rel, id) in dm.iter().filter(|(k, v)| cm.get(*k) != Some(*v)) {
+        let id = id.as_str().unwrap_or_default();
+        match find(&root, id) {
+            Some(bytes) => write(rel, &bytes)?,
+            None => {
+                let _ = fs::remove_file(root.join(rel));
+                WANTED.with_borrow_mut(|w| w.insert(rel.clone(), id.to_owned()));
+            }
+        }
+    }
+    app.session.refresh();
+    // The open page's ink, when it changed: read again from its file (nothing is being drawn: this is a quiet frame).
+    let ink = app.editor.as_ref().and_then(|ed| rel_of(&root, &ed.dir.join(crate::inkpad::FILE)));
+    if let (Some(rel), Some(ed)) = (ink, app.editor.as_ref())
+        && cf.get(&rel) != df.get(&rel)
+    {
+        app.pad = Some(crate::inkpad::Pad::of_page(&ed.dir));
+    }
+    // The open page as merged (its file may still be the last save: what is on screen counts).
+    let page = app.editor.as_ref().and_then(|ed| rel_of(&root, &ed.dir.join(ed.format.file_name())));
+    follow_page(app, page.and_then(|rel| df.get(&rel)).and_then(Value::as_str));
+    with_ctx(egui::Context::request_repaint);
+    Ok(())
+}
+
+/// The open page after a remote change: its text as merged, the caret where its text went, its title and files.
+fn follow_page(app: &mut NoteCraftApp, text: Option<&str>) {
+    let Some(ed) = app.editor.as_mut() else { return };
+    let Some(text) = text else {
+        // Someone removed the page.
+        app.editor = None;
+        app.status = "Someone in the session removed this page".into();
+        return;
+    };
+    let body = body_of(text, ed.format);
+    if body.trim_matches('\n') != ed.body.trim_matches('\n') {
+        let blocks = preview::blocks_for(ed.format, &body);
+        let was = ed.caret.as_ref().map(|c| c.block);
+        ed.caret = ed.caret.take().and_then(|c| caret(&ed.blocks, &blocks, c));
+        // The text box takes its new cursor before the next key, not after it (that key would land where the text was).
+        if let (Some(c), Some(was)) = (ed.caret.as_mut().filter(|c| c.focus), was)
+            && with_ctx(|ctx| peers::place_caret(ctx, was, c.block, c.selection)) == Some(true)
+        {
+            (c.focus, c.place) = (false, None);
+        }
+        ed.writable = pageedit::round_trips(ed.format, &body);
+        (ed.blocks, ed.body) = (blocks, body);
+    }
+    if let Some(info) = notecraft_store::tree::read_node(&ed.dir) {
+        if ed.title_buf == ed.title {
+            ed.title_buf = info.title.clone();
+        }
+        ed.title = info.title;
+    }
+    ed.attachments = notecraft_store::assets::list(&ed.dir);
+    // The boxes the blocks sit in and the page's direction travel in the page's own file.
+    ed.boxes = notecraft_store::page::containers(&ed.dir).unwrap_or_default();
+    ed.page_dir = notecraft_store::page::load_page(&ed.dir).ok().and_then(|p| p.dir);
+}
+
+/// Where the caret in `old` goes in `new`: the same block where it is unchanged (only its index may move), else the
+/// changed block between the same unchanged neighbours that keeps most of its text, at the same place in its text.
+fn caret(old: &[Block], new: &[Block], c: Caret) -> Option<Caret> {
+    let m = text::matches(old, new, |a, b| a == b);
+    let to = |block: usize, text: String, at: usize| Caret { block, text, focus: true, selection: (at, at), place: Some(at), ..Default::default() };
+    if let Some(j) = m.get(c.block).copied().flatten() {
+        // The text box is keyed by the block's place: one that moved takes the keyboard again where it was.
+        return Some(if j == c.block { c } else { Caret { block: j, focus: true, place: Some(c.selection.0), ..c } });
+    }
+    let lo = m.get(..c.block.min(m.len())).and_then(|before| before.iter().rev().find_map(|j| *j)).map_or(0, |j| j + 1);
+    let hi = m.get(c.block..).and_then(|after| after.iter().find_map(|j| *j)).unwrap_or(new.len());
+    let mine = old.get(c.block).map(pageedit::block_text).unwrap_or_default();
+    let kept = |b: &Block| {
+        let (a, t): (Vec<char>, Vec<char>) = (mine.chars().collect(), pageedit::block_text(b).chars().collect());
+        text::matches(&a, &t, |x, y| x == y).iter().flatten().count()
+    };
+    let j = (lo..hi.min(new.len()))
+        .filter(|j| new.get(*j).is_some_and(pageedit::is_writable))
+        .max_by_key(|j| (new.get(*j).map(kept), std::cmp::Reverse(*j)))?;
+    let text = new.get(j).map(pageedit::block_text)?;
+    let at = text::map_pos(&mine, &text, c.selection.0);
+    Some(to(j, text, at))
+}
+
+// ---------------------------------------------------------------- the app's side
+
+/// Merges two people's notebooks file by file (see the top); a folder left without files goes.
+fn merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+    fn tree(b: Option<&Value>, c: Option<&Value>, e: Option<&Value>, text: bool, at: &str) -> Result<Option<Value>, Error> {
+        if e == b {
+            return Ok(c.cloned());
+        }
+        if c == b {
+            return Ok(e.cloned());
+        }
+        match (b, c, e) {
+            (Some(Value::String(bt)), Some(Value::String(ct)), Some(Value::String(et))) if text => Ok(Some(text::merge(bt, ct, et).into())),
+            (None, Some(Value::String(ct)), Some(Value::String(et))) if text => Ok(Some(text::merge_added(ct, et).into())),
+            (b, Some(Value::Object(co)), Some(Value::Object(eo))) if b.is_none_or(Value::is_object) => {
+                let none = Map::new();
+                let bo = b.and_then(Value::as_object).unwrap_or(&none);
+                let mut out = Map::new();
+                for k in bo.keys().chain(co.keys()).chain(eo.keys()) {
+                    if !out.contains_key(k)
+                        && let Some(v) = tree(bo.get(k), co.get(k), eo.get(k), text, &format!("{at}/{k}"))?
+                    {
+                        out.insert(k.clone(), v);
+                    }
+                }
+                Ok((!out.is_empty()).then(|| out.into()))
+            }
+            _ => Err(format!("Conflict at {at}")),
+        }
+    }
+    let mut out = Map::new();
+    for part in ["files", "media"] {
+        let merged = tree(base.get(part), current.get(part), edited.get(part), part == "files", part)?;
+        out.insert(part.to_owned(), merged.unwrap_or_else(|| Map::new().into()));
+    }
+    Ok(out.into())
+}
+
+impl Live for NoteCraftApp {
+    fn live_document(&self) -> Value {
+        document(self)
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), Error> {
+        adopt(self, document)
+    }
+
+    /// No button held: a click, a text selection being dragged or a scroll bar being moved. Not the presence look's
+    /// `quiet`, which also waits for no text field focused: the page's text box keeps the keyboard while this person
+    /// writes, and the others' typing goes in then (the caret follows its text).
+    fn live_quiet(&self) -> bool {
+        !with_ctx(|ctx| ctx.input(|i| i.pointer.any_down())).unwrap_or(false)
+    }
+
+    /// The in-memory folder's change count and the page being written: a frame with neither changed reads nothing.
+    #[cfg(target_arch = "wasm32")]
+    fn live_generation(&self) -> Option<u64> {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        fs::generation().hash(&mut h);
+        self.editor.as_ref().map(|e| (&e.dir, &e.body, e.dirty_since.is_some())).hash(&mut h);
+        WANTED.with_borrow(|w| w.len()).hash(&mut h);
+        Some(h.finish())
+    }
+
+    fn live_disconnected(&mut self) {
+        WANTED.with_borrow_mut(BTreeMap::clear);
+    }
+
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let media = parts(&document(self)).map(|(_, media)| media).unwrap_or_default();
+        let wanted: Vec<String> = WANTED.with_borrow(|w| w.values().cloned().collect());
+        let mut out: Vec<(String, String, bool)> = Vec::new();
+        for (rel, id) in media {
+            let Some(id) = id.as_str() else { continue };
+            if out.iter().all(|(have, ..)| have != id) {
+                let name = rel.rsplit('/').next().unwrap_or("file").to_owned();
+                out.push((id.to_owned(), name, !wanted.iter().any(|w| w == id)));
+            }
+        }
+        out
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        parts(document).map(|(_, media)| media.into_values().filter_map(|id| id.as_str().map(str::to_owned)).collect()).unwrap_or_default()
+    }
+
+    fn live_read_asset(&self, id: &str) -> Option<Vec<u8>> {
+        find(self.session.root(), id)
+    }
+
+    /// Someone's picture or file: every page that names it gets it (when the bytes are what the id says).
+    fn live_write_asset(&mut self, id: &str, _name: &str, bytes: Vec<u8>) {
+        if content_id(&bytes) != id {
+            return;
+        }
+        let root = self.session.root().to_path_buf();
+        let paths: Vec<String> = WANTED.with_borrow(|w| w.iter().filter(|(_, v)| *v == id).map(|(k, _)| k.clone()).collect());
+        for rel in paths {
+            let path = root.join(&rel);
+            let _ = path.parent().map(fs::create_dir_all);
+            if fs::write(&path, &bytes).is_ok() {
+                WANTED.with_borrow_mut(|w| w.remove(&rel));
+            }
+        }
+        if let Some(ed) = self.editor.as_mut() {
+            ed.attachments = notecraft_store::assets::list(&ed.dir);
+        }
+        // Pictures that failed to load before load again.
+        with_ctx(egui::Context::forget_all_images);
+    }
+
+    fn live_presence(&self) -> Value {
+        peers::mine(self)
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        peers::show(others);
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+        merge(base, current, edited)
+    }
+
+    fn live_check(document: &Value) -> Result<(), Error> {
+        check(document)
+    }
+}
+
+// ---------------------------------------------------------------- hooks
+
+/// The end of each frame, after the window's own: the others' marks in the tree, the presence look's frame (after
+/// all the marks are drawn), the page the others are on for someone who just joined, the session's frame (remote
+/// changes in, this person's out, once quiet), then this person's pointer for their presence.
+pub fn frame(app: &mut NoteCraftApp, ctx: &egui::Context) {
+    CTX.with(|c| {
+        c.get_or_init(|| ctx.clone());
+    });
+    peers::rows(app, ctx);
+    playground_live::presence::end_frame(ctx);
+    peers::join(app);
+    playground_live::frame(app);
+    peers::note(app, ctx);
+}
+
+/// Before the page's blocks are drawn (app.rs, around `pageedit::show`): where the page is.
+pub(crate) fn page_start(ui: &egui::Ui) {
+    peers::page_start(ui);
+}
+
+/// After the page's blocks: the others' carets and pointers on this page.
+pub(super) fn page_end(ui: &egui::Ui, ed: &Editor, tokens: &crate::theme::Tokens) {
+    peers::page_end(ui, ed, tokens);
+}
+
+/// The top of block `i` as the page draws it (pageedit.rs).
+pub(crate) fn block_top(i: usize, ui: &egui::Ui) {
+    peers::block_top(i, ui);
+}
+
+/// A row of the notebook tree as drawn (app.rs `draw_node`).
+pub(crate) fn row(path: &Path, rect: egui::Rect, clip: egui::Rect) {
+    peers::row(path, rect, clip);
+}
+
+/// Offers the adapter to the Playground shell (the web entry calls it once the window runs).
+#[cfg(target_arch = "wasm32")]
+pub fn attach(
+    with_app: impl Fn(&mut dyn FnMut(&mut NoteCraftApp)) -> bool + 'static,
+    repaint: impl Fn() + 'static,
+) -> Result<(), wasm_bindgen::JsValue> {
+    playground_live::web::attach::<NoteCraftApp>(concat!("onenote:1:", env!("CARGO_PKG_VERSION")), with_app, repaint)
+}
+
+#[cfg(test)]
+#[path = "live/tests.rs"]
+mod tests;
diff --git a/crates/ui-egui/src/app/live/peers.rs b/crates/ui-egui/src/app/live/peers.rs
