+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! The three-way merge of a page's text (or any file of the notebooks) for live editing: as git merges, first by
+//! line, then, where both sides changed the same lines, character by character. It never conflicts and never drops a
+//! character someone typed: a character either side deleted goes, everything either side inserted stays (the same
+//! text inserted at one place by both counts once: the same change), and two insertions at one place go in a fixed
+//! order (the smaller text first), so `merge(b, c, e) == merge(b, e, c)` and every browser comes to the same page
+//! whichever change it saw first.
+
+/// Edit distance [`matches`] works out exactly; past it the middle counts as all changed (both sides' text is kept,
+/// so nothing typed is lost, but a delete on the other side inside that stretch may come back).
+// ponytail: O(D²) memory for the trace (about 8 MB at the cap); a linear-space Myers if bigger edits must merge.
+const MAX_EDITS: isize = 1000;
+
+pub fn merge(base: &str, current: &str, edited: &str) -> String {
+    if edited == base {
+        return current.to_owned();
+    }
+    if current == base {
+        return edited.to_owned();
+    }
+    fn lines(s: &str) -> Vec<&str> {
+        s.split_inclusive('\n').collect()
+    }
+    let (b, c, e) = (lines(base), lines(current), lines(edited));
+    let (mc, me) = (matches(&b, &c, |x, y| x == y), matches(&b, &e, |x, y| x == y));
+    let (mut i, mut j, mut k) = (0, 0, 0);
+    let mut out = String::new();
+    loop {
+        while i < b.len() && mc[i] == Some(j) && me[i] == Some(k) {
+            out.push_str(b[i]);
+            (i, j, k) = (i + 1, j + 1, k + 1);
+        }
+        let next = (i..b.len()).find_map(|x| Some((x, mc[x]?, me[x]?))).unwrap_or((b.len(), c.len(), e.len()));
+        if next == (i, j, k) {
+            return out;
+        }
+        let (bb, cc, ee) = (b[i..next.0].concat(), c[j..next.1].concat(), e[k..next.2].concat());
+        if cc == bb {
+            out.push_str(&ee);
+        } else if ee == bb {
+            out.push_str(&cc);
+        } else {
+            out.push_str(&chars(&bb, &cc, &ee));
+        }
+        (i, j, k) = next;
+    }
+}
+
+/// A file both sides added at once (the first strokes on a page, from two pens): merged over the lines they share, so
+/// what they have in common is there once and what each added is kept.
+pub fn merge_added(current: &str, edited: &str) -> String {
+    let (c, e): (Vec<&str>, Vec<&str>) = (current.split_inclusive('\n').collect(), edited.split_inclusive('\n').collect());
+    let common: String = c.iter().zip(matches(&c, &e, |x, y| x == y)).filter_map(|(line, m)| m.map(|_| *line)).collect();
+    merge(&common, current, edited)
+}
+
+/// What one side did to the base, character by character: which base characters it kept, and what it inserted in
+/// each gap (gap `g` is before base character `g`; the last one is at the end).
+struct Edit {
+    kept: Vec<bool>,
+    inserted: Vec<String>,
+}
+
+fn edit(b: &[char], x: &[char]) -> Edit {
+    let m = matches(b, x, |p, q| p == q);
+    let mut inserted = vec![String::new(); b.len() + 1];
+    let mut at = 0;
+    // Characters of `x` between two kept base characters go in the gap before the next kept one.
+    for (i, j) in m.iter().enumerate().filter_map(|(i, j)| Some((i, (*j)?))).chain([(b.len(), x.len())]) {
+        inserted[i].extend(&x[at..j]);
+        at = j + 1;
+    }
+    let kept: Vec<bool> = m.iter().map(Option::is_some).collect();
+    // One place for an insertion among equal characters (`a|ab` and `aa|b` insert the same `a`): the furthest right,
+    // so the same insertion from both sides meets in one gap and counts once.
+    for g in (0..b.len()).rev() {
+        let mut at = g;
+        while at < b.len() && kept[at] && inserted[at + 1].is_empty() && inserted[at].starts_with(b[at]) {
+            let mut ins: String = inserted[at].chars().skip(1).collect();
+            ins.push(b[at]);
+            inserted[at].clear();
+            inserted[at + 1] = ins;
+            at += 1;
+        }
+    }
+    // New lines go in at a line's start: `<p>|Top</p>\n<p>|Kick` (the diff's pick) reads `|<p>Top</p>\n|<p>Kick`, the
+    // same text, so that what the other side typed at the start of the next line stays on that line.
+    for g in 1..=b.len() {
+        let ins: Vec<char> = inserted[g].chars().collect();
+        if !ins.contains(&'\n') || ins.last() == Some(&'\n') {
+            continue;
+        }
+        let fits = |k: usize| (1..=k).all(|t| kept[g - t] && b[g - t] == ins[ins.len() - t] && inserted[g - t].is_empty());
+        if let Some(k) = (1..ins.len().min(g + 1)).take_while(|k| fits(*k)).find(|k| ins[ins.len() - 1 - k] == '\n') {
+            inserted[g - k] = b[g - k..g].iter().chain(&ins[..ins.len() - k]).collect();
+            inserted[g].clear();
+        }
+    }
+    Edit { kept, inserted }
+}
+
+/// Both sides changed this stretch: each base character stays unless either side deleted it, and both sides'
+/// insertions stay, the smaller first where they meet.
+fn chars(base: &str, current: &str, edited: &str) -> String {
+    let (b, c, e): (Vec<char>, Vec<char>, Vec<char>) = (base.chars().collect(), current.chars().collect(), edited.chars().collect());
+    let (ec, ee) = (edit(&b, &c), edit(&b, &e));
+    let mut out = String::new();
+    for g in 0..=b.len() {
+        let (x, y) = (&ec.inserted[g], &ee.inserted[g]);
+        // The same text from both (both pages written back the same way): once.
+        let (first, second) = if x <= y { (x, y) } else { (y, x) };
+        out.push_str(first);
+        if second != first {
+            out.push_str(second);
+        }
+        if g < b.len() && ec.kept[g] && ee.kept[g] {
+            out.push(b[g]);
+        }
+    }
+    out
+}
+
+/// Where position `pos` of `a` (a character index, a caret) is in `b`: after the last character before it that both
+/// have.
+pub fn map_pos(a: &str, b: &str, pos: usize) -> usize {
+    let (a, b): (Vec<char>, Vec<char>) = (a.chars().collect(), b.chars().collect());
+    let m = matches(&a, &b, |x, y| x == y);
+    m.iter().take(pos.min(a.len())).rev().find_map(|j| j.map(|j| j + 1)).unwrap_or(0).min(b.len())
+}
+
+/// For each item of `a`, the item of `b` it is paired with in a longest common subsequence (Myers' O(ND) diff after
+/// the common start and end).
+pub fn matches<T>(a: &[T], b: &[T], same: impl Fn(&T, &T) -> bool) -> Vec<Option<usize>> {
+    let mut out = vec![None; a.len()];
+    let pre = a.iter().zip(b).take_while(|(x, y)| same(x, y)).count();
+    let suf = a[pre..].iter().rev().zip(b[pre..].iter().rev()).take_while(|(x, y)| same(x, y)).count();
+    for (i, o) in out.iter_mut().enumerate().take(pre) {
+        *o = Some(i);
+    }
+    for s in 1..=suf {
+        out[a.len() - s] = Some(b.len() - s);
+    }
+    let (a, b) = (&a[pre..a.len() - suf], &b[pre..b.len() - suf]);
+    let (n, m) = (a.len() as isize, b.len() as isize);
+    if n == 0 || m == 0 {
+        return out;
+    }
+    let off = n + m + 1;
+    let mut v = vec![0isize; 2 * off as usize + 1];
+    let mut trace = Vec::new();
+    'search: for d in 0..=n + m {
+        if d > MAX_EDITS {
+            return out;
+        }
+        // The furthest x on diagonals -d-1..=d+1 before this step, for the way back.
+        trace.push(v[(off - d - 1) as usize..=(off + d + 1) as usize].to_vec());
+        for k in (-d..=d).step_by(2) {
+            let at = |k: isize| v[(off + k) as usize];
+            let mut x = if k == -d || (k != d && at(k - 1) < at(k + 1)) { at(k + 1) } else { at(k - 1) + 1 };
+            let mut y = x - k;
+            while x < n && y < m && same(&a[x as usize], &b[y as usize]) {
+                (x, y) = (x + 1, y + 1);
+            }
+            v[(off + k) as usize] = x;
+            if x >= n && y >= m {
+                break 'search;
+            }
+        }
+    }
+    let (mut x, mut y) = (n, m);
+    for (d, t) in trace.iter().enumerate().rev() {
+        let d = d as isize;
+        let at = |k: isize| t[(k + d + 1) as usize];
+        let k = x - y;
+        let prev = if k == -d || (k != d && at(k - 1) < at(k + 1)) { k + 1 } else { k - 1 };
+        let (px, py) = (at(prev), at(prev) - prev);
+        while x > px && y > py {
+            (x, y) = (x - 1, y - 1);
+            out[pre + x as usize] = Some(pre + y as usize);
+        }
+        (x, y) = (px, py);
+    }
+    out
+}
