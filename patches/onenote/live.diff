+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! Live editing in a Playground session, the web entry's side (patches/onenote.yaml): the kept web runner, and the
+//! app eframe runs (the window, then the session's frame hook, crates/ui-egui/src/app/live.rs), offered to the
+//! Playground shell as its adapter. While a session is connected, Ctrl+Z and Ctrl+Y (or Ctrl+Shift+Z) go to the
+//! session, which takes back only this person's edits; the text boxes' own undo would also take back what others
+//! typed into the same block.
+
+use crate::web::{Web, repaint};
+use eframe::egui;
+use notecraft_ui_egui::NoteCraftApp;
+use notecraft_ui_egui::app::live;
+use std::cell::OnceCell;
+
+thread_local! {
+    static RUNNER: OnceCell<eframe::WebRunner> = const { OnceCell::new() };
+}
+
+/// The page's web runner, kept for the adapter.
+pub fn runner() -> eframe::WebRunner {
+    RUNNER.with(|kept| kept.get_or_init(eframe::WebRunner::new).clone())
+}
+
+/// The app eframe runs: the page's window, then the session's frame.
+pub fn wrap(web: Web) -> Box<dyn eframe::App> {
+    let with_app = |f: &mut dyn FnMut(&mut NoteCraftApp)| runner().app_mut::<Shell>().map(|mut s| f(&mut s.0.app)).is_some();
+    if let Err(e) = live::attach(with_app, repaint) {
+        web_sys::console::warn_1(&format!("notecraft: no live editing: {e:?}").into());
+    }
+    Box::new(Shell(web))
+}
+
+struct Shell(Web);
+
+impl eframe::App for Shell {
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        if live::connected() {
+            raw_input.events.retain(|e| match e {
+                egui::Event::Key { key: key @ (egui::Key::Z | egui::Key::Y), pressed, modifiers, .. } if modifiers.command && !modifiers.alt => {
+                    if *pressed {
+                        live::undo(*key == egui::Key::Y || modifiers.shift);
+                    }
+                    false
+                }
+                _ => true,
+            });
+        }
+        self.0.raw_input_hook(ctx, raw_input);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.0.ui(ui, frame);
+        live::frame(&mut self.0.app, ui.ctx());
+    }
+
+    /// The shell itself: the adapter reaches the window through it.
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
