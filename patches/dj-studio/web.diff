index 0000000..0670545
--- /dev/null
+++ b/src/app/web.rs
@@ -0,0 +1,323 @@
+// SPDX-License-Identifier: MIT
+//! MixStudio in the browser, for Playground (patches/dj-studio.yaml in github.com/daijro/openplayground): the desktop
+//! window on the page's canvas, its files in Playground's Files, and the browser's audio.
+//!
+//! `app::run` starts [`Web`] on the canvas: the desktop's App, made as on the desktop with the demo mix (`mixstudio
+//! --demo`), and the page's side after each frame. Files live in memory (src/playground.rs): a file from Files comes in
+//! at its path (`browser:/Track.mp3` is `/Track.mp3` here), so a mix saved in Files names its tracks by their place in
+//! Files, and opening it brings them in again. The desktop's dialogs (each on a thread of its own, which
+//! sends the app a message with the answer) are Playground's here: the app's dialog functions call the ones below,
+//! which ask after the frame and send the same message. Whatever MixStudio writes outside its own folders (a mix, an
+//! export, a dropped file) goes to Files after the frame. Work it hands to a thread runs once the frame is drawn.
+
+use super::{App, Msg};
+use crate::playground::std::{fs, thread};
+use eframe::egui;
+use std::cell::{Cell, OnceCell, RefCell};
+use std::path::{Path, PathBuf};
+use wasm_bindgen::{closure::Closure, JsCast as _, JsValue};
+
+/// MixStudio's own folders in memory, never copied to Files: the demo's tracks, settings, the analysis cache.
+const OWN: [&str; 2] = ["/tmp", "/home"];
+/// Where the demo's generated tracks go.
+const DEMO: &str = "/tmp/MixStudio demo";
+/// Where dropped files are kept: in Files (which lists them at its top), so a mix saved there finds them again.
+pub(super) const DROPPED: &str = "/MixStudio/Dropped";
+/// Where a file opened from the computer is kept, in Files too (a folder, so it never replaces a file of its name).
+const OPENED_FROM_COMPUTER: &str = "/MixStudio/Opened";
+/// Where an export to download is written first.
+const DOWNLOADING: &str = "/tmp/MixStudio exports";
+pub(super) const NO_STEMS: &str = "Stem separation isn't available in MixStudio's browser version: it needs ONNX Runtime and a 166 MB model.";
+
+thread_local! {
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+    /// Files from Playground ("Open in MixStudio"), in memory now, for the next frame.
+    static OPENED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    /// Exports to hand to the browser's downloads once they are written.
+    static DOWNLOADS: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    /// Whether queued work has a turn booked.
+    static BOOKED: Cell<bool> = const { Cell::new(false) };
+}
+
+fn repaint() {
+    CTX.with(|c| c.get().map(egui::Context::request_repaint));
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = Some(get(&js_sys::global(), "playgroundFiles")).filter(JsValue::is_object)?;
+    let f = get(&api, method).dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok().filter(|v| !v.is_null() && !v.is_undefined())
+}
+
+fn options(fields: &[(&str, JsValue)]) -> JsValue {
+    let o = js_sys::Object::new();
+    for (k, v) in fields {
+        let _ = js_sys::Reflect::set(&o, &(*k).into(), v);
+    }
+    o.into()
+}
+
+fn types(exts: &[&str]) -> JsValue {
+    exts.iter().map(|e| JsValue::from(*e)).collect::<js_sys::Array>().into()
+}
+
+fn is_mix(p: &Path) -> bool {
+    p.extension().is_some_and(|e| e.eq_ignore_ascii_case("json"))
+}
+
+/// A file from Playground (`{ path, name, bytes }`) into memory at its path in Files; one from the computer is kept in
+/// Files at `/MixStudio/Opened`.
+fn bring_in(file: &JsValue) -> Option<PathBuf> {
+    let name = get(file, "name").as_string()?;
+    let bytes = js_sys::Uint8Array::new(&get(file, "bytes")).to_vec();
+    match get(file, "path").as_string().and_then(|p| p.strip_prefix("browser:").map(PathBuf::from)) {
+        Some(path) => {
+            fs::put(&path, bytes);
+            Some(path)
+        }
+        None => {
+            let path = Path::new(OPENED_FROM_COMPUTER).join(Path::new(&name).file_name()?);
+            fs::write(&path, bytes).ok()?;
+            Some(path)
+        }
+    }
+}
+
+/// Playground's Open dialog for one of `exts`; the file it gives, in memory.
+async fn pick(exts: &[&str]) -> Option<PathBuf> {
+    let files = wait(call("open", &[options(&[("types", types(exts))])])).await?;
+    bring_in(&js_sys::Array::from(&files).get(0))
+}
+
+/// The tracks a mix names, brought in from Files where they are not in memory yet. Files keeps one flat list (it moves
+/// a file saved in a folder, a dropped one, to the top when its list opens), so a track not at its path is looked for
+/// there under its name.
+// ponytail: by name alone; two tracks of one name from different folders would need Files to remember where each was.
+async fn bring_tracks(mix: &Path) {
+    let Some(mix) = fs::read(mix).ok().and_then(|b| serde_json::from_slice::<crate::model::Mix>(&b).ok()) else { return };
+    let mut paths: Vec<PathBuf> = mix.tracks.into_iter().map(|t| PathBuf::from(t.path)).collect();
+    paths.sort();
+    paths.dedup();
+    for p in paths.into_iter().filter(|p| fs::metadata(p).is_err()) {
+        let flat = p.file_name().map(|name| Path::new("/").join(name));
+        for place in std::iter::once(p.clone()).chain(flat) {
+            if let Some(bytes) = wait(call("read", &[format!("browser:{}", place.display()).into()])).await {
+                fs::put(&p, js_sys::Uint8Array::new(&bytes).to_vec());
+                break;
+            }
+        }
+    }
+}
+
+/// A file Playground hands to MixStudio ("Open in MixStudio", or `?open=` at startup).
+fn opened(file: JsValue) {
+    let Some(path) = bring_in(&file) else { return };
+    wasm_bindgen_futures::spawn_local(async move {
+        if is_mix(&path) {
+            bring_tracks(&path).await;
+        }
+        OPENED.with_borrow_mut(|o| o.push(path));
+        repaint();
+    });
+}
+
+/// The desktop's dialog functions on the web (app.rs and persistence.rs call these instead).
+impl App {
+    /// Add tracks: Playground's Open, for one audio file.
+    pub(super) fn web_pick_files(&self, sample: Option<usize>) {
+        let (tx, id) = (self.tx.clone(), self.persistence.id.clone());
+        wasm_bindgen_futures::spawn_local(async move {
+            if let Some(path) = pick(crate::library::EXTS).await {
+                let _ = tx.send(Msg::Picked(vec![path], sample, id));
+                repaint();
+            }
+        });
+    }
+
+    /// Open mix… (kind 0), Save as… (1) and Export (2).
+    pub(super) fn web_dialog(&self, save: bool, kind: u8) {
+        let (tx, id) = (self.tx.clone(), self.persistence.id.clone());
+        if !save {
+            return wasm_bindgen_futures::spawn_local(async move {
+                if let Some(path) = pick(&["json"]).await {
+                    bring_tracks(&path).await;
+                    let _ = tx.send(Msg::Opened(path));
+                    repaint();
+                }
+            });
+        }
+        // The mix as Save would write it, for "Download to device"; an export is rendered after the choice.
+        let (name, ext, bytes) = if kind == 1 {
+            let bytes = serde_json::to_vec_pretty(&self.mix).unwrap_or_default();
+            (format!("{}.mixstudio.json", self.mix.name), "json", Some(bytes))
+        } else {
+            let ext = crate::export::FORMATS[self.export_fmt as usize].1;
+            (format!("{}.{ext}", self.mix.name), ext, None)
+        };
+        let mut fields = vec![("name", JsValue::from(name.as_str())), ("types", types(&[ext]))];
+        if let Some(bytes) = &bytes {
+            fields.push(("bytes", js_sys::Uint8Array::from(bytes.as_slice()).into()));
+        }
+        let asked = call("saveAs", &[options(&fields)]);
+        wasm_bindgen_futures::spawn_local(async move {
+            let Some(answer) = wait(asked).await else { return };
+            let path = get(&answer, "path").as_string().and_then(|p| p.strip_prefix("browser:").map(PathBuf::from));
+            let _ = match (path, kind) {
+                (Some(path), 1) => tx.send(Msg::SaveTo(path, id)),
+                (Some(path), _) => tx.send(Msg::ExportTo(path, id)),
+                // Downloaded: the mix went with the answer; an export is downloaded once it is written.
+                (None, 1) => return,
+                (None, _) => {
+                    let path = Path::new(DOWNLOADING).join(&name);
+                    DOWNLOADS.with_borrow_mut(|d| d.push(path.clone()));
+                    tx.send(Msg::ExportTo(path, id))
+                }
+            };
+            repaint();
+        });
+    }
+
+    /// Add music folder: a page has no folders of music to watch.
+    pub(super) fn web_pick_folder(&self) {
+        let _ = self.tx.send(Msg::Status("Music folders aren't available in the browser: add tracks from Files, or drop audio files on the window.".into()));
+    }
+
+    /// Import DJ library: Playground's Open, for a Rekordbox/iTunes XML, Traktor NML, Serato crate or Engine database.
+    pub(super) fn web_pick_import(&self) {
+        let tx = self.tx.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            if let Some(path) = pick(&["xml", "nml", "crate", "db"]).await {
+                let _ = tx.send(Msg::ImportPick(path));
+                repaint();
+            }
+        });
+    }
+
+    /// Locate a missing source: Playground's Open, then the file read as the desktop's dialog thread does it.
+    pub(super) fn web_choose_relink(&mut self, old: String) {
+        if self.persistence.relink_busy {
+            return;
+        }
+        self.persistence.relink_busy = true;
+        self.persistence.candidate = None;
+        let (tx, id) = (self.tx.clone(), self.persistence.id.clone());
+        wasm_bindgen_futures::spawn_local(async move {
+            let picked = pick(crate::library::EXTS).await;
+            thread::spawn(move || {
+                let result = match picked {
+                    None => Ok(None),
+                    Some(path) => crate::analysis::load(&path).map(|(a, n)| Some((path, a, n))).map_err(|e| e.to_string()),
+                };
+                let _ = tx.send(Msg::RelinkReady(id, old, result));
+            });
+            repaint();
+        });
+    }
+}
+
+/// The page's app: the window, then what it asked of the page.
+struct Web {
+    app: App,
+    unsaved: Option<bool>,
+}
+
+impl Web {
+    /// After the window's frame: the audio's commands, files that came in, what MixStudio wrote, its unsaved state,
+    /// and a turn for the work it queued.
+    fn after(&mut self, ctx: &egui::Context) {
+        crate::audio::web::pump();
+        for path in OPENED.take() {
+            if is_mix(&path) {
+                self.app.open(path);
+            } else if crate::library::is_audio(&path) {
+                self.app.load_files(vec![path], None);
+            }
+        }
+        let downloads = DOWNLOADS.take();
+        for p in fs::changes().into_iter().filter(|p| !OWN.iter().any(|own| p.starts_with(own))) {
+            let target = JsValue::from(format!("browser:{}", p.display()));
+            match fs::metadata(&p) {
+                Ok(m) if m.is_file() => {
+                    call("write", &[target, js_sys::Uint8Array::from(fs::read(&p).unwrap_or_default().as_slice()).into()]);
+                }
+                Ok(_) => {}
+                Err(_) => {
+                    call("remove", &[target]);
+                }
+            }
+        }
+        let waiting = downloads.into_iter().filter(|p| match fs::read(p) {
+            Ok(bytes) => {
+                let name = p.file_name().unwrap_or_default().to_string_lossy().into_owned();
+                call("download", &[name.into(), js_sys::Uint8Array::from(bytes.as_slice()).into()]);
+                let _ = fs::remove_file(p);
+                false
+            }
+            Err(_) => true,
+        });
+        DOWNLOADS.with_borrow_mut(|d| d.extend(waiting));
+        // ponytail: the mix compared each frame something happened; a change counter if long mixes stutter.
+        if ctx.input(|i| !i.events.is_empty()) || self.unsaved.is_none() {
+            let unsaved = serde_json::to_string(&self.app.mix).ok().as_deref() != Some(self.app.persistence.saved_body());
+            if self.unsaved.replace(unsaved) != Some(unsaved) {
+                call("setUnsaved", &[unsaved.into()]);
+            }
+        }
+        if thread::queued() && !BOOKED.replace(true) {
+            // After this frame is on screen: analysis and exports hold the page while they run.
+            let turn = Closure::once_into_js(|| {
+                BOOKED.set(false);
+                thread::run_spawned();
+                repaint();
+            });
+            if let Some(window) = web_sys::window() {
+                let _ = window.set_timeout_with_callback(turn.unchecked_ref());
+            }
+        }
+    }
+}
+
+impl eframe::App for Web {
+    fn update(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        eframe::App::update(&mut self.app, ctx, frame);
+        self.after(ctx);
+    }
+}
+
+/// `app::run` on the web: the app on the page's canvas, with the demo mix unless asked for another folder.
+pub(super) fn start(demo: Option<String>) {
+    let demo = demo.or_else(|| Some(DEMO.into()));
+    wasm_bindgen_futures::spawn_local(async move {
+        let document = web_sys::window().and_then(|w| w.document()).expect("no document");
+        let canvas = document
+            .get_element_by_id("mixstudio_canvas")
+            .and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok())
+            .expect("no #mixstudio_canvas");
+        let creator = move |cc: &eframe::CreationContext<'_>| {
+            CTX.with(|c| c.set(cc.egui_ctx.clone()).ok());
+            let mut app = App::new(cc, demo);
+            // The demo is where every page starts, not unsaved work.
+            let mix = app.mix.clone();
+            app.persistence.saved(&mix);
+            call("onOpen", &[Closure::<dyn Fn(JsValue)>::new(opened).into_js_value()]);
+            Ok(Box::new(Web { app, unsaved: None }) as Box<dyn eframe::App>)
+        };
+        let started = eframe::WebRunner::new().start(canvas, eframe::WebOptions::default(), Box::new(creator)).await;
+        if let Some(loading) = document.get_element_by_id("mixstudio_loading") {
+            match started {
+                Ok(()) => loading.remove(),
+                Err(e) => loading.set_text_content(Some(&format!("MixStudio could not start: {e:?}"))),
+            }
+        }
+    });
+}
diff --git a/src/audio/web.rs b/src/audio/web.rs
new file mode 100644
index 0000000..75a9209
--- /dev/null
+++ b/src/audio/web.rs
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: MIT
+//! The browser's audio, for Playground (patches/dj-studio.yaml in github.com/daijro/openplayground): a page cannot
+//! start the audio worker thread, so its loop runs in turns instead ([`pump`]): at the start of each Web Audio
+//! callback (cpal's webaudio host calls the device reader on the page's one thread), and after each frame, so commands
+//! never pile up while the browser keeps the audio off (until the first click). Same work as the thread's loop: the
+//! commands handled, then blocks rendered ahead into every free slot, without its waiting.
+
+use super::{AudioBlock, WorkerGuard, WorkerState};
+use crate::engine::Cmd;
+use crossbeam_channel::{Receiver, Sender};
+use std::cell::RefCell;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+
+struct Pump {
+    worker: WorkerState,
+    commands: Receiver<Cmd>,
+    stale: Receiver<Box<AudioBlock>>,
+    recycle: Sender<Box<AudioBlock>>,
+    free: Receiver<Box<AudioBlock>>,
+    ready: Sender<Box<AudioBlock>>,
+    stop: Arc<AtomicBool>,
+}
+
+thread_local! {
+    static PUMP: RefCell<Option<Pump>> = const { RefCell::new(None) };
+}
+
+/// [`WorkerGuard::start`] on the web: the worker's state and queues are kept for [`pump`] instead of a thread.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn start(
+    guard: WorkerGuard,
+    worker: WorkerState,
+    commands: Receiver<Cmd>,
+    stale: Receiver<Box<AudioBlock>>,
+    recycle: Sender<Box<AudioBlock>>,
+    free: Receiver<Box<AudioBlock>>,
+    ready: Sender<Box<AudioBlock>>,
+    stop: Arc<AtomicBool>,
+) -> WorkerGuard {
+    PUMP.set(Some(Pump { worker, commands, stale, recycle, free, ready, stop }));
+    guard
+}
+
+/// One turn of the worker's loop.
+pub(crate) fn pump() {
+    PUMP.with_borrow_mut(|slot| {
+        let Some(p) = slot else { return };
+        if p.stop.load(Ordering::Acquire) {
+            *slot = None;
+            return;
+        }
+        while let Ok(command) = p.commands.try_recv() {
+            let previous = p.worker.epoch;
+            p.worker.handle(command);
+            if p.worker.epoch != previous {
+                while let Ok(block) = p.stale.try_recv() {
+                    let _ = p.recycle.try_send(block);
+                }
+            }
+        }
+        while p.worker.playing {
+            let Ok(mut block) = p.free.try_recv() else { break };
+            p.worker.render(&mut block);
+            // Room for every block there is, so this never waits.
+            if p.ready.try_send(block).is_err() {
+                break;
+            }
+        }
+    });
+}
