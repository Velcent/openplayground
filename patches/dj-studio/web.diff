+++ b/src/playground.rs
@@ -0,0 +1,646 @@
+// SPDX-License-Identifier: MIT
+//! MixStudio in the browser, for Playground (patches/dj-studio.yaml in github.com/daijro/openplayground).
+//!
+//! wasm32-unknown-unknown has no clock, no files, no threads and no process: `Instant::now` and `SystemTime::now`
+//! panic there, every file call fails, and so does `thread::spawn`. The modules that use them take `std` from here
+//! instead, through one `#[cfg(target_arch = "wasm32")] use crate::playground::std;` line at each one's end (a local
+//! `std` shadows the standard library's name in that module; everything else in it still comes from the real std):
+//!   time     web-time's clock (its Instant a day on, so the app can step a few seconds back from `now`);
+//!   fs       an in-memory file system (the demo's tracks, audio from Files or dropped, mixes, settings, the analysis
+//!            cache), each change noted for the page to mirror into Files (app/web.rs);
+//!   thread   `spawn` (and `Builder::spawn`) queue the work for the page to run once the frame is drawn, on this thread;
+//!   env      `HOME` is `/home` (settings and caches live in memory, so every page starts afresh); nothing else is set;
+//!   process  `id` is 1.
+//! Below them: what Signalsmith Stretch's C++ (Key lock) asks of a C++ runtime, which this target has none of.
+
+// Not every part of std's API that is here gets used.
+#![allow(dead_code)]
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod time {
+        pub use web_time::*;
+        use ::std::ops::{Add, AddAssign, Sub, SubAssign};
+
+        /// web-time's Instant, a day on from the page's start: the app sets clocks a few seconds in the past
+        /// (`Instant::now() - 15 s`), which web-time's clock, 0 when the page opened, cannot go below.
+        #[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+        pub struct Instant(web_time::Instant);
+
+        impl Instant {
+            pub fn now() -> Self {
+                Self(web_time::Instant::now() + Duration::from_secs(86_400))
+            }
+            pub fn elapsed(&self) -> Duration {
+                Self::now().saturating_duration_since(*self)
+            }
+            pub fn duration_since(&self, earlier: Self) -> Duration {
+                self.0.duration_since(earlier.0)
+            }
+            pub fn saturating_duration_since(&self, earlier: Self) -> Duration {
+                self.0.saturating_duration_since(earlier.0)
+            }
+            pub fn checked_duration_since(&self, earlier: Self) -> Option<Duration> {
+                self.0.checked_duration_since(earlier.0)
+            }
+            pub fn checked_add(&self, d: Duration) -> Option<Self> {
+                self.0.checked_add(d).map(Self)
+            }
+            pub fn checked_sub(&self, d: Duration) -> Option<Self> {
+                self.0.checked_sub(d).map(Self)
+            }
+        }
+        impl Add<Duration> for Instant {
+            type Output = Self;
+            fn add(self, d: Duration) -> Self {
+                Self(self.0 + d)
+            }
+        }
+        impl Sub<Duration> for Instant {
+            type Output = Self;
+            fn sub(self, d: Duration) -> Self {
+                Self(self.0 - d)
+            }
+        }
+        impl Sub for Instant {
+            type Output = Duration;
+            fn sub(self, earlier: Self) -> Duration {
+                self.saturating_duration_since(earlier)
+            }
+        }
+        impl AddAssign<Duration> for Instant {
+            fn add_assign(&mut self, d: Duration) {
+                self.0 += d;
+            }
+        }
+        impl SubAssign<Duration> for Instant {
+            fn sub_assign(&mut self, d: Duration) {
+                self.0 -= d;
+            }
+        }
+    }
