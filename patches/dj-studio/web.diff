+    #[no_mangle]
+    extern "C" fn _ZNSt3__213random_deviceC2ERKNS_12basic_stringIcNS_11char_traitsIcEENS_9allocatorIcEEEE(
+        this: *mut u8,
+        _token: *const u8,
