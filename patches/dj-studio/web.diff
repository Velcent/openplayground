+    #[no_mangle]
+    extern "C" fn _Znwm(size: usize) -> *mut u8 {
+        let p = unsafe { alloc(layout(size)) };
+        if p.is_null() {
+            handle_alloc_error(layout(size));
+        }
+        p
+    }
+
