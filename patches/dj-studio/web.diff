+/// .cargo/playground-cxx.sh) asks of a C++ runtime: operator new and sized delete over Rust's allocator,
+/// `std::random_device` (it only seeds the stretcher's phase randomisation) and libc++'s abort message. Its maths
+/// (sinf, cosf, exp, exp2, roundf) come from Rust's compiler-builtins.
+mod cxx {
+    use ::std::alloc::{alloc, dealloc, handle_alloc_error, Layout};
+    use ::std::ffi::{c_char, CStr};
