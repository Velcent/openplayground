+    #[no_mangle]
+    unsafe extern "C" fn _ZNSt3__222__libcpp_verbose_abortEPKcz(message: *const c_char, _args: *const u8) -> ! {
+        panic!("Signalsmith Stretch: {}", CStr::from_ptr(message).to_string_lossy())
+    }
+
