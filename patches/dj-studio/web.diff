+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
+  <title>MixStudio</title>
+  <!-- MixStudio in the browser, for Playground (patches/dj-studio.yaml in github.com/daijro/openplayground). -->
+  <link data-trunk rel="rust" href="Cargo.toml" data-bin="mixstudio" data-wasm-opt="0" />
+  <style>
+    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #1a1b1f; }
+    #mixstudio_canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
+    #mixstudio_loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
+      color: #dcdee2; font: 14px system-ui, sans-serif; pointer-events: none; }
+  </style>
+  <script>
+    // Browsers keep a page's audio off until the person clicks or types: the mix's AudioContext starts then.
+    {
+      const contexts = []
+      if (window.AudioContext) window.AudioContext = class extends window.AudioContext {
+        constructor(...args) { super(...args); contexts.push(this) }
+      }
+      const resume = () => contexts.forEach((c) => c.state === 'suspended' && c.resume().catch(() => {}))
+      for (const type of ['pointerdown', 'keydown', 'touchend']) addEventListener(type, resume, { capture: true })
+    }
+  </script>
+</head>
+<body>
+  <canvas id="mixstudio_canvas"></canvas>
+  <div id="mixstudio_loading">Loading MixStudio&hellip;</div>
+</body>
+</html>
diff --git a/src/app/web.rs b/src/app/web.rs
