+# Playground's browser build of MixStudio (patches/dj-studio.yaml in github.com/daijro/openplayground): Key lock's C++
+# (the signalsmith-stretch crate) for wasm32-unknown-unknown. Native builds read none of this (every name ends in the
+# wasm target).
+[env]
+# clang with wasi-sdk's C++ headers (playground-cxx.sh).
+CXX_wasm32_unknown_unknown = { value = ".cargo/playground-cxx.sh", relative = true }
+# No C++ library to link: src/playground.rs has the few pieces it uses.
+CXXSTDLIB_wasm32_unknown_unknown = ""
+# clang hides a wasm32 header's functions by default, and bindgen leaves hidden ones out.
+BINDGEN_EXTRA_CLANG_ARGS_wasm32_unknown_unknown = "-fvisibility=default"
