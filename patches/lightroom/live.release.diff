+            let mut shared = session.catalog.clone();
+            let mut d = (*session.develop_of(id).unwrap()).clone();
+            d.light.exposure = 0.5;
+            shared.apply(lightcraft_catalog::Op::SetDevelop { id, settings: Arc::new(d), label: "Exposure".into(), edited: None }).unwrap();
+            shared
+        };
+        let active = session.active().unwrap();
+        let other = session.visible().iter().copied().find(|id| *id != active).unwrap();
+        session.adopt_catalog(exposure(&session, other));
+        assert!(state.is_current(&session), "another photo's change leaves the preset's step alone");
+        session.adopt_catalog(exposure(&session, active));
+        assert!(!state.is_current(&session), "undoing the preset now would drop someone else's change");
