+//! Playground live editing (`playground_live`): the shared document is the library's catalog as JSON (every photo's
+//! develop settings, History, Versions, rating, flag, label and metadata; albums, stacks, the keyword list), without
+//! this browser's own browsing records (when it browsed Local folders and the photos seen there) and without views
+//! (selection, filter, sort, panels live outside the catalog). The originals of imported photos travel as session files
+//! named by their content hash, and land in this browser's storage as if imported here. Native undo history stays
+//! local; while connected Undo and Redo go to the session. Each person sees the others' selections outlined in the grid
+//! and filmstrip, and their pointers over a photo both have open, in their color with their name.
+
+#![cfg_attr(test, allow(dead_code))]
+
+// The template, copied next to this file (tools.yaml `live:`).
+#[allow(dead_code)]
+#[path = "playground_live.rs"]
+mod playground_live;
+
+use crate::store::{self, Originals};
+use lightcraft_engine::Session;
+use lightcraft_engine::catalog::{Catalog, PhotoId, Source, playground as hooks};
+use playground_live::{Live, Presence};
+use lightcraft_ui_egui::LightcraftApp;
+use lightcraft_ui_egui::state::ViewMode;
+use serde::Deserialize as _;
+use serde_json::Value;
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, BTreeSet, HashSet};
+
+pub const FORMAT: &str = concat!("lightroom:1:", env!("CARGO_PKG_VERSION"));
+
+thread_local! {
+    static POINTER_DOWN: Cell<bool> = const { Cell::new(false) };
+    /// This browser's originals: the ones in memory, and the hashes known to be in its storage (never removed).
+    static MEDIA: RefCell<(Originals, HashSet<String>)> = RefCell::default();
+    /// An original arrived from the session since the last frame.
+    static ARRIVED: Cell<bool> = const { Cell::new(false) };
+    /// Where this person points on the photo open in the loupe, as fractions of its frame.
+    static POINTER: Cell<Option<[f64; 2]>> = const { Cell::new(None) };
+    /// The others in the session, as the shell last gave them.
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+}
+
+/// The photo this person has open in the loupe (Detail view).
+fn open_photo(app: &LightcraftApp) -> Option<PhotoId> {
+    (app.ui.view == ViewMode::Detail).then_some(app.session.selection.active).flatten()
+}
+
+/// The end of a frame in the browser: notes where this person points on the open photo, draws the others' selections
+/// and pointers over the app, then [`frame`].
+#[cfg(target_arch = "wasm32")]
+pub fn end_frame(app: &mut LightcraftApp, ctx: &egui::Context) {
+    let (down, at) = ctx.input(|i| (i.pointer.any_down(), i.pointer.hover_pos()));
+    let over = |r: egui::Rect| at.filter(|p| r.contains(*p) && app.canvas_rect.is_some_and(|c| c.contains(*p)));
+    let fraction = |p: egui::Pos2, r: egui::Rect| [(p.x - r.left()) / r.width(), (p.y - r.top()) / r.height()].map(|f| (f as f64 * 1e4).round() / 1e4);
+    POINTER.set(open_photo(app).and(app.image_rect).and_then(|r| Some(fraction(over(r)?, r))));
+    OTHERS.with_borrow(|others| show_others(app, ctx, others));
+    frame(app, down);
+}
+
+/// Each other person's selection outlined (grid cells, filmstrip) and pointer (on the photo this person has open too),
+/// in their color with their name. Their states come from other people: what does not resolve is skipped.
+#[cfg(target_arch = "wasm32")]
+fn show_others(app: &LightcraftApp, ctx: &egui::Context, others: &[Presence]) {
+    use egui::{Color32, FontId, Painter, Pos2, Rect, Shape, Stroke, StrokeKind, vec2};
+    fn tag(p: &Painter, at: Pos2, name: &str, color: Color32) {
+        let text = p.layout_no_wrap(name.to_owned(), FontId::proportional(11.0), Color32::WHITE);
+        let r = Rect::from_min_size(at, text.size() + vec2(8.0, 4.0));
+        p.rect_filled(r, 3.0, color);
+        p.galley(r.min + vec2(4.0, 2.0), text, Color32::WHITE);
+    }
+    let painter = ctx.layer_painter(egui::LayerId::background());
+    let area = |key: &str| app.widgets.iter().find(|(k, _)| k == key).map(|(_, r)| *r);
+    let (grid, strip) = (area("grid:scroll"), area("filmstrip"));
+    for (i, who) in others.iter().enumerate() {
+        let color = Color32::from_rgb(who.color[0], who.color[1], who.color[2]);
+        let selected: HashSet<u64> = who.state["selection"].as_array().into_iter().flatten().filter_map(Value::as_u64).collect();
+        for (key, r) in &app.widgets {
+            let clip = match key.split_once(':') {
+                Some(("thumb", id)) if id.parse().is_ok_and(|id| selected.contains(&id)) => grid,
+                Some(("film", id)) if id.parse().is_ok_and(|id| selected.contains(&id)) => strip,
+                _ => continue,
+            };
+            let Some(clip) = clip else { continue };
+            let p = painter.with_clip_rect(clip.intersect(*r));
+            // one inside the other when several people select the same photo
+            let inner = r.shrink(1.0 + 3.0 * i as f32);
+            p.rect_stroke(inner, 0.0, Stroke::new(2.0, color), StrokeKind::Inside);
+            tag(&p, inner.min + vec2(3.0, 3.0), &who.name, color);
+        }
+        let pointer = who.state["pointer"].as_array().map(|xy| xy.iter().filter_map(Value::as_f64).collect::<Vec<_>>());
+        if let (Some(photo), Some(image), Some(canvas), Some(&[x, y])) = (open_photo(app), app.image_rect, app.canvas_rect, pointer.as_deref())
+            && who.state["page"].as_u64() == Some(photo.0)
+            && (0.0..=1.0).contains(&x)
+            && (0.0..=1.0).contains(&y)
+        {
+            let at = image.min + vec2(x as f32 * image.width(), y as f32 * image.height());
+            let p = painter.with_clip_rect(canvas);
+            p.add(Shape::convex_polygon(vec![at, at + vec2(0.0, 16.0), at + vec2(11.0, 11.0)], color, Stroke::new(1.0, Color32::WHITE)));
+            tag(&p, at + vec2(10.0, 14.0), &who.name, color);
+        }
+    }
+}
+
+/// The end of a frame.
+pub fn frame(app: &mut LightcraftApp, pointer_down: bool) {
+    POINTER_DOWN.set(pointer_down);
+    if ARRIVED.take() {
+        // failed renders are retried once the catalog changes (as after a relink); the document itself stays as it is
+        app.session.catalog.revision = app.session.catalog.revision.wrapping_add(1);
+    }
+    playground_live::frame(app);
+}
+
+/// Offers live editing to the Playground shell (nothing happens until it connects).
+#[cfg(target_arch = "wasm32")]
+pub async fn attach(
+    with_app: impl Fn(&mut dyn FnMut(&mut LightcraftApp)) -> bool + 'static,
+    repaint: impl Fn() + 'static,
+    (originals, backend): (Originals, Option<crate::backend::Backend>),
+) {
+    let stored = match &backend {
+        Some(b) => b.list("originals").await.unwrap_or_else(|e| {
+            log::warn!("listing the stored originals: {e}");
+            Vec::new()
+        }),
+        None => Vec::new(),
+    };
+    MEDIA.set((originals.clone(), stored.into_iter().collect()));
+    let _ = hooks::FRESH_ID.set(playground_live::fresh_id);
+    let _ = hooks::UNDO.set(playground_live::undo);
+    let _ = hooks::LIVE.set(playground_live::connected);
+    if session_library().is_some() {
+        // a restore would point this browser's own library at the backup
+        with_app(&mut |app| app.services.restore_library = None);
+    }
+    if let Err(e) = playground_live::web::attach::<LightcraftApp>(FORMAT, with_app, repaint).and_then(|()| media(originals, backend)) {
+        log::error!("live editing unavailable: {e:?}");
+    }
+}
+
+/// The bytes of original `id`, refused unless they are the file the hash names.
+#[cfg(target_arch = "wasm32")]
+fn checked<'a>(id: &str, bytes: Option<&'a [u8]>) -> Result<&'a [u8], wasm_bindgen::JsValue> {
+    bytes.filter(|b| store::content_hash(b) == id).ok_or_else(|| format!("Missing media: the original {id}").into())
+}
+
+/// Originals live in asynchronous browser storage: the adapter's `readAsset` and `writeAsset` return promises. One that
+/// arrives is stored and kept in memory as the import does, without touching the catalog or the undo history.
+#[cfg(target_arch = "wasm32")]
+fn media(originals: Originals, backend: Option<crate::backend::Backend>) -> Result<(), wasm_bindgen::JsValue> {
+    use js_sys::{Reflect, Uint8Array};
+    use wasm_bindgen::prelude::*;
+    use wasm_bindgen_futures::future_to_promise;
+    let adapter = Reflect::get(&js_sys::global(), &"playgroundLiveAdapter".into())?;
+    let (o, b) = (originals.clone(), backend.clone());
+    let read = move |id: String| {
+        let (originals, backend) = (o.clone(), b.clone());
+        future_to_promise(async move {
+            let path = store::original_path(&id, "original");
+            if let Some(bytes) = originals.contains(&path).then(|| originals.get(&path)).flatten() {
+                return checked(&id, Some(&bytes)).map(|b| Uint8Array::from(b).into());
+            }
+            let bytes = match &backend {
+                Some(b) => b.read(&store::storage_key(&id)).await?,
+                None => None,
+            };
+            checked(&id, bytes.as_deref()).map(|b| Uint8Array::from(b).into())
+        })
+    };
+    Reflect::set(&adapter, &"readAsset".into(), &Closure::<dyn Fn(String) -> js_sys::Promise>::new(read).into_js_value())?;
+    let write = move |id: String, _name: String, bytes: Uint8Array| {
+        let (originals, backend) = (originals.clone(), backend.clone());
+        future_to_promise(async move {
+            let bytes = bytes.to_vec();
+            checked(&id, Some(&bytes))?;
+            if let Some(b) = &backend {
+                b.write(&store::storage_key(&id), &bytes).await?;
+            }
+            originals.insert(&id, bytes.into());
+            MEDIA.with_borrow_mut(|(_, stored)| stored.insert(id));
+            ARRIVED.set(true);
+            crate::web::request_repaint();
+            Ok(JsValue::UNDEFINED)
+        })
+    };
+    let write = Closure::<dyn Fn(String, String, Uint8Array) -> js_sys::Promise>::new(write);
+    Reflect::set(&adapter, &"writeAsset".into(), &write.into_js_value())?;
+    Ok(())
+}
+
+/// Installs a catalog with other people's changes in it. No undo step; the selection keeps the photos still there, and
+/// the library saves it whole (no op says what changed).
+fn adopt(session: &mut Session, mut catalog: Catalog) {
+    for p in session.catalog.photos() {
+        if catalog.photo(p.id).is_none_or(|n| (&n.source, &n.content_hash) != (&p.source, &p.content_hash)) {
+            session.media.forget(p.id);
+        }
+    }
+    // caches keyed on the revision see a new one, with nothing remembered of how it got there (the grid works its
+    // photos out again)
+    catalog.revision = session.catalog.revision.wrapping_add(1);
+    session.catalog = catalog;
+    let there = |id: &PhotoId| session.catalog.photo(*id).is_some();
+    session.selection.ids.retain(there);
+    session.selection.active = session.selection.active.filter(there).or_else(|| session.selection.ids.first().copied());
+    // ponytail: a whole snapshot per remote change, O(library); journal the photos that changed if big libraries lag
+    session.compact_soon();
+}
+
+/// The library folder of a Playground session (`?pg-session=<room id>`, a lowercase UUID): its own, so joining a session
+/// never touches this browser's library. `None` for anything else.
+fn session_library_dir(room: &str) -> Option<String> {
+    let uuid = room.len() == 36
+        && room.char_indices().all(|(i, c)| if matches!(i, 8 | 13 | 18 | 23) { c == '-' } else { matches!(c, '0'..='9' | 'a'..='f') });
+    uuid.then(|| format!("library-session-{room}"))
+}
+
+/// This page's session library folder, when it was opened from a Playground invitation.
+#[cfg(target_arch = "wasm32")]
+pub fn session_library() -> Option<String> {
+    let query = web_sys::window()?.location().search().ok()?;
+    let room = query.trim_start_matches('?').split('&').find_map(|p| p.strip_prefix("pg-session="))?;
+    session_library_dir(room)
+}
+
+/// A photo record only this browser has: seen while browsing a Local folder, not in the library.
+fn own(photo: &Value) -> bool {
+    photo.get("local") == Some(&Value::Bool(true))
+}
+
+/// The catalog a shared document holds, refusing one that does not hold together (concurrent stacks sharing a photo,
+/// folders moved into each other): every peer would repair it, each proposing the same fix.
+fn catalog(document: &Value) -> Result<Catalog, String> {
+    let catalog = Catalog::deserialize(document).map_err(|e| format!("Conflict: {e}"))?;
+    match catalog.clone().repair().first() {
+        Some(problem) => Err(format!("Conflict: {problem}")),
+        None => Ok(catalog),
+    }
+}
+
+impl Live for LightcraftApp {
+    const COUNTERS: &'static [&'static str] = &["next_photo", "next_album", "next_stack"];
+
+    fn live_document(&self) -> Value {
+        let mut doc = serde_json::to_value(&self.session.catalog).unwrap_or(Value::Null);
+        if let Some(c) = doc.as_object_mut() {
+            c.remove("browsed");
+            if let Some(photos) = c.get_mut("photos").and_then(Value::as_object_mut) {
+                photos.retain(|_, p| !own(p));
+            }
+        }
+        doc
+    }
+
+    fn live_adopt(&mut self, mut document: Value) -> Result<(), String> {
+        let mine = serde_json::to_value(&self.session.catalog).map_err(|e| e.to_string())?;
+        if let (Some(doc), Some(mine)) = (document.as_object_mut(), mine.as_object()) {
+            if let Some(browsed) = mine.get("browsed") {
+                doc.insert("browsed".into(), browsed.clone());
+            }
+            if let (Some(photos), Some(old)) = (doc.get_mut("photos").and_then(Value::as_object_mut), mine.get("photos").and_then(Value::as_object)) {
+                for (id, p) in old.iter().filter(|(_, p)| own(p)) {
+                    photos.entry(id.clone()).or_insert_with(|| p.clone());
+                }
+            }
+        }
+        adopt(&mut self.session, catalog(&document)?);
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        !POINTER_DOWN.get()
+            && !self.text_focus
+            && self.session.interaction.is_none()
+            && self.gesture.is_none()
+            && self.brush_live.is_none()
+            && self.import.is_none()
+            && self.ui.name_edit.is_none()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.session.catalog.revision)
+    }
+
+    fn live_disconnected(&mut self) {
+        self.session.undo.clear();
+        self.session.redo.clear();
+    }
+
+    fn live_check(document: &Value) -> Result<(), String> {
+        catalog(document).map(drop)
+    }
+
+    /// The originals the shared photos were imported from, by content hash (demo photos have none).
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        MEDIA.with_borrow(|(originals, stored)| {
+            let files: BTreeMap<_, _> = (self.session.catalog.photos().filter(|p| !p.local))
+                .filter_map(|p| match &p.source {
+                    Source::File { path } => {
+                        let hash = store::hash_of_path(path)?;
+                        Some((hash.to_string(), (p.file_name.clone(), stored.contains(hash) || originals.contains(path))))
+                    }
+                    _ => None,
+                })
+                .collect();
+            files.into_iter().map(|(hash, (name, have))| (hash, name, have)).collect()
+        })
+    }
+
+    /// `{ page: "library" | the photo open in the loupe, pointer: [x, y] on it (fractions of its frame), selection: the
+    /// first 50 selected photos }`.
+    fn live_presence(&self) -> Value {
+        let catalog = &self.session.catalog;
+        let shared = self.session.selection.ids.iter().filter(|id| catalog.photo(**id).is_some_and(|p| !p.local));
+        let mut state = serde_json::json!({"page": "library", "selection": shared.take(50).map(|id| id.0).collect::<Vec<_>>()});
+        if let Some(photo) = open_photo(self) {
+            state["page"] = photo.0.into();
+            if let Some(at) = POINTER.get() {
+                state["pointer"] = serde_json::json!(at);
+            }
+        }
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        let photos = document.get("photos").and_then(Value::as_object).into_iter().flat_map(|p| p.values());
+        let ids: BTreeSet<_> = photos.filter(|p| !own(p)).filter_map(|p| store::hash_of_path(p.get("source")?.get("path")?.as_str()?)).collect();
+        ids.into_iter().map(str::to_string).collect()
+    }
+}
