+    #[test]
+    fn presence_is_the_open_photo_the_pointer_on_it_and_the_shared_selection() -> Result<(), String> {
+        let mut a = demo();
+        let ids: Vec<u64> = a.session.catalog.photos().map(|p| p.id.0).take(2).collect();
+        // a Local folder's photo is this person's own: the others are not shown it
+        let mut seen = Photo::new(a.session.catalog.alloc_photo_id(), Source::Demo { scene: 1 }, "seen.jpg", "JPEG", 9, 9, "2026-01-01T00:00:00");
+        seen.local = true;
+        a.session.catalog.apply(Op::AddPhoto { photo: Box::new(seen.clone()) }).map_err(|e| e.to_string())?;
+        a.run("library.select", json!({"ids": [ids[0], ids[1], seen.id.0]}))?;
+        POINTER.set(Some([0.25, 0.5]));
+        a.ui.view = ViewMode::PhotoGrid;
+        assert_eq!(a.live_presence(), json!({"page": "library", "selection": ids}), "no pointer outside the loupe");
+        a.ui.view = ViewMode::Detail;
+        let open = a.session.selection.active.ok_or("no active photo")?;
+        assert_eq!(a.live_presence(), json!({"page": open.0, "pointer": [0.25, 0.5], "selection": ids}));
+        Ok(())
+    }
+
+    #[test]
+    fn lists_the_shared_photos_originals_once_by_content_hash() -> Result<(), String> {
+        let mut a = demo();
+        let hash = store::content_hash(b"photo");
+        let mut add = |path: String, local: bool| {
+            let mut p = Photo::new(a.session.catalog.alloc_photo_id(), Source::File { path }, "IMG 1.jpg", "JPEG", 9, 9, "2026-01-01T00:00:00");
+            p.local = local;
+            a.session.catalog.apply(Op::AddPhoto { photo: Box::new(p) }).map(drop).map_err(|e| e.to_string())
+        };
+        // a virtual copy shares its original; a Local folder's photo and a file on disk are not the session's
+        add(store::original_path(&hash, "IMG 1.jpg"), false)?;
+        add(store::original_path(&hash, "IMG 1.jpg"), false)?;
+        add(store::original_path("123", "seen.jpg"), true)?;
+        add("/home/me/x.jpg".into(), false)?;
+        assert_eq!(a.live_assets(), [(hash.clone(), "IMG 1.jpg".to_string(), false)], "demo photos have no original");
+        assert_eq!(LightcraftApp::live_assets_of(&a.live_document()), [hash.clone()], "the same from the shared document");
+        MEDIA.with_borrow(|(originals, _)| originals.insert(&hash, b"photo".as_slice().into()));
+        assert_eq!(a.live_assets(), [(hash, "IMG 1.jpg".to_string(), true)]);
+        Ok(())
+    }
+}
diff --git a/apps/lightcraft-web/src/web/live.rs b/apps/lightcraft-web/src/web/live.rs
new file mode 100644
index 00000000..5c219bb7
--- /dev/null
+++ b/apps/lightcraft-web/src/web/live.rs
@@ -0,0 +1,71 @@
+//! Live editing in Playground sessions, the web entry's side (`crate::live` is the adapter): the runner, kept so the
+//! adapter reaches the app between frames, and the app wrapped so each frame ends with the session's frame hook.
+
+use super::WebApp;
+use lightcraft_ui_egui::LightcraftApp;
+use std::cell::RefCell;
+
+thread_local! {
+    static RUNNER: RefCell<Option<eframe::WebRunner>> = const { RefCell::new(None) };
+}
+
+/// `eframe::WebRunner::new()`, kept for the adapter.
+pub(super) fn runner() -> eframe::WebRunner {
+    let runner = eframe::WebRunner::new();
+    RUNNER.set(Some(runner.clone()));
+    runner
+}
+
+/// The app, each frame ending with the session's frame hook; the first offers live editing to the Playground shell.
+pub(super) fn wrap(app: WebApp) -> Box<Shell> {
+    Box::new(Shell { app, attached: false })
+}
+
+pub(super) struct Shell {
+    app: WebApp,
+    attached: bool,
+}
+
+/// Runs `f` on the app between frames (false while a frame runs).
+fn with_app(f: &mut dyn FnMut(&mut LightcraftApp)) -> bool {
+    RUNNER.with_borrow(|r| r.as_ref().and_then(|r| r.app_mut::<Shell>()).map(|mut shell| f(&mut shell.app.app)).is_some())
+}
+
+impl eframe::App for Shell {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        eframe::App::logic(&mut self.app, ctx, frame);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        eframe::App::ui(&mut self.app, ui, frame);
+        crate::live::end_frame(&mut self.app.app, ui.ctx());
+        if !std::mem::replace(&mut self.attached, true) {
+            let media = (self.app.originals.clone(), self.app.backend.clone());
+            wasm_bindgen_futures::spawn_local(crate::live::attach(with_app, super::request_repaint, media));
+        }
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw: &mut egui::RawInput) {
+        eframe::App::raw_input_hook(&mut self.app, ctx, raw);
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        eframe::App::save(&mut self.app, storage);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        eframe::App::auto_save_interval(&self.app)
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        eframe::App::clear_color(&self.app, visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        eframe::App::persist_egui_memory(&self.app)
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
diff --git a/crates/catalog/src/playground.rs b/crates/catalog/src/playground.rs
new file mode 100644
index 00000000..f222bf42
--- /dev/null
+++ b/crates/catalog/src/playground.rs
@@ -0,0 +1,58 @@
+//! Hooks for live editing in Playground sessions, set by the web build (`apps/lightcraft-web/src/live.rs`); without
+//! them everything behaves as before. Each is called from one line at the top of the function it changes.
+
+use std::cell::RefCell;
+use std::collections::BTreeSet;
+use std::sync::OnceLock;
+
+use crate::{Op, PhotoId};
+
+/// A new id from a counter while several people edit one library: one none of the others can pick.
+pub static FRESH_ID: OnceLock<fn(&mut u64) -> u64> = OnceLock::new();
+/// Whether a live session is connected.
+pub static LIVE: OnceLock<fn() -> bool> = OnceLock::new();
+/// Takes Undo (`false`) or Redo (`true`) over while it returns true.
+pub static UNDO: OnceLock<fn(bool) -> bool> = OnceLock::new();
+
+thread_local! {
+    /// While live: the photos whose develop settings this person committed since their last automatic version.
+    static OWN_EDITS: RefCell<BTreeSet<PhotoId>> = const { RefCell::new(BTreeSet::new()) };
+}
+
+pub fn live() -> bool {
+    LIVE.get().is_some_and(|connected| connected())
+}
+
+/// `alloc_*_id`: the id [`FRESH_ID`] gives (the counter still goes past it), or `None` to allocate as usual.
+pub fn fresh(counter: &mut u64) -> Option<u64> {
+    let fresh = FRESH_ID.get()?;
+    let id = fresh(&mut (*counter).max(1));
+    *counter = (*counter).max(id.saturating_add(1));
+    Some(id)
+}
+
+/// `edit.undo` / `edit.redo`: whether the session took it.
+pub fn undo(redo: bool) -> bool {
+    UNDO.get().is_some_and(|undo| undo(redo))
+}
+
+/// `Session::commit`: notes the photos whose develop settings this person changed.
+pub fn committed(op: &Op) {
+    if !live() {
+        return;
+    }
+    let mut ops = vec![op];
+    while let Some(op) = ops.pop() {
+        match op {
+            Op::SetDevelop { id, .. } => _ = OWN_EDITS.with_borrow_mut(|own| own.insert(*id)),
+            Op::Batch { ops: inner } => ops.extend(inner),
+            _ => {}
+        }
+    }
+}
+
+/// `Session::auto_version`: while live, a photo's automatic version is made by whoever edited it, not by everyone who
+/// leaves it after their change arrived.
+pub fn others_edit(id: PhotoId) -> bool {
+    live() && !OWN_EDITS.with_borrow_mut(|own| own.remove(&id))
+}
