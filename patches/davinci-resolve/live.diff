+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Live editing in a Playground session (patches/davinci-resolve.yaml in github.com/daijro/openplayground wires it in;
+//! the session and the presence look are the playground-live crate's). The shared document is the project as its file
+//! holds it: media, tracks and clips all have ids (UUIDs, never the same twice), so two people's edits to different
+//! clips, tracks or media both stay, and two people's clips added to one track are put back in time order. What each
+//! person sees for themselves (playhead, selection, page, zoom and scroll, the Source viewer) is outside it already.
+//! Imported media travel as the session's files, by path. Presence: each person's timeline pointer (frame, track),
+//! playhead, selected clips and the clip being dragged or trimmed, drawn on the others' Cut and Edit timelines.
+
+use crate::app::PicassoApp;
+use egui::{Painter, Pos2, Rect, pos2};
+use picasso_core::{Id, Project};
+use playground_live::{Live, Presence, presence};
+use serde_json::{Map, Value, json};
+use std::cell::{Cell, RefCell};
+use std::path::{Component, Path, PathBuf};
+
+/// Clips sent as this person's selection, or as a drag's, at most.
+const MAX_SELECTION: usize = 50;
+/// Picasso Suite's own folders in the browser's memory: another person's media never land there.
+const OWN: [&str; 2] = ["/tmp", "/home"];
+
+thread_local! {
+    /// The rows (track, band) of the timeline being drawn ([`row`], then [`timeline`]).
+    static ROWS: RefCell<Vec<(Id, Rect)>> = const { RefCell::new(Vec::new()) };
+    /// This frame's pointer on a timeline: frame, track (None: the ruler), how far down it.
+    static POINTER: Cell<Option<(f64, Option<Id>, f64)>> = const { Cell::new(None) };
+    static POINTED: Cell<Option<(f64, Option<Id>, f64)>> = const { Cell::new(None) };
+    /// This person's drag under way, as `[track, start, duration]` per clip.
+    static GHOSTS: RefCell<Vec<(Id, i64, i64)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// The end of a frame: the presence look's and the session's ([`playground_live::frame`]).
+pub fn frame(app: &mut PicassoApp, ctx: &egui::Context) {
+    presence::end_frame(ctx);
+    POINTER.set(POINTED.take());
+    playground_live::frame(app);
+}
+
+/// A row of the timeline being drawn: `track`'s band.
+pub fn row(track: Id, rect: Rect) {
+    ROWS.with_borrow_mut(|r| r.push((track, rect)));
+}
+
+/// The others on a timeline whose rows [`row`] gave, before it draws its own playhead: their playheads and the ghosts
+/// of their drags, outlines around their selected clips, then their pointers. A frame is at
+/// `x0 + (frame - frame0) * ppf`; `drag` is this person's (clip, 0 move / 1 trim start / 2 trim end, frames, track
+/// index), which goes into this person's presence.
+#[allow(clippy::too_many_arguments)]
+pub fn timeline(ui: &egui::Ui, painter: &Painter, ruler: Rect, lanes: Rect, x0: f32, frame0: f32, ppf: f32, drag: Option<(Id, u8, i64, usize)>, project: &Project) {
+    let mut rows = ROWS.take();
+    rows.sort_by(|a, b| a.1.min.y.total_cmp(&b.1.min.y));
+    let x = |f: f64| x0 + (f as f32 - frame0) * ppf;
+    let frame_at = |px: f32| f64::from(frame0 + (px - x0) / ppf.max(1e-6));
+    if let Some(p) = ui.ctx().pointer_hover_pos() {
+        let down = |r: Rect| (f64::from((p.y - r.min.y) / r.height().max(1.0)).clamp(0.0, 1.0) * 1000.0).round() / 1000.0;
+        if let Some((track, r)) = rows.iter().find(|(_, r)| r.y_range().contains(p.y)).filter(|_| lanes.contains(p)) {
+            POINTED.set(Some((frame_at(p.x).round(), Some(*track), down(*r))));
+        } else if ruler.contains(p) {
+            POINTED.set(Some((frame_at(p.x).round(), None, down(ruler))));
+        }
+    }
+    GHOSTS.set(drag.map(|d| ghosts(project, d)).unwrap_or_default());
+
+    // A position down the rows: a track's index plus the fraction down it; -1 is the ruler.
+    let place = |track: Option<Id>, y: f64| match track {
+        Some(t) => rows.iter().position(|(id, _)| *id == t).map(|i| i as f64 + y),
+        None => Some(y - 1.0),
+    };
+    let band = |v: f64| -> Option<Rect> {
+        if v < 0.0 {
+            return Some(ruler.translate(egui::vec2(0.0, (v.max(-1.0) + 1.0) as f32 * ruler.height())));
+        }
+        let i = (v as usize).min(rows.len().checked_sub(1)?);
+        let r = rows[i].1;
+        Some(r.translate(egui::vec2(0.0, (v - i as f64) as f32 * r.height())))
+    };
+    let px = [f64::from(ppf), rows.first().map_or(40.0, |r| f64::from(r.1.height()))];
+    let far = [f64::from(lanes.width()) / 4.0, f64::from(lanes.height()) / 4.0];
+    let ctx = ui.ctx();
+    let others = presence::others();
+    let id = |v: &Value| v.as_str().and_then(|s| s.parse::<Id>().ok());
+    for o in &others {
+        let color = presence::color(o);
+        let s = &o.state;
+        if let Some([f]) = s["playhead"].as_f64().and_then(|f| presence::ease(ctx, &o.id, "playhead", [f], [px[0]], [far[0]])) {
+            let at = x(f);
+            if lanes.x_range().contains(at) {
+                presence::playhead(painter, at, [ruler.min.y, lanes.max.y], lanes.max.x, color, &o.name);
+            }
+        }
+        for (i, g) in s["ghosts"].as_array().into_iter().flatten().take(MAX_SELECTION).enumerate() {
+            let Some(v) = id(&g[0]).and_then(|t| place(Some(t), 0.0)) else { continue };
+            let (Some(start), Some(len)) = (g[1].as_f64(), g[2].as_f64()) else { continue };
+            let Some([start, v, len]) = presence::ease(ctx, &o.id, &format!("ghost{i}"), [start, v, len.max(0.0)], [px[0], px[1], px[0]], [far[0], far[1], far[0]]) else { continue };
+            if let Some(r) = band(v) {
+                let body = Rect::from_min_max(pos2(x(start), r.min.y + 1.0), pos2(x(start + len).max(x(start) + 1.0), r.max.y - 1.0));
+                presence::ghost(painter, body, color);
+            }
+        }
+        for clip in s["selection"].as_array().into_iter().flatten().take(MAX_SELECTION).filter_map(id) {
+            let Some((ti, ci)) = project.timeline.find_clip(clip) else { continue };
+            let Some((_, r)) = rows.iter().find(|(t, _)| *t == project.timeline.tracks[ti].id) else { continue };
+            let c = &project.timeline.tracks[ti].clips[ci];
+            let body = Rect::from_min_max(pos2(x(c.start as f64), r.min.y + 1.0), pos2(x(c.end() as f64).max(x(c.start as f64) + 1.0), r.max.y - 1.0));
+            presence::outline(painter, body, color);
+        }
+    }
+    for o in &others {
+        let p = &o.state["pointer"];
+        let track = p.get("track").map(id);
+        let Some(v) = (match track {
+            Some(None) => None,
+            Some(Some(t)) => place(Some(t), p["y"].as_f64().unwrap_or(0.5).clamp(0.0, 1.0)),
+            None => place(None, p["y"].as_f64().unwrap_or(0.5).clamp(0.0, 1.0)),
+        }) else {
+            continue;
+        };
+        let Some(f) = p["frame"].as_f64() else { continue };
+        let Some([f, v]) = presence::ease(ctx, &o.id, "pointer", [f, v], px, far) else { continue };
+        let Some(r) = band(v.floor().max(-1.0)) else { continue };
+        let tip = Pos2::new(x(f), r.min.y + (v - v.floor()) as f32 * r.height());
+        if painter.clip_rect().contains(tip) {
+            presence::cursor(painter, tip, presence::color(o), &o.name);
+        }
+    }
+}
+
+/// The clips a drag under way moves or trims so far, each `(track, start, duration)`, as the Timeline shows them.
+fn ghosts(project: &Project, (clip, mode, delta, target): (Id, u8, i64, usize)) -> Vec<(Id, i64, i64)> {
+    let tracks = &project.timeline.tracks;
+    let mut out: Vec<_> = project
+        .linked_group(clip)
+        .into_iter()
+        .filter_map(|id| {
+            let (ti, ci) = project.timeline.find_clip(id)?;
+            let c = &tracks[ti].clips[ci];
+            let ti = if id == clip && mode == 0 && target < tracks.len() { target } else { ti };
+            Some(match mode {
+                0 => (tracks[ti].id, c.start + delta, c.duration),
+                1 => (tracks[ti].id, c.start + delta, c.duration - delta),
+                _ => (tracks[ti].id, c.start, c.duration + delta),
+            })
+        })
+        .collect();
+    out.truncate(MAX_SELECTION);
+    out
+}
+
+/// Where another person's media file goes in this browser's memory: its path, if it starts at the root (std calls no
+/// path absolute on wasm32-unknown-unknown) and has a single spelling (no `.` or `..`), outside Picasso Suite's own
+/// folders. Anything else is left out.
+fn session_path(id: &str) -> Option<PathBuf> {
+    let path = Path::new(id);
+    let plain = path.has_root() && !id.contains(['\\', '\0']) && path.components().skip(1).all(|c| matches!(c, Component::Normal(_)));
+    (plain && path.components().count() > 1 && !OWN.iter().any(|own| path.starts_with(own))).then(|| path.to_path_buf())
+}
+
+/// Clips must stay in time order on their track (the Timeline and the renderer find them so): two people's clips added
+/// after the same one come in the order of the sides, so every merged track is sorted again.
+fn by_start(document: &mut Value) {
+    let tracks = document.pointer_mut("/timeline/tracks").and_then(Value::as_array_mut);
+    for clips in tracks.into_iter().flatten().filter_map(|t| t.get_mut("clips")?.as_array_mut()) {
+        if clips.iter().all(|c| c["start"].is_i64()) {
+            clips.sort_by_key(|c| c["start"].as_i64());
+        }
+    }
+}
+
+impl Live for PicassoApp {
+    fn live_document(&self) -> Value {
+        serde_json::to_value(&self.project).unwrap_or_default()
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        let mut merged = playground_live::merge(base, current, edited, Self::COUNTERS)?;
+        by_start(&mut merged);
+        Ok(merged)
+    }
+
+    /// What every peer can install: a project whose clips are sorted, last at least a frame, never overlap on their
+    /// track and show media the project has.
+    fn live_check(document: &Value) -> Result<(), String> {
+        let project: Project = serde_json::from_value(document.clone()).map_err(|e| format!("Invalid project: {e}"))?;
+        for t in &project.timeline.tracks {
+            for c in &t.clips {
+                if c.duration < 1 || project.media(c.media_id).is_none() {
+                    return Err(format!("Conflict: clip {} on {}", c.name, t.name));
+                }
+            }
+            if t.clips.windows(2).any(|w| w[1].start < w[0].end()) {
+                return Err(format!("Conflict: clips overlap on {}", t.name));
+            }
+        }
+        Ok(())
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        self.project = serde_json::from_value(document).map_err(|e| format!("Invalid project: {e}"))?;
+        let project = &self.project;
+        self.selection.retain(|id| project.timeline.clip(*id).is_some());
+        if self.media_selection.is_some_and(|m| project.media(m).is_none()) {
+            self.media_selection = project.media.first().map(|m| m.id);
+        }
+        self.touched();
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        presence::quiet()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.version)
+    }
+
+    /// Undo steps hold other people's edits: native Undo starts again from here.
+    fn live_disconnected(&mut self) {
+        self.history.clear();
+    }
+
+    /// The files the project's media read, by path: two different files imported under one path by two people each
+    /// keep their own.
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let mut paths: Vec<&Path> = self.project.media.iter().map(|m| m.path.as_path()).collect();
+        paths.sort();
+        paths.dedup();
+        let name = |p: &Path| p.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+        paths.into_iter().map(|p| (p.to_string_lossy().into_owned(), name(p), std::fs::metadata(p).is_ok_and(|m| m.is_file()))).collect()
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        let mut paths: Vec<String> = document["media"].as_array().into_iter().flatten().filter_map(|m| m["path"].as_str().map(String::from)).collect();
+        paths.sort();
+        paths.dedup();
+        paths
+    }
+
+    fn live_read_asset(&self, id: &str) -> Option<Vec<u8>> {
+        self.project.media.iter().any(|m| m.path.as_os_str() == id).then(|| std::fs::read(id).ok()).flatten()
+    }
+
+    /// Media someone else imported, kept at the project's path for this page only (never copied to Files); a path
+    /// this browser has already keeps its own file.
+    fn live_write_asset(&mut self, id: &str, _name: &str, bytes: Vec<u8>) {
+        let Some(path) = session_path(id) else { return };
+        if std::fs::metadata(&path).is_ok() {
+            return;
+        }
+        #[cfg(target_arch = "wasm32")]
+        {
+            std::fs::put(&path, bytes);
+            crate::web::media_arrived(path);
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            let _ = path.parent().map(std::fs::create_dir_all);
+            let _ = std::fs::write(&path, bytes);
+        }
+    }
+
+    /// The timeline pointer (frame, track or the ruler, how far down), the playhead, the selected clips and a drag
+    /// under way, where its clips are so far.
+    fn live_presence(&self) -> Value {
+        let mut state = Map::new();
+        if let Some((frame, track, y)) = POINTER.get() {
+            let mut p = json!({"frame": frame, "y": y});
+            if let Some(t) = track {
+                p["track"] = json!(t.to_string());
+            }
+            state.insert("pointer".into(), p);
+        }
+        state.insert("playhead".into(), json!(self.playhead));
+        let mut selection: Vec<String> = self.selection.iter().map(Id::to_string).collect();
+        selection.sort();
+        selection.truncate(MAX_SELECTION);
+        state.insert("selection".into(), json!(selection));
+        let ghosts: Vec<Value> = GHOSTS.with_borrow(|g| g.iter().map(|(t, s, d)| json!([t.to_string(), s, d])).collect());
+        if !ghosts.is_empty() {
+            state.insert("ghosts".into(), ghosts.into());
+        }
+        Value::Object(state)
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        presence::show(others);
+    }
+}
+
+/// Offers the running app to a Playground session.
+#[cfg(target_arch = "wasm32")]
+pub fn attach() {
+    let attached = playground_live::web::attach::<PicassoApp>(
+        concat!("davinci-resolve:1:", env!("CARGO_PKG_VERSION")),
+        |with| crate::web::runner().app_mut::<crate::web::Web>().map(|mut web| with(&mut web.app)).is_some(),
+        crate::web::repaint,
+    );
+    if let Err(e) = attached {
+        web_sys::console::error_1(&format!("live editing: {e:?}").into());
+    }
+}
+
+// Playground's browser build: the files (patches/davinci-resolve.yaml).
+#[cfg(target_arch = "wasm32")]
+use picasso_playground::std;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use picasso_core::{AudioInfo, MediaInfo, MediaItem, VideoInfo};
+    use playground_live::canonical;
+
+    fn app() -> PicassoApp {
+        let ctx = egui::Context::default();
+        let mut app = PicassoApp::new(&eframe::CreationContext::_new_kittest(ctx), None);
+        let media = MediaItem {
+            id: picasso_core::new_id(),
+            name: "a.mp4".into(),
+            path: "/Videos/a.mp4".into(),
+            sequence: None,
+            info: MediaInfo {
+                format_name: "mp4".into(),
+                duration_secs: 4.0,
+                video: Some(VideoInfo { codec: "h264".into(), width: 640, height: 360, fps: app.project.settings.fps, pix_fmt: "yuv420p".into(), has_alpha: false, is_still: false }),
+                audio: Some(AudioInfo { codec: "aac".into(), sample_rate: 48_000, channels: 2 }),
+            },
+        };
+        let id = media.id;
+        app.project.media.push(media);
+        app.place_media(id, 0, None);
+        app
+    }
+
+    /// A copy of the first clip of the first track, `at` frames in, as another person would place it.
+    fn add_clip(app: &mut PicassoApp, at: i64, len: i64) {
+        let mut c = app.project.timeline.tracks[0].clips[0].clone();
+        (c.id, c.link, c.start, c.duration) = (picasso_core::new_id(), None, at, len);
+        app.project.timeline.tracks[0].clips.push(c);
+        app.project.timeline.tracks[0].clips.sort_by_key(|c| c.start);
+        app.touched();
+    }
+
+    #[test]
+    fn adopting_keeps_views_and_is_no_undo_step() {
+        let (mut a, mut b) = (app(), app());
+        b.project = a.project.clone();
+        b.project.timeline.tracks[0].clips[0].enabled = false;
+        a.playhead = 40;
+        a.selection.insert(a.project.timeline.tracks[0].clips[0].id);
+        let undo = a.history.can_undo();
+        a.live_adopt(b.live_document()).unwrap();
+        assert_eq!(canonical(&a.live_document()), canonical(&b.live_document()));
+        assert_eq!((a.playhead, a.selection.len(), a.history.can_undo()), (40, 1, undo));
+    }
+
+    #[test]
+    fn clips_two_people_add_merge_in_time_order_and_overlaps_conflict() {
+        let base = app();
+        let merge = |first: i64, second: i64| {
+            let (mut a, mut b) = (app(), app());
+            (a.project, b.project) = (base.project.clone(), base.project.clone());
+            add_clip(&mut a, first, 10);
+            add_clip(&mut b, second, 10);
+            PicassoApp::live_merge(&base.live_document(), &a.live_document(), &b.live_document())
+        };
+        let merged = merge(400, 200).unwrap();
+        PicassoApp::live_check(&merged).unwrap();
+        let starts: Vec<i64> = merged["timeline"]["tracks"][0]["clips"].as_array().unwrap().iter().map(|c| c["start"].as_i64().unwrap()).collect();
+        assert!(starts.windows(2).all(|w| w[0] <= w[1]), "{starts:?}");
+        assert!(PicassoApp::live_check(&merge(300, 305).unwrap()).unwrap_err().contains("overlap"));
+        assert!(PicassoApp::live_check(&json!(null)).is_err());
+    }
+
+    #[test]
+    fn media_are_shared_by_path_and_land_only_at_plain_paths() {
+        let a = app();
+        assert_eq!(PicassoApp::live_assets_of(&a.live_document()), ["/Videos/a.mp4"]);
+        assert_eq!(a.live_assets(), [("/Videos/a.mp4".into(), "a.mp4".into(), false)]);
+        let ids = ["/Videos/b.mp4", "/a/../b.mp4", "relative.mp4", "/tmp/x.mp4", "/", "/a\\b.mp4"];
+        assert_eq!(ids.map(|i| session_path(i).is_some()), [true, false, false, false, false, false]);
+    }
+
+    #[test]
+    fn a_drag_is_shared_where_the_timeline_shows_it() {
+        let a = app();
+        let clip = &a.project.timeline.tracks[0].clips[0];
+        let (track, start, len) = (a.project.timeline.tracks[0].id, clip.start, clip.duration);
+        let moved = ghosts(&a.project, (clip.id, 0, 25, 0));
+        assert!(moved.contains(&(track, start + 25, len)), "{moved:?}");
+        assert_eq!(moved.len(), 2, "with its linked sound");
+        assert!(ghosts(&a.project, (clip.id, 2, -5, 0)).contains(&(track, start, len - 5)));
+    }
+}
