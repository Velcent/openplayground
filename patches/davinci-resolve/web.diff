index 0000000..c4fbb59
--- /dev/null
+++ b/crates/picasso-app/src/web/workers.rs
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! The desktop's background threads (workers.rs) on the page's one thread, for Playground (patches/davinci-resolve.yaml
+//! in github.com/daijro/openplayground): the same API, with the work done where a page can do it.
+//!   preview    renders when asked, on this thread; asked again when a decoder's seek lands
+//!              (`picasso_media::web::frames`), and from scratch when media files arrive.
+//!   import     reads the files with the browser (asynchronously), then hands them over as the thread did.
+//!   overviews  poster frames and waveforms from the browser, as each is ready.
+//!   export     needs FFmpeg: the job fails at once, saying so.
+
+use picasso_core::{Id, MediaItem, Project, Rational};
+use picasso_media::RgbaImage;
+use picasso_render::{DecoderPool, ExportProgress, ExportSettings, render_frame};
+use std::cell::RefCell;
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::rc::Rc;
+use std::sync::Arc;
+use std::sync::mpsc::{Receiver, channel};
+
+pub struct PreviewFrame {
+    pub image: RgbaImage,
+    pub failures: HashMap<Id, String>,
+}
+
+pub struct Preview {
+    ctx: egui::Context,
+    pool: DecoderPool,
+    media: Option<(Vec<(Id, PathBuf)>, u64)>,
+    last_sent: Option<(u64, i64, u32, u32, u64)>,
+    latest: Option<PreviewFrame>,
+}
+
+impl Preview {
+    pub fn spawn(ctx: egui::Context) -> Self {
+        Self { ctx, pool: DecoderPool::new(16), media: None, last_sent: None, latest: None }
+    }
+
+    /// Renders a frame unless the identical request was already rendered (and no decoder has a new frame since).
+    pub fn request(&mut self, project: &Arc<Project>, version: u64, frame: i64, width: u32, height: u32) {
+        let key = (version, frame, width, height, picasso_media::web::frames());
+        if self.last_sent == Some(key) {
+            return;
+        }
+        self.last_sent = Some(key);
+        let media = (project.media.iter().map(|m| (m.id, m.path.clone())).collect(), picasso_media::web::files());
+        if self.media.as_ref() != Some(&media) {
+            self.pool.reset();
+            self.media = Some(media);
+        }
+        let image = render_frame(project, frame, width, height, &mut self.pool);
+        self.latest = Some(PreviewFrame { image, failures: self.pool.failures().clone() });
+        self.ctx.request_repaint();
+    }
+
+    pub fn poll(&mut self) -> Option<PreviewFrame> {
+        self.latest.take()
+    }
+}
+
+pub type ImportOutcome = Vec<(PathBuf, Result<MediaItem, String>)>;
+
+pub fn spawn_import(ctx: egui::Context, paths: Vec<PathBuf>, sequence_fps: Rational) -> Receiver<ImportOutcome> {
+    let (tx, rx) = channel();
+    wasm_bindgen_futures::spawn_local(async move {
+        let mut out = Vec::new();
+        for path in paths {
+            let result = picasso_media::web::probe::probe_async(&path, sequence_fps).await.map_err(|e| e.to_string());
+            out.push((path, result));
+        }
+        let _ = tx.send(out);
+        ctx.request_repaint();
+    });
+    rx
+}
+
+pub struct ExportJob {
+    pub progress: Arc<ExportProgress>,
+    pub result: Receiver<Result<(), String>>,
+}
+
+pub fn spawn_export(_ctx: egui::Context, _project: Project, _settings: ExportSettings) -> ExportJob {
+    let (tx, result) = channel();
+    let _ = tx.send(Err("rendering needs FFmpeg, which Picasso Suite's desktop app has".into()));
+    ExportJob { progress: Arc::default(), result }
+}
+
+pub enum OverviewResult {
+    Thumbnail(Id, RgbaImage),
+    Waveform(Id, Vec<f32>),
+}
+
+/// Waveform resolution: peaks per second of media.
+pub const WAVE_PER_SECOND: u32 = 100;
+
+pub struct Overviews {
+    ctx: egui::Context,
+    done: Rc<RefCell<Vec<OverviewResult>>>,
+    requested: HashSet<Id>,
+}
+
+impl Overviews {
+    pub fn spawn(ctx: egui::Context) -> Self {
+        Self { ctx, done: Rc::default(), requested: HashSet::new() }
+    }
+
+    /// Reads thumbnails and waveforms for media not seen before.
+    pub fn ensure(&mut self, media: &[MediaItem]) {
+        for m in media.iter().filter(|m| m.info.format_name != "offline") {
+            if !self.requested.insert(m.id) {
+                continue;
+            }
+            let (m, done, ctx) = (m.clone(), self.done.clone(), self.ctx.clone());
+            wasm_bindgen_futures::spawn_local(async move {
+                let poster = (m.info.duration_secs * 0.1).min(2.0);
+                if let Some(img) = picasso_media::web::thumbnail(&m, poster, 320, 180).await {
+                    done.borrow_mut().push(OverviewResult::Thumbnail(m.id, img));
+                    ctx.request_repaint();
+                }
+                if m.info.audio.is_some()
+                    && let Some(w) = picasso_media::web::waveform(&m.path).await
+                {
+                    done.borrow_mut().push(OverviewResult::Waveform(m.id, w));
+                    ctx.request_repaint();
+                }
+            });
+        }
+    }
+
+    /// Forgets a media item so it is analysed again (after relinking, or its file arriving).
+    pub fn forget(&mut self, id: Id) {
+        self.requested.remove(&id);
+    }
+
+    pub fn poll(&self) -> Vec<OverviewResult> {
+        std::mem::take(&mut *self.done.borrow_mut())
+    }
+}
