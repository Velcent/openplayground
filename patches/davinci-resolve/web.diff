new file mode 100644
index 0000000..66fc0d7
--- /dev/null
+++ b/crates/picasso-media/src/web.rs
@@ -0,0 +1,407 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Media in the browser, for Playground (patches/davinci-resolve.yaml in github.com/daijro/openplayground). A page can't
+//! run FFmpeg, so on the web the crate reads media with the browser's own decoders instead: `<video>` and `<img>`
+//! elements for pictures, Web Audio for sound. The files are the in-memory ones (picasso-playground's `std::fs`).
+//!
+//! [`decode`] and [`probe`] stand in for the FFmpeg modules of the same names (the crate root takes them from here on
+//! wasm), with the same API. A browser only reads media asynchronously, so:
+//!   probe     [`probe::probe_async`] reads a file (the import does); [`probe::probe`] answers from what it read.
+//!   decode    [`decode::VideoDecoder::frame_at`] returns the frame it has and seeks toward the one asked for; when
+//!             the seek lands, [`frames`] goes up and the page repaints, so the viewer asks again.
+//! Waveforms come from Web Audio ([`waveform`]), poster frames from a `<video>` of their own ([`thumbnail`]).
+
+use crate::frame::RgbaImage;
+use picasso_playground::std::fs;
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+use wasm_bindgen_futures::JsFuture;
+
+/// Extensions read as still pictures; anything else is tried as video, then as sound.
+const STILLS: &[&str] = &["png", "jpg", "jpeg", "gif", "webp", "bmp", "avif", "svg", "ico"];
+/// Extensions read as sound only.
+const SOUNDS: &[&str] = &["wav", "wave", "mp3", "m4a", "aac", "flac", "ogg", "oga", "opus", "aif", "aiff", "caf"];
+/// Web Audio decodes at this rate: enough for a drawn envelope, and a tenth of the memory of the file's own.
+const WAVE_RATE: f32 = 8000.0;
+/// Peaks per second in [`waveform`] (the app's `WAVE_PER_SECOND`).
+const PEAKS_PER_SECOND: usize = 100;
+
+thread_local! {
+    static REPAINT: RefCell<Option<Box<dyn Fn()>>> = const { RefCell::new(None) };
+    static FRAMES: Cell<u64> = const { Cell::new(0) };
+    static FILES: Cell<u64> = const { Cell::new(0) };
+    /// Object URLs of the files' bytes, by path and length (a file brought in again with other bytes gets a new one).
+    static URLS: RefCell<HashMap<(PathBuf, u64), String>> = RefCell::default();
+    /// What [`probe::probe_async`] read, for [`probe::probe`].
+    static PROBED: RefCell<HashMap<PathBuf, picasso_core::MediaInfo>> = RefCell::default();
+    static PEAKS: RefCell<HashMap<PathBuf, Vec<f32>>> = RefCell::default();
+}
+
+/// How the page asks for a frame (the app sets it once it runs).
+pub fn set_repaint(repaint: impl Fn() + 'static) {
+    REPAINT.with_borrow_mut(|r| *r = Some(Box::new(repaint)));
+}
+
+fn repaint() {
+    REPAINT.with_borrow(|r| r.as_ref().map(|r| r()));
+}
+
+/// Goes up each time a decoder has a new frame: the viewer renders again when it changes.
+pub fn frames() -> u64 {
+    FRAMES.get()
+}
+
+fn frame_arrived() {
+    FRAMES.set(FRAMES.get() + 1);
+    repaint();
+}
+
+/// Goes up when media files arrive (brought in from Files, or from a session): decoders that failed try again.
+pub fn files() -> u64 {
+    FILES.get()
+}
+
+/// Media files arrived at these paths.
+pub fn files_arrived<'a>(paths: impl IntoIterator<Item = &'a Path>) {
+    for p in paths {
+        PROBED.with_borrow_mut(|m| m.remove(p));
+        PEAKS.with_borrow_mut(|m| m.remove(p));
+    }
+    FILES.set(FILES.get() + 1);
+    repaint();
+}
+
+fn js(e: JsValue) -> crate::MediaError {
+    crate::MediaError::Probe(e.as_string().unwrap_or_else(|| format!("{e:?}")))
+}
+
+fn ext(path: &Path) -> String {
+    path.extension().map(|e| e.to_string_lossy().to_ascii_lowercase()).unwrap_or_default()
+}
+
+fn document() -> web_sys::Document {
+    web_sys::window().and_then(|w| w.document()).expect("a page")
+}
+
+/// An object URL for the file at `path`, made once per path and length.
+fn url(path: &Path) -> crate::Result<String> {
+    let missing = || crate::MediaError::Io(std::io::Error::new(std::io::ErrorKind::NotFound, format!("{} is not here (yet)", path.display())));
+    let len = fs::metadata(path).map_err(|_| missing())?.len();
+    let key = (path.to_path_buf(), len);
+    if let Some(url) = URLS.with_borrow(|u| u.get(&key).cloned()) {
+        return Ok(url);
+    }
+    let bytes = fs::read(path).map_err(|_| missing())?;
+    let parts = js_sys::Array::of1(&js_sys::Uint8Array::from(bytes.as_slice()));
+    let blob = web_sys::Blob::new_with_u8_array_sequence(&parts).map_err(js)?;
+    let url = web_sys::Url::create_object_url_with_blob(&blob).map_err(js)?;
+    URLS.with_borrow_mut(|u| u.insert(key, url.clone()));
+    Ok(url)
+}
+
+/// Resolves once `target` fires `ok` (true) or `error` (false).
+async fn event(target: &web_sys::EventTarget, ok: &str) -> bool {
+    let promise = js_sys::Promise::new(&mut |resolve, _| {
+        let fire = |value: bool| {
+            let resolve = resolve.clone();
+            Closure::once_into_js(move || drop(resolve.call1(&JsValue::NULL, &value.into())))
+        };
+        let once = web_sys::AddEventListenerOptions::new();
+        once.set_once(true);
+        let _ = target.add_event_listener_with_callback_and_add_event_listener_options(ok, fire(true).unchecked_ref(), &once);
+        let _ = target.add_event_listener_with_callback_and_add_event_listener_options("error", fire(false).unchecked_ref(), &once);
+    });
+    JsFuture::from(promise).await.ok().and_then(|v| v.as_bool()).unwrap_or(false)
+}
+
+fn video_element(src: &str) -> crate::Result<web_sys::HtmlVideoElement> {
+    let video: web_sys::HtmlVideoElement = document().create_element("video").map_err(js)?.unchecked_into();
+    video.set_muted(true);
+    video.set_preload("auto");
+    video.set_attribute("playsinline", "").map_err(js)?;
+    video.set_src(src);
+    Ok(video)
+}
+
+/// A 2D canvas of `w`×`h` whose pixels are read back often.
+fn canvas(w: u32, h: u32) -> crate::Result<web_sys::CanvasRenderingContext2d> {
+    let canvas: web_sys::HtmlCanvasElement = document().create_element("canvas").map_err(js)?.unchecked_into();
+    canvas.set_width(w);
+    canvas.set_height(h);
+    let options = js_sys::Object::new();
+    js_sys::Reflect::set(&options, &"willReadFrequently".into(), &true.into()).map_err(js)?;
+    let ctx = canvas.get_context_with_context_options("2d", &options).map_err(js)?.ok_or_else(|| js("no 2D canvas".into()))?;
+    Ok(ctx.unchecked_into())
+}
+
+/// `source` (a video or picture) drawn at `w`×`h` and read back.
+fn draw(ctx: &web_sys::CanvasRenderingContext2d, source: &JsValue, w: u32, h: u32) -> Option<RgbaImage> {
+    let (wf, hf) = (f64::from(w), f64::from(h));
+    ctx.clear_rect(0.0, 0.0, wf, hf);
+    let drawn = match source.dyn_ref::<web_sys::HtmlVideoElement>() {
+        Some(video) => ctx.draw_image_with_html_video_element_and_dw_and_dh(video, 0.0, 0.0, wf, hf),
+        None => ctx.draw_image_with_html_image_element_and_dw_and_dh(source.unchecked_ref(), 0.0, 0.0, wf, hf),
+    };
+    drawn.ok()?;
+    let data = ctx.get_image_data(0.0, 0.0, wf, hf).ok()?;
+    Some(RgbaImage { width: w, height: h, data: data.data().0 })
+}
+
+/// Peak amplitude (0..1) of the file's sound, [`PEAKS_PER_SECOND`] values a second, mixed to mono; with its duration
+/// and channel count. None: no sound the browser can decode.
+async fn decode_sound(path: &Path) -> Option<(Vec<f32>, f64, u32)> {
+    let bytes = fs::read(path).ok()?;
+    let ctx = web_sys::OfflineAudioContext::new_with_number_of_channels_and_length_and_sample_rate(1, 1, WAVE_RATE).ok()?;
+    // decodeAudioData takes the buffer over: give it its own copy.
+    let buffer = js_sys::Uint8Array::from(bytes.as_slice()).buffer();
+    let decoded = JsFuture::from(ctx.decode_audio_data(&buffer).ok()?).await.ok()?;
+    let audio: web_sys::AudioBuffer = decoded.dyn_into().ok()?;
+    let channels = audio.number_of_channels();
+    let bucket = (WAVE_RATE as usize / PEAKS_PER_SECOND).max(1);
+    let mut peaks = vec![0f32; (audio.length() as usize).div_ceil(bucket)];
+    for c in 0..channels {
+        let samples = audio.get_channel_data(c).ok()?;
+        for (peak, chunk) in peaks.iter_mut().zip(samples.chunks(bucket)) {
+            *peak = chunk.iter().fold(*peak, |m, s| m.max(s.abs())).min(1.0);
+        }
+    }
+    Some((peaks, audio.duration(), channels))
+}
+
+/// The waveform of the file at `path` (what [`crate::overview::waveform`] gives on the desktop): from the import's
+/// probe, or decoded now.
+pub async fn waveform(path: &Path) -> Option<Vec<f32>> {
+    if let Some(peaks) = PEAKS.with_borrow(|p| p.get(path).cloned()) {
+        return Some(peaks);
+    }
+    let (peaks, ..) = decode_sound(path).await?;
+    PEAKS.with_borrow_mut(|p| p.insert(path.to_path_buf(), peaks.clone()));
+    Some(peaks)
+}
+
+/// A poster frame that fits in `max_w`×`max_h`, `seconds` into the media (what [`crate::overview::thumbnail`] gives
+/// on the desktop).
+pub async fn thumbnail(media: &picasso_core::MediaItem, seconds: f64, max_w: u32, max_h: u32) -> Option<RgbaImage> {
+    let v = media.info.video.as_ref()?;
+    let scale = (f64::from(max_w) / f64::from(v.width.max(1))).min(f64::from(max_h) / f64::from(v.height.max(1)));
+    let w = ((f64::from(v.width) * scale).round() as u32).max(2) & !1;
+    let h = ((f64::from(v.height) * scale).round() as u32).max(2) & !1;
+    let src = url(&media.path).ok()?;
+    let source: JsValue = if v.is_still {
+        let img = web_sys::HtmlImageElement::new().ok()?;
+        img.set_src(&src);
+        JsFuture::from(img.decode()).await.ok()?;
+        img.into()
+    } else {
+        let video = video_element(&src).ok()?;
+        if !event(&video, "loadeddata").await {
+            return None;
+        }
+        video.set_current_time(seconds.min((video.duration() - 0.05).max(0.0)));
+        if !event(&video, "seeked").await {
+            return None;
+        }
+        video.into()
+    };
+    draw(&canvas(w, h).ok()?, &source, w, h)
+}
+
+pub mod probe {
+    //! Reading media metadata with the browser (the desktop's is `ffprobe`).
+    use super::*;
+    use crate::MediaError;
+    use picasso_core::{AudioInfo, MediaInfo, MediaItem, Rational, VideoInfo, new_id};
+    use std::ffi::OsString;
+
+    /// FFmpeg's input arguments for a media item, as on the desktop (only the export, which the web build doesn't
+    /// run, reads them).
+    pub fn input_args(media: &MediaItem) -> Vec<OsString> {
+        vec!["-i".into(), media.path.clone().into_os_string()]
+    }
+
+    /// A file [`probe_async`] read. Anything else isn't known yet: a page reads media only asynchronously.
+    pub fn probe(path: &Path, _sequence_fps: Rational) -> crate::Result<MediaItem> {
+        let info = PROBED.with_borrow(|p| p.get(path).cloned()).ok_or_else(|| MediaError::Probe(format!("{} has not been read", path.display())))?;
+        Ok(item(path, info))
+    }
+
+    fn item(path: &Path, info: MediaInfo) -> MediaItem {
+        let name = path.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+        MediaItem { id: new_id(), name, path: path.to_path_buf(), sequence: None, info }
+    }
+
+    /// Reads a file's pictures and sound with the browser. Its frame rate isn't something a browser tells, so video
+    /// takes `fps` (the project's).
+    // ponytail: the project's rate for every video; read it from the container (MP4's stts) if mixed rates matter.
+    pub async fn probe_async(path: &Path, fps: Rational) -> crate::Result<MediaItem> {
+        let e = ext(path);
+        let src = url(path)?;
+        let video = |codec: String, width: u32, height: u32, still: bool| VideoInfo {
+            codec,
+            width,
+            height,
+            fps,
+            pix_fmt: if still { "rgba".into() } else { "yuv420p".into() },
+            has_alpha: still && matches!(e.as_str(), "png" | "webp" | "gif" | "avif" | "svg" | "ico"),
+            is_still: still,
+        };
+        let mut info = MediaInfo { format_name: e.clone(), ..MediaInfo::default() };
+        if STILLS.contains(&e.as_str()) {
+            let img = web_sys::HtmlImageElement::new().map_err(js)?;
+            img.set_src(&src);
+            JsFuture::from(img.decode()).await.map_err(|_| MediaError::NoStreams(path.display().to_string()))?;
+            info.format_name = "image2".into();
+            info.video = Some(video(e.clone(), img.natural_width(), img.natural_height(), true));
+        } else {
+            if !SOUNDS.contains(&e.as_str()) {
+                let el = video_element(&src)?;
+                if event(&el, "loadedmetadata").await && el.video_width() > 0 {
+                    info.video = Some(video(e.clone(), el.video_width(), el.video_height(), false));
+                    info.duration_secs = el.duration();
+                }
+                el.remove_attribute("src").ok();
+            }
+            if let Some((peaks, duration, channels)) = decode_sound(path).await {
+                // ponytail: Web Audio hands back the sound resampled, not the file's own rate; 48 kHz is shown.
+                info.audio = Some(AudioInfo { codec: e.clone(), sample_rate: 48_000, channels });
+                if info.duration_secs <= 0.0 || !info.duration_secs.is_finite() {
+                    info.duration_secs = duration;
+                }
+                PEAKS.with_borrow_mut(|p| p.insert(path.to_path_buf(), peaks));
+            }
+        }
+        if !info.duration_secs.is_finite() {
+            info.duration_secs = 0.0;
+        }
+        if info.video.is_none() && info.audio.is_none() {
+            return Err(MediaError::NoStreams(path.display().to_string()));
+        }
+        PROBED.with_borrow_mut(|p| p.insert(path.to_path_buf(), info.clone()));
+        Ok(item(path, info))
+    }
+}
+
+pub mod decode {
+    //! Video frames from a `<video>` (or a still from an `<img>`), drawn at the size asked for.
+    use super::*;
+    use crate::MediaError;
+    use picasso_core::time::seconds_to_frames;
+    use picasso_core::{MediaItem, Rational};
+    use std::sync::Arc;
+
+    pub struct VideoDecoder {
+        source: JsValue,
+        ctx: web_sys::CanvasRenderingContext2d,
+        fps: Rational,
+        width: u32,
+        height: u32,
+        still: bool,
+        last: Option<(i64, Arc<RgbaImage>)>,
+        /// The element's time when it was last drawn, and the frame last asked for.
+        drawn: Option<f64>,
+        asked: Option<i64>,
+        /// Repaints when the element has a new frame; kept alive with it.
+        _ready: Closure<dyn Fn()>,
+    }
+
+    impl Drop for VideoDecoder {
+        fn drop(&mut self) {
+            // Stop the element loading: it is dropped with the decoder.
+            if let Some(el) = self.source.dyn_ref::<web_sys::Element>() {
+                let _ = el.remove_attribute("src");
+            }
+        }
+    }
+
+    impl VideoDecoder {
+        /// Decoder producing `width`×`height` RGBA frames (scaled by the canvas).
+        pub fn new(media: &MediaItem, width: u32, height: u32) -> crate::Result<Self> {
+            let video = media.info.video.as_ref().ok_or_else(|| MediaError::NoStreams(media.name.clone()))?;
+            let src = url(&media.path)?;
+            let (width, height) = (width.max(2), height.max(2));
+            let ready = Closure::<dyn Fn()>::new(frame_arrived);
+            let source: JsValue = if video.is_still {
+                let img = web_sys::HtmlImageElement::new().map_err(js)?;
+                img.add_event_listener_with_callback("load", ready.as_ref().unchecked_ref()).map_err(js)?;
+                img.set_src(&src);
+                img.into()
+            } else {
+                let el = video_element(&src)?;
+                for e in ["loadeddata", "seeked"] {
+                    el.add_event_listener_with_callback(e, ready.as_ref().unchecked_ref()).map_err(js)?;
+                }
+                el.into()
+            };
+            Ok(Self { source, ctx: canvas(width, height)?, fps: video.fps, width, height, still: video.is_still, last: None, drawn: None, asked: None, _ready: ready })
+        }
+
+        pub fn size(&self) -> (u32, u32) {
+            (self.width, self.height)
+        }
+
+        /// The frame displayed at `seconds` into the media once the element is there; until then the newest frame it
+        /// has drawn on the way (or nothing). The element seeks toward a frame asked for, one seek at a time (when it
+        /// lands, the viewer asks again); while the frames asked for move forward from where it is (playback), it plays
+        /// along instead.
+        pub fn frame_at(&mut self, seconds: f64) -> crate::Result<Option<Arc<RgbaImage>>> {
+            if self.still {
+                if self.last.is_none()
+                    && let Some(img) = self.source.dyn_ref::<web_sys::HtmlImageElement>().filter(|i| i.complete() && i.natural_width() > 0)
+                    && let Some(frame) = draw(&self.ctx, img, self.width, self.height)
+                {
+                    self.last = Some((0, Arc::new(frame)));
+                }
+                return Ok(self.last());
+            }
+            let index = seconds_to_frames(seconds.max(0.0), self.fps);
+            let video: &web_sys::HtmlVideoElement = self.source.unchecked_ref();
+            if let Some(err) = video.error() {
+                return Err(MediaError::Ffmpeg(format!("the browser can't play this video (error {})", err.code())));
+            }
+            const HAVE_METADATA: u16 = 1;
+            const HAVE_CURRENT_DATA: u16 = 2;
+            let rate = self.fps.as_f64().max(1.0);
+            // The middle of the frame, short of the end (a seek past it shows nothing new).
+            let end = video.duration();
+            let mut target = (index as f64 + 0.5) / rate;
+            if end.is_finite() {
+                target = target.min((end - 0.5 / rate).max(0.0));
+            }
+            let now = video.current_time();
+            let ready = !video.seeking() && video.ready_state() >= HAVE_CURRENT_DATA;
+            if ready && self.drawn != Some(now) {
+                if let Some(frame) = draw(&self.ctx, &self.source, self.width, self.height) {
+                    self.last = Some((seconds_to_frames(now, self.fps), Arc::new(frame)));
+                    self.drawn = Some(now);
+                }
+            }
+            let forward = self.asked.is_some_and(|a| index > a);
+            self.asked = Some(index);
+            let ahead = target - now;
+            if ready && ahead.abs() < 0.5 / rate {
+                return Ok(self.last());
+            }
+            if !video.paused() {
+                // Playing along: stop once the frames asked for stop moving forward or leave it behind.
+                if !forward || !(-0.25..=1.0).contains(&ahead) {
+                    let _ = video.pause();
+                    video.set_current_time(target);
+                } else {
+                    // Catching up with the playhead (or letting it catch up) over about half a second.
+                    video.set_playback_rate((1.0 + 2.0 * ahead).clamp(0.5, 2.0));
+                }
+            } else if ready && forward && (0.0..0.5).contains(&ahead) {
+                video.set_playback_rate(1.0);
+                let _ = video.play();
+            } else if !video.seeking() && video.ready_state() >= HAVE_METADATA {
+                video.set_current_time(target);
+            }
+            Ok(self.last())
+        }
+
+        fn last(&self) -> Option<Arc<RgbaImage>> {
+            self.last.as_ref().map(|(_, img)| img.clone())
+        }
+    }
+}
diff --git a/crates/picasso-playground/Cargo.toml b/crates/picasso-playground/Cargo.toml
new file mode 100644
index 0000000..076b9f4
--- /dev/null
+++ b/crates/picasso-playground/Cargo.toml
@@ -0,0 +1,12 @@
+# Playground's browser build of Picasso Suite (patches/davinci-resolve.yaml in github.com/daijro/openplayground): std's
+# clock, files and threads as wasm32-unknown-unknown can have them. Native builds compile it empty.
+[package]
+name = "picasso-playground"
+version = "0.1.0"
+edition = "2021"
+description = "Picasso Suite in the browser: the clock, files and threads std lacks on wasm32-unknown-unknown"
+license = "GPL-3.0-or-later"
+publish = false
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+web-time = "1"
