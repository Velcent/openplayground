+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Picasso Suite in the browser, for Playground (patches/davinci-resolve.yaml in github.com/daijro/openplayground): the
+//! desktop window on the page's canvas, its files in Playground's Files, and media read by the browser.
+//!
+//! `main` runs as on the desktop: the crate root takes [`eframe`] from here on the web, whose `run_native` starts the
+//! app on the page with the desktop's own creator. Files live in memory (picasso-playground's `std::fs`): a file opened
+//! from Files comes in at its path (`browser:/Videos/a.mp4` is `/Videos/a.mp4` here), one from the computer or dropped
+//! on the window is kept in Files at `/Picasso Suite/Media/<name>`, so a saved project finds it again. File > Open…,
+//! Import Media…, Save As… and Export Timeline (OTIO) are Playground's dialogs ([`rfd`]), and whatever Picasso Suite
+//! writes outside its own folders (a saved project) goes back to Files after the frame. A project's media that aren't
+//! in memory yet are read from Files. "Open in Picasso Suite" opens a project or imports media. Rendering needs FFmpeg,
+//! so the Deliver page says it takes the desktop app.
+
+use crate::app::PicassoApp;
+
+pub mod workers;
+use ::eframe::egui;
+use picasso_playground::std::fs;
+use std::cell::{Cell, OnceCell, RefCell};
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+/// Picasso Suite's own folders in memory, never copied to Files: scratch files, key bindings, sessions' media.
+const OWN: [&str; 3] = ["/tmp", "/home", "/live"];
+/// Where media from the computer (and dropped files) are kept, in Files too.
+const MEDIA: &str = "/Picasso Suite/Media";
+/// What Import Media… offers (the browser's decoders read these).
+const MEDIA_TYPES: [&str; 18] = ["mp4", "m4v", "mov", "webm", "mkv", "png", "jpg", "jpeg", "gif", "webp", "bmp", "wav", "mp3", "m4a", "aac", "flac", "ogg", "opus"];
+
+/// A dialog the app asked for this frame (see [`rfd`]).
+#[derive(Clone, Copy, PartialEq)]
+enum Ask {
+    Open,
+    Import,
+    /// Save As… (a project) or Export Timeline (OTIO), by the extension the dialog filtered on.
+    Save(&'static str),
+}
+
+thread_local! {
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+    static ASKED: Cell<Option<Ask>> = const { Cell::new(None) };
+    /// Files from Playground (Open, Import, "Open in Picasso Suite"), for the next frame.
+    static OPENED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    /// Where Save As… put a project or an OTIO timeline, for the next frame.
+    static SAVED: RefCell<Option<(PathBuf, &'static str)>> = const { RefCell::new(None) };
+    /// Dropped files whose bytes are in memory now, for the next frame.
+    static DROPPED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    /// Media files that came in since the last frame (from Files or a session).
+    static ARRIVED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    /// Media paths already asked of Files.
+    static ASKED_FILES: RefCell<HashSet<PathBuf>> = RefCell::default();
+}
+
+pub fn repaint() {
+    CTX.with(|c| c.get().map(egui::Context::request_repaint));
+}
+
+/// The desktop's eframe, with `run_native` starting the app on the page instead.
+pub mod eframe {
+    pub use ::eframe::*;
+
+    /// The desktop window's options, which a page has no use for.
+    #[derive(Default)]
+    #[allow(dead_code)]
+    pub struct NativeOptions {
+        pub viewport: egui::ViewportBuilder,
+    }
+
+    /// Runs the app `creator` makes on the page's canvas.
+    pub fn run_native(_name: &str, _options: NativeOptions, creator: super::Creator) -> ::eframe::Result {
+        super::start(creator)
+    }
+
+    /// A PNG as eframe's icon data (the app's logo; eframe has this on the desktop only).
+    pub mod icon_data {
+        pub fn from_png_bytes(png: &[u8]) -> Result<::eframe::egui::IconData, String> {
+            let img = image::load_from_memory_with_format(png, image::ImageFormat::Png).map_err(|e| e.to_string())?.into_rgba8();
+            Ok(::eframe::egui::IconData { width: img.width(), height: img.height(), rgba: img.into_raw() })
+        }
+    }
+}
+
+/// The desktop's file dialogs: on the web they ask Playground's after the frame ([`Web::after`]) and give nothing now.
+pub mod rfd {
+    use std::path::PathBuf;
+
+    pub struct FileDialog {
+        extensions: Vec<String>,
+    }
+
+    impl FileDialog {
+        pub fn new() -> Self {
+            Self { extensions: Vec::new() }
+        }
+        pub fn add_filter<T: ToString>(mut self, _name: impl Into<String>, extensions: &[T]) -> Self {
+            self.extensions.extend(extensions.iter().map(ToString::to_string));
+            self
+        }
+        pub fn set_title(self, _title: impl Into<String>) -> Self {
+            self
+        }
+        pub fn set_file_name(self, _name: impl Into<String>) -> Self {
+            self
+        }
+        pub fn pick_file(self) -> Option<PathBuf> {
+            super::ASKED.set(Some(super::Ask::Open));
+            None
+        }
+        pub fn pick_files(self) -> Option<Vec<PathBuf>> {
+            super::ASKED.set(Some(super::Ask::Import));
+            None
+        }
+        pub fn save_file(self) -> Option<PathBuf> {
+            let otio = self.extensions.iter().any(|e| e == "otio");
+            super::ASKED.set(Some(super::Ask::Save(if otio { "otio" } else { picasso_core::io::EXTENSION })));
+            None
+        }
+        /// Playground's Files has no folder picker: nothing is chosen (Relink Media and the render location).
+        pub fn pick_folder(self) -> Option<PathBuf> {
+            None
+        }
+    }
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = Some(get(&js_sys::global(), "playgroundFiles")).filter(JsValue::is_object)?;
+    let f = get(&api, method).dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok().filter(|v| !v.is_null() && !v.is_undefined())
+}
+
+fn is_project(path: &Path) -> bool {
+    path.extension().is_some_and(|e| e.eq_ignore_ascii_case(picasso_core::io::EXTENSION) || e.eq_ignore_ascii_case("drp"))
+}
+
+/// A file from Files (`{ path, name, bytes }`) into memory at its path; one from the computer is kept in Files too, at
+/// `/Picasso Suite/<name>` (a project) or `/Picasso Suite/Media/<name>`.
+fn bring_in(file: &JsValue) -> Option<PathBuf> {
+    let name = get(file, "name").as_string()?;
+    let bytes = js_sys::Uint8Array::new(&get(file, "bytes")).to_vec();
+    match get(file, "path").as_string().and_then(|p| p.strip_prefix("browser:").map(PathBuf::from)) {
+        Some(path) => {
+            fs::put(&path, bytes);
+            Some(path)
+        }
+        None => {
+            let name = Path::new(&name).file_name()?;
+            let path = if is_project(Path::new(name)) { Path::new(MEDIA).with_file_name(name) } else { Path::new(MEDIA).join(name) };
+            fs::write(&path, bytes).ok()?;
+            Some(path)
+        }
+    }
+}
+
+fn opened(files: JsValue) {
+    let files: Vec<PathBuf> = js_sys::Array::from(&files).iter().filter_map(|f| bring_in(&f)).collect();
+    picasso_media::web::files_arrived(files.iter().map(PathBuf::as_path));
+    OPENED.with_borrow_mut(|o| o.extend(files));
+    repaint();
+}
+
+fn types(list: &[&str]) -> JsValue {
+    list.iter().map(|t| JsValue::from(*t)).collect::<js_sys::Array>().into()
+}
+
+/// Media someone else's edits refer to arrived at `path` (live editing's session media): the viewer and overviews
+/// read it again on the next frame.
+pub fn media_arrived(path: PathBuf) {
+    picasso_media::web::files_arrived([path.as_path()]);
+    ARRIVED.with_borrow_mut(|a| a.push(path));
+    repaint();
+}
+
+/// The page's app: the window, then what it asked of the page.
+pub struct Web {
+    pub app: PicassoApp,
+    unsaved: Option<bool>,
+}
+
+impl Web {
+    fn new(app: PicassoApp) -> Self {
+        Self { app, unsaved: None }
+    }
+
+    /// After the window's frame: files that came in, the dialogs it asked for, what it wrote, its unsaved state.
+    fn after(&mut self, ctx: &egui::Context) {
+        // What the frame spawned, now that it is drawn.
+        picasso_playground::std::thread::run_spawned();
+        let (projects, media): (Vec<_>, Vec<_>) = OPENED.take().into_iter().partition(|p| is_project(p));
+        if let Some(p) = projects.into_iter().next() {
+            self.app.open_path(p);
+        }
+        if !media.is_empty() {
+            self.app.import_paths(ctx, media);
+        }
+        if let Some((path, kind)) = SAVED.take() {
+            self.save_to(path, kind);
+        }
+        match ASKED.take() {
+            Some(Ask::Open) => self.open(&[picasso_core::io::EXTENSION, "drp"]),
+            Some(Ask::Import) => self.open(&MEDIA_TYPES),
+            Some(Ask::Save(kind)) => self.save_as(kind),
+            None => {}
+        }
+        for p in fs::changes().into_iter().filter(|p| !OWN.iter().any(|own| p.starts_with(own))) {
+            let target = JsValue::from(format!("browser:{}", p.display()));
+            match fs::metadata(&p) {
+                Ok(m) if m.is_file() => {
+                    call("write", &[target, js_sys::Uint8Array::from(fs::read(&p).unwrap_or_default().as_slice()).into()]);
+                }
+                Ok(_) => {}
+                Err(_) => {
+                    call("remove", &[target]);
+                }
+            }
+        }
+        self.bring_in_media();
+        let arrived = ARRIVED.take();
+        if !arrived.is_empty() {
+            for m in self.app.project.media.iter().filter(|m| arrived.contains(&m.path)) {
+                self.app.overviews.forget(m.id);
+            }
+            self.app.overviews.ensure(&self.app.project.media);
+        }
+        if self.unsaved.replace(self.app.dirty) != Some(self.app.dirty) {
+            call("setUnsaved", &[self.app.dirty.into()]);
+        }
+    }
+
+    /// The project's media that aren't in memory, read from Files once each (a project opened from Files refers to
+    /// media kept there).
+    fn bring_in_media(&self) {
+        for m in &self.app.project.media {
+            let path = m.path.clone();
+            if fs::metadata(&path).is_ok() || !ASKED_FILES.with_borrow_mut(|a| a.insert(path.clone())) {
+                continue;
+            }
+            let read = call("read", &[format!("browser:{}", path.display()).into()]);
+            wasm_bindgen_futures::spawn_local(async move {
+                if let Some(bytes) = wait(read).await {
+                    fs::put(&path, js_sys::Uint8Array::new(&bytes).to_vec());
+                    media_arrived(path);
+                }
+            });
+        }
+    }
+
+    /// Playground's Open dialog, for `types`.
+    fn open(&self, list: &[&str]) {
+        let options = js_sys::Object::new();
+        let _ = js_sys::Reflect::set(&options, &"types".into(), &types(list));
+        let asked = call("open", &[options.into()]);
+        wasm_bindgen_futures::spawn_local(async move {
+            if let Some(files) = wait(asked).await {
+                opened(files);
+            }
+        });
+    }
+
+    /// A project (`pcsp`) or an OTIO timeline as it would be written now, at a scratch path.
+    fn content(&self, kind: &str, name: &str) -> Option<Vec<u8>> {
+        let scratch = Path::new("/tmp/picasso-save").join(name);
+        match kind {
+            "otio" => picasso_interop::otio::write(&self.app.project, &scratch).ok()?,
+            _ => picasso_core::io::save(&self.app.project, &scratch).ok()?,
+        }
+        fs::read(&scratch).ok()
+    }
+
+    /// Save As… / Export Timeline: Playground's dialog, with the file as it is now for "Download to device"; a place
+    /// in Files saves there on the next frame.
+    fn save_as(&self, kind: &'static str) {
+        let base = if kind == "otio" { &self.app.project.timeline.name } else { &self.app.project.name };
+        let name = format!("{base}.{kind}");
+        let options = js_sys::Object::new();
+        for (k, v) in [
+            ("name", JsValue::from(name.as_str())),
+            ("types", types(&[kind])),
+            ("bytes", js_sys::Uint8Array::from(self.content(kind, &name).unwrap_or_default().as_slice()).into()),
+        ] {
+            let _ = js_sys::Reflect::set(&options, &k.into(), &v);
+        }
+        let asked = call("saveAs", &[options.into()]);
+        wasm_bindgen_futures::spawn_local(async move {
+            let path = wait(asked).await.and_then(|a| get(&a, "path").as_string());
+            if let Some(path) = path.and_then(|p| p.strip_prefix("browser:").map(PathBuf::from)) {
+                SAVED.set(Some((path, kind)));
+                repaint();
+            }
+        });
+    }
+
+    /// What the desktop's Save As… and Export Timeline do once they have a path.
+    fn save_to(&mut self, path: PathBuf, kind: &str) {
+        let app = &mut self.app;
+        if kind == "otio" {
+            app.status = match picasso_interop::otio::write(&app.project, &path) {
+                Ok(()) => format!("Exported {}", path.display()),
+                Err(e) => format!("OTIO export failed: {e}"),
+            };
+            return;
+        }
+        let path = path.with_extension(picasso_core::io::EXTENSION);
+        match picasso_core::io::save(&app.project, &path) {
+            Ok(()) => {
+                app.status = format!("Saved {}", path.display());
+                app.path = Some(path);
+                app.dirty = false;
+            }
+            Err(e) => app.status = format!("Save failed: {e}"),
+        }
+    }
+}
+
+/// A dropped file, in memory.
+#[derive(Debug)]
+struct InMemory(PathBuf);
+
+impl egui::DroppedFile for InMemory {
+    fn path(&self) -> &Path {
+        &self.0
+    }
+    fn bytes_async(&self) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<Vec<u8>, String>> + '_>> {
+        let bytes = fs::read(&self.0).map_err(|e| e.to_string());
+        Box::pin(async move { bytes })
+    }
+}
+
+impl ::eframe::App for Web {
+    fn raw_input_hook(&mut self, _: &egui::Context, raw_input: &mut egui::RawInput) {
+        // A dropped file is only a name on the web: once its bytes are kept at /Picasso Suite/Media/<name>, a later
+        // frame drops that file instead, as the desktop window gets it.
+        raw_input.dropped_files.extend(DROPPED.take().into_iter().map(|p| std::sync::Arc::new(InMemory(p)) as _));
+        for f in std::mem::take(&mut raw_input.dropped_files) {
+            if f.path().parent() == Some(Path::new(MEDIA)) {
+                raw_input.dropped_files.push(f);
+                continue;
+            }
+            wasm_bindgen_futures::spawn_local(async move {
+                if let (Ok(bytes), Some(name)) = (f.bytes_async().await, f.path().file_name()) {
+                    let path = Path::new(MEDIA).join(name);
+                    if fs::write(&path, bytes).is_ok() {
+                        picasso_media::web::files_arrived([path.as_path()]);
+                        DROPPED.with_borrow_mut(|d| d.push(path));
+                        repaint();
+                    }
+                }
+            });
+        }
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut ::eframe::Frame) {
+        ::eframe::App::ui(&mut self.app, ui, frame);
+        self.after(&ui.ctx().clone());
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
+
+/// The page's web runner.
+pub fn runner() -> ::eframe::WebRunner {
+    thread_local! {
+        static RUNNER: OnceCell<::eframe::WebRunner> = const { OnceCell::new() };
+    }
+    RUNNER.with(|kept| kept.get_or_init(::eframe::WebRunner::new).clone())
+}
+
+/// What the page runs: the app with the page's side around it.
+fn wrap(app: PicassoApp) -> Box<dyn ::eframe::App> {
+    Box::new(Web::new(app))
+}
+
+/// The desktop's app creator, as `main` hands it over (a `Box<PicassoApp>`, not eframe's `dyn App`).
+pub type Creator = Box<dyn FnOnce(&::eframe::CreationContext<'_>) -> Result<Box<PicassoApp>, DynError>>;
+type DynError = Box<dyn std::error::Error + Send + Sync>;
+
+/// [`eframe::run_native`] on the web: the app made by the desktop's creator once the page's runner has a context.
+fn start(creator: Creator) -> ::eframe::Result {
+    std::panic::set_hook(Box::new(|info| web_sys::console::error_1(&format!("Picasso Suite: {info}").into())));
+    call("onOpen", &[Closure::<dyn Fn(JsValue)>::new(|file: JsValue| opened(js_sys::Array::of1(&file).into())).into_js_value()]);
+    wasm_bindgen_futures::spawn_local(async move {
+        let document = web_sys::window().and_then(|w| w.document()).expect("no document");
+        let canvas = document
+            .get_element_by_id("picasso_canvas")
+            .and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok())
+            .expect("no #picasso_canvas");
+        let creator = move |cc: &::eframe::CreationContext<'_>| {
+            CTX.with(|c| c.set(cc.egui_ctx.clone()).ok());
+            picasso_media::web::set_repaint(repaint);
+            Ok(wrap(*creator(cc)?))
+        };
+        let started = runner().start(canvas, ::eframe::WebOptions::default(), Box::new(creator)).await;
+        if let Some(loading) = document.get_element_by_id("picasso_loading") {
+            match started {
+                Ok(()) => loading.remove(),
+                Err(e) => loading.set_text_content(Some(&format!("Picasso Suite could not start: {e:?}"))),
+            }
+        }
+    });
+    Ok(())
+}
