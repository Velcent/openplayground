+  <!-- Picasso Suite in the browser, for Playground (patches/davinci-resolve.yaml in github.com/daijro/openplayground). -->
+  <link data-trunk rel="rust" href="crates/picasso-app/Cargo.toml" data-bin="picasso-suite" data-wasm-opt="0" />
+  <link data-trunk rel="icon" href="crates/picasso-app/assets/icon.png" />
+  <style>
+    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #1c1c1f; }
+    #picasso_canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
+    #picasso_loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
+      color: #d8d8dc; font: 14px system-ui, sans-serif; pointer-events: none; }
+  </style>
+</head>
+<body>
+  <canvas id="picasso_canvas"></canvas>
+  <div id="picasso_loading">Loading Picasso Suite&hellip;</div>
