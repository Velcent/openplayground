+// SPDX-License-Identifier: MIT
+//! Live editing in a Playground session (patches/mspaint.yaml in github.com/daijro/openplayground). Playground's
+//! `shell/live.js` drives it through the adapter [`web::attach`] offers; nothing here runs until a session connects.
+//! Web only; the document functions also run in native tests. A child of the app module, so it reads the app's state.
+//!
+//! The shared document is the picture: its size and pixels, cut into 64×64 tiles, each a single colour or a PNG, so a
+//! stroke changes only the bytes of the tiles it touched ([`MAGIC`] for the layout). Two people's edits merge pixel by
+//! pixel ([`merge`]): both strokes stay, and where both painted the same pixel the later one is on top. A remote change
+//! goes into the picture at the end of a frame with no stroke under way ([`frame`]) and is no step of the app's own
+//! history; while connected, Undo and Redo go to the session, which takes back only this person's edits. Each person's
+//! pointer and the stroke, shape or text they are making go to the others (`peers`). Presence lists and the look of the
+//! others' pointers are the playground-live crate's (patches/live/kit).
+
+mod peers;
+#[cfg(test)]
+mod tests;
+
+#[cfg(target_arch = "wasm32")]
+pub use peers::paint;
+
+use super::{DragState, SelfPaintApp};
+use crate::document::Document;
+use image::RgbaImage;
+use playground_live::presence;
+use std::cell::{Cell, RefCell};
+use std::collections::VecDeque;
+
+/// The document's format: peers whose formats differ do not share a document.
+pub const FORMAT: &str = "mspaint:1";
+/// The document: this line; the width and height (u32, little-endian); then each tile in rows from the top left, as a
+/// u32 n and n bytes: `0 r g b a` for a tile of one colour, else the tile as a PNG (RGBA, 8 bits).
+const MAGIC: &[u8] = b"selfpaint-live 1\n";
+const TILE: u32 = 64;
+/// The app's largest picture side (`Document::new`).
+const MAX_SIDE: u32 = 8192;
+
+fn invalid(e: impl std::fmt::Display) -> String {
+    format!("Invalid shared picture: {e}")
+}
+
+// ---------------------------------------------------------------- the document
+
+/// The rectangle of tile `i` in a w×h picture: x, y, width, height.
+fn tile_rect(w: u32, h: u32, i: usize) -> (u32, u32, u32, u32) {
+    let across = w.div_ceil(TILE);
+    let (x, y) = (i as u32 % across * TILE, i as u32 / across * TILE);
+    (x, y, TILE.min(w - x), TILE.min(h - y))
+}
+
+fn tile_count(w: u32, h: u32) -> usize {
+    (w.div_ceil(TILE) * h.div_ceil(TILE)) as usize
+}
+
+/// The pixels of `rect` in a picture `w` wide, row after row.
+fn cut(raw: &[u8], w: u32, (x, y, tw, th): (u32, u32, u32, u32)) -> Vec<u8> {
+    let (w, x, tw) = (w as usize, x as usize, tw as usize);
+    (y as usize..(y + th) as usize).flat_map(|row| &raw[(row * w + x) * 4..(row * w + x + tw) * 4]).copied().collect()
+}
+
+/// One tile's bytes (see [`MAGIC`]).
+fn encode(px: &[u8], tw: u32, th: u32) -> Vec<u8> {
+    use image::ImageEncoder as _;
+    if px.chunks_exact(4).all(|p| p == &px[..4]) {
+        return [&[0], &px[..4]].concat();
+    }
+    let mut png = Vec::new();
+    let encoder = image::codecs::png::PngEncoder::new_with_quality(&mut png, image::codecs::png::CompressionType::Fast, image::codecs::png::FilterType::Adaptive);
+    encoder.write_image(px, tw, th, image::ExtendedColorType::Rgba8).expect("encoding a PNG in memory");
+    png
+}
+
+fn decode(bytes: &[u8], tw: u32, th: u32) -> Result<Vec<u8>, String> {
+    if let [0, rgba @ ..] = bytes {
+        return if rgba.len() == 4 { Ok(rgba.repeat((tw * th) as usize)) } else { Err(invalid("tile")) };
+    }
+    // The size in its header first: a PNG from someone else could claim any size.
+    let size = |at: usize| bytes.get(at..at + 4).map(|n| u32::from_be_bytes(n.try_into().unwrap_or_default()));
+    if (size(16), size(20)) != (Some(tw), Some(th)) {
+        return Err(invalid("tile size"));
+    }
+    let img = image::load_from_memory_with_format(bytes, image::ImageFormat::Png).map_err(invalid)?.into_rgba8();
+    if img.dimensions() != (tw, th) {
+        return Err(invalid("tile size"));
+    }
+    Ok(img.into_raw())
+}
+
+/// A document taken apart (its tiles still encoded).
+struct Doc<'a> {
+    w: u32,
+    h: u32,
+    tiles: Vec<&'a [u8]>,
+}
+
+fn parse(bytes: &[u8]) -> Result<Doc<'_>, String> {
+    fn take<'a>(rest: &mut &'a [u8], n: usize) -> Result<&'a [u8], String> {
+        let (head, tail) = rest.split_at_checked(n).ok_or_else(|| invalid("cut short"))?;
+        *rest = tail;
+        Ok(head)
+    }
+    let number = |rest: &mut &[u8]| take(rest, 4).map(|n| u32::from_le_bytes(n.try_into().unwrap_or_default()));
+    let mut rest = bytes.strip_prefix(MAGIC).ok_or_else(|| invalid("not a SelfPaint picture"))?;
+    let (w, h) = (number(&mut rest)?, number(&mut rest)?);
+    if !(1..=MAX_SIDE).contains(&w) || !(1..=MAX_SIDE).contains(&h) {
+        return Err(invalid(format!("{w} × {h} px")));
+    }
+    let mut tiles = Vec::with_capacity(tile_count(w, h));
+    for _ in 0..tile_count(w, h) {
+        let n = number(&mut rest)? as usize;
+        tiles.push(take(&mut rest, n)?);
+    }
+    if !rest.is_empty() {
+        return Err(invalid("trailing bytes"));
+    }
+    Ok(Doc { w, h, tiles })
+}
+
+fn write(w: u32, h: u32, tiles: &[impl AsRef<[u8]>]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(MAGIC.len() + 8 + tiles.iter().map(|t| 4 + t.as_ref().len()).sum::<usize>());
+    out.extend(MAGIC);
+    out.extend(w.to_le_bytes());
+    out.extend(h.to_le_bytes());
+    for tile in tiles {
+        out.extend((tile.as_ref().len() as u32).to_le_bytes());
+        out.extend(tile.as_ref());
+    }
+    out
+}
+
+/// A whole picture as the document.
+#[cfg(test)]
+fn document_of(img: &RgbaImage) -> Vec<u8> {
+    let (w, h) = img.dimensions();
+    let tiles: Vec<_> = (0..tile_count(w, h)).map(|i| tile_rect(w, h, i)).map(|r| encode(&cut(img.as_raw(), w, r), r.2, r.3)).collect();
+    write(w, h, &tiles)
+}
+
+/// The picture a document holds.
+#[cfg(test)]
+fn picture_of(bytes: &[u8]) -> Result<RgbaImage, String> {
+    let doc = parse(bytes)?;
+    let mut img = RgbaImage::new(doc.w, doc.h);
+    for (i, tile) in doc.tiles.iter().enumerate() {
+        let r = tile_rect(doc.w, doc.h, i);
+        paste(&mut img, doc.w, r, &decode(tile, r.2, r.3)?);
+    }
+    Ok(img)
+}
+
+/// `px` (a tile's pixels) into `rect` of a picture `w` wide.
+fn paste(raw: &mut [u8], w: u32, (x, y, tw, th): (u32, u32, u32, u32), px: &[u8]) {
+    let w = w as usize;
+    for row in 0..th as usize {
+        let at = ((y as usize + row) * w + x as usize) * 4;
+        raw[at..at + tw as usize * 4].copy_from_slice(&px[row * tw as usize * 4..(row + 1) * tw as usize * 4]);
+    }
+}
+
+/// The three-way merge: `current` (the side not accepted yet: this person's unsent work, or the proposal being
+/// placed) and `edited` (the accepted change) both changed `base`. Each pixel takes the side that changed it; a pixel
+/// both changed takes `current`'s, which is applied after `edited`, so both strokes stay and the later is on top. A new
+/// canvas size on one side wins when the other left the picture as it was, and is a conflict otherwise. Tiles the
+/// result takes that `base` did not have are checked to decode.
+pub fn merge(base: &[u8], current: &[u8], edited: &[u8]) -> Result<Vec<u8>, String> {
+    let (b, c, e) = (parse(base)?, parse(current)?, parse(edited)?);
+    let checked = |doc: &Doc, bytes: &[u8]| -> Result<Vec<u8>, String> {
+        for (i, tile) in doc.tiles.iter().enumerate() {
+            let r = tile_rect(doc.w, doc.h, i);
+            if (doc.w, doc.h) != (b.w, b.h) || *tile != b.tiles[i] {
+                decode(tile, r.2, r.3)?;
+            }
+        }
+        Ok(bytes.to_vec())
+    };
+    if (c.w, c.h, e.w, e.h) != (b.w, b.h, b.w, b.h) {
+        return match (edited == base, current == base) {
+            (true, _) => checked(&c, current),
+            (_, true) => checked(&e, edited),
+            _ => Err("Conflict: the canvas size changed".into()),
+        };
+    }
+    let mut tiles = Vec::with_capacity(b.tiles.len());
+    for i in 0..b.tiles.len() {
+        let (tb, tc, te) = (b.tiles[i], c.tiles[i], e.tiles[i]);
+        let r = tile_rect(b.w, b.h, i);
+        let take = |t: &[u8]| -> Result<Vec<u8>, String> {
+            if t != tb {
+                decode(t, r.2, r.3)?;
+            }
+            Ok(t.to_vec())
+        };
+        tiles.push(if te == tb || tc == te {
+            take(tc)?
+        } else if tc == tb {
+            take(te)?
+        } else {
+            let (pb, pc, pe) = (decode(tb, r.2, r.3)?, decode(tc, r.2, r.3)?, decode(te, r.2, r.3)?);
+            let px: Vec<u8> = pb.chunks_exact(4).zip(pc.chunks_exact(4)).zip(pe.chunks_exact(4)).flat_map(|((b, c), e)| if c != b { c } else { e }).copied().collect();
+            encode(&px, r.2, r.3)
+        });
+    }
+    Ok(write(b.w, b.h, &tiles))
+}
+
+// ---------------------------------------------------------------- the app's document, kept encoded
+
+/// The document as last made from the picture or installed into it.
+#[derive(Default)]
+struct Cache {
+    w: u32,
+    h: u32,
+    tiles: Vec<Vec<u8>>,
+    /// The pixels the tiles hold.
+    pixels: Vec<u8>,
+    bytes: Vec<u8>,
+    /// [`CHANGES`] when they were made.
+    seen: u64,
+}
+
+thread_local! {
+    static CACHE: RefCell<Cache> = RefCell::default();
+    /// Counts the app's changes to its picture (`touch`, from the app's mark_doc_dirty).
+    static CHANGES: Cell<u64> = const { Cell::new(1) };
+    static SESSION: RefCell<Session> = RefCell::default();
+}
+
+/// The app changed its picture (called where it marks it changed).
+pub fn touch() {
+    CHANGES.set(CHANGES.get() + 1);
+}
+
+/// No stroke under way (it paints into the picture as it goes; shapes and text go in at once when done).
+fn quiet(app: &SelfPaintApp) -> bool {
+    !matches!(app.drag, DragState::Stroke { .. })
+}
+
+/// The picture as the document: only the tiles that changed since last time are encoded again.
+fn document(app: &SelfPaintApp) -> Vec<u8> {
+    CACHE.with_borrow_mut(|c| {
+        let (w, h, changes) = (app.doc.width(), app.doc.height(), CHANGES.get());
+        if c.seen == changes && (c.w, c.h) == (w, h) && !c.bytes.is_empty() {
+            return c.bytes.clone();
+        }
+        let raw = app.doc.pixels.as_raw();
+        let fresh = (c.w, c.h) != (w, h) || c.pixels.len() != raw.len();
+        if fresh {
+            c.pixels.clone_from(raw);
+            c.tiles = vec![Vec::new(); tile_count(w, h)];
+        }
+        // The byte ranges of a tile's rows.
+        let rows = |(x, y, tw, th): (u32, u32, u32, u32)| (y..y + th).map(move |row| (row * w + x) as usize * 4).map(move |at| at..at + tw as usize * 4);
+        for i in 0..c.tiles.len() {
+            let r = tile_rect(w, h, i);
+            if fresh || rows(r).any(|span| raw[span.clone()] != c.pixels[span]) {
+                let px = cut(raw, w, r);
+                paste(&mut c.pixels, w, r, &px);
+                c.tiles[i] = encode(&px, r.2, r.3);
+            }
+        }
+        (c.w, c.h, c.seen) = (w, h, changes);
+        c.bytes = write(w, h, &c.tiles);
+        c.bytes.clone()
+    })
+}
+
+/// Puts a document into the picture, decoding only the tiles that differ (all of them for a new size), and keeps it
+/// as the app's document. Not a change of this person's, and no step of the app's history.
+fn install(app: &mut SelfPaintApp, bytes: &[u8]) -> Result<(), String> {
+    document(app);
+    let doc = parse(bytes)?;
+    let resized = (doc.w, doc.h) != (app.doc.width(), app.doc.height());
+    let changed = CACHE.with_borrow(|c| {
+        let tiles = doc.tiles.iter().enumerate().filter(|(i, t)| resized || c.tiles[*i] != **t);
+        tiles.map(|(i, t)| {
+            let r = tile_rect(doc.w, doc.h, i);
+            decode(t, r.2, r.3).map(|px| (r, px))
+        })
+        .collect::<Result<Vec<_>, _>>()
+    })?;
+    if resized {
+        app.doc = Document::from_rgba(RgbaImage::new(doc.w, doc.h));
+    }
+    let size = [doc.w as usize, doc.h as usize];
+    let mut texture = app.texture.as_mut().filter(|t| !resized && t.size() == size);
+    for (r, px) in &changed {
+        paste(&mut app.doc.pixels, doc.w, *r, px);
+        // Only the tiles that changed go to the screen.
+        if let Some(t) = texture.as_mut() {
+            t.set_partial([r.0 as usize, r.1 as usize], egui::ColorImage::from_rgba_unmultiplied([r.2 as usize, r.3 as usize], px), egui::TextureOptions::LINEAR);
+        }
+    }
+    if texture.is_none() {
+        app.texture_dirty = true;
+    }
+    if !changed.is_empty() {
+        peers::landed();
+    }
+    CACHE.with_borrow_mut(|c| {
+        if resized {
+            c.pixels.clone_from(app.doc.pixels.as_raw());
+        } else {
+            changed.iter().for_each(|(r, px)| paste(&mut c.pixels, doc.w, *r, px));
+        }
+        c.tiles = doc.tiles.iter().map(|t| t.to_vec()).collect();
+        (c.w, c.h, c.seen) = (doc.w, doc.h, CHANGES.get());
+        c.bytes = bytes.to_vec();
+    });
+    Ok(())
+}
+
+// ---------------------------------------------------------------- the session
+
+/// A remote change waiting for a quiet frame: `edited` relative to `base`, or with no base a whole document.
+struct Remote {
+    base: Option<Vec<u8>>,
+    edited: Vec<u8>,
+    done: Box<dyn FnOnce(Result<Option<Vec<u8>>, String>)>,
+}
+
+#[derive(Default)]
+struct Session {
+    connected: bool,
+    remote: VecDeque<Remote>,
+    /// [`CHANGES`] when the shell was last told.
+    reported: u64,
+    #[cfg(target_arch = "wasm32")]
+    hooks: Option<(js_sys::Function, js_sys::Function)>,
+}
+
+pub fn connected() -> bool {
+    SESSION.with_borrow(|s| s.connected)
+}
+
+/// At the top of the app's Undo and Redo: while connected they go to the session (whether they did).
+pub fn undo(redo: bool) -> bool {
+    #[cfg(target_arch = "wasm32")]
+    if let Some(undo) = SESSION.with_borrow(|s| s.hooks.as_ref().map(|h| h.1.clone())) {
+        let _ = undo.call1(&wasm_bindgen::JsValue::NULL, &redo.into());
+    }
+    let _ = redo;
+    connected()
+}
+
+fn adopt(app: &mut SelfPaintApp, base: Option<&[u8]>, edited: &[u8]) -> Result<Option<Vec<u8>>, String> {
+    let current = document(app);
+    match base {
+        Some(base) => install(app, &merge(base, &current, edited)?).map(|()| None),
+        None => install(app, edited).map(|()| Some(current)),
+    }
+}
+
+/// The end of each frame: once no stroke is under way, the remote changes waiting go in (whether any did: the next
+/// frame shows them) and the shell hears of a change of this person's.
+pub fn frame(app: &mut SelfPaintApp) -> bool {
+    if !connected() || !quiet(app) {
+        return false;
+    }
+    let waiting = SESSION.with_borrow_mut(|s| std::mem::take(&mut s.remote));
+    let adopted = !waiting.is_empty();
+    for remote in waiting {
+        let result = adopt(app, remote.base.as_deref(), &remote.edited);
+        (remote.done)(result);
+    }
+    let changes = CHANGES.get();
+    if SESSION.with_borrow_mut(|s| std::mem::replace(&mut s.reported, changes) != changes) {
+        #[cfg(target_arch = "wasm32")]
+        if let Some(changed) = SESSION.with_borrow(|s| s.hooks.as_ref().map(|h| h.0.clone())) {
+            let _ = changed.call0(&wasm_bindgen::JsValue::NULL);
+        }
+    }
+    adopted
+}
+
+/// The session ended: changes still waiting fail, and the app's own Undo starts again from the picture as it is.
+fn disconnect(app: Option<&mut SelfPaintApp>) {
+    let waiting = SESSION.with_borrow_mut(|s| {
+        s.connected = false;
+        #[cfg(target_arch = "wasm32")]
+        {
+            s.hooks = None;
+        }
+        std::mem::take(&mut s.remote)
+    });
+    for remote in waiting {
+        (remote.done)(Err("Live editing disconnected".into()));
+    }
+    if let Some(app) = app {
+        app.history.clear();
+    }
+    presence::show(Vec::new());
+}
+
+/// The adapter object the shell drives (`shell/live.js`): `format`, `checkpoint()` (throws `busy` mid-stroke),
+/// `merge(base, current, edited)`, `apply(base | null, edited)` (a promise, settled at the next quiet frame; a whole
+/// document resolves to the one it replaced), `connect({ changed, undo })`, `disconnect()`, `presence()` and
+/// `showPresence(others)`; and the web runner and the app wrapped with the session's frame.
+#[cfg(target_arch = "wasm32")]
+pub mod web {
+    use super::{SESSION, SelfPaintApp};
+    use crate::app::web::Web;
+    use eframe::egui;
+    use js_sys::{Function, Object, Promise, Reflect, Uint8Array};
+    use std::cell::OnceCell;
+    use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+    thread_local! {
+        static RUNNER: OnceCell<eframe::WebRunner> = const { OnceCell::new() };
+    }
+
+    /// The page's web runner, kept for the adapter.
+    pub fn runner() -> eframe::WebRunner {
+        RUNNER.with(|kept| kept.get_or_init(eframe::WebRunner::new).clone())
+    }
+
+    /// Runs `f` on the app, unless it is not running or mid-frame (false).
+    fn with_app<T>(f: impl FnOnce(&mut SelfPaintApp) -> T) -> Option<T> {
+        runner().app_mut::<Shell>().map(|mut shell| f(&mut shell.0.0))
+    }
+
+    /// The app eframe runs: the page's app, the presence look's end of frame (repaints while a mark eases), then the
+    /// session's frame; and the adapter offered to the shell.
+    pub fn wrap(web: Web) -> Box<dyn eframe::App> {
+        if let Err(e) = attach() {
+            web_sys::console::warn_1(&format!("SelfPaint: no live editing: {e:?}").into());
+        }
+        Box::new(Shell(web))
+    }
+
+    struct Shell(Web);
+
+    impl eframe::App for Shell {
+        fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+            eframe::App::ui(&mut self.0, ui, frame);
+            super::presence::end_frame(ui.ctx());
+            if super::frame(&mut self.0.0) {
+                ui.ctx().request_repaint();
+            }
+        }
+
+        fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+            eframe::App::clear_color(&self.0, visuals)
+        }
+
+        fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+            Some(self)
+        }
+    }
+
+    fn busy() -> JsValue {
+        "busy".into()
+    }
+
+    fn attach() -> Result<(), JsValue> {
+        let adapter = Object::new();
+        let set = |name: &str, value: JsValue| Reflect::set(&adapter, &name.into(), &value).map(drop);
+        set("format", super::FORMAT.into())?;
+        let checkpoint = || -> Result<Uint8Array, JsValue> {
+            let bytes = with_app(|app| super::quiet(app).then(|| super::document(app))).flatten().ok_or_else(busy)?;
+            Ok(bytes.as_slice().into())
+        };
+        set("checkpoint", Closure::<dyn Fn() -> _>::new(checkpoint).into_js_value())?;
+        let merge = |base: Uint8Array, current: Uint8Array, edited: Uint8Array| -> Result<Uint8Array, JsValue> {
+            let merged = super::merge(&base.to_vec(), &current.to_vec(), &edited.to_vec()).map_err(|e| JsValue::from_str(&e))?;
+            Ok(merged.as_slice().into())
+        };
+        set("merge", Closure::<dyn Fn(_, _, _) -> _>::new(merge).into_js_value())?;
+        let apply = |base: JsValue, edited: Uint8Array| -> Promise {
+            let mut job = Some((base.dyn_ref::<Uint8Array>().map(Uint8Array::to_vec), edited.to_vec()));
+            Promise::new(&mut |resolve, reject| {
+                let Some((base, edited)) = job.take() else { return };
+                let done = Box::new(move |result: Result<Option<Vec<u8>>, String>| {
+                    let _ = match result {
+                        Ok(None) => resolve.call0(&JsValue::NULL),
+                        Ok(Some(replaced)) => resolve.call1(&JsValue::NULL, &Uint8Array::from(replaced.as_slice())),
+                        Err(e) => reject.call1(&JsValue::NULL, &JsValue::from_str(&e)),
+                    };
+                });
+                let refused = SESSION.with_borrow_mut(|s| {
+                    if !s.connected {
+                        return Some(done);
+                    }
+                    s.remote.push_back(super::Remote { base, edited, done });
+                    None
+                });
+                match refused {
+                    Some(done) => done(Err("Live editing is not connected".into())),
+                    None => crate::app::web::repaint(),
+                }
+            })
+        };
+        set("apply", Closure::<dyn Fn(_, _) -> _>::new(apply).into_js_value())?;
+        let connect = |hooks: JsValue| -> Result<(), JsValue> {
+            let get = |name: &str| Reflect::get(&hooks, &name.into())?.dyn_into::<Function>();
+            let hooks = (get("changed")?, get("undo")?);
+            SESSION.with_borrow_mut(|s| (s.connected, s.reported, s.hooks) = (true, 0, Some(hooks)));
+            crate::app::web::repaint();
+            Ok(())
+        };
+        set("connect", Closure::<dyn Fn(_) -> _>::new(connect).into_js_value())?;
+        let disconnect = || {
+            if with_app(|app| super::disconnect(Some(app))).is_none() {
+                super::disconnect(None);
+            }
+        };
+        set("disconnect", Closure::<dyn Fn()>::new(disconnect).into_js_value())?;
+        let presence = || -> Result<JsValue, JsValue> {
+            let state = with_app(|app| super::peers::mine(app)).ok_or_else(busy)?;
+            js_sys::JSON::parse(&state.to_string())
+        };
+        set("presence", Closure::<dyn Fn() -> _>::new(presence).into_js_value())?;
+        let show_presence = |others: JsValue| -> Result<(), JsValue> {
+            let text: String = js_sys::JSON::stringify(&others)?.into();
+            super::presence::show(playground_live::Presence::list(&serde_json::from_str(&text).unwrap_or_default()));
+            crate::app::web::repaint();
+            Ok(())
+        };
+        set("showPresence", Closure::<dyn Fn(_) -> _>::new(show_presence).into_js_value())?;
+        let global = js_sys::global();
+        Reflect::set(&global, &"playgroundLiveAdapter".into(), &adapter)?;
+        let attach = Reflect::get(&global, &"playgroundLive".into()).and_then(|live| Reflect::get(&live, &"attach".into())).ok();
+        if let Some(attach) = attach.and_then(|f| f.dyn_into::<Function>().ok()) {
+            attach.call1(&global, &adapter)?;
+        }
+        Ok(())
+    }
+}
