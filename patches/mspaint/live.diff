@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: MIT
+use super::*;
+use image::Rgba;
+
+#[test]
+fn concurrent_strokes_both_stay_the_later_on_top_and_undo_takes_back_only_its_own() {
+    let (white, red, blue) = (Rgba([255, 255, 255, 255]), Rgba([255, 0, 0, 255]), Rgba([0, 0, 255, 255]));
+    let start = RgbaImage::from_pixel(200, 130, white);
+    let base = document_of(&start);
+    assert_eq!(picture_of(&base).unwrap(), start, "a document reads back as its picture");
+    // Ann paints across row 20 (tile 0), Bob across row 22 and over one of Ann's pixels (tiles 0 and 1): same tile.
+    let mut ann = start.clone();
+    (10..60).for_each(|x| ann.put_pixel(x, 20, red));
+    let mut bob = start.clone();
+    (30..90).for_each(|x| bob.put_pixel(x, 22, blue));
+    bob.put_pixel(40, 20, blue);
+    // Ann's stroke was accepted first; Bob's is placed after it.
+    let merged = merge(&base, &document_of(&bob), &document_of(&ann)).unwrap();
+    let both = picture_of(&merged).unwrap();
+    assert_eq!((both.get_pixel(15, 20), both.get_pixel(80, 22), both.get_pixel(40, 20)), (&red, &blue, &blue));
+    assert_eq!(merged, document_of(&both), "the merge gives the bytes the picture encodes to");
+    // Ann's Undo (the journal: merge(after hers, now, before hers)) takes back her pixels, not Bob's over them.
+    let undone = picture_of(&merge(&document_of(&ann), &merged, &base).unwrap()).unwrap();
+    assert_eq!((undone.get_pixel(15, 20), undone.get_pixel(40, 20), undone.get_pixel(80, 22)), (&white, &blue, &blue));
+    // A new canvas size on one side while the other painted is a conflict; alone, it wins.
+    let resized = document_of(&RgbaImage::from_pixel(64, 64, white));
+    assert!(merge(&base, &resized, &document_of(&ann)).is_err());
+    assert_eq!(merge(&base, &resized, &base).unwrap(), resized);
+    assert!(merge(&base, &base[..base.len() - 1], &base).is_err(), "a cut document is refused");
+}
