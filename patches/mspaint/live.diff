new file mode 100644
index 0000000..f592128
--- /dev/null
+++ b/src/app/live/peers.rs
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: MIT
+//! Presence in a live session. Each person shares their pointer over the picture (in picture pixels, so it lands on
+//! the same spot at anyone's zoom and scroll) and what they are making: the stroke being drawn (its newest points and
+//! brush size), the shape being dragged out, the text being typed. Here, for the others, over the picture: their
+//! stroke in their colour, their shape's outline dashed, their text, then their pointer with their name. Pointers ease
+//! toward their latest place. A finished stroke stays until the picture with it arrives (at most a second).
+//! Everything in a state comes from another person: what doesn't read as numbers in range is skipped. Pointers, name
+//! tags and the easing are the playground-live crate's presence look; strokes, dashed outlines and text are drawn here,
+//! in the person's colour.
+// The painting is web only (its hook is); native tests use the state.
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+use super::super::{DragState, SelfPaintApp};
+use super::{connected, presence};
+use egui::{Color32, FontId, Pos2, Rect, Shape, Stroke, vec2};
+use serde_json::{Value, json};
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+
+/// The newest points of a stroke shared (presence stays under 4 KiB).
+const MAX_POINTS: usize = 150;
+const MAX_TEXT: usize = 300;
+/// How long a finished stroke stays while its picture is on the way, in seconds.
+const LINGER: f64 = 1.0;
+
+/// Someone's stroke as shown here: its points and brush size, when it last changed, and once it is finished, until
+/// when it stays.
+#[derive(Default)]
+struct Mark {
+    stroke: Option<(Vec<[f32; 2]>, f32)>,
+    changed: f64,
+    until: Option<f64>,
+}
+
+thread_local! {
+    /// This person's pointer over the picture and the stroke they are drawing, as of the last frame.
+    static POINTER: Cell<Option<[f32; 2]>> = const { Cell::new(None) };
+    static STROKE: RefCell<Vec<[f32; 2]>> = const { RefCell::new(Vec::new()) };
+    static SHOWN: RefCell<HashMap<String, Mark>> = RefCell::default();
+    /// A remote change went into the picture since the last frame, and when one last did.
+    static LANDED: Cell<bool> = const { Cell::new(false) };
+    static LANDED_AT: Cell<f64> = const { Cell::new(f64::NEG_INFINITY) };
+}
+
+/// To a tenth of a pixel.
+fn r(v: f32) -> f64 {
+    (f64::from(v) * 10.0).round() / 10.0
+}
+
+fn pt(p: impl Into<[f32; 2]>) -> Value {
+    let p = p.into();
+    json!([r(p[0]), r(p[1])])
+}
+
+pub(in super::super) fn mine(app: &SelfPaintApp) -> Value {
+    let mut s = json!({});
+    if let Some(p) = POINTER.get() {
+        s["pointer"] = pt(p);
+    }
+    STROKE.with_borrow(|points| {
+        if !points.is_empty() {
+            s["stroke"] = json!({ "points": points.iter().map(|p| pt(*p)).collect::<Vec<_>>(), "size": r(app.brush_radius() * 2.0) });
+        }
+    });
+    if let Some(p) = &app.shape_preview {
+        s["shape"] = json!({ "kind": p.shape.as_str(), "from": pt(p.start), "to": pt(p.current), "filled": p.filled });
+    }
+    if app.text.editing {
+        let text: String = app.text.draft.chars().take(MAX_TEXT).collect();
+        s["text"] = json!({ "at": pt(app.text.anchor), "text": text, "size": r(app.text_size) });
+    }
+    s
+}
+
+/// A remote change went into the picture: finished strokes have arrived.
+pub(super) fn landed() {
+    LANDED.set(true);
+}
+
+/// A point someone gave, when it is two numbers of a sane size.
+fn point(v: &Value) -> Option<[f32; 2]> {
+    let c = |v: &Value| v.as_f64().filter(|c| c.abs() < 1e5).map(|c| c as f32);
+    Some([c(&v[0])?, c(&v[1])?])
+}
+
+fn size(v: &Value) -> Option<f32> {
+    v.as_f64().filter(|s| (0.0..1000.0).contains(s)).map(|s| s as f32)
+}
+
+fn stroke_of(v: &Value) -> Option<(Vec<[f32; 2]>, f32)> {
+    let points: Vec<_> = v["points"].as_array()?.iter().take(MAX_POINTS * 2).map(point).collect::<Option<_>>()?;
+    (!points.is_empty()).then_some((points, size(&v["size"])?))
+}
+
+/// `c` at 70% over white, opaque (overlapping dabs of a translucent colour would show darker spots).
+fn tint(c: Color32) -> Color32 {
+    let mix = |v: u8| (255.0 - 0.7 * (255.0 - f32::from(v))).round() as u8;
+    Color32::from_rgb(mix(c.r()), mix(c.g()), mix(c.b()))
+}
+
+/// A dashed outline in `color` (the others' shapes and text boxes being made).
+fn dashed(painter: &egui::Painter, points: &[Pos2], color: Color32) {
+    painter.extend(Shape::dashed_line(points, Stroke::new(1.5, color), 4.0, 3.0));
+}
+
+/// In the canvas, after the picture (a line in src/app.rs): notes this person's pointer and stroke, and draws the
+/// others' strokes, shapes, text and pointers.
+pub fn paint(app: &SelfPaintApp, ui: &egui::Ui, painter: &egui::Painter, sheet: Rect) {
+    if !connected() {
+        POINTER.set(None);
+        return;
+    }
+    let zoom = app.view.zoom;
+    let clip = painter.clip_rect();
+    let hover = ui.input(|i| i.pointer.hover_pos()).filter(|p| clip.contains(*p) && ui.ctx().layer_id_at(*p).is_none_or(|l| l.order == egui::Order::Background));
+    POINTER.set(hover.map(|p| [(p.x - sheet.min.x) / zoom, (p.y - sheet.min.y) / zoom]));
+    STROKE.with_borrow_mut(|points| match app.drag {
+        DragState::Stroke { last, .. } => {
+            let p = [last.0, last.1];
+            if points.last().is_none_or(|q| (q[0] - p[0]).hypot(q[1] - p[1]) * zoom >= 1.0) {
+                points.push(p);
+                if points.len() > MAX_POINTS {
+                    points.remove(0);
+                }
+            }
+        }
+        _ => points.clear(),
+    });
+
+    let screen = |p: [f32; 2]| sheet.min + vec2(p[0] * zoom, p[1] * zoom);
+    let now = ui.input(|i| i.time);
+    // Pointers ease in picture pixels (`zoom` points each); a jump farther than a quarter of the canvas goes at once.
+    let far = f64::from(clip.width().max(clip.height()) / 4.0);
+    if LANDED.take() {
+        LANDED_AT.set(now);
+    }
+    let others = presence::others();
+    let mut pointers = Vec::new();
+    SHOWN.with_borrow_mut(|shown| {
+        shown.retain(|id, _| others.iter().any(|o| o.id == *id));
+        for o in &others {
+            let (state, color) = (&o.state, presence::color(o));
+            let mark = shown.entry(o.id.clone()).or_default();
+            match stroke_of(&state["stroke"]) {
+                Some(stroke) => {
+                    if mark.stroke.as_ref() != Some(&stroke) {
+                        mark.changed = now;
+                    }
+                    (mark.stroke, mark.until) = (Some(stroke), None);
+                }
+                // Finished: it stays until a change lands after its last point (the picture with it), at most a
+                // second.
+                None if mark.stroke.is_some() => {
+                    if LANDED_AT.get() > mark.changed || now > *mark.until.get_or_insert(now + LINGER) {
+                        (mark.stroke, mark.until) = (None, None);
+                    } else {
+                        presence::keep_moving();
+                    }
+                }
+                None => {}
+            }
+            if let Some((points, size)) = &mark.stroke {
+                let (line, width, ink) = (points.iter().map(|p| screen(*p)).collect::<Vec<_>>(), (size * zoom).max(2.0), tint(color));
+                painter.add(Shape::line(line.clone(), Stroke::new(width, ink)));
+                for p in line {
+                    painter.circle_filled(p, width / 2.0, ink);
+                }
+            }
+            let shape = &state["shape"];
+            if let (Some(kind), Some(a), Some(b)) = (shape["kind"].as_str(), point(&shape["from"]), point(&shape["to"])) {
+                let (a, b) = (screen(a), screen(b));
+                let r = Rect::from_two_pos(a, b);
+                match kind {
+                    "line" => dashed(painter, &[a, b], color),
+                    "rect" => dashed(painter, &[r.left_top(), r.right_top(), r.right_bottom(), r.left_bottom(), r.left_top()], color),
+                    "ellipse" => {
+                        let ring: Vec<Pos2> = (0..=64).map(|i| i as f32 * std::f32::consts::TAU / 64.0).map(|t| r.center() + vec2(t.cos() * r.width(), t.sin() * r.height()) / 2.0).collect();
+                        dashed(painter, &ring, color);
+                    }
+                    _ => {}
+                }
+            }
+            let text = &state["text"];
+            if let (Some(at), Some(size)) = (point(&text["at"]), size(&text["size"])) {
+                let words: String = text["text"].as_str().unwrap_or_default().chars().take(MAX_TEXT).collect();
+                let galley = painter.layout_no_wrap(words, FontId::proportional((size * zoom).clamp(4.0, 512.0)), tint(color));
+                let box_ = Rect::from_min_size(screen(at), galley.size().max(vec2(8.0, size * zoom))).expand(3.0);
+                painter.galley(screen(at), galley, color);
+                dashed(painter, &[box_.left_top(), box_.right_top(), box_.right_bottom(), box_.left_bottom(), box_.left_top()], color);
+            }
+            let eased = point(&state["pointer"]).and_then(|p| presence::ease(ui.ctx(), &o.id, "pointer", p.map(f64::from), [f64::from(zoom); 2], [far; 2]));
+            if let Some(p) = eased {
+                pointers.push((screen(p.map(|v| v as f32)), color, &o.name));
+            }
+        }
+    });
+    // Pointers over everything of theirs.
+    for (tip, color, name) in pointers {
+        presence::cursor(painter, tip, color, name);
+    }
+}
