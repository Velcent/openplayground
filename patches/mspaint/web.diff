@@ -0,0 +1,9 @@
+# PaintCraft's browser editor for Playground (patches/mspaint.yaml in github.com/daijro/openplayground): the
+# paintcraft-web cdylib on index.html's canvas, the editor only (upstream's Astro site adds its download page).
+# Build with: trunk build --release
+[build]
+target = "index.html"
+public_url = "./"
+filehash = true
+# Upstream's browser packaging profile (Cargo.toml: LTO, one codegen unit, no symbols).
+cargo_profile = "web-release"
diff --git a/apps/paintcraft-web/index.html b/apps/paintcraft-web/index.html
new file mode 100644
index 0000000..953947b
--- /dev/null
+++ b/apps/paintcraft-web/index.html
@@ -0,0 +1,51 @@
+<!doctype html>
+<!-- PaintCraft's browser editor for Playground (patches/mspaint.yaml in github.com/daijro/openplayground): upstream's
+     src/pages/index.astro and src/lib/main.js for trunk. The Japanese and Chinese faces the editor needs before it
+     starts are copied next to the page (upstream's Astro build hashes them into a manifest); the leave warning is
+     Playground's (the app reports its unsaved state to it). -->
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Untitled - PaintCraft</title>
+  <link data-trunk rel="rust" href="Cargo.toml" data-wasm-opt="0" />
+  <link data-trunk rel="css" href="src/styles/global.css" />
+  <link data-trunk rel="copy-file" href="../../assets/fonts/noto-sans-jp/NotoSansJP-Regular.otf" data-target-path="fonts" />
+  <link data-trunk rel="copy-file" href="../../assets/fonts/noto-sans-sc/NotoSansSC-Regular.otf" data-target-path="fonts" />
+  <link data-trunk rel="copy-file" href="../../assets/fonts/noto-sans-jp/LICENSE" data-target-path="fonts/noto-sans-jp" />
+  <link data-trunk rel="copy-file" href="../../assets/fonts/noto-sans-sc/LICENSE" data-target-path="fonts/noto-sans-sc" />
+  <link data-trunk rel="copy-file" href="../../assets/fonts/noto-sans-devanagari/LICENSE" data-target-path="fonts/noto-sans-devanagari" />
+  <link data-trunk rel="copy-file" href="../../assets/fonts/selawik/LICENSE.txt" data-target-path="fonts/selawik" />
+</head>
+<body>
+  <canvas id="paintcraft" aria-label="PaintCraft Classic canvas"></canvas>
+  <div id="loading" role="status">Loading PaintCraft Web…</div>
+  <noscript>PaintCraft Web requires JavaScript and WebAssembly.</noscript>
+  <script type="module">
+    const status = document.getElementById('loading')
+    // trunk's loader sets window.wasmBindings, then says so.
+    const bindings = new Promise((resolve) => window.wasmBindings ? resolve(window.wasmBindings)
+      : addEventListener('TrunkApplicationStarted', () => resolve(window.wasmBindings), { once: true }))
+    const font = async (file) => {
+      const response = await fetch(`fonts/${file}`)
+      if (!response.ok) throw new Error(`${file}: HTTP ${response.status}`)
+      return new Uint8Array(await response.arrayBuffer())
+    }
+    let app
+    try {
+      const [{ WebHandle, install_cjk_fonts }, japanese, chinese] =
+        await Promise.all([bindings, font('NotoSansJP-Regular.otf'), font('NotoSansSC-Regular.otf')])
+      install_cjk_fonts(japanese, chinese)
+      app = new WebHandle()
+      window.paintcraft = app
+      await app.start(document.getElementById('paintcraft'))
+      status.remove()
+      addEventListener('pagehide', (event) => { if (!event.persisted) app.destroy() })
+    } catch (error) {
+      app?.destroy()
+      status.textContent = `PaintCraft could not start. PaintCraft needs WebAssembly and WebGPU or WebGL. ${error}`
+      console.error(error)
+    }
+  </script>
+</body>
+</html>
diff --git a/apps/paintcraft-web/src/paintcraft-web/app/playground.rs b/apps/paintcraft-web/src/paintcraft-web/app/playground.rs
