index 0000000..642d7df
--- /dev/null
+++ b/apps/paintcraft-web/src/paintcraft-web/app/playground.rs
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: MIT
+//! PaintCraft's files in Playground (patches/mspaint.yaml in github.com/daijro/openplayground): Playground's Files
+//! through the page's `globalThis.playgroundFiles` (shell/files.js). wasm only; a child of the app module, so it
+//! reaches the app's state like the app's own methods do.
+//!
+//! Open (after the app's own unsaved-changes question) is Files' Open dialog: projects and pictures in browser storage,
+//! or "From computer…". Save writes the project back to the browser file it came from or was saved to, else asks where
+//! (Files' Save As: browser storage or a download); Export asks each time. Files' "Open in PaintCraft" (and ?open=…)
+//! and files dropped on the page go through the app's Open as well. The leave warning follows the app's unsaved state,
+//! which a project kept in browser storage clears. A page without playgroundFiles keeps upstream's picker and downloads.
+
+use super::{Action, WebApp};
+use crate::files::Loaded;
+use eframe::egui;
+use paintcraft_formats::registry::{Frontend as Profile, Operation, Platform};
+use std::cell::{Cell, OnceCell, RefCell};
+use uuid::Uuid;
+use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+/// What the page finished with, for the app's next frame.
+enum Arrived {
+    /// A file read for Open, and its browser path (None: from the computer or dropped).
+    Opened(Result<Loaded, String>, Option<String>),
+    Cancelled,
+    /// Bytes kept at a browser path; for a project, its session and state (saved there).
+    Saved(String, Option<(Uuid, Uuid)>),
+}
+
+/// A file handed in: name, bytes, browser path.
+type Handed = (String, Vec<u8>, Option<String>);
+
+thread_local! {
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+    static ARRIVED: RefCell<Vec<Arrived>> = const { RefCell::new(Vec::new()) };
+    /// Handed in by Files or a drop, for the app's Open to take ([`HANDED`]), then waiting there ([`STASHED`]) while
+    /// the app asks about unsaved changes.
+    static HANDED: RefCell<Option<Handed>> = const { RefCell::new(None) };
+    static STASHED: RefCell<Option<Handed>> = const { RefCell::new(None) };
+    /// The project's browser file, where Save writes back.
+    static PATH: RefCell<Option<String>> = const { RefCell::new(None) };
+    static UNSAVED: Cell<Option<bool>> = const { Cell::new(None) };
+}
+
+fn arrive(arrived: Arrived) {
+    ARRIVED.with_borrow_mut(|a| a.push(arrived));
+    CTX.with(|c| c.get().map(egui::Context::request_repaint));
+}
+
+fn api() -> Option<JsValue> {
+    js_sys::Reflect::get(&js_sys::global(), &"playgroundFiles".into()).ok().filter(JsValue::is_object)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or the call threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = api()?;
+    let f = js_sys::Reflect::get(&api, &method.into()).ok()?.dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+fn object(fields: &[(&str, JsValue)]) -> JsValue {
+    let o = js_sys::Object::new();
+    for (k, v) in fields {
+        let _ = js_sys::Reflect::set(&o, &(*k).into(), v);
+    }
+    o.into()
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+fn types(exts: &[&str]) -> JsValue {
+    exts.iter().map(|e| JsValue::from_str(e)).collect::<js_sys::Array>().into()
+}
+
+/// Awaits `playgroundFiles[method](args)` without holding up the app, then gives `done` the result (null on failure).
+fn ask(method: &'static str, args: JsValue, done: impl FnOnce(JsValue) + 'static) {
+    let promise = call(method, &[args]).and_then(|p| p.dyn_into::<js_sys::Promise>().ok());
+    wasm_bindgen_futures::spawn_local(async move {
+        let result = match promise {
+            Some(p) => wasm_bindgen_futures::JsFuture::from(p).await.unwrap_or(JsValue::NULL),
+            None => JsValue::NULL,
+        };
+        done(result);
+    });
+}
+
+fn base_name(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// A handed-in file (`{ path, name, bytes }`), as Open reads one.
+fn handed(file: &JsValue) -> Option<Handed> {
+    let name = get(file, "name").as_string()?;
+    let bytes = get(file, "bytes").dyn_into::<js_sys::Uint8Array>().ok()?.to_vec();
+    Some((name, bytes, get(file, "path").as_string()))
+}
+
+fn read((name, bytes, path): Handed, profile: Profile) -> Arrived {
+    Arrived::Opened(crate::files::decode_for_profile(&bytes, name, profile).map_err(|e| e.to_string()), path)
+}
+
+/// The app's Open, once it has asked about unsaved changes: a file handed in, else Files' Open dialog. False when the
+/// page has no playgroundFiles (upstream's picker then).
+pub(crate) fn open(app: &mut WebApp, profile: Profile) -> bool {
+    if let Some(file) = STASHED.take() {
+        app.files.busy = true;
+        arrive(read(file, profile));
+        return true;
+    }
+    if api().is_none() {
+        return false;
+    }
+    app.files.busy = true;
+    let exts = paintcraft_formats::registry::enabled_extensions(profile, Operation::Open, Platform::Web);
+    ask("open", object(&[("types", types(&exts))]), move |v| {
+        let file = v.dyn_ref::<js_sys::Array>().map(|a| a.get(0)).as_ref().and_then(handed);
+        arrive(file.map_or(Arrived::Cancelled, |file| read(file, profile)));
+    });
+    true
+}
+
+/// Where Save and Export put the bytes they would download (files.rs's `download`): a project back to its browser
+/// file, else Files' Save As (which downloads them itself when asked to). `project`: a project's session and state,
+/// marked saved once kept. None when the page has no playgroundFiles (the caller downloads).
+pub(crate) fn save(bytes: &[u8], name: &str, project: Option<(Uuid, Uuid)>) -> Option<Result<(), JsValue>> {
+    api()?;
+    let path = PATH.with_borrow(|p| p.clone()).filter(|p| project.is_some() && base_name(p) == name);
+    if let Some(path) = path {
+        call("write", &[path.as_str().into(), js_sys::Uint8Array::from(bytes).into()]);
+        arrive(Arrived::Saved(path, project));
+        return Some(Ok(()));
+    }
+    let ext = name.rsplit_once('.').map_or("", |(_, ext)| ext);
+    let data = js_sys::Uint8Array::from(bytes);
+    let args = object(&[("name", name.into()), ("types", types(&[ext])), ("bytes", data.clone().into())]);
+    ask("saveAs", args, move |v| {
+        // Kept in browser storage: written there (a download was the page's to make).
+        if let Some(path) = get(&v, "path").as_string() {
+            call("write", &[path.as_str().into(), data.into()]);
+            arrive(Arrived::Saved(path, project));
+        }
+    });
+    Some(Ok(()))
+}
+
+/// Each frame, after the app's: files handed in go to the app's Open, what the page finished with goes in, and the page
+/// hears whether there are unsaved changes.
+pub(crate) fn frame(app: &mut WebApp, ctx: &egui::Context) {
+    if CTX.with(|c| c.set(ctx.clone()).is_ok()) {
+        // Files' "Open in PaintCraft" (and ?open=browser:/…) hands a stored file in.
+        let open = Closure::<dyn Fn(JsValue)>::new(|file: JsValue| {
+            HANDED.set(handed(&file));
+            CTX.with(|c| c.get().map(egui::Context::request_repaint));
+        });
+        call("onOpen", &[open.into_js_value()]);
+        // Upstream's greeting says Save downloads; here it keeps the project in Files.
+        if api().is_some() && app.message.starts_with("Ready - Save downloads") {
+            app.message = "Ready - Save keeps a project copy in Files".into();
+        }
+    }
+    for file in ctx.input_mut(|i| std::mem::take(&mut i.raw.dropped_files)) {
+        wasm_bindgen_futures::spawn_local(async move {
+            if let Ok(bytes) = file.bytes_async().await {
+                HANDED.set(Some((file.path().to_string_lossy().into_owned(), bytes, None)));
+                CTX.with(|c| c.get().map(egui::Context::request_repaint));
+            }
+        });
+    }
+    // The unsaved-changes question was answered Cancel: the file waiting for it is dropped.
+    if app.confirm_replace.is_none() {
+        STASHED.take();
+    }
+    if let Some(file) = HANDED.take() {
+        STASHED.set(Some(file));
+        app.action(ctx, Action::Open);
+    }
+    for arrived in ARRIVED.take() {
+        match arrived {
+            Arrived::Opened(loaded, path) => {
+                app.files.busy = false;
+                match loaded {
+                    Ok(loaded) => {
+                        PATH.set(path);
+                        app.accept_loaded(loaded, ctx);
+                    }
+                    Err(e) => {
+                        app.import_owner = None;
+                        app.message = format!("Open failed: {e}");
+                    }
+                }
+            }
+            Arrived::Cancelled => {
+                app.files.busy = false;
+                app.import_owner = None;
+                app.message = "File dialog cancelled; current document retained".into();
+            }
+            Arrived::Saved(path, project) => {
+                app.message = format!("Saved {} to Files", base_name(&path));
+                // A project of the document still open: it is that file now.
+                if let Some((_, state)) = project.filter(|(owner, _)| *owner == app.editor.session.history_ticket().owner) {
+                    app.editor.session.mark_saved_state(state);
+                    app.name = base_name(&path).to_owned();
+                    app.update_title();
+                    PATH.set(Some(path));
+                }
+            }
+        }
+    }
+    let unsaved = app.unsaved();
+    if UNSAVED.replace(Some(unsaved)) != Some(unsaved) {
+        call("setUnsaved", &[unsaved.into()]);
+    }
+}
