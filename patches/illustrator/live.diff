+//! Live editing in a Playground session: the shell around [`WebShell`] that offers the app to the page and ends each
+//! frame with the session's frame hook. A child of `web`, so it reaches the runner the page keeps (`Host`).
+
+use std::cell::{Cell, RefCell};
+
+use super::WebShell;
+
+thread_local! {
+    /// The page's runner, kept across graphics restarts (the same one starts again).
+    static RUNNER: RefCell<Option<eframe::WebRunner>> = const { RefCell::new(None) };
+    /// The running app's context, to wake for a remote change.
+    static CONTEXT: RefCell<Option<egui::Context>> = const { RefCell::new(None) };
+    static ATTACHED: Cell<bool> = const { Cell::new(false) };
+}
+
+/// The app eframe runs: `shell`, offered to the page for live editing (once: a graphics restart wraps the moved app
+/// again on the same runner).
+pub(super) fn wrap(shell: WebShell) -> Box<dyn eframe::App> {
+    RUNNER.set(Some(shell.host.runner.clone()));
+    if !ATTACHED.replace(true) {
+        let with_app = |f: &mut dyn FnMut(&mut vectorcraft_ui_egui::VectorcraftApp)| {
+            let runner = RUNNER.with_borrow(Clone::clone);
+            runner.and_then(|r| r.app_mut::<Live>().and_then(|mut live| live.0.app.as_mut().map(|app| f(app)))).is_some()
+        };
+        let repaint = || CONTEXT.with_borrow(|ctx| ctx.iter().for_each(egui::Context::request_repaint));
+        if let Err(e) = vectorcraft_ui_egui::playground::attach(with_app, repaint) {
+            log::error!("vectorcraft-web: no live editing: {e:?}");
+        }
+    }
+    Box::new(Live(shell))
+}
+
+struct Live(WebShell);
+
+impl eframe::App for Live {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        CONTEXT.set(Some(ctx.clone()));
+        self.0.logic(ctx, frame);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.0.ui(ui, frame);
+        if let Some(app) = &mut self.0.app {
+            vectorcraft_ui_egui::playground::frame(app, ui);
+        }
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.0.save(storage);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.0.auto_save_interval()
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.0.clear_color(visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        self.0.persist_egui_memory()
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.0.raw_input_hook(ctx, raw_input);
+    }
+}
