index 0000000..cdb11a3
--- /dev/null
+++ b/crates/ui-egui/live/playground.rs
@@ -0,0 +1,391 @@
+//! Live editing in a Playground session (web only): [`playground_live`] is what the page drives.
+//!
+//! The shared document is the open document the session started on, as its JSON with the images' bytes and without
+//! what is this person's: the id counter, the view and Layers rows written at save, the export and print settings. A
+//! remote change replaces that document at a quiet frame and keeps the selection, tools and views, with no native undo
+//! step. New ids come from `playground_live::fresh_id` while connected, so additions at once don't collide.
+//!
+//! Presence: while the shared document is the active one, this person's active artboard (its id), pointer (document
+//! points) and selected objects (ids); the others' are drawn over the canvas in their color at the end of each frame.
+
+#[path = "playground_live.rs"]
+pub mod playground_live;
+
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, HashSet};
+use std::sync::Arc;
+
+use serde_json::Value;
+use vectorcraft_doc::{Document, ImageBlob};
+use vectorcraft_engine::{DocState, Session};
+
+use crate::VectorcraftApp;
+use playground_live::{Live, Presence};
+
+/// Document fields that are this person's, or written at save only: not shared.
+const LOCAL: [&str; 5] = ["next_id", "last_view", "layers_open", "export_settings", "print_setup"];
+
+/// What [`BOUND`] holds once the session's document is none (shared before a document was open): no
+/// [`DocState::uid`] is 0.
+const NO_DOCUMENT: u64 = 0;
+
+/// Image bytes by key, and whether they are a linked image's preview.
+type Images = BTreeMap<String, (Vec<u8>, bool)>;
+
+thread_local! {
+    /// The shared document ([`DocState::uid`]), from the session's first look at it.
+    static BOUND: Cell<Option<u64>> = const { Cell::new(None) };
+    /// A pointer button was down, or a text field had the keyboard, in the last frame.
+    static POINTER: Cell<bool> = const { Cell::new(false) };
+    /// The document last compared: held, so that any change to it makes a new one.
+    static SEEN: RefCell<Option<Arc<Document>>> = const { RefCell::new(None) };
+    /// The others in the session, as the shell last gave them.
+    static OTHERS: RefCell<Vec<Presence>> = const { RefCell::new(Vec::new()) };
+}
+
+/// The end of each frame: draws the others over the canvas, applies the remote changes waiting and reports this
+/// person's, once quiet.
+pub fn frame(app: &mut VectorcraftApp, ui: &egui::Ui) {
+    let ctx = ui.ctx();
+    let typing = ctx.memory(|m| m.focused()).is_some_and(|id| egui::TextEdit::load_state(ctx, id).is_some());
+    POINTER.set(typing || ctx.input(|i| i.pointer.any_down()));
+    draw_presence(app, ui);
+    playground_live::frame(app);
+}
+
+/// Offers live editing to the page: `with_app` runs a closure on the running app (false: none), `repaint` asks for a
+/// frame.
+#[cfg(target_arch = "wasm32")]
+pub fn attach(
+    with_app: impl Fn(&mut dyn FnMut(&mut VectorcraftApp)) -> bool + 'static,
+    repaint: impl Fn() + 'static,
+) -> Result<(), wasm_bindgen::JsValue> {
+    let _ = vectorcraft_doc::playground_ids::FRESH_ID.set(playground_live::fresh_id);
+    playground_live::web::attach::<VectorcraftApp>(concat!("illustrator:1:", env!("CARGO_PKG_VERSION")), with_app, repaint)
+}
+
+/// [`VectorcraftApp::run`]'s first step: Undo and Redo go to the session while it shares the active document.
+pub fn run(app: &VectorcraftApp, id: &str) -> Option<Result<Value, String>> {
+    let redo = match id {
+        "edit.undo" => false,
+        "edit.redo" => true,
+        _ => return None,
+    };
+    let shared = BOUND.get().is_none_or(|uid| app.session.active().is_some_and(|d| d.uid == uid));
+    (shared && playground_live::undo(redo)).then_some(Ok(Value::Null))
+}
+
+/// The shared document, when it is the one on the canvas here.
+fn shown(app: &VectorcraftApp) -> Option<&DocState> {
+    let st = app.session.active().filter(|_| !crate::menus::home_showing(app))?;
+    BOUND.get().is_none_or(|uid| uid == st.uid).then_some(st)
+}
+
+/// The others' pointers (an arrow with their name) and their selected objects' bounds, in their colors, over the
+/// canvas (the last thing drawn in its layer). Their numbers come from other people: what doesn't resolve is skipped.
+fn draw_presence(app: &VectorcraftApp, ui: &egui::Ui) {
+    use egui::{Color32, Shape, Stroke, vec2};
+    OTHERS.with_borrow(|others| {
+        let (Some(st), Some(rect), Some(view)) = (shown(app).filter(|_| !others.is_empty()), app.canvas_rect, app.view()) else {
+            return;
+        };
+        let xf = crate::canvas::Xf::new(rect, view);
+        let painter = ui.painter_at(rect);
+        let symbols = st.doc.symbol_boxes();
+        let pad = 2.0 / xf.zoom;
+        for other in others {
+            let color = Color32::from_rgb(other.color[0], other.color[1], other.color[2]);
+            let ids = other.state["selection"].as_array().into_iter().flatten().take(50).filter_map(Value::as_u64);
+            for bounds in ids.filter_map(|id| st.doc.node(vectorcraft_doc::NodeId(id))?.geometric_bounds_with(&symbols)) {
+                painter.add(Shape::closed_line(xf.quad(bounds.inflate(pad, pad)), Stroke::new(1.5, color)));
+            }
+            let pointer = &other.state["pointer"];
+            let Some(tip) = pointer[0].as_f64().zip(pointer[1].as_f64()).map(|(x, y)| xf.to_screen(vectorcraft_geom::Point::new(x, y))) else {
+                continue;
+            };
+            // NaN, infinite and far-off points fail this.
+            if !(tip.x.abs() < 1e6 && tip.y.abs() < 1e6) {
+                continue;
+            }
+            painter.add(Shape::convex_polygon(vec![tip, tip + vec2(0.0, 15.0), tip + vec2(10.5, 10.5)], color, Stroke::new(1.0, Color32::WHITE)));
+            let name: String = other.name.chars().take(32).collect();
+            if !name.is_empty() {
+                let text = painter.layout_no_wrap(name, egui::FontId::proportional(11.0), Color32::WHITE);
+                let tag = egui::Rect::from_min_size(tip + vec2(8.0, 15.0), text.size() + vec2(8.0, 4.0));
+                painter.rect_filled(tag, 3.0, color);
+                painter.galley(tag.min + vec2(4.0, 2.0), text, Color32::WHITE);
+            }
+        }
+    });
+}
+
+/// The shared document: the bound one, else the active one (bound by `bind`).
+fn shared(app: &VectorcraftApp, bind: bool) -> Option<&DocState> {
+    if bind && BOUND.get().is_none() {
+        BOUND.set(app.session.active().map(|d| d.uid));
+    }
+    match BOUND.get() {
+        Some(uid) => app.session.documents().iter().find(|d| d.uid == uid),
+        None => app.session.active(),
+    }
+}
+
+/// A shared document as a [`Document`] whose id counter is `next_id`, and its images' bytes (which the document keeps
+/// outside its JSON).
+fn decode(mut document: Value, next_id: u64) -> Result<(Document, Images), String> {
+    let o = document.as_object_mut().ok_or("The shared document is not a VectorCraft document")?;
+    let mut bytes = Images::new();
+    if let Some(Value::Object(images)) = o.get_mut("images") {
+        for (k, image) in images.iter_mut() {
+            let data = image.as_object_mut().and_then(|i| i.remove("data"));
+            let data = data.as_ref().and_then(Value::as_str).and_then(vectorcraft_format::base64_decode);
+            let proxy = image.get("proxy") == Some(&Value::Bool(true));
+            bytes.insert(k.clone(), (data.ok_or_else(|| format!("Invalid image data for `{k}`"))?, proxy));
+        }
+    }
+    o.insert("next_id".into(), next_id.into());
+    let doc = serde_json::from_value(document).map_err(|e| format!("Invalid shared document: {e}"))?;
+    Ok((doc, bytes))
+}
+
+impl Live for VectorcraftApp {
+    /// A merged document installs: it reads as a document, with no object in two places (moved into different groups
+    /// by both sides).
+    fn live_check(document: &Value) -> Result<(), String> {
+        let (doc, _) = decode(document.clone(), 1)?;
+        let (mut ids, mut unique) = (HashSet::new(), true);
+        doc.walk(|n| unique &= ids.insert(n.id));
+        if unique { Ok(()) } else { Err("Conflict: an object would be in two places".into()) }
+    }
+
+    fn live_document(&self) -> Value {
+        // Once the shared document is closed here, the last one seen: a change from the others opens it again.
+        let Some(doc) = shared(self, true).map(|st| st.doc.clone()).or_else(|| SEEN.with_borrow(Clone::clone)) else {
+            return Value::Null;
+        };
+        let doc = doc.without_edit_modes();
+        let mut v = serde_json::to_value(&*doc).unwrap_or_default();
+        if let Some(o) = v.as_object_mut() {
+            for k in LOCAL {
+                o.remove(k);
+            }
+            if let Some(Value::Object(images)) = o.get_mut("images") {
+                for (k, blob) in &doc.images {
+                    if let Some(Value::Object(image)) = images.get_mut(k) {
+                        image.insert("data".into(), vectorcraft_format::base64_encode(&blob.bytes).into());
+                        if blob.is_proxy() {
+                            image.insert("proxy".into(), true.into());
+                        }
+                    }
+                }
+            }
+        }
+        v
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        // A session shared before a document was open has none: this person's own document isn't shared (the first
+        // one opened is, without one).
+        if document.is_null() {
+            SEEN.set(None);
+            if BOUND.get().is_some() || self.session.active().is_some() {
+                BOUND.set(Some(NO_DOCUMENT));
+            }
+            return Ok(());
+        }
+        let current = shared(self, true).map(|st| st.doc.clone());
+        let (mut doc, mut bytes) = decode(document, current.as_ref().map_or(1, |d| d.peek_next_id()))?;
+        for (k, blob) in &mut doc.images {
+            let Some((data, proxy)) = bytes.remove(k) else { continue };
+            *blob = match current.as_ref().and_then(|d| d.images.get(k)) {
+                // The same image stays the same blob (its decoded pixels are kept).
+                Some(old) if old.mime == blob.mime && *old.bytes == data => old.clone(),
+                _ => {
+                    let mut new = ImageBlob::new(blob.mime.clone(), data);
+                    new.proxy = proxy.then(|| new.bytes.clone());
+                    new
+                }
+            };
+        }
+        if let Some(d) = &current {
+            (doc.last_view, doc.layers_open) = (d.last_view.clone(), d.layers_open.clone());
+            (doc.export_settings, doc.print_setup) = (d.export_settings.clone(), d.print_setup.clone());
+            // Puppet Warp's pins (the tool's working state).
+            doc.puppet.clone_from(&d.puppet);
+        }
+        doc.fix_next_id();
+        doc.limit_depth();
+        Session::refresh_text_bounds(&mut doc);
+        match BOUND.get().and_then(|uid| self.session.document_mut(uid)) {
+            Some(st) => {
+                st.doc = Arc::new(doc);
+                st.selection.prune(&st.doc);
+                st.revision += 1;
+            }
+            // No document open (or the shared one was closed): it opens.
+            None => {
+                let i = self.session.add_document(doc, None);
+                BOUND.set(self.session.documents().get(i).map(|d| d.uid));
+            }
+        }
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        let editing = |st: &DocState| {
+            st.interaction.is_some() || st.undo_group.is_some() || st.doc.mask_edit.is_some() || st.doc.pattern_edit.is_some()
+        };
+        !POINTER.get() && !self.picks.is_waiting() && self.ime_marked.is_none() && !shared(self, false).is_some_and(editing)
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        if let Some(st) = shared(self, true) {
+            SEEN.set(Some(st.doc.clone()));
+        }
+        SEEN.with_borrow(|d| d.as_ref().map(|d| Arc::as_ptr(d) as usize as u64))
+    }
+
+    fn live_presence(&self) -> Value {
+        let Some(st) = shown(self) else { return Value::Null };
+        let artboard = st.doc.artboards.get(crate::panels::artboards::selected(self, st.doc.artboards.len())).map(|a| a.id);
+        let selection: Vec<u64> = st.selection.objects.iter().take(50).map(|id| id.0).collect();
+        let mut presence = serde_json::json!({ "artboard": artboard, "selection": selection });
+        if let Some(p) = self.hover_doc.filter(|p| p.x.is_finite() && p.y.is_finite()) {
+            let round = |v: f64| (v * 100.0).round() / 100.0;
+            presence["pointer"] = serde_json::json!([round(p.x), round(p.y)]);
+        }
+        presence
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.set(others);
+    }
+
+    fn live_disconnected(&mut self) {
+        // Native Undo starts again from here: its steps are from before the others' changes.
+        if let Some(st) = BOUND.take().and_then(|uid| self.session.document_mut(uid)) {
+            st.history.undo.clear();
+            st.history.redo.clear();
+        }
+        SEEN.set(None);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+
+    use super::*;
+    use super::playground_live::{activity, canonical, connect, disconnect, queue};
+
+    fn app_with_rect() -> VectorcraftApp {
+        let mut app = VectorcraftApp::new(Session::new(), crate::Services::default());
+        app.run("file.new", json!({})).unwrap();
+        app.run("shape.rectangle", json!({"x": 10, "y": 10, "width": 50, "height": 40})).unwrap();
+        app.session
+            .edit("Image", |d, _| {
+                d.images.insert("pic".into(), ImageBlob::png(vec![1, 2, 3]));
+                Ok(())
+            })
+            .unwrap();
+        app
+    }
+
+    #[test]
+    fn the_shared_document_leaves_views_out_and_adopting_one_keeps_them_without_an_undo_step() {
+        let mut app = app_with_rect();
+        let shared = app.live_document();
+        assert!(shared.get("next_id").is_none() && shared["images"]["pic"]["data"] == "AQID");
+        // Views, selection and Layers rows are this person's.
+        app.run("select.all", json!({})).unwrap();
+        let st = app.session.active_mut().unwrap();
+        st.transparency_grid = true;
+        Arc::make_mut(&mut st.doc).export_settings.insert("scale".into(), json!(2));
+        assert_eq!(canonical(&app.live_document()), canonical(&shared), "views don't change the shared document");
+
+        // A remote change: the rectangle renamed and a new layer.
+        let mut remote = shared.clone();
+        remote["layers"][0]["kind"]["children"][0]["name"] = json!("Box");
+        let mut layer = remote["layers"][0].clone();
+        layer["id"] = json!(1u64 << 52);
+        layer["kind"]["children"] = json!([]);
+        remote["layers"].as_array_mut().unwrap().push(layer);
+        let (undo_steps, selected) = {
+            let st = app.session.active().unwrap();
+            (st.history.undo.len(), st.selection.clone())
+        };
+        app.live_adopt(remote.clone()).unwrap();
+        assert_eq!(canonical(&app.live_document()), canonical(&remote));
+        let st = app.session.active().unwrap();
+        assert_eq!(st.history.undo.len(), undo_steps, "no native undo step");
+        assert_eq!(st.selection, selected, "the selection stays");
+        assert!(st.transparency_grid && st.doc.export_settings.contains_key("scale"), "views and settings stay");
+        assert_eq!(*st.doc.images["pic"].bytes, [1, 2, 3]);
+        assert!(st.doc.peek_next_id() > 1 << 52, "new ids come after the remote ones");
+    }
+
+    #[test]
+    fn a_session_without_a_document_shares_none_until_one_comes_and_merges_must_give_documents() {
+        let mut owner = VectorcraftApp::new(Session::new(), crate::Services::default());
+        owner.live_adopt(Value::Null).unwrap();
+        owner.run("file.new", json!({})).unwrap();
+        assert!(!owner.live_document().is_null(), "the first document opened is shared");
+        BOUND.set(None);
+        let mut app = app_with_rect();
+        let doc = app.live_document();
+        // A session shared before its owner opened a document: joining adopts nothing.
+        BOUND.set(None);
+        app.live_adopt(Value::Null).unwrap();
+        assert!(app.live_document().is_null(), "this person's own document isn't shared");
+        assert!(VectorcraftApp::live_check(&Value::Null).is_err());
+        let mut twice = doc.clone();
+        let layer = twice["layers"][0].clone();
+        twice["layers"].as_array_mut().unwrap().push(json!({"id": 9, "kind": {"type": "layer", "color": {"Preset": 1}, "children": [layer]}}));
+        assert!(VectorcraftApp::live_check(&twice).unwrap_err().contains("two places"));
+        // The owner opens one: it opens here too.
+        app.live_adopt(VectorcraftApp::live_merge(&Value::Null, &Value::Null, &doc).unwrap()).unwrap();
+        assert_eq!(app.session.documents().len(), 2);
+        assert_eq!(canonical(&app.live_document()), canonical(&doc));
+    }
+
+    #[test]
+    fn a_remote_change_waits_while_busy_and_undo_goes_to_the_session() {
+        let mut app = app_with_rect();
+        connect();
+        let base = canonical(&app.live_document());
+        let mut remote = app.live_document();
+        remote["title"] = json!("Shared");
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        queue(Some(base), canonical(&remote), Box::new(move |r| to.set(r.is_ok())));
+        app.session.begin_interaction("Move").unwrap();
+        playground_live::frame(&mut app);
+        assert!(!done.get(), "a drag holds remote changes back");
+        app.session.commit_interaction().unwrap();
+        playground_live::frame(&mut app);
+        assert!(done.get());
+        assert_eq!(app.session.active().unwrap().doc.title, "Shared");
+        let undo_steps = app.session.active().unwrap().history.undo.len();
+        app.run("edit.undo", json!({})).unwrap();
+        assert_eq!(activity().1, [false]);
+        assert_eq!(app.session.active().unwrap().history.undo.len(), undo_steps, "native Undo waits");
+        disconnect();
+        app.live_disconnected();
+        assert!(app.session.active().unwrap().history.undo.is_empty(), "native Undo starts again");
+    }
+
+    #[test]
+    fn presence_is_the_pointer_in_document_points_and_the_selection_while_the_shared_document_shows() {
+        let mut app = app_with_rect();
+        app.live_document();
+        app.run("select.all", json!({})).unwrap();
+        app.hover_doc = Some(vectorcraft_geom::Point::new(12.345, 67.0));
