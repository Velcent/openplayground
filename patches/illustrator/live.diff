@@ -0,0 +1,18 @@
+//! Live editing in a Playground session (web only): new ids nobody else in the session picks, so that people adding
+//! objects to one document at once give them different ids.
+
+use crate::{Document, MAX_NEXT_ID, NodeId};
+
+/// Where [`Document::alloc_id`] takes ids from once set (`playground_live::fresh_id`, from the counter).
+pub static FRESH_ID: std::sync::OnceLock<fn(&mut u64) -> u64> = std::sync::OnceLock::new();
+
+impl Document {
+    /// [`Document::alloc_id`]'s id while live editing is offered: none otherwise (the counter as upstream).
+    pub(crate) fn playground_alloc_id(&mut self) -> Option<NodeId> {
+        let fresh = FRESH_ID.get().filter(|_| self.next_id < MAX_NEXT_ID)?;
+        let id = fresh(&mut self.next_id);
+        // The counter stays above every id, as without it ("from the counter on" is new).
+        self.next_id = self.next_id.max(id.saturating_add(1));
+        Some(NodeId(id))
+    }
+}
diff --git a/crates/ui-egui/live/playground.rs b/crates/ui-egui/live/playground.rs
