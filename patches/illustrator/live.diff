+//! Live editing in a Playground session: the others' marks over the canvas, and this person's gesture in progress for
+//! them. A child of `canvas`, so the others' objects are outlined as the canvas outlines its own selection
+//! ([`node_outline`]).
+//!
+//! The shared document changes when a gesture ends (typing aside: it reaches the others as it is typed). Until then a
+//! presence carries the gesture ([`gestures`]), in document points, outlines as flat `[x0, y0, x1, y1, …]` (a closed one
+//! ends where it starts):
+//! - `move`: `{ ids, m }`, objects being moved, scaled, rotated, reflected or sheared (the Selection tool, Free
+//!   Transform, the transform tools): those objects, as the others have them, through the affine `m` so far;
+//! - `ghosts`: the objects another gesture is changing (anchors, reshapes, widths), as they are so far;
+//! - `bands`: the shapes being drawn (the Rectangle, Ellipse, Polygon, Star, Line Segment, grid… tools);
+//! - `strokes` and `width`: what the Pencil, the Paintbrush, the Blob Brush, the Eraser or the Pen is drawing, and its
+//!   width.
+//!
+//! The others' marks are drawn under this person's own selection and tool overlays: ghosts, strokes and bands, then
+//! selection outlines, then pointers with name tags, each in that person's color, easing toward the latest state. The
+//! pointers, colors and easing are the playground-live crate's ([`presence`]); the shapes of objects (ghosts, strokes,
+//! bands, outlines) are VectorCraft's own, drawn here in the kit's colors.
+
+use std::cell::RefCell;
+
+use egui::{Color32, Mesh, Painter, Pos2, Shape, Stroke, pos2};
+use playground_live::{Presence, presence};
+use serde_json::{Value, json};
+use vectorcraft_doc::{Document, Node, NodeId};
+use vectorcraft_engine::DocState;
+use vectorcraft_geom::{Affine, BezPath, PathEl, Point};
+use vectorcraft_tools::Overlay;
+
+use super::Xf;
+use super::outline::{node_outline, stroke_path, to_screen_path, too_many_anchors};
+use crate::VectorcraftApp;
+
+/// The most objects, outlines and selected objects a presence carries, or is drawn with.
+const MAX_ITEMS: usize = 50;
+/// The most outline points a presence carries (the shell sends at most 4 KiB of it).
+pub(crate) const MAX_POINTS: usize = 200;
+/// Remote coordinates this far off (document points), or no numbers, are not drawn.
+const FAR: f64 = 1e7;
+
+thread_local! {
+    /// The Blob Brush's or the Eraser's stroke in progress (only the tool has it until it ends), and its width.
+    static BRUSH: RefCell<Option<(BezPath, f64)>> = const { RefCell::new(None) };
+}
+
+/// Each frame: the Blob Brush's or the Eraser's stroke so far, for [`gestures`].
+pub(crate) fn frame(app: &mut VectorcraftApp) {
+    let brush = matches!(app.session.tool_id(), "blobBrush" | "eraser") && app.session.tool_busy();
+    let stroke = brush.then(|| {
+        let width = app.session.tool_options()["size"].as_f64().unwrap_or(1.0);
+        let view = app.view_info();
+        app.session.overlays(view).into_iter().find_map(|o| if let Overlay::Path { path, .. } = o { Some((path, width)) } else { None })
+    });
+    BRUSH.set(stroke.flatten());
+}
+
+/// This person's gesture in progress on `st` (the shared document, shown here) into `out`, with at most `points`
+/// outline points.
+pub(crate) fn gestures(app: &VectorcraftApp, st: &DocState, points: usize, out: &mut Value) {
+    let zoom = app.view().map_or(1.0, |v| v.zoom).max(1e-6);
+    let mut left = points;
+    if let Some((path, width)) = BRUSH.with_borrow(Clone::clone) {
+        out["strokes"] = flat(rings(&path, zoom), zoom, &mut left, true);
+        out["width"] = fine(width).into();
+        return;
+    }
+    let Some(it) = st.interaction.as_ref().filter(|it| it.label != "Typing") else { return };
+    let Some((cmd, params)) = &it.preview else { return };
+    let anchors = params["anchors"] == true && !it.selection.anchors.is_empty();
+    let m: Option<Vec<f64>> = params["matrix"].as_array().and_then(|m| m.iter().map(Value::as_f64).collect());
+    if let Some(m) = m.filter(|m| cmd == "object.transform" && !anchors && m.len() == 6) {
+        let ids: Vec<u64> = match params["ids"].as_array() {
+            Some(ids) => ids.iter().filter_map(Value::as_u64).take(MAX_ITEMS).collect(),
+            None => it.selection.objects.iter().take(MAX_ITEMS).map(|id| id.0).collect(),
+        };
+        let m: Vec<f64> = m.iter().enumerate().map(|(i, v)| if i < 4 { (v * 1e4).round() / 1e4 } else { fine(*v) }).collect();
+        out["move"] = json!({ "ids": ids, "m": m });
+        return;
+    }
+    let (changed, added) = changes(&it.doc, &st.doc);
+    let symbols = st.doc.symbol_boxes();
+    let outlines = |nodes: &[&Node]| {
+        let mut bp = BezPath::new();
+        nodes.iter().for_each(|n| bp.extend(node_outline(n, &symbols)));
+        rings(&bp, zoom)
+    };
+    let width = || added.iter().chain(&changed).next().map_or(1.0, |n| fine(n.appearance.stroke_width()));
+    match cmd.as_str() {
+        // The Pencil's and the Paintbrush's points as the hand draws them (the path is fitted to them).
+        "path.freehand" | "brush.freehand" => {
+            let p = |p: &Value| Some(Point::new(p[0].as_f64()?, p[1].as_f64()?));
+            let hand: Vec<Point> = params["points"].as_array().into_iter().flatten().filter_map(p).collect();
+            out["strokes"] = flat(vec![hand], zoom, &mut left, true);
+            out["width"] = width().into();
+        }
+        // The Pen's path, anchor by anchor.
+        "path.create" | "path.appendAnchor" | "path.close" | "path.curvature" => {
+            out["strokes"] = flat(outlines(&[added.as_slice(), changed.as_slice()].concat()), zoom, &mut left, true);
+            out["width"] = width().into();
+        }
+        _ => {
+            for (key, nodes) in [("bands", &added), ("ghosts", &changed)].into_iter().filter(|(_, n)| !n.is_empty()) {
+                out[key] = flat(outlines(nodes), zoom, &mut left, false);
+            }
+        }
+    }
+}
+
+/// The objects a gesture changed in `now` since `before` (its snapshot), the outermost changed, and those it added;
+/// [`MAX_ITEMS`] at most.
+fn changes<'a>(before: &Document, now: &'a Document) -> (Vec<&'a Node>, Vec<&'a Node>) {
+    fn walk<'a>(before: &Document, old: &[std::sync::Arc<Node>], new: &'a [std::sync::Arc<Node>], out: &mut (Vec<&'a Node>, Vec<&'a Node>)) {
+        for (i, n) in new.iter().enumerate() {
+            if out.0.len() + out.1.len() >= MAX_ITEMS {
+                return;
+            }
+            let was = old.get(i).filter(|o| o.id == n.id).map(|o| &**o).or_else(|| before.node(n.id));
+            match was {
+                None => out.1.push(n),
+                Some(o) if std::ptr::eq(o, &**n) => {}
+                Some(o) => {
+                    let found = out.0.len() + out.1.len();
+                    if let (Some(oc), Some(nc)) = (o.children(), n.children()) {
+                        walk(before, oc, nc, out);
+                    }
+                    // A layer is no object; a group none of whose objects changed changed itself.
+                    if out.0.len() + out.1.len() == found && !n.is_layer() {
+                        out.0.push(n);
+                    }
+                }
+            }
+        }
+    }
+    let mut out = (Vec::new(), Vec::new());
+    walk(before, &before.layers, &now.layers, &mut out);
+    out
+}
+
+/// `bp` flattened (to a tenth of a pixel at `zoom`) into polylines of document points, a closed one ending where it
+/// starts.
+fn rings(bp: &BezPath, zoom: f64) -> Vec<Vec<Point>> {
+    let mut out: Vec<Vec<Point>> = Vec::new();
+    vectorcraft_geom::flatten(bp.elements().iter().copied(), 0.1 / zoom, &mut |el| match el {
+        PathEl::MoveTo(p) => out.push(vec![p]),
+        PathEl::LineTo(p) => out.last_mut().into_iter().for_each(|r| r.push(p)),
+        PathEl::ClosePath => out.last_mut().into_iter().filter(|r| r.last() != r.first()).for_each(|r| r.push(r[0])),
+        _ => {}
+    });
+    out
+}
+
+/// `rings` as flat `[x0, y0, …]` arrays: each point a pixel (at `zoom`) or more from the one before, at most `left`
+/// points in all (it goes down by what they take), the newest (`newest`, the last ones) or the first when cut.
+fn flat(rings: Vec<Vec<Point>>, zoom: f64, left: &mut usize, newest: bool) -> Value {
+    let mut rings: Vec<Vec<Point>> = rings
+        .into_iter()
+        .map(|r| {
+            let mut kept: Vec<Point> = Vec::new();
+            for (i, p) in r.iter().enumerate() {
+                if kept.last().is_none_or(|q| q.distance(*p) * zoom >= 1.0 || i + 1 == r.len()) {
+                    kept.push(*p);
+                }
+            }
+            kept
+        })
+        .filter(|r| r.len() >= 2)
+        .collect();
+    if newest {
+        rings.reverse();
+    }
+    let mut out = Vec::new();
+    for mut r in rings.into_iter().take(MAX_ITEMS) {
+        if *left < 2 {
+            break;
+        }
+        if r.len() > *left {
+            match newest {
+                true => drop(r.drain(..r.len() - *left)),
+                false => r.truncate(*left),
+            }
+        }
+        *left -= r.len();
+        out.push(r.iter().flat_map(|p| [fine(p.x), fine(p.y)]).collect::<Vec<f64>>());
+    }
+    if newest {
+        out.reverse();
+    }
+    json!(out)
+}
+
+/// `x` in hundredths: finer than a pixel up to 100× zoom, and short in JSON.
+pub(crate) fn fine(x: f64) -> f64 {
+    (x * 100.0).round() / 100.0
+}
+
+/// A remote point, unless it is no number or too far off.
+fn point(x: &Value, y: &Value) -> Option<Point> {
+    let (x, y) = (x.as_f64()?, y.as_f64()?);
+    (x.abs() < FAR && y.abs() < FAR).then(|| Point::new(x, y))
+}
+
+/// Remote outlines (flat `[x0, y0, …]` arrays); one with a point that is no number or too far off is skipped.
+fn lines(v: &Value) -> Vec<Vec<Point>> {
+    let line = |l: &Value| -> Option<Vec<Point>> { l.as_array()?.chunks_exact(2).map(|c| point(&c[0], &c[1])).collect() };
+    v.as_array().into_iter().flatten().take(MAX_ITEMS).filter_map(line).filter(|l| l.len() >= 2).collect()
+}
+
+/// The box around `lines`, as `[x0, y0, x1, y1]`.
+fn bounds(lines: &[Vec<Point>]) -> Option<[f64; 4]> {
+    let mut points = lines.iter().flatten();
+    let first = points.next()?;
+    Some(points.fold([first.x, first.y, first.x, first.y], |b, p| [b[0].min(p.x), b[1].min(p.y), b[2].max(p.x), b[3].max(p.y)]))
+}
+
+/// The affine taking box `from` onto box `to`; a side with no extent keeps its size.
+fn fit(from: [f64; 4], to: [f64; 4]) -> Affine {
+    let scale = |a: f64, b: f64| if a > 1e-9 { b / a } else { 1.0 };
+    let (sx, sy) = (scale(from[2] - from[0], to[2] - to[0]), scale(from[3] - from[1], to[3] - to[1]));
+    Affine::translate((to[0], to[1])) * Affine::scale_non_uniform(sx, sy) * Affine::translate((-from[0], -from[1]))
+}
+
+/// The others on the document shown here, over the canvas (after the art, before this person's selection and tool
+/// overlays): their gestures in progress, their selected objects, their pointers with their names. Remote numbers that
+/// do not resolve or fit are skipped.
+pub(crate) fn draw(app: &VectorcraftApp, ctx: &egui::Context, painter: &Painter, xf: &Xf) {
+    let Some((st, doc)) = crate::playground::shown(app) else { return };
+    let others: Vec<Presence> = presence::others().into_iter().filter(|o| o.state["doc"].as_u64() == Some(doc)).collect();
+    if others.is_empty() {
+        return;
+    }
+    let symbols = st.doc.symbol_boxes();
+    let far = f64::from(xf.rect.width().min(xf.rect.height())) / 4.0;
+    let px = xf.zoom;
+    for o in &others {
+        let (color, state) = (presence::color(o), &o.state);
+        // Objects moved: as the others have them, through the affine so far (other objects: it starts again).
+        let ids: Vec<u64> = state["move"]["ids"].as_array().into_iter().flatten().take(MAX_ITEMS).filter_map(Value::as_u64).collect();
+        let m: Option<Vec<f64>> = state["move"]["m"].as_array().and_then(|m| m.iter().map(Value::as_f64).collect());
+        let m = m.and_then(|m| <[f64; 6]>::try_from(m).ok()).filter(|m| m.iter().all(|v| v.abs() < FAR));
+        let nodes: Vec<&Node> = ids.iter().filter_map(|id| st.doc.node(NodeId(*id))).collect();
+        let size = nodes.iter().filter_map(|n| n.geometric_bounds_with(&symbols)).fold(1.0, |s: f64, b| s.max(b.width()).max(b.height()));
+        if let Some(m) = m.filter(|_| !nodes.is_empty()).and_then(|m| presence::ease(ctx, &o.id, &format!("move {ids:?}"), m, [size * px, size * px, size * px, size * px, px, px], [far; 6])) {
+            let boxes = too_many_anchors(nodes.iter().copied());
+            for n in nodes {
+                let mut outline = match boxes {
+                    true => n.geometric_bounds_with(&symbols).map(|b| vectorcraft_geom::shapes::rectangle(b).to_bezpath()).unwrap_or_default(),
+                    false => node_outline(n, &symbols),
+                };
+                outline.apply_affine(Affine::new(m));
+                ghost(painter, to_screen_path(&outline, xf), color);
+            }
+        }
+        // Ghosts and bands: drawn into their box as it eases.
+        let (ghosts, bands) = (lines(&state["ghosts"]), lines(&state["bands"]));
+        let target = bounds(&[ghosts.as_slice(), bands.as_slice()].concat());
+        let frame = target.and_then(|t| presence::ease(ctx, &o.id, "frame", t, [px; 4], [far; 4]));
+        if let Some((from, to)) = target.zip(frame) {
+            let at = fit(from, to);
+            let screen = |l: &Vec<Point>| l.iter().map(|p| xf.to_screen(at * *p)).collect::<Vec<Pos2>>();
+            ghost(painter, ghosts.iter().map(screen).collect(), color);
+            for band in bands.iter().map(screen) {
+                painter.extend(Shape::dashed_line(&band, Stroke::new(1.5, color), 4.0, 3.0));
+            }
+        }
+        // Strokes: their newest point eases.
+        let mut strokes = lines(&state["strokes"]);
+        let head = strokes.last().and_then(|l| l.last()).and_then(|p| presence::ease(ctx, &o.id, "head", [p.x, p.y], [px; 2], [far; 2]));
+        if let (Some(last), Some([x, y])) = (strokes.last_mut().and_then(|l| l.last_mut()), head) {
+            *last = Point::new(x, y);
+        }
+        let width = state["width"].as_f64().filter(|w| *w > 0.0 && *w < FAR).unwrap_or(1.0);
+        for l in &strokes {
+            stroke(painter, l.iter().map(|p| xf.to_screen(*p)).collect(), (width * px).clamp(2.0, 400.0) as f32, color);
+        }
+    }
+    // Selected objects, outlined as the canvas outlines its own selection.
+    for o in &others {
+        let ids = o.state["selection"].as_array().into_iter().flatten().take(MAX_ITEMS).filter_map(Value::as_u64);
+        let nodes: Vec<&Node> = ids.filter_map(|id| st.doc.node(NodeId(id))).collect();
+        let boxes = too_many_anchors(nodes.iter().copied());
+        for n in nodes {
+            let outline = match boxes {
+                true => n.geometric_bounds_with(&symbols).map(|b| vectorcraft_geom::shapes::rectangle(b).to_bezpath()),
+                false => Some(node_outline(n, &symbols)),
+            };
+            outline.into_iter().for_each(|bp| stroke_path(painter, &bp, xf, Stroke::new(2.0, presence::color(o))));
+        }
+    }
+    // Pointers, with their names.
+    for o in &others {
+        let target = point(&o.state["pointer"][0], &o.state["pointer"][1]).map(|p| [p.x, p.y]);
+        if let Some([x, y]) = target.and_then(|t| presence::ease(ctx, &o.id, "pointer", t, [px; 2], [far; 2])) {
+            presence::cursor(painter, xf.to_screen(Point::new(x, y)), presence::color(o), &o.name);
+        }
+    }
+}
+
+/// Outlines being moved or changed (screen points): the closed ones filled with `color` at 28%, all edged at 85%.
+fn ghost(painter: &Painter, rings: Vec<Vec<Pos2>>, color: Color32) {
+    let closed = |r: &&Vec<Pos2>| r.len() > 3 && r.first() == r.last();
+    fill(painter, rings.iter().filter(closed), color.gamma_multiply(0.28));
+    let edge = Stroke::new(1.5, color.gamma_multiply(0.85));
+    for r in rings {
+        match closed(&&r) {
+            true => painter.add(Shape::closed_line(r[..r.len() - 1].to_vec(), edge)),
+            false => painter.add(Shape::line(r, edge)),
+        };
+    }
+}
+
+/// The inside of closed polylines (screen points, even-odd), in rows a point high across what the painter shows.
+fn fill<'a>(painter: &Painter, rings: impl Iterator<Item = &'a Vec<Pos2>>, color: Color32) {
+    let edges: Vec<(Pos2, Pos2)> = rings.flat_map(|r| r.windows(2).map(|w| (w[0], w[1]))).collect();
+    // ponytail: every edge per row; an active-edge table if ghosts of huge selections get slow.
+    if edges.is_empty() || edges.len() > 4_000 {
+        return;
+    }
+    let clip = painter.clip_rect();
+    let (top, bottom) = edges.iter().fold((f32::MAX, f32::MIN), |(t, b), (p, q)| (t.min(p.y).min(q.y), b.max(p.y).max(q.y)));
+    let (mut y, bottom) = (top.max(clip.top()).floor() + 0.5, bottom.min(clip.bottom()));
+    let (mut mesh, mut xs) = (Mesh::default(), Vec::new());
+    while y < bottom {
+        xs.clear();
+        xs.extend(edges.iter().filter(|(p, q)| (p.y <= y) != (q.y <= y)).map(|(p, q)| p.x + (y - p.y) / (q.y - p.y) * (q.x - p.x)));
+        xs.sort_by(f32::total_cmp);
+        for span in xs.chunks_exact(2) {
+            let (x0, x1) = (span[0].max(clip.left()), span[1].min(clip.right()));
+            if x1 > x0 {
+                mesh.add_colored_rect(egui::Rect::from_min_max(pos2(x0, y - 0.5), pos2(x1, y + 0.5)), color);
+            }
+        }
+        y += 1.0;
+    }
+    painter.add(mesh);
+}
+
+/// A stroke being drawn (screen points): `color` at 70%, `width` wide, with round ends.
+fn stroke(painter: &Painter, line: Vec<Pos2>, width: f32, color: Color32) {
+    let color = color.gamma_multiply(0.7);
+    let ends = [(line[0], line[1]), (line[line.len() - 1], line[line.len() - 2])];
+    painter.add(Shape::line(line, Stroke::new(width, color)));
+    for (end, next) in ends {
+        let d = (end - next).normalized();
+        if d.is_finite() && width > 3.0 {
+            let half = (0..=12).map(|i| std::f32::consts::PI * i as f32 / 12.0);
+            painter.add(Shape::convex_polygon(half.map(|a| end + (d.rot90() * a.cos() + d * a.sin()) * width / 2.0).collect(), color, Stroke::NONE));
+        }
+    }
+}
+
+/// Dots on tab `i` (`rect`) in the colors of the others on its document.
+pub(crate) fn tab(app: &VectorcraftApp, ui: &egui::Ui, i: usize, rect: egui::Rect) {
+    let Some(doc) = app.session.documents().get(i).and_then(|d| crate::playground::session_id(d.uid)) else { return };
+    let here: Vec<Presence> = presence::others().into_iter().filter(|o| o.state["doc"].as_u64() == Some(doc)).take(8).collect();
+    let left = rect.center().x - 4.0 * (here.len().max(1) - 1) as f32;
+    for (k, o) in here.iter().enumerate() {
+        ui.painter().circle(pos2(left + 8.0 * k as f32, rect.bottom() - 5.0), 3.0, presence::color(o), Stroke::new(1.0, Color32::WHITE));
+    }
+}
+
+/// Home's "In this session": the session's documents closed here, a row each that opens it again.
+pub(crate) fn home(app: &mut VectorcraftApp, ui: &mut egui::Ui) {
+    let closed = crate::playground::closed();
+    if closed.is_empty() {
+        return;
+    }
+    let t = crate::theme::Tokens::get(ui.ctx());
+    ui.add_space(28.0);
+    ui.label(egui::RichText::new("In this session").font(crate::theme::semibold(14.0)).color(t.text));
+    ui.add_space(8.0);
+    for (id, name) in closed {
+        ui.horizontal(|ui| {
+            crate::icons::icon(ui, "globe", 16.0, t.icon);
+            if ui.add(egui::Button::new(egui::RichText::new(&name).color(t.accent).size(13.0)).frame(false)).clicked() {
+                crate::playground::reopen(app, id);
+            }
+        });
+    }
+}
