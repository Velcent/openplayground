+/// Offer live editing to the page (a Playground session): on the app the runner has, while it has one.
+fn attach_live(host: &Host) {
+    let (runner, pasted) = (host.runner.clone(), host.pasted.clone());
+    let attached = vectorcraft_ui_egui::live::attach(
+        move |f| runner.app_mut::<WebShell>().and_then(|mut shell| shell.app.as_mut().map(|app| f(app))).is_some(),
+        move || {
+            if let Some(ctx) = pasted.try_borrow().ok().and_then(|p| p.ctx.clone()) {
+                ctx.request_repaint();
+            }
+        },
+    );
+    if let Err(e) = attached {
+        log::error!("vectorcraft-web: no live editing: {}", js_err(e));
+    }
+}
