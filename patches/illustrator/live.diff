+++ b/crates/ui-egui/live/playground.rs
@@ -0,0 +1,562 @@
+//! Live editing in a Playground session (web only): [`playground_live`] is what the page drives.
+//!
+//! The shared document is the set of documents open in the session, `{ "documents": [{ "id", "name", … }] }`: each one
+//! as its JSON with its images' bytes and without what is this person's (the id counter, the view and Layers rows
+//! written at save, the export and print settings), under an id of its own in the session and its title. The owner
+//! shares the documents open when the session starts; one anyone opens or creates while connected joins them, and opens
+//! for the others as a tab they are not switched to (someone joining is switched to the session's first). Closing a tab
+//! hides that document here only: changes to it are kept, and Home lists it to open again. A remote change installs at
+//! a quiet frame and keeps this person's selection, tools and views, with no native undo step. New ids come from
+//! `playground_live::fresh_id` while connected, so additions at once don't collide.
+//!
+//! Presence: on one of the session's documents, which one (`doc`, its id in the session), the active artboard (its id),
+//! the pointer (document points), the selected objects (ids) and the gesture in progress; the canvas draws the others
+//! on the same document, and the tabs show dots for the others on theirs (`canvas::playground_presence`).
+//!
+//! Typing goes to the others as it is typed: the Type tool's typing (one interaction while the caret stays) counts as
+//! quiet, and a remote change keeps it first, as Undo does; the next key goes on in a new step.
+//!
+//! The session and the presence look are the playground-live crate's (patches/live/kit); this module maps VectorCraft's
+//! documents to them.
+
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, HashSet};
+use std::hash::{Hash, Hasher};
+use std::sync::Arc;
+
+use serde_json::{Value, json};
+use vectorcraft_doc::{Document, ImageBlob};
+use vectorcraft_engine::{DocState, Session};
+
+use crate::VectorcraftApp;
+use crate::canvas::playground_presence::{MAX_POINTS, fine, gestures};
+use playground_live::{Live, Presence, presence};
+
+/// Document fields that are this person's, or written at save only: not shared.
+const LOCAL: [&str; 5] = ["next_id", "last_view", "layers_open", "export_settings", "print_setup"];
+
+/// Image bytes by key, and whether they are a linked image's preview.
+type Images = BTreeMap<String, (Vec<u8>, bool)>;
+
+/// One of the session's documents.
+struct Entry {
+    /// Its id in the session.
+    id: u64,
+    /// The open document showing it here ([`DocState::uid`]); none once closed here.
+    uid: Option<u64>,
+    /// It as last seen here (as last received, while closed here).
+    doc: Arc<Document>,
+    /// `doc` (by address) and the digest of its shared form, as last reported: the same one adopted installs nothing.
+    reported: Option<(usize, u64)>,
+}
+
+thread_local! {
+    /// The session's documents, from its first look at this person's.
+    static DOCS: RefCell<Option<Vec<Entry>>> = const { RefCell::new(None) };
+    /// The newest [`DocState::uid`] open here when the session's documents were last brought up to date: a document
+    /// opened after that joins them.
+    static OPENED: Cell<u64> = const { Cell::new(0) };
+    /// A change from the session was installed (the first switches someone joining to the session's documents).
+    static JOINED: Cell<bool> = const { Cell::new(false) };
+    /// The next of the session's document ids, natively (tests).
+    #[cfg(not(target_arch = "wasm32"))]
+    static NEXT: Cell<u64> = const { Cell::new(1) };
+}
+
+/// The end of each frame: the presence look's (name tags in VectorCraft's semibold), then applies the remote changes
+/// waiting and reports this person's, once quiet.
+pub fn frame(app: &mut VectorcraftApp, ui: &egui::Ui) {
+    presence::set_font(crate::theme::semibold(12.0));
+    presence::end_frame(ui.ctx());
+    crate::canvas::playground_presence::frame(app);
+    playground_live::frame(app);
+}
+
+/// Offers live editing to the page: `with_app` runs a closure on the running app (false: none), `repaint` asks for a
+/// frame.
+#[cfg(target_arch = "wasm32")]
+pub fn attach(
+    with_app: impl Fn(&mut dyn FnMut(&mut VectorcraftApp)) -> bool + 'static,
+    repaint: impl Fn() + 'static,
+) -> Result<(), wasm_bindgen::JsValue> {
+    let _ = vectorcraft_doc::playground_ids::FRESH_ID.set(playground_live::fresh_id);
+    playground_live::web::attach::<VectorcraftApp>(concat!("illustrator:1:", env!("CARGO_PKG_VERSION")), with_app, repaint)
+}
+
+/// [`VectorcraftApp::run`]'s first step: Undo and Redo go to the session, unless the active document is this person's
+/// own (not one of the session's).
+pub fn run(app: &VectorcraftApp, id: &str) -> Option<Result<Value, String>> {
+    let redo = match id {
+        "edit.undo" => false,
+        "edit.redo" => true,
+        _ => return None,
+    };
+    let own = app.session.active().is_some_and(|d| DOCS.with_borrow(Option::is_some) && session_id(d.uid).is_none());
+    (!own && playground_live::undo(redo)).then_some(Ok(Value::Null))
+}
+
+/// The session's id of open document `uid`, when it is one of the session's documents.
+pub(crate) fn session_id(uid: u64) -> Option<u64> {
+    DOCS.with_borrow(|docs| docs.iter().flatten().find(|e| e.uid == Some(uid)).map(|e| e.id))
+}
+
+/// The session's document on the canvas here, and its id in the session.
+pub(crate) fn shown(app: &VectorcraftApp) -> Option<(&DocState, u64)> {
+    let st = app.session.active().filter(|_| !crate::menus::home_showing(app))?;
+    Some((st, session_id(st.uid)?))
+}
+
+/// The session's documents closed here: (id, title), for Home.
+pub(crate) fn closed() -> Vec<(u64, String)> {
+    DOCS.with_borrow(|docs| docs.iter().flatten().filter(|e| e.uid.is_none()).map(|e| (e.id, e.doc.title.clone())).collect())
+}
+
+/// Opens the session's document `id` again (closed here), and shows it.
+pub(crate) fn reopen(app: &mut VectorcraftApp, id: u64) {
+    let Some(doc) = DOCS.with_borrow(|docs| docs.iter().flatten().find(|e| e.id == id && e.uid.is_none()).map(|e| e.doc.clone())) else {
+        return;
+    };
+    let i = app.session.add_document(Arc::unwrap_or_clone(doc), None);
+    let st = &app.session.documents()[i];
+    DOCS.with_borrow_mut(|docs| {
+        if let Some(e) = docs.iter_mut().flatten().find(|e| e.id == id) {
+            (e.uid, e.doc) = (Some(st.uid), st.doc.clone());
+        }
+    });
+    app.ui.home = None;
+    app.sync_views();
+}
+
+/// The session's documents brought up to date with the ones open here: at the session's first look all of them (the
+/// owner's; someone joining has theirs replaced by the session's), then each one opened since. A closed one keeps its
+/// last state.
+fn sync(app: &VectorcraftApp) {
+    let open = app.session.documents();
+    DOCS.with_borrow_mut(|docs| {
+        let all = docs.is_none();
+        let docs = docs.get_or_insert_with(Vec::new);
+        for e in docs.iter_mut() {
+            e.uid = e.uid.filter(|uid| open.iter().any(|d| d.uid == *uid));
+        }
+        for st in open {
+            match docs.iter_mut().find(|e| e.uid == Some(st.uid)) {
+                Some(e) => e.doc = st.doc.clone(),
+                None if all || st.uid > OPENED.get() => {
+                    docs.push(Entry { id: new_id(), uid: Some(st.uid), doc: st.doc.clone(), reported: None });
+                }
+                None => {}
+            }
+        }
+    });
+    OPENED.set(open.iter().map(|d| d.uid).fold(OPENED.get(), u64::max));
+}
+
+/// A new id for one of the session's documents: 2^52 and 52 random bits in the browser (a page looks at its documents
+/// before it connects, so a count would repeat another person's), counted natively.
+fn new_id() -> u64 {
+    #[cfg(target_arch = "wasm32")]
+    let id = (1 << 52) | (js_sys::Math::random() * (1u64 << 52) as f64) as u64;
+    #[cfg(not(target_arch = "wasm32"))]
+    let id = NEXT.with(|n| n.replace(n.get() + 1));
+    id
+}
+
+/// Document `doc` as the session shares it, as its document `id`.
+fn project(doc: &Document, id: u64) -> Value {
+    let doc = doc.without_edit_modes();
+    let mut v = serde_json::to_value(&*doc).unwrap_or_default();
+    if let Some(o) = v.as_object_mut() {
+        for k in LOCAL {
+            o.remove(k);
+        }
+        if let Some(Value::Object(images)) = o.get_mut("images") {
+            for (k, blob) in &doc.images {
+                if let Some(Value::Object(image)) = images.get_mut(k) {
+                    image.insert("data".into(), vectorcraft_format::base64_encode(&blob.bytes).into());
+                    if blob.is_proxy() {
+                        image.insert("proxy".into(), true.into());
+                    }
+                }
+            }
+        }
+        o.insert("id".into(), id.into());
+        o.insert("name".into(), doc.title.clone().into());
+    }
+    v
+}
+
+/// The digest of a shared document.
+fn digest(v: &Value) -> u64 {
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    playground_live::canonical(v).hash(&mut hasher);
+    hasher.finish()
+}
+
+/// The session's documents in a shared value: (id, document).
+fn documents(v: &Value) -> Result<Vec<(u64, Value)>, String> {
+    let list = v["documents"].as_array().ok_or("The shared document is not a set of VectorCraft documents")?;
+    list.iter().map(|d| Ok((d["id"].as_u64().ok_or("A shared document has no id")?, d.clone()))).collect()
+}
+
+/// One of the session's documents as a [`Document`] whose id counter is `next_id`, and its images' bytes (which the
+/// document keeps outside its JSON).
+fn decode(mut document: Value, next_id: u64) -> Result<(Document, Images), String> {
+    let o = document.as_object_mut().ok_or("The shared document is not a VectorCraft document")?;
+    // Its id and name in the session are not the document's (it would keep keys it does not know).
+    o.remove("id");
+    o.remove("name");
+    let mut bytes = Images::new();
+    if let Some(Value::Object(images)) = o.get_mut("images") {
+        for (k, image) in images.iter_mut() {
+            let data = image.as_object_mut().and_then(|i| i.remove("data"));
+            let data = data.as_ref().and_then(Value::as_str).and_then(vectorcraft_format::base64_decode);
+            let proxy = image.get("proxy") == Some(&Value::Bool(true));
+            bytes.insert(k.clone(), (data.ok_or_else(|| format!("Invalid image data for `{k}`"))?, proxy));
+        }
+    }
+    o.insert("next_id".into(), next_id.into());
+    let doc = serde_json::from_value(document).map_err(|e| format!("Invalid shared document: {e}"))?;
+    Ok((doc, bytes))
+}
+
+/// One of the session's documents, `value`, as the next state of `current` (none: new here): this person's settings
+/// kept, and the images that did not change kept as they were.
+fn install(value: Value, current: Option<&Document>) -> Result<Document, String> {
+    let (mut doc, mut bytes) = decode(value, current.map_or(1, Document::peek_next_id))?;
+    for (k, blob) in &mut doc.images {
+        let Some((data, proxy)) = bytes.remove(k) else { continue };
+        *blob = match current.and_then(|d| d.images.get(k)) {
+            // The same image stays the same blob (its decoded pixels are kept).
+            Some(old) if old.mime == blob.mime && *old.bytes == data => old.clone(),
+            _ => {
+                let mut new = ImageBlob::new(blob.mime.clone(), data);
+                new.proxy = proxy.then(|| new.bytes.clone());
+                new
+            }
+        };
+    }
+    if let Some(d) = current {
+        (doc.last_view, doc.layers_open) = (d.last_view.clone(), d.layers_open.clone());
+        (doc.export_settings, doc.print_setup) = (d.export_settings.clone(), d.print_setup.clone());
+        // Puppet Warp's pins (the tool's working state).
+        doc.puppet.clone_from(&d.puppet);
+    }
+    doc.fix_next_id();
+    doc.limit_depth();
+    Session::refresh_text_bounds(&mut doc);
+    Ok(doc)
+}
+
+impl Live for VectorcraftApp {
+    /// A merged set installs: documents with ids of their own, each reading as a document with no object in two places
+    /// (moved into different groups by both sides).
+    fn live_check(document: &Value) -> Result<(), String> {
+        let mut ids = HashSet::new();
+        for (id, d) in documents(document)? {
+            if !ids.insert(id) {
+                return Err("Conflict: two documents with one id".into());
+            }
+            let (doc, _) = decode(d, 1)?;
+            let (mut objects, mut unique) = (HashSet::new(), true);
+            doc.walk(|n| unique &= objects.insert(n.id));
+            if !unique {
+                return Err("Conflict: an object would be in two places".into());
+            }
+        }
+        Ok(())
+    }
+
+    fn live_document(&self) -> Value {
+        sync(self);
+        DOCS.with_borrow_mut(|docs| {
+            let documents: Vec<Value> = (docs.iter_mut().flatten())
+                .map(|e| {
+                    let v = project(&e.doc, e.id);
+                    e.reported = Some((Arc::as_ptr(&e.doc) as usize, digest(&v)));
+                    v
+                })
+                .collect();
+            json!({ "documents": documents })
+        })
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        // Typing in progress is kept first: its preview would start again from the document before this one.
+        if self.session.active().is_some_and(|st| st.interaction.is_some()) {
+            self.session.commit_interaction().map_err(|e| e.to_string())?;
+            self.session.set_tool_option("endTyping", &Value::Bool(true));
+        }
+        let given = if document.is_null() { Vec::new() } else { documents(&document)? };
+        sync(self);
+        // Each document's next state (none: the same as reported), read before anything changes.
+        let next: Vec<(u64, Option<Document>)> = DOCS.with_borrow(|docs| {
+            let entry = |id: u64| docs.iter().flatten().find(|e| e.id == id);
+            let next = |(id, value): (u64, Value)| {
+                let old = entry(id);
+                let same = old.is_some_and(|e| e.reported == Some((Arc::as_ptr(&e.doc) as usize, digest(&value))));
+                Ok((id, if same { None } else { Some(install(value, old.map(|e| &*e.doc))?) }))
+            };
+            given.into_iter().map(next).collect::<Result<_, String>>()
+        })?;
+        let mut docs = DOCS.take().unwrap_or_default();
+        // Someone joining (none of their documents in the session's) is shown the session's.
+        let joining = !JOINED.replace(true) && !next.is_empty() && docs.iter().all(|e| next.iter().all(|(id, _)| *id != e.id));
+        let (active, home) = (self.session.active_index(), crate::menus::home_showing(self));
+        let (mut kept, mut first) = (Vec::new(), None);
+        for (id, doc) in next {
+            let mut entry = docs.iter().position(|e| e.id == id).map(|i| docs.swap_remove(i));
+            if let Some(doc) = doc.map(Arc::new) {
+                match &mut entry {
+                    Some(e) => {
+                        if let Some(st) = e.uid.and_then(|uid| self.session.document_mut(uid)) {
+                            st.doc = doc.clone();
+                            st.selection.prune(&st.doc);
+                            st.revision += 1;
+                        }
+                        (e.doc, e.reported) = (doc, None);
+                    }
+                    // New here: it opens as a tab.
+                    None => {
+                        let i = self.session.add_document(Arc::unwrap_or_clone(doc), None);
+                        let st = &self.session.documents()[i];
+                        first.get_or_insert(i);
+                        entry = Some(Entry { id, uid: Some(st.uid), doc: st.doc.clone(), reported: None });
+                    }
+                }
+            }
+            kept.extend(entry);
+        }
+        // A document no longer in the session (its opening undone) stays open here as this person's own.
+        DOCS.set(Some(kept));
+        OPENED.set(self.session.documents().iter().map(|d| d.uid).fold(OPENED.get(), u64::max));
+        if let Some(i) = first {
+            if joining {
+                self.session.set_active(i);
+                self.ui.home = None;
+            } else {
+                // Another person's document opens behind this person's.
+                if let Some(a) = active {
+                    self.session.set_active(a);
+                }
+                if home {
+                    self.ui.home = Some(crate::menus::home_key(self));
+                }
+            }
+            self.sync_views();
+        }
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        // Typing is quiet between keys (IME composition aside): it reaches the others as it is typed.
+        let gesture = |st: &DocState| st.interaction.as_ref().is_some_and(|it| it.label != "Typing");
+        let editing = |st: &DocState| {
+            session_id(st.uid).is_some() && (st.undo_group.is_some() || st.doc.mask_edit.is_some() || st.doc.pattern_edit.is_some())
+        };
+        presence::quiet()
+            && !self.picks.is_waiting()
+            && self.ime_marked.is_none()
+            && !self.session.active().is_some_and(gesture)
+            && !self.session.documents().iter().any(editing)
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        sync(self);
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        DOCS.with_borrow(|docs| docs.iter().flatten().for_each(|e| (e.id, Arc::as_ptr(&e.doc) as usize).hash(&mut hasher)));
+        Some(hasher.finish())
+    }
+
+    fn live_presence(&self) -> Value {
+        let Some((st, doc)) = shown(self) else { return Value::Null };
+        let artboard = st.doc.artboards.get(crate::panels::artboards::selected(self, st.doc.artboards.len())).map(|a| a.id);
+        let selection: Vec<u64> = st.selection.objects.iter().take(50).map(|id| id.0).collect();
+        let mut presence = json!({ "doc": doc, "artboard": artboard, "selection": selection });
+        if let Some(p) = self.hover_doc.filter(|p| p.x.is_finite() && p.y.is_finite()) {
+            presence["pointer"] = json!([fine(p.x), fine(p.y)]);
+        }
+        // The gesture in progress, with fewer outline points while the whole is over what the shell sends (4 KiB).
+        let with = |points| {
+            let mut p = presence.clone();
+            gestures(self, st, points, &mut p);
+            p
+        };
+        [MAX_POINTS, MAX_POINTS / 3, 0].into_iter().map(with).find(|p| p.to_string().len() <= 4000).unwrap_or(presence)
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        presence::show(others);
+    }
+
+    fn live_disconnected(&mut self) {
+        // Native Undo starts again from here: its steps are from before the others' changes.
+        for uid in DOCS.take().into_iter().flatten().filter_map(|e| e.uid) {
+            if let Some(st) = self.session.document_mut(uid) {
+                st.history.undo.clear();
+                st.history.redo.clear();
+            }
+        }
+        JOINED.set(false);
+    }
+}
