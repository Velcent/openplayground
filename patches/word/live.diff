+    }
+
+    #[test]
+    fn tables_merge_by_cell_while_their_shape_holds_and_a_sort_conflicts() {
+        let cell = |t: &str| json!({"blocks": [plain(t)]});
+        let table = |rows: &[[&str; 2]]| json!({"kind": "table", "rows": rows.iter().map(|r| json!({"cells": [cell(r[0]), cell(r[1])]})).collect::<Vec<_>>()});
+        let base = doc(vec![table(&[["a", "b"], ["c", "d"]]), plain("after")]);
+        let c = doc(vec![table(&[["a1", "b"], ["c", "d"]]), plain("after")]);
+        let e = doc(vec![table(&[["a", "b"], ["c", "d2"]]), plain("after")]);
+        assert_eq!(merge(&base, &c, &e).unwrap(), doc(vec![table(&[["a1", "b"], ["c", "d2"]]), plain("after")]));
+        let sorted = doc(vec![table(&[["c", "d"], ["a", "b"]]), plain("after")]);
+        assert!(merge(&base, &sorted, &e).is_err());
+        // Typing into a table while the other side adds one above it never lands in the new table.
+        let base = doc(vec![plain("Intro"), table(&[["", ""]]), plain("")]);
+        let added = doc(vec![plain("Intro"), table(&[["", "x"]]), plain(""), table(&[["", ""]]), plain("")]);
+        let typed = doc(vec![plain("Intro"), table(&[["Alice", ""]]), plain("")]);
+        let want = doc(vec![plain("Intro"), table(&[["", "x"]]), plain(""), table(&[["Alice", ""]]), plain("")]);
+        for (c, e) in [(&added, &typed), (&typed, &added)] {
+            if let Ok(merged) = merge(&base, c, e) {
+                assert_eq!(merged, want);
+            }
+        }
+    }
+
+    #[test]
+    fn matches_pairs_a_longest_common_subsequence() {
+        let pairs = |a: &str, b: &str| {
+            let (a, b): (Vec<char>, Vec<char>) = (a.chars().collect(), b.chars().collect());
+            matches(&a, &b, |x, y| x == y)
+        };
+        assert_eq!(pairs("abcabba", "cbabac").iter().flatten().count(), 4);
+        assert_eq!(pairs("xay", "xby"), [Some(0), None, Some(2)]);
+        assert_eq!(pairs("", "abc"), []);
+        assert_eq!(pairs("abc", "zabcz"), [Some(1), Some(2), Some(3)]);
+    }
+}
