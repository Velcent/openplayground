new file mode 100644
index 0000000..e1714e1
--- /dev/null
+++ b/apps/wordcraft-web/src/live/presence.rs
@@ -0,0 +1,357 @@
+//! Presence: what each person shows the others and how the others are drawn over the pages, in their color.
+//!
+//! Shared (page points, `[page, …]`): the selection's ends (`anchor`, `focus`: story, paragraph path, byte offset), the
+//! pointer over a page (`pointer`: `[page, x, y]`), and what a gesture under way is doing before it reaches the document:
+//! a picture, shape or text box moved, resized or turned by its frame (`drag`: `[page, x, y, w, h, degrees]`), a table
+//! border or the table's resize handle dragged (`border`: `[page, x0, y0, x1, y1, outline]`) and an ink stroke being
+//! drawn (`stroke`: `{page, width, points}`). Typing needs nothing of its own: each keystroke edits the document (the
+//! app is quiet between keystrokes), and a selection being dragged moves `focus` as it goes.
+//!
+//! Drawn, under menus and dialogs: the others' gestures (ghosts, border lines, strokes), then their selections (text
+//! shaded, a picture or shape outlined, the caret as a bar), then their pointers with their names (a name at the caret
+//! for whoever's pointer is off the pages). Moving marks ease toward where they are, in page points.
+
+use egui::epaint::PathShape;
+use egui::{Color32, Painter, Pos2, Rect, Stroke, pos2, vec2};
+use serde_json::{Value, json};
+use wordcraft_doc::{Document, Pos};
+use wordcraft_engine::layout::DocLayout;
+use wordcraft_ui_egui::WordApp;
+
+use super::playground_live::Presence;
+
+/// The most stroke points a presence carries; the shell sends no presence over 4 KiB.
+const MAX_STROKE: usize = 200;
+const MAX_PRESENCE: usize = 4000;
+/// Names in tags are cut to this many characters.
+const MAX_NAME: usize = 24;
+/// How long the others' marks take to go most (1 - 1/e) of the way to where they last were, in seconds.
+const EASE: f32 = 0.08;
+/// A pointer's arrow, tip first: egui fills a closed path as a fan from its first point, which this shape allows.
+const ARROW: [[f32; 2]; 7] = [[0.0, 0.0], [12.5, 11.0], [7.3, 11.0], [10.4, 17.3], [7.6, 18.6], [4.5, 12.2], [0.0, 16.0]];
+
+/// A mark on a page: the page and its numbers (page points; a frame's angle last, in degrees).
+type Mark<const N: usize> = (usize, [f32; N]);
+
+/// What moves of another person's: the pointer, the frame being dragged and the table border being dragged (with
+/// whether it is the table's outline).
+#[derive(Clone, Copy, Default)]
+struct Marks {
+    pointer: Option<Mark<2>>,
+    drag: Option<Mark<5>>,
+    border: Option<(Mark<4>, bool)>,
+}
+
+/// Another person's presence, read defensively: positions are checked against the document before use.
+pub(super) struct Other {
+    id: String,
+    name: String,
+    color: Color32,
+    pub(super) selection: Option<(Pos, Pos)>,
+    /// Where their marks are, as they last showed themselves.
+    to: Marks,
+    /// Where this page last drew them, eased toward `to`.
+    shown: Marks,
+    /// The stroke being drawn: page, pen width (points) and points.
+    stroke: Option<(usize, f32, Vec<[f32; 2]>)>,
+    /// The stroke's length as last seen and how far its shown end is behind its newest point (page points); a length of
+    /// infinity: not seen yet, shown whole at once.
+    ink: [f32; 2],
+}
+
+/// A number from another person's presence, if it is one worth drawing.
+fn number(v: &Value) -> Option<f32> {
+    v.as_f64().filter(|v| v.abs() < 1e6).map(|v| v as f32)
+}
+
+/// `[page, n…]` from another person's presence.
+fn mark<const N: usize>(v: &Value) -> Option<Mark<N>> {
+    let page = usize::try_from(v[0].as_u64()?).ok()?;
+    let mut at = [0.0; N];
+    for (i, n) in at.iter_mut().enumerate() {
+        *n = number(&v[i + 1])?;
+    }
+    Some((page, at))
+}
+
+impl Other {
+    /// Who `p` is and where, keeping where this page last drew their marks when `old` has them.
+    pub(super) fn new(p: Presence, old: &[Other]) -> Other {
+        let state = &p.state;
+        let pos = |key: &str| serde_json::from_value::<Pos>(state[key].clone()).ok();
+        let s = &state["stroke"];
+        let points: Option<Vec<f32>> = s["points"].as_array().into_iter().flatten().take(2 * MAX_STROKE).map(number).collect();
+        let points: Vec<[f32; 2]> = points.unwrap_or_default().chunks_exact(2).map(|p| [p[0], p[1]]).collect();
+        let page = s["page"].as_u64().and_then(|page| usize::try_from(page).ok());
+        let stroke = page.zip(number(&s["width"])).filter(|_| points.len() >= 2).map(|(page, width)| (page, width.clamp(0.0, 200.0), points));
+        let to = Marks {
+            pointer: mark(&state["pointer"]),
+            drag: mark(&state["drag"]).filter(|(_, d): &Mark<5>| d[2] >= 0.0 && d[3] >= 0.0),
+            border: mark(&state["border"]).map(|m| (m, state["border"][5].as_bool() == Some(true))),
+        };
+        let (shown, ink) = old.iter().find(|o| o.id == p.id).map_or((Marks::default(), [f32::INFINITY, 0.0]), |o| (o.shown, o.ink));
+        Other {
+            name: p.name.trim().to_owned(),
+            color: Color32::from_rgb(p.color[0], p.color[1], p.color[2]),
+            selection: pos("anchor").zip(pos("focus")),
+            id: p.id,
+            to,
+            shown,
+            stroke,
+            ink,
+        }
+    }
+
+    /// One frame on toward where they are (`k`: the share of the way, `z`: screen points a page point, `far`: the jump in
+    /// screen points that goes at once). Whether a mark is still on its way.
+    fn step(&mut self, k: f32, z: f32, far: f32) -> bool {
+        let mut moving = ease(&mut self.shown.pointer, self.to.pointer, k, z, far);
+        if let (Some((_, s)), Some((_, t))) = (&self.shown.drag, &mut self.to.drag) {
+            // A frame turns the short way round.
+            t[4] = s[4] + (t[4] - s[4] + 540.0).rem_euclid(360.0) - 180.0;
+        }
+        moving |= ease(&mut self.shown.drag, self.to.drag, k, z, far);
+        // A line and an outline do not turn into each other.
+        let same = matches!((self.shown.border, self.to.border), (Some((_, a)), Some((_, b))) if a == b);
+        let mut border = self.shown.border.filter(|_| same).map(|(m, _)| m);
+        moving |= ease(&mut border, self.to.border.map(|(m, _)| m), k, z, far);
+        self.shown.border = border.zip(self.to.border.map(|(_, outline)| outline));
+        if let Some((_, _, points)) = &self.stroke {
+            let [seen, behind] = &mut self.ink;
+            let length = length(points);
+            *behind = (*behind + length - *seen).max(0.0);
+            *seen = length;
+            let mut tail = Some((0, [*behind]));
+            moving |= ease(&mut tail, Some((0, [0.0])), k, z, far);
+            *behind = tail.map_or(0.0, |(_, [b])| b);
+        } else {
+            self.ink = [0.0; 2];
+        }
+        moving
+    }
+}
+
+/// `shown` moved `k` of the way to `to` (page points, `z` screen points each): all of it when either is missing, on
+/// another page, after a jump of more than `far` screen points, or once under half a screen point remains. Whether it is
+/// still on its way.
+fn ease<const N: usize>(shown: &mut Option<Mark<N>>, to: Option<Mark<N>>, k: f32, z: f32, far: f32) -> bool {
+    let (Some((page, s)), Some((to_page, t))) = (shown.as_mut(), to) else {
+        *shown = to;
+        return false;
+    };
+    let off = |s: &[f32; N]| s.iter().zip(&t).map(|(s, t)| (t - s).abs() * z).fold(0.0, f32::max);
+    let k = if *page != to_page || off(s) > far { 1.0 } else { k };
+    *page = to_page;
+    s.iter_mut().zip(&t).for_each(|(s, t)| *s += (t - *s) * k);
+    let moving = off(s) >= 0.5;
+    if !moving {
+        *s = t;
+    }
+    moving
+}
+
+fn length(stroke: &[[f32; 2]]) -> f32 {
+    stroke.windows(2).map(|w| (w[1][0] - w[0][0]).hypot(w[1][1] - w[0][1])).sum()
+}
+
+fn round(v: f32) -> f64 {
+    (f64::from(v) * 10.0).round() / 10.0
+}
+
+/// This person's gestures under way, for [`Live::live_presence`](super::Live::live_presence): see the module's comment.
+/// `ctx` gives the keys held (a table border's drag depends on them).
+pub(super) fn gestures(app: &WordApp, ctx: Option<&egui::Context>, v: &mut Value) {
+    if let Some((page, r, deg)) = wordcraft_ui_egui::objects::live::ghost(app) {
+        v["drag"] = json!([page, round(r[0]), round(r[1]), round(r[2]), round(r[3]), round(deg)]);
+    }
+    if let Some((page, l, outline)) = ctx.and_then(|ctx| wordcraft_ui_egui::table_resize::live::border(app, ctx)) {
+        v["border"] = json!([page, round(l[0]), round(l[1]), round(l[2]), round(l[3]), outline]);
+    }
+    if let Some((page, width, points)) = wordcraft_ui_egui::ink::live::stroke(app) {
+        // Points at least a pixel apart at this person's zoom, the newest ones.
+        let z = app.canvas.scale.max(0.01);
+        let mut kept: Vec<[f32; 2]> = Vec::new();
+        for p in points {
+            if kept.last().is_none_or(|q| (p[0] - q[0]).hypot(p[1] - q[1]) * z >= 1.0) {
+                kept.push(*p);
+            }
+        }
+        let kept = &kept[kept.len().saturating_sub(MAX_STROKE)..];
+        let flat: Vec<f64> = kept.iter().flatten().map(|v| round(*v)).collect();
+        v["stroke"] = json!({"page": page, "width": round(width), "points": flat});
+    }
+    // The shell sends nothing bigger: the stroke's oldest points go first.
+    while v.to_string().len() > MAX_PRESENCE
+        && let Some(points) = v.get_mut("stroke").and_then(|s| s.get_mut("points")).and_then(Value::as_array_mut).filter(|p| p.len() > 4)
+    {
+        points.drain(..points.len() / 4 * 2);
+    }
+}
+
+/// A selection from another person that lies in this document: both ends in one story, each a paragraph's position on
+/// a character boundary.
+pub(super) fn resolved<'a>(doc: &Document, selection: &'a Option<(Pos, Pos)>) -> Option<(&'a Pos, &'a Pos)> {
+    let valid = |pos: &Pos| doc.para_at(pos).is_some_and(|p| p.text.is_char_boundary(pos.off));
+    selection.as_ref().filter(|(a, f)| a.story == f.story && valid(a) && valid(f)).map(|(a, f)| (a, f))
+}
+
+/// The others over the pages as this frame drew them, in their colors (see the module's comment). Marks ease toward
+/// where they are, repainting until they get there.
+pub(super) fn draw(app: &WordApp, ui: &egui::Ui, layout: &DocLayout, others: &mut [Other]) {
+    let Some(clip) = app.canvas.canvas_rect else { return };
+    let p = ui.painter().with_clip_rect(clip);
+    let (doc, hint, rects) = (&app.session.doc, app.session.page_hint, &app.canvas.page_rects);
+    // A page point on screen, with the page's scale (as the canvas places its own selection).
+    let screen = |page: usize, x: f32, y: f32| {
+        let (r, pg) = (rects.get(page)?, layout.pages.get(page)?);
+        let scale = if pg.w > 0.0 { r.width() / pg.w } else { app.canvas.scale };
+        Some((pos2(r.min.x + x * scale, r.min.y + y * scale), scale))
+    };
+    // A frame `[x, y, w, h]` turned `deg` about its centre: its corners on screen, clockwise from the top left.
+    let corners = |page: usize, r: [f32; 4], deg: f32| -> Option<Vec<Pos2>> {
+        let (min, scale) = screen(page, r[0], r[1])?;
+        let f = Rect::from_min_size(min, vec2(r[2], r[3]) * scale);
+        let (s, k) = deg.to_radians().sin_cos();
+        let turn = |q: Pos2| f.center() + vec2((q.x - f.center().x) * k - (q.y - f.center().y) * s, (q.x - f.center().x) * s + (q.y - f.center().y) * k);
+        Some([f.left_top(), f.right_top(), f.right_bottom(), f.left_bottom()].into_iter().map(turn).collect())
+    };
+
+    let dt = ui.input(|i| i.stable_dt).clamp(0.0, 0.1);
+    let (k, z, far) = (1.0 - (-dt / EASE).exp(), app.canvas.scale.max(0.01), 0.25 * clip.width().max(clip.height()));
+    let mut moving = false;
+    for o in others.iter_mut() {
+        moving |= o.step(k, z, far);
+    }
+    if moving {
+        ui.ctx().request_repaint();
+    }
+
+    // What they are doing: frames being dragged, table borders, strokes.
+    for o in others.iter() {
+        let (fill, edge) = (o.color.gamma_multiply(0.28), Stroke::new(1.5, o.color.gamma_multiply(0.85)));
+        if let Some((page, d)) = o.shown.drag
+            && let Some(c) = corners(page, [d[0], d[1], d[2], d[3]], d[4])
+        {
+            p.add(PathShape::convex_polygon(c, fill, edge));
+        }
+        if let Some(((page, l), outline)) = o.shown.border
+            && let (Some((a, _)), Some((b, _))) = (screen(page, l[0], l[1]), screen(page, l[2], l[3]))
+        {
+            if outline {
+                p.add(PathShape::convex_polygon(vec![a, pos2(b.x, a.y), b, pos2(a.x, b.y)], fill, edge));
+            } else {
+                p.line_segment([a, b], Stroke::new(6.0, fill));
+                p.line_segment([a, b], edge);
+            }
+        }
+        if let Some((page, width, points)) = &o.stroke {
+            paint_stroke(&p, |q| screen(*page, q[0], q[1]), points, *width, o.ink[1], o.color);
+        }
+    }
+    // Their selections: text shaded, a picture or shape outlined, the caret.
+    let mut carets = Vec::new();
+    for o in others.iter() {
+        let Some((anchor, focus)) = resolved(doc, &o.selection) else { continue };
+        let object = (anchor.story == focus.story && anchor.path == focus.path && anchor.off.abs_diff(focus.off) == wordcraft_doc::para::OBJ.len_utf8())
+            .then(|| if anchor.off < focus.off { anchor } else { focus })
+            .filter(|at| doc.para_at(at).and_then(|para| para.object_at(at.off)).is_some_and(|obj| obj.is_drawing()))
+            .and_then(|at| layout.object(at, hint));
+        if let Some(obj) = object {
+            if let Some(c) = corners(obj.page, [obj.rect.x, obj.rect.y, obj.rect.w, obj.rect.h], obj.spin.deg) {
+                p.add(PathShape::closed_line(c, Stroke::new(2.0, o.color)));
+            }
+            continue;
+        }
+        if anchor != focus {
+            for (page, r) in layout.selection_rects(doc, anchor, focus, hint) {
+                if let Some((min, scale)) = screen(page, r.x, r.y) {
+                    p.rect_filled(Rect::from_min_size(min, vec2(r.w, r.h) * scale), 0.0, o.color.gamma_multiply(0.25));
+                }
+            }
+        }
+        if let Some(c) = layout.caret_on(focus, hint)
+            && let Some((top, scale)) = screen(c.page, c.x, c.top)
+        {
+            // Turned text (a table cell's text direction): the caret lies across the page.
+            let end = if c.width > 0.0 { top + vec2(c.width * scale, 0.0) } else { top + vec2(0.0, c.height * scale) };
+            p.line_segment([top, end], Stroke::new(2.0, o.color));
+            if o.shown.pointer.is_none() {
+                carets.push((top, end, o));
+            }
+        }
+    }
+    // Their pointers with their names, and a name at the caret of whoever's pointer is off the pages.
+    for (top, end, o) in carets {
+        paint_tag(&p, top, Some(end.y.max(top.y)), &o.name, o.color);
+    }
+    for o in others.iter() {
+        if let Some((tip, _)) = o.shown.pointer.and_then(|(page, [x, y])| screen(page, x, y)) {
+            paint_arrow(&p, tip, o.color);
+            paint_tag(&p, tip + vec2(12.0, 15.0), None, &o.name, o.color);
+        }
+    }
+}
+
+/// A stroke being drawn, up to `behind` page points short of its newest point: translucent, as wide as the pen.
+fn paint_stroke(p: &Painter, at: impl Fn([f32; 2]) -> Option<(Pos2, f32)>, stroke: &[[f32; 2]], width: f32, behind: f32, color: Color32) {
+    let Some((first, scale)) = stroke.first().and_then(|q| at(*q)) else { return };
+    let mut left = length(stroke) - behind;
+    let mut line = vec![first];
+    for w in stroke.windows(2) {
+        let d = (w[1][0] - w[0][0]).hypot(w[1][1] - w[0][1]);
+        let q = if d >= left {
+            let f = if d > 0.0 { (left / d).max(0.0) } else { 0.0 };
+            [w[0][0] + (w[1][0] - w[0][0]) * f, w[0][1] + (w[1][1] - w[0][1]) * f]
+        } else {
+            w[1]
+        };
+        line.extend(at(q).map(|(q, _)| q));
+        if d >= left {
+            break;
+        }
+        left -= d;
+    }
+    let stroke = Stroke::new((width * scale).max(2.0), color.gamma_multiply(0.7));
+    // Round caps: a half disc past each end, so nothing is painted twice and the color stays even.
+    // ponytail: egui's own (mitred) joins; round ones would show only at sharp turns of a wide highlighter.
+    let r = stroke.width / 2.0;
+    if let ([a, b, ..], [.., y, z]) = (line.as_slice(), line.as_slice())
+        && r > 1.5
+    {
+        for (end, from) in [(*a, *b), (*z, *y)] {
+            let d = (end - from).normalized();
+            let cap = (0..=8).map(|i| (i as f32 * std::f32::consts::PI / 8.0).sin_cos()).map(|(s, c)| end + (d.rot90() * c + d * s) * r);
+            p.add(PathShape::convex_polygon(cap.collect(), stroke.color, Stroke::NONE));
+        }
+    }
+    p.add(PathShape::line(line, stroke));
+}
+
+/// A pointer: the arrow, its tip at `tip`, in `color` with a white edge and a soft shadow.
+fn paint_arrow(p: &Painter, tip: Pos2, color: Color32) {
+    let points: Vec<Pos2> = ARROW.iter().map(|&[x, y]| tip + vec2(x, y)).collect();
+    let shadow = points.iter().map(|q| *q + vec2(0.0, 1.0)).collect();
+    p.add(PathShape::convex_polygon(shadow, Color32::from_black_alpha(64), Stroke::NONE));
+    p.add(PathShape::convex_polygon(points, color, Stroke::new(1.5, Color32::WHITE)));
+}
+
+/// A name tag in `color`: its top left at `at`; or, given the bottom of a caret whose top is `at`, just above the caret
+/// (below it when the view's top would cut the tag). Dark text on light colors.
+fn paint_tag(p: &Painter, at: Pos2, caret_bottom: Option<f32>, name: &str, color: Color32) {
+    if name.is_empty() {
+        return;
+    }
+    let name: String = if name.chars().count() > MAX_NAME { name.chars().take(MAX_NAME - 1).chain(['…']).collect() } else { name.into() };
+    let lin = egui::ecolor::linear_f32_from_gamma_u8;
+    let luminance = 0.2126 * lin(color.r()) + 0.7152 * lin(color.g()) + 0.0722 * lin(color.b());
+    let ink = if luminance > 0.55 { Color32::from_gray(0x11) } else { Color32::WHITE };
+    let text = p.layout_no_wrap(name, wordcraft_ui_egui::theme::semibold(12.0), ink);
+    let size = text.size() + vec2(14.0, 6.0);
+    let r = match caret_bottom {
+        None => Rect::from_min_size(at, size),
+        Some(_) if at.y - size.y - 1.0 >= p.clip_rect().top() => Rect::from_min_size(at - vec2(0.0, size.y + 1.0), size),
+        Some(bottom) => Rect::from_min_size(pos2(at.x, bottom + 1.0), size),
+    };
+    p.rect_filled(r, 6.0, color);
+    p.galley(r.min + vec2(7.0, 3.0), text, ink);
+}
diff --git a/apps/wordcraft-web/src/live/text_merge.rs b/apps/wordcraft-web/src/live/text_merge.rs
new file mode 100644
index 0000000..60c0d1b
--- /dev/null
+++ b/apps/wordcraft-web/src/live/text_merge.rs
@@ -0,0 +1,440 @@
+//! Playground live editing: the three-way merge of WordCraft's shared document (JSON). Stories (the body, parts, note
+//! separators, table cells) are lists of blocks without ids and a paragraph is one string with byte-length runs and
+//! positional inline objects, so they merge as text does (diff3, as git merges lines): blocks that neither side
+//! changed match by content; where both sides changed the same stretch of blocks, its paragraphs become characters
+//! (each with its run's formatting and, for U+FFFC, its inline object; a paragraph end carries the paragraph's own
+//! properties) that merge the same way and then become paragraphs again. Overlapping changes conflict. Table rows and
+//! cells merge by position while both sides keep the table's shape; everything else merges as JSON by key
+//! ([`playground_live::merge`]).
+
+use std::borrow::Cow;
+
+use serde_json::{Map, Value};
+
+use super::playground_live::{self, Error};
+
+/// The object replacement character: an inline object's place in a paragraph's text.
+const OBJ: char = '\u{FFFC}';
+/// Edit distance [`matches`] works out exactly; past it the stretch counts as all changed (more conflicts, never a
+/// wrong merge).
+// ponytail: O(D²) memory for the trace (about 8 MB at the cap); a linear-space Myers if bigger edits must merge.
+const MAX_EDITS: isize = 1000;
+
+pub fn merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+    value(base, current, edited, "")
+}
+
+fn conflict(at: &str) -> Error {
+    format!("Conflict at {}", if at.is_empty() { "/" } else { at })
+}
+
+fn value(b: &Value, c: &Value, e: &Value, key: &str) -> Result<Value, Error> {
+    if e == b {
+        return Ok(c.clone());
+    }
+    if c == b {
+        return Ok(e.clone());
+    }
+    match (b, c, e) {
+        (Value::Object(bo), Value::Object(co), Value::Object(eo)) => {
+            let keys: std::collections::BTreeSet<&String> = bo.keys().chain(co.keys()).chain(eo.keys()).collect();
+            let mut out = Map::new();
+            for k in keys {
+                let (bv, cv, ev) = (bo.get(k), co.get(k), eo.get(k));
+                let merged = if ev == bv {
+                    cv.cloned()
+                } else if cv == bv {
+                    ev.cloned()
+                } else if let (Some(bv), Some(cv), Some(ev)) = (bv, cv, ev) {
+                    Some(value(bv, cv, ev, k)?)
+                } else {
+                    return Err(conflict(k));
+                };
+                if let Some(v) = merged {
+                    out.insert(k.clone(), v);
+                }
+            }
+            Ok(Value::Object(out))
+        }
+        (Value::Array(bs), Value::Array(cs), Value::Array(es)) if [bs, cs, es].iter().all(|a| a.iter().all(is_block)) => {
+            blocks(bs, cs, es).map(Value::Array)
+        }
+        // A table's rows and a row's cells, while both sides keep their number: by position, unless a side moved one
+        // (a sort), which conflicts.
+        (Value::Array(bs), Value::Array(cs), Value::Array(es)) if matches!(key, "rows" | "cells") && bs.len() == cs.len() && bs.len() == es.len() => {
+            let moved = |x: &Value, at: &Value| x != at && bs.contains(x);
+            bs.iter()
+                .zip(cs.iter().zip(es))
+                .map(|(b, (c, e))| if moved(c, b) || moved(e, b) { Err(conflict(key)) } else { value(b, c, e, "") })
+                .collect::<Result<Vec<_>, _>>()
+                .map(Value::Array)
+        }
+        _ => playground_live::merge(b, c, e, &[]).map_err(|err| if key.is_empty() { err } else { format!("{err} in {key}") }),
+    }
+}
+
+fn is_block(v: &Value) -> bool {
+    match v.get("kind").and_then(Value::as_str) {
+        Some("para") => v.get("text").is_some_and(Value::is_string) && v.get("runs").is_some_and(Value::is_array),
+        Some("table") => v.get("rows").is_some_and(Value::is_array),
+        _ => false,
+    }
+}
+
+fn blocks(b: &[Value], c: &[Value], e: &[Value]) -> Result<Vec<Value>, Error> {
+    diff3(
+        b,
+        c,
+        e,
+        |x, y| x == y,
+        |b, _, _| Ok(b.clone()),
+        |b, c, e| {
+            // Both sides changed these blocks: merge them character by character. Paragraph ends and tables pair up
+            // by position when all three stretches have as many of them, else only when equal: a table typed into
+            // must not pair with one the other side added.
+            let paras = |x: &[Value]| x.iter().filter(|b| b.get("kind").and_then(Value::as_str) == Some("para")).count();
+            let (ends, tables) = ([b, c, e].map(paras), [b, c, e].map(|x| x.len() - paras(x)));
+            let by_position = (ends[0] == ends[1] && ends[1] == ends[2], tables[0] == tables[1] && tables[1] == tables[2]);
+            let same = move |x: &Atom, y: &Atom| match (x, y) {
+                (Atom::Char(a, ..), Atom::Char(b, ..)) => a == b,
+                (Atom::End(i, a), Atom::End(j, b)) => {
+                    if by_position.0 {
+                        i == j
+                    } else {
+                        a == b
+                    }
+                }
+                (Atom::Table(i, a), Atom::Table(j, b)) => {
+                    if by_position.1 {
+                        i == j
+                    } else {
+                        a == b
+                    }
+                }
+                _ => false,
+            };
+            let (b, c, e) = (atoms(b)?, atoms(c)?, atoms(e)?);
+            let merged = diff3(&b, &c, &e, same, Atom::merge, |_, _, _| Err(conflict("text")))?;
+            paragraphs(merged)
+        },
+    )
+}
+
+/// A story's content in reading order: characters, paragraph ends and tables.
+#[derive(Clone, Debug)]
+enum Atom<'a> {
+    /// A character with its run's `props` (`{}` for none) and, for U+FFFC, its inline object.
+    Char(char, Cow<'a, Value>, Option<Cow<'a, Value>>),
+    /// A paragraph's end (the how-manyth in its stretch): the paragraph without its text, runs and objects.
+    End(usize, Cow<'a, Value>),
+    /// A table (the how-manyth in its stretch).
+    Table(usize, Cow<'a, Value>),
+}
+
+/// The same content; where it stands in its stretch does not count.
+impl PartialEq for Atom<'_> {
+    fn eq(&self, other: &Self) -> bool {
+        match (self, other) {
+            (Atom::Char(a, ap, ao), Atom::Char(b, bp, bo)) => a == b && ap == bp && ao == bo,
+            (Atom::End(_, a), Atom::End(_, b)) | (Atom::Table(_, a), Atom::Table(_, b)) => a == b,
+            _ => false,
+        }
+    }
+}
+
+impl<'a> Atom<'a> {
+    /// One that neither side removed: formatting, objects and paragraph or table properties merge.
+    fn merge(b: &Self, c: &Self, e: &Self) -> Result<Self, Error> {
+        fn three<'a>(b: &Cow<'a, Value>, c: &Cow<'a, Value>, e: &Cow<'a, Value>, key: &str) -> Result<Cow<'a, Value>, Error> {
+            Ok(if e == b {
+                c.clone()
+            } else if c == b {
+                e.clone()
+            } else {
+                Cow::Owned(value(b, c, e, key)?)
+            })
+        }
+        Ok(match (b, c, e) {
+            (Atom::Char(ch, bp, bo), Atom::Char(_, cp, co), Atom::Char(_, ep, eo)) => {
+                let object = match (bo, co, eo) {
+                    (Some(b), Some(c), Some(e)) => Some(three(b, c, e, "objects")?),
+                    _ => None,
+                };
+                Atom::Char(*ch, three(bp, cp, ep, "props")?, object)
+            }
+            (Atom::End(i, b), Atom::End(_, c), Atom::End(_, e)) => Atom::End(*i, three(b, c, e, "paragraph")?),
+            (Atom::Table(i, b), Atom::Table(_, c), Atom::Table(_, e)) => Atom::Table(*i, three(b, c, e, "table")?),
+            _ => return Err(conflict("text")),
+        })
+    }
+}
+
+fn atoms(blocks: &[Value]) -> Result<Vec<Atom<'_>>, Error> {
+    let (mut out, mut ends, mut tables) = (Vec::new(), 0, 0);
+    for block in blocks {
+        if block.get("kind").and_then(Value::as_str) != Some("para") {
+            out.push(Atom::Table(tables, Cow::Borrowed(block)));
+            tables += 1;
+            continue;
+        }
+        let text = block.get("text").and_then(Value::as_str).unwrap_or_default();
+        let runs = block.get("runs").and_then(Value::as_array).map(Vec::as_slice).unwrap_or_default();
+        let len = |run: &Value| run.get("len").and_then(Value::as_u64).unwrap_or(0) as usize;
+        let mut objects = block.get("objects").and_then(Value::as_array).into_iter().flatten();
+        let (mut run, mut end) = (0, runs.first().map_or(0, len));
+        for (at, ch) in text.char_indices() {
+            while at >= end && run + 1 < runs.len() {
+                run += 1;
+                end += runs.get(run).map_or(0, len);
+            }
+            let props = runs.get(run).and_then(|r| r.get("props")).map_or_else(|| Cow::Owned(Value::Object(Map::new())), Cow::Borrowed);
+            let object = if ch == OBJ { Some(Cow::Borrowed(objects.next().ok_or("Invalid paragraph: an inline object is missing")?)) } else { None };
+            out.push(Atom::Char(ch, props, object));
+        }
+        let rest = block.as_object().into_iter().flatten().filter(|(k, _)| !matches!(k.as_str(), "text" | "runs" | "objects"));
+        out.push(Atom::End(ends, Cow::Owned(Value::Object(rest.map(|(k, v)| (k.clone(), v.clone())).collect()))));
+        ends += 1;
+    }
+    Ok(out)
+}
+
+/// Paragraphs (runs as the app normalizes them: adjacent equal formatting joined) and tables again.
+fn paragraphs(atoms: Vec<Atom>) -> Result<Vec<Value>, Error> {
+    let mut out = Vec::new();
+    let (mut text, mut runs, mut objects) = (String::new(), Vec::<(usize, Value)>::new(), Vec::new());
+    for atom in atoms {
+        match atom {
+            Atom::Char(ch, props, object) => {
+                match runs.last_mut() {
+                    Some((len, p)) if *p == *props => *len += ch.len_utf8(),
+                    _ => runs.push((ch.len_utf8(), props.into_owned())),
+                }
+                text.push(ch);
+                objects.extend(object.map(Cow::into_owned));
+            }
+            Atom::End(_, rest) => {
+                let mut p = match rest.into_owned() {
+                    Value::Object(p) => p,
+                    _ => Map::new(),
+                };
+                p.insert("text".into(), std::mem::take(&mut text).into());
+                let runs = runs.drain(..).map(|(len, props)| {
+                    let mut run = Map::from_iter([("len".to_string(), Value::from(len))]);
+                    if props.as_object().is_none_or(|p| !p.is_empty()) {
+                        run.insert("props".into(), props);
+                    }
+                    Value::Object(run)
+                });
+                p.insert("runs".into(), runs.collect());
+                if !objects.is_empty() {
+                    p.insert("objects".into(), std::mem::take(&mut objects).into());
+                }
+                out.push(Value::Object(p));
+            }
+            // Text left without its paragraph end (one side joined paragraphs where the other put a table).
+            Atom::Table(..) if !text.is_empty() => return Err(conflict("text")),
+            Atom::Table(_, table) => out.push(table.into_owned()),
+        }
+    }
+    if !text.is_empty() {
+        return Err(conflict("text"));
+    }
+    Ok(out)
+}
+
+/// diff3: the stretches where `b`, `c` and `e` agree (items `same` in all three, merged by `stable`) and between them
+/// the changed ones, taken from the side that changed them, or from `both` when both did.
+fn diff3<T: Clone + PartialEq>(
+    b: &[T],
+    c: &[T],
+    e: &[T],
+    same: impl Fn(&T, &T) -> bool + Copy,
+    mut stable: impl FnMut(&T, &T, &T) -> Result<T, Error>,
+    mut both: impl FnMut(&[T], &[T], &[T]) -> Result<Vec<T>, Error>,
+) -> Result<Vec<T>, Error> {
+    let (mc, me) = (matches(b, c, same), matches(b, e, same));
+    let (mut i, mut j, mut k) = (0, 0, 0);
+    let mut out = Vec::new();
+    loop {
+        while i < b.len() && mc[i] == Some(j) && me[i] == Some(k) {
+            out.push(stable(&b[i], &c[j], &e[k])?);
+            (i, j, k) = (i + 1, j + 1, k + 1);
+        }
+        let next = (i..b.len()).find_map(|x| Some((x, mc[x]?, me[x]?))).unwrap_or((b.len(), c.len(), e.len()));
+        if next == (i, j, k) {
+            return Ok(out);
+        }
+        let (bb, cc, ee) = (&b[i..next.0], &c[j..next.1], &e[k..next.2]);
+        if cc == bb {
+            out.extend_from_slice(ee);
+        } else if ee == bb {
+            out.extend_from_slice(cc);
+        } else {
+            out.extend(both(bb, cc, ee)?);
+        }
+        (i, j, k) = next;
+    }
+}
+
+/// For each item of `a`, the item of `b` it is paired with in a longest common subsequence (Myers' O(ND) diff after
+/// the common start and end).
+pub fn matches<T>(a: &[T], b: &[T], same: impl Fn(&T, &T) -> bool) -> Vec<Option<usize>> {
+    let mut out = vec![None; a.len()];
+    let pre = a.iter().zip(b).take_while(|(x, y)| same(x, y)).count();
+    let suf = a[pre..].iter().rev().zip(b[pre..].iter().rev()).take_while(|(x, y)| same(x, y)).count();
+    for (i, o) in out.iter_mut().enumerate().take(pre) {
+        *o = Some(i);
+    }
+    for s in 1..=suf {
+        out[a.len() - s] = Some(b.len() - s);
+    }
+    let (a, b) = (&a[pre..a.len() - suf], &b[pre..b.len() - suf]);
+    let (n, m) = (a.len() as isize, b.len() as isize);
+    if n == 0 || m == 0 {
+        return out;
+    }
+    let off = n + m + 1;
+    let mut v = vec![0isize; 2 * off as usize + 1];
+    let mut trace = Vec::new();
+    'search: for d in 0..=n + m {
+        if d > MAX_EDITS {
+            return out;
+        }
+        // The furthest x on diagonals -d-1..=d+1 before this step, for the way back.
+        trace.push(v[(off - d - 1) as usize..=(off + d + 1) as usize].to_vec());
+        for k in (-d..=d).step_by(2) {
+            let at = |k: isize| v[(off + k) as usize];
+            let mut x = if k == -d || (k != d && at(k - 1) < at(k + 1)) { at(k + 1) } else { at(k - 1) + 1 };
+            let mut y = x - k;
+            while x < n && y < m && same(&a[x as usize], &b[y as usize]) {
+                (x, y) = (x + 1, y + 1);
+            }
+            v[(off + k) as usize] = x;
+            if x >= n && y >= m {
+                break 'search;
+            }
+        }
+    }
+    let (mut x, mut y) = (n, m);
+    for (d, t) in trace.iter().enumerate().rev() {
+        let d = d as isize;
+        let at = |k: isize| t[(k + d + 1) as usize];
+        let k = x - y;
+        let prev = if k == -d || (k != d && at(k - 1) < at(k + 1)) { k + 1 } else { k - 1 };
+        let (px, py) = (at(prev), at(prev) - prev);
+        while x > px && y > py {
+            (x, y) = (x - 1, y - 1);
+            out[pre + x as usize] = Some(pre + y as usize);
+        }
+        (x, y) = (px, py);
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    /// A paragraph from (text, bold) pieces.
+    fn para(pieces: &[(&str, bool)]) -> Value {
+        let text: String = pieces.iter().map(|(t, _)| *t).collect();
+        let runs: Vec<Value> =
+            pieces.iter().map(|(t, bold)| if *bold { json!({"len": t.len(), "props": {"bold": true}}) } else { json!({"len": t.len()}) }).collect();
+        json!({"kind": "para", "text": text, "runs": runs})
+    }
+    fn plain(text: &str) -> Value {
+        para(&[(text, false)])
+    }
+    fn doc(body: Vec<Value>) -> Value {
+        json!({"body": body, "settings": {"trackChanges": false}})
+    }
+
+    #[test]
+    fn edits_in_different_paragraphs_and_places_merge_and_overlapping_ones_conflict() {
+        let base = doc(vec![plain("One two three"), plain("Four"), plain("Five")]);
+        // Different paragraphs, and one side adds a paragraph.
+        let c = doc(vec![plain("One two three!"), plain("Four"), plain("Five")]);
+        let e = doc(vec![plain("One two three"), plain("Four"), plain("New"), plain("Five 5")]);
+        assert_eq!(merge(&base, &c, &e).unwrap(), doc(vec![plain("One two three!"), plain("Four"), plain("New"), plain("Five 5")]));
+        // The same paragraph, different places; one side also splits it (Enter) after "two".
+        let c = doc(vec![plain("Uno two three"), plain("Four"), plain("Five")]);
+        let e = doc(vec![plain("One two"), plain(" three, four"), plain("Four"), plain("Five")]);
+        assert_eq!(merge(&base, &c, &e).unwrap(), doc(vec![plain("Uno two"), plain(" three, four"), plain("Four"), plain("Five")]));
+        // Next to each other: a conflict.
+        let e = doc(vec![plain("One"), plain(" two three"), plain("Four"), plain("Five")]);
+        assert!(merge(&base, &c, &e).is_err());
+        // The same place: a conflict, even when both typed the same.
+        let c = doc(vec![plain("One two! three"), plain("Four"), plain("Five")]);
+        let e = doc(vec![plain("One two? three"), plain("Four"), plain("Five")]);
+        assert!(merge(&base, &c, &e).unwrap_err().contains("Conflict"));
+        assert!(merge(&base, &c, &c).is_err());
+        // Other parts of the document merge by key.
+        let mut c = base.clone();
+        c["settings"]["trackChanges"] = json!(true);
+        let e = doc(vec![plain("One two three"), plain("Four"), plain("Five!")]);
+        let mut both = e.clone();
+        both["settings"]["trackChanges"] = json!(true);
+        assert_eq!(merge(&base, &c, &e).unwrap(), both);
+    }
+
+    #[test]
+    fn formatting_and_inline_objects_follow_their_characters() {
+        let pic = |w: u32| json!({"type": "image", "media": "image1.png", "w": w, "h": 10});
+        let mut base = plain("ab\u{FFFC}cd efg");
+        base["objects"] = json!([pic(10)]);
+        base["props"] = json!({"style": "Normal"});
+        // One side bolds "efg" and resizes the picture; the other types before the picture and restyles the paragraph.
+        let mut c = para(&[("ab\u{FFFC}cd ", false), ("efg", true)]);
+        c["objects"] = json!([pic(20)]);
+        c["props"] = json!({"style": "Normal"});
+        let mut e = plain("aXb\u{FFFC}cd efg");
+        e["objects"] = json!([pic(10)]);
+        e["props"] = json!({"style": "Heading1"});
+        let mut want = para(&[("aXb\u{FFFC}cd ", false), ("efg", true)]);
+        want["objects"] = json!([pic(20)]);
+        want["props"] = json!({"style": "Heading1"});
+        assert_eq!(merge(&doc(vec![base.clone()]), &doc(vec![c]), &doc(vec![e])).unwrap(), doc(vec![want]));
+        // Bold and italic on the same letter merge; bold on both sides conflicts.
+        let styled = |props: Value| json!({"kind": "para", "text": "ab", "runs": [{"len": 1, "props": props}, {"len": 1}]});
+        let b = doc(vec![plain("ab")]);
+        let merged = merge(&b, &doc(vec![styled(json!({"bold": true}))]), &doc(vec![styled(json!({"italic": true}))])).unwrap();
+        assert_eq!(merged, doc(vec![styled(json!({"bold": true, "italic": true}))]));
+        let bold = doc(vec![styled(json!({"bold": true}))]);
