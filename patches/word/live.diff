+//! Live editing in a Playground session (patches/word.yaml): a picture, shape or text box being moved, resized or turned
+//! by its frame, for the others to see before it is dropped. A child of `objects` to read its drag.
+
+use crate::WordApp;
+
+/// The dragged object's frame where the drag would put it: its page, `[x, y, w, h]` (page points, unturned) and its angle
+/// (degrees clockwise); `None` until it moves, and for a connector's end.
+pub fn ghost(app: &WordApp) -> Option<(usize, [f32; 4], f32)> {
+    let d = app.canvas.obj_drag.as_ref().filter(|d| d.drag.moved && d.end.is_none())?;
+    let r = d.drag.rect;
+    Some((d.drag.to_page, [r.x, r.y, r.w, r.h], d.drag.deg))
+}
