+    /// Whether each of the body's fields shows its code (Shift+F9).
+    fn codes(doc: &Document) -> Vec<bool> {
+        let mut out = Vec::new();
+        paragraphs(&doc.body, &mut |p| {
+            out.extend(p.objects.iter().filter_map(|o| match o {
+                InlineObject::Field { code, .. } => Some(*code),
+                _ => None,
+            }))
+        });
+        out
+    }
+
+    #[test]
+    fn shares_the_document_without_views_merges_text_in_without_an_undo_step_and_waits_for_a_gesture() {
+        let mut a = app(&["Hello world", "Second", "Third"]);
+        for at in [(0, 11), (1, 6)] {
+            caret(&mut a, at.0, at.1);
+            a.session.run("insert.field", &json!({"instr": "PAGE"})).unwrap();
+        }
+        install();
+        playground_live::connect();
+        let start = canonical(&a.live_document());
+        // Views, save stamps and field-code toggles are not shared.
+        caret(&mut a, 2, 3);
+        a.session.view.zoom = 2.0;
+        a.session.stamp_save();
+        paragraphs_mut(&mut a.session.doc.body, &mut |p| {
+            p.objects.iter_mut().for_each(|o| {
+                if let InlineObject::Field { code, .. } = o {
+                    *code = true;
+                }
+            })
+        });
+        assert_eq!(canonical(&a.live_document()), start, "views are not shared");
+
+        // B (another page: the adapter's state is per thread) joins from the Start screen and adopts it whole, types in
+        // the first paragraph and adds one before the last.
+        let joined = start.clone();
+        let edited = std::thread::spawn(move || {
+            let mut b = app(&[""]);
+            b.ui.start_screen = true;
+            b.start_screen();
+            assert!(!b.has_document());
+            b.live_adopt(serde_json::from_slice(&joined).unwrap()).unwrap();
+            assert!(b.has_document() && !b.ui.backstage);
+            assert_eq!(canonical(&b.live_document()), joined);
+            typed(&mut b, 0, 0, "Oh, ");
+            typed(&mut b, 2, 0, "New");
+            b.session.run("text.newParagraph", &json!({})).unwrap();
+            canonical(&b.live_document())
+        })
+        .join()
+        .unwrap();
+        // A, typing in the same first paragraph further on, merges B's edits at a quiet frame, keeping its own, its
+        // caret, its undo history and unchanged blocks.
+        typed(&mut a, 0, 11, "!");
+        let second = a.session.doc.body[1].clone();
+        caret(&mut a, 2, 3);
+        let undo_steps = a.session.undo_depth();
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(start.clone()), edited, Box::new(move |r| to.set(r.is_ok())));
+        UI_BUSY.set(true);
+        playground_live::frame(&mut a);
+        assert!(!done.get(), "a gesture under way holds remote changes");
+        UI_BUSY.set(false);
+        playground_live::frame(&mut a);
+        assert!(done.get());
+        let text: Vec<&str> = a.session.doc.body.iter().filter_map(|b| b.as_para()).map(|p| p.text.as_str()).collect();
+        assert_eq!(text[0], "Oh, Hello world!\u{FFFC}");
+        assert_eq!(codes(&a.session.doc), [true, true], "field-code views stay");
+        assert_eq!(text.last(), Some(&"Third"));
+        assert_eq!(a.session.undo_depth(), undo_steps, "no undo step");
+        assert!(Arc::ptr_eq(&a.session.doc.body[1], &second), "an unchanged paragraph keeps its Arc");
+        let last = a.session.doc.body.len() - 1;
+        assert_eq!((a.session.sel.focus.path.0.as_slice(), a.session.sel.focus.off), (&[last as u32][..], 3), "the caret stays in Third");
+        assert_eq!(a.session.view.zoom, 2.0);
+
+        // Undo goes to the session; the shared document ends at another document.
+        a.session.run("edit.undo", &json!({})).unwrap();
+        assert_eq!(playground_live::activity().1, [false]);
+        let shared = canonical(&a.live_document());
+        a.session.set_document(Document::new());
+        assert_eq!(canonical(&a.live_document()), shared, "the shared document stays reported");
+        a.session.run("text.insert", &json!({"text": "x"})).unwrap();
+        a.session.run("edit.undo", &json!({})).unwrap();
+        assert_eq!(a.session.doc.plain_text(StoryRef::Body).trim(), "", "another document's Undo is native");
+        playground_live::disconnect();
+    }
+
+    #[test]
+    fn presence_is_the_selection_in_the_shared_document_and_only_positions_in_it_are_drawn() {
