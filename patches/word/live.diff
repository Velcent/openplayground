+//! Live editing in a Playground session (patches/word.yaml): the ink stroke being drawn, for the others to see before it
+//! is finished. A child of `ink` to read its drag.
+
+use crate::WordApp;
+
+/// The stroke being drawn with a pen: its page, the pen's width (points) and its points so far (page points).
+pub fn stroke(app: &WordApp) -> Option<(usize, f32, &[[f32; 2]])> {
+    let d = app.canvas.ink.as_ref()?;
+    Some((d.page, app.session.view.draw.settings(d.tool).width, &d.pts))
+}
