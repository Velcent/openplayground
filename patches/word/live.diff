+//! Playground live editing (`playground_live`): the shared document is the open document's model as JSON (as the
+//! app's own JSON format writes it, with pictures and kept parts as base64) without what is personal or stamped on
+//! save: the zoom saved with it, the save times, author and count, and field-code toggles. Text merges character by
+//! character (`text_merge`). Native undo history stays local; while connected Undo and Redo go to the session.
+//!
+//! Presence (`presence`): each person shares their selection in the shared document, their pointer over a page and
+//! what a gesture under way is doing (an object's frame dragged, a table border dragged, ink being drawn); the others
+//! are drawn over the pages in their color, eased toward where they are (`web/live.rs` calls [`frame`] after each
+//! frame).
+//!
+//! Upstream calls in through two hooks (rules in patches/word.yaml): `wordcraft_engine::LIVE_UNDO` at the top of
+//! `Session::run` and `wordcraft_engine::LIVE_HISTORY` at the top of the QAT's `qat_enabled`.
+
+// The frame hook and drawing run in the browser only.
+#![cfg_attr(test, allow(dead_code))]
+
+#[path = "playground_live.rs"]
+#[allow(dead_code)]
+pub mod playground_live;
+mod presence;
+mod text_merge;
+
+use std::cell::{Cell, RefCell};
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+use serde_json::{Map, Value, json};
+use wordcraft_doc::{Block, Blocks, Document, InlineObject, Paragraph, Pos, StoryRef};
+use wordcraft_engine::cmd::insert::{base64_decode, base64_encode};
+use wordcraft_ui_egui::WordApp;
+
+use playground_live::{Error, Live, Presence};
+
+pub const FORMAT: &str = concat!("word:1:", env!("CARGO_PKG_VERSION"));
+
+thread_local! {
+    /// The shared document's `document_id`: the document open when the session first read it (not the Start screen's
+    /// placeholder), or the one the Start screen opened for it.
+    static SHARED: Cell<Option<u64>> = const { Cell::new(None) };
+    /// The shared document as last seen, still reported and merged into once another document replaced it here.
+    static LAST: RefCell<Option<Document>> = const { RefCell::new(None) };
+    /// A pointer is down, or a text field other than the page has the keyboard.
+    static UI_BUSY: Cell<bool> = const { Cell::new(false) };
+    static CTX: RefCell<Option<egui::Context>> = const { RefCell::new(None) };
+    /// This person's pointer over the shared document's pages as of the last frame: page, x, y (points).
+    static POINTER: Cell<Option<(usize, f64, f64)>> = const { Cell::new(None) };
+    /// The others in the session, as the shell last gave them, with their marks where this page last drew them.
+    static OTHERS: RefCell<Vec<presence::Other>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Hooks the engine's Undo and Redo, and the QAT's state of them.
+pub fn install() {
+    let _ = wordcraft_engine::LIVE_UNDO.set(undo);
+    let _ = wordcraft_engine::LIVE_HISTORY.set(holds);
+}
+
+/// The end of a frame.
+pub fn frame(app: &mut WordApp, ui: &egui::Ui) {
+    let ctx = ui.ctx();
+    UI_BUSY.set(ctx.input(|i| i.pointer.any_down()) || (ctx.memory(|m| m.focused().is_some()) && !app.canvas.focused));
+    CTX.with_borrow_mut(|c| _ = c.get_or_insert_with(|| ctx.clone()));
+    // The shared document's pages are on screen (no Backstage or Start screen over them).
+    let shown = !app.ui.backstage && app.has_document() && SHARED.get() == Some(app.session.document_id());
+    let hover = ctx.input(|i| i.pointer.hover_pos()).filter(|p| app.canvas.canvas_rect.is_some_and(|r| r.contains(*p)));
+    let mut pointer = None;
+    if shown && (hover.is_some() || OTHERS.with_borrow(|o| !o.is_empty())) {
+        let layout = app.session.layout();
+        let round = |v: f32| (f64::from(v) * 10.0).round() / 10.0;
+        pointer = hover
+            .and_then(|p| wordcraft_ui_egui::canvas::page_at(&app.canvas.page_rects, &layout, app.canvas.scale, p))
+            .map(|(page, x, y)| (page, round(x), round(y)));
+        OTHERS.with_borrow_mut(|others| presence::draw(app, ui, &layout, others));
+    }
+    POINTER.set(pointer);
+    playground_live::frame(app);
+}
+
+pub fn repaint() {
+    CTX.with_borrow(|c| c.iter().for_each(egui::Context::request_repaint));
+}
+
+/// `wordcraft_engine::LIVE_HISTORY`: whether the session holds document `id`'s Undo and Redo (the shared one, while
+/// connected).
+fn holds(document: u64) -> bool {
+    SHARED.get() == Some(document) && playground_live::connected()
+}
+
+/// `wordcraft_engine::LIVE_UNDO`, `Session::run`'s first step: while the session holds the document's history, its Undo
+/// and Redo (`count` steps for Undo Actions) are the session's.
+fn undo(document: u64, command: &str, params: &Value) -> bool {
+    let redo = match command {
+        "edit.undo" | "edit.undoTo" => false,
+        "edit.redo" => true,
+        _ => return false,
+    };
+    if !holds(document) {
+        return false;
+    }
+    for _ in 0..params.get("count").and_then(Value::as_u64).unwrap_or(1).clamp(1, 64) {
+        playground_live::undo(redo);
+    }
+    true
+}
+
+/// Whether the open document is the shared one; the first document open becomes it.
+fn bound(app: &WordApp) -> bool {
+    let id = app.session.document_id();
+    match SHARED.get() {
+        Some(shared) => shared == id,
+        None if app.has_document() => {
+            SHARED.set(Some(id));
+            true
+        }
+        None => false,
+    }
+}
+
+fn project(doc: &Document) -> Value {
+    let mut d = doc.clone();
+    let (media, passthrough) = (std::mem::take(&mut d.media), std::mem::take(&mut d.passthrough));
+    (d.core.created, d.core.modified, d.core.last_modified_by, d.core.revision) = Default::default();
+    let mut v = serde_json::to_value(&d).unwrap_or_default();
+    // The zoom saved with the document (in versions that save one) is this person's.
+    if let Some(settings) = v.get_mut("settings").and_then(Value::as_object_mut) {
+        settings.remove("zoom");
+    }
+    without_field_codes(&mut v);
+    // ponytail: files are encoded again on every changed frame; cache the text by Arc if big pictures make typing lag.
+    for (key, files) in [("media", media), ("passthrough", passthrough)] {
+        if !files.is_empty() {
+            v[key] = files.iter().map(|(name, bytes)| (name.clone(), Value::from(base64_encode(bytes)))).collect::<Map<_, _>>().into();
+        }
+    }
+    v
+}
+
+/// Shift+F9's per-field code view is this person's.
+fn without_field_codes(v: &mut Value) {
+    match v {
+        Value::Object(m) => {
+            if m.get("type").and_then(Value::as_str) == Some("field") {
+                m.remove("code");
+            }
+            m.values_mut().for_each(without_field_codes);
+        }
+        Value::Array(items) => items.iter_mut().for_each(without_field_codes),
+        _ => {}
+    }
+}
+
+fn from_shared(mut document: Value) -> Result<Document, Error> {
+    let invalid = |e: &dyn std::fmt::Display| format!("Invalid shared document: {e}");
+    let files = |v: Option<Value>| -> Result<BTreeMap<String, Arc<Vec<u8>>>, Error> {
+        match v {
+            None => Ok(BTreeMap::new()),
+            Some(Value::Object(m)) => m
+                .into_iter()
+                .map(|(name, v)| Ok((name, Arc::new(v.as_str().and_then(base64_decode).ok_or_else(|| invalid(&"bad file bytes"))?))))
+                .collect(),
+            Some(_) => Err(invalid(&"bad files")),
+        }
+    };
+    let map = document.as_object_mut().ok_or_else(|| invalid(&"not an object"))?;
+    let (media, passthrough) = (map.remove("media"), map.remove("passthrough"));
+    let mut doc: Document = serde_json::from_value(document).map_err(|e| invalid(&e))?;
+    (doc.media, doc.passthrough) = (files(media)?, files(passthrough)?);
+    Ok(doc)
+}
+
+/// The body's and the parts' blocks.
+fn stories(doc: &Document) -> impl Iterator<Item = &Blocks> {
+    std::iter::once(&doc.body).chain(doc.parts.values().map(|p| &p.blocks))
+}
+
+fn paragraphs<'a>(blocks: &'a Blocks, f: &mut dyn FnMut(&'a Paragraph)) {
+    for block in blocks {
+        match &**block {
+            Block::Para(p) => f(p),
+            Block::Table(t) => t.rows.iter().flat_map(|r| &r.cells).for_each(|c| paragraphs(&c.blocks, f)),
+        }
+    }
+}
+
+fn paragraphs_mut(blocks: &mut Blocks, f: &mut dyn FnMut(&mut Paragraph)) {
+    for block in blocks {
+        match Arc::make_mut(block) {
+            Block::Para(p) => f(p),
+            Block::Table(t) => t.rows.iter_mut().flat_map(|r| &mut r.cells).for_each(|c| paragraphs_mut(&mut c.blocks, f)),
+        }
+    }
+}
+
+/// Shift+F9's per-field code view stays this person's: fields pair up by their codes in reading order. (`new` was just
+/// read, so its blocks are its own and nothing is copied.)
+fn keep_field_codes(new: &mut Document, old: &Document) {
+    let fields = |doc: &Document| {
+        let mut out = Vec::new();
+        for blocks in stories(doc) {
+            paragraphs(blocks, &mut |p| {
+                out.extend(p.objects.iter().filter_map(|o| match o {
+                    InlineObject::Field { instr, code, .. } => Some((instr.clone(), *code)),
+                    _ => None,
+                }))
+            });
+        }
+        out
+    };
+    let was = fields(old);
+    if !was.iter().any(|(_, code)| *code) {
+        return;
+    }
+    let pairs = text_merge::matches(&fields(new), &was, |a, b| a.0 == b.0);
+    let mut codes = pairs.into_iter().map(|j| j.and_then(|j| was.get(j)).is_some_and(|(_, code)| *code));
+    let mut set = |p: &mut Paragraph| {
+        for o in &mut p.objects {
+            if let InlineObject::Field { code, .. } = o {
+                *code = codes.next().unwrap_or(false);
+            }
+        }
+    };
+    paragraphs_mut(&mut new.body, &mut set);
+    for part in new.parts.values_mut() {
+        paragraphs_mut(&mut part.blocks, &mut set);
+    }
+}
+
+/// Keeps `old`'s blocks (and so their layout) where `new` has them unchanged: for each old block, its new index.
+fn reuse(new: &mut Blocks, old: &Blocks) -> Vec<Option<usize>> {
+    let pairs = text_merge::matches(old, new, |a, b| a == b);
+    for (i, j) in pairs.iter().enumerate() {
+        if let (Some(j), Some(block)) = (*j, old.get(i)) {
+            new[j] = block.clone();
+        }
+    }
+    pairs
+}
+
+/// `pos` after its story's blocks went from `old` to `new` (`pairs` from [`reuse`]).
+fn map_pos(pos: &mut Pos, pairs: &[Option<usize>], old: &Blocks, new: &Blocks) {
+    let Some(i) = pos.path.0.first().map(|&i| i as usize) else { return };
+    let j = match pairs.get(i) {
+        Some(Some(j)) => *j,
+        // Its block changed too: the block after the last unchanged one before it, at the same place in the text.
+        _ => {
+            let j = pairs.get(..i).unwrap_or(pairs).iter().rev().find_map(|p| *p).map_or(0, |j| j + 1);
+            if let ([_], Some(Block::Para(a)), Some(Block::Para(b))) = (pos.path.0.as_slice(), old.get(i).map(|b| &**b), new.get(j).map(|b| &**b)) {
+                pos.off = offset(&a.text, &b.text, pos.off);
+            }
+            j
+        }
+    };
+    pos.path.0[0] = j as u32;
+}
+
+/// `off` in `old` moved into `new`: kept in their common start, kept from the end in their common end.
+fn offset(old: &str, new: &str, off: usize) -> usize {
+    let pre: usize = old.chars().zip(new.chars()).take_while(|(a, b)| a == b).map(|(a, _)| a.len_utf8()).sum();
+    if off <= pre {
+        return off;
+    }
+    let suf: usize = old[pre..].chars().rev().zip(new[pre..].chars().rev()).take_while(|(a, b)| a == b).map(|(a, _)| a.len_utf8()).sum();
+    let after = old.len().saturating_sub(off);
+    if after <= suf { new.len() - after } else { pre }
+}
+
+impl Live for WordApp {
+    fn live_document(&self) -> Value {
+        if bound(self) {
+            LAST.set(Some(self.session.doc.clone()));
+        } else if SHARED.get().is_some() {
+            return LAST.with_borrow(|last| project(last.as_ref().unwrap_or(&self.session.doc)));
+        }
+        project(&self.session.doc)
+    }
+
+    fn live_adopt(&mut self, mut document: Value) -> Result<(), Error> {
+        // This person's saved zoom stays (read by name: the field is newer than some releases).
+        if let Some(settings) = document.get_mut("settings").and_then(Value::as_object_mut) {
+            match serde_json::to_value(&self.session.doc.settings).ok().and_then(|mut v| v.get_mut("zoom").map(Value::take)) {
+                Some(zoom) => settings.insert("zoom".into(), zoom),
+                None => settings.remove("zoom"),
+            };
+        }
+        let mut doc = from_shared(document)?;
+        if !self.has_document() {
+            // The Start screen: the shared document opens.
+            self.session.set_document(doc);
+            self.ui.backstage = false;
+            SHARED.set(Some(self.session.document_id()));
+            LAST.set(Some(self.session.doc.clone()));
+            return Ok(());
+        }
+        if !bound(self) {
+            LAST.set(Some(doc));
+            return Ok(());
+        }
+        let s = &mut self.session;
+        let core = &s.doc.core;
+        (doc.core.created, doc.core.modified, doc.core.last_modified_by, doc.core.revision) =
+            (core.created.clone(), core.modified.clone(), core.last_modified_by.clone(), core.revision);
+        keep_field_codes(&mut doc, &s.doc);
+        // Unchanged blocks and files keep their Arcs (and their layout); the selection and an equation being edited
+        // move with the text.
+        let body = reuse(&mut doc.body, &s.doc.body);
+        let mut parts = BTreeMap::new();
+        for (id, part) in doc.parts.iter_mut() {
+            if let Some(was) = s.doc.parts.get(id) {
+                parts.insert(*id, reuse(&mut part.blocks, &was.blocks));
+            }
+        }
+        for (new, old) in [(&mut doc.media, &s.doc.media), (&mut doc.passthrough, &s.doc.passthrough)] {
+            for (name, bytes) in new.iter_mut() {
+                if let Some(was) = old.get(name).filter(|was| ***was == **bytes) {
+                    *bytes = was.clone();
+                }
+            }
+        }
+        if doc == s.doc {
+            return Ok(());
+        }
+        for pos in [&mut s.sel.anchor, &mut s.sel.focus].into_iter().chain(s.math.as_mut().map(|m| &mut m.at)) {
+            let story = match pos.story {
+                StoryRef::Body => Some((&body, &s.doc.body, &doc.body)),
+                StoryRef::Part(id) => parts.get(&id).zip(s.doc.parts.get(&id)).zip(doc.parts.get(&id)).map(|((p, o), n)| (p, &o.blocks, &n.blocks)),
+            };
+            if let Some((pairs, old, new)) = story {
+                map_pos(pos, pairs, old, new);
+            }
+        }
+        s.doc = doc;
+        s.also_selected.clear();
+        s.column = None;
+        s.touch();
+        s.clamp_selection();
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        !UI_BUSY.get() && self.canvas.ime_preedit.is_empty()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        // Elsewhere only a remote change, adopted already, changes the shared document.
+        Some(if bound(self) { self.session.rev() ^ self.session.document_id().rotate_left(40) } else { u64::MAX })
+    }
+
+    fn live_disconnected(&mut self) {
+        LAST.set(None);
+        if SHARED.take() == Some(self.session.document_id()) {
+            self.session.reset_history();
+        }
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, Error> {
+        text_merge::merge(base, current, edited)
+    }
+
+    /// What every page can open: a document whose paragraphs' runs cover their text on character boundaries, with one
+    /// object per U+FFFC, and every story and cell holding a paragraph.
+    fn live_check(document: &Value) -> Result<(), Error> {
+        let doc = from_shared(document.clone())?;
+        let mut whole = doc.clone();
+        whole.ensure_nonempty();
+        let mut valid = whole == doc;
+        for blocks in stories(&doc) {
+            paragraphs(blocks, &mut |p| {
+                let mut end = 0usize;
+                valid &= p.runs.iter().all(|r| {
+                    end = end.saturating_add(r.len);
+                    p.text.is_char_boundary(end)
+                }) && end == p.text.len()
+                    && p.text.matches(wordcraft_doc::para::OBJ).count() == p.objects.len();
+            });
+        }
+        if valid { Ok(()) } else { Err("Conflict: the merged document is not valid".into()) }
+    }
+
+    /// `{anchor, focus, pointer?, drag?, border?, stroke?}` while the shared document is open: the selection's ends, the
+    /// pointer over a page and the gestures under way (`presence`).
+    fn live_presence(&self) -> Value {
+        if !self.has_document() || SHARED.get() != Some(self.session.document_id()) {
+            return Value::Null;
+        }
+        let mut v = json!({"anchor": self.session.sel.anchor, "focus": self.session.sel.focus});
+        if let Some((page, x, y)) = POINTER.get() {
+            v["pointer"] = json!([page, x, y]);
+        }
+        CTX.with_borrow(|ctx| presence::gestures(self, ctx.as_ref(), &mut v));
+        v
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        OTHERS.with_borrow_mut(|old| *old = others.into_iter().map(|p| presence::Other::new(p, old)).collect());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use playground_live::canonical;
+    use wordcraft_engine::Session;
+    use wordcraft_ui_egui::Services;
+
+    fn app(text: &[&str]) -> WordApp {
+        let mut doc = Document::new();
+        doc.body = text.iter().map(|t| wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(t, Default::default()))).collect();
+        WordApp::new(Session::new(doc), Services::default())
+    }
+    fn caret(app: &mut WordApp, block: usize, off: usize) {
+        app.session.sel = wordcraft_engine::Selection::caret(Pos::body(block, off));
+    }
+    fn typed(app: &mut WordApp, block: usize, off: usize, text: &str) {
+        caret(app, block, off);
+        app.session.run("text.insert", &json!({"text": text})).unwrap();
+    }
+    /// Whether each of the body's fields shows its code (Shift+F9).
+    fn codes(doc: &Document) -> Vec<bool> {
+        let mut out = Vec::new();
+        paragraphs(&doc.body, &mut |p| {
+            out.extend(p.objects.iter().filter_map(|o| match o {
+                InlineObject::Field { code, .. } => Some(*code),
+                _ => None,
+            }))
+        });
+        out
+    }
+
+    #[test]
+    fn shares_the_document_without_views_merges_text_in_without_an_undo_step_and_waits_for_a_gesture() {
+        let mut a = app(&["Hello world", "Second", "Third"]);
+        for at in [(0, 11), (1, 6)] {
+            caret(&mut a, at.0, at.1);
+            a.session.run("insert.field", &json!({"instr": "PAGE"})).unwrap();
+        }
+        install();
+        playground_live::connect();
+        let start = canonical(&a.live_document());
+        // Views, save stamps and field-code toggles are not shared.
+        caret(&mut a, 2, 3);
+        a.session.view.zoom = 2.0;
+        a.session.stamp_save();
+        paragraphs_mut(&mut a.session.doc.body, &mut |p| {
+            p.objects.iter_mut().for_each(|o| {
+                if let InlineObject::Field { code, .. } = o {
+                    *code = true;
+                }
+            })
+        });
+        assert_eq!(canonical(&a.live_document()), start, "views are not shared");
+
+        // B (another page: the adapter's state is per thread) joins from the Start screen and adopts it whole, types in
+        // the first paragraph and adds one before the last.
+        let joined = start.clone();
+        let edited = std::thread::spawn(move || {
+            let mut b = app(&[""]);
+            b.ui.start_screen = true;
+            b.start_screen();
+            assert!(!b.has_document());
+            b.live_adopt(serde_json::from_slice(&joined).unwrap()).unwrap();
+            assert!(b.has_document() && !b.ui.backstage);
+            assert_eq!(canonical(&b.live_document()), joined);
+            typed(&mut b, 0, 0, "Oh, ");
+            typed(&mut b, 2, 0, "New");
+            b.session.run("text.newParagraph", &json!({})).unwrap();
+            canonical(&b.live_document())
+        })
+        .join()
+        .unwrap();
+        // A, typing in the same first paragraph further on, merges B's edits at a quiet frame, keeping its own, its
+        // caret, its undo history and unchanged blocks.
+        typed(&mut a, 0, 11, "!");
+        let second = a.session.doc.body[1].clone();
+        caret(&mut a, 2, 3);
+        let undo_steps = a.session.undo_depth();
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(start.clone()), edited, Box::new(move |r| to.set(r.is_ok())));
+        UI_BUSY.set(true);
+        playground_live::frame(&mut a);
+        assert!(!done.get(), "a gesture under way holds remote changes");
+        UI_BUSY.set(false);
+        playground_live::frame(&mut a);
+        assert!(done.get());
+        let text: Vec<&str> = a.session.doc.body.iter().filter_map(|b| b.as_para()).map(|p| p.text.as_str()).collect();
+        assert_eq!(text[0], "Oh, Hello world!\u{FFFC}");
+        assert_eq!(codes(&a.session.doc), [true, true], "field-code views stay");
+        assert_eq!(text.last(), Some(&"Third"));
+        assert_eq!(a.session.undo_depth(), undo_steps, "no undo step");
+        assert!(Arc::ptr_eq(&a.session.doc.body[1], &second), "an unchanged paragraph keeps its Arc");
+        let last = a.session.doc.body.len() - 1;
+        assert_eq!((a.session.sel.focus.path.0.as_slice(), a.session.sel.focus.off), (&[last as u32][..], 3), "the caret stays in Third");
+        assert_eq!(a.session.view.zoom, 2.0);
+
+        // Undo goes to the session; the shared document ends at another document.
+        a.session.run("edit.undo", &json!({})).unwrap();
+        assert_eq!(playground_live::activity().1, [false]);
+        let shared = canonical(&a.live_document());
+        a.session.set_document(Document::new());
+        assert_eq!(canonical(&a.live_document()), shared, "the shared document stays reported");
+        a.session.run("text.insert", &json!({"text": "x"})).unwrap();
+        a.session.run("edit.undo", &json!({})).unwrap();
+        assert_eq!(a.session.doc.plain_text(StoryRef::Body).trim(), "", "another document's Undo is native");
+        playground_live::disconnect();
+    }
+
+    #[test]
+    fn presence_is_the_selection_in_the_shared_document_and_only_positions_in_it_are_drawn() {
+        let mut a = app(&["Hello w\u{f6}rld", "Second"]);
+        assert_eq!(a.live_presence(), Value::Null, "nothing before the session reads the document");
+        a.live_document();
+        a.session.sel = wordcraft_engine::Selection { anchor: Pos::body(0, 6), focus: Pos::body(0, 12) };
+        let mine = a.live_presence();
+        let end = |path: Value, off: usize| json!({"story": "body", "path": path, "off": off});
+        assert_eq!(mine, json!({"anchor": end(json!([0]), 6), "focus": end(json!([0]), 12)}));
+        let drawn = |state: Value| {
+            let other = presence::Other::new(Presence { id: "b".into(), name: "Bob".into(), color: [9, 9, 9], state }, &[]);
+            presence::resolved(&a.session.doc, &other.selection).is_some()
+        };
+        assert!(drawn(mine));
+        let part = json!({"story": {"part": 1}, "path": [0], "off": 0});
+        for focus in [end(json!([0]), 8), end(json!([0]), 13), end(json!([2]), 0), end(json!([0, 0]), 0), part, json!(-1)] {
+            assert!(!drawn(json!({"anchor": end(json!([0]), 0), "focus": focus})), "{focus}");
+        }
+
+        // A shape dragged by its frame and held mid-way (Alt: no snapping): the others see its ghost where it would land.
+        caret(&mut a, 0, 0);
+        a.run("view.commentsPane", json!({"value": false})).unwrap();
+        a.run("insert.shape", json!({"kind": "rectangle", "width": 100, "height": 50})).unwrap();
+        a.run("arrange.bounds", json!({"page": 0, "x": 100, "y": 250})).unwrap();
+        let (ctx, mut time) = (egui::Context::default(), 0.0);
+        let mut frame = |app: &mut WordApp, events: Vec<egui::Event>| {
+            time += 1.0 / 60.0;
+            let screen = egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1440.0, 900.0));
+            let events = [vec![egui::Event::ModifiersChanged(egui::Modifiers::ALT)], events].concat();
+            let input = egui::RawInput { events, time: Some(time), screen_rect: Some(screen), ..Default::default() };
+            ctx.run_ui(input, |ui| {
+                app.logic(&ui.ctx().clone());
+                app.ui(ui);
+            })
+            .drop_without_applying_deltas();
+        };
+        (0..6).for_each(|_| frame(&mut a, Vec::new()));
+        let shape = wordcraft_engine::cmd::objects::object_selection(&a.session).unwrap().0;
+        let r = a.session.layout().object(&shape, 0).unwrap().rect;
+        let (cx, cy) = (r.x + r.w / 2.0, r.y + r.h / 2.0);
+        let at = |a: &mut WordApp, dx: f32, dy: f32| wordcraft_ui_egui::canvas::page_to_screen(a, 0, cx + dx, cy + dy).unwrap();
+        let button = |pos, pressed| egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed, modifiers: egui::Modifiers::ALT };
+        let from = at(&mut a, 0.0, 0.0);
+        frame(&mut a, vec![egui::Event::PointerMoved(from), button(from, true)]);
+        for (dx, dy) in [(0.0, 30.0), (20.0, 30.0)] {
+            let to = at(&mut a, dx, dy);
+            frame(&mut a, vec![egui::Event::PointerMoved(to)]);
+        }
+        let ghost: Vec<f64> = serde_json::from_value(a.live_presence()["drag"].clone()).unwrap();
+        let near = |got: f64, want: f32| (got - f64::from(want)).abs() < 0.11;
+        assert!(ghost.len() == 6 && [0.0, r.x + 20.0, r.y + 30.0, r.w, r.h, 0.0].iter().zip(&ghost).all(|(w, g)| near(*g, *w)), "{ghost:?} for {r:?}");
+    }
+
+    #[test]
+    fn only_documents_every_page_can_open_pass_the_check() {
+        let doc = |text: &str, runs: Value| json!({"body": [{"kind": "para", "text": text, "runs": runs}]});
+        assert!(WordApp::live_check(&project(&Document::new())).is_ok());
+        let bad = [
+            doc("ab", json!([{"len": 1}])),
+            doc("é", json!([{"len": 1}, {"len": 1}])),
+            doc("\u{FFFC}", json!([{"len": 3}])),
+            doc("a", json!("?")),
+            json!({"body": []}),
+            Value::Null,
+        ];
+        for bad in bad {
+            assert!(WordApp::live_check(&bad).is_err(), "{bad}");
+        }
+    }
+}
